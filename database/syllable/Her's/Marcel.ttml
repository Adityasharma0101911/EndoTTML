<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Marcel</ttm:title><ttm:agent type="person" xml:id="v1">Her's</ttm:agent><ttm:item type="album">Songs of Her's</ttm:item><ttm:item type="spotify_id">5u9cuDcYdOpSRB7fAYXXdp</ttm:item><itunes:duration>03:07.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:44.788" end="00:49.293"><span begin="00:44.788" end="00:45.300">I </span><span begin="00:45.300" end="00:45.852">wanna </span><span begin="00:45.852" end="00:46.148">ride </span><span begin="00:46.148" end="00:46.852">your </span><span begin="00:46.852" end="00:47.276">wave </span><span begin="00:47.276" end="00:48.477">again</span></p><p ttm:agent="v1" begin="00:49.293" end="00:53.735"><span begin="00:49.293" end="00:49.749">Don't </span><span begin="00:49.749" end="00:50.127">tell </span><span begin="00:50.127" end="00:50.415">me </span><span begin="00:50.415" end="00:50.671">I </span><span begin="00:50.671" end="00:51.279">can </span><span begin="00:51.279" end="00:51.871">just </span><span begin="00:51.871" end="00:53.167">pretend</span></p><p ttm:agent="v1" begin="00:53.735" end="00:58.240"><span begin="00:53.735" end="00:54.328">I </span><span begin="00:54.328" end="00:54.608">love </span><span begin="00:54.608" end="00:54.912">you </span><span begin="00:54.912" end="00:55.160">but </span><span begin="00:55.160" end="00:55.752">there's </span><span begin="00:55.752" end="00:56.336">still </span><span begin="00:56.336" end="00:56.616">a </span><span begin="00:56.616" end="00:57.688">taste</span></p><p ttm:agent="v1" begin="00:58.240" end="01:01.868"><span begin="00:58.240" end="00:58.736">Don't </span><span begin="00:58.736" end="00:59.064">know </span><span begin="00:59.064" end="00:59.352">if </span><span begin="00:59.352" end="00:59.616">you'll </span><span begin="00:59.616" end="01:00.695">always </span><span begin="01:00.695" end="01:00.999">be </span><span begin="01:00.999" end="01:01.868">amazed</span></p><p ttm:agent="v1" begin="01:01.868" end="01:04.527"><span begin="01:01.868" end="01:02.428">Right </span><span begin="01:02.428" end="01:03.287">now</span></p><p ttm:agent="v1" begin="01:04.527" end="01:11.890"><span begin="01:04.527" end="01:04.903">I </span><span begin="01:04.903" end="01:05.199">wanna </span><span begin="01:05.199" end="01:05.719">love </span><span begin="01:05.719" end="01:06.162">you </span><span begin="01:06.386" end="01:09.002">tonight</span></p><p ttm:agent="v1" begin="01:11.890" end="01:16.140"><span begin="01:11.890" end="01:12.258">Why </span><span begin="01:12.258" end="01:12.506">did </span><span begin="01:12.506" end="01:12.770">you </span><span begin="01:12.770" end="01:13.042">have </span><span begin="01:13.042" end="01:13.711">to </span><span begin="01:13.711" end="01:14.196">say </span><span begin="01:14.196" end="01:15.700">goodnight</span></p><p ttm:agent="v1" begin="01:16.140" end="01:20.596"><span begin="01:16.140" end="01:16.652">I </span><span begin="01:16.652" end="01:16.964">love </span><span begin="01:16.964" end="01:17.228">you </span><span begin="01:17.228" end="01:17.492">but </span><span begin="01:17.492" end="01:17.836">it </span><span begin="01:17.836" end="01:18.268">don't </span><span begin="01:18.268" end="01:18.748">feel </span><span begin="01:18.748" end="01:19.564">right</span></p><p ttm:agent="v1" begin="01:20.596" end="01:25.123"><span begin="01:20.596" end="01:21.668">Nobody </span><span begin="01:21.668" end="01:22.210">seems </span><span begin="01:22.210" end="01:22.666">to </span><span begin="01:22.666" end="01:23.226">really </span><span begin="01:23.226" end="01:24.683">know</span></p><p ttm:agent="v1" begin="01:25.123" end="01:28.751"><span begin="01:25.123" end="01:25.699">This </span><span begin="01:25.699" end="01:26.315">feeling's </span><span begin="01:26.315" end="01:26.979">getting </span><span begin="01:26.979" end="01:28.449">overgrown</span></p><p ttm:agent="v1" begin="01:28.751" end="01:31.618"><span begin="01:28.751" end="01:29.482">Slow </span><span begin="01:29.482" end="01:30.298">down</span></p><p ttm:agent="v1" begin="01:31.618" end="01:35.773"><span begin="01:31.618" end="01:31.866">I </span><span begin="01:31.866" end="01:32.122">wanna </span><span begin="01:32.122" end="01:32.650">love </span><span begin="01:32.650" end="01:33.093">you </span><span begin="01:33.277" end="01:35.714">tonight</span></p></div></body></tt>