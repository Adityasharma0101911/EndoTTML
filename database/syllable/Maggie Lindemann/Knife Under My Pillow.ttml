<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Knife Under My Pillow</ttm:title><ttm:agent type="person" xml:id="v1">Maggie Lindemann</ttm:agent><ttm:item type="album">PARANOIA</ttm:item><ttm:item type="spotify_id">2kbNqVLbxvO8VCaFftgnzr</ttm:item><itunes:duration>02:02.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:09.633" end="00:12.671"><span begin="00:09.633" end="00:09.845">Sorry </span><span begin="00:09.845" end="00:10.427">I </span><span begin="00:10.427" end="00:10.814">don't </span><span begin="00:10.814" end="00:11.164">mean </span><span begin="00:11.164" end="00:11.388">to </span><span begin="00:11.388" end="00:11.811">freak </span><span begin="00:11.811" end="00:12.019">you </span><span begin="00:12.019" end="00:12.671">out</span></p><p ttm:agent="v1" begin="00:12.671" end="00:15.989"><span begin="00:12.671" end="00:13.022">But </span><span begin="00:13.022" end="00:13.211">I </span><span begin="00:13.211" end="00:13.560">hear </span><span begin="00:13.560" end="00:14.395">someone </span><span begin="00:14.395" end="00:14.979">inside </span><span begin="00:14.979" end="00:15.186">my </span><span begin="00:15.186" end="00:15.626">house</span></p><p ttm:agent="v1" begin="00:15.989" end="00:22.973"><span begin="00:15.989" end="00:16.429">Heart </span><span begin="00:16.429" end="00:17.922">racin'keepin'me </span><span begin="00:17.922" end="00:21.220">awake</span></p><p ttm:agent="v1" begin="00:22.973" end="00:26.154"><span begin="00:22.973" end="00:24.340">Paranoia's </span><span begin="00:24.340" end="00:26.031">slippin'in</span></p><p ttm:agent="v1" begin="00:26.154" end="00:29.334"><span begin="00:26.154" end="00:27.201">Checkin'all </span><span begin="00:27.201" end="00:27.497">the </span><span begin="00:27.497" end="00:28.097">locks </span><span begin="00:28.097" end="00:29.091">again</span></p><p ttm:agent="v1" begin="00:29.334" end="00:33.241"><span begin="00:29.334" end="00:29.648">It's </span><span begin="00:29.648" end="00:29.998">so </span><span begin="00:29.998" end="00:30.403">loud </span><span begin="00:30.403" end="00:31.181">inside </span><span begin="00:31.181" end="00:31.605">my </span><span begin="00:31.605" end="00:33.006">head</span></p><p ttm:agent="v1" begin="00:33.241" end="00:36.385"><span begin="00:33.241" end="00:33.466">Got </span><span begin="00:33.466" end="00:33.691">me </span><span begin="00:33.691" end="00:34.166">feelin' </span><span begin="00:34.166" end="00:36.071">paralyzed</span></p><p ttm:agent="v1" begin="00:36.385" end="00:39.515"><span begin="00:36.385" end="00:36.628">I </span><span begin="00:36.628" end="00:36.817">can't </span><span begin="00:36.817" end="00:37.114">sleep </span><span begin="00:37.114" end="00:37.553">without </span><span begin="00:37.553" end="00:37.993">the </span><span begin="00:37.993" end="00:39.094">lights</span></p><p ttm:agent="v1" begin="00:39.515" end="00:42.716"><span begin="00:39.515" end="00:39.722">A </span><span begin="00:39.722" end="00:39.982">chill </span><span begin="00:39.982" end="00:40.225">is </span><span begin="00:40.225" end="00:40.808">runnin'down </span><span begin="00:40.808" end="00:41.194">my </span><span begin="00:41.194" end="00:42.330">spine</span></p><p ttm:agent="v1" begin="00:42.716" end="00:44.269"><span begin="00:42.716" end="00:42.961">Starin' </span><span begin="00:42.961" end="00:43.451">out </span><span begin="00:43.451" end="00:43.946">the </span><span begin="00:43.946" end="00:44.269">window</span></p><p ttm:agent="v1" begin="00:44.269" end="00:45.969"><span begin="00:44.269" end="00:44.458">A </span><span begin="00:44.458" end="00:44.630">knife </span><span begin="00:44.630" end="00:44.820">under </span><span begin="00:44.820" end="00:45.080">my </span><span begin="00:45.080" end="00:45.969">pillow</span></p><p ttm:agent="v1" begin="00:45.969" end="00:48.806"><span begin="00:45.969" end="00:46.174">But </span><span begin="00:46.174" end="00:46.470">it's </span><span begin="00:46.470" end="00:46.677">all </span><span begin="00:46.677" end="00:47.152">inside </span><span begin="00:47.152" end="00:47.575">my </span><span begin="00:47.575" end="00:48.656">mind</span></p><p ttm:agent="v1" begin="00:48.806" end="00:51.954"><span begin="00:48.806" end="00:48.997">Oh </span><span begin="00:48.997" end="00:49.220">I'm </span><span begin="00:49.220" end="00:49.803">holdin'on </span><span begin="00:49.803" end="00:50.207">for </span><span begin="00:50.207" end="00:50.752">dear </span><span begin="00:50.752" end="00:51.657">life</span></p><p ttm:agent="v1" begin="00:51.954" end="00:55.158"><span begin="00:51.954" end="00:52.231">Why's </span><span begin="00:52.231" end="00:52.457">this </span><span begin="00:52.457" end="00:52.897">happen </span><span begin="00:52.897" end="00:53.104">to </span><span begin="00:53.104" end="00:53.311">me </span><span begin="00:53.311" end="00:53.626">all </span><span begin="00:53.626" end="00:54.029">the </span><span begin="00:54.029" end="00:54.915">time</span></p><p ttm:agent="v1" begin="00:55.158" end="00:57.021"><span begin="00:55.158" end="00:55.384">Got </span><span begin="00:55.384" end="00:55.644">me </span><span begin="00:55.644" end="00:55.923">starin' </span><span begin="00:55.923" end="00:56.291">out </span><span begin="00:56.291" end="00:56.748">the </span><span begin="00:56.748" end="00:57.021">window</span></p><p ttm:agent="v1" begin="00:57.021" end="00:58.754"><span begin="00:57.021" end="00:57.264">A </span><span begin="00:57.264" end="00:57.488">knife </span><span begin="00:57.488" end="00:57.697">under </span><span begin="00:57.697" end="00:57.957">my </span><span begin="00:57.957" end="00:58.754">pillow</span></p><p ttm:agent="v1" begin="00:58.754" end="01:02.514"><span begin="00:58.754" end="00:58.978">But </span><span begin="00:58.978" end="00:59.121">it's </span><span begin="00:59.121" end="00:59.453">all </span><span begin="00:59.453" end="00:59.982">inside </span><span begin="00:59.982" end="01:00.385">my </span><span begin="01:00.385" end="01:01.110">mind</span></p><p ttm:agent="v1" begin="01:02.514" end="01:05.481"><span begin="01:02.514" end="01:02.811">I </span><span begin="01:02.811" end="01:03.179">know </span><span begin="01:03.179" end="01:03.618">I've </span><span begin="01:03.618" end="01:04.022">made </span><span begin="01:04.022" end="01:04.283">this </span><span begin="01:04.283" end="01:04.651">call </span><span begin="01:04.651" end="01:05.304">before</span></p><p ttm:agent="v1" begin="01:05.481" end="01:08.749"><span begin="01:05.481" end="01:05.850">Not </span><span begin="01:05.850" end="01:06.593">cryin' </span><span begin="01:06.593" end="01:07.197">wolf </span><span begin="01:07.197" end="01:07.511">I'm </span><span begin="01:07.511" end="01:08.004">pretty </span><span begin="01:08.004" end="01:08.749">sure</span></p><p ttm:agent="v1" begin="01:08.749" end="01:15.672"><span begin="01:08.749" end="01:09.080">There's </span><span begin="01:09.080" end="01:09.572">just </span><span begin="01:09.572" end="01:09.941">some </span><span begin="01:09.941" end="01:10.398">fears </span><span begin="01:10.398" end="01:10.713">you </span><span begin="01:10.713" end="01:11.152">can't </span><span begin="01:11.152" end="01:15.182">erase</span></p><p ttm:agent="v1" begin="01:15.672" end="01:18.938"><span begin="01:15.672" end="01:17.237">Paranoia's </span><span begin="01:17.237" end="01:18.695">slippin'in</span></p><p ttm:agent="v1" begin="01:18.938" end="01:21.964"><span begin="01:18.938" end="01:19.985">Checkin'all </span><span begin="01:19.985" end="01:20.334">the </span><span begin="01:20.334" end="01:21.096">locks </span><span begin="01:21.096" end="01:21.964">again</span></p><p ttm:agent="v1" begin="01:21.964" end="01:26.201"><span begin="01:21.964" end="01:22.278">It's </span><span begin="01:22.278" end="01:22.683">so </span><span begin="01:22.683" end="01:23.159">loud </span><span begin="01:23.159" end="01:24.026">inside </span><span begin="01:24.026" end="01:24.430">my </span><span begin="01:24.430" end="01:25.816">head</span></p><p ttm:agent="v1" begin="01:26.201" end="01:29.043"><span begin="01:26.201" end="01:26.427">Got </span><span begin="01:26.427" end="01:26.616">me </span><span begin="01:26.616" end="01:26.878">feelin' </span><span begin="01:26.878" end="01:28.709">paralyzed</span></p><p ttm:agent="v1" begin="01:29.043" end="01:32.280"><span begin="01:29.043" end="01:29.357">I </span><span begin="01:29.357" end="01:29.618">can't </span><span begin="01:29.618" end="01:29.951">sleep </span><span begin="01:29.951" end="01:30.319">without </span><span begin="01:30.319" end="01:30.793">the </span><span begin="01:30.793" end="01:31.857">lights</span></p><p ttm:agent="v1" begin="01:32.280" end="01:35.534"><span begin="01:32.280" end="01:32.469">A </span><span begin="01:32.469" end="01:32.730">chill </span><span begin="01:32.730" end="01:32.972">is </span><span begin="01:32.972" end="01:33.626">runnin'down </span><span begin="01:33.626" end="01:33.977">my </span><span begin="01:33.977" end="01:35.131">spine</span></p><p ttm:agent="v1" begin="01:35.534" end="01:37.131"><span begin="01:35.534" end="01:35.866">Starin' </span><span begin="01:35.866" end="01:36.127">out </span><span begin="01:36.127" end="01:36.370">the </span><span begin="01:36.370" end="01:37.131">window</span></p><p ttm:agent="v