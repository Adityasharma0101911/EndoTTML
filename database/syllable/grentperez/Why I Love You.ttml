<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Why I Love You</ttm:title><ttm:agent type="person" xml:id="v1">grentperez</ttm:agent><ttm:item type="album">Conversations with the Moon</ttm:item><ttm:item type="spotify_id">4f0v1QGuLwIxl77Vp6Tu6W</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:12.230" end="00:16.280"><span begin="00:12.230" end="00:12.680">She </span><span begin="00:12.680" end="00:13.160">dragged </span><span begin="00:13.160" end="00:13.430">my </span><span begin="00:13.430" end="00:13.970">heart </span><span begin="00:13.970" end="00:14.420">into </span><span begin="00:14.420" end="00:14.690">the </span><span begin="00:14.690" end="00:15.860">flame</span></p><p ttm:agent="v1" begin="00:16.280" end="00:19.250"><span begin="00:16.280" end="00:16.577">She</span><span begin="00:16.577" end="00:16.874">’</span><span begin="00:16.874" end="00:17.171">s </span><span begin="00:17.171" end="00:17.468">pleasure </span><span begin="00:17.468" end="00:17.765">and </span><span begin="00:17.765" end="00:18.062">she</span><span begin="00:18.062" end="00:18.359">’</span><span begin="00:18.359" end="00:18.656">s </span><span begin="00:18.656" end="00:18.953">pain</span></p><p ttm:agent="v1" begin="00:19.250" end="00:22.430"><span begin="00:19.250" end="00:19.400">She</span><span begin="00:19.400" end="00:19.430">’</span><span begin="00:19.430" end="00:19.490">s </span><span begin="00:19.490" end="00:19.910">more </span><span begin="00:19.910" end="00:20.090">than </span><span begin="00:20.090" end="00:20.420">what </span><span begin="00:20.420" end="00:20.720">i </span><span begin="00:20.720" end="00:21.470">bargained </span><span begin="00:21.470" end="00:22.430">for</span></p><p ttm:agent="v1" begin="00:22.430" end="00:24.260"><span begin="00:22.430" end="00:22.430">（</span><span begin="00:22.430" end="00:23.420">Initially </span><span begin="00:23.420" end="00:24.260">I</span><span begin="00:24.260" end="00:24.260">）</span></p><p ttm:agent="v1" begin="00:24.260" end="00:28.280"><span begin="00:24.260" end="00:24.680">Thought </span><span begin="00:24.680" end="00:25.100">she </span><span begin="00:25.100" end="00:25.400">was </span><span begin="00:25.400" end="00:25.880">sand </span><span begin="00:25.880" end="00:26.420">between </span><span begin="00:26.420" end="00:26.720">my </span><span begin="00:26.720" end="00:28.250">toes</span></p><p ttm:agent="v1" begin="00:28.280" end="00:31.370"><span begin="00:28.280" end="00:28.490">But </span><span begin="00:28.490" end="00:28.850">now </span><span begin="00:28.850" end="00:29.060">she</span><span begin="00:29.060" end="00:29.120">’</span><span begin="00:29.120" end="00:29.180">s </span><span begin="00:29.180" end="00:29.390">in </span><span begin="00:29.390" end="00:29.720">my </span><span begin="00:29.720" end="00:31.190">clothes</span></p><p ttm:agent="v1" begin="00:31.370" end="00:33.380"><span begin="00:31.370" end="00:32.060">Shoes</span><span begin="00:32.060" end="00:32.060">, </span><span begin="00:32.060" end="00:32.510">socks </span><span begin="00:32.510" end="00:32.720">and </span><span begin="00:32.720" end="00:33.380">nose</span></p><p ttm:agent="v1" begin="00:33.380" end="00:35.930"><span begin="00:33.380" end="00:33.410">（</span><span begin="00:33.410" end="00:33.620">Oh </span><span begin="00:33.620" end="00:34.250">no </span><span begin="00:34.250" end="00:34.280"> </span><span begin="00:34.280" end="00:34.820">now </span><span begin="00:34.820" end="00:34.880">i'm </span><span begin="00:34.880" end="00:35.300">getting </span><span begin="00:35.300" end="00:35.690">itchy</span><span begin="00:35.690" end="00:35.930">）</span></p><p ttm:agent="v1" begin="00:35.930" end="00:39.410"><span begin="00:35.930" end="00:36.770">In </span><span begin="00:36.770" end="00:37.250">the </span><span begin="00:37.250" end="00:37.940">winter </span><span begin="00:37.940" end="00:38.240">you</span><span begin="00:38.240" end="00:38.270">’</span><span begin="00:38.270" end="00:38.570">re </span><span begin="00:38.570" end="00:38.660"> </span><span begin="00:38.660" end="00:38.780">a </span><span begin="00:38.780" end="00:39.410">bright</span></p><p ttm:agent="v1" begin="00:39.410" end="00:41.120"><span begin="00:39.410" end="00:39.500">And </span><span begin="00:39.500" end="00:40.250">sunny </span><span begin="00:40.250" end="00:40.910">day</span></p><p ttm:agent="v1" begin="00:41.120" end="00:43.700"><span begin="00:41.120" end="00:41.660">Then </span><span begin="00:41.660" end="00:41.750">you </span><span begin="00:41.750" end="00:42.410">go </span><span begin="00:42.410" end="00:42.530">and </span><span begin="00:42.530" end="00:43.100">turn </span><span begin="00:43.100" end="00:43.280">to </span><span begin="00:43.280" end="00:43.700">rain</span></p><p ttm:agent="v1" begin="00:43.700" end="00:44.900"><span begin="00:43.700" end="00:44.000">Just </span><span begin="00:44.000" end="00:44.480">when </span><span begin="00:44.480" end="00:44.900">I</span></p><p ttm:agent="v1" begin="00:44.900" end="00:47.420"><span begin="00:44.900" end="00:45.180">Think </span><span begin="00:45.180" end="00:45.460">it</span><span begin="00:45.460" end="00:45.740">’</span><span begin="00:45.740" end="00:46.020">s </span><span begin="00:46.020" end="00:46.300">safe </span><span begin="00:46.300" end="00:46.580"> </span><span begin="00:46.580" end="00:46.860">to </span><span begin="00:46.860" end="00:47.140">play</span></p><p ttm:agent="v1" begin="00:47.420" end="00:50.000"><span begin="00:47.420" end="00:47.660">And </span><span begin="00:47.660" end="00:47.840">that</span><span begin="00:47.840" end="00:47.870">’</span><span begin="00:47.870" end="00:47.930">s </span><span begin="00:47.930" end="00:48.770">why </span><span begin="00:48.770" end="00:49.220">i </span><span begin="00:49.220" end="00:49.670">love </span><span begin="00:49.670" end="00:50.000">you</span></p><p ttm:agent="v1" begin="00:50.000" end="00:52.520"><span begin="00:50.000" end="00:50.000">（</span><span begin="00:50.000" end="00:50.570">You </span><span begin="00:50.570" end="00:50.690">bring </span><span begin="00:50.690" end="00:50.930">the </span><span begin="00:50.930" end="00:51.230">joy </span><span begin="00:51.230" end="00:51.560">into </span><span begin="00:51.560" end="00:51.710">the </span><span begin="00:51.710" end="00:52.190">darkness </span><span begin="00:52.190" end="00:52.340">of </span><span begin="00:52.340" end="00:52.490">dismay</span><span begin="00:52.490" end="00:52.520">）</span></p><p ttm:agent="v1" begin="00:52.520" end="00:54.980"><span begin="00:52.520" end="00:53.300">Why </span><span begin="00:53.300" end="00:53.810">i </span><span begin="00:53.810" end="00:54.230">need </span><span begin="00:54.230" end="00:54.980">you</span></p><p ttm:agent="v1" begin="00:54.980" end="00:57.200"><span begin="00:54.980" end="00:54.980">（</span><span begin="00:54.980" end="00:55.130">You </span><span begin="00:55.130" end="00:55.310">bring </span><span begin="00:55.310" end="00:55.430">the </span><span begin="00:55.430" end="00:55.940">colour </span><span begin="00:55.940" end="00:56.210">into </span><span begin="00:56.210" end="00:56.570">boring </span><span begin="00:56.570" end="00:56.870">shades </span><span begin="00:56.870" end="00:56.990">of </span><span begin="00:56.990" end="00:57.170">gray</span><span begin="00:57.170" end="00:57.200">）</span></p><p ttm:agent="v1" begin="00:57.200" end="01:00.290"><span begin="00:57.200" end="00:57.650">Like </span><span begin="00:57.650" end="00:58.310">august </span><span begin="00:58.310" end="00:58.820">rain </span><span begin="00:58.820" end="00:59.420">into </span><span begin="00:59.420" end="00:59.660">the </span><span begin="00:59.660" end="01:00.290">summer</span></p><p ttm:agent="v1" begin="01:00.290" end="01:01.700"><span begin="01:00.290" end="01:00.446">（</span><span begin="01:00.446" end="01:00.602">No </span><span begin="01:00.602" end="01:00.758">one </span><span begin="01:00.758" end="01:00.914">could </span><span begin="01:00.914" end="01:01.070">ever </span><span begin="01:01.070" end="01:01.226">take </span><span begin="01:01.226" end="01:01.382">your </span><span begin="01:01.382" end="01:01.538">place</span><span begin="01:01.538" end="01:01.700">）</span></p><p ttm:agent="v1" begin="01:01.700" end="01:04.580"><span begin="01:01.700" end="01:02.060">You </span><span begin="01:02.060" end="01:02.450">are </span><span begin="01:02.450" end="01:02.750">the </span><span begin="01:02.750" end="01:03.530">dessert </span><span begin="01:03.530" end="01:03.920">to </span><span begin="01:03.920" end="01:04.190">my </span><span begin="01:04.190" end="01:04.580">supper</span></p><p ttm:agent="v1" begin="01:04.580" end="01:06.980"><span begin="01:04.580" end="01:04.580">（</span><span begin="01:04.580" end="01:05.240">Supper</span><span begin="01:05.240" end="01:05.240">, </span><span begin="01:05.240" end="01:05.840">flower</span><span begin="01:05.840" end="01:05.840">, </span><span begin="01:05.840" end="01:05.900">the </span><span begin="01:05.900" end="01:06.380">sweetness </span><span begin="01:06.380" end="01:06.560">to </span><span begin="01:06.560" end="01:06.710">my </span><span begin="01:06.710" end="01:06.950">sour</span><span begin="01:06.950" end="01:06.980">）</span></p><p ttm:agent="v1" begin="01:06.980" end="01:12.920"><span begin="01:06.980" end="01:07.100">You </span><span begin="01:07.100" end="01:07.340">bring </span><span begin="01:07.340" end="01:07.460">the </span><span begin="01:07.460" end="01:07.790">light </span><span begin="01:07.790" end="01:08.060">into </span><span begin="01:08.060" end="01:08.210">the </span><span begin="01:08.210" end="01:08.720">darkness </span><span begin="01:08.720" end="01:08.810">of </span><span begin="01:08.810" end="01:11.660">day</span><span begin="01:11.660" end="01:12.920">）</span></p><p ttm:agent="v1" begin="01:12.920" end="01:16.220"><span begin="01:12.920" end="01:13.190">And </span><span begin="01:13.190" end="01:13.310">it's </span><span begin="01:13.310" end="01:14.720">complicated </span><span begin="01:14.720" end="01:16.220">convoluted</span></p><p ttm:agent="v1" begin="01:16.220" end="01:18.830"><span begin="01:16.220" end="01:16.460">no </span><span begin="01:16.460" end="01:17.120">batteries </span><span begin="01:17.120" end="01:18.410">included</span></p><p ttm:agent="v1" begin="01:18.830" end="01:24.470"><span begin="01:18.830" end="01:19.160">When </span><span begin="01:19.160" end="01:19.280">you </span><span begin="01:19.280" end="01:20.120">picture </span><span begin="01:20.120" end="01:20.510">it </span><span begin="01:20.510" end="01:20.630">in </span><span begin="01:20.630" end="01:20.780">your </span><span begin="01:20.780" end="01:23.210">mind</span></p><p ttm:agent="v1" begin="01:24.470" end="01:26.270"><span begin="01:24.470" end="01:24.740">But </span><span begin="01:24.740" end="01:24.950">when </span><span begin="01:24.950" end="01:25.190">she</span><span begin="01:25.190" end="01:25.220">’</span><span begin="01:25.220" end="01:25.280">s </span><span begin="01:25.280" end="01:26.270">here</span></p><p ttm:agent="v1" begin="01:26.270" end="01:29.450"><span begin="01:26.270" end="01:27.350">Everything </span><span begin="01:27.350" end="01:27.650">falls </span><span begin="01:27.650" end="01:28.280">into </span><span begin="01:28.280" end="01:29.390">place</span></p><p ttm:agent="v1" begin="01:29.450" end="01:31.250"><span begin="01:29.450" end="01:29.720">Like </span><span begin="01:29.720" end="01:29.810">a </span><span begin="01:29.810" end="01:30.800">brushstroke </span><span begin="01:30.800" end="01:30.950">in </span><span begin="01:30.950" end="01:31.250">this</span></p><p ttm:agent="v1" begin="01:31.250" end="01:34.250"><span begin="01:31.250" end="01:32.150">Painting </span><span begin="01:32.150" end="01:32.450">of </span><span begin="01:32.450" end="01:32.690">her </span><span begin="01:32.690" end="01:32.900">and </span><span begin="01:32.900" end="01:34.250">i</span></p><p ttm:agent="v1" begin="01:34.250" end="01:35.450"><span begin="01:34.250" end="01:34.310">（</span><span begin="01:34.310" end="01:35.090">mm</span><span begin="01:35.090" end="01:35.450">）</span></p><p ttm:agent="v1" begin="01:35.450" end="01:38.540"><span begin="01:35.450" end="01:35.660">And </span><span begin="01:35.660" end="01:35.840">that</span><span begin="01:35.840" end="01:35.900">’</span><span begin="01:35.900" end="01:35.960">s </span><span begin="01:35.960" end="01:36.770">why </span><span begin="01:36.770" end="01:37.220">i </span><span begin="01:37.220" end="01:37.640">love </span><span begin="01:37.640" end="01:38.540">you</span></p><p ttm:agent="v1" begin="01:38.540" end="01:40.580"><span begin="01:38.540" end="01:38.540">（</span><span begin="01:38.540" end="01:38.600">You </span><span begin="01:38.600" end="01:38.780">bring </span><span begin="01:38.780" end="01:38.960">the </span><span begin="01:38.960" end="01:39.230">joy </span><span begin="01:39.230" end="01:39.560">into </span><span begin="01:39.560" end="01:39.710">the </span><span begin="01:39.710" end="01:40.190">darkness </span><span begin="01:40.190" end="01:40.370">of </span><span begin="01:40.370" end="01:40.580">dismay</span><span begin="01:40.580" end="01:40.580">）</span></p><p ttm:ag