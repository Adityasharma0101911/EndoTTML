<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Sweet Sacrifice</ttm:title><ttm:agent type="person" xml:id="v1">Evanescence</ttm:agent><ttm:item type="album">The Open Door</ttm:item><ttm:item type="spotify_id">7hlXiMxN81uctLsvbtHZ8x</ttm:item><itunes:duration>03:05.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:02.228" end="00:11.935"><span begin="00:02.228" end="00:02.926">It's </span><span begin="00:02.926" end="00:05.751">true  </span><span begin="00:05.751" end="00:06.052">we're </span><span begin="00:06.052" end="00:06.378">all </span><span begin="00:06.378" end="00:06.686">a </span><span begin="00:06.686" end="00:08.560">little </span><span begin="00:08.560" end="00:11.927">insane</span></p><p ttm:agent="v1" begin="00:11.635" end="00:15.840"><span begin="00:11.635" end="00:12.266">But </span><span begin="00:12.266" end="00:13.439">it's </span><span begin="00:13.439" end="00:14.346">so </span><span begin="00:14.346" end="00:15.840">clear</span></p><p ttm:agent="v1" begin="00:15.540" end="00:22.111"><span begin="00:15.540" end="00:16.081">Now </span><span begin="00:16.081" end="00:16.428">that </span><span begin="00:16.428" end="00:18.357">I'm </span><span begin="00:18.357" end="00:22.111">unchained</span></p><p ttm:agent="v1" begin="00:21.811" end="00:27.061"><span begin="00:21.811" end="00:22.834">Fear </span><span begin="00:22.834" end="00:23.122">is </span><span begin="00:23.122" end="00:23.939">only </span><span begin="00:23.939" end="00:24.844">in </span><span begin="00:24.844" end="00:25.430">our </span><span begin="00:25.430" end="00:27.056">minds</span></p><p ttm:agent="v1" begin="00:26.762" end="00:31.956"><span begin="00:26.762" end="00:27.993">Taking </span><span begin="00:27.993" end="00:29.197">over </span><span begin="00:29.197" end="00:29.926">all </span><span begin="00:29.926" end="00:30.436">the </span><span begin="00:30.436" end="00:31.951">time</span></p><p ttm:agent="v1" begin="00:31.656" end="00:36.359"><span begin="00:31.656" end="00:32.631">Fear </span><span begin="00:32.631" end="00:32.971">is </span><span begin="00:32.971" end="00:34.101">only </span><span begin="00:34.101" end="00:34.785">in </span><span begin="00:34.785" end="00:35.376">our </span><span begin="00:35.376" end="00:36.352">minds</span></p><p ttm:agent="v1" begin="00:36.195" end="00:51.106"><span begin="00:36.195" end="00:36.758">But </span><span begin="00:36.758" end="00:37.101">its </span><span begin="00:37.101" end="00:37.899">taking </span><span begin="00:37.899" end="00:39.090">over </span><span begin="00:39.090" end="00:39.706">all </span><span begin="00:39.706" end="00:40.269">the </span><span begin="00:40.269" end="00:51.106">time</span></p><p ttm:agent="v1" begin="00:50.806" end="00:56.350"><span begin="00:50.806" end="00:51.713">You </span><span begin="00:51.713" end="00:52.928">poor </span><span begin="00:52.928" end="00:54.259">sweet </span><span begin="00:54.259" end="00:55.777">innocent </span><span begin="00:55.777" end="00:56.342">thing</span></p><p ttm:agent="v1" begin="00:56.050" end="01:01.419"><span begin="00:56.050" end="00:56.959">Dry </span><span begin="00:56.959" end="00:57.207">your </span><span begin="00:57.207" end="00:58.521">eyes </span><span begin="00:58.521" end="00:58.941">and </span><span begin="00:58.941" end="01:01.416">testify</span></p><p ttm:agent="v1" begin="01:01.274" end="01:08.305"><span begin="01:01.274" end="01:01.822">You </span><span begin="01:01.822" end="01:02.853">know </span><span begin="01:02.853" end="01:04.207">you </span><span begin="01:04.207" end="01:04.831">live </span><span begin="01:04.831" end="01:05.075">to </span><span begin="01:05.075" end="01:05.656">break </span><span begin="01:05.656" end="01:06.306">me- </span><span begin="01:06.306" end="01:06.955">don't </span><span begin="01:06.955" end="01:08.304">deny</span></p><p ttm:agent="v1" begin="01:08.005" end="01:13.739"><span begin="01:08.005" end="01:09.030">Sweet </span><span begin="01:09.030" end="01:13.732">sacrifice</span></p><p ttm:agent="v1" begin="01:13.439" end="01:23.781"><span begin="01:13.439" end="01:14.879">One </span><span begin="01:14.879" end="01:17.385">day </span><span begin="01:17.385" end="01:17.855">I'm </span><span begin="01:17.855" end="01:18.440">gonna </span><span begin="01:18.440" end="01:20.254">forget </span><span begin="01:20.254" end="01:21.116">your </span><span begin="01:21.116" end="01:23.773">name</span></p><p ttm:agent="v1" begin="01:23.481" end="01:27.362"><span begin="01:23.481" end="01:24.043">And </span><span begin="01:24.043" end="01:25.115">one </span><span begin="01:25.115" end="01:26.093">sweet </span><span begin="01:26.093" end="01:27.357">day </span></p><p ttm:agent="v1" begin="01:27.062" end="01:33.836"><span begin="01:27.062" end="01:27.730">You're </span><span begin="01:27.730" end="01:28.003">gonna </span><span begin="01:28.003" end="01:28.538">drown </span><span begin="01:28.538" end="01:28.900">in </span><span begin="01:28.900" end="01:30.019">my </span><span begin="01:30.019" end="01:31.118">lost </span><span begin="01:31.118" end="01:33.835">pain</span></p><p ttm:agent="v1" begin="01:33.536" end="01:38.741"><span begin="01:33.536" end="01:34.407">Fear </span><span begin="01:34.407" end="01:34.736">is </span><span begin="01:34.736" end="01:35.966">only </span><span begin="01:35.966" end="01:36.553">in </span><span begin="01:36.553" end="01:37.171">our </span><span begin="01:37.171" end="01:38.737">minds</span></p><p ttm:agent="v1" begin="01:38.441" end="01:43.806"><span begin="01:38.441" end="01:39.585">Taking </span><span begin="01:39.585" end="01:40.902">over </span><span begin="01:40.902" end="01:41.656">all </span><span begin="01:41.656" end="01:42.138">the </span><span begin="01:42.138" end="01:43.803">time</span></p><p ttm:agent="v1" begin="01:43.506" end="01:48.096"><span begin="01:43.506" end="01:44.429">Fear </span><span begin="01:44.429" end="01:44.730">is </span><span begin="01:44.730" end="01:45.830">only </span><span begin="01:45.830" end="01:46.530">in </span><span begin="01:46.530" end="01:47.037">our </span><span begin="01:47.037" end="01:48.093">minds</span></p><p ttm:agent="v1" begin="01:47.768" end="01:57.918"><span begin="01:47.768" end="01:48.297">But </span><span begin="01:48.297" end="01:48.731">its </span><span begin="01:48.731" end="01:49.684">taking </span><span begin="01:49.684" end="01:50.754">over </span><span begin="01:50.754" end="01:51.410">all </span><span begin="01:51.410" end="01:52.058">the </span><span begin="01:52.058" end="01:57.915">time</span></p><p ttm:agent="v1" begin="01:57.618" end="02:03.193"><span begin="01:57.618" end="01:58.516">You </span><span begin="01:58.516" end="01:59.684">poor </span><span begin="01:59.684" end="02:01.058">sweet </span><span begin="02:01.058" end="02:02.630">innocent </span><span begin="02:02.630" end="02:03.185">thing</span></p><p ttm:agent="v1" begin="02:02.893" end="02:08.215"><span begin="02:02.893" end="02:03.773">Dry </span><span begin="02:03.773" end="02:04.037">your </span><span begin="02:04.037" end="02:05.409">eyes </span><span begin="02:05.409" end="02:05.734">and </span><span begin="02:05.734" end="02:08.209">testify</span></p><p ttm:agent="v1" begin="02:07.915" end="02:14.965"><span begin="02:07.915" end="02:08.502">And </span><span begin="02:08.502" end="02:09.646">oh </span><span begin="02:09.646" end="02:10.940">you </span><span begin="02:10.940" end="02:11.530">love </span><span begin="02:11.530" end="02:11.804">to </span><span begin="02:11.804" end="02:12.402">hate </span><span begin="02:12.402" end="02:13.075">me </span><span begin="02:13.075" end="02:13.695">don't </span><span begin="02:13.695" end="02:14.058">you  </span><span begin="02:14.058" end="02:14.958">honey </span></p><p ttm:agent="v1" begin="02:14.665" end="02:18.090"><span begin="02:14.665" end="02:15.312">I'm </span><span begin="02:15.312" end="02:15.658">your </span><span begin="02:15.658" end="02:18.081">sacrifice </span></p><p ttm:agent="v1" begin="02:17.790" end="02:21.352"><span begin="02:17.790" end="02:18.901">I </span><span begin="02:18.901" end="02:19.318">dream </span><span begin="02:19.318" end="02:19.607">in </span><span begin="02:19.607" end="02:21.351">darkness</span></p><p ttm:agent="v1" begin="02:21.052" end="02:23.915"><span begin="02:21.052" end="02:21.614">I </span><span begin="02:21.614" end="02:21.845">sleep </span><span begin="02:21.845" end="02:22.154">to </span><span begin="02:22.154" end="02:22.502">die </span><span begin="02:22.502" end="02:23.907">e</span></p><p ttm:agent="v1" begin="02:23.615" end="02:26.235"><span begin="02:23.615" end="02:24.127">Raise </span><span begin="02:24.127" end="02:24.471">the </span><span begin="02:24.471" end="02:26.234">silence</span></p><p ttm:agent="v1" begin="02:25.935" end="02:27.572"><span begin="02:25.935" end="02:26.469">Erase </span><span begin="02:26.469" end="02:26.751">my </span><span begin="02:26.751" end="02:27.564">life</span></p><p ttm:agent="v1" begin="02:27.272" end="02:30.695"><span begin="02:27.272" end="02:27.776">Do </span><span begin="02:27.776" end="02:28.101">you </span><span begin="02:28.101" end="02:29.942">wonder </span><span begin="02:29.942" end="02:30.173">why </span><span begin="02:30.173" end="02:30.511">you </span><span begin="02:30.511" end="02:30.687">hate </span></p><p ttm:agent="v1" begin="02:30.395" end="02:31.229"><span begin="02:30.395" end="02:30.881">（Our </span><span begin="02:30.881" end="02:31.049">burning </span><span begin="02:31.049" end="02:31.222">ashes）</span></p><p ttm:agent="v1" begin="02:30.929" end="02:32.052"><span begin="02:30.929" end="02:31.405">（Blacken </span><span begin="02:31.405" end="02:31.815">the </span><span begin="02:31.815" end="02:32.048">day）</span></p><p ttm:agent="v1" begin="02:31.752" end="02:34.734"><span begin="02:31.752" end="02:32.705">Are </span><span begin="02:32.705" end="02:33.037">you </span><span begin="02:33.037" end="02:33.602">still </span><span begin="02:33.602" end="02:34.158">too </span><span begin="02:34.158" end="02:34.733">weak</span></p><p ttm:agent="v1" begin="02:34.434" end="02:35.488"><span begin="02:34.434" end="02:34.903">（A </span><span begin="02:34.903" end="02:35.107">world </span><span begin="02:35.107" end="02:35.298">of </span><span begin="02:35.298" end="02:35.482">nothingness）</span></p><p ttm:agent="v1" begin="02:35.188" end="02:39.003"><span begin="02:35.188" end="02:35.668">To </span><span begin="02:35.668" end="02:36.142">survive </span><span begin="02:36.142" end="02:37.504">your </span><span begin="02:37.504" end="02:38.998">mistakes </span></p><p ttm:agent="v1" begin="02:38.703" end="02:39.826"><span begin="02:38.703" end="02:39.470">（Blow </span><span begin="02:39.470" end="02:39.648">me </span><span begin="02:39.648" end="02:39.821">away）</span></p><p ttm:agent="v1" begin="02:39.526" end="02:45.282"><span begin="02:39.526" end="02:40.650">You </span><span begin="02:40.650" end="02:41.851">poor </span><span begin="02:41.851" end="02:43.124">sweet </span><span begin="02:43.124" end="02:44.670">innocent </span><span begin="02:44.670" end="02:45.275">thing</span></p><p ttm:agent="v1" begin="02:44.982" end="02:50.342"><span begin="02:44.982" end="02:45.946">Dry </span><span begin="02:45.946" end="02:46.185">your </span><span begin="02:46.185" end="02:47.484">eyes </span><span begin="02:47.484" end="02:47.780">and </span><span begin="02:47.780" end="02:50.335">testify</span></p><p ttm:agent="v1" begin="02:50.042" end="02:57.314"><span begin="02:50.042" end="02:50.651">You </span><span begin="02:50.651" end="02:51.844">know </span><span begin="02:51.844" end="02:53.141">you </span><span begin="02:53.141" end="02:53.695">live </span><span begin="02:53.695" end="02:54.007">to </span><span begin="02:54.093" end="02:54.303">break </span><span begin="02:54.303" end="02:55.081">me- </span><span begin="02:55.081" end="02:56.003">don't </span><span begin="02:56.003" end="02:57.312">deny</span></p><p ttm:agent="v1" begin="02:57.092" end="03:00.515"><span begin="02:57.092" end="02:57.653">Sweet </span><span begin="02:57.653" end="03:00.515">sacrifice</span></p><p ttm:agent="v1" begin="03:00.215" end="03:02.906"><span begin="03:02.906" end="03:03.106">END</span></p></div></body></tt>