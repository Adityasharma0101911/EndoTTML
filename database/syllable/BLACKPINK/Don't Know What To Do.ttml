        <span begin="03:07.273" end="03:07.599">do </span>
        <span begin="03:07.599" end="03:08.024">without </span>
        <span begin="03:08.024" end="03:08.800">you</span>
      </p>
      <p begin="03:09.473" end="03:13.327" ttm:agent="v1">
        <span begin="03:09.473" end="03:09.936">하찮은 </span>
        <span begin="03:09.936" end="03:11.392">이곳에 </span>
        <span begin="03:11.392" end="03:12.104">홀로 </span>
        <span begin="03:12.104" end="03:13.327">남아</span>
      </p>
      <p begin="03:13.704" end="03:15.935" ttm:agent="v1">
        <span begin="03:13.704" end="03:14.336">그려본 </span>
        <span begin="03:14.336" end="03:14.609">네 </span>
        <span begin="03:14.609" end="03:15.305">기억은 </span>
        <span begin="03:15.305" end="03:15.935">blue</span>
      </p>
    </div>
  </body>
</tt>
