<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Poacher's Pride</ttm:title><ttm:agent type="person" xml:id="v1">Nicole Dollanganger</ttm:agent><ttm:item type="album">Natural Born Losers</ttm:item><ttm:item type="spotify_id">5InE7NRPIeNayZy5HhbUxD</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.090" end="00:06.990"><span begin="00:00.090" end="00:00.630">I </span><span begin="00:00.630" end="00:01.170">shot </span><span begin="00:01.170" end="00:01.530">an </span><span begin="00:01.530" end="00:02.820">angel </span><span begin="00:02.820" end="00:03.450">with </span><span begin="00:03.450" end="00:04.080">my </span><span begin="00:04.080" end="00:05.250">father's </span><span begin="00:05.250" end="00:06.990">rifle</span></p><p ttm:agent="v1" begin="00:06.990" end="00:12.870"><span begin="00:06.990" end="00:07.470">I </span><span begin="00:07.470" end="00:08.040">should </span><span begin="00:08.040" end="00:08.220">have </span><span begin="00:08.220" end="00:08.760">set </span><span begin="00:08.760" end="00:09.240">it </span><span begin="00:09.240" end="00:10.050">free</span><span begin="00:10.050" end="00:10.350">,</span><span begin="00:10.350" end="00:10.860">but </span><span begin="00:10.860" end="00:11.070">I </span><span begin="00:11.070" end="00:11.550">let </span><span begin="00:11.550" end="00:12.090">it </span><span begin="00:12.090" end="00:12.870">bleed</span></p><p ttm:agent="v1" begin="00:13.140" end="00:28.770"><span begin="00:13.140" end="00:13.620">Made </span><span begin="00:13.620" end="00:13.950">it </span><span begin="00:13.950" end="00:14.820">into </span><span begin="00:14.820" end="00:17.580">taxidermy</span><span begin="00:17.580" end="00:17.580">,</span><span begin="00:17.580" end="00:18.450">hung </span><span begin="00:18.450" end="00:19.080">it </span><span begin="00:19.080" end="00:19.680">on </span><span begin="00:19.680" end="00:20.370">my </span><span begin="00:20.370" end="00:22.830">wall </span><span begin="00:22.830" end="00:23.760">on </span><span begin="00:23.760" end="00:25.170">my </span><span begin="00:25.170" end="00:28.770">wall</span></p><p ttm:agent="v1" begin="00:33.150" end="00:40.050"><span begin="00:33.150" end="00:33.660">I </span><span begin="00:33.660" end="00:34.260">shot </span><span begin="00:34.260" end="00:34.590">an </span><span begin="00:34.590" end="00:35.790">angel</span><span begin="00:35.790" end="00:35.790">,</span><span begin="00:35.790" end="00:36.660">kept </span><span begin="00:36.660" end="00:36.990">it </span><span begin="00:36.990" end="00:37.470">in </span><span begin="00:37.470" end="00:38.250">my </span><span begin="00:38.250" end="00:40.050">backyard</span></p><p ttm:agent="v1" begin="00:40.050" end="00:45.960"><span begin="00:40.050" end="00:40.500">hung </span><span begin="00:40.500" end="00:41.190">it </span><span begin="00:41.190" end="00:42.120">out </span><span begin="00:42.120" end="00:42.390">to </span><span begin="00:42.390" end="00:43.500">dry </span><span begin="00:43.500" end="00:43.890">on </span><span begin="00:43.890" end="00:44.130">the </span><span begin="00:44.130" end="00:45.270">clothing </span><span begin="00:45.270" end="00:45.960">line</span></p><p ttm:agent="v1" begin="00:46.200" end="00:50.460"><span begin="00:46.200" end="00:46.740">Pinned </span><span begin="00:46.740" end="00:47.280">above </span><span begin="00:47.280" end="00:47.910">my </span><span begin="00:47.910" end="00:48.990">bed </span><span begin="00:48.990" end="00:49.410">like </span><span begin="00:49.410" end="00:49.620">the </span><span begin="00:49.620" end="00:50.460">cross</span></p><p ttm:agent="v1" begin="00:50.460" end="01:02.100"><span begin="00:50.460" end="00:50.670">of </span><span begin="00:50.670" end="00:52.770">jesus </span><span begin="00:52.770" end="00:55.950">christ </span><span begin="00:55.950" end="00:56.880">on </span><span begin="00:56.880" end="00:58.260">my </span><span begin="00:58.260" end="01:02.100">wall</span></p><p ttm:agent="v1" begin="01:04.500" end="01:13.470"><span begin="01:04.500" end="01:04.950">And </span><span begin="01:04.950" end="01:05.190">I </span><span begin="01:05.190" end="01:05.910">know </span><span begin="01:05.910" end="01:06.930">one </span><span begin="01:06.930" end="01:07.560">day </span><span begin="01:07.560" end="01:09.000">hell </span><span begin="01:09.000" end="01:09.600">will </span><span begin="01:09.600" end="01:10.500">catch </span><span begin="01:10.500" end="01:11.070">up </span><span begin="01:11.070" end="01:11.400">with </span><span begin="01:11.400" end="01:13.470">me</span></p><p ttm:agent="v1" begin="01:15.840" end="01:24.510"><span begin="01:15.840" end="01:16.350">And </span><span begin="01:16.350" end="01:17.130">I'm </span><span begin="01:17.130" end="01:17.940">sure </span><span begin="01:17.940" end="01:18.450">that </span><span begin="01:18.450" end="01:19.320">I </span><span begin="01:19.320" end="01:19.650">will </span><span begin="01:19.650" end="01:20.790">burn </span><span begin="01:20.790" end="01:24.510">eternally</span></p><p ttm:agent="v1" begin="01:26.880" end="01:34.650"><span begin="01:26.880" end="01:27.270">One </span><span begin="01:27.270" end="01:28.770">day </span><span begin="01:28.770" end="01:28.920">it </span><span begin="01:28.920" end="01:29.190">will </span><span begin="01:29.190" end="01:30.300">come </span><span begin="01:30.300" end="01:30.540">to </span><span begin="01:30.540" end="01:31.830">claim </span><span begin="01:31.830" end="01:32.070">its </span><span begin="01:32.070" end="01:33.300">pound </span><span begin="01:33.300" end="01:34.410">of </span><span begin="01:34.410" end="01:34.650">flesh</span></p><p ttm:agent="v1" begin="01:37.320" end="01:47.340"><span begin="01:37.320" end="01:38.400">When </span><span begin="01:38.400" end="01:39.360">it's </span><span begin="01:39.360" end="01:40.080">done</span><span begin="01:40.080" end="01:40.080">,</span><span begin="01:40.080" end="01:40.440">there </span><span begin="01:40.440" end="01:41.010">won't </span><span begin="01:41.010" end="01:42.150">be </span><span begin="01:42.150" end="01:44.550">anything </span><span begin="01:44.550" end="01:47.340">left</span></p><p ttm:agent="v1" begin="01:50.370" end="01:57.150"><span begin="01:50.370" end="01:50.880">I </span><span begin="01:50.880" end="01:51.510">shot </span><span begin="01:51.510" end="01:51.840">an </span><span begin="01:51.840" end="01:53.070">angel</span><span begin="01:53.070" end="01:53.070">,</span><span begin="01:53.070" end="01:53.910">dragged </span><span begin="01:53.910" end="01:54.150">it </span><span begin="01:54.150" end="01:54.720">to </span><span begin="01:54.720" end="01:55.530">my </span><span begin="01:55.530" end="01:57.150">basement</span></p><p ttm:agent="v1" begin="01:57.150" end="02:05.790"><span begin="01:57.150" end="01:58.080">Starved </span><span begin="01:58.080" end="01:58.620">it </span><span begin="01:58.620" end="01:59.130">till </span><span begin="01:59.130" end="01:59.670">it </span><span begin="01:59.670" end="02:00.750">died </span><span begin="02:00.750" end="02:01.170">and </span><span begin="02:01.170" end="02:01.380">I </span><span begin="02:01.380" end="02:01.740">did </span><span begin="02:01.740" end="02:02.400">not </span><span begin="02:02.400" end="02:05.790">cry</span></p><p ttm:agent="v1" begin="02:07.440" end="02:15.510"><span begin="02:07.440" end="02:09.810">Sickness </span><span begin="02:09.810" end="02:10.710">of </span><span begin="02:10.710" end="02:13.140">poacher's </span><span begin="02:13.140" end="02:15.510">pride</span></p></div></body></tt>