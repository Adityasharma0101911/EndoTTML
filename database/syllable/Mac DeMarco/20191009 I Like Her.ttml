7.995">feel </span><span begin="01:27.995" end="01:28.612">so </span><span begin="01:28.612" end="01:29.149">good</span></p><p ttm:agent="v1" begin="01:32.533" end="01:35.271"><span begin="01:32.533" end="01:32.821">Because </span><span begin="01:32.821" end="01:33.325">I </span><span begin="01:33.325" end="01:34.294">like </span><span begin="01:34.717" end="01:35.271">her</span></p><p ttm:agent="v1" begin="01:41.598" end="01:43.670"><span begin="01:41.598" end="01:41.869">Could </span><span begin="01:41.869" end="01:42.109">it </span><span begin="01:42.109" end="01:42.325">be </span><span begin="01:42.325" end="01:42.792">make </span><span begin="01:42.792" end="01:43.670">believe</span></p><p ttm:agent="v1" begin="01:45.047" end="01:47.692"><span begin="01:45.047" end="01:45.254">Am </span><span begin="01:45.254" end="01:45.646">I </span><span begin="01:45.646" end="01:45.934">just </span><span begin="01:45.934" end="01:46.694">walking </span><span begin="01:46.694" end="01:46.867">through </span><span begin="01:46.867" end="01:47.059">a </span><span begin="01:47.059" end="01:47.692">dream</span></p><p ttm:agent="v1" begin="01:55.796" end="01:57.997"><span begin="01:55.796" end="01:56.308">Haven't </span><span begin="01:56.308" end="01:56.621">felt </span><span begin="01:56.621" end="01:57.012">this </span><span begin="01:57.012" end="01:57.339">way </span><span begin="01:57.339" end="01:57.997">in</span></p><p ttm:agent="v1" begin="01:59.275" end="02:02.492"><span begin="01:59.275" end="01:59.485">Such </span><span begin="01:59.485" end="01:59.924">a </span><span begin="01:59.924" end="02:00.285">long </span><span begin="02:00.285" end="02:01.010">time </span><span begin="02:01.010" end="02:01.203">I </span><span begin="02:01.203" end="02:01.676">do </span><span begin="02:01.676" end="02:02.492">believe</span></p><p ttm:agent="v1" begin="02:08.723" end="02:11.001"><span begin="02:08.723" end="02:08.906">That </span><span begin="02:08.906" end="02:09.122">I </span><span begin="02:09.122" end="02:09.394">like </span><span begin="02:10.577" end="02:11.001">her</span></p></div></body></tt>