<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Watching Him Fade Away</ttm:title><ttm:agent type="person" xml:id="v1">Mac DeMarco</ttm:agent><ttm:item type="album">This Old Dog</ttm:item><ttm:item type="spotify_id">2QzKAF0y1BQhxwg8N05Uog</ttm:item><itunes:duration>02:23.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:08.093" end="00:10.644"><span begin="00:08.093" end="00:08.485">Haven't </span><span begin="00:08.485" end="00:08.795">got </span><span begin="00:08.795" end="00:09.002">the </span><span begin="00:09.002" end="00:09.441">guts </span><span begin="00:09.441" end="00:09.728">to </span><span begin="00:09.728" end="00:10.063">call </span><span begin="00:10.063" end="00:10.221">him </span><span begin="00:10.221" end="00:10.644">up</span></p><p ttm:agent="v1" begin="00:15.292" end="00:20.657"><span begin="00:15.292" end="00:15.563">Walk </span><span begin="00:15.563" end="00:15.874">around </span><span begin="00:15.874" end="00:16.153">as </span><span begin="00:16.153" end="00:16.496">if </span><span begin="00:16.496" end="00:16.743">you </span><span begin="00:16.743" end="00:17.119">never </span><span begin="00:17.119" end="00:18.877">cared </span><span begin="00:18.877" end="00:19.108">in </span><span begin="00:19.108" end="00:19.323">the </span><span begin="00:19.323" end="00:19.642">first </span><span begin="00:19.642" end="00:20.657">place</span></p><p ttm:agent="v1" begin="00:22.316" end="00:25.275"><span begin="00:22.316" end="00:22.587">But </span><span begin="00:22.587" end="00:22.730">if </span><span begin="00:22.730" end="00:22.897">you </span><span begin="00:22.897" end="00:23.104">never </span><span begin="00:23.104" end="00:23.591">call </span><span begin="00:23.591" end="00:23.902">you'll </span><span begin="00:23.902" end="00:24.173">end </span><span begin="00:24.173" end="00:24.492">up </span><span begin="00:24.492" end="00:25.275">stuck</span></p><p ttm:agent="v1" begin="00:29.196" end="00:32.309"><span begin="00:29.196" end="00:29.563">Without </span><span begin="00:29.563" end="00:29.938">another </span><span begin="00:29.938" end="00:30.481">chance </span><span begin="00:30.481" end="00:30.744">to </span><span begin="00:30.744" end="00:31.039">tell </span><span begin="00:31.039" end="00:31.254">him </span><span begin="00:31.254" end="00:32.309">off</span></p><p ttm:agent="v1" begin="00:32.572" end="00:34.360"><span begin="00:32.572" end="00:32.755">Right </span><span begin="00:32.755" end="00:33.042">to </span><span begin="00:33.042" end="00:33.313">his </span><span begin="00:33.313" end="00:34.360">face</span></p><p ttm:agent="v1" begin="00:36.284" end="00:37.833"><span begin="00:36.284" end="00:36.491">And </span><span begin="00:36.491" end="00:36.810">even </span><span begin="00:36.810" end="00:37.833">though</span></p><p ttm:agent="v1" begin="00:38.796" end="00:40.857"><span begin="00:38.796" end="00:38.995">We </span><span begin="00:38.995" end="00:39.194">barely </span><span begin="00:39.194" end="00:39.657">know </span><span begin="00:39.657" end="00:40.034">each </span><span begin="00:40.034" end="00:40.857">other</span></p><p ttm:agent="v1" begin="00:41.350" end="00:44.515"><span begin="00:41.350" end="00:41.597">It </span><span begin="00:41.597" end="00:42.348">still </span><span begin="00:43.548" end="00:44.515">hurts</span></p><p ttm:agent="v1" begin="00:45.590" end="00:49.410"><span begin="00:45.590" end="00:46.197">Watching </span><span begin="00:46.197" end="00:46.572">him </span><span begin="00:46.572" end="00:48.123">fade </span><span begin="00:48.123" end="00:49.410">away</span></p><p ttm:agent="v1" begin="00:52.310" end="00:55.922"><span begin="00:52.310" end="00:52.957">Watching </span><span begin="00:52.957" end="00:53.396">him </span><span begin="00:53.396" end="00:54.899">fade </span><span begin="00:54.899" end="00:55.922">away</span></p><p ttm:agent="v1" begin="00:59.166" end="01:03.258"><span begin="00:59.166" end="00:59.925">Watching </span><span begin="00:59.925" end="01:00.316">him </span><span begin="01:00.316" end="01:02.131">fade </span><span begin="01:02.131" end="01:03.258">away</span></p><p ttm:agent="v1" begin="01:06.006" end="01:09.466"><span begin="01:06.006" end="01:06.565">Watching </span><span begin="01:06.565" end="01:06.956">him </span><span begin="01:06.956" end="01:08.515">fade </span><span begin="01:08.515" end="01:09.466">away</span></p><p ttm:agent="v1" begin="01:17.022" end="01:20.301"><span begin="01:17.022" end="01:17.229">I </span><span begin="01:17.229" end="01:17.420">know </span><span begin="01:17.420" end="01:17.619">you </span><span begin="01:17.619" end="01:17.874">never </span><span begin="01:17.874" end="01:18.305">meant </span><span begin="01:18.305" end="01:18.576">to </span><span begin="01:18.576" end="01:18.847">put </span><span begin="01:18.847" end="01:19.054">him </span><span begin="01:19.054" end="01:20.301">down</span></p><p ttm:agent="v1" begin="01:23.966" end="01:29.115"><span begin="01:23.966" end="01:24.181">And </span><span begin="01:24.181" end="01:24.356">even </span><span begin="01:24.356" end="01:24.531">if </span><span begin="01:24.531" end="01:24.760">you </span><span begin="01:24.760" end="01:25.855">did </span><span begin="01:25.855" end="01:26.846">he </span><span begin="01:26.846" end="01:27.805">sure </span><span begin="01:27.805" end="01:28.508">deserved </span><span begin="01:28.508" end="01:29.115">it</span></p><p ttm:agent="v1" begin="01:30.844" end="01:34.020"><span begin="01:30.844" end="01:31.043">The </span><span begin="01:31.043" end="01:31.226">thought </span><span begin="01:31.226" end="01:31.361">of </span><span begin="01:31.361" end="01:31.520">him </span><span begin="01:31.520" end="01:31.783">no </span><span begin="01:31.783" end="01:32.270">longer </span><span begin="01:32.270" end="01:32.837">being </span><span begin="01:32.837" end="01:34.020">around</span></p><p ttm:agent="v1" begin="01:37.732" end="01:43.057"><span begin="01:37.732" end="01:37.907">Well </span><span begin="01:37.907" end="01:38.074">sure </span><span begin="01:38.074" end="01:38.217">it </span><span begin="01:38.217" end="01:38.392">would </span><span begin="01:38.392" end="01:38.743">be </span><span begin="01:38.743" end="01:39.557">sad </span><span begin="01:39.557" end="01:39.876">but </span><span begin="01:39.876" end="01:40.899">not </span><span begin="01:40.899" end="01:41.954">really </span><span begin="01:41.954" end="01:43.057">different</span></p><p ttm:agent="v1" begin="01:44.810" end="01:46.365"><span begin="01:44.810" end="01:44.936">And </span><span begin="01:44.936" end="01:45.190">even </span><span begin="01:45.190" end="01:46.365">though</span></p><p ttm:agent="v1" begin="01:47.496" end="01:49.391"><span begin="01:47.496" end="01:47.743">We </span><span begin="01:47.743" end="01:48.054">barely </span><span begin="01:48.054" end="01:48.445">know </span><span begin="01:48.445" end="01:48.799">each </span><span begin="01:48.799" end="01:49.391">other</span></p><p ttm:agent="v1" begin="01:50.164" end="01:53.178"><span begin="01:50.164" end="01:50.387">It </span><span begin="01:50.387" end="01:51.143">still </span><span begin="01:52.243" end="01:53.178">hurts</span></p><p ttm:agent="v1" begin="01:54.477" end="01:58.449"><span begin="01:54.477" end="01:55.196">Watching </span><span begin="01:55.196" end="01:55.555">him </span><span begin="01:55.555" end="01:57.002">fade </span><span begin="01:57.002" end="01:58.449">away</span></p><p ttm:agent="v1" begin="02:01.349" end="02:05.653"><span begin="02:01.349" end="02:01.980">Watching </span><span begin="02:01.980" end="02:02.379">him </span><span begin="02:02.379" end="02:04.422">fade </span><span begin="02:04.422" end="02:05.653">away</span></p><p ttm:agent="v1" begin="02:08.289" end="02:12.317"><span begin="02:08.289" end="02:08.936">Watching </span><span begin="02:08.936" end="02:09.455">him </span><span begin="02:09.455" end="02:11.342">fade </span><span begin="02:11.342" end="02:12.317">away</span></p><p ttm:agent="v1" begin="02:15.273" end="02:19.267"><span begin="02:15.273" end="02:15.777">Watching </span><span begin="02:15.777" end="02:16.161">him </span><span begin="02:16.161" end="02:17.539">fade </span><span begin="02:17.539" end="02:19.267">away</span></p></div></body></tt>