1:28.670">miss </span><span begin="01:28.670" end="01:29.060">me</span></p><p ttm:agent="v1" begin="01:29.090" end="01:30.620"><span begin="01:29.090" end="01:29.390">You've </span><span begin="01:29.390" end="01:29.630">got </span><span begin="01:29.630" end="01:29.690">a </span><span begin="01:29.690" end="01:30.050">dirty </span><span begin="01:30.050" end="01:30.350">tongue </span><span begin="01:30.350" end="01:30.620">and</span></p><p ttm:agent="v1" begin="01:30.620" end="01:32.810"><span begin="01:30.620" end="01:30.830">Looks </span><span begin="01:30.830" end="01:30.980">like </span><span begin="01:30.980" end="01:31.100">the </span><span begin="01:31.100" end="01:31.520">damage </span><span begin="01:31.520" end="01:31.730">done </span><span begin="01:31.730" end="01:31.970">is </span><span begin="01:31.970" end="01:32.600">forever </span><span begin="01:32.600" end="01:32.810">and</span></p><p ttm:agent="v1" begin="01:32.810" end="01:34.640"><span begin="01:32.810" end="01:32.960">It's </span><span begin="01:32.960" end="01:33.050">a </span><span begin="01:33.050" end="01:33.410">long </span><span begin="01:33.410" end="01:33.800">time </span><span begin="01:33.800" end="01:33.950">to </span><span begin="01:33.950" end="01:34.280">miss </span><span begin="01:34.280" end="01:34.640">me</span></p><p ttm:agent="v1" begin="01:34.640" end="01:38.270"><span begin="01:34.640" end="01:36.860">Whoa </span><span begin="01:36.860" end="01:38.270">oh</span></p><p ttm:agent="v1" begin="01:38.270" end="01:40.280"><span begin="01:38.270" end="01:38.420">And </span><span begin="01:38.420" end="01:38.630">it's </span><span begin="01:38.630" end="01:38.720">a </span><span begin="01:38.720" end="01:39.080">long </span><span begin="01:39.080" end="01:39.470">time </span><span begin="01:39.470" end="01:39.620">to </span><span begin="01:39.620" end="01:39.950">miss </span><span begin="01:39.950" end="01:40.280">me</span></p><p ttm:agent="v1" begin="01:40.280" end="01:44.600"><span begin="01:40.280" end="01:42.530">Whoa </span><span begin="01:42.530" end="01:44.600">oh</span></p><p ttm:agent="v1" begin="01:45.050" end="01:54.530"><span begin="01:45.050" end="01:45.350">And </span><span begin="01:45.350" end="01:45.560">I </span><span begin="01:45.560" end="01:47.870">don't </span><span begin="01:47.870" end="01:48.680">feel </span><span begin="01:48.680" end="01:49.280">sorry </span><span begin="01:49.280" end="01:49.580">for </span><span begin="01:49.580" end="01:51.170">you</span><span begin="01:51.170" end="01:51.410">, </span><span begin="01:51.410" end="01:52.130">sorry </span><span begin="01:52.130" end="01:52.430">for </span><span begin="01:52.430" end="01:54.530">you</span></p><p ttm:agent="v1" begin="01:54.710" end="01:57.380"><span begin="01:54.710" end="01:55.070">Cause </span><span begin="01:55.070" end="01:55.460">now </span><span begin="01:55.460" end="01:55.730">the </span><span begin="01:55.730" end="01:56.540">table's </span><span begin="01:56.540" end="01:57.380">turning</span></p><p ttm:agent="v1" begin="01:57.620" end="02:00.200"><span begin="01:57.620" end="01:57.800">And </span><span begin="01:57.800" end="01:58.280">now </span><span begin="01:58.280" end="01:58.460">the </span><span begin="01:58.460" end="01:59.090">bridge </span><span begin="01:59.090" end="01:59.360">is </span><span begin="01:59.360" end="02:00.200">burning</span></p><p ttm:agent="v1" begin="02:00.380" end="02:04.190"><span begin="02:00.380" end="02:00.710">It's </span><span begin="02:00.710" end="02:01.400">coming </span><span begin="02:01.400" end="02:02.000">crashing </span><span begin="02:02.000" end="02:02.690">down</span><span begin="02:02.690" end="02:02.810">, </span><span begin="02:02.810" end="02:03.440">crashing </span><span begin="02:03.440" end="02:04.190">down</span></p><p ttm:agent="v1" begin="02:09.920" end="02:28.370"><span begin="02:09.920" end="02:11.300">Over </span><span begin="02:11.300" end="02:11.510">you </span><span begin