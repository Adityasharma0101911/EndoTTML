<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Crying At The Airport</ttm:title><ttm:agent type="person" xml:id="v1">Ebony Loren</ttm:agent><ttm:item type="album">Crying At The Airport</ttm:item><ttm:item type="spotify_id">3gn79DAsSqsMIN61JBrXzv</ttm:item><itunes:duration>03:21.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:11.577" end="00:14.441"><span begin="00:11.577" end="00:11.881">Woke </span><span begin="00:11.881" end="00:12.200">up </span><span begin="00:12.200" end="00:12.792">at </span><span begin="00:12.792" end="00:13.536">5</span><span begin="00:13.536" end="00:14.441">am</span></p><p ttm:agent="v1" begin="00:14.441" end="00:16.983"><span begin="00:14.441" end="00:14.809">Just </span><span begin="00:14.809" end="00:15.209">to </span><span begin="00:15.481" end="00:15.825">have </span><span begin="00:15.825" end="00:16.163">a </span><span begin="00:16.163" end="00:16.479">few </span><span begin="00:16.479" end="00:16.983">more</span></p><p ttm:agent="v1" begin="00:17.199" end="00:18.854"><span begin="00:17.199" end="00:17.656">Hours </span><span begin="00:17.656" end="00:18.032">to </span><span begin="00:18.032" end="00:18.854">spend</span></p><p ttm:agent="v1" begin="00:19.327" end="00:22.265"><span begin="00:19.327" end="00:20.189">Watching </span><span begin="00:20.189" end="00:20.614">the </span><span begin="00:20.614" end="00:22.265">sunrise</span></p><p ttm:agent="v1" begin="00:22.606" end="00:24.493"><span begin="00:22.606" end="00:22.950">That </span><span begin="00:22.950" end="00:23.294">was </span><span begin="00:23.294" end="00:23.679">the </span><span begin="00:23.679" end="00:24.182">first </span><span begin="00:24.182" end="00:24.493">time</span></p><p ttm:agent="v1" begin="00:24.683" end="00:26.218"><span begin="00:24.683" end="00:24.852">That </span><span begin="00:24.852" end="00:25.156">I </span><span begin="00:25.156" end="00:26.218">cried</span></p><p ttm:agent="v1" begin="00:26.839" end="00:32.588"><span begin="00:26.839" end="00:27.327">'Cuz </span><span begin="00:27.327" end="00:27.825">I </span><span begin="00:28.054" end="00:29.553">knew </span><span begin="00:30.113" end="00:30.408">soon </span><span begin="00:30.408" end="00:30.627">as </span><span begin="00:30.627" end="00:30.971">I </span><span begin="00:31.163" end="00:31.491">saw </span><span begin="00:31.491" end="00:31.779">the </span><span begin="00:31.779" end="00:32.588">sun</span></p><p ttm:agent="v1" begin="00:33.986" end="00:36.861"><span begin="00:33.986" end="00:34.411">This </span><span begin="00:34.411" end="00:34.795">day </span><span begin="00:34.795" end="00:35.203">would </span><span begin="00:35.203" end="00:35.594">soon </span><span begin="00:35.594" end="00:36.139">be </span><span begin="00:36.139" end="00:36.861">done</span></p><p ttm:agent="v1" begin="00:36.861" end="00:40.010"><span begin="00:36.861" end="00:37.285">And </span><span begin="00:37.285" end="00:37.829">you'd </span><span begin="00:37.829" end="00:38.165">be </span><span begin="00:38.348" end="00:38.896">on </span><span begin="00:38.896" end="00:39.247">your </span><span begin="00:39.247" end="00:40.010">way</span></p><p ttm:agent="v1" begin="00:40.506" end="00:44.115"><span begin="00:40.506" end="00:40.986">On </span><span begin="00:40.986" end="00:41.394">a </span><span begin="00:41.394" end="00:42.026">plane </span><span begin="00:42.266" end="00:42.994">across </span><span begin="00:42.994" end="00:43.306">the </span><span begin="00:43.306" end="00:44.115">world</span></p><p ttm:agent="v1" begin="00:44.115" end="00:48.042"><span begin="00:44.115" end="00:44.490">And </span><span begin="00:44.490" end="00:45.009">I'd </span><span begin="00:45.296" end="00:45.625">be </span><span begin="00:45.625" end="00:46.273">on </span><span begin="00:46.273" end="00:46.673">my </span><span begin="00:46.673" end="00:47.201">own </span><span begin="00:47.456" end="00:48.042">again</span></p><p ttm:agent="v1" begin="00:48.605" end="00:56.349"><span begin="00:48.605" end="00:49.859">Crying </span><span begin="00:49.859" end="00:50.443">at </span><span begin="00:50.443" end="00:50.851">the </span><span begin="00:50.851" end="00:51.892">airport </span><span begin="00:52.300" end="00:52.836">by </span><span begin="00:52.836" end="00:56.349">myself</span></p><p ttm:agent="v1" begin="01:02.992" end="01:06.271"><span begin="01:02.992" end="01:03.263">We </span><span begin="01:03.263" end="01:03.560">pack </span><span begin="01:03.560" end="01:03.936">up </span><span begin="01:03.936" end="01:04.464">our </span><span begin="01:04.464" end="01:05.111">things </span><span begin="01:05.335" end="01:05.615">to </span><span begin="01:05.615" end="01:06.271">go</span></p><p ttm:agent="v1" begin="01:06.871" end="01:10.091"><span begin="01:06.871" end="01:07.175">Both </span><span begin="01:07.175" end="01:07.567">of </span><span begin="01:07.567" end="01:07.998">us </span><span begin="01:08.191" end="01:08.930">moving </span><span begin="01:09.199" end="01:09.615">so </span><span begin="01:09.615" end="01:10.091">slow</span></p><p ttm:agent="v1" begin="01:10.339" end="01:13.444"><span begin="01:10.339" end="01:10.691">To </span><span begin="01:10.691" end="01:11.330">leave </span><span begin="01:11.330" end="01:11.682">the </span><span begin="01:11.682" end="01:12.572">hotel </span><span begin="01:12.572" end="01:13.444">room</span></p><p ttm:agent="v1" begin="01:13.972" end="01:17.236"><span begin="01:13.972" end="01:14.324">It's </span><span begin="01:14.324" end="01:15.036">all </span><span begin="01:15.036" end="01:16.276">happening </span><span begin="01:16.459" end="01:16.780">too </span><span begin="01:16.780" end="01:17.236">soon</span></p><p ttm:agent="v1" begin="01:18.220" end="01:21.052"><span begin="01:18.220" end="01:18.724">So </span><span begin="01:18.724" end="01:19.500">I </span><span begin="01:19.500" end="01:21.052">stop</span></p><p ttm:agent="v1" begin="01:21.524" end="01:25.172"><span begin="01:21.524" end="01:21.812">To </span><span begin="01:21.812" end="01:22.164">look </span><span begin="01:22.164" end="01:22.460">you </span><span begin="01:22.460" end="01:22.964">in </span><span begin="01:22.964" end="01:23.389">the </span><span begin="01:23.389" end="01:25.172">eyes</span></p><p ttm:agent="v1" begin="01:25.518" end="01:28.843"><span begin="01:25.518" end="01:25.932">As </span><span begin="01:25.932" end="01:26.324">if </span><span begin="01:26.324" end="01:26.708">this </span><span begin="01:26.708" end="01:27.220">is </span><span begin="01:27.220" end="01:27.683">the </span><span begin="01:27.683" end="01:28.524">last </span><span begin="01:28.524" end="01:28.843">time</span></p><p ttm:agent="v1" begin="01:28.843" end="01:31.501"><span begin="01:28.843" end="01:29.467">That </span><span begin="01:29.467" end="01:29.915">we'll </span><span begin="01:29.915" end="01:30.779">ever </span><span begin="01:30.779" end="01:31.501">be</span></p><p ttm:agent="v1" begin="01:31.699" end="01:35.588"><span begin="01:31.699" end="01:32.867">Together </span><span begin="01:32.867" end="01:33.271">in </span><span begin="01:33.271" end="01:33.810">a </span><span begin="01:33.810" end="01:34.380">place </span><span begin="01:34.380" end="01:34.844">like </span><span begin="01:34.844" end="01:35.588">this</span></p><p ttm:agent="v1" begin="01:35.860" end="01:38.812"><span begin="01:35.860" end="01:36.276">I </span><span begin="01:36.276" end="01:36.692">give </span><span begin="01:36.692" end="01:37.141">you </span><span begin="01:37.141" end="01:37.676">one </span><span begin="01:37.676" end="01:38.124">last </span><span begin="01:38.124" end="01:38.812">kiss</span></p><p ttm:agent="v1" begin="01:39.212" end="01:42.691"><span begin="01:39.212" end="01:39.996">Before </span><span begin="01:39.996" end="01:40.663">I'm </span><span begin="01:40.663" end="01:41.654">crying </span><span begin="01:41.913" end="01:42.346">at </span><span begin="01:42.346" end="01:42.691">the</span></p><p ttm:agent="v1" begin="01:42.691" end="01:47.538"><span begin="01:42.691" end="01:43.602">Airport </span><span begin="01:44.026" end="01:44.514">by </span><span begin="01:44.514" end="01:47.538">myself</span></p><p ttm:agent="v1" begin="01:54.009" end="01:57.836"><span begin="01:54.009" end="01:54.959">Watching </span><span begin="01:54.959" end="01:55.432">the </span><span begin="01:55.432" end="01:55.928">world </span><span begin="01:56.096" end="01:56.472">pass </span><span begin="01:56.472" end="01:56.864">us </span><span begin="01:56.864" end="01:57.836">by</span></p><p ttm:agent="v1" begin="01:58.308" end="02:01.601"><span begin="01:58.308" end="01:58.748">I </span><span begin="01:58.748" end="01:59.164">can't </span><span begin="01:59.164" end="01:59.684">help </span><span begin="01:59.684" end="02:00.156">but </span><span begin="02:00.156" end="02:00.582">check </span><span begin="02:00.582" end="02:01.076">the </span><span begin="02:01.076" end="02:01.601">time</span></p><p ttm:agent="v1" begin="02:01.856" end="02:05.137"><span begin="02:01.856" end="02:02.179">It </span><span begin="02:02.179" end="02:02.663">keeps </span><span begin="02:02.838" end="02:03.592">getting </span><span begin="02:03.592" end="02:05.137">away</span></p><p ttm:agent="v1" begin="02:05.400" end="02:09.111"><span begin="02:05.400" end="02:05.744">Now </span><span begin="02:05.744" end="02:06.192">there's </span><span begin="02:06.192" end="02:07.097">nothing </span><span begin="02:07.271" end="02:07.560">left </span><span begin="02:07.560" end="02:07.888">to </span><span begin="02:07.888" end="02:09.111">say</span></p><p ttm:agent="v1" begin="02:09.654" end="02:15.799"><span begin="02:09.654" end="02:10.415">So </span><span begin="02:10.415" end="02:12.079">I </span><span begin="02:12.543" end="02:12.994">put </span><span begin="02:12.994" end="02:13.351">your </span><span begin="02:13.351" end="02:13.870">hand </span><span begin="02:13.870" end="02:14.223">in </span><span begin="02:14.223" end="02:15.799">mine</span></p><p ttm:agent="v1" begin="02:16.303" end="02:19.221"><span begin="02:16.303" end="02:16.671">And </span><span begin="02:16.671" end="02:17.063">try </span><span begin="02:17.063" end="02:17.399">not </span><span begin="02:17.399" end="02:17.831">to </span><span begin="02:17.831" end="02:19.221">acknowledge</span></p><p ttm:agent="v1" begin="02:19.501" end="02:21.891"><span begin="02:19.501" end="02:20.178">The </span><span begin="02:20.178" end="02:21.891">reality</span></p><p ttm:agent="v1" begin="02:22.130" end="02:26.114"><span begin="02:22.130" end="02:22.570">You </span><span begin="02:22.570" end="02:23.075">won't </span><span begin="02:23.075" end="02:23.442">be </span><span begin="02:23.442" end="02:24.202">coming </span><span begin="02:24.498" end="02:24.962">home </span><span begin="02:24.962" end="02:25.490">with </span><span begin="02:25.490" end="02:26.114">me</span></p><p ttm:agent="v1" begin="02:26.385" end="02:30.386"><span begin="02:26.385" end="02:26.786">And </span><span begin="02:26.786" end="02:27.282">I'll </span><span begin="02:27.282" end="02:27.602">be </span><span begin="02:27.602" end="02:28.041">on </span><span begin="02:28.041" end="02:28.530">my </span><span begin="02:28.530" end="02:29.274">own </span><span begin="02:29.274" end="02:30.386">again</span></p><p ttm:agent="v1" begin="02:30.978" end="02:38.387"><span begin="02:30.978" end="02:32.058">Crying </span><span begin="02:32.058" end="02:32.602">at </span><span begin="02:32.602" end="02:33.066">the </span><span begin="02:33.066" end="02:34.210">airport </span><span begin="02:34.497" end="02:35.082">by </span><span begin="02:35.082" end="02:38.387">myself</span></p><p ttm:agent="v1" begin="02:43.632" end="02:47.839"><span begin="02:43.632" end="02:44.256">Now </span><span begin="02:44.256" end="02:44.864">I'm </span><span begin="02:45.048" end="02:45.808">bracing </span><span begin="02:45.992" end="02:46.416">for </span><span begin="02:46.416" end="02:46.727">the </span><span begin="02:46.727" end="02:47.839">pain</span></p><p ttm:agent="v1" begin="02:48.304" end="02:52.425"><span begin="02:48.304" end="02:48.840">Try </span><span begin="02:48.840" end="02:49.327">to </span><span begin="02:49.327" end="02:50.568">memorize </span><span begin="02:50.736" end="02:51.043">your </span><span begin="02:51.043" end="02:52.425">face</span></p><p ttm:agent="v1" begin="02:52.896" end="02:57.155"><span begin="02:52.896" end="02:53.592">Look </span><span begin="02:53.592" end="02:54.168">back </span><span begin="02:54.168" end="02:54.576">at </span><span begin="02:54.576" end="02:55.093">me </span><span begin="02:55.349" end="02:56.094">one </span><span begin="02:56.094" end="02:56.709">last </span><span begin="02:56.709" end="02:57.155">time</span></p><p ttm:agent="v1" begin="02:57.355" end="03:00.711"><span begin="02:57.355" end="02:58.319">Before </span><span begin="02:58.319" end="02:58.775">you </span><span begin="02:58.775" end="02:59.295">walk </span><span begin="02:59.295" end="03:00.711">away</span></p><p ttm:agent="v1" begin="03:00.943" end="03:05.695"><span begin="03:00.943" end="03:01.287">And </span><span begin="03:01.287" end="03:01.623">leave </span><span begin="03:01.623" end="03:02.039">me </span><span begin="03:02.039" end="03:03.183">standing </span><span begin="03:03.479" end="03:04.135">all </span><span begin="03:04.135" end="03:05.695">alone</span></p><p ttm:agent="v1" begin="03:06.550" end="03:13.235"><span begin="03:06.550" end="03:07.639">Crying </span><span begin="03:07.919" end="03:08.470">at </span><span begin="03:08.470" end="03:08.879">the </span><span begin="03:08.879" end="03:10.267">airport </span><span begin="03:10.476" end="03:11.019">by </span><span begin="03:11.019" end="03:13.235">myself</span></p></div></body></tt>