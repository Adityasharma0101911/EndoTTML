<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Chamomile</ttm:title><ttm:agent type="person" xml:id="v1">Jeff Bernat</ttm:agent><ttm:item type="album">Love, Jeffrey</ttm:item><ttm:item type="spotify_id">6oYfq3ryu8EiJDTWpdngI6</ttm:item><itunes:duration>02:32.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:13.052" end="00:15.404"><span begin="00:13.052" end="00:13.232">I </span><span begin="00:13.232" end="00:13.428">think </span><span begin="00:13.428" end="00:13.669">you're </span><span begin="00:13.669" end="00:14.020">better </span><span begin="00:14.020" end="00:14.227">with </span><span begin="00:14.227" end="00:14.486">the </span><span begin="00:14.486" end="00:14.891">lights </span><span begin="00:14.891" end="00:15.404">on</span></p><p ttm:agent="v1" begin="00:16.091" end="00:18.957"><span begin="00:16.091" end="00:16.267">But </span><span begin="00:16.267" end="00:16.420">I'll </span><span begin="00:16.420" end="00:16.571">take </span><span begin="00:16.571" end="00:16.771">you </span><span begin="00:16.771" end="00:17.075">any </span><span begin="00:17.075" end="00:17.339">type </span><span begin="00:17.339" end="00:17.580">of </span><span begin="00:17.580" end="00:18.957">way</span></p><p ttm:agent="v1" begin="00:19.212" end="00:21.831"><span begin="00:19.212" end="00:19.419">The </span><span begin="00:19.419" end="00:19.611">way </span><span begin="00:19.611" end="00:19.819">you </span><span begin="00:19.819" end="00:19.956">soothe </span><span begin="00:19.956" end="00:20.173">me </span><span begin="00:20.173" end="00:20.490">all </span><span begin="00:20.490" end="00:20.931">night </span><span begin="00:20.931" end="00:21.831">long</span></p><p ttm:agent="v1" begin="00:22.256" end="00:24.999"><span begin="00:22.256" end="00:22.466">The </span><span begin="00:22.466" end="00:22.863">perfect </span><span begin="00:22.863" end="00:23.154">way </span><span begin="00:23.154" end="00:23.303">to </span><span begin="00:23.303" end="00:23.488">end </span><span begin="00:23.488" end="00:23.746">the </span><span begin="00:23.746" end="00:24.999">day</span></p><p ttm:agent="v1" begin="00:25.731" end="00:27.797"><span begin="00:25.731" end="00:25.920">Girl </span><span begin="00:25.920" end="00:26.079">I </span><span begin="00:26.079" end="00:26.255">need </span><span begin="00:26.255" end="00:26.415">you </span><span begin="00:26.415" end="00:26.583">like </span><span begin="00:26.583" end="00:26.790">some </span><span begin="00:26.790" end="00:27.324">hot </span><span begin="00:27.324" end="00:27.797">tea</span></p><p ttm:agent="v1" begin="00:28.423" end="00:31.228"><span begin="00:28.423" end="00:28.599">You </span><span begin="00:28.599" end="00:28.807">fill </span><span begin="00:28.807" end="00:29.015">my </span><span begin="00:29.015" end="00:29.247">cup </span><span begin="00:29.247" end="00:29.431">like </span><span begin="00:29.431" end="00:30.084">nothing </span><span begin="00:30.084" end="00:31.228">else</span></p><p ttm:agent="v1" begin="00:31.533" end="00:34.492"><span begin="00:31.533" end="00:31.730">Don't </span><span begin="00:31.730" end="00:31.890">need </span><span begin="00:31.890" end="00:32.074">to </span><span begin="00:32.074" end="00:32.281">mix </span><span begin="00:32.281" end="00:32.481">you </span><span begin="00:32.481" end="00:32.657">with </span><span begin="00:32.657" end="00:32.937">no </span><span begin="00:32.937" end="00:34.492">others</span></p><p ttm:agent="v1" begin="00:34.901" end="00:37.439"><span begin="00:34.901" end="00:35.116">I'll </span><span begin="00:35.116" end="00:35.322">take </span><span begin="00:35.322" end="00:35.572">you </span><span begin="00:35.572" end="00:35.818">by </span><span begin="00:35.818" end="00:37.439">yourself</span></p><p ttm:agent="v1" begin="00:38.249" end="00:43.174"><span begin="00:38.249" end="00:38.466">You </span><span begin="00:38.466" end="00:38.673">just </span><span begin="00:38.673" end="00:38.881">got </span><span begin="00:38.881" end="00:39.177">a </span><span begin="00:39.177" end="00:40.673">peaceful </span><span begin="00:40.673" end="00:41.434">kind </span><span begin="00:41.434" end="00:41.864">of </span><span begin="00:41.864" end="00:43.174">love</span></p><p ttm:agent="v1" begin="00:43.174" end="00:45.316"><span begin="00:43.174" end="00:43.486">And </span><span begin="00:43.486" end="00:43.830">I </span><span begin="00:43.830" end="00:44.205">can't </span><span begin="00:44.205" end="00:44.895">get </span><span begin="00:44.895" end="00:45.316">enough</span></p><p ttm:agent="v1" begin="00:45.316" end="00:47.060"><span begin="00:45.316" end="00:46.122">Chamomile </span><span begin="00:46.337" end="00:47.060">chamomile</span></p><p ttm:agent="v1" begin="00:47.316" end="00:50.356"><span begin="00:47.316" end="00:47.508">Been </span><span begin="00:47.508" end="00:47.861">looking </span><span begin="00:47.861" end="00:48.052">for </span><span begin="00:48.052" end="00:48.289">you </span><span begin="00:48.289" end="00:48.580">in </span><span begin="00:48.580" end="00:48.861">a </span><span begin="00:48.861" end="00:49.205">pile </span><span begin="00:49.454" end="00:49.846">for </span><span begin="00:49.846" end="00:50.356">awhile</span></p><p ttm:agent="v1" begin="00:50.534" end="00:53.218"><span begin="00:50.534" end="00:50.684">I'm </span><span begin="00:50.684" end="00:50.764">glad </span><span begin="00:50.764" end="00:51.024">I </span><span begin="00:51.024" end="00:51.445">found </span><span begin="00:51.445" end="00:53.218">you</span></p><p ttm:agent="v1" begin="00:53.919" end="00:57.518"><span begin="00:53.919" end="00:54.097">Now </span><span begin="00:54.097" end="00:54.325">there's </span><span begin="00:54.325" end="00:55.013">something </span><span begin="00:55.013" end="00:55.389">about </span><span begin="00:55.389" end="00:55.764">you </span><span begin="00:55.764" end="00:56.108">that </span><span begin="00:56.108" end="00:56.540">keeps </span><span begin="00:56.540" end="00:57.518">steeping</span></p><p ttm:agent="v1" begin="00:57.518" end="00:59.485"><span begin="00:57.518" end="00:58.358">Chamomile </span><span begin="00:58.597" end="00:59.485">chamomile</span></p><p ttm:agent="v1" begin="00:59.694" end="01:02.630"><span begin="00:59.694" end="00:59.854">I </span><span begin="00:59.854" end="01:00.022">need </span><span begin="01:00.022" end="01:00.196">to </span><span begin="01:00.196" end="01:00.380">have </span><span begin="01:00.380" end="01:00.620">you </span><span begin="01:00.620" end="01:01.100">every </span><span begin="01:01.100" end="01:01.476">night </span><span begin="01:01.749" end="01:02.229">every </span><span begin="01:02.229" end="01:02.630">time</span></p><p ttm:agent="v1" begin="01:02.669" end="01:05.590"><span begin="01:02.669" end="01:02.854">So </span><span begin="01:02.854" end="01:03.029">what </span><span begin="01:03.029" end="01:03.257">am </span><span begin="01:03.257" end="01:03.486">I </span><span begin="01:03.486" end="01:03.729">to </span><span begin="01:03.729" end="01:05.590">do</span></p><p ttm:agent="v1" begin="01:06.104" end="01:11.363"><span begin="01:06.104" end="01:06.303">Girl </span><span begin="01:06.303" end="01:06.592">you're </span><span begin="01:06.592" end="01:07.261">something </span><span begin="01:07.261" end="01:07.669">I'm </span><span begin="01:07.669" end="01:08.069">gonna </span><span begin="01:08.069" end="01:08.462">need </span><span begin="01:08.462" end="01:08.661">for </span><span begin="01:08.661" end="01:08.877">the </span><span begin="01:08.877" end="01:09.173">rest </span><span begin="01:09.173" end="01:09.365">of </span><span begin="01:09.365" end="01:09.722">my </span><span begin="01:09.722" end="01:11.363">life</span></p><p ttm:agent="v1" begin="01:11.492" end="01:14.281"><span begin="01:11.492" end="01:11.687">There </span><span begin="01:11.687" end="01:11.892">ain't </span><span begin="01:11.892" end="01:12.025">no </span><span begin="01:12.025" end="01:12.275">thing </span><span begin="01:12.275" end="01:12.468">as </span><span begin="01:12.468" end="01:12.697">way </span><span begin="01:12.697" end="01:13.008">too </span><span begin="01:13.008" end="01:14.281">much</span></p><p ttm:agent="v1" begin="01:14.438" end="01:17.590"><span begin="01:14.438" end="01:14.609">And </span><span begin="01:14.609" end="01:14.774">I </span><span begin="01:14.774" end="01:14.951">don't </span><span begin="01:14.951" end="01:15.143">care </span><span begin="01:15.143" end="01:15.319">that </span><span begin="01:15.319" end="01:15.518">you </span><span begin="01:15.518" end="01:15.725">could </span><span begin="01:15.725" end="01:16.022">be </span><span begin="01:16.022" end="01:17.590">dangerous</span></p><p ttm:agent="v1" begin="01:17.624" end="01:20.195"><span begin="01:17.624" end="01:17.832">You're </span><span begin="01:17.832" end="01:18.287">burning </span><span begin="01:18.287" end="01:18.511">me </span><span begin="01:18.511" end="01:18.697">with </span><span begin="01:18.697" end="01:19.139">every </span><span begin="01:19.139" end="01:20.195">touch</span></p><p ttm:agent="v1" begin="01:20.355" end="01:23.569"><span begin="01:20.355" end="01:20.501">And </span><span begin="01:20.501" end="01:20.745">ooh </span><span begin="01:20.745" end="01:20.935">you </span><span begin="01:20.935" e