<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Have Me Again - demo</ttm:title><ttm:agent type="person" xml:id="v1">Rocco</ttm:agent><ttm:item type="album">Apples</ttm:item><ttm:item type="spotify_id">3DIuGax1cNXv74PnmDYAtd</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:11.740" end="00:17.800"><span begin="00:11.740" end="00:11.780">You</span><span begin="00:11.830" end="00:12.110"> found</span><span begin="00:12.400" end="00:12.700"> your</span><span begin="00:13.300" end="00:13.340"> way</span><span begin="00:13.390" end="00:13.630"> back</span><span begin="00:13.870" end="00:14.260"> to</span><span begin="00:14.830" end="00:14.900"> my</span><span begin="00:14.980" end="00:15.490"> mind,</span><span begin="00:16.290" end="00:16.350"> I</span><span begin="00:16.420" end="00:16.640"> hate</span><span begin="00:16.870" end="00:17.800"> it</span></p><p ttm:agent="v1" begin="00:17.800" end="00:21.980"><span begin="00:17.800" end="00:17.870">At</span><span begin="00:17.950" end="00:18.200"> least,</span><span begin="00:18.460" end="00:18.580"> we</span><span begin="00:18.700" end="00:19.090"> can</span><span begin="00:19.120" end="00:19.630"> say</span><span begin="00:19.870" end="00:20.200"> that</span><span begin="00:20.620" end="00:20.680"> we</span><span begin="00:20.740" end="00:21.980"> tried</span></p><p ttm:agent="v1" begin="00:21.980" end="00:26.720"><span begin="00:21.980" end="00:22.120">But</span><span begin="00:22.250" end="00:22.360"> you've</span><span begin="00:22.460" end="00:23.360"> taken</span><span begin="00:23.840" end="00:23.890"> a</span><span begin="00:23.930" end="00:24.260"> piece</span><span begin="00:24.590" end="00:24.830"> of</span><span begin="00:24.980" end="00:26.480"> myself</span></p><p ttm:agent="v1" begin="00:26.720" end="00:34.720"><span begin="00:26.720" end="00:26.840">There's</span><span begin="00:26.960" end="00:27.750"> nobody</span><span begin="00:28.550" end="00:28.760"> else</span><span begin="00:28.970" end="00:29.210"> quite</span><span begin="00:29.450" end="00:29.870"> like</span><span begin="00:30.470" end="00:30.730"> you,</span><span begin="00:31.910" end="00:32.230"> quite</span><span begin="00:32.480" end="00:32.900"> like</span><span begin="00:33.500" end="00:34.720"> you</span></p><p ttm:agent="v1" begin="00:35.680" end="00:38.250"><span begin="00:35.680" end="00:35.760">My</span><span begin="00:35.850" end="00:36.630"> darling,</span><span begin="00:37.260" end="00:37.360"> my</span><span begin="00:37.470" end="00:37.660"> love</span><span begin="00:37.860" end="00:38.180"> (ah-</span><span begin="00:38.180" end="00:38.220"> ah-</span><span begin="00:38.220" end="00:38.720"> ah)</span></p><p ttm:agent="v1" begin="00:38.250" end="00:41.720"><span begin="00:38.250" end="00:38.360">Could</span><span begin="00:38.480" end="00:38.550"> I</span><span begin="00:38.630" end="00:38.760"> still</span><span begin="00:38.890" end="00:39.070"> call</span><span begin="00:39.250" end="00:39.330"> you</span><span begin="00:39.420" end="00:39.550"> that?</span><span begin="00:39.690" end="00:41.660"> (Ah-</span><span begin="00:41.660" end="00:41.690"> ah-</span><span begin="00:41.690" end="00:42.190"> ah)</span></p><p ttm:agent="v1" begin="00:41.720" end="00:47.210"><span begin="00:41.720" end="00:41.780">I</span><span begin="00:41.840" end="00:42.500"> wouldn't</span><span begin="00:42.980" end="00:43.160"> wanna</span><span begin="00:43.340" end="00:43.880"> call</span><span begin="00:43.990" end="00:44.540"> this</span><span begin="00:44.780" end="00:45.060"> crawling</span><span begin="00:45.350" end="00:46.850"> back</span></p><p ttm:agent="v1" begin="00:47.210" end="00:50.420"><span begin="00:47.210" end="00:47.330">But</span><span begin="00:47.450" end="00:47.600"> if</span><span begin="00:47.750" end="00:47.940"> you'll</span><span begin="00:48.140" end="00:48.410"> have</span><span begin="00:48.680" end="00:48.980"> me</span><span begin="00:50.300" end="00:50.330"> (ah-</span><span begin="00:50.330" end="00:50.360"> ah-</span><span begin="00:50.360" end="00:50.860"> ah)</span></p><p ttm:agent="v1" begin="00:50.420" end="00:55.390"><span begin="00:50.420" end="00:50.430">Oh,</span><span begin="00:50.450" end="00:50.660"> would</span><span begin="00:51.230" end="00:51.260"> you</span><span begin="00:51.290" end="00:51.480"> have</span><span begin="00:51.680" end="00:52.010"> me</span><span begin="00:53.570" end="00:53.850"> again?</span><span begin="00:54.140" end="00:55.310"> (Ah-</span><span begin="00:55.310" end="00:55.340"> ah-</span><span begin="00:55.340" end="00:55.840"> ah)</span></p><p ttm:agent="v1" begin="00:55.390" end="00:59.670"><span begin="00:55.390" end="00:55.550">We</span><span begin="00:55.720" end="00:55.870"> had</span><span begin="00:56.230" end="00:57.010"> something</span><span begin="00:57.280" end="00:58.780"> going</span></p><p ttm:agent="v1" begin="00:59.670" end="01:02.750"><span begin="00:59.670" end="00:59.790">From</span><span begin="00:59.910" end="00:59.950"> your</span><span begin="01:00.000" end="01:00.580"> fingers</span><span begin="01:01.170" end="01:01.240"> to</span><span begin="01:01.320" end="01:01.410"> your</span><span begin="01:01.500" end="01:02.750"> lips</span></p><p ttm:agent="v1" begin="01:02.750" end="01:04.940"><span begin="01:02.750" end="01:02.870">What's</span><span begin="01:02.990" end="01:03.530"> hard</span><span begin="01:03.980" end="01:04.160"> to</span><span begin="01:04.340" end="01:04.940"> admit?</span></p><p ttm:agent="v1" begin="01:04.940" end="01:09.010"><span begin="01:04.940" end="01:05.300">That</span><span begin="01:05.450" end="01:05.550"> I</span><span begin="01:05.660" end="01:05.940"> still</span><span begin="01:06.230" end="01:06.770"> think</span><span begin="01:07.310" end="01:07.650"> about</span><span begin="01:08.000" end="01:09.010"> you</span></p><p ttm:agent="v1" begin="01:09.010" end="01:14.750"><span begin="01:09.010" end="01:09.440">Hour</span><span begin="01:09.880" end="01:10.150"> after</span><span begin="01:10.420" end="01:10.970"> hour,</span><span begin="01:11.530" end="01:11.640"> I</span><span begin="01:11.760" end="01:12.390"> still</span><span begin="01:13.020" end="01:13.170"> keep</span><span begin="01:13.330" end="01:13.370"> it</span><span begin="01:13.420" end="01:14.750"> close</span></p><p ttm:agent="v1" begin="01:14.750" end="01:17.600"><span begin="01:14.750" end="01:14.790">Though</span><span begin="01:14.840" end="01:14.900"> I</span><span begin="01:14.960" end="01:15.210"> let</span><span begin="01:15.470" end="01:15.740"> your</span><span begin="01:15.770" end="01:16.220"> heart</span><span begin="01:16.460" end="01:17.600"> go</span></p><p ttm:agent="v1" begin="01:17.600" end="01:20.280"><span begin="01:17.600" end="01:17.690">My</span><span begin="01:17.780" end="01:18.590"> darling,</span><span begin="01:19.130" end="01:19.260"> my</span><span begin="01:19.400" end="01:19.740"> love</span><span begin="01:20.090" end="01:20.120"> (ah-</span><span begin="01:20.120" end="01:20.150"> ah-</span><span begin="01:20.150" end="01:20.650"> ah)</span></p><p ttm:agent="v1" begin="01:20.280" end="01:23.760"><span begin="01:20.280" end="01:20.390">Could</span><span begin="01:20.510" end="01:20.580"> I</span><span begin="01:20.660" end="01:20.780"> still</span><span begin="01:20.890" end="01:21.120"> call</span><span begin="01:21.340" end="01:21.400"> you</span><span begin="01:21.460" end="01:21.850"> that?</span><span begin="01:22.250" end="01:23.700"> (Ah-</span><span begin="01:23.700" end="01:23.730"> ah-</span><span begin="01:23.730" end="01:24.230"> ah)</span></p><p ttm:agent="v1" begin="01:23.760" end="01:29.280"><span begin="01:23.760" end="01:23.830">I</span><span begin="01:23.910" end="01:24.690"> wouldn't</span><span begin="01:24.990" end="01:25.180"> wanna</span><span begin="01:25.380" end="01:25.660"> call</span><span begin="01:25.950" end="01:26.580"> this</span><span begin="01:26.820" end="01:27.190"> crawling</span><span begin="01:27.570" end="01:29.070"> back</span></p><p ttm:agent="v1" begin="01:29.280" end="01:32.340"><span begin="01:29.280" end="01:29.490">But</span><span begin="01:29.610" end="01:29.720"> if</span><span begin="01:29.840" end="01:29.930"> you'll</span><span begin="01:30.030" end="01:30.370"> have</span><span begin="01:30.720" end="01:30.780"> me</span><span begin="01:32.220" end="01:32.250"> (ah-</span><span begin="01:32.250" end="01:32.280"> ah-</span><span begin="01:32.280" end="01:32.780"> ah)</span></p><p ttm:agent="v1" begin="01:32.340" end="01:36.340"><span begin="01:32.340" end="01:32.430">Oh,</span><span begin="01:32.520" end="01:32.760"> would</span><span begin="01:33.240" end="01:33.260"> you</span><span begin="01:33.300" end="01:33.500"> have</span><span begin="01:33.710" end="01:34.240"> me</span><span begin="01:34.770" end="01:35.260"> again?</span><span begin="01:35.760" end="01:35.790"> (Ah-</span><span begin="01:35.790" end="01:35.820"> ah-</span><span begin="01:35.820" end="01:36.340"> ah)</span></p></div></body></tt>