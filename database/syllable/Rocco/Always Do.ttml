<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Always Do</ttm:title><ttm:agent type="person" xml:id="v1">Rocco</ttm:agent><ttm:item type="album">Her Favorite Flowers</ttm:item><ttm:item type="spotify_id">11xv68WXiyKy1nC60SAmZk</ttm:item><itunes:duration>02:16.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:10.527" end="00:15.126"><span begin="00:10.527" end="00:10.703">The </span><span begin="00:10.703" end="00:10.902">thing </span><span begin="00:10.902" end="00:11.326">about </span><span begin="00:11.326" end="00:12.519">love </span><span begin="00:13.302" end="00:13.734">people </span><span begin="00:13.734" end="00:14.118">don't </span><span begin="00:14.118" end="00:15.126">say</span></p><p ttm:agent="v1" begin="00:16.979" end="00:20.652"><span begin="00:16.979" end="00:17.155">It's </span><span begin="00:17.155" end="00:17.547">all </span><span begin="00:17.547" end="00:18.315">just </span><span begin="00:18.315" end="00:19.379">elusive </span><span begin="00:19.379" end="00:19.747">in </span><span begin="00:19.747" end="00:20.652">pain</span></p><p ttm:agent="v1" begin="00:21.164" end="00:23.931"><span begin="00:21.164" end="00:21.379">But </span><span begin="00:21.379" end="00:21.579">the </span><span begin="00:21.579" end="00:21.924">thing </span><span begin="00:21.924" end="00:22.523">about </span><span begin="00:22.523" end="00:23.931">us</span></p><p ttm:agent="v1" begin="00:24.268" end="00:25.955"><span begin="00:24.268" end="00:24.444">It's </span><span begin="00:24.444" end="00:24.915">written </span><span begin="00:24.915" end="00:25.179">in </span><span begin="00:25.179" end="00:25.955">stone</span></p><p ttm:agent="v1" begin="00:26.795" end="00:29.081"><span begin="00:26.795" end="00:26.980">I'll </span><span begin="00:26.980" end="00:27.348">find </span><span begin="00:27.348" end="00:27.747">my </span><span begin="00:27.747" end="00:28.012">way </span><span begin="00:28.012" end="00:28.636">back </span><span begin="00:28.636" end="00:28.843">to </span><span begin="00:28.843" end="00:29.081">ya</span></p><p ttm:agent="v1" begin="00:29.648" end="00:32.673"><span begin="00:29.648" end="00:29.809">No </span><span begin="00:29.809" end="00:30.097">matter </span><span begin="00:30.097" end="00:30.633">where </span><span begin="00:30.633" end="00:30.873">we </span><span begin="00:30.873" end="00:31.098">go </span><span begin="00:31.762" end="00:32.673">oh</span></p><p ttm:agent="v1" begin="00:33.193" end="00:37.053"><span begin="00:33.193" end="00:33.538">So </span><span begin="00:33.538" end="00:33.817">I'll </span><span begin="00:33.817" end="00:34.258">send </span><span begin="00:34.258" end="00:35.044">my </span><span begin="00:35.044" end="00:35.532">heart </span><span begin="00:35.532" end="00:35.789">out </span><span begin="00:35.789" end="00:36.148">to </span><span begin="00:36.148" end="00:37.053">you</span></p><p ttm:agent="v1" begin="00:37.941" end="00:40.227"><span begin="00:37.941" end="00:38.125">You </span><span begin="00:38.125" end="00:38.292">don't </span><span begin="00:38.292" end="00:38.572">need </span><span begin="00:38.572" end="00:38.916">to </span><span begin="00:38.916" end="00:39.188">say </span><span begin="00:39.188" end="00:39.531">a </span><span begin="00:39.531" end="00:40.227">word</span></p><p ttm:agent="v1" begin="00:41.196" end="00:43.797"><span begin="00:41.196" end="00:41.245">Just </span><span begin="00:41.989" end="00:42.461">hold </span><span begin="00:42.461" end="00:43.013">out </span><span begin="00:43.013" end="00:43.430">your </span><span begin="00:43.430" end="00:43.797">hand</span></p><p ttm:agent="v1" begin="00:44.086" end="00:48.485"><span begin="00:44.086" end="00:44.278">And </span><span begin="00:44.278" end="00:44.519">it </span><span begin="00:44.519" end="00:44.845">will </span><span begin="00:44.845" end="00:45.405">find </span><span begin="00:45.836" end="00:46.140">its </span><span begin="00:46.140" end="00:46.517">way </span><span begin="00:46.517" end="00:46.853">back </span><span begin="00:46.853" end="00:47.172">to </span><span begin="00:47.172" end="00:48.485">you</span></p><p ttm:agent="v1" begin="00:48.940" end="00:50.748"><span begin="00:48.940" end="00:49.132">Like </span><span begin="00:49.132" end="00:49.604">I </span><span begin="00:49.604" end="00:49.988">always </span><span begin="00:49.988" end="00:50.748">do</span></p><p ttm:agent="v1" begin="00:52.996" end="00:54.292"><span begin="00:52.996" end="00:54.292">Mhm</span></p><p ttm:agent="v1" begin="00:57.332" end="00:59.405"><span begin="00:57.332" end="00:57.628">Maybe </span><span begin="00:57.628" end="00:58.085">it's </span><span begin="00:58.085" end="00:58.300">the </span><span begin="00:58.300" end="00:58.822">things </span><span begin="00:58.822" end="00:59.037">you </span><span begin="00:59.037" end="00:59.405">say?</span></p><p ttm:agent="v1" begin="01:01.205" end="01:04.930"><span begin="01:01.205" end="01:01.373">Or </span><span begin="01:01.373" end="01:01.509">the </span><span begin="01:01.509" end="01:01.864">way </span><span begin="01:02.480" end="01:02.792">your </span><span begin="01:02.792" end="01:03.600">hair </span><span begin="01:03.600" end="01:03.976">falls </span><span begin="01:03.976" end="01:04.930">down?</span></p><p ttm:agent="v1" begin="01:06.769" end="01:08.722"><span begin="01:06.769" end="01:06.954">Oh </span><span begin="01:06.954" end="01:07.169">I </span><span begin="01:07.169" end="01:07.385">don't </span><span begin="01:07.385" end="01:07.657">know </span><span begin="01:07.657" end="01:07.882">what </span><span begin="01:07.882" end="01:08.154">brings </span><span begin="01:08.154" end="01:08.329">me </span><span begin="01:08.329" end="01:08.722">back?</span></p><p ttm:agent="v1" begin="01:09.761" end="01:11.738"><span begin="01:09.761" end="01:10.057">Maybe </span><span begin="01:10.057" end="01:10.313">our </span><span begin="01:10.313" end="01:10.610">souls </span><span begin="01:10.610" end="01:10.866">are </span><span begin="01:10.866" end="01:11.738">attached?</span></p><p ttm:agent="v1" begin="01:12.465" end="01:14.548"><span begin="01:12.465" end="01:12.818">Maybe </span><span begin="01:12.818" end="01:13.025">we </span><span begin="01:13.025" end="01:13.305">met </span><span begin="01:13.305" end="01:13.553">in </span><span begin="01:13.553" end="01:14.202">another </span><span begin="01:14.202" end="01:14.548">life?</span></p><p ttm:agent="v1" begin="01:15.148" end="01:17.255"><span begin="01:15.148" end="01:15.348">Or </span><span begin="01:15.348" end="01:15.580">I </span><span begin="01:15.580" end="01:15.892">just </span><span begin="01:15.892" end="01:16.156">miss </span><span begin="01:16.156" end="01:16.404">when </span><span begin="01:16.404" end="01:16.620">you </span><span begin="01:16.620" end="01:16.892">hold </span><span begin="01:16.892" end="01:17.100">me </span><span begin="01:17.100" end="01:17.255">tight?</span></p><p ttm:agent="v1" begin="01:17.872" end="01:21.540"><span begin="01:17.872" end="01:18.271">I </span><span begin="01:18.615" end="01:18.852">don't </span><span begin="01:19.299" end="01:19.908">have </span><span begin="01:19.908" end="01:20.340">the </span><span begin="01:20.340" end="01:21.540">answers</span></p><p ttm:agent="v1" begin="01:22.131" end="01:23.940"><span begin="01:22.131" end="01:22.332">All </span><span begin="01:22.332" end="01:22.508">I </span><span begin="01:22.508" end="01:22.772">got </span><span begin="01:22.772" end="01:23.068">is </span><span begin="01:23.068" end="01:23.940">you</span></p><p ttm:agent="v1" begin="01:24.684" end="01:27.116"><span begin="01:24.684" end="01:24.844">And </span><span begin="01:24.844" end="01:25.004">as </span><span begin="01:25.004" end="01:25.236">long </span><span begin="01:25.236" end="01:25.492">as </span><span begin="01:25.492" end="01:25.836">that's </span><span begin="01:25.836" end="01:27.116">true</span></p><p ttm:agent="v1" begin="01:28.860" end="01:32.300"><span begin="01:28.860" end="01:29.036">I'll </span><span begin="01:29.036" end="01:29.636">send </span><span begin="01:29.636" end="01:30.100">my </span><span begin="01:30.100" end="01:30.764">heart </span><span begin="01:30.764" end="01:31.036">out </span><span begin="01:31.036" end="01:31.380">to </span><span begin="01:31.380" end="01:32.300">you</span></p><p ttm:agent="v1" begin="01:33.108" end="01:35.732"><span begin="01:33.108" end="01:33.284">You </span><span begin="01:33.284" end="01:33.468">don't </span><span begin="01:33.468" end="01:33.724">need </span><span begin="01:33.724" end="01:34.061">to </span><span begin="01:34.061" end="01:34.756">say </span><span begin="01:34.756" end="01:34.924">a </span><span begin="01:34.924" end="01:35.732">word</span></p><p ttm:agent="v1" begin="01:36.436" end="01:38.893"><span begin="01:36.436" end="01:36.453">Just </span><span begin="01:37.172" end="01:37.582">hold </span><span begin="01:37.582" end="01:38.124">out </span><span begin="01:38.124" end="01:38.549">your </span><span begin="01:38.549" end="01:38.893">hand</span></p><p ttm:agent="v1" begin="01:39.220" end="01:43.552"><span begin="01:39.220" end="01:39.413">And </span><span begin="01:39.413" end="01:39.637">it </span><span begin="01:39.637" end="01:39.917">will </span><span begin="01:39.917" end="01:40.440">find </span><span begin="01:41.064" end="01:41.336">its </span><span begin="01:41.336" end="01:41.719">way </span><span begin="01:41.719" end="01:41.983">back </span><span begin="01:41.983" end="01:42.352">to </span><span begin="01:42.352" end="01:43.552">you</span></p><p ttm:agent="v1" begin="01:44.119" end="01:45.880"><span begin="01:44.119" end="01:44.288">Like </span><span begin="01:44.288" end="01:44.519">I </span><span begin="01:44.519" end="01:45.135">always </span><span begin="01:45.135" end="01:45.880">do</span></p><p ttm:agent="v1" begin="01:48.136" end="01:49.560"><span begin="01:48.136" end="01:49.560">Mhm</span></p></div></body></tt>