70" end="00:22.230">）</span></p><p ttm:agent="v1" begin="00:22.230" end="00:25.560"><span begin="00:22.230" end="00:22.470">So </span><span begin="00:22.470" end="00:22.830">pretty </span><span begin="00:22.830" end="00:23.040">that </span><span begin="00:23.040" end="00:23.160">you're </span><span begin="00:23.160" end="00:23.490">kil </span><span begin="00:23.490" end="00:23.610">me </span><span begin="00:23.610" end="00:24.450">softly </span><span begin="00:24.450" end="00:24.450">（</span><span begin="00:24.450" end="00:24.480">Ooh</span><span begin="00:24.480" end="00:24.510">-</span><span begin="00:24.510" end="00:24.540">ooh</span><span begin="00:24.540" end="00:24.600">-</span><span begin="00:24.600" end="00:25.530">ooh</span><span begin="00:25.530" end="00:25.560">）</span></p><p ttm:agent="v1" begin="00:25.560" end="00:28.140"><span begin="00:25.560" end="00:25.770">If </span><span begin="00:25.770" end="00:25.920">you </span><span begin="00:25.920" end="00:26.100">were </span><span begin="00:26.100" end="00:26.190">to </span><span begin="00:26.190" end="00:26.790">leave </span><span begin="00:26.790" end="00:28.140">me</span></p><p ttm:agent="v1" begin="00:28.200" end="00:30.420"><span begin="00:28.200" end="00:28.440">If </span><span begin="00:28.440" end="00:28.590">I </span><span begin="00:28.590" end="00:28.740">were </span><span begin="00:28.740" end="00:28.830">to </span><span begin="00:28.830" end="00:30.420">die</span></p><p ttm:agent="v1" begin="00:32.460" end="00:35.940"><span begin="00:32.460" end="00:32.580">You </span><span begin="00:32.580" end="00:32.850">know </span><span begin="00:32.850" end="00:32.940">I </span><span begin="00:32.940" end="00:33.240">really </span><span begin="00:33.240" end="00:33.600">wanna </span><span begin="00:33.600" end="00:33.990">risk </span><span begin="00:33.990" end="00:34.170">it </span><span begin="00:34.170" end="00:34.860">all </span><span begin="00:34.860" end="00:34.860">（</span><span begin="00:34.860" e