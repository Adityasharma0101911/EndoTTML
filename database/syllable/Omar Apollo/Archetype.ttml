0.580" end="00:50.820">Don't </span><span begin="00:50.820" end="00:51.150">want </span><span begin="00:51.150" end="00:51.510">this </span><span begin="00:51.510" end="00:51.570">to </span><span begin="00:51.570" end="00:51.720">end</span><span begin="00:51.720" end="00:51.720">）</span></p><p ttm:agent="v1" begin="00:51.720" end="00:53.820"><span begin="00:51.720" end="00:52.140">Could </span><span begin="00:52.140" end="00:52.350">you </span><span begin="00:52.350" end="00:53.190">help </span><span begin="00:53.190" end="00:53.820">me</span><span begin="00:53.820" end="00:53.820">?</span></p><p ttm:agent="v1" begin="00:53.820" end="00:56.190"><span begin="00:53.820" end="00:54.150">Hope </span><span begin="00:54.150" end="00:54.450">you </span><span begin="00:54.450" end="00:54.870">think </span><span begin="00:54.870" end="00:55.800">about </span><span begin="00:55.800" end="00:56.190">me</span></p><p ttm:agent="v1" begin="00:56.370" end="00:58.740"><span begin="00:56.370" end="00:56.640">I </span><span begin="00:56.640" end="00:57.150">think </span><span begin="00:57.150" end="00:57.450">of </span><span begin="00:57.450" end="00:57.660">you </span><span begin="00:57.660" end="00:58.740">daily</span></p><p ttm:agent="v1" begin="00:58.980" end="01:02.550"><span begin="00:58.980" end="00:59.250">I </span><span begin="00:59.250" end="00:59.670">could </span><span begin="00:59.670" end="01:00.030">give </span><span begin="01:00.030" end="01:00.360">you </span><span begin="01:00.360" end="01:00.930">all </span><span begin="01:00.930" end="01:00.930">（</span><span begin="01:00.930" end="01:01.170">I </span><span begin="01:01.170" end="01:01.590">can </span><span begin="01:01.590" end="01:01.950">give </span><span begin="01:01.950" end="01:02.310">you </span><span begin="01:02.310" end="01:02.550">all</span><span begin="01:02.550" end="01:02.550">）</span></p><p ttm:agent="v1" begin="01:02.550" end="01:07.080"><span begin="01:02.550" end="01:02.640">You're </span><span begin="01:02.640" end="01:02.970">the </span><span begin="01:02.970" end="01:04.800">only </span><span begin="01:04.800" end="01:05.220">one </span><span begin="01:05.220" end="01:05.550">that </span><span begin="01:05.550" end="01:05.910">knows </span><span begin="01:05.910" end="01:07.080">me</span></p><p ttm:agent="v1" begin="01:07.320" end="01:12.720"><span begin="01:07.320" end="01:07.860">You're </span><span begin="01:07.860" end="01:08.190">the </span><span begin="01:08.190" end="01:10.020">only </span><span begin="01:10.020" end="01:10.440">one </span><span begin="01:10.440" end="01:10.830">that </span><span begin="01:10.830" end="01:11.130">knows </span><span begin="01:11.130" end="01:12.720">me</span></p><p ttm:agent="v1" begin="01:14.250" end="01:17.880"><span begin="01:14.250" end="01:14.550">Yeah</span><span begin="01:14.550" end="01:14.550">, </span><span begin="01:14.550" end="01:14.670">I </span><span begin="01:14.670" end="01:14.850">know </span><span begin="01:14.850" end="01:14.970">you're </span><span begin="01:14.970" end="01:15.270">feelin' </span><span begin="01:15.270" end="01:16.500">paranoia </span><span begin="01:16.500" end="01:16.950">（</span><span begin="01:16.950" end="01:17.820">Why</span><span begin="01:17.820" end="01:17.850">?</span><span begin="01:17.850" end="01:17.880">）</span></p><p ttm:agent="v1" begin="01:17.880" end="01:20.340"><span begin="01:17.880" end="01:18.090">Are </span><span begin="01:18.090" end="01:18.270">you </span><span begin="01:18.270" end="01:18.360">in </span><span begin="01:18.360" end="01:20.310">love</span><span begin="01:20.310" end="01:20.340">?</span></p><p ttm:agent="v1" begin="01:20.340" end="01:23.220"><span begin="01:20.340" end="01:20.610">'Cause </span><span begin="01:20.610" end="01:20.730">I </span><span begin="01:20.730" end="01:21.000">wanna </span><span begin="01:21.000" end="01:23.220">try</span></p><p ttm:agent="v1" begin="01:24.720" end="01:28.140"><span begin="01:24.720" end="01:24.900">I </span><span begin="01:24.900" end="01:25.110">can </span><span begin="01:25.110" end="01:25.290">tell </span><span begin="01:25.290" end="01:25.440">just </span><span begin="01:25.440" end="01:25.590">by </span><span begin="01:25.590" end="01:25.710">the </span><span begin="01:25.710" end="01:25.920">way </span><span begin="01:25.920" end="01:26.130">that </span><span begin="01:26.130" end="01:26.190">you </span><span begin="01:26.190" end="01:27.090">talkin' </span><span begin="01:27.090" end="01:27.420">to </span><span begin="01:27.420" end="01:28.140">me</span></p><p ttm:agent="v1" begin="01:28.170" end="01:30.960"><span begin="01:28.170" end="01:28.320">You </span><span begin="01:28.320" end="01:28.620">don't </span><span begin="01:28.620" end="01:28.770">have </span><span begin="01:28.770" end="01:28.830">a </span><span begin="01:28.830" end="01:29.610">clue </span><span begin="01:29.610" end="01:29.610">（</span><span begin="01:29.610" end="01:29.700">You </span><span begin="01:29.700" end="01:29.940">don't </span><span begin="01:29.940" end="01:30.090">have </span><span begin="01:30.090" end="01:30.180">a </span><span begin="01:30.180" end="01:30.930">clue</span><span begin="01:30.930" end="01:30.960">）</span></p><p ttm:agent="v1" begin="01:30.960" end="01:35.010"><span begin="01:30.960" end="01:31.290">Neither </span><span begin="01:31.290" end="01:31.530">do </span><span begin="01:31.530" end="01:31.680">I </span><span begin="01:31.680" end="01:31.680">（</span><span begin="01:31.680" end="01:31.800">Neither </span><span begin="01:31.800" end="01:32.850">do </span><span begin="01:32.850" end="01:34.350">I</span><span begin="01:34.350" end="01:35.010">）</span></p><p ttm:agent="v1" begin="01:35.010" end="01:38.430"><span begin="01:35.010" end="01:35.160">I </span><span begin="01:35.160" end="01:35.550">didn't </span><span begin="01:35.550" end="01:35.820">really </span><span begin="01:35.820" end="01:36.090">think </span><span begin="01:36.090" end="01:36.18