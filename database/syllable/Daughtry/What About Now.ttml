<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>What About Now</ttm:title><ttm:agent type="person" xml:id="v1">Daughtry</ttm:agent><ttm:item type="album">It's Not Over....The Hits So Far</ttm:item><ttm:item type="spotify_id">35SuLFF1dk9nBgjE2HzTzp</ttm:item><itunes:duration>04:11.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:06.840" end="00:09.628"><span begin="00:06.840" end="00:07.380">Shadows </span><span begin="00:07.380" end="00:07.940">fill </span><span begin="00:07.940" end="00:08.268">an </span><span begin="00:08.268" end="00:08.900">empty </span><span begin="00:08.900" end="00:09.628">heart</span></p><p ttm:agent="v1" begin="00:10.142" end="00:12.202"><span begin="00:10.142" end="00:10.430">As </span><span begin="00:10.430" end="00:10.798">love </span><span begin="00:10.798" end="00:11.118">is </span><span begin="00:11.118" end="00:12.202">fading</span></p><p ttm:agent="v1" begin="00:12.562" end="00:15.570"><span begin="00:12.562" end="00:12.842">From </span><span begin="00:12.842" end="00:13.130">all </span><span begin="00:13.130" end="00:13.434">the </span><span begin="00:13.434" end="00:14.018">things </span><span begin="00:14.018" end="00:14.386">that </span><span begin="00:14.386" end="00:14.778">we </span><span begin="00:14.778" end="00:15.570">are</span></p><p ttm:agent="v1" begin="00:16.130" end="00:18.067"><span begin="00:16.130" end="00:16.426">And </span><span begin="00:16.426" end="00:16.746">are </span><span begin="00:16.746" end="00:17.074">not </span><span begin="00:17.074" end="00:18.067">saying</span></p><p ttm:agent="v1" begin="00:18.647" end="00:21.653"><span begin="00:18.647" end="00:18.991">Can </span><span begin="00:18.991" end="00:19.271">we </span><span begin="00:19.271" end="00:19.770">see </span><span begin="00:19.770" end="00:20.418">beyond </span><span begin="00:20.418" end="00:20.762">the </span><span begin="00:20.762" end="00:21.653">scars</span></p><p ttm:agent="v1" begin="00:21.981" end="00:25.206"><span begin="00:21.981" end="00:22.245">And </span><span begin="00:22.245" end="00:22.581">make </span><span begin="00:22.581" end="00:22.949">it </span><span begin="00:22.949" end="00:23.437">to </span><span begin="00:23.437" end="00:23.741">the </span><span begin="00:23.741" end="00:25.206">dawn?</span></p><p ttm:agent="v1" begin="00:27.526" end="00:30.442"><span begin="00:27.526" end="00:27.902">Change </span><span begin="00:27.902" end="00:28.222">the </span><span begin="00:28.222" end="00:28.870">colors </span><span begin="00:28.870" end="00:29.326">of </span><span begin="00:29.326" end="00:29.670">the </span><span begin="00:29.670" end="00:30.442">sky</span></p><p ttm:agent="v1" begin="00:31.004" end="00:32.828"><span begin="00:31.004" end="00:31.308">And </span><span begin="00:31.308" end="00:31.844">open </span><span begin="00:31.844" end="00:32.188">up </span><span begin="00:32.188" end="00:32.828">to</span></p><p ttm:agent="v1" begin="00:33.252" end="00:36.364"><span begin="00:33.252" end="00:33.572">The </span><span begin="00:33.572" end="00:33.892">ways </span><span begin="00:33.892" end="00:34.156">you </span><span begin="00:34.156" end="00:34.572">made </span><span begin="00:34.572" end="00:34.884">me </span><span begin="00:34.884" end="00:35.212">feel </span><span begin="00:35.212" end="00:36.364">alive</span></p><p ttm:agent="v1" begin="00:36.820" end="00:38.860"><span begin="00:36.820" end="00:37.172">The </span><span begin="00:37.172" end="00:37.532">ways </span><span begin="00:37.532" end="00:37.812">I </span><span begin="00:37.812" end="00:38.164">loved </span><span begin="00:38.164" end="00:38.860">you</span></p><p ttm:agent="v1" begin="00:39.208" end="00:42.346"><span begin="00:39.208" end="00:39.504">For </span><span begin="00:39.504" end="00:39.824">all </span><span begin="00:39.824" end="00:40.088">the </span><span begin="00:40.088" end="00:40.466">things </span><span begin="00:40.466" end="00:40.818">that </span><span begin="00:40.818" end="00:41.482">never </span><span begin="00:41.482" end="00:42.346">died</span></p><p ttm:agent="v1" begin="00:42.898" end="00:45.703"><span begin="00:42.898" end="00:43.178">To </span><span begin="00:43.178" end="00:43.506">make </span><span begin="00:43.506" end="00:43.778">it </span><span begin="00:43.778" end="00:44.178">through </span><span begin="00:44.178" end="00:44.482">the </span><span begin="00:44.482" end="00:45.703">night</span></p><p ttm:agent="v1" begin="00:45.703" end="00:48.831"><span begin="00:45.703" end="00:46.487">Love </span><span begin="00:46.487" end="00:47.151">will </span><span begin="00:47.151" end="00:47.935">find </span><span begin="00:47.935" end="00:48.831">you</span></p><p ttm:agent="v1" begin="00:49.183" end="00:51.223"><span begin="00:49.183" end="00:49.647">What </span><span begin="00:49.647" end="00:50.151">about </span><span begin="00:50.151" end="00:51.223">now?</span></p><p ttm:agent="v1" begin="00:51.975" end="00:54.383"><span begin="00:51.975" end="00:52.527">What </span><span begin="00:52.527" end="00:53.127">about </span><span begin="00:53.127" end="00:54.383">today?</span></p><p ttm:agent="v1" begin="00:54.927" end="01:00.532"><span begin="00:54.927" end="00:55.295">What </span><span begin="00:55.295" end="00:55.631">if </span><span begin="00:55.631" end="00:56.095">you're </span><span begin="00:56.095" end="00:57.127">makin' </span><span begin="00:57.127" end="00:57.588">me </span><span begin="00:57.948" end="00:58.276">all </span><span begin="00:58.276" end="00:58.596">that </span><span begin="00:58.596" end="00:58.932">I </span><span begin="00:58.932" end="00:59.236">was </span><span begin="00:59.236" end="00:59.732">meant </span><span begin="00:59.732" end="01:00.020">to </span><span begin="01:00.020" end="01:00.532">be?</span></p><p ttm:agent="v1" begin="01:00.884" end="01:06.180"><span begin="01:00.884" end="01:01.332">What </span><span begin="01:01.332" end="01:01.644">if </span><span begin="01:01.644" end="01:02.036">our </span><span begin="01:02.036" end="01:03.140">love </span><span begin="01:03.772" end="01:04.380">never </span><span begin="01:04.380" end="01:04.932">went </span><span begin="01:04.932" end="01:06.180">away?</span></p><p ttm:agent="v1" begin="01:06.716" end="01:12.420"><span begin="01:06.716" end="01:07.060">What </span><span begin="01:07.060" end="01:07.396">if </span><span begin="01:07.396" end="01:07.836">it's </span><span begin="01:07.836" end="01:08.652">lost </span><span begin="01:08.652" end="01:09.444">behind </span><span begin="01:09.804" end="01:10.156">words </span><span begin="01:10.156" end="01:10.436">we </span><span begin="01:10.436" end="01:10.804">could </span><span begin="01:10.804" end="01:11.860">never </span><span begin="01:11.860" end="01:12.420">find?</span></p><p ttm:agent="v1" begin="01:12.748" end="01:17.948"><span begin="01:12.748" end="01:13.396">Baby </span><span begin="01:13.396" end="01:15.332">before </span><span begin="01:15.332" end="01:16.036">it's </span><span begin="01:16.036" end="01:16.748">too </span><span begin="01:16.748" end="01:17.948">late</span></p><p ttm:agent="v1" begin="01:18.580" end="01:21.428"><span begin="01:18.580" end="01:19.044">What </span><span begin="01:19.044" end="01:19.860">about </span><span begin="01:19.860" end="01:21.428">now?</span></p><p ttm:agent="v1" begin="01:26.619" end="01:29.715"><span begin="01:26.619" end="01:26.891">The </span><span begin="01:26.891" end="01:27.211">sun </span><span begin="01:27.211" end="01:27.491">is </span><span begin="01:27.491" end="01:28.195">breakin' </span><span begin="01:28.195" end="01:28.547">in </span><span begin="01:28.547" end="01:28.891">your </span><span begin="01:28.891" end="01:29.715">eyes</span></p><p ttm:agent="v1" begin="01:30.243" end="01:32.245"><span begin="01:30.243" end="01:30.547">To </span><span begin="01:30.547" end="01:30.859">start </span><span begin="01:30.859" end="01:31.139">a </span><span begin="01:31.139" end="01:31.507">new </span><span begin="01:31.507" end="01:32.245">day</span></p><p ttm:agent="v1" begin="01:32.541" end="01:35.621"><span begin="01:32.541" end="01:32.821">This </span><span begin="01:32.821" end="01:33.269">broken </span><span begin="01:33.269" end="01:33.845">heart </span><span begin="01:33.845" end="01:34.141">can </span><span begin="01:34.141" end="01:34.493">still </span><span begin="01:34.493" end="01:35.621">survive</span></p><p ttm:agent="v1" begin="01:36.085" end="01:38.229"><span begin="01:36.085" end="01:36.349">With </span><span begin="01:36.349" end="01:36.597">a </span><span begin="01:36.597" end="01:36.869">touch </span><span begin="01:36.869" end="01:37.149">of </span><span begin="01:37.149" end="01:37.453">your </span><span begin="01:37.453" end="01:38.229">grace</span></p><p ttm:agent="v1" begin="01:38.517" end="01:41.711"><span begin="01:38.517" end="01:38.797">As </span><span begin="01:38.797" end="01:39.221">shadows </span><span begin="01:39.221" end="01:39.765">fade </span><span begin="01:39.765" end="01:40.365">into </span><span begin="01:40.365" end="01:40.733">the </span><span begin="01:40.733" end="01:41.711">light</span></p><p ttm:agent="v1" begin="01:42.303" end="01:44.603"><span begin="01:42.303" end="01:42.663">I </span><span begin="01:42.663" end="01:42.999">am </span><span begin="01:42.999" end="01:43.351">by </span><span begin="