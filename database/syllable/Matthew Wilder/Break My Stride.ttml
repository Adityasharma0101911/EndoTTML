<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Break My Stride</ttm:title><ttm:agent type="person" xml:id="v1">Matthew Wilder</ttm:agent><ttm:item type="album">I Don't Speak The Language</ttm:item><ttm:item type="spotify_id">1mCsF9Tw4AkIZOjvZbZZdT</ttm:item><itunes:duration>03:04.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:19.378" end="00:22.147"><span begin="00:19.378" end="00:19.677">Last </span><span begin="00:19.677" end="00:20.137">night </span><span begin="00:20.137" end="00:20.287">I </span><span begin="00:20.287" end="00:20.467">had </span><span begin="00:20.467" end="00:20.657">the </span><span begin="00:20.657" end="00:21.307">strangest </span><span begin="00:21.307" end="00:22.147">dream</span></p><p ttm:agent="v1" begin="00:23.107" end="00:25.267"><span begin="00:23.107" end="00:23.277">I </span><span begin="00:23.277" end="00:23.737">sailed </span><span begin="00:23.737" end="00:24.067">away </span><span begin="00:24.067" end="00:24.257">to </span><span begin="00:24.257" end="00:25.267">China</span></p><p ttm:agent="v1" begin="00:25.267" end="00:27.407"><span begin="00:25.267" end="00:25.417">In </span><span begin="00:25.417" end="00:25.577">a </span><span begin="00:25.577" end="00:25.917">little </span><span begin="00:25.917" end="00:26.117">row </span><span begin="00:26.117" end="00:26.327">boat </span><span begin="00:26.327" end="00:26.547">to </span><span begin="00:26.547" end="00:26.837">find </span><span begin="00:26.837" end="00:27.407">ya</span></p><p ttm:agent="v1" begin="00:27.407" end="00:28.747"><span begin="00:27.407" end="00:27.567">And </span><span begin="00:27.567" end="00:27.697">you </span><span begin="00:27.697" end="00:28.037">said </span><span begin="00:28.037" end="00:28.177">you </span><span begin="00:28.177" end="00:28.587">had </span><span begin="00:28.587" end="00:28.747">to</span></p><p ttm:agent="v1" begin="00:28.747" end="00:31.037"><span begin="00:28.747" end="00:28.917">Get </span><span begin="00:28.917" end="00:29.277">your </span><span begin="00:29.277" end="00:30.187">laundry </span><span begin="00:30.187" end="00:31.037">cleaned</span></p><p ttm:agent="v1" begin="00:31.807" end="00:33.747"><span begin="00:31.807" end="00:31.967">Didn't </span><span begin="00:31.967" end="00:32.287">want </span><span begin="00:32.287" end="00:32.827">no-one </span><span begin="00:32.827" end="00:32.997">to </span><span begin="00:32.997" end="00:33.227">hold </span><span begin="00:33.227" end="00:33.747">you</span></p><p ttm:agent="v1" begin="00:33.747" end="00:35.157"><span begin="00:33.747" end="00:33.897">What </span><span begin="00:33.897" end="00:34.197">does </span><span begin="00:34.197" end="00:34.397">that </span><span begin="00:34.397" end="00:35.157">mean</span></p><p ttm:agent="v1" begin="00:35.157" end="00:36.007"><span begin="00:35.157" end="00:35.297">And </span><span begin="00:35.297" end="00:35.437">you </span><span begin="00:35.437" end="00:36.277">said</span></p><p ttm:agent="v1" begin="00:36.277" end="00:38.307"><span begin="00:36.277" end="00:36.437">Ain't </span><span begin="00:36.437" end="00:36.707">nothin' </span><span begin="00:36.707" end="00:36.877">gonna </span><span begin="00:36.877" end="00:37.047">to </span><span begin="00:37.047" end="00:37.357">break </span><span begin="00:37.357" end="00:37.517">my </span><span begin="00:37.517" end="00:38.307">stride</span></p><p ttm:agent="v1" begin="00:38.307" end="00:41.817"><span begin="00:38.307" end="00:38.977">Nobody's </span><span begin="00:38.977" end="00:39.127">gonna </span><span begin="00:39.127" end="00:39.627">slow </span><span begin="00:39.627" end="00:39.987">me </span><span begin="00:39.987" end="00:41.017">down </span><span begin="00:41.017" end="00:41.817">oh no</span></p><p ttm:agent="v1" begin="00:42.177" end="00:44.807"><span begin="00:42.177" end="00:42.347">I </span><span begin="00:42.347" end="00:42.557">got </span><span begin="00:42.557" end="00:42.817">to </span><span begin="00:42.817" end="00:43.137">keep </span><span begin="00:43.137" end="00:43.606">on </span><span begin="00:43.606" end="00:44.936">movin'</span></p><p ttm:agent="v1" begin="00:44.936" end="00:46.986"><span begin="00:44.936" end="00:45.116">Ain't </span><span begin="00:45.116" end="00:45.396">nothin' </span><span begin="00:45.396" end="00:45.766">gonna </span><span begin="00:45.766" end="00:45.916">break </span><span begin="00:45.916" end="00:46.086">my </span><span begin="00:46.086" end="00:46.986">stride</span></p><p ttm:agent="v1" begin="00:46.986" end="00:49.776"><span begin="00:46.986" end="00:47.156">I'm </span><span begin="00:47.156" end="00:47.546">running </span><span begin="00:47.546" end="00:47.706">and </span><span begin="00:47.706" end="00:47.876">I </span><span begin="00:47.876" end="00:48.366">won't </span><span begin="00:48.366" end="00:48.896">touch </span><span begin="00:48.896" end="00:49.776">ground</span></p><p ttm:agent="v1" begin="00:49.776" end="00:53.586"><span begin="00:49.776" end="00:50.856">Oh no </span><span begin="00:50.856" end="00:51.016">I </span><span begin="00:51.016" end="00:51.176">got </span><span begin="00:51.176" end="00:51.516">to </span><span begin="00:51.516" end="00:51.806">keep </span><span begin="00:51.806" end="00:52.266">on </span><span begin="00:52.266" end="00:53.606">movin'</span></p><p ttm:agent="v1" begin="00:53.606" end="00:57.886"><span begin="00:53.606" end="00:53.776">You're </span><span begin="00:53.776" end="00:53.906">on </span><span begin="00:53.906" end="00:54.166">the </span><span begin="00:54.166" end="00:54.666">road </span><span begin="00:54.666" end="00:54.836">and </span><span begin="00:54.836" end="00:55.056">now </span><span begin="00:55.056" end="00:55.306">you </span><span begin="00:55.306" end="00:55.946">pray </span><span begin="00:55.946" end="00:56.276">it </span><span begin="00:56.276" end="00:57.886">lasts</span></p><p ttm:agent="v1" begin="00:57.886" end="01:00.136"><span begin="00:57.886" end="00:58.046">The </span><span begin="00:58.046" end="00:58.486">road </span><span begin="00:58.486" end="00:58.976">behind </span><span begin="00:58.976" end="00:59.166">was </span><span begin="00:59.166" end="01:00.136">rocky</span></p><p ttm:agent="v1" begin="01:00.136" end="01:02.286"><span begin="01:00.136" end="01:00.286">But </span><span begin="01:00.286" end="01:00.596">now </span><span begin="01:00.596" end="01:00.836">you're </span><span begin="01:00.836" end="01:01.306">feeling </span><span begin="01:01.306" end="01:02.286">cocky</span></p><p ttm:agent="v1" begin="01:02.286" end="01:06.066"><span begin="01:02.286" end="01:02.436">You </span><span begin="01:02.436" end="01:02.646">look </span><span begin="01:02.646" end="01:02.946">at </span><span begin="01:02.946" end="01:03.676">me </span><span begin="01:03.676" end="01:03.936">and </span><span begin="01:03.936" end="01:04.096">you </span><span begin="01:04.096" end="01:04.646">see </span><span begin="01:04.646" end="01:04.886">your </span><span begin="01:04.886" end="01:06.066">past</span></p><p ttm:agent="v1" begin="01:06.676" end="01:09.916"><span begin="01:06.676" end="01:06.856">Is </span><span begin="01:06.856" end="01:07.026">that </span><span begin="01:07.026" end="01:07.246">the </span><span begin="01:07.246" end="01:07.876">reason </span><span begin="01:07.876" end="01:08.116">why </span><span begin="01:08.116" end="01:08.356">you're </span><span begin="01:08.356" end="01:08.996">runnin' </span><span begin="01:08.996" end="01:09.156">so </span><span begin="01:09.156" end="01:09.916">fast</span></p><p ttm:agent="v1" begin="01:09.916" end="01:10.986"><span begin="01:09.916" end="01:10.106">And </span><span begin="01:10.106" end="01:10.325">she </span><span begin="01:10.325" end="01:11.025">said</span></p><p ttm:agent="v1" begin="01:11.025" end="01:13.135"><span begin="01:11.025" end="01:11.215">Ain't </span><span begin="01:11.215" end="01:11.535">nothin' </span><span begin="01:11.535" end="01:11.905">gonna </span><span begin="01:11.905" end="01:12.065">break </span><span begin="01:12.065" end="01:12.225">my </span><span begin="01:12.225" end="01:13.135">stride</span></p><p ttm:agent="v1" begin="01:13.135" end="01:17.045"><span begin="01:13.135" end="01:13.765">Nobody's </span><span begin="01:13.765" end="01:13.905">gonna </span><span begin="01:13.905" end="01:14.405">slow </span><span begin="01:14.405" end="01:14.885">me </span><span begin="01:14.885" end="01:15.935">down </span><span begin="01:15.935" end="01:17.045">oh no</span></p><p ttm:agent="v1" begin="01:17.045" end="01:19.545"><span begin="01:17.045" end="01:17.195">I </span><span begin="01:17.195" end="01:17.365">got </span><span begin="01:17.365" end="01:17.655">to </span><span begin="01:17.655" end="01:17.955">keep </span><span begin="01:17.955" end="01:18.155">on </span><span begin="01:18.155" end="01:19.545">moving</span></p><p ttm:agent="v1" begin="01:19.895" end="01:21.825"><span begin="01:19.895" end="01:20.205">Ain't </span><span begin="01:20.205" end="01:20.505">nothin' </span><span begin="01:20.505" end="01:20.685">gonna </span><span begin="01:20.685" end="01:20.855">break </span><span begin="01:20.855" end="01:21.055">my </span><span begin="01:21.055" end="01:21.825">stride</span></p><p ttm:agent="v1" begin="01:21.825" end="01:24.325"><span begin="01:21.825" end="01:21.985">I'm </span><span begin="01:21.985" end="01:22.385">running </span><span begin="01:22.385" end="01:22.515">and </span><span begin="01:22.515" end="01:22.675">I </span><span begin="01:22.675" end="01:23.245">won't </span><span begin="01:23.245" end="01:23.665">touch </span><span begin="01:23.665" end="01:24.325">ground</span></p><p ttm:agent="v1" begin="01:24.625" end="01:28.155"><span begin="01:24.625" end="01:25.695">Oh no </span><span begin="01:25.695" end="01:25.865">I </span><span begin="01:25.865" end="01:26.005">got </span><span begin="01:26.005" end="01:26.345">to </span><span begin="01:26.345" end="01:26.665">keep </span><span begin="01:26.665" end="01:26.885">on </span><span begin="01:26.885" end="01:28.155">moving</span></p><p ttm:agent="v1" begin="01:45.942" end="01:50.242"><span begin="01:45.942" end="01:46.112">Never </span><span begin="01:46.112" end="01:46.262">let </span><span begin="01:46.262" end="01:46.712">another </span><span begin="01:46.712" end="01:46.972">girl </span><span begin="01:46.972" end="01:47.132">like </span><span begin="01:47.132" end="01:48.312">you </span><span begin="01:48.312" end="01:48.462">work </span><span begin="01:48.462" end="01:48.972">me </span><span begin="01:48.972" end="01:50.242">over</span></p><p ttm:agent="v1" begin="01:50.242" end="01:54.572"><span begin="01:50.242" end="01:50.392">Never </span><span begin="01:50.392" end="01:50.652">let </span><span begin="01:50.652" end="01:51.062">another </span><span begin="01:51.062" end="01:51.242">girl </span><span begin="01:51.242" end="01:51.412">like </span><span begin="01:51.412" end="01:52.662">you </span><span begin="01:52.662" end="01:52.802">drag </span><span begin="01:52.802" end="01:53.182">me </span><span begin="01:53.182" end="01:54.572">under</span></p><p ttm:agent="v1" begin="01:54.572" end="01:58.952"><span begin="01:54.572" end="01:54.722">If </span><span begin="01:54.722" end="01:54.872">I </span><span begin="01:54.872" end="01:55.142">meet </span><span begin="01:55.142" end="01:55.302">another </span><span begin="01:55.302" end="01:55.522">girl </span><span begin="01:55.522" end="01:55.742">like </span><span begin="01:55.742" end="01:56.982">you </span><span begin="01:56.982" end="01:57.132">I </span><span begin="01:57.132" end="01:57.422">will </span><span begin="01:57.422" end="01:57.992">tell </span><span begin="01:57.992" end="01:58.952">her</span></p><p ttm:agent="v1" begin="01:58.952" end="02:02.242"><span begin="01:58.952" end="01:59.102">Never </span><span begin="01:59.102" end="01:59.392">want </span><span begin="01:59.392" end="01:59.562">another </span><span begin="01:59.562" end="01:59.922">girl </span><span begin="01:59.922" end="02:00.092">like </span><span begin="02:00.092" end="02:00.862">you </span><span begin="02:00.862" end="02:01.022">have </span><span begin="02:01.022" end="02:01.162">to </span><span begin="02:01.162" end="02:02.242">say</span></p><p ttm:agent="v1" begin="02:03.292" end="02:05.192"><span begin="02:03.292" end="02:03.522">Ain't </span><span begin="02:03.522" end="02:03.862">nothin' </span><span begin="02:03.862" end="02:04.042">gonna </span><span begin="02:04.042" end="02:04.282">break </span><span begin="02:04.282" end="02:04.432">my </span><span begin="02:04.432" end="02:05.192">stride</span></p><p ttm:agent="v1" begin="02:05.492" end="02:08.162"><span begin="02:05.492" end="02:06.002">Nobody's </span><span begin="02:06.002" end="02:06.182">gonna </span><span begin="02:06.182" end="02:06.722">slow </span><span begin="02:06.722" end="02:07.242">me </span><span begin="02:07.242" end="02:08.162">down</span></p><p ttm:agent="v1" begin="02:08.162" end="02:11.992"><span begin="02:08.162" end="02:08.862">Oh no </span><span begin="02:08.862" end="02:09.422">oh no </span><span begin="02:09.422" end="02:09.572">I </span><span begin="02:09.572" end="02:09.732">got </span><span begin="02:09.732" end="02:09.902">to </span><span begin="02:09.902" end="02:10.212">keep </span><span begin