<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Roxanne</ttm:title><ttm:agent type="person" xml:id="v1">Chase Atlantic</ttm:agent><ttm:item type="album">Nostalgia - EP</ttm:item><ttm:item type="spotify_id">7zRTw6GCjbxsNWZK37G87u</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:33.950" end="00:36.740"><span begin="00:33.950" end="00:34.370">Tell </span><span begin="00:34.370" end="00:34.610">me </span><span begin="00:34.610" end="00:34.970">your </span><span begin="00:34.970" end="00:36.050">name</span></p><p ttm:agent="v1" begin="00:36.740" end="00:40.850"><span begin="00:36.740" end="00:37.100">I </span><span begin="00:37.100" end="00:37.430">don't </span><span begin="00:37.430" end="00:37.880">ever </span><span begin="00:37.880" end="00:38.390">wanna </span><span begin="00:38.390" end="00:38.810">let </span><span begin="00:38.810" end="00:38.960">you </span><span begin="00:38.960" end="00:40.670">down</span></p><p ttm:agent="v1" begin="00:40.850" end="00:44.720"><span begin="00:40.850" end="00:41.240">No</span><span begin="00:41.240" end="00:41.240">, </span><span begin="00:41.240" end="00:41.420">I </span><span begin="00:41.420" end="00:41.780">just </span><span begin="00:41.780" end="00:42.080">want </span><span begin="00:42.080" end="00:42.230">to </span><span begin="00:42.230" end="00:42.650">kiss </span><span begin="00:42.650" end="00:42.800">your </span><span begin="00:42.800" end="00:43.220">lips </span><span begin="00:43.220" end="00:43.400">in </span><span begin="00:43.400" end="00:43.640">the </span><span begin="00:43.640" end="00:44.570">rain</span></p><p ttm:agent="v1" begin="00:44.720" end="00:50.240"><span begin="00:44.720" end="00:44.930">You </span><span begin="00:44.930" end="00:45.350">know </span><span begin="00:45.350" end="00:45.500">I'll </span><span begin="00:45.500" end="00:45.800">pull </span><span begin="00:45.800" end="00:46.040">you </span><span begin="00:46.040" end="00:46.700">closer </span><span begin="00:46.700" end="00:46.970">if </span><span begin="00:46.970" end="00:47.090">you </span><span begin="00:47.090" end="00:47.480">start </span><span begin="00:47.480" end="00:47.660">to </span><span begin="00:47.660" end="00:49.070">drown</span><span begin="00:49.070" end="00:49.070">, </span><span begin="00:49.070" end="00:50.240">drown</span></p><p ttm:agent="v1" begin="00:50.240" end="00:55.430"><span begin="00:50.240" end="00:51.590">And </span><span begin="00:51.590" end="00:52.880"> </span><span begin="00:52.880" end="00:53.420">then </span><span begin="00:53.420" end="00:53.630">my </span><span begin="00:53.630" end="00:54.020">hand </span><span begin="00:54.020" end="00:54.320">meets </span><span begin="00:54.320" end="00:54.470">your </span><span begin="00:54.470" end="00:55.430">thighs</span></p><p ttm:agent="v1" begin="00:55.430" end="01:01.640"><span begin="00:55.430" end="00:55.640">With </span><span begin="00:55.640" end="00:55.910">that </span><span begin="00:55.910" end="00:56.270">look </span><span begin="00:56.270" end="00:56.450">in </span><span begin="00:56.450" end="00:56.870">your </span><span begin="00:56.870" end="00:57.380">eyes</span><span begin="00:57.380" end="00:57.380">, </span><span begin="00:57.380" end="00:57.740">I </span><span begin="00:57.740" end="00:58.040">can </span><span begin="00:58.040" end="00:58.550">never </span><span begin="00:58.550" end="01:00.110">forget</span></p><p ttm:agent="v1" begin="01:01.640" end="01:04.100"><span begin="01:01.640" end="01:01.910">And </span><span begin="01:01.910" end="01:02.240">then </span><span begin="01:02.240" end="01:02.450">it's </span><span begin="01:02.450" end="01:02.750">back </span><span begin="01:02.750" end="01:02.990">to </span><span begin="01:02.990" end="01:03.230">my </span><span begin="01:03.230" end="01:04.100">room</span></p><p ttm:agent="v1" begin="01:04.100" end="01:06.620"><span begin="01:04.100" end="01:04.460">What </span><span begin="01:04.460" end="01:04.580">a </span><span begin="01:04.580" end="01:05.450">wonderful </span><span begin="01:05.450" end="01:05.960">view</span><span begin="01:05.960" end="01:05.960">, </span><span begin="01:05.960" end="01:06.620">love</span></p><p ttm:agent="v1" begin="01:06.620" end="01:09.470"><span begin="01:06.620" end="01:06.830">And </span><span begin="01:06.830" end="01:07.160">that's </span><span begin="01:07.160" end="01:07.430">when </span><span begin="01:07.430" end="01:07.610">I </span><span begin="01:07.610" end="01:08.540">said</span></p><p ttm:agent="v1" begin="01:09.470" end="01:12.830"><span begin="01:09.470" end="01:10.250">Roxanne</span></p><p ttm:agent="v1" begin="01:12.830" end="01:21.770"><span begin="01:12.830" end="01:13.730">Why'd </span><span begin="01:13.730" end="01:13.910">you </span><span begin="01:13.910" end="01:14.420">wanna </span><span begin="01:14.420" end="01:14.990">leave </span><span begin="01:14.990" end="01:15.350">me </span><span begin="01:15.350" end="01:15.830">on </span><span begin="01:15.830" end="01:16.460">my </span><span begin="01:16.460" end="01:17.240">own </span><span begin="01:17.240" end="01:17.390"> </span><span begin="01:17.390" end="01:17.930">now</span><span begin="01:17.930" end="01:17.960">, </span><span begin="01:17.960" end="01:21.500">Roxanne</span><span begin="01:21.500" end="01:21.770">?</span></p><p ttm:agent="v1" begin="01:21.770" end="01:28.460"><span begin="01:21.770" end="01:21.980">I </span><span begin="01:21.980" end="01:22.400">think </span><span begin="01:22.400" end="01:22.580">we </span><span begin="01:22.580" end="01:22.910">should </span><span begin="01:22.910" end="01:23.510">go </span><span begin="01:23.510" end="01:23.720"> </span><span begin="01:23.720" end="01:24.080">but </span><span begin="01:24.080" end="01:24.500">I'm </span><span begin="01:24.500" end="01:24.950">not </span><span begin="01:24.950" end="01:26.000">sure </span><span begin="01:26.000" end="01:26.630">enough</span><span begin="01:26.630" end="01:26.630">, </span><span begin="01:26.630" end="01:28.430">Roxanne</span></p><p ttm:agent="v1" begin="01:28.460" end="01:32.780"><span begin="01:28.460" end="01:28.580">I'm </span><span begin="01:28.580" end="01:29.120">driving </span><span begin="01:29.120" end="01:29.690">somewhere </span><span begin="01:29.690" end="01:30.110">far </span><span begin="01:30.110" end="01:30.560">away </span><span begin="01:30.560" end="01:30.890">from </span><span begin="01:30.890" end="01:31.190">out </span><span begin="01:31.190" end="01:31.310">of </span><span begin="01:31.310" end="01:32.360">town</span></p><p ttm:agent="v1" begin="01:32.780" end="01:37.130"><span begin="01:32.780" end="01:33.290">No</span><span begin="01:33.290" end="01:33.290">, </span><span begin="01:33.290" end="01:33.500">I'm </span><span begin="01:33.500" end="01:34.100">falling </span><span begin="01:34.100" end="01:34.430">deep </span><span begin="01:34.430" end="01:35.000">within </span><span begin="01:35.000" end="01:35.300">your </span><span begin="01:35.300" end="01:35.570">eyes </span><span begin="01:35.570" end="01:35.750">like </span><span begin="01:35.750" end="01:36.830">cocaine</span></p><p ttm:agent="v1" begin="01:37.130" end="01:45.830"><span begin="01:37.130" end="01:37.430">I'm </span><span begin="01:37.430" end="01:37.940">hoping </span><span begin="01:37.940" end="01:38.240">that </span><span begin="01:38.240" end="01:38.450">you'll </span><span begin="01:38.450" end="01:38.780">be </span><span begin="01:38.780" end="01:38.990">there </span><span begin="01:38.990" end="01:39.020"> </span><span begin="01:39.020" end="01:39.380">when </span><span begin="01:39.380" end="01:39.500">I'm </span><span begin="01:39.500" end="01:40.070">coming </span><span begin="01:40.070" end="01:41.390">down</span><span begin="01:41.390" end="01:41.390">, </span><span begin="01:41.390" end="01:44.240">down</span></p><p ttm:agent="v1" begin="01:45.830" end="01:51.140"><span begin="01:45.830" end="01:46.160">And </span><span begin="01:46.160" end="01:47.090">you </span><span begin="01:47.090" end="01:47.690">know </span><span begin="01:47.690" end="01:48.020">that </span><span begin="01:48.020" end="01:48.230">you've </span><span begin="01:48.230" end="01:48.620">got </span><span begin="01:48.620" end="01:48.770">to </span><span begin="01:48.770" end="01:49.670">believe </span><span begin="01:49.670" end="01:50.510">me</span></p><p ttm:agent="v1" begin="01:51.140" end="01:54.500"><span begin="01:51.140" end="01:51.830">No</span><span begin="01:51.830" end="01:52.220">, </span><span begin="01:52.220" end="01:54.410">no</span></p><p ttm:agent="v1" begin="01:54.500" end="01:59.360"><span begin="01:54.500" end="01:54.860">And </span><span begin="01:54.860" end="01:55.730"> </span><span begin="01:55.730" end="01:55.790">I </span><span begin="01:55.790" end="01:56.450">know </span><span begin="01:56.450" end="01:56.720">that </span><span begin="01:56.720" end="01:57.050">we </span><span begin="01:57.050" end="01:57.260">have </span><span begin="01:57.260" end="01:57.470">to </span><span begin="01:57.470" end="01:59.060">try</span></p><p ttm:agent="v1" begin="01:59.360" end="02:01.850"><span begin="01:59.360" end="01:59.750">So </span><span begin="01:59.750" end="01:59.810">I </span><span begin="01:59.810" end="02:01.640">say</span></p><p ttm:agent="v1" begin="02:01.850" end="02:05.210"><span begin="02:01.850" end="02:02.630">Roxanne</span></p><p ttm:agent="v1" begin="02:05.210" end="02:14.120"><span begin="02:05.210" end="02:06.080">Why'd </span><span begin="02:06.080" end="02:06.260">you </span><span begin="02:06.260" end="02:06.800">wanna </span><span begin="02:06.800" end="02:07.340">leave </span><span begin="02:07.340" end="02:07.700">me </span><span begin="02:07.700" end="02:08.180">on </span><span begin="02:08.180" end="02:08.840">my </span><span begin="02:08.840" end="02:09.770">own </span><span begin="02:09.770" end="02:10.280">now</span><span begin="02:10.280" end="02:10.340">, </span><span begin="02:10.340" end="02:13.850">Roxanne</span><span begin="02:13.850" end="02:14.120">?</span></p><p ttm:agent="v1" begin="02:14.120" end="02:19.100"><span begin="02:14.120" end="02:14.330">I </span><span begin="02:14.330" end="02:14.750">think </span><span begin="02:14.750" end="02:14.930">we </span><span begin="02:14.930" end="02:15.260">should </span><span begin="02:15.260" end="02:15.890">go </span><span begin="02:15.890" end="02:16.070"> </span><span begin="02:16.070" end="02:16.460">but </span><span begin="02:16.460" end="02:16.850">I'm </span><span begin="02:16.850" end="02:17.330">not </span><span begin="02:17.330" end="02:18.350">sure </span><span begin="02:18.350" end="02:19.040">enough</span></p><p ttm:agent="v1" begin="02:19.100" end="02:21.350"><span begin="02:19.100" end="02:19.340">And </span><span begin="02:19.340" end="02:19.700">now </span><span begin="02:19.700" end="02:19.910">it's </span><span begin="02:19.910" end="02:20.480">burning </span><span begin="02:20.480" end="02:20.690">my </span><span begin="02:20.690" end="02:21.350">mind</span></p><p ttm:agent="v1" begin="02:21.350" end="02:23.510"><span begin="02:21.350" end="02:21.620">That </span><span begin="02:21.620" end="02:21.860">you </span><span begin="02:21.860" end="02:22.340">left </span><span begin="02:22.340" end="02:22.670">me </span><span begin="02:22.670" end="02:23.510">inside</span></p><p ttm:agent="v1" begin="02:23.510" end="02:25.730"><span begin="02:23.510" end="02:23.780">With </span><span begin="02:23.780" end="02:24.050">your </span><span begin="02:24.050" end="02:24.620">lips </span><span begin="02:24.620" end="02:24.860">and </span><span begin="02:24.860" end="02:25.100">your </span><span begin="02:25.100" end="02:25.730">thighs</span></p><p ttm:agent="v1" begin="02:25.730" end="02:28.070"><span begin="02:25.730" end="02:25.910">You </span><span begin="02:25.910" end="02:26.210">pull </span><span begin="02:26.210" end="02:26.450">them </span><span begin="02:26.450" end="02:27.050">closer </span><span begin="02:27.050" end="02:27.200">to </span><span begin="02:27.200" end="02:27.860">mine</span></p><p ttm:agent="v1" begin="02:28.070" end="02:31.850"><span begin="02:28.070" end="02:31.820">Roxanne</span></p><p ttm:agent="v1" begin="02:31.850" end="02:54.200"><span begin="02:31.850" end="02:32.270">Why'd </span><span begin="02:32.270" end="02:32.450">you </span><span begin="02:32.450" end="02:32.960">wanna </span><span begin="02:32.960" end="02:33.500">leave </span><span begin="02:33.500" end="02:33.860">me</span><span begin="02:33.860" end="02:33.860">, </span><span begin="02:33.860" end="02:34.340">leave </span><span begin="02:34.340" end="02:34.670">me</span><span begin="02:34.670" end="02:34.700">, </span><span begin="02:34.700" end="02:39.140">Roxanne</span><span begin="02:39.140" end="02:54.200">?</span></p><p ttm:agent="v1" begin="02:54.200" end="02:58.280"><span begin="02:54.200" end="02:57.560">Roxanne</span></p><p ttm:agent="v1" begin="02:58.280" end="03:02.150"><span begin="02:58.280" end="03:02.120">Roxanne</span></p><p ttm:agent="v1" begin="03:02.150" end="03:05.780"><span begin="03:02.150" end="03:02.810">Why'd </span><span begin="03:02.810" end="03:02.990">you </span><span begin="03:02.990" end="03:03.500">wanna </span><span begin="03:03.500" end="03:04.070">leave </span><span begin="03:04.070" end="03:04.370">me</span><span begin="03:04.370" end="03:04.370">, </span><span begin="03:04.370" end="03:04.850">leave </span><span begin="03:04.850" end="03:05.780">me</span></p><p ttm:agent="v1" begin="03:05.780" end="03:07.910"><span begin="03:05.780" end="03:06.260">On </span><span begin="03:06.260" end="03:06.890">my </span><span begin="03:06.890" end="03:07.670">own</span></p><p ttm:agent="v1" begin="03:07.910" end="03:11.450"><span begin="03:07.910" end="03:08.450">Leave </span><span begin="03:08.450" end="03:08.750">me</span><span begin="03:08.750" end="03:08.750">, </span><span begin="03:08.750" end="03:09.230">leave </span><span begin="03:09.230" end="03:09.590">me</span><span begin="03:09.590" end="03:09.620">, </span><span begin="03:09.620" end="03:11.390">Roxanne</span><span begin="03:11.390" end="03:11.450">?</span></p><p ttm:agent="v1" begin="03:11.450" end="03:13.730"><span begin="03:11.450" end="03:11.720">And </span><span begin="03:11.720" end="03:12.080">now </span><span begin="03:12.080" end="03:12.290">it's </span><span begin="03:12.290" end="03:12.860">burning </span><span begin="03:12.860" end="03:13.070">my </span><span begin="03:13.070" end="03:13.730">mind</span></p><p ttm:agent="v1" begin="03:13.730" end="03:15.890"><span begin="03:13.730" end="03:14.000">That </span><span begin="03:14.000" end="03:14.210">you </span><span begin="03:14.210" end="03:14.720">left </span><span begin="03:14.720" end="03:15.020">me </span><span begin="03:15.020" end="03:15.890">inside</span></p><p ttm:agent="v1" begin="03:15.890" end="03:18.110"><span begin="03:15.890" end="03:16.130">With </span><span begin="03:16.130" end="03:16.430">your </span><span begin="03:16.430" end="03:17.000">lips </span><span begin="03:17.000" end="03:17.240">and </span><span begin="03:17.240" end="03:17.480">your </span><span begin="03:17.480" end="03:18.110">thighs</span></p><p ttm:agent="v1" begin="03:18.110" end="03:20.420"><span begin="03:18.110" end="03:18.290">You </span><span begin="03:18.290" end="03:18.590">pull </span><span begin="03:18.590" end="03:18.830">them </span><span begin="03:18.830" end="03:19.430">closer </span><span begin="03:19.430" end="03:19.580">to </span><span begin="03:19.580" end="03:20.240">mine</span></p><p ttm:agent="v1" begin="03:20.420" end="03:21.230"><span begin="03:20.420" end="03:21.200">Roxanne</span></p><p ttm:agent="v1" begin="03:21.230" end="03:52.040"><span begin="03:21.230" end="03:24.170">I </span><span begin="03:24.170" end="03:24.590">think </span><span begin="03:24.590" end="03:24.770">we </span><span begin="03:24.770" end="03:25.070">should </span><span begin="03:25.070" end="03:25.880">go </span><span begin="03:25.880" end="03:25.910"> </span><span begin="03:25.910" end="03:26.300">but </span><span begin="03:26.300" end="03:26.690">I'm </span><span begin="03:26.690" end="03:27.140">not </span><span begin="03:27.140" end="03:28.190">sure </span><span begin="03:28.190" end="03:28.820">enough</span><span begin="03:28.820" end="03:28.820">, </span><span begin="03:28.820" end="03:31.760">Roxanne</span></p></div></body></tt>