7.038">I </span><span begin="03:07.038" end="03:08.766">get </span><span begin="03:08.766" end="03:09.694">lonesome </span><span begin="03:10.494" end="03:12.838">sometimes</span></p><p ttm:agent="v1" begin="03:16.582" end="03:23.998"><span begin="03:16.582" end="03:16.798">And </span><span begin="03:16.798" end="03:17.486">save </span><span begin="03:17.486" end="03:17.966">all </span><span begin="03:17.966" end="03:18.230">the </span><span begin="03:18.230" end="03:20.014">jokes </span><span begin="03:20.014" end="03:20.655">you're </span><span begin="03:20.655" end="03:21.174">going </span><span begin="03:21.174" end="03:21.518">to </span><span begin="03:21.518" end="03:22.854">make</span></p><p ttm:agent="v1" begin="03:23.998" end="03:30.966"><span begin="03:23.998" end="03:24.494">Whilst </span><span begin="03:24.494" end="03:24.734">I </span><span begin="03:24.734" end="03:25.662">see </span><span begin="03:25.662" end="03:26.118">how </span><span begin="03:26.118" end="03:26.438">much </span><span begin="03:26.438" end="03:27.366">drink </span><span begin="03:27.366" end="03:27.790">I </span><span begin="03:27.790" end="03:27.998">can </span><span begin="03:27.998" end="03:29.142">take</span></p><p ttm:agent="v1" begin="03:30.966" end="03:40.222"><span begin="03:30.966" end="03:31.447">Then </span><span begin="03:31.447" end="03:35.386">be </span><span begin="03:34.886" end="03:36.746">my </span><span begin="03:37.446" end="03:39.586">mistake</span></p></div></body></tt>