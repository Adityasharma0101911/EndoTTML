<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>American Idiot</ttm:title><ttm:agent type="person" xml:id="v1">Green Day</ttm:agent><ttm:item type="album">American Idiot</ttm:item><ttm:item type="spotify_id">6nTiIhLmQ3FWhvrGafw2zj</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:10.610" end="00:13.550"><span begin="00:10.610" end="00:10.880">Don't </span><span begin="00:10.880" end="00:11.150">wanna </span><span begin="00:11.150" end="00:11.450">be </span><span begin="00:11.450" end="00:11.570">an </span><span begin="00:11.570" end="00:12.530">American </span><span begin="00:12.530" end="00:13.550">idiot</span></p><p ttm:agent="v1" begin="00:15.800" end="00:18.680"><span begin="00:15.800" end="00:16.070">Don't </span><span begin="00:16.070" end="00:16.280">want </span><span begin="00:16.280" end="00:16.340">a </span><span begin="00:16.340" end="00:16.760">nation </span><span begin="00:16.760" end="00:17.180">under </span><span begin="00:17.180" end="00:17.330">the </span><span begin="00:17.330" end="00:17.600">new </span><span begin="00:17.600" end="00:18.680">media</span></p><p ttm:agent="v1" begin="00:20.930" end="00:23.870"><span begin="00:20.930" end="00:21.170">And </span><span begin="00:21.170" end="00:21.410">can </span><span begin="00:21.410" end="00:21.560">you </span><span begin="00:21.560" end="00:21.680">hear </span><span begin="00:21.680" end="00:21.920">the </span><span begin="00:21.920" end="00:22.430">sound </span><span begin="00:22.430" end="00:22.670">of </span><span begin="00:22.670" end="00:23.870">hysteria</span></p><p ttm:agent="v1" begin="00:26.150" end="00:29.090"><span begin="00:26.150" end="00:26.360">The </span><span begin="00:26.360" end="00:27.170">subliminal </span><span begin="00:27.170" end="00:27.340">*</span><span begin="00:27.340" end="00:27.510">*</span><span begin="00:27.510" end="00:27.680">*</span><span begin="00:27.680" end="00:27.860">* </span><span begin="00:27.860" end="00:29.090">America</span></p><p ttm:agent="v1" begin="00:31.280" end="00:34.010"><span begin="00:31.280" end="00:31.820">Welcome </span><span begin="00:31.820" end="00:32.090">to </span><span begin="00:32.090" end="00:32.270">a  </span><span begin="00:32.270" end="00:32.600">new </span><span begin="00:32.600" end="00:32.990">kind </span><span begin="00:32.990" end="00:33.080">of </span><span begin="00:33.080" end="00:34.010">tension</span></p><p ttm:agent="v1" begin="00:34.070" end="00:36.890"><span begin="00:34.070" end="00:34.340">All </span><span begin="00:34.340" end="00:34.790">across </span><span begin="00:34.790" end="00:35.000">the </span><span begin="00:35.000" end="00:35.720">alien </span><span begin="00:35.720" end="00:36.890">nation</span></p><p ttm:agent="v1" begin="00:36.890" end="00:40.310"><span begin="00:36.890" end="00:37.190">Everything </span><span begin="00:37.190" end="00:37.490">isn't </span><span begin="00:37.490" end="00:37.790">meant </span><span begin="00:37.790" end="00:38.090">to </span><span begin="00:38.090" end="00:38.540">be </span><span begin="00:38.540" end="00:40.310">okay</span></p><p ttm:agent="v1" begin="00:41.780" end="00:44.120"><span begin="00:41.780" end="00:42.620">Television </span><span begin="00:42.620" end="00:43.070">dreams </span><span begin="00:43.070" end="00:43.280">of </span><span begin="00:43.280" end="00:44.120">tomorrow</span></p><p ttm:agent="v1" begin="00:44.300" end="00:46.940"><span begin="00:44.300" end="00:44.720">We're </span><span begin="00:44.720" end="00:45.050">not </span><span begin="00:45.050" end="00:45.200">the </span><span begin="00:45.200" end="00:45.590">ones' </span><span begin="00:45.590" end="00:45.680">who're </span><span begin="00:45.680" end="00:45.890">meant </span><span begin="00:45.890" end="00:46.010">to </span><span begin="00:46.010" end="00:46.940">follow</span></p><p ttm:agent="v1" begin="00:46.940" end="00:50.180"><span begin="00:46.940" end="00:47.300">For </span><span begin="00:47.300" end="00:47.600">that's </span><span begin="00:47.600" end="00:48.080">enough </span><span begin="00:48.080" end="00:48.560">to </span><span begin="00:48.560" end="00:50.180">argue</span></p><p ttm:agent="v1" begin="00:57.050" end="01:00.020"><span begin="00:57.050" end="00:57.290">Well </span><span begin="00:57.290" end="00:57.710">maybe </span><span begin="00:57.710" end="00:57.890">I</span><span begin="00:57.890" end="00:57.920">‘ </span><span begin="00:57.920" end="00:57.980">m </span><span begin="00:57.980" end="00:58.070">the </span><span begin="00:58.070" end="00:58.250">*</span><span begin="00:58.250" end="00:58.430">*</span><span begin="00:58.430" end="00:58.610">*</span><span begin="00:58.610" end="00:58.820">* </span><span begin="00:58.820" end="01:00.020">America</span></p><p ttm:agent="v1" begin="01:02.300" end="01:05.300"><span begin="01:02.300" end="01:02.510">I'm </span><span begin="01:02.510" end="01:02.720">not </span><span begin="01:02.720" end="01:02.810">a </span><span begin="01:02.810" end="01:03.080">part </span><span begin="01:03.080" end="01:03.200">of </span><span begin="01:03.200" end="01:03.290">a </span><span begin="01:03.290" end="01:03.980">redneck </span><span begin="01:03.980" end="01:05.300">agenda</span></p><p ttm:agent="v1" begin="01:07.370" end="01:10.430"><span begin="01:07.370" end="01:07.700">Now </span><span begin="01:07.700" end="01:08.390">everybody </span><span begin="01:08.390" end="01:08.780">do </span><span begin="01:08.780" end="01:08.900">the </span><span begin="01:08.900" end="01:10.430">propaganda</span></p><p ttm:agent="v1" begin="01:12.590" end="01:14.840"><span begin="01:12.590" end="01:12.800">And </span><span begin="01:12.800" end="01:13.040">sing </span><span begin="01:13.040" end="01:13.340">along </span><span begin="01:13.340" end="01:13.490">in </span><span begin="01:13.490" end="01:13.700">the </span><span begin="01:13.700" end="01:14.000">age </span><span begin="01:14.000" end="01:14.120">of </span><span begin="01:14.120" end="01:14.840">paranoid</span></p><p ttm:agent="v1" begin="01:17.330" end="01:20.360"><span begin="01:17.330" end="01:18.260">Welcome </span><span begin="01:18.260" end="01:18.560">to </span><span begin="01:18.560" end="01:18.710">a </span><span begin="01:18.710" end="01:19.040">new </span><span begin="01:19.040" end="01:19.490">kind </span><span begin="01:19.490" end="01:19.550">of </span><span begin="01:19.550" end="01:20.360">tension</span></p><p ttm:agent="v1" begin="01:20.510" end="01:22.910"><span begin="01:20.510" end="01:20.750">All </span><span begin="01:20.750" end="01:21.230">across </span><span begin="01:21.230" end="01:21.410">the </span><span begin="01:21.410" end="01:22.160">alien </span><span begin="01:22.160" end="01:22.910">nation</span></p><p ttm:agent="v1" begin="01:23.240" end="01:26.570"><span begin="01:23.240" end="01:23.690">Everything </span><span begin="01:23.690" end="01:23.960">isn't </span><span begin="01:23.960" end="01:24.260">meant </span><span begin="01:24.260" end="01:24.560">to </span><span begin="01:24.560" end="01:24.980">be </span><span begin="01:24.980" end="01:26.570">okay</span></p><p ttm:agent="v1" begin="01:28.220" end="01:30.740"><span begin="01:28.220" end="01:29.030">Television </span><span begin="01:29.030" end="01:29.510">dreams </span><span begin="01:29.510" end="01:29.690">of </span><span begin="01:29.690" end="01:30.740">tomorrow</span></p><p ttm:agent="v1" begin="01:30.770" end="01:33.410"><span begin="01:30.770" end="01:31.190">We're </span><span begin="01:31.190" end="01:31.490">not </span><span begin="01:31.490" end="01:31.640">the </span><span begin="01:31.640" end="01:32.030">ones' </span><span begin="01:32.030" end="01:32.150">who're </span><span begin="01:32.150" end="01:32.330">meant </span><span begin="01:32.330" end="01:32.450">to </span><span begin="01:32.450" end="01:33.410">follow</span></p><p ttm:agent="v1" begin="01:33.410" end="01:35.780"><span begin="01:33.410" end="01:33.770">For </span><span begin="01:33.770" end="01:34.040">that's </span><span begin="01:34.040" end="01:34.520">enough </span><span begin="01:34.520" end="01:35.000">to </span><span begin="01:35.000" end="01:35.780">argue</span></p><p ttm:agent="v1" begin="02:11.960" end="02:14.630"><span begin="02:11.960" end="02:12.170">Don't </span><span begin="02:12.170" end="02:12.440">wanna </span><span begin="02:12.440" end="02:12.800">be </span><span begin="02:12.800" end="02:12.860">an </span><span begin="02:12.860" end="02:13.820">American </span><span begin="02:13.820" end="02:14.630">idiot</span></p><p ttm:agent="v1" begin="02:14.660" end="02:17.120"><span begin="02:14.660" end="02:15.020">One </span><span begin="02:15.020" end="02:15.410">nation </span><span begin="02:15.410" end="02:15.890">controlled </span><span begin="02:15.890" end="02:16.190">by </span><span begin="02:16.190" end="02:16.340">the </span><span begin="02:16.340" end="02:17.120">media</span></p><p ttm:agent="v1" begin="02:17.270" end="02:19.670"><span begin="02:17.270" end="02:18.140">Information </span><span begin="02:18.140" end="02:18.710">nation </span><span begin="02:18.710" end="02:18.770">of </span><span begin="02:18.770" end="02:19.670">hysteria</span></p><p ttm:agent="v1" begin="02:19.730" end="02:22.220"><span begin="02:19.730" end="02:19.910">It's </span><span begin="02:19.910" end="02:20.300">going </span><span begin="02:20.300" end="02:20.570">out </span><span begin="02:20.570" end="02:20.720">to </span><span begin="02:20.720" end="02:21.440">idiot </span><span begin="02:21.440" end="02:22.220">America</span></p><p ttm:agent="v1" begin="02:22.280" end="02:24.890"><span begin="02:22.280" end="02:22.790">Welcome </span><span begin="02:22.790" end="02:23.060">to </span><span begin="02:23.060" end="02:23.240">a </span><span begin="02:23.240" end="02:23.570">new </span><span begin="02:23.570" end="02:23.990">kind </span><span begin="02:23.990" end="02:24.050">of </span><span begin="02:24.050" end="02:24.890">tension</span></p><p ttm:agent="v1" begin="02:25.010" end="02:27.050"><span begin="02:25.010" end="02:25.280">All </span><span begin="02:25.280" end="02:25.730">across </span><span begin="02:25.730" end="02:25.940">the </span><span begin="02:25.940" end="02:26.660">alien </span><span begin="02:26.660" end="02:27.050">nation</span></p><p ttm:agent="v1" begin="02:27.740" end="02:31.100"><span begin="02:27.740" end="02:28.160">Everything </span><span begin="02:28.160" end="02:28.460">isn't </span><span begin="02:28.460" end="02:28.730">meant </span><span begin="02:28.730" end="02:29.060">to </span><span begin="02:29.060" end="02:29.510">be </span><span begin="02:29.510" end="02:31.100">okay</span></p><p ttm:agent="v1" begin="02:32.750" end="02:35.270"><span begin="02:32.750" end="02:33.560">Television </span><span begin="02:33.560" end="02:34.040">dreams </span><span begin="02:34.040" end="02:34.250">of </span><span begin="02:34.250" end="02:35.270">tomorrow</span></p><p ttm:agent="v1" begin="02:35.300" end="02:37.910"><span begin="02:35.300" end="02:35.660">We're </span><span begin="02:35.660" end="02:35.990">not </span><span begin="02:35.990" end="02:36.200">the </span><span begin="02:36.200" end="02:36.560">ones' </span><span begin="02:36.560" end="02:36.650">who're </span><span begin="02:36.650" end="02:36.860">meant </span><span begin="02:36.860" end="02:36.980">to </span><span begin="02:36.980" end="02:37.910">follow</span></p><p ttm:agent="v1" begin="02:37.910" end="02:40.340"><span begin="02:37.910" end="02:38.300">For </span><span begin="02:38.300" end="02:38.570">that's </span><span begin="02:38.570" end="02:39.080">enough </span><span begin="02:39.080" end="02:39.530">to </span><span begin="02:39.530" end="02:40.340">argue</span></p></div></body></tt>