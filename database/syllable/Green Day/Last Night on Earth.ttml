<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Last Night on Earth</ttm:title><ttm:agent type="person" xml:id="v1">Green Day</ttm:agent><ttm:item type="album">21st Century Breakdown</ttm:item><ttm:item type="spotify_id">5TpPSTItCwtZ8Sltr3vdzm</ttm:item><itunes:duration>03:56.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:16.661" end="00:20.841"><span begin="00:16.661" end="00:17.031">I </span><span begin="00:17.031" end="00:17.471">text </span><span begin="00:17.471" end="00:17.911">a </span><span begin="00:17.911" end="00:19.041">postcard  </span><span begin="00:19.041" end="00:19.411">sent </span><span begin="00:19.411" end="00:19.721">to </span><span begin="00:19.721" end="00:20.681">you</span></p><p ttm:agent="v1" begin="00:20.681" end="00:22.491"><span begin="00:20.681" end="00:20.991">Did </span><span begin="00:20.991" end="00:21.241">it </span><span begin="00:21.241" end="00:21.681">go </span><span begin="00:21.681" end="00:25.121">through </span></p><p ttm:agent="v1" begin="00:25.121" end="00:29.241"><span begin="00:25.121" end="00:25.741">Sending </span><span begin="00:25.741" end="00:26.371">all </span><span begin="00:26.371" end="00:26.741">my </span><span begin="00:26.741" end="00:27.301">love </span><span begin="00:27.301" end="00:27.741">to </span><span begin="00:27.741" end="00:29.241">you</span></p><p ttm:agent="v1" begin="00:31.611" end="00:40.411"><span begin="00:31.611" end="00:32.421">You </span><span begin="00:32.421" end="00:33.111">are </span><span begin="00:33.111" end="00:33.791">the </span><span begin="00:33.791" end="00:34.481">moonlight </span><span begin="00:34.481" end="00:35.171">of </span><span begin="00:35.171" end="00:35.731">my </span><span begin="00:35.731" end="00:36.791">life </span><span begin="00:36.791" end="00:37.541">every </span><span begin="00:37.541" end="00:40.411">night</span></p><p ttm:agent="v1" begin="00:40.411" end="00:47.091"><span begin="00:40.411" end="00:41.721">Giving </span><span begin="00:41.721" end="00:42.341">all </span><span begin="00:42.341" end="00:42.781">my </span><span begin="00:42.781" end="00:43.531">love </span><span begin="00:43.531" end="00:43.841">to </span><span begin="00:43.841" end="00:47.091">you</span></p><p ttm:agent="v1" begin="00:47.091" end="00:53.141"><span begin="00:47.091" end="00:48.581">My </span><span begin="00:48.581" end="00:49.461">beating </span><span begin="00:49.461" end="00:50.461">heart </span><span begin="00:50.461" end="00:51.201">belongs </span><span begin="00:51.201" end="00:51.771">to </span><span begin="00:51.771" end="00:56.001">you</span></p><p ttm:agent="v1" begin="00:56.001" end="01:04.361"><span begin="00:56.001" end="00:56.621">I </span><span begin="00:56.621" end="00:57.311">walked </span><span begin="00:57.311" end="00:57.811">for </span><span begin="00:57.811" end="00:58.491">miles </span><span begin="00:58.491" end="00:58.801">til </span><span begin="00:58.801" end="00:59.241">I </span><span begin="00:59.241" end="00:59.621">found </span><span begin="00:59.621" end="01:04.361">you</span></p><p ttm:agent="v1" begin="01:04.361" end="01:07.481"><span begin="01:04.361" end="01:04.861">I'm </span><span begin="01:04.861" end="01:05.301">here </span><span begin="01:05.301" end="01:05.731">to </span><span begin="01:05.731" end="01:06.611">honor </span><span begin="01:06.611" end="01:07.481">you</span></p><p ttm:agent="v1" begin="01:07.481" end="01:13.531"><span begin="01:07.481" end="01:08.291">If </span><span begin="01:08.291" end="01:08.791">I </span><span begin="01:08.791" end="01:09.291">lose </span><span begin="01:09.291" end="01:10.971">everything </span><span begin="01:10.971" end="01:11.601">in </span><span begin="01:11.601" end="01:11.911">the </span><span begin="01:11.911" end="01:13.531">fire</span></p><p ttm:agent="v1" begin="01:13.531" end="01:18.281"><span begin="01:13.531" end="01:13.781">I'm </span><span begin="01:13.781" end="01:14.031">sending </span><span begin="01:14.031" end="01:14.471">all </span><span begin="01:14.471" end="01:14.911">my </span><span begin="01:14.911" end="01:15.591">love </span><span begin="01:15.591" end="01:15.841">to </span><span begin="01:15.841" end="01:18.281">you</span></p><p ttm:agent="v1" begin="01:32.691" end="01:37.061"><span begin="01:32.691" end="01:33.131">With </span><span begin="01:33.131" end="01:33.631">every </span><span begin="01:33.631" end="01:34.381">breath </span><span begin="01:34.381" end="01:34.941">that </span><span begin="01:34.941" end="01:35.311">I </span><span begin="01:35.311" end="01:35.751">am </span><span begin="01:35.751" end="01:37.061">worth</span></p><p ttm:agent="v1" begin="01:37.061" end="01:40.551"><span begin="01:37.061" end="01:37.501">Here </span><span begin="01:37.501" end="01:38.001">on </span><span begin="01:38.001" end="01:40.551">Earth</span></p><p ttm:agent="v1" begin="01:40.551" end="01:47.871"><span begin="01:40.551" end="01:41.011">I'm </span><span begin="01:41.011" end="01:41.631">sending </span><span begin="01:41.631" end="01:42.201">all </span><span begin="01:42.201" end="01:42.691">my </span><span begin="01:42.691" end="01:43.321">love </span><span begin="01:43.321" end="01:43.811">to </span><span begin="01:43.811" end="01:47.871">you</span></p><p ttm:agent="v1" begin="01:47.871" end="01:52.871"><span begin="01:47.871" end="01:48.561">So </span><