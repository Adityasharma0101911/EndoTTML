<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Feelings</ttm:title><ttm:agent type="person" xml:id="v1">PinkPantheress</ttm:agent><ttm:item type="album">Heaven knows</ttm:item><ttm:item type="spotify_id">6MNSwUUjWSDUhuCZaTezAn</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:08.880" end="00:10.680"><span begin="00:08.880" end="00:09.210">Breath </span><span begin="00:09.210" end="00:09.540">comes </span><span begin="00:09.540" end="00:09.810">out </span><span begin="00:09.810" end="00:09.990">of </span><span begin="00:09.990" end="00:10.680">me</span></p><p ttm:agent="v1" begin="00:10.680" end="00:12.750"><span begin="00:10.680" end="00:10.980">It's </span><span begin="00:10.980" end="00:11.160">my </span><span begin="00:11.160" end="00:12.750">philosophy</span></p><p ttm:agent="v1" begin="00:12.750" end="00:14.790"><span begin="00:12.750" end="00:12.990">It </span><span begin="00:12.990" end="00:13.440">only </span><span begin="00:13.440" end="00:13.830">slows </span><span begin="00:13.830" end="00:14.040">you </span><span begin="00:14.040" end="00:14.550">down</span></p><p ttm:agent="v1" begin="00:14.790" end="00:17.100"><span begin="00:14.790" end="00:15.030">You </span><span begin="00:15.030" end="00:15.360">can't </span><span begin="00:15.360" end="00:15.690">look </span><span begin="00:15.690" end="00:15.870">at </span><span begin="00:15.870" end="00:16.020">me </span><span begin="00:16.020" end="00:17.040">now</span></p><p ttm:agent="v1" begin="00:17.100" end="00:19.200"><span begin="00:17.100" end="00:17.700">Wires </span><span begin="00:17.700" end="00:17.910">on </span><span begin="00:17.910" end="00:18.030">the </span><span begin="00:18.030" end="00:19.110">floor</span></p><p ttm:agent="v1" begin="00:19.200" end="00:22.920"><span begin="00:19.200" end="00:19.380">It </span><span begin="00:19.380" end="00:19.680">plays </span><span begin="00:19.680" end="00:20.640">24 </span><span begin="00:20.640" end="00:20.970"> </span><span begin="00:20.970" end="00:21.210">of </span><span begin="00:21.210" end="00:21.480">the </span><span begin="00:21.480" end="00:22.050">hours </span><span begin="00:22.050" end="00:22.200">a </span><span begin="00:22.200" end="00:22.890">day</span></p><p ttm:agent="v1" begin="00:22.920" end="00:25.260"><span begin="00:22.920" end="00:23.550">Hearing </span><span begin="00:23.550" end="00:23.760">it </span><span begin="00:23.760" end="00:24.030">keeps </span><span begin="00:24.030" end="00:24.240">me </span><span begin="00:24.240" end="00:24.810">sane</span></p><p ttm:agent="v1" begin="00:25.260" end="00:27.360"><span begin="00:25.260" end="00:25.560">This </span><span begin="00:25.560" end="00:26.160">feeling </span><span begin="00:26.160" end="00:26.340">I </span><span begin="00:26.340" end="00:27.120">pay </span><span begin="00:27.120" end="00:27.360">you</span></p><p ttm:agent="v1" begin="00:27.360" end="00:29.190"><span begin="00:27.360" end="00:27.600">While </span><span begin="00:27.600" end="00:27.900">you're </span><span begin="00:27.900" end="00:28.170">on </span><span begin="00:28.170" end="00:28.260">the </span><span begin="00:28.260" end="00:28.950">stage</span></p><p ttm:agent="v1" begin="00:29.190" end="00:31.050"><span begin="00:29.190" end="00:29.490">No</span><span begin="00:29.490" end="00:29.490">, </span><span begin="00:29.490" end="00:29.640">I </span><span begin="00:29.640" end="00:29.970">can't </span><span begin="00:29.970" end="00:30.300">take </span><span begin="00:30.300" end="00:30.450">a </span><span begin="00:30.450" end="00:31.020">pill</span></p><p ttm:agent="v1" begin="00:31.050" end="00:33.480"><span begin="00:31.050" end="00:31.530">And </span><span begin="00:31.530" end="00:31.740">yet </span><span begin="00:31.740" end="00:31.770"> </span><span begin="00:31.770" end="00:31.980">I </span><span begin="00:31.980" end="00:32.190">can't </span><span begin="00:32.190" end="00:32.460">stay </span><span begin="00:32.460" end="00:32.970">still</span></p><p ttm:agent="v1" begin="00:33.480" end="00:37.710"><span begin="00:33.480" end="00:33.870">Now </span><span begin="00:33.870" end="00:34.080">I'm </span><span begin="00:34.080" end="00:35.070">wondering </span><span begin="00:35.070" end="00:35.430">what </span><span begin="00:35.430" end="00:35.850">made </span><span begin="00:35.850" end="00:36.030">me </span><span begin="00:36.030" end="00:36.420">feel </span><span begin="00:36.420" end="00:36.900">this </span><span begin="00:36.900" end="00:37.710">way</span></p><p ttm:agent="v1" begin="00:37.710" end="00:39.420"><span begin="00:37.710" end="00:37.920">Because </span><span begin="00:37.920" end="00:37.950"> </span><span begin="00:37.950" end="00:38.160">I </span><span begin="00:38.160" end="00:38.400">can't </span><span begin="00:38.400" end="00:38.640">stay </span><span begin="00:38.640" end="00:39.240">sure</span></p><p ttm:agent="v1" begin="00:39.420" end="00:40.710"><span begin="00:39.420" end="00:39.600">I'll </span><span begin="00:39.600" end="00:40.290">carry </span><span begin="00:40.290" end="00:40.470">on</span><span begin="00:40.470" end="00:40.470">, </span><span begin="00:40.470" end="00:40.710">ignore</span></p><p ttm:agent="v1" begin="00:40.710" end="00:43.260"><span begin="00:40.710" end="00:40.980">My </span><span begin="00:40.980" end="00:43.260">worries</span></p><p ttm:agent="v1" begin="00:43.260" end="00:47.100"><span begin="00:43.260" end="00:43.440">'Cause </span><span begin="00:43.440" end="00:43.560">no </span><span begin="00:43.560" end="00:43.830">one </span><span begin="00:43.830" end="00:44.220">ever </span><span begin="00:44.220" end="00:44.610">told </span><span begin="00:44.610" end="00:44.760">me </span><span begin="00:44.760" end="00:45.030">to </span><span begin="00:45.030" end="00:47.100">worry</span></p><p ttm:agent="v1" begin="00:47.100" end="00:51.240"><span begin="00:47.100" end="00:47.370">I </span><span begin="00:47.370" end="00:47.940">realise </span><span begin="00:47.940" end="00:48.210">that </span><span begin="00:48.210" end="00:48.360">I'm </span><span begin="00:48.360" end="00:48.900">peaking </span><span begin="00:48.900" end="00:49.230">too </span><span begin="00:49.230" end="00:49.320">early</span></p><p ttm:agent="v1" begin="00:51.240" end="00:55.410"><span begin="00:51.240" end="00:51.540">But </span><span begin="00:51.540" end="00:51.780">I </span><span begin="00:51.780" end="00:51.960">don't </span><span begin="00:51.960" end="00:52.260">want </span><span begin="00:52.260" end="00:52.470">that </span><span begin="00:52.470" end="00:53.010">making </span><span begin="00:53.010" end="00:53.250">you </span><span begin="00:53.250" end="00:55.410">worry</span></p><p ttm:agent="v1" begin="00:55.410" end="00:58.110"><span begin="00:55.410" end="00:55.590">'Cause </span><span begin="00:55.590" end="00:55.920">no </span><span begin="00:55.920" end="00:56.130">one </span><span begin="00:56.130" end="00:56.520">ever </span><span begin="00:56.520" end="00:56.910">told </span><span begin="00:56.910" end="00:57.060">me </span><span begin="00:57.060" end="00:57.360">to </span><span begin="00:57.360" end="00:57.840">worry</span></p><p ttm:agent="v1" begin="00:58.110" end="00:59.940"><span begin="00:58.110" end="00:58.440">Breath </span><span begin="00:58.440" end="00:58.770">comes </span><span begin="00:58.770" end="00:59.040">out </span><span begin="00:59.040" end="00:59.220">of </span><span begin="00:59.220" end="00:59.940">me</span></p><p ttm:agent="v1" begin="00:59.940" end="01:01.980"><span begin="00:59.940" end="01:00.210">It's </span><span begin="01:00.210" end="01:00.390">my </span><span begin="01:00.390" end="01:01.920">philosophy</span></p><p ttm:agent="v1" begin="01:01.980" end="01:03.990"><span begin="01:01.980" end="01:02.220">I </span><span begin="01:02.220" end="01:02.430">won't </span><span begin="01:02.430" end="01:02.820">get </span><span begin="01:02.820" end="01:03.030">out </span><span begin="01:03.030" end="01:03.270">of </span><span begin="01:03.270" end="01:03.840">here</span></p><p ttm:agent="v1" begin="01:03.990" end="01:06.330"><span begin="01:03.990" end="01:04.260">It's </span><span begin="01:04.260" end="01:04.470">the </span><span begin="01:04.470" end="01:04.770">one </span><span begin="01:04.770" end="01:05.100">thing </span><span begin="01:05.100" end="01:05.250">I </span><span begin="01:05.250" end="01:06.270">fear</span></p><p ttm:agent="v1" begin="01:06.330" end="01:08.400"><span begin="01:06.330" end="01:06.930">Wires </span><span begin="01:06.930" end="01:07.140">on </span><span begin="01:07.140" end="01:07.260">the </span><span begin="01:07.260" end="01:08.340">floor</span></p><p ttm:agent="v1" begin="01:08.400" end="01:10.020"><span begin="01:08.400" end="01:08.610">It </span><span begin="01:08.610" end="01:08.910">plays </span><span begin="01:08.910" end="01:09.960">24</span></p><p ttm:agent="v1" begin="01:10.020" end="01:12.240"><span begin="01:10.020" end="01:10.380">He </span><span begin="01:10.380" end="01:10.710">can't </span><span begin="01:10.710" end="01:10.980">beg </span><span begin="01:10.980" end="01:11.250">me </span><span begin="01:11.250" end="01:11.370">to </span><span begin="01:11.370" end="01:12.000">stay</span></p><p ttm:agent="v1" begin="01:12.240" end="01:14.490"><span begin="01:12.240" end="01:12.480">You </span><span begin="01:12.480" end="01:12.540"> </span><span begin="01:12.540" end="01:12.720">won't </span><span begin="01:12.720" end="01:13.110">seem </span><span begin="01:13.110" end="01:14.040">unafraid</span></p><p ttm:agent="v1" begin="01:14.490" end="01:16.590"><span begin="01:14.490" end="01:14.790">This </span><span begin="01:14.790" end="01:15.390">feeling </span><span begin="01:15.390" end="01:15.570">I </span><span begin="01:15.570" end="01:16.350">pay </span><span begin="01:16.350" end="01:16.590">you</span></p><p ttm:agent="v1" begin="01:16.590" end="01:18.420"><span begin="01:16.590" end="01:16.830">While </span><span begin="01:16.830" end="01:17.130">you're </span><span begin="01:17.130" end="01:17.400">on </span><span begin="01:17.400" end="01:17.490">the </span><span begin="01:17.490" end="01:18.150">stage</span></p><p ttm:agent="v1" begin="01:18.420" end="01:20.490"><span begin="01:18.420" end="01:18.720">No</span><span begin="01:18.720" end="01:18.720">, </span><span begin="01:18.720" end="01:18.870">I </span><span begin="01:18.870" end="01:19.200">can't </span><span begin="01:19.200" end="01:19.530">take </span><span begin="01:19.530" end="01:19.680">a </span><span begin="01:19.680" end="01:20.220">pill</span></p><p ttm:agent="v1" begin="01:20.490" end="01:22.710"><span begin="01:20.490" end="01:20.760">And </span><span begin="01:20.760" end="01:20.970">yet </span><span begin="01:20.970" end="01:21.000"> </span><span begin="01:21.000" end="01:21.180">I </span><span begin="01:21.180" end="01:21.420">can't </span><span begin="01:21.420" end="01:21.690">stay </span><span begin="01:21.690" end="01:22.200">still</span></p><p ttm:agent="v1" begin="01:22.710" end="01:26.760"><span begin="01:22.710" end="01:23.070">Now </span><span begin="01:23.070" end="01:23.310">I'm </span><span begin="01:23.310" end="01:24.300">wondering </span><span begin="01:24.300" end="01:24.660">what </span><span begin="01:24.660" end="01:25.080">made </span><span begin="01:25.080" end="01:25.290">me </span><span begin="01:25.290" end="01:25.650">feel </span><span begin="01:25.650" end="01:26.130">this </span><span begin="01:26.130" end="01:26.760">way</span></p><p ttm:agent="v1" begin="01:26.760" end="01:28.650"><span begin="01:26.760" end="01:27.180">Because </span><span begin="01:27.180" end="01:27.360">I </span><span begin="01:27.360" end="01:27.630">can't </span><span begin="01:27.630" end="01:27.870">stay </span><span begin="01:27.870" end="01:28.380">sure</span></p><p ttm:agent="v1" begin="01:28.650" end="01:29.940"><span begin="01:28.650" end="01:28.860">I'll </span><span begin="01:28.860" end="01:29.490">carry </span><span begin="01:29.490" end="01:29.700">on</span><span begin="01:29.700" end="01:29.700">, </span><span begin="01:29.700" end="01:29.940">ignore</span></p><p ttm:agent="v1" begin="01:29.940" end="01:32.490"><span begin="01:29.940" end="01:30.210">My </span><span begin="01:30.210" end="01:32.490">worries</span></p><p ttm:agent="v1" begin="01:32.490" end="01:36.420"><span begin="01:32.490" end="01:32.670">'Cause </span><span begin="01:32.670" end="01:32.820">no </span><span begin="01:32.820" end="01:33.060">one </span><span begin="01:33.060" end="01:33.450">ever </span><span begin="01:33.450" end="01:33.840">told </span><span begin="01:33.840" end="01:33.990">me </span><span begin="01:33.990" end="01:34.260">to </span><span begin="01:34.260" end="01:36.330">worry</span></p><p ttm:agent="v1" begin="01:36.420" end="01:40.470"><span begin="01:36.420" end="01:36.600">I </span><span begin="01:36.600" end="01:37.170">realise </span><span begin="01:37.170" end="01:37.440">that </span><span begin="01:37.440" end="01:37.590">I'm </span><span begin="01:37.590" end="01:38.130">peaking </span><span begin="01:38.130" end="01:38.460">too </span><span begin="01:38.460" end="01:38.580">early</span></p><p ttm:agent="v1" begin="01:40.470" end="01:44.520"><span begin="01:40.470" end="01:40.740">But </span><span begin="01:40.740" end="01:41.010">I </span><span begin="01:41.010" end="01:41.220">don't </span><span begin="01:41.220" end="01:41.490">want </span><span begin="01:41.490" end="01:41.700">that </span><span begin="01:41.700" end="01:42.270">making </span><span begin="01:42.270" end="01:42.480">you </span><span begin="01:42.480" end="01:44.520">worry</span></p><p ttm:agent="v1" begin="01:44.520" end="01:47.670"><span begin="01:44.520" end="01:44.820">'Cause </span><span begin="01:44.820" end="01:45.150">no </span><span begin="01:45.150" end="01:45.390">one </span><span begin="01:45.390" end="01:45.750">ever </span><span begin="01:45.750" end="01:46.140">told </span><span begin="01:46.140" end="01:46.290">me </span><span begin="01:46.290" end="01:46.590">to </span><span begin="01:46.590" end="01:46.830">worry</span></p><p ttm:agent="v1" begin="01:47.670" end="01:49.680"><span begin="01:47.670" end="01:48.090">I'll </span><span begin="01:48.090" end="01:48.390">never </span><span begin="01:48.390" end="01:48.720">give </span><span begin="01:48.720" end="01:49.020">it </span><span begin="01:49.020" end="01:49.680">up</span></p><p ttm:agent="v1" begin="01:49.680" end="01:51.720"><span begin="01:49.680" end="01:49.800">This </span><span begin="01:49.800" end="01:49.980">is </span><span begin="01:49.980" end="01:50.760">everything </span><span begin="01:50.760" end="01:51.210">I </span><span begin="01:51.210" end="01:51.720">wanted</span></p><p ttm:agent="v1" begin="01:51.720" end="01:53.730"><span begin="01:51.720" end="01:52.020">This </span><span begin="01:52.020" end="01:52.200"> </span><span begin="01:52.200" end="01:52.830">feeling </span><span begin="01:52.830" end="01:52.980">I </span><span begin="01:52.980" end="01:53.700">love</span></p><p ttm:agent="v1" begin="01:53.730" end="01:55.830"><span begin="01:53.730" end="01:53.910">If </span><span begin="01:53.910" end="01:54.030">you </span><span begin="01:54.030" end="01:54.240">weren't </span><span begin="01:54.240" end="01:54.810">singing </span><span begin="01:54.810" end="01:54.990">your </span><span begin="01:54.990" end="01:55.770">chorus</span></p><p ttm:agent="v1" begin="01:55.830" end="01:57.870"><span begin="01:55.830" end="01:56.310">I'll </span><span begin="01:56.310" end="01:56.610">never </span><span begin="01:56.610" end="01:56.940">give </span><span begin="01:56.940" end="01:57.210">it </span><span begin="01:57.210" end="01:57.870">up</span></p><p ttm:agent="v1" begin="01:57.870" end="01:59.940"><span begin="01:57.870" end="01:58.020">This </span><span begin="01:58.020" end="01:58.200">is </span><span begin="01:58.200" end="01:58.920">everything </span><span begin="01:58.920" end="01:59.130">we </span><span begin="01:59.130" end="01:59.940">wanted</span></p><p ttm:agent="v1" begin="01:59.940" end="02:01.980"><span begin="01:59.940" end="02:00.450">This </span><span begin="02:00.450" end="02:00.690">whole </span><span begin="02:00.690" end="02:00.990">thing </span><span begin="02:00.990" end="02:01.320">went </span><span begin="02:01.320" end="02:01.530">up</span></p><p ttm:agent="v1" begin="02:01.980" end="02:40.420"><span begin="02:01.980" end="02:02.250">While </span><span begin="02:02.250" end="02:02.340">we're </span><span begin="02:02.340" end="02:02.400">all </span><span begin="02:02.400" end="02:02.550">singing </span><span begin="02:02.550" end="02:02.700">your </span><span begin="02:02.700" end="02:03.240"> </span><span begin="02:03.240" end="02:03.840">chorus</span></p></div></body></tt>