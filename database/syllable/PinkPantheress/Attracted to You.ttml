<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Attracted to You</ttm:title><ttm:agent type="person" xml:id="v1">PinkPantheress</ttm:agent><ttm:item type="album">Attracted To You</ttm:item><ttm:item type="spotify_id">4fPjI40ElIwJQ4DJJxSCOe</ttm:item><itunes:duration>01:07.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:16.808" end="00:19.143"><span begin="00:16.808" end="00:17.249">I </span><span begin="00:17.249" end="00:17.453">thought </span><span begin="00:17.453" end="00:17.730">I </span><span begin="00:17.730" end="00:18.065">found </span><span begin="00:18.065" end="00:18.314">the </span><span begin="00:18.314" end="00:18.567">answer </span><span begin="00:18.567" end="00:19.029">to </span><span begin="00:19.029" end="00:19.143">it</span></p><p ttm:agent="v1" begin="00:19.343" end="00:21.823"><span begin="00:19.343" end="00:19.725">Eternal </span><span begin="00:19.725" end="00:20.725">happiness </span><span begin="00:20.823" end="00:21.823">tonight</span></p><p ttm:agent="v1" begin="00:22.266" end="00:24.920"><span begin="00:22.266" end="00:22.447">But </span><span begin="00:22.447" end="00:22.600">it </span><span begin="00:22.600" end="00:22.763">was </span><span begin="00:22.763" end="00:22.999">just </span><span begin="00:22.999" end="00:23.171">another </span><span begin="00:23.171" end="00:23.430">blip </span><span begin="00:23.430" end="00:23.620">in </span><span begin="00:23.620" end="00:23.920">my </span><span begin="00:23.920" end="00:24.920">heart</span></p><p ttm:agent="v1" begin="00:25.473" end="00:27.420"><span begin="00:25.473" end="00:25.719">Sometimes </span><span begin="00:25.719" end="00:26.119">I </span><span begin="00:26.119" end="00:26.308">think </span><span begin="00:26.308" end="00:26.507">of </span><span begin="00:26.507" end="00:26.813">calling </span><span begin="00:26.813" end="00:27.166">you </span><span begin="00:27.166" end="00:27.420">up</span></p><p ttm:agent="v1" begin="00:27.620" end="00:30.506"><span begin="00:27.620" end="00:27.939">To </span><span begin="00:27.939" end="00:28.201">make </span><span begin="00:28.201" end="00:28.897">myself </span><span begin="00:28.897" end="00:29.198">look </span><span begin="00:29.198" end="00:29.506">bad </span><span begin="00:29.506" end="00:30.506">again</span></p><p ttm:agent="v1" begin="00:30.641" end="00:32.967"><span begin="00:30.641" end="00:30.879">But </span><span begin="00:30.879" end="00:31.078">now </span><span begin="00:31.078" end="00:31.292">im </span><span begin="00:31.292" end="00:31.446">bringing </span><span begin="00:31.446" end="00:31.701">flowers </span><span begin="00:31.701" end="00:31.942">to </span><span begin="00:31.942" end="00:32.219">your </span><span begin="00:32.219" end="00:32.487">front </span><span begin="00:32.487" end="00:32.967">doo</span></p><p ttm:agent="v1" begin="00:33.167" end="00:34.335"><span begin="00:33.167" end="00:33.325">Last </span><span begin="00:33.325" end="00:33.479">night </span><span begin="00:33.479" end="00:33.655">I </span><span begin="00:33.655" end="00:33.866">had </span><span begin="00:33.866" end="00:34.113">a </span><span begin="00:34.113" end="00:34.335">dream</span></p><p ttm:agent="v1" begin="00:34.535" end="00:37.219"><span begin="00:34.535" end="00:34.832">We </span><span begin="00:34.832" end="00:35.013">started </span><span begin="00:35.013" end="00:35.196">dating </span><span begin="00:35.196" end="00:35.690">now </span><span begin="00:35.690" end="00:35.941">you're </span><span begin="00:35.941" end="00:36.204">pissing </span><span begin="00:36.204" end="00:36.781">me </span><span begin="00:36.781" end="00:37.219">off</span></p><p ttm:agent="v1" begin="00:37.419" end="00:39.314"><span begin="00:37.419" end="00:37.668">I </span><span begin="00:37.668" end="00:37.967">know </span><span begin="00:37.967" end="00:38.222">it's </span><span begin="00:38.222" end="00:38.516">not </span><span begin="00:38.516" end="00:38.799">la </span><span begin="00:38.799" end="00:39.013">la </span><span begin="00:39.013" end="00:39.314">love</span></p><p ttm:agent="v1" begin="00:39.514" end="00:41.508"><span begin="00:39.514" end="00:39.787">It's </span><span begin="00:39.787" end="00:40.063">not </span><span begin="00:40.063" end="00:40.684">something </span><span begin="00:40.684" end="00:40.908">i </span><span begin="00:40.908" end="00:41.508">want</span></p><p ttm:agent="v1" begin="00:41.708" end="00:45.659"><span begin="00:41.708" end="00:42.005">I'm </span><span begin="00:42.005" end="00:43.005">not </span><span begin="00:43.187" end="00:43.544">attracted </span><span begin="00:43.544" end="00:43.973">to </span><span begin="00:43.973" end="00:44.465">you, </span><span begin="00:44.465" end="00:44.785">like </span><span begin="00:44.785" end="00:45.182">i </span><span begin="00:45.182" end="00:45.659">was</span></p><p ttm:agent="v1" begin="00:45.859" end="00:47.658"><span begin="00:45.859" end="00:46.148">Back </span><span begin="00:46.148" end="00:46.384">at </span><span begin="00:46.384" end="00:46.632">the </span><span begin="00:46.632" end="00:46.885">start(back </span><span begin="00:46.885" end="00:47.182">at </span><span begin="00:47.182" end="00:47.577">the </span><span begin="00:47.577" end="00:47.658">start)</span></p><p ttm:agent="v1" begin="00:47.858" end="00:50.730"><span begin="00:47.858" end="00:48.240">Back </span><span begin="00:48.240" end="00:48.514">at </span><span begin="00:48.514" end="00:48.763">the </span><span begin="00:48.763" end="00:49.077">start(back </span><span begin="00:49.077" end="00:49.310">at </span><span begin="00:49.310" end="00:49.730">the </span><span begin="00:49.730" end="00:50.730">start)</span></p><p ttm:agent="v1" begin="00:50.890" end="00:55.615"><span begin="00:50.890" end="00:51.890">You're </span><span begin="00:52.444" end="00:52.721">in </span><span begin="00:52.721" end="00:52.980">my </span><span begin="00:52.980" end="00:53.375">head </span><span begin="00:53.375" end="00:53.593">so </span><span begin="00:53.593" end="00:53.831">l </span><span begin="00:53.831" end="00:54.128">can't </span><span begin="00:54.128" end="00:54.374">now </span><span begin="00:54.374" end="00:54.615">forget </span><span begin="00:54.615" end="00:55.615">you</span></p><p ttm:agent="v1" begin="00:56.315" end="01:00.276"><span begin="00:56.315" end="00:56.594">You're </span><span begin="00:56.594" end="00:56.885">in </span><span begin="00:56.885" end="00:57.152">my </span><span begin="00:57.152" end="00:57.412">head </span><span begin="00:57.412" end="00:57.672">so </span><span begin="00:57.672" end="00:57.969">I </span><span begin="00:57.969" end="00:58.228">can't- </span><span begin="00:58.228" end="00:58.751">so </span><span begin="00:58.751" end="00:59.005">I </span><span begin="00:59.005" end="00:59.276">can't </span><span begin="00:59.276" end="01:00.276">now-</span></p><p ttm:agent="v1" begin="01:00.604" end="01:03.746"><span begin="01:00.604" end="01:00.865">You're </span><span begin="01:00.865" end="01:01.124">in </span><span begin="01:01.124" end="01:01.360">my </span><span begin="01:01.360" end="01:01.617">head </span><span begin="01:01.617" end="01:01.862">so </span><span begin="01:01.862" end="01:02.154">l </span><span begin="01:02.154" end="01:02.421">can't </span><span begin="01:02.421" end="01:02.719">now </span><span begin="01: