<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>love languages</ttm:title><ttm:agent type="person" xml:id="v1">CHSKA</ttm:agent><ttm:item type="album">love letter</ttm:item><ttm:item type="spotify_id">29nNdiWubkjhujeV4ZImV9</ttm:item><itunes:duration>02:13.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:17.814" end="00:22.654"><span begin="00:17.814" end="00:18.552">And </span><span begin="00:18.552" end="00:19.178">I </span><span begin="00:19.178" end="00:19.892">can't </span><span begin="00:19.892" end="00:20.433">sleep </span><span begin="00:20.433" end="00:20.822">at </span><span begin="00:20.822" end="00:22.654">night</span></p><p ttm:agent="v1" begin="00:24.255" end="00:31.058"><span begin="00:24.255" end="00:24.908">Knowin' </span><span begin="00:24.908" end="00:25.593">that </span><span begin="00:25.593" end="00:25.896">you're </span><span begin="00:25.896" end="00:26.772">not </span><span begin="00:26.772" end="00:28.056">remotely </span><span begin="00:28.056" end="00:28.743">close </span><span begin="00:28.743" end="00:28.997">to </span><span begin="00:28.997" end="00:31.058">me</span></p><p ttm:agent="v1" begin="00:34.417" end="00:39.693"><span begin="00:34.417" end="00:35.218">And </span><span begin="00:35.218" end="00:35.664">they </span><span begin="00:35.664" end="00:36.159">said </span><span begin="00:36.159" end="00:36.529">that </span><span begin="00:36.529" end="00:37.051">we're </span><span begin="00:37.051" end="00:37.651">still </span><span begin="00:37.651" end="00:39.693">young</span></p><p ttm:agent="v1" begin="00:40.707" end="00:48.603"><span begin="00:40.707" end="00:41.041">But </span><span begin="00:41.041" end="00:41.638">I </span><span begin="00:41.638" end="00:41.899">would </span><span begin="00:41.899" end="00:42.614">rather </span><span begin="00:42.614" end="00:43.065">not </span><span begin="00:43.065" end="00:43.565">go </span><span begin="00:43.565" end="00:44.826">fishin' </span><span begin="00:44.826" end="00:45.227">in </span><span begin="00:45.227" end="00:45.712">the </span><span begin="00:45.712" end="00:48.603">sea</span></p><p ttm:agent="v1" begin="00:50.929" end="00:56.032"><span begin="00:50.929" end="00:51.208">'Di </span><span begin="00:51.208" end="00:56.032">inaakalang</span></p><p ttm:agent="v1" begin="00:58.220" end="01:05.306"><span begin="00:58.220" end="00:59.384">Ikaw </span><span begin="00:59.384" end="01:00.064">sa </span><span begin="01:00.064" end="01:01.198">lahat </span><span begin="01:01.506" end="01:01.732">ang </span><span begin="01:01.732" end="01:05.306">mahagkan</span></p><p ttm:agent="v1" begin="01:06.042" end="01:13.188"><span begin="01:06.042" end="01:06.539">At </span><span begin="01:06.539" end="01:08.251">isang </span><span begin="01:08.409" end="01:09.792">minutong </span><span begin="01:09.792" end="01:13.188">lumilipas</span></p><p ttm:agent="v1" begin="01:14.386" end="01:22.155"><span begin="01:14.386" end="01:14.899">Tila </span><span begin="01:14.899" end="01:15.709">isang </span><span begin="01:15.709" end="01:16.747">milyong </span><span begin="01:16.747" end="01:18.235">segundong </span><span begin="01:18.235" end="01:22.155">umatras</span></p><p ttm:agent="v1" begin="01:24.534" end="01:27.083"><span begin="01:24.534" end="01:25.102">Bailemos </span><span begin="01:25.102" end="01:25.552">ese </span><span begin="01:25.552" end="01:27.083">ritmo</span></p><p ttm:agent="v1" begin="01:27.960" end="01:31.513"><span begin="01:27.960" end="01:28.467">Estás </span><span begin="01:28.467" end="01:29.259">cantando </span><span begin="01:29.259" end="01:29.553">a </span><span begin="01:29.553" end="01:29.820">la </span><span begin="01:29.820" end="01:31.513">música</span></p><p ttm:agent="v1" begin="01:32.177" end="01:35.164"><span begin="01:32.177" end="01:33.200">Protégeme </span><span begin="01:33.200" end="01:33.474">de </span><span begin="01:33.474" end="01:33.717">los </span><span begin="01:33.717" end="01:35.164">peligros</span></p><p ttm:agent="v1" begin="01:35.341" end="01:41.016"><span begin="01:35.341" end="01:35.567">Te </span><span begin="01:35.567" end="01:36.358">amaré </span><span begin="01:36.358" end="01:36.959">por </span><span begin="01:36.959" end="01:37.301">mil </span><span begin="01:37.604" end="01:38.874">décadas </span><span begin="01:38.874" end="01:39.297">y </span><span begin="01:39.297" end="01:40.005">mucho </span><span begin="01:40.005" end="01:41.016">más</span></p><p ttm:agent="v1" begin="01:41.016" end="01:46.925"><span begin="01:41.016" end="01:42.283">And </span><span begin="01:42.604" end="01:43.136">I </span><span begin="01:43.136" end="01:43.487">can't </span><span begin="01:43.487" end="01:43.780">sleep </span><span begin="01:43.780" end="01:44.305">at </span><span begin="01:44.305" end="01:46.925">night</span></p><p ttm:agent="v1" begin="01:48.041" end="01:55.002"><span begin="01:48.041" end="01:48.647">Knowin' </span><span begin="01:48.647" end="01:49.044">that </span><span begin="01:49.044" end="01:49.384">you're </span><span begin="01:49.384" end="01:49.861">not </span><span begin="01:50.117" end="01:51.713">remotely </span><span begin="01:51.713" end="01:52.379">close </span><span begin="01:52.379" end="01:53.331">to </span><span begin="01:53.331" end="01:55.002">me</span></p></div></body></tt>