<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Man in the Box</ttm:title><ttm:agent type="person" xml:id="v1">Alice In Chains</ttm:agent><ttm:item type="album">Facelift</ttm:item><ttm:item type="spotify_id">6gZVQvQZOFpzIy3HblJ20F</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:37.570" end="00:42.910"><span begin="00:37.570" end="00:39.220">I'm </span><span begin="00:39.220" end="00:39.430">the </span><span begin="00:39.430" end="00:41.260">man </span><span begin="00:41.260" end="00:41.500">in </span><span begin="00:41.500" end="00:41.740">the </span><span begin="00:41.740" end="00:42.910">box</span></p><p ttm:agent="v1" begin="00:46.630" end="00:55.570"><span begin="00:46.630" end="00:48.790">Buried </span><span begin="00:48.790" end="00:50.650">in </span><span begin="00:50.650" end="00:51.010">my </span><span begin="00:51.010" end="00:52.150">*</span><span begin="00:52.150" end="00:53.290">*</span><span begin="00:53.290" end="00:54.430">*</span><span begin="00:54.430" end="00:55.570">*</span></p><p ttm:agent="v1" begin="00:55.570" end="01:08.560"><span begin="00:55.570" end="00:58.030">Won't </span><span begin="00:58.030" end="01:00.130">you </span><span begin="01:00.130" end="01:02.470">come </span><span begin="01:02.470" end="01:04.120">and </span><span begin="01:04.120" end="01:04.870">save </span><span begin="01:04.870" end="01:05.830">me</span><span begin="01:05.830" end="01:08.560">,</span></p><p ttm:agent="v1" begin="01:08.560" end="01:10.000"><span begin="01:08.560" end="01:09.490">save </span><span begin="01:09.490" end="01:10.000">me</span></p><p ttm:agent="v1" begin="01:16.840" end="01:19.750"><span begin="01:16.840" end="01:17.050">Feed </span><span begin="01:17.050" end="01:17.500">my </span><span begin="01:17.500" end="01:19.720">eyes</span><span begin="01:19.720" end="01:19.750">,</span></p><p ttm:agent="v1" begin="01:19.750" end="01:24.040"><span begin="01:19.750" end="01:20.710">can </span><span begin="01:20.710" end="01:20.860">you </span><span begin="01:20.860" end="01:21.490">sew </span><span begin="01:21.490" end="01:21.940">them </span><span begin="01:21.940" end="01:22.300">shut</span><span begin="01:22.300" end="01:24.040">?</span></p><p ttm:agent="v1" begin="01:24.040" end="01:28.450"><span begin="01:24.040" end="01:26.260">Jesus </span><span begin="01:26.260" end="01:28.420">Christ</span><span begin="01:28.420" end="01:28.450">,</span></p><p ttm:agent="v1" begin="01:28.450" end="01:30.880"><span begin="01:28.450" end="01:29.380">deny </span><span begin="01:29.380" end="01:29.620">your </span><span begin="01:29.620" end="01:30.880">maker</span></p><p ttm:agent="v1" begin="01:31.000" end="01:37.180"><span begin="01:31.000" end="01:34.510">He </span><span begin="01:34.510" end="01:34.900">who </span><span begin="01:34.900" end="01:37.180">tries</span><span begin="01:37.180" end="01:37.180">,</span></p><p ttm:agent="v1" begin="01:37.180" end="01:39.490"><span begin="01:37.180" end="01:37.990">will </span><span begin="01:37.990" end="01:38.260">be </span><span begin="01:38.260" end="01:39.490">wasted</span></p><p ttm:agent="v1" begin="01:39.490" end="01:45.790"><span begin="01:39.490" end="01:43.150">Feed </span><span begin="01:43.150" end="01:43.780">my </span><span begin="01:43.780" end="01:45.790">eyes</span></p><p ttm:agent="v1" begin="01:45.820" end="01:48.220"><span begin="01:45.820" end="01:46.600">now </span><span begin="01:46.600" end="01:46.810">you've </span><span begin="01:46.810" end="01:47.410">sewn </span><span begin="01:47.410" end="01:47.860">them </span><span begin="01:47.860" end="01:48.220">shut</span></p><p ttm:agent="v1" begin="02:01.510" end="02:11.740"><span begin="02:01.510" end="02:07.990">I'm </span><span begin="02:07.990" end="02:08.230">the </span><span begin="02:08.230" end="02:10.000">dog </span><span begin="02:10.000" end="02:10.270">who </span><span begin="02:10.270" end="02:10.780">gets </span><span begin="02:10.780" end="02:11.740">beat</span></p><p ttm:agent="v1" begin="02:15.160" end="02:24.280"><span begin="02:15.160" end="02:16.840">Shove </span><span begin="02:16.840" end="02:17.230">my </span><span begin="02:17.230" end="02:19.450">nose </span><span begin="02:19.450" end="02:19.720">in </span><span begin="02:19.720" end="02:20.860">*</span><span begin="02:20.860" end="02:22.000">*</span><span begin="02:22.000" end="02:23.140">*</span><span begin="02:23.140" end="02:24.280">*</span></p><p ttm:agent="v1" begin="02:24.280" end="02:37.060"><span begin="02:24.280" end="02:26.680">Won't </span><span begin="02:26.680" end="02:28.720">you </span><span begin="02:28.720" end="02:31.000">come </span><span begin="02:31.000" end="02:32.650">and </span><span begin="02:32.650" end="02:33.370">save </span><span begin="02:33.370" end="02:34.450">me</span><span begin="02:34.450" end="02:37.060">,</span></p><p ttm:agent="v1" begin="02:37.060" end="02:38.500"><span begin="02:37.060" end="02:38.020">save </span><span begin="02:38.020" end="02:38.500">me</span></p><p ttm:agent="v1" begin="02:43.690" end="02:48.190"><span begin="02:43.690" end="02:45.520">Feed </span><span begin="02:45.520" end="02:45.970">my </span><span begin="02:45.970" end="02:48.100">eyes</span><span begin="02:48.100" end="02:48.190">,</span></p><p ttm:agent="v1" begin="02:48.190" end="02:53.770"><span begin="02:48.190" end="02:49.120">can </span><span begin="02:49.120" end="02:49.270">you </span><span begin="02:49.270" end="02:49.900">sew </span><span begin="02:49.900" end="02:50.380">them </span><span begin="02:50.380" end="02:50.710">shut</span><span begin="02:50.710" end="02:53.770">?</span></p><p ttm:agent="v1" begin="02:53.770" end="02:56.830"><span begin="02:53.770" end="02:54.640">Jesus </span><span begin="02:54.640" end="02:56.800">Christ</span><span begin="02:56.800" end="02:56.830">,</span></p><p ttm:agent="v1" begin="02:56.830" end="02:59.260"><span begin="02:56.830" end="02:57.730">deny </span><span begin="02:57.730" end="02:57.970">your </span><span begin="02:57.970" end="02:59.260">maker</span></p><p ttm:agent="v1" begin="02:59.380" end="03:05.530"><span begin="02:59.380" end="03:03.190">He </span><span begin="03:03.190" end="03:03.280">who </span><span begin="03:03.280" end="03:05.530">tries</span><span begin="03:05.530" end="03:05.530">,</span></p><p ttm:agent="v1" begin="03:05.530" end="03:07.930"><span begin="03:05.530" end="03:06.340">will </span><span begin="03:06.340" end="03:06.550">be </span><span begin="03:06.550" end="03:07.930">wasted</span></p><p ttm:agent="v1" begin="03:07.930" end="03:14.050"><span begin="03:07.930" end="03:11.410">Feed </span><span begin="03:11.410" end="03:12.070">my </span><span begin="03:12.070" end="03:14.050">eyes</span></p><p ttm:agent="v1" begin="03:14.080" end="03:16.600"><span begin="03:14.080" end="03:14.890">now </span><span begin="03:14.890" end="03:15.100">you've </span><span begin="03:15.100" end="03:15.700">sewn </span><span begin="03:15.700" end="03:16.390">them </span><span begin="03:16.390" end="03:16.600">shut</span></p><p ttm:agent="v1" begin="03:16.600" end="03:54.640"><span begin="03:16.600" end="03:16.600">（</span><span begin="03:16.600" end="03:17.050">guitar</span><span begin="03:17.050" end="03:54.640">）</span></p><p ttm:agent="v1" begin="03:54.640" end="03:58.000"><span begin="03:54.640" end="03:55.300">Feed </span><span begin="03:55.300" end="03:55.810">my </span><span begin="03:55.810" end="03:58.000">eyes</span><span begin="03:58.000" end="03:58.000">,</span></p><p ttm:agent="v1" begin="03:58.000" end="04:03.340"><span begin="03:58.000" end="03:58.930">can </span><span begin="03:58.930" end="03:59.080">you </span><span begin="03:59.080" end="03:59.680">sew </span><span begin="03:59.680" end="04:00.160">them </span><span begin="04:00.160" end="04:00.340">shut</span><span begin="04:00.340" end="04:03.340">?</span></p><p ttm:agent="v1" begin="04:03.340" end="04:06.700"><span begin="04:03.340" end="04:04.480">Jesus </span><span begin="04:04.480" end="04:06.670">Christ</span><span begin="04:06.670" end="04:06.700">,</span></p><p ttm:agent="v1" begin="04:06.700" end="04:09.040"><span begin="04:06.700" end="04:07.540">deny </span><span begin="04:07.540" end="04:07.780">your </span><span begin="04:07.780" end="04:09.040">maker</span></p><p ttm:agent="v1" begin="04:09.190" end="04:15.280"><span begin="04:09.190" end="04:12.610">He </span><span begin="04:12.610" end="04:13.090">who </span><span begin="04:13.090" end="04:15.280">tries</span><span begin="04:15.280" end="04:15.280">,</span></p><p ttm:agent="v1" begin="04:15.280" end="04:17.590"><span begin="04:15.280" end="04:16.150">will </span><span begin="04:16.150" end="04:16.360">be </span><span begin="04:16.360" end="04:17.590">wasted</span></p><p ttm:agent="v1" begin="04:17.590" end="04:23.890"><span begin="04:17.590" end="04:21.280">Feed </span><span begin="04:21.280" end="04:21.820">my </span><span begin="04:21.820" end="04:23.890">eyes</span></p><p ttm:agent="v1" begin="04:23.890" end="04:26.350"><span begin="04:23.890" end="04:24.640">now </span><span begin="04:24.640" end="04:24.880">you've </span><span begin="04:24.880" end="04:25.450">sewn </span><span begin="04:25.450" end="04:25.750">them </span><span begin="04:25.750" end="04:26.350">shut</span></p></div></body></tt>