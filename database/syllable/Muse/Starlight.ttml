<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Starlight</ttm:title><ttm:agent type="person" xml:id="v1">Muse</ttm:agent><ttm:item type="album">Black Holes and Revelations</ttm:item><ttm:item type="spotify_id">3skn2lauGk7Dx6bVIt5DVj</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:25.940" end="00:28.160"><span begin="00:25.940" end="00:27.110">Far </span><span begin="00:27.110" end="00:28.160">away</span></p><p ttm:agent="v1" begin="00:28.310" end="00:32.150"><span begin="00:28.310" end="00:28.640">The </span><span begin="00:28.640" end="00:29.000">ship </span><span begin="00:29.000" end="00:29.180">is </span><span begin="00:29.180" end="00:29.720">taking </span><span begin="00:29.720" end="00:30.020">me </span><span begin="00:30.020" end="00:30.980">far </span><span begin="00:30.980" end="00:32.150">away</span></p><p ttm:agent="v1" begin="00:32.330" end="00:36.140"><span begin="00:32.330" end="00:32.990">Far </span><span begin="00:32.990" end="00:33.380">away </span><span begin="00:33.380" end="00:33.680">from </span><span begin="00:33.680" end="00:33.980">the </span><span begin="00:33.980" end="00:36.140">memories</span></p><p ttm:agent="v1" begin="00:36.380" end="00:41.390"><span begin="00:36.380" end="00:36.890">Of </span><span begin="00:36.890" end="00:37.070">the </span><span begin="00:37.070" end="00:37.610">people </span><span begin="00:37.610" end="00:37.970">who </span><span begin="00:37.970" end="00:38.690">care </span><span begin="00:38.690" end="00:38.900">if </span><span begin="00:38.900" end="00:39.110">I </span><span begin="00:39.110" end="00:39.440">live </span><span begin="00:39.440" end="00:39.800">or </span><span begin="00:39.800" end="00:41.390">die</span></p><p ttm:agent="v1" begin="00:41.900" end="00:44.030"><span begin="00:41.900" end="00:44.030">Starlight</span></p><p ttm:agent="v1" begin="00:44.240" end="00:48.170"><span begin="00:44.240" end="00:44.510">I </span><span begin="00:44.510" end="00:44.780">will </span><span begin="00:44.780" end="00:44.930">be </span><span begin="00:44.930" end="00:45.590">chasing </span><span begin="00:45.590" end="00:45.830">your </span><span begin="00:45.830" end="00:48.170">starlight</span></p><p ttm:agent="v1" begin="00:48.200" end="00:51.950"><span begin="00:48.200" end="00:48.740">Until </span><span begin="00:48.740" end="00:49.040">the </span><span begin="00:49.040" end="00:49.310">end </span><span begin="00:49.310" end="00:49.490">of </span><span begin="00:49.490" end="00:49.910">my </span><span begin="00:49.910" end="00:51.950">life</span></p><p ttm:agent="v1" begin="00:52.160" end="00:57.200"><span begin="00:52.160" end="00:52.640">I </span><span begin="00:52.640" end="00:52.910">don't </span><span begin="00:52.910" end="00:53.270">know </span><span begin="00:53.270" end="00:53.630">if </span><span begin="00:53.630" end="00:53.930">it's </span><span begin="00:53.930" end="00:54.470">worth </span><span begin="00:54.470" end="00:54.980">it </span><span begin="00:54.980" end="00:57.200">anymore</span></p><p ttm:agent="v1" begin="00:57.560" end="01:03.830"><span begin="00:57.560" end="00:57.770">And </span><span begin="00:57.770" end="01:00.080">hold </span><span begin="01:00.080" end="01:01.160">you </span><span begin="01:01.160" end="01:01.550">in </span><span begin="01:01.550" end="01:02.870">my </span><span begin="01:02.870" end="01:03.830">arms</span></p><p ttm:agent="v1" begin="01:04.010" end="01:07.970"><span begin="01:04.010" end="01:04.460">I </span><span begin="01:04.460" end="01:04.820">just </span><span begin="01:04.820" end="01:05.390">wanted </span><span begin="01:05.390" end="01:05.930">to </span><span begin="01:05.930" end="01:07.970">hold</span></p><p ttm:agent="v1" begin="01:07.970" end="01:12.230"><span begin="01:07.970" end="01:08.480">You </span><span begin="01:08.480" end="01:09.380">in </span><span begin="01:09.380" end="01:10.760">my </span><span begin="01:10.760" end="01:12.230">arms</span></p><p ttm:agent="v1" begin="01:13.370" end="01:15.590"><span begin="01:13.370" end="01:14.600">My </span><span begin="01:14.600" end="01:15.590">life</span></p><p ttm:agent="v1" begin="01:15.770" end="01:19.490"><span begin="01:15.770" end="01:16.430">You </span><span begin="01:16.430" end="01:17.630">electrify </span><span begin="01:17.630" end="01:18.530">my </span><span begin="01:18.530" end="01:19.490">life</span></p><p ttm:agent="v1" begin="01:19.520" end="01:23.450"><span begin="01:19.520" end="01:20.270">Lets </span><span begin="01:20.270" end="01:20.870">conspire </span><span begin="01:20.870" end="01:21.170">to </span><span begin="01:21.170" end="01:21.410">re</span><span begin="01:21.410" end="01:21.440">-</span><span begin="01:21.440" end="01:23.450">ignite</span></p><p ttm:agent="v1" begin="01:23.690" end="01:28.610"><span begin="01:23.690" end="01:24.290">All </span><span begin="01:24.290" end="01:24.440">the </span><span begin="01:24.440" end="01:24.950">souls </span><span begin="01:24.950" end="01:25.250">that </span><span begin="01:25.250" end="01:25.490">would </span><span begin="01:25.490" end="01:25.940">die </span><span begin="01:25.940" end="01:26.270">just </span><span begin="01:26.270" end="01:26.420">to </span><span begin="01:26.420" end="01:26.870">feel </span><span begin="01:26.870" end="01:28.610">alive</span></p><p ttm:agent="v1" begin="01:29.810" end="01:34.160"><span begin="01:29.810" end="01:30.110">But </span><span begin="01:30.110" end="01:31.130">I'll </span><span begin="01:31.130" end="01:32.120">never </span><span begin="01:32.120" end="01:32.510">let </span><span begin="01:32.510" end="01:32.810">you </span><span begin="01:32.810" end="01:34.160">go</span></p><p ttm:agent="v1" begin="01:34.340" end="01:40.100"><span begin="01:34.340" end="01:34.640">If </span><span begin="01:34.640" end="01:34.940">you </span><span begin="01:34.940" end="01:36.050">promised </span><span begin="01:36.050" end="01:36.470">not </span><span begin="01:36.470" end="01:37.100">to </span><span begin="01:37.100" end="01:38.840">fade </span><span begin="01:38.840" end="01:40.100">away</span></p><p ttm:agent="v1" begin="01:40.130" end="01:44.960"><span begin="01:40.130" end="01:40.790">Never </span><span begin="01:40.790" end="01:42.740">fade </span><span begin="01:42.740" end="01:44.960">away</span></p><p ttm:agent="v1" begin="01:46.130" end="01:53.030"><span begin="01:46.130" end="01:46.820">Our </span><span begin="01:46.820" end="01:47.660">hopes </span><span begin="01:47.660" end="01:48.200">and </span><span begin="01:48.200" end="01:53.030">expectations</span></p><p ttm:agent="v1" begin="01:53.720" end="02:00.710"><span begin="01:53.720" end="01:54.680">Black </span><span begin="01:54.680" end="01:55.610">holes </span><span begin="01:55.610" end="01:55.970">and </span><span begin="01:55.970" end="02:00.710">revelations</span></p><p ttm:agent="v1" begin="02:01.970" end="02:09.560"><span begin="02:01.970" end="02:02.630">Our </span><span begin="02:02.630" end="02:03.470">hopes </span><span begin="02:03.470" end="02:03.980">and </span><span begin="02:03.980" end="02:09.560">expectations</span></p><p ttm:agent="v1" begin="02:09.770" end="02:16.790"><span begin="02:09.770" end="02:10.520">Black </span><span begin="02:10.520" end="02:11.390">holes </span><span begin="02:11.390" end="02:11.690">and </span><span begin="02:11.690" end="02:16.7