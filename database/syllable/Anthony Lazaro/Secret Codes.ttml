<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Secret Codes</ttm:title><ttm:agent type="group" xml:id="v1">Anthony Lazaro, rhyu</ttm:agent><ttm:item type="album">Secret Codes</ttm:item><ttm:item type="spotify_id">1BSvCKeSJFGkynbhQVWsqw</ttm:item><itunes:duration>02:48.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:14.333" end="00:16.549"><span begin="00:14.333" end="00:14.965">Every </span><span begin="00:14.965" end="00:15.373">time </span><span begin="00:15.373" end="00:15.725">we </span><span begin="00:15.725" end="00:16.549">meet</span></p><p ttm:agent="v1" begin="00:17.341" end="00:19.773"><span begin="00:17.341" end="00:17.501">I </span><span begin="00:17.501" end="00:17.661">look </span><span begin="00:17.661" end="00:18.013">for </span><span begin="00:18.013" end="00:18.277">a </span><span begin="00:18.277" end="00:19.069">secret </span><span begin="00:19.069" end="00:19.773">code</span></p><p ttm:agent="v1" begin="00:20.781" end="00:23.173"><span begin="00:20.781" end="00:21.077">To </span><span begin="00:21.077" end="00:21.420">tell </span><span begin="00:21.420" end="00:21.780">you </span><span begin="00:21.780" end="00:22.141">how </span><span begin="00:22.141" end="00:22.413">I </span><span begin="00:22.413" end="00:23.173">feel</span></p><p ttm:agent="v1" begin="00:24.125" end="00:26.701"><span begin="00:24.125" end="00:24.341">Without </span><span begin="00:24.341" end="00:25.069">using </span><span begin="00:25.069" end="00:25.877">any </span><span begin="00:25.877" end="00:26.701">words</span></p><p ttm:agent="v1" begin="00:27.493" end="00:30.021"><span begin="00:27.493" end="00:27.669">Do </span><span begin="00:27.669" end="00:27.965">we </span><span begin="00:27.965" end="00:28.365">really </span><span begin="00:28.365" end="00:28.813">need </span><span begin="00:28.813" end="00:29.189">to </span><span begin="00:29.189" end="00:30.021">say</span></p><p ttm:agent="v1" begin="00:30.893" end="00:33.597"><span begin="00:30.893" end="00:31.069">What </span><span begin="00:31.069" end="00:31.253">has </span><span begin="00:31.253" end="00:31.997">flashed </span><span begin="00:31.997" end="00:32.525">inside </span><span begin="00:32.525" end="00:32.828">our </span><span begin="00:32.828" end="00:33.597">minds</span></p><p ttm:agent="v1" begin="00:33.877" end="00:35.077"><span begin="00:33.877" end="00:34.061">For </span><span begin="00:34.061" end="00:34.317">many </span><span begin="00:34.317" end="00:35.077">days</span></p><p ttm:agent="v1" begin="00:36.733" end="00:39.325"><span begin="00:36.733" end="00:39.325">Anyway</span></p><p ttm:agent="v1" begin="00:40.637" end="00:43.621"><span begin="00:40.637" end="00:40.821">You </span><span begin="00:40.821" end="00:40.997">can </span><span begin="00:40.997" end="00:41.205">give </span><span begin="00:41.205" end="00:41.389">me </span><span begin="00:41.389" end="00:41.605">just </span><span begin="00:41.605" end="00:41.821">a </span><span begin="00:41.821" end="00:42.253">little </span><span begin="00:42.253" end="00:43.621">sign</span></p><p ttm:agent="v1" begin="00:43.949" end="00:46.637"><span begin="00:43.949" end="00:44.133">A </span><span begin="00:44.133" end="00:44.293">small </span><span begin="00:44.293" end="00:44.493">nod </span><span begin="00:44.493" end="00:44.837">when </span><span begin="00:44.837" end="00:45.141">our </span><span begin="00:45.141" end="00:45.589">eyes </span><span begin="00:45.589" end="00:46.637">align</span></p><p ttm:agent="v1" begin="00:47.101" end="00:49.276"><span begin="00:47.101" end="00:47.251">And </span><span begin="00:47.251" end="00:47.468">we'll </span><span begin="00:47.468" end="00:47.940">send </span><span begin="00:47.940" end="00:49.276">together</span></p><p ttm:agent="v1" begin="00:49.820" end="00:53.036"><span begin="00:49.820" end="00:49.996">A </span><span begin="00:49.996" end="00:50.148">little </span><span begin="00:50.148" end="00:51.444">shockwave </span><span begin="00:51.444" end="00:51.676">to </span><span begin="00:51.676" end="00:51.947">the </span><span begin="00:51.947" end="00:53.036">world</span></p><p ttm:agent="v1" begin="00:54.164" end="00:56.828"><span begin="00:54.164" end="00:54.340">And </span><span begin="00:54.340" end="00:54.507">the </span><span begin="00:54.507" end="00:55.012">universe </span><span begin="00:55.012" end="00:55.212">will </span><span begin="00:55.212" end="00:55.580">skip </span><span begin="00:55.580" end="00:55.876">a </span><span begin="00:55.876" end="00:56.828">beat</span></p><p ttm:agent="v1" begin="00:57.491" end="01:00.430"><span begin="00:57.491" end="00:58.238">Underneath </span><span begin="00:58.238" end="00:58.430">a </span><span begin="00:58.430" end="00:58.678">sky </span><span begin="00:58.678" end="00:59.517">completely </span><span begin="00:59.517" end="01:00.430">lit</span></p><p ttm:agent="v1" begin="01:00.990" end="01:02.894"><span begin="01:00.990" end="01:01.174">Like </span><span begin="01:01.174" end="01:01.350">the </span><span begin="01:01.350" end="01:01.662">world </span><span begin="01:01.662" end="01:02.101">has </span><span begin="01:02.101" end="01:02.894">paused</span></p><p ttm:agent="v1" begin="01:03.661" end="01:05.910"><span begin="01:03.661" end="01:04.093">Just </span><span begin="01:04.093" end="01:04.421">to </span><span begin="01:04.421" end="01:04.845">take </span><span begin="01:04.845" end="01:05.181">a </span><span begin="01:05.181" end="01:05.910">breath</span></p><p ttm:agent="v1" begin="01:08.388" end="01:11.636"><span begin="01:08.388" end="01:08.700">And </span><span begin="01:08.700" end="01:09.532">sometimes </span><span begin="01:09.532" end="01:09.804">I </span><span begin="01:09.804" end="01:10.460">wonder </span><span begin="01:10.460" end="01:10.668">if </span><span begin="01:10.668" end="01:10.924">they're </span><span begin="01:10.924" end="01:11.261">for </span><span begin="01:11.261" end="01:11.636">me</span></p><p ttm:agent="v1" begin="01:12.116" end="01:14.949"><span begin="01:12.116" end="01:12.372">These </span><span begin="01:12.372" end="01:13.060">codes </span><span begin="01:13.060" end="01:13.661">that </span><span begin="01:13.661" end="01:14.277">you </span><span begin="01:14.277" end="01:14.949">send</span></p><p ttm:agent="v1" begin="01:15.629" end="01:18.419"><span begin="01:15.629" end="01:15.755">What </span><span begin="01:15.755" end="01:16.163">if </span><span begin="01:16.163" end="01:16.899">I'm </span><span begin="01:16.899" end="01:17.195">getting </span><span begin="01:17.195" end="01:17.659">this </span><span begin="01:17.659" end="01:18.051">all </span><span begin="01:18.051" end="01:18.419">wrong</span></p><p ttm:agent="v1" begin="01:19.051" end="01:21.771"><span begin="01:19.051" end="01:19.283">What </span><span begin="01:19.283" end="01:19.659">if </span><span begin="01:19.659" end="01:19.995">I'm </span><span begin="01:19.995" end="01:20.482">just </span><span begin="01:20.482" end="01:20.915">a </span><span begin="01:20.915" end="01:21.771">friend</span></p><p ttm:agent="v1" begin="01:22.507" end="01:25.228"><span begin="01:22.507" end="01:22.723">But </span><span begin="01:22.723" end="01:23.067">these </span><span begin="01:23.067" end="01:23.899">shivers </span><span begin="01:23.899" end="01:24.115">they </span><span begin="01:24.115" end="01:24.339">don't </span><span begin="01:24.339" end="01:25.228">lie</span></p><p ttm:agent="v1" begin="01:25.860" end="01:28.996"><span begin="01:25.860" end="01:26.236">One </span><span begin="01:26.236" end="01:26.956">simple </span><span begin="01:26.956" end="01:27.347">touch </span><span begin="01:27.347" end="01:27.763">it's </span><span begin="01:27.763" end="01:28.228">an </span><span begin="01:28.228" end="01:28.996">earthquake</span></p><p ttm:agent="v1" begin="01:29.227" end="01:34.387"><span begin="01:29.227" end="01:29.436">Through </span><span begin="01:29.436" end="01:29.964">my </span><span begin="01:29.964" end="01:31.091">mind </span><span begin="01:31.091" end="01:32.732">rumbling </span><span begin="01:32.732" end="01:34.387">wild</span></p><p ttm:agent="v1" begin="01:35.131" end="01:38.092"><span begin="01:35.131" end="01:35.500">You </span><span begin="01:35.500" end="01:35.699">can </span><span begin="01:35.699" end="01:35.947">give </span><span begin="01:35.947" end="01:36.163">me </span><span begin="01:36.163" end="01:36.347">just </span><span begin="01:36.347" end="01:36.627">a </span><span begin="01:36.627" end="01:37.195">little </span><span begin="01:37.195" end="01:38.092">sign</span></p><p ttm:agent="v1" begin="01:38.587" end="01:41.443"><span begin="01:38.587" end="01:38.803">A </span><span begin="01:38.803" end="01:39.083">small </span><span begin="01:39.083" end="01:39.307">nod </span><span begin="01:39.307" end="01:39.627">when </span><span begin="01:39.627" end="01:39.852">our </span><span begin="01:39.852" end="01:40.227">eyes </span><span begin="01:40.227" end="01:41.443">align</span></p><p ttm:agent="v1" begin="01:42.131" end="01:44.201"><span begin="01:42.131" end="01:42.323">And </span><span begin="01:42.323" end="01:42.531">we'll </span><span begin="01:42.531" end="01:42.873">send </span><span begin="01:42.873" end="01:44.201">together</span></p><p ttm:agent="v1" begin="01:44.568" end="01:48.234"><span begin="01:44.568" end="01:44.753">A </span><span begin="01:44.753" end="01:44.977">little </span><span begin="01:44.977" end="01:46.257">shockwave </span><span begin="01:46.257" end="01:46.962">through </span><span begin="01:46.962" end="01:47.154">the </span><span begin="01:47.154" end="01:48.234">world</span></p><p ttm:agent="v1" begin="01:48.818" end="01:52.114"><span begin="01:48.818" end="01:49.042">And </span><span begin="01:49.042" end="01:49.266">the </span><span begin="01:49.266" end="01:49.978">universe </span><span begin="01:49.978" end="01:50.242">will </span><span begin="01:50.242" end="01:50.802">skip </span><span begin="01:50.802" end="01:51.034">a </span><span begin="01:51.034" end="01:52.114">beat</span></p><p ttm:agent="v1" begin="01:52.370" end="01:55.650"><span begin="01:52.370" end="01:53.114">Underneath </span><span begin="01:53.114" end="01:53.354">a </span><span begin="01:53.354" end="01:53.666">sky </span><span begin="01:53.666" end="01:54.706">completely </span><span begin="01:54.706" end="01:55.650">lit</span></p><p ttm:agent="v1" begin="01:55.898" end="01:58.282"><span begin="01:55.898" end="01:56.098">Like </span><span begin="01:56.098" end="01:56.290">the </span><span begin="01:56.290" end="01:56.570">world </span><span begin="01:56.570" end="01:56.970">has </span><span begin="01:56.970" end="01:58.282">paused</span></p><p ttm:agent="v1" begin="01:58.602" end="02:02.017"><span begin="01:58.602" end="01:59.074">Just </span><span begin="01:59.074" end="01:59.434">to </span><span begin="01:59.434" end="02:00.458">take </span><span begin="02:00.458" end="02:00.793">a </span><span begin="02:00.793" end="02:02.017">breath</span></p><p ttm:agent="v1" begin="02:02.890" end="02:05.732"><span begin="02:02.890" end="02:03.073">You </span><span begin="02:03.073" end="02:03.241">can </span><span begin="02:03.241" end="02:03.418">give </span><span begin="02:03.418" end="02:03.602">me </span><span begin="02:03.602" end="02:03.794">just </span><span begin="02:03.794" end="02:03.994">a </span><span begin="02:03.994" end="02:04.362">little </span><span begin="02:04.362" end="02:05.732">sign</span></p><p ttm:agent="v1" begin="02:06.060" end="02:08.900"><span begin="02:06.060" end="02:06.228">A </span><span begin="02:06.228" end="02:06.452">small </span><span begin="02:06.452" end="02:06.748">nod </span><span begin="02:06.748" end="02:06.996">when </span><span begin="02:06.996" end="02:07.244">our </span><span begin="02:07.244" end="02:07.628">eyes </span><span begin="02:07.628" end="02:08.900">align</span></p><p ttm:agent="v1" begin="02:09.532" end="02:11.228"><span begin="02:09.532" end="02:09.716">And </span><span begin="02:09.716" end="02:09.884">we'll </span><span begin="02:09.884" end="02:10.212">send </span><span begin="02:10.212" end="02:11.228">together</span></p><p ttm:agent="v1" begin="02:12.116" end="02:15.260"><span begin="02:12.116" end="02:12.283">A </span><span begin="02:12.283" end="02:12.452">little </span><span begin="02:12.452" end="02:13.764">shockwave </span><span begin="02:13.764" end="02:13.964">through </span><span begin="02:13.964" end="02:14.324">the </span><span begin="02:14.324" end="02:15.260">world</span></p><p ttm:agent="v1" begin="02:16.220" end="02:19.164"><span begin="02:16.220" end="02:16.428">And </span><span begin="02:16.428" end="02:16.684">the </span><span begin="02:16.684" end="02:17.212">universe </span><span begin="02:17.212" end="02:17.572">will </span><span begin="02:17.572" end="02:18.052">skip </span><span begin="02:18.052" end="02:18.299">a </span><span begin="02:18.299" end="02:19.164">beat</span></p><p ttm:agent="v1" begin="02:19.708" end="02:22.564"><span begin="02:19.708" end="02:20.396">Underneath </span><span begin="02:20.396" end="02:20.595">a </span><span begin="02:20.595" end="02:20.900">sky </span><span begin="02:20.900" end="02:21.724">completely </span><span begin="02:21.724" end="02:22.564">lit</span></p><p ttm:agent="v1" begin="02:22.932" end="02:25.644"><span begin="02:22.932" end="02