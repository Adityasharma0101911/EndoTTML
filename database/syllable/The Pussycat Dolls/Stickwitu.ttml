<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Stickwitu</ttm:title><ttm:agent type="person" xml:id="v1">The Pussycat Dolls</ttm:agent><ttm:item type="album">PCD (Expanded Edition)</ttm:item><ttm:item type="spotify_id">0mhVi5NpxkA3zzbiulfkow</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.000" end="00:13.200"><span begin="00:00.000" end="00:00.330">Stickwitu</span><span begin="00:00.330" end="00:00.330">（</span><span begin="00:00.330" end="00:00.390">The </span><span begin="00:00.390" end="00:01.730">*</span><span begin="00:01.730" end="00:03.070">*</span><span begin="00:03.070" end="00:04.410">*</span><span begin="00:04.410" end="00:05.750">*</span><span begin="00:05.750" end="00:07.090">*</span><span begin="00:07.090" end="00:08.430">*</span><span begin="00:08.430" end="00:09.770">*</span><span begin="00:09.770" end="00:11.130">* </span><span begin="00:11.130" end="00:11.400">Dolls</span><span begin="00:11.400" end="00:13.200">）</span></p><p ttm:agent="v1" begin="00:13.200" end="00:17.640"><span begin="00:13.200" end="00:13.590">I </span><span begin="00:13.590" end="00:13.800">don't </span><span begin="00:13.800" end="00:14.190">wanna </span><span begin="00:14.190" end="00:14.790">go </span><span begin="00:14.790" end="00:15.270">another </span><span begin="00:15.270" end="00:17.220">day</span><span begin="00:17.220" end="00:17.640">,</span></p><p ttm:agent="v1" begin="00:17.640" end="00:23.550"><span begin="00:17.640" end="00:17.940">So </span><span begin="00:17.940" end="00:18.270">I'm </span><span begin="00:18.270" end="00:19.080">telling </span><span begin="00:19.080" end="00:19.500">you </span><span begin="00:19.500" end="00:20.430">exactly </span><span begin="00:20.430" end="00:20.970">what </span><span begin="00:20.970" end="00:21.330">is </span><span begin="00:21.330" end="00:21.630">on </span><span begin="00:21.630" end="00:21.900">my </span><span begin="00:21.900" end="00:23.220">mind</span><span begin="00:23.220" end="00:23.550">.</span></p><p ttm:agent="v1" begin="00:23.550" end="00:26.820"><span begin="00:23.550" end="00:24.060">Seems </span><span begin="00:24.060" end="00:24.480">like </span><span begin="00:24.480" end="00:25.500">everybody's </span><span begin="00:25.500" end="00:26.040">breaking </span><span begin="00:26.040" end="00:26.820">up</span></p><p ttm:agent="v1" begin="00:27.210" end="00:29.700"><span begin="00:27.210" end="00:27.660">Throwing </span><span begin="00:27.660" end="00:27.990">their </span><span begin="00:27.990" end="00:28.500">love </span><span begin="00:28.500" end="00:29.460">away</span><span begin="00:29.460" end="00:29.700">,</span></p><p ttm:agent="v1" begin="00:29.700" end="00:33.360"><span begin="00:29.700" end="00:29.940">But </span><span begin="00:29.940" end="00:30.150">I </span><span begin="00:30.150" end="00:30.660">know </span><span begin="00:30.660" end="00:30.900">I </span><span begin="00:30.900" end="00:31.530">got </span><span begin="00:31.530" end="00:31.770">a </span><span begin="00:31.770" end="00:32.100">good </span><span begin="00:32.100" end="00:32.520">thing </span><span begin="00:32.520" end="00:32.940">right </span><span begin="00:32.940" end="00:33.360">here</span></p><p ttm:agent="v1" begin="00:33.630" end="00:36.630"><span begin="00:33.630" end="00:33.960">That's </span><span begin="00:33.960" end="00:34.380">why </span><span begin="00:34.380" end="00:34.560">I </span><span begin="00:34.560" end="00:35.550">say</span><span begin="00:35.550" end="00:35.580">（</span><span begin="00:35.580" end="00:36.630">Hey</span><span begin="00:36.630" end="00:36.630">）</span></p><p ttm:agent="v1" begin="00:36.630" end="00:39.210"><span begin="00:36.630" end="00:37.380">Nobody </span><span begin="00:37.380" end="00:37.710">gonna </span><span begin="00:37.710" end="00:38.100">love </span><span begin="00:38.100" end="00:38.460">me </span><span begin="00:38.460" end="00:39.210">better</span></p><p ttm:agent="v1" begin="00:39.660" end="00:42.630"><span begin="00:39.660" end="00:39.810">I </span><span begin="00:39.810" end="00:40.110">must </span><span begin="00:40.110" end="00:40.590">stick </span><span begin="00:40.590" end="00:40.830">with </span><span begin="00:40.830" end="00:41.040">you </span><span begin="00:41.040" end="00:42.330">forever</span><span begin="00:42.330" end="00:42.630">.</span></p><p ttm:agent="v1" begin="00:42.630" end="00:45.300"><span begin="00:42.630" end="00:43.380">Nobody </span><span begin="00:43.380" end="00:43.710">gonna </span><span begin="00:43.710" end="00:44.070">take </span><span begin="00:44.070" end="00:44.430">me </span><span begin="00:44.430" end="00:45.300">higher</span></p><p ttm:agent="v1" begin="00:45.630" end="00:48.600"><span begin="00:45.630" end="00:45.750">I </span><span begin="00:45.750" end="00:46.200">must </span><span begin="00:46.200" end="00:46.530">stick </span><span begin="00:46.530" end="00:46.770">with </span><span begin="00:46.770" end="00:48.570">you</span><span begin="00:48.570" end="00:48.600">.</span></p><p ttm:agent="v1" begin="00:48.600" end="00:51.360"><span begin="00:48.600" end="00:48.840">You </span><span begin="00:48.840" end="00:49.200">know </span><span begin="00:49.200" end="00:49.620">how </span><span begin="00:49.620" end="00:49.710">to </span><span begin="00:49.710" end="00:51.120">appreciate </span><span begin="00:51.120" end="00:51.360">me</span></p><p ttm:agent="v1" begin="00:51.660" end="00:54.630"><span begin="00:51.660" end="00:51.810">I </span><span begin="00:51.810" end="00:52.230">must </span><span begin="00:52.230" end="00:52.590">stick </span><span begin="00:52.590" end="00:52.800">with </span><span begin="00:52.800" end="00:53.100">you</span><span begin="00:53.100" end="00:53.100">, </span><span begin="00:53.100" end="00:53.460">my </span><span begin="00:53.460" end="00:54.600">baby</span><span begin="00:54.600" end="00:54.630">.</span></p><p ttm:agent="v1" begin="00:54.630" end="00:57.450"><span begin="00:54.630" end="00:55.470">Nobody </span><span begin="00:55.470" end="00:55.740">ever </span><span begin="00:55.740" end="00:56.100">made </span><span begin="00:56.100" end="00:56.460">me </span><span begin="00:56.460" end="00:56.880">feel </span><span begin="00:56.880" end="00:57.180">this </span><span begin="00:57.180" end="00:57.450">way</span></p><p ttm:agent="v1" begin="00:57.690" end="01:01.200"><span begin="00:57.690" end="00:57.810">I </span><span begin="00:57.810" end="00:58.230">must </span><span begin="00:58.230" end="00:58.530">stick </span><span begin="00:58.530" end="00:58.770">with </span><span begin="00:58.770" end="01:00.300">you</span><span begin="01:00.300" end="01:01.200">.</span></p><p ttm:agent="v1" begin="01:01.200" end="01:05.220"><span begin="01:01.200" end="01:01.590">I </span><span begin="01:01.590" end="01:01.800">don't </span><span begin="01:01.800" end="01:02.250">wanna </span><span begin="01:02.250" end="01:02.820">go </span><span begin="01:02.820" end="01:03.300">another </span><span begin="01:03.300" end="01:05.220">day</span></p><p ttm:agent="v1" begin="01:05.580" end="01:11.580"><span begin="01:05.580" end="01:05.970">So </span><span begin="01:05.970" end="01:06.270">I'm </span><span begin="01:06.270" end="01:07.050">telling </span><span begin="01:07.050" end="01:07.470">you </span><span begin="01:07.470" end="01:08.460">exactly </span><span begin="01:08.460" end="01:08.940">what </span><span begin="01:08.940" end="01:09.360">is </span><span begin="01:09.360" end="01:09.660">on </span><span begin="01:09.660" end="01:09.900">my </span><span begin="01:09.900" end="01:11.340">mind</span><span begin="01:11.340" end="01:11.580">.</span></p><p ttm:agent="v1" begin="01:11.580" end="01:14.970"><span begin="01:11.580" end="01:12.090">See </span><span begin="01:12.090" end="01:12.450">the </span><span begin="01:12.450" end="01:12.840">way </span><span begin="01:12.840" end="01:12.990">we </span><span begin="01:12.990" end="01:13.470">ride </span><span begin="01:13.470" end="01:13.620">in </span><span begin="01:13.620" end="01:13.890">our </span><span begin="01:13.890" end="01:14.490">private </span><span begin="01:14.490" end="01:14.970">lives</span><span begin="01:14.970" end="01:14.970">,</span></p><p ttm:agent="v1" begin="01:14.970" end="01:17.760"><span begin="01:14.970" end="01:15.120">Ain't </span><span begin="01:15.120" end="01:15.990">nobody </span><span begin="01:15.990" end="01:16.410">getting </span><span begin="01:16.410" end="01:16.560">in </span><span begin="01:16.560" end="01:17.610">between</span><span begin="01:17.610" end="01:17.760">.</span></p><p ttm:agent="v1" begin="01:17.760" end="01:23.640"><span begin="01:17.760" end="01:17.880">I </span><span begin="01:17.880" end="01:18.300">want </span><span begin="01:18.300" end="01:18.690">you </span><span begin="01:18.690" end="01:18.810">to </span><span begin="01:18.810" end="01:19.410">know </span><span begin="01:19.410" end="01:19.800">that </span><span begin="01:19.800" end="01:20.160">you're </span><span begin="01:20.160" end="01:20.610">the </span><span begin="01:20.610" end="01:21.300">only </span><span begin="01:21.300" end="01:22.560">one </span><span begin="01:22.560" end="01:22.740">for </span><span begin="01:22.740" end="01:22.950">me</span><span begin="01:22.950" end="01:22.950">（</span><span begin="01:22.950" end="01:23.310">one </span><span begin="01:23.310" end="01:23.640">forme</span><span begin="01:23.640" end="01:23.640">）</span></p><p ttm:agent="v1" begin="01:23.640" end="01:24.600"><span begin="01:23.640" end="01:23.820">And </span><span begin="01:23.820" end="01:23.940">I </span><span begin="01:23.940" end="01:24.600">say</span></p><p ttm:agent="v1" begin="01:24.630" end="01:27.390"><span begin="01:24.630" end="01:25.350">Nobody </span><span begin="01:25.350" end="01:25.770">gonna </span><span begin="01:25.770" end="01:26.070">love </span><span begin="01:26.070" end="01:26.460">me </span><span begin="01:26.460" end="01:27.390">better</span></p><p ttm:agent="v1" begin="01:27.660" end="01:30.630"><span begin="01:27.660" end="01:27.780">I </span><span begin="01:27.780" end="01:28.110">must </span><span begin="01:28.110" end="01:28.560">stick </span><span begin="01:28.560" end="01:28.830">with </span><span begin="01:28.830" end="01:29.040">you </span><span begin="01:29.040" end="01:30.360">forever</span><span begin="01:30.360" end="01:30.630">.</span></p><p ttm:agent="v1" begin="01:30.630" end="01:33.300"><span begin="01:30.630" end="01:31.380">Nobody </span><span begin="01:31.380" end="01:31.710">gonna </span><span begin="01:31.710" end="01:32.010">take </span><span begin="01:32.010" end="01:32.430">me </span><span begin="01:32.430" end="01:33.300">higher</span></p><p ttm:agent="v1" begin="01:33.630" end="01:36.600"><span begin="01:33.630" end="01:33.750">I </span><span begin="01:33.750" end="01:34.200">must </span><span begin="01:34.200" end="01:34.530">stick </span><span begin="01:34.530" end="01:34.770">with </span><span begin="01:34.770" end="01:35.550">you</span><span begin="01:35.550" end="01:36.600">.</span></p><p ttm:agent="v1" begin="01:36.600" end="01:39.360"><span begin="01:36.600" end="01:36.810">You </span><span begin="01:36.810" end="01:37.050">know </span><span begin="01:37.050" end="01:37.650">how </span><span begin="01:37.650" end="01:37.710">to </span><span begin="01:37.710" end="01:39.120">appreciate </span><span begin="01:39.120" end="01:39.360">me</span></p><p ttm:agent="v1" begin="01:39.660" end="01:42.660"><span begin="01:39.660" end="01:39.810">I </span><span begin="01:39.810" end="01:40.230">must </span><span begin="01:40.230" end="01:40.560">stick </span><span begin="01:40.560" end="01:40.800">with </span><span begin="01:40.800" end="01:41.100">you</span><span begin="01:41.100" end="01:41.100">, </span><span begin="01:41.100" end="01:41.460">my </span><span begin="01:41.460" end="01:42.630">baby</span><span begin="01:42.630" end="01:42.660">.</span></p><p ttm:agent="v1" begin="01:42.660" end="01:45.510"><span begin="01:42.660" end="01:43.470">Nobody </span><span begin="01:43.470" end="01:43.710">ever </span><span begin="01:43.710" end="01:44.070">made </span><span begin="01:44.070" end="01:44.460">me </span><span begin="01:44.460" end="01:44.880">feel </span><span begin="01:44.880" end="01:45.180">this </span><span begin="01:45.180" end="01:45.510">way</span></p><p ttm:agent="v1" begin="01:45.690" end="01:47.910"><span begin="01:45.690" end="01:45.810">I </span><span begin="01:45.810" end="01:46.110">must </span><span begin="01:46.110" end="01:46.500">stick </span><span begin="01:46.500" end="01:46.800">with </span><span begin="01:46.800" end="01:47.910">you</span><span begin="01:47.910" end="01:47.910">.</span></p><p ttm:agent="v1" begin="01:47.910" end="01:50.370"><span begin="01:47.910" end="01:48.240">And </span><span begin="01:48.240" end="01:50.370">now</span></p><p ttm:agent="v1" begin="01:50.850" end="01:53.820"><span begin="01:50.850" end="01:51.150">Ain't </span><span begin="01:51.150" end="01:51.690">nothing </span><span begin="01:51.690" end="01:52.080">else </span><span begin="01:52.080" end="01:52.380">I </span><span begin="01:52.380" end="01:52.560">can </span><span begin="01:52.560" end="01:52.950">need</span><span begin="01:52.950" end="01:52.950">（</span><span begin="01:52.950" end="01:53.220">nothing </span><sp