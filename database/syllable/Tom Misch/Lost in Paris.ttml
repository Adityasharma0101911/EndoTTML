27.810" end="01:28.080">Say </span><span begin="01:28.080" end="01:28.410">grace</span><span begin="01:28.410" end="01:28.440">, </span><span begin="01:28.440" end="01:28.590">but </span><span begin="01:28.590" end="01:28.680">I </span><span begin="01:28.680" end="01:28.860">fell </span><span begin="01:28.860" end="01:28.980">in </span><span begin="01:28.980" end="01:29.250">love </span><span begin="01:29.250" end="01:29.430">with </span><span begin="01:29.430" end="01:29.490">a </span><span begin="01:29.490" end="01:29.820">small </span><span begin="01:29.820" end="01:30.210">waist</span></p><p ttm:agent="v1" begin="01:30.420" end="01:32.400"><span begin="01:30.420" end="01:30.690">Uh</span><span begin="01:30.690" end="01:30.690">, </span><span begin="01:30.690" end="01:30.930">never </span><span begin="01:30.930" end="01:31.320">start</span><span begin="01:31.320" end="01:31.320">, </span><span begin="01:31.320" end="01:31.530">yeah </span><span begin="01:31.530" end="01:31.860">right</span><span begin="01:31.860" end="01:31.860">, </span><span begin="01:31.860" end="01:32.160">yeah </span><span begin="01:32.160" end="01:32.400">uh</span></p><p ttm:agent="v1" begin="01:32.400" end="01:34.680"><span begin="01:32.400" end="01:32.730">Bang</span><span begin="01:32.730" end="01:32.760">, </span><span begin="01:32.760" end="01:32.940">uh</span><span begin="01:32.940" end="01:32.940">, </span><span begin="01:32.940" end="01:33.180">shot </span><span begin="01:33.180" end="01:33.330">me </span><span begin="01:33.330" end="01:33.450">in </span><span begin="01:33.450" end="01:33.600">my </span><span begin="01:33.600" end="01:33.900">heart </span><span begin="01:33.900" end="01:34.050">and </span><span begin="01:34.050" end="01:34.200">it </span><span begin="01:34.200" end="01:34.440">hurt </span><span begin="01:34.440" end="01:34.680">gage</span></p><p ttm:agent="v1" begin="01:34.680" end="01:37.050"><span begin="01:34.680" end="01:34.950">She </span><span begin="01:34.950