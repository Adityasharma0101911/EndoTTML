<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>'Til Death Do Us Part</ttm:title><ttm:agent type="person" xml:id="v1">Bryant Barnes</ttm:agent><ttm:item type="album">SOLACE</ttm:item><ttm:item type="spotify_id">2yBGWuXvohOlVAzpt5tIB0</ttm:item><itunes:duration>02:43.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.351" end="00:07.799"><span begin="00:00.351" end="00:01.647">Baby </span><span begin="00:01.647" end="00:02.671">I've </span><span begin="00:02.671" end="00:03.023">been </span><span begin="00:03.023" end="00:03.847">waiting </span><span begin="00:04.311" end="00:04.799">to </span><span begin="00:04.799" end="00:05.271">see </span><span begin="00:05.271" end="00:05.687">your </span><span begin="00:05.687" end="00:06.791">face </span><span begin="00:06.991" end="00:07.799">again</span></p><p ttm:agent="v1" begin="00:10.927" end="00:19.167"><span begin="00:10.927" end="00:11.175">I </span><span begin="00:11.175" end="00:11.751">can't </span><span begin="00:11.751" end="00:12.303">stop </span><span begin="00:12.303" end="00:12.535">my </span><span begin="00:12.535" end="00:12.927">heart </span><span begin="00:13.487" end="00:13.905">from </span><span begin="00:13.905" end="00:14.935">racing </span><span begin="00:15.711" end="00:16.135">as </span><span begin="00:16.135" end="00:16.535">you </span><span begin="00:16.535" end="00:17.815">take </span><span begin="00:17.815" end="00:18.039">my </span><span begin="00:18.039" end="00:19.167">hand</span></p><p ttm:agent="v1" begin="00:21.509" end="00:25.859"><span begin="00:21.509" end="00:21.957">Never </span><span begin="00:21.957" end="00:22.349">thought </span><span begin="00:22.549" end="00:22.884">there'd </span><span begin="00:23.163" end="00:23.387">be </span><span begin="00:23.387" end="00:23.915">someone </span><span begin="00:24.587" end="00:25.155">beside </span><span begin="00:25.155" end="00:25.859">me</span></p><p ttm:agent="v1" begin="00:26.515" end="00:31.051"><span begin="00:26.515" end="00:26.923">But </span><span begin="00:26.923" end="00:27.411">baby </span><span begin="00:27.411" end="00:31.051">I</span></p><p ttm:agent="v1" begin="00:31.806" end="00:35.067"><span begin="00:31.806" end="00:32.051">I </span><span begin="00:32.051" end="00:32.483">give </span><span begin="00:32.483" end="00:32.939">my </span><span begin="00:32.939" end="00:34.019">all </span><span begin="00:34.019" end="00:34.275">to </span><span begin="00:34.275" end="00:35.067">you</span></p><p ttm:agent="v1" begin="00:35.539" end="00:40.147"><span begin="00:35.539" end="00:36.051">You've </span><span begin="00:36.051" end="00:36.516">shown </span><span begin="00:36.516" end="00:37.043">me </span><span begin="00:37.043" end="00:37.483">love </span><span begin="00:37.651" end="00:37.899">that </span><span begin="00:37.899" end="00:38.315">I </span><span begin="00:38.315" end="00:39.539">never </span><span begin="00:39.763" end="00:40.147">knew</span></p><p ttm:agent="v1" begin="00:41.051" end="00:45.603"><span begin="00:41.051" end="00:41.483">You </span><span begin="00:41.483" end="00:41.923">pull </span><span begin="00:41.923" end="00:42.451">me </span><span begin="00:42.451" end="00:42.811">out </span><span begin="00:43.003" end="00:43.283">of </span><span begin="00:43.283" end="00:43.651">my </span><span begin="00:43.867" end="00:45.259">darkest </span><span begin="00:45.259" end="00:45.603">blue</span></p><p ttm:agent="v1" begin="00:46.571" end="00:51.091"><span begin="00:46.571" end="00:46.763">And </span><span begin="00:46.763" end="00:47.059">you're </span><span begin="00:47.059" end="00:47.419">with </span><span begin="00:47.419" end="00:47.891">me </span><span begin="00:47.891" end="00:48.507">in </span><span begin="00:48.507" end="00:49.371">everything </span><span begin="00:50.363" end="00:50.595">I </span><span begin="00:50.595" end="00:51.091">do</span></p><p ttm:agent="v1" begin="00:51.731" end="00:53.043"><span begin="00:51.731" end="00:51.955">Oh </span><span begin="00:51.955" end="00:52.131">it's </span><span begin="00:52.131" end="00:53.043">true</span></p><p ttm:agent="v1" begin="00:53.603" end="00:55.675"><span begin="00:53.603" end="00:53.931">You're </span><span begin="00:53.931" end="00:54.171">in </span><span begin="00:54.171" end="00:54.651">my </span><span begin="00:54.651" end="00:55.675">arms</span></p><p ttm:agent="v1" begin="00:56.147" end="00:58.411"><span begin="00:56.147" end="00:56.819">Holding </span><span begin="00:56.819" end="00:57.187">my </span><span begin="00:57.187" end="00:58.411">heart</span></p><p ttm:agent="v1" begin="00:58.611" end="01:03.547"><span begin="00:58.611" end="00:58.843">Till </span><span begin="00:58.843" end="00:59.356">death </span><span begin="00:59.356" end="00:59.587">do </span><span begin="00:59.587" end="01:00.163">us </span><span begin="01:00.163" end="01:03.547">part</span></p><p ttm:agent="v1" begin="01:04.516" end="01:07.870"><span begin="01:04.516" end="01:04.763">I </span><span begin="01:04.763" end="01:05.163">give </span><span begin="01:05.163" end="01:05.659">my </span><span begin="01:05.659" end="01:06.771">all </span><span begin="01:06.771" end="01:07.462">to </span><span begin="01:07.462" end="01:07.870">you</span></p><p ttm:agent="v1" begin="01:09.662" end="01:13.342"><span begin="01:09.662" end="01:09.870">'Cause </span><span begin="01:09.870" end="01:10.150">I'm </span><span begin="01:10.150" end="01:10.550">so </span><span begin="01:10.550" end="01:11.054">in </span><span begin="01:11.054" end="01:11.774">love </span><span begin="01:12.214" end="01:12.471">with </span><span begin="01:12.471" end="01:13.342">you</span></p><p ttm:agent="v1" begin="01:17.174" end="01:24.254"><span begin="01:17.174" end="01:17.398">As </span><span begin="01:17.398" end="01:17.838">long </span><span begin="01:17.838" end="01:18.046">as </span><span begin="01:18.046" end="01:18.302">I </span><span begin="01:18.302" end="01:19.022">can </span><span begin="01:19.022" end="01:19.558">remember </span><span begin="01:20.702" end="01:20.934">you've </span><span begin="01:20.934" end="01:21.606">been </span><span begin="01:21.606" end="01:21.966">my </span><span begin="01:21.966" end="01:24.254">everything</span></p><p ttm:agent="v1" begin="01:26.876" end="01:36.276"><span begin="01:26.876" end="01:27.476">And </span><span begin="01:27.476" end="01:27.900">without </span><span begin="01:27.900" end="01:28.180">you </span><span begin="01:28.532" end="01:28.740">I'm </span><span begin="01:28.740" end="01:29.428">hurting </span><span begin="01:29.804" end="01:30.204">forever </span><span begin="01:31.548" end="01:32.060">what </span><span begin="01:32.060" end="01:32.500">have </span><span begin="01:32.500" end="01:32.844">you </span><span begin="01:32.844" end="01:34.188">done </span><span begin="01:34.188" end="01:34.396">to </span><span begin="01:34.396" end="01:36.276">me?</span></p><p ttm:agent="v1" begin="01:37.769" end="01:42.193"><span begin="01:37.769" end="01:38.353">Never </span><span begin="01:38.353" end="01:38.633">thought </span><span begin="01:38.905" end="01:39.601">there'd </span><span begin="01:39.601" end="01:39.817">be </span><span begin="01:39.817" end="01:41.041">someone </span><span begin="01:41.041" end="01:41.601">beside </span><span begin="01:41.601" end="01:42.193">me</span></p><p ttm:agent="v1" begin="01:42.881" end="01:47.505"><span begin="01:42.881" end="01:43.489">But </span><span begin="01:43.489" end="01:43.985">baby </span><span begin="01:43.985" end="01:47.505">I</span></p><p ttm:agent="v1" begin="01:48.337" end="01:51.185"><span begin="01:48.337" end="01:48.529">I </span><span begin="01:48.529" end="01:48.841">give </span><span begin="01:48.841" end="01:49.297">my </span><span begin="01:49.297" end="01:50.473">all </span><span begin="01:50.473" end="01:50.705">to </span><span begin="01:50.705" end="01:51.185">you</span></p><p ttm:agent="v1" begin="01:51.945" end="01:56.490"><span begin="01:51.945" end="01:52.481">You've </span><span begin="01:52.481" end="01:52.921">shown </span><span begin="01:52.921" end="01:53.393">me </span><span begin="01:53.393" end="01:53.785">love </span><span begin="01:53.969" end="01:54.201">that </span><span begin="01:54.201" end="01:54.697">I </span><span begin="01:54.697" end="01:55.882">never </span><span begin="01:56.129" end="01:56.490">knew</span></p><p ttm:agent="v1" begin="01:57.473" end="02:02.001"><span begin="01:57.473" end="01:57.873">You </span><span begin="01:57.873" end="01:58.257">pull </span><span begin="01:58.257" end="01:58.465">me </span><span begin="01:58.873" end="01:59.273">out </span><span begin="01:59.273" end="01:59.689">of </span><span begin="01:59.689" end="01:59.993">my </span><span begin="02:00.233" end="02:01.425">darkest </span><span begin="02:01.625" end="02:02.001">blue</span></p><p ttm:agent="v1" begin="02:02.913" end="02:07.497"><span begin="02:02.913" end="02:03.105">And </span><span begin="02:03.105" end="02:03.361">you're </span><span begin="02:03.361" end="02:03.777">with </span><span begin="02:03.777" end="02:04.281">me </span><span begin="02:04.281" end="02:04.769">in </span><span begin="02:04.769" end="02:05.753">everything </span><span begin="02:06.753" end="02:07.001">I </span><span begin="02:07.001" end="02:07.497">do</span></p><p ttm:agent="v1" begin="02:08.089" end="02:09.329"><span begin="02:08.089" end="02:08.337">Oh </span><span begin="02:08.337" end="02:08.513">it's </span><span begin="02:08.513" end="02:09.329">true</span></p><p ttm:agent="v1" begin="02:10.009" end="02:12.089"><span begin="02:10.009" end="02:10.337">You're </span><span begin="02:10.337" end="02:10.561">in </span><span begin="02:10.561" end="02:11.017">my </span><span begin="02:11.017" end="02:12.089">arms</span></p><p ttm:agent="v1" begin="02:12.593" end="02:14.769"><span begin="02:12.593" end="02:13.201">Holding </span><span begin="02:13.201" end="02:13.602">my </span><span begin="02:13.602" end="02:14.769">heart</span></p><p ttm:agent="v1" begin="02:14.912" end="02:19.928"><span begin="02:14.912" end="02:15.224">Till </span><span begin="02:15.224" end="02:15.616">death </span><span begin="02:15.800" end="02:16.016">do </span><span begin="02:16.016" end="02:16.488">us </span><span begin="02:16.488" end="02:19.928">part</span></p><p ttm:agent="v1" begin="02:20.936" end="02:23.872"><span begin="02:20.936" end="02:21.159">I </span><span begin="02:21.159" end="02:21.447">give </span><span begin="02:21.447" end="02:22.007">my </span><span begin="02:22.007" end="02:23.216">all </span><span begin="02:23.216" end="02:23.440">to </span><span begin="02:23.440" end="02:23.872">you</span></p><p ttm:agent="v1" begin="02:26.128" end="02:33.288"><span begin="02:26.128" end="02:26.319">'Cause </span><span begin="02:26.319" end="02:26.544">I'm </span><span begin="02:26.544" end="02:26.968">so </span><span begin="02:26.968" end="02:27.352">in </span><span begin="02:27.352" end="02:28.152">love </span><span begin="02:28.600" end="02:28.864">with </span><span begin="02:28.864" end="02:33.288">you</span></p></div></body></tt>