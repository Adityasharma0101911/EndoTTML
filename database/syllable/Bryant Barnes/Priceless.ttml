<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Priceless</ttm:title><ttm:agent type="person" xml:id="v1">Bryant Barnes</ttm:agent><ttm:item type="album">Priceless</ttm:item><ttm:item type="spotify_id">4AQSA9Do6uF4a1XkLNok6d</ttm:item><itunes:duration>02:39.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:04.224" end="00:05.635"><span begin="00:04.224" end="00:04.536">It's </span><span begin="00:04.536" end="00:05.635">spiritual</span></p><p ttm:agent="v1" begin="00:06.107" end="00:11.962"><span begin="00:06.107" end="00:06.328">How </span><span begin="00:06.328" end="00:06.562">you </span><span begin="00:06.562" end="00:07.042">make </span><span begin="00:07.042" end="00:07.391">all </span><span begin="00:07.391" end="00:07.768">of </span><span begin="00:07.768" end="00:08.248">my </span><span begin="00:08.248" end="00:09.475">dreams </span><span begin="00:10.448" end="00:10.872">come </span><span begin="00:10.872" end="00:11.962">true</span></p><p ttm:agent="v1" begin="00:14.665" end="00:15.810"><span begin="00:14.665" end="00:15.810">Invisible</span></p><p ttm:agent="v1" begin="00:16.537" end="00:19.633"><span begin="00:16.537" end="00:16.704">Got </span><span begin="00:16.704" end="00:16.864">a </span><span begin="00:16.864" end="00:17.264">string </span><span begin="00:17.264" end="00:18.048">pulling </span><span begin="00:18.048" end="00:18.506">me </span><span begin="00:18.506" end="00:19.633">back</span></p><p ttm:agent="v1" begin="00:20.767" end="00:22.424"><span begin="00:20.767" end="00:21.116">To </span><span begin="00:21.116" end="00:22.424">you</span></p><p ttm:agent="v1" begin="00:23.822" end="00:25.629"><span begin="00:23.822" end="00:24.471">Diamonds </span><span begin="00:24.471" end="00:24.904">and </span><span begin="00:24.904" end="00:25.629">chains</span></p><p ttm:agent="v1" begin="00:26.320" end="00:30.799"><span begin="00:26.320" end="00:26.664">They </span><span begin="00:26.664" end="00:27.064">don't </span><span begin="00:27.064" end="00:27.525">mean </span><span begin="00:27.525" end="00:28.346">nothing </span><span begin="00:28.346" end="00:28.800">I'll </span><span begin="00:28.800" end="00:29.192">throw </span><span begin="00:29.192" end="00:29.591">them </span><span begin="00:29.591" end="00:30.042">in </span><span begin="00:30.042" end="00:30.799">flames</span></p><p ttm:agent="v1" begin="00:31.386" end="00:35.904"><span begin="00:31.386" end="00:32.169">Money </span><span begin="00:32.169" end="00:32.625">can't </span><span begin="00:32.625" end="00:33.064">buy </span><span begin="00:33.064" end="00:33.464">what </span><span begin="00:33.464" end="00:33.920">is </span><span begin="00:33.920" end="00:34.355">in </span><span begin="00:34.355" end="00:34.760">front </span><span begin="00:34.760" end="00:35.128">of </span><span begin="00:35.128" end="00:35.904">me</span></p><p ttm:agent="v1" begin="00:36.498" end="00:40.547"><span begin="00:36.498" end="00:36.672">You're </span><span begin="00:36.672" end="00:36.952">one </span><span begin="00:36.952" end="00:37.320">of </span><span begin="00:37.320" end="00:37.713">one </span><span begin="00:37.713" end="00:38.144">can't </span><span begin="00:38.144" end="00:38.570">be </span><span begin="00:38.570" end="00:40.547">replaced</span></p><p ttm:agent="v1" begin="00:43.107" end="00:43.804"><span begin="00:43.107" end="00:43.804">Oh</span></p><p ttm:agent="v1" begin="00:44.363" end="00:47.698"><span begin="00:44.363" end="00:45.162">I </span><span begin="00:45.684" end="00:45.900">want </span><span begin="00:45.900" end="00:46.299">you </span><span begin="00:46.299" end="00:46.770">for </span><span begin="00:46.770" end="00:47.698">life</span></p><p ttm:agent="v1" begin="00:48.073" end="00:51.006"><span begin="00:48.073" end="00:48.402">Can </span><span begin="00:48.402" end="00:48.836">it </span><span begin="00:48.836" end="00:49.316">be </span><span begin="00:49.316" end="00:51.006">timeless?</span></p><p ttm:agent="v1" begin="00:51.649" end="00:55.300"><span begin="00:51.649" end="00:52.348">Nothing </span><span begin="00:52.348" end="00:53.193">compares </span><span begin="00:53.193" end="00:53.619">to </span><span begin="00:53.619" end="00:54.033">you </span><span begin="00:54.033" end="00:54.479">and </span><span begin="00:54.479" end="00:55.300">I</span></p><p ttm:agent="v1" begin="00:55.802" end="00:57.891"><span begin="00:55.802" end="00:56.617">Baby </span><span begin="00:56.617" end="00:57.051">that's </span><span begin="00:57.051" end="00:57.891">right</span></p><p ttm:agent="v1" begin="00:58.314" end="01:01.066"><span begin="00:58.314" end="00:58.475">What </span><span begin="00:58.475" end="00:58.820">we </span><span begin="00:58.820" end="00:59.178">have </span><span begin="00:59.178" end="00:59.644">is </span><span begin="00:59.644" end="01:01.066">priceless</span></p><p ttm:agent="v1" begin="01:02.412" end="01:06.146"><span begin="01:02.412" end="01:03.146">Baby </span><span begin="01:03.146" end="01:03.484">I </span><span begin="01:03.484" end="01:03.866">want </span><span begin="01:03.866" end="01:04.353">you </span><span begin="01:04.353" end="01:04.803">for </span><span begin="01:04.803" end="01:06.146">life</span></p><p ttm:agent="v1" begin="01:08.970" end="01:11.901"><span begin="01:08.970" end="01:11.901">No</span></p><p ttm:agent="v1" begin="01:12.330" end="01:14.218"><span begin="01:12.330" end="01:14.218">Hmm</span></p><p ttm:agent="v1" begin="01:15.257" end="01:17.113"><span begin="01:15.257" end="01:15.465">Maybe </span><span begin="01:15.465" end="01:15.659">we </span><span begin="01:15.659" end="01:15.857">can </span><span begin="01:15.857" end="01:16.089">raise </span><span begin="01:16.089" end="01:16.354">the </span><span begin="01:16.354" end="01:17.113">tempo</span></p><p ttm:agent="v1" begin="01:17.551" end="01:19.856"><span begin="01:17.551" end="01:17.884">Sing </span><span begin="01:17.884" end="01:18.188">until </span><span begin="01:18.188" end="01:18.434">we're </span><span begin="01:18.434" end="01:18.658">out </span><span begin="01:18.658" end="01:18.911">of </span><span begin="01:18.911" end="01:19.856">echoes</span></p><p ttm:agent="v1" begin="01:20.349" end="01:22.220"><span begin="01:20.349" end="01:20.509">Hit </span><span begin="01:20.509" end="01:20.661">a </span><span begin="01:20.661" end="01:21.025">different </span><span begin="01:21.025" end="01:21.245">type </span><span begin="01:21.245" end="01:21.437">of </span><span begin="01:21.437" end="01:22.220">high</span></p><p ttm:agent="v1" begin="01:22.735" end="01:25.050"><span begin="01:22.735" end="01:22.957">Love </span><span begin="01:22.957" end="01:23.148">you </span><span begin="01:23.148" end="01:23.348">'til </span><span begin="01:23.348" end="01:23.566">I'm </span><span begin="01:23.566" end="01:23.980">not </span><span begin="01:23.980" end="01:25.050">alive</span></p><p ttm:agent="v1" begin="01:25.315" end="01:27.577"><span begin="01:25.315" end="01:25.506">Take </span><span begin="01:25.506" end="01:25.730">it </span><span begin="01:25.730" end="01:26.105">to </span><span begin="01:26.105" end="01:26.578">another </span><span begin="01:26.578" end="01:27.577">level</span></p><p ttm:agent="v1" begin="01:27.897" end="01:30.182"><span begin="01:27.897" end="01:28.089">I </span><span begin="01:28.089" end="01:28.207">don't </span><span begin="01:28.207" end="01:28.632">ever </span><span begin="01:28.632" end="01:29.111">wanna </span><span begin="01:29.111" end="01:29.535">let </span><span begin="01:29.535" end="01:30.182">go</span></p><p ttm:agent="v1" begin="01:30.455" end="01:35.262"><span begin="01:30.455" end="01:30.663">Don't </span><span begin="01:30.663" end="01:30.839">you </span><span begin="01:30.839" end="01:31.015">know </span><span begin="01:31.015" end="01:31.214">that </span><span begin="01:31.214" end="01:31.407">I'm </span><span begin="01:31.407" end="01:32.647">designed </span><span begin="01:32.647" end="01:33.023">for </span><span begin="01:33.023" end="01:35.262">you?</span></p><p ttm:agent="v1" begin="01:35.758" end="01:38.926"><span begin="01:35.758" end="01:36.495">I </span><span begin="01:37.033" end="01:37.303">want </span><span begin="01:37.303" end="01:37.687">you </span><span begin="01:37.687" end="01:38.130">for </span><span begin="01:38.130" end="01:38.926">life</span></p><p ttm:agent="v1" begin="01:39.508" end="01:42.304"><span begin="01:39.508" end="01:39.876">Can </span><span begin="01:39.876" end="01:40.267">it </span><span begin="01:40.267" end="01:40.731">be </span><span begin="01:40.731" end="01:42.304">timeless?</span></p><p ttm:agent="v1" begin="01:42.998" end="01:46.764"><span begin="01:42.998" end="01:43.744">Nothing </span><span begin="01:43.744" end="01:44.553">compares </span><span begin="01:44.553" end="01:44.972">to </span><span begin="01:44.972" end="01:45.405">you </span><span begin="01:45.405" end="01:45.849">and </span><span begin="01:45.849" end="01:46.764">I</span></p><p ttm:agent="v1" begin="01:47.240" end="01:49.425"><span begin="01:47.240" end="01:48.042">Baby </span><span begin="01:48.042" end="01:48.450">that's </span><span begin="01:48.450" end="01:49.425">right</span></p><p ttm:agent="v1" begin="01:49.914" end="01:52.264"><span begin="01:49.914" end="01:50.256">Our </span><span begin="01:50.256" end="01:50.593">love </span><span begin="01:50.593" end="01:51.000">is </span><span begin="01:51.000" end="01:52.264">priceless</span></p><p ttm:agent="v1" begin="01:53.752" end="01:57.513"><span begin="01:53.752" end="01:54.496">Baby </span><span begin="01:54.496" end="01:54.880">I </span><span begin="01:54.880" end="01:55.305">want </span><span begin="01:55.305" end="01:55.704">you </span><span begin="01:55.704" end="01:56.138">for </span><span begin="01:56.138" end="01:57.513">life</span></p><p ttm:agent="v1" begin="01:58.376" end="02:00.353"><span begin="01:58.376" end="01:58.778">For </span><span begin="01:58.778" end="02:00.353">life</span></p><p ttm:agent="v1" begin="02:00.921" end="02:02.994"><span begin="02:00.921" end="02:01.323">For </span><span begin="02:01.323" end="02:02.994">life</span></p><p ttm:agent="v1" begin="02:04.114" end="02:07.833"><span begin="02:04.114" end="02:04.747">Baby </span><span begin="02:04.747" end="02:05.153">I </span><span begin="02:05.153" end="02:05.545">want </span><span begin="02:05.545" end="02:05.969">you </span><span begin="02:05.969" end="02:06.441">for </span><span begin="02:06.441" end="02:07.833">life</span></p><p ttm:agent="v1" begin="02:08.625" end="02:10.136"><span begin="02:08.625" end="02:09.065">For </span><span begin="02:09.065" end="02:10.136">life</span></p><p ttm:agent="v1" begin="02:10.415" end="02:14.678"><span begin="02:10.415" end="02:10.712">Our </span><span begin="02:10.712" end="02:11.134">love </span><span begin="02:11.134" end="02:11.568">is </span><span begin="02:11.568" end="02:14.678">priceless</span></p></div></body></tt>