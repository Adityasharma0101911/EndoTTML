9.914" end="00:30.312">lost </span><span begin="00:30.312" end="00:30.688">in </span><span begin="00:30.688" end="00:31.960">direction</span></p><p ttm:agent="v1" begin="00:32.816" end="00:36.816"><span begin="00:32.816" end="00:33.120">So </span><span begin="00:33.120" end="00:33.528">then </span><span begin="00:33.528" end="00:33.960">why </span><span begin="00:33.960" end="00:34.320">do </span><span begin="00:34.320" end="00:34.712">I </span><span begin="00:34.712" end="00:35.120">keep </span><span begin="00:35.120" end="00:35.536">it </span><span begin="00:35.536" end="00:36.816">alive</span></p><p ttm:agent="v1" begin="00:37.608" end="00:41.672"><span begin="00:37.608" end="00:37.968">Said </span><span begin="00:37.968" end="00:38.400">you'd </span><span begin="00:38.400" end="00:39.168">rather </span><span begin="00:39.168" end="00:39.552">just </span><span begin="00:39.552" end="00:39.992">wait </span><span begin="00:39.992" end="00:40.328">'till </span><span begin="00:40.328" end="00:40.672">the </span><span begin="00:40.672" end="00:41.672">summer</span></p><p ttm:agent="v1" begin="00:42.448" end="00:46.384"><span begin="00:42.448" end="00:42.752">All </span><span begin="00:42.752" end="00:43.136">to </span><span begin="00:43.136" end="00:43.504">see </span><span begin="00:43.504" end="00:43.888">if </span><span begin="00:43.888" end="00:44.344">you'll </span><span begin="00:44.344" end="00:44.816">leave </span><span begin="00:44.816" end="00:45.176">me </span><span begin="00:45.176" end="00:45.496">to </span><span begin="00:45.496" end="00:46.384">dry</span></p><p ttm:agent="v1" begin="00:47.256" end="00:48.968"><span begin="00:47.256" end="00:47.584">What </span><span begin="00:47.584" end="00:47.952">you </span><span begin="00:47.952" end="00:48.746">waiting </span><span begin="00:48.746" end="00:48.968">for?</span></p><p ttm:agent="v1" begin="00:49.185" end="00:49.680"><span begin="00:49.185" end="00:49.680">Baby</span></p><p ttm:agent="v1" begin="00:49.880" end="00:51.512"><span begin="00:49.880" end="00:50.088">Oh </span><span begin="00:50.088" end="00:50.352">the </span><span begin="00:50.352" end="00:50.745">way </span><span begin="00:50.745" end="00:51.152">you're </span><span begin="00:51.152" end="00:51.512">torn</span></p><p ttm:agent="v1" begin="00:51.512" end="00:51.992"><span begin="00:51.512" end="00:51.992">Maybe</span></p><p ttm:agent="v1" begin="00:52.160" end="00:56.228"><span begin="00:52.160" end="00:52.423">You </span><span begin="00:52.423" end="00:52.768">got </span><span begin="00:52.768" end="00:53.379">lots </span><span begin="00:53.908" end="00:55.108">to </span><span begin="00:55.108" end="00:56.228">choose</span></p><p ttm:agent="v1" begin="00:56.436" end="00:58.716"><span begin="00:56.436" end="00:56.980">What </span><span begin="00:56.980" end="00:57.499">about </span><span begin="00:57.499" end="00:58.716">me?</span></p><p ttm:agent="v1" begin="00:59.486" end="01:03.864"><span begin="00:59.486" end="00:59.928">'Cause </span><span begin="00:59.928" end="01:00.406">I've </span><span begin="01:00.406" end="01:01.152">been </span><span begin="01:01.152" end="01:02.001">waiting </span><span begin="01:02.001" end="01:02.344">for </span><span begin="01:02.344" end="01:03.864">free</span></p><p ttm:agent="v1" begin="01:04.408" end="01:08.843"><span begin="01:04.408" end="01:04.801">You </span><span begin="01:04.801" end="01:05.160">watch </span><span begin="01:05.160" end="01:05.520">me </span><span begin="01:06.056" end="01:06.393">hold </span><span begin="01:06.393" end="01:06.752">to </span><span begin="01:06.752" end="01:07.199">my </span><span begin="01:07.199" end="01:07.595">tongue </span><span begin="01:07.595" end="01:08.323">every </span><span begin="01:08.323" end="01:08.843">night</span></p><p ttm:agent="v1" begin="01:09.267" end="01:11.235"><span begin="01:09.267" end="01:09.675">The </span><span begin="01:09.675" end="01:10.059">stars </span><span begin="01:10.059" end="01:10.412">don't </span><span begin="01:10.412" end="01:11.235">align</span></p><p ttm:agent="v1" begin="01:11.867" end="01:15.534"><span begin="01:11.867" end="01:11.990">But </span><span begin="01:12.358" end="01:12.837">I'm </span><span begin="01:12.837" end="01:13.582">okay </span><span begin="01:13.582" end="01:13.926">that </span><span begin="01:13.926" end="01:14.326">it's </span><span begin="01:14.326" end="01:15.534">me</span></p><p ttm:agent="v1" begin="01:16.886" end="01:20.061"><span begin="01:16.886" end="01:17.686">Texting </span><span begin="01:17.686" end="01:18.005">don't </span><span begin="01:18.005" end="01:18.382">help </span><span begin="01:18.382" end="01:18.734">the </span><span begin="01:18.734" end="01:20.061">complexion</span></p><p ttm:agent="v1" begin="01:20.863" end="01:24.422"><span begin="01:20.863" end="01:21.118">I </span><span begin="01:21.118" end="01:21.510">would </span><span begin="01:21.510" end="01:22.286">rather </span><span begin="01:22.286" end="01:22.694">you </span><span begin="01:22.694" end="01:23.158">speak </span><span begin="01:23.158" end="01:23.534">all </span><span begin="01:23.534" end="01:23.846">the </span><span begin="01:23.846" end="01:24.422">words</span></p><p ttm:agent="v1" begin="01:25.350" end="01:29.486"><span begin="01:25.350" end="01:25.542">Tell </span><span begin="01:25.542" end="01:25.725">me </span><span begin="01:25.725" end="01:25.902">why </span><span begin="01:25.902" end="01:26.070">I </span><span begin="01:26.070" end="01:26.453">always </span><span begin="01:26.453" end="01:27.037">change </span><span begin="01:27.037" end="01:27.429">my </span><span begin="01:27.429" end="01:27.886">mood </span><span begin="01:27.886" end="01:28.270">for </span><span begin="01:28.270" end="01:29.486">perfection</span></p><p ttm:agent="v1" begin="01:30.381" end="01:34.722"><span begin="01:30.381" end="01:30.767">So </span><span begin="01:30.767" end="01:31.558">alone </span><span begin="01:31.558" end="01:31.902">is </span><span begin="01:31.902" end="01:32.697">what </span><span begin="01:32.697" end="01:33.145">I </span><span begin="01:33.145" end="01:34.722">prefer</span></p><p ttm:agent="v1" begin="01:35.258" end="01:36.513"><span begin="01:35.258" end="01:35.666">Yeah </span><span begin="01:35.666" end="01:35.993">you </span><span begin="01:35.993" end="01:36.513">know</span></p><p ttm:agent="v1" begin="01:37.593" end="01:39.289"><span begin="01:37.593" end="01:37.922">How </span><span begin="01:37.922" end="01:38.282">I </span><span begin="01:38.282" end="01:39.289">breathe</span></p><p ttm:agent="v1" begin="01:40.025" end="01:44.455"><span begin="01:40.025" end="01:40.322">Still </span><span begin="01:40.322" end="01:40.722">you'd </span><span begin="01:40.722" end="01:41.061">rather </span><span begin="01:41.061" end="01:41.277">fall </span><span begin="01:41.277" end="01:41.549">in </span><span begin="01:41.549" end="01:41.877">love </span><span begin="01:41.877" end="01:42.045">with </span><span begin="01:42.045" end="01:42.411">someone </span><span begin="01:42.411" end="01:42.772">else </span><span begin="01:42.772" end="01:43.448">than </span><span begin="01:43.448" end="01:44.455">me</span></p><p ttm:agent="v1" begin="01:44.951" end="01:46.815"><span begin="01:44.951" end="01:45.287">What </span><span begin="01:45.287" end="01:45.615">you </span><span begin="01:45.615" end="01:46.367">waiting </span><span begin="01:46.367" end="01:46.815">for?</span></p><p ttm:agent="v1" begin="01:47.015" end="01:47.319"><span begin="01:47.015" end="01:47.319">Baby</span></p><p ttm:agent="v1" begin="01:47.543" end="01:48.935"><span begin="01:47.543" end="01:47.727">Oh </span><span begin="01:47.727" end="01:47.959">the </span><span begin="01:47.959" end="01:48.327">way </span><span begin="01:48.327" end="01:48.663">you're </span><span begin="01:48.663" end="01:48.935">torn</span></p><p ttm:agent="v1" begin="01:49.199" end="01:49.551"><span begin="01:49.199" end="01:49.551">Maybe</span></p><p ttm:agent="v1" begin="01:49.791" end="01:53.799"><span begin="01:49.791" end="01:50.031">You </span><span begin="01:50.031" end="01:50.407">got </span><span begin="01:50.407" end="01:51.431">lots </span><span begin="01:51.431" end="01:52.783">to </span><span begin="01:52.783" end="01:53.799">choose</span></p><p ttm:agent="v1" begin="01:54.151" end="01:56.463"><span begin="01:54.151" end="01:54.567">What </span><span begin="01:54.567" end="01:55.143">about </span><span begin="01:55.143" end="01:56.463">me?</span></p><p ttm:agent="v1" begin="01:57.471" end="02:01.311"><span begin="01:57.471" end="01:57.656">'Cause </span><span begin="01:57.656" end="01:57.999">I've </span><span begin="01:57.999" end="01:58.783">been </span><span begin="01:58.783" end="01:59.575">waiting </span><span begin="01:59.575" end="01:59.943">for </span><span begin="01:59.943" end="02:01.311">free</span></p><p ttm:agent="v1" begin="02:02.135" end="02:06.476"><span begin="02:02.135" end="02:02.479">You </span><span begin="02:02.479" end="02:02.847">watch </span><span begin="02:02.847" end="02:03.188">me </span><span begin="02:03.661" end="02:03.972">hold </span><span begin="02:03.972" end="02:04.348">to </span><span begin="02:04.348" end="02:04.772">my </span><span begin="02:04.772" end="02:05.308">tongue </span><span begin="02:05.308" end="02:05.908">every </span><span begin="02:05.908" end="02:06.476">night</span></p><p ttm:agent="v1" begin="02:07.140" end="02:08.733"><span begin="02:07.140" end="02:07.237">The </span><span begin="02:07.237" end="02:07.621">stars </span><span begin="02:07.621" end="02:08.005">don't </span><span begin="02:08.005" end="02:08.733">align</span></p><p ttm:agent="v1" begin="02:09.485" end="02:12.962"><span begin="02:09.485" end="02:09.851">But </span><span begin="02:09.851" end="02:10.282">I'm </span><span begin="02:10.282" end="02:11.082">okay </span><span begin="02:11.082" end="02:11.498">that </span><span begin="02:11.498" end="02:11.891">it's </spa