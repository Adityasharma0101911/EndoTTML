<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Far Too Young to Die</ttm:title><ttm:agent type="person" xml:id="v1">Panic! At The Disco</ttm:agent><ttm:item type="album">Too Weird to Live, Too Rare to Die!</ttm:item><ttm:item type="spotify_id">4NTL7fT4eqfPao94lmqth2</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:49.670" end="00:53.120"><span begin="00:49.670" end="00:50.150">I've </span><span begin="00:50.150" end="00:51.020">never </span><span begin="00:51.020" end="00:51.680">so </span><span begin="00:51.680" end="00:52.580">adored </span><span begin="00:52.580" end="00:53.120">you</span></p><p ttm:agent="v1" begin="00:53.540" end="00:57.080"><span begin="00:53.540" end="00:53.930">I'm </span><span begin="00:53.930" end="00:54.950">twisting </span><span begin="00:54.950" end="00:56.570">allegories </span><span begin="00:56.570" end="00:57.080">now</span></p><p ttm:agent="v1" begin="00:57.320" end="01:00.620"><span begin="00:57.320" end="00:57.710">I </span><span begin="00:57.710" end="00:58.220">want </span><span begin="00:58.220" end="00:58.610">to </span><span begin="00:58.610" end="01:00.170">complicate </span><span begin="01:00.170" end="01:00.620">you</span></p><p ttm:agent="v1" begin="01:01.040" end="01:04.610"><span begin="01:01.040" end="01:01.550">Don't </span><span begin="01:01.550" end="01:02.000">let </span><span begin="01:02.000" end="01:02.390">me </span><span begin="01:02.390" end="01:02.840">do </span><span begin="01:02.840" end="01:03.170">this </span><span begin="01:03.170" end="01:03.530">to </span><span begin="01:03.530" end="01:04.610">myself</span></p><p ttm:agent="v1" begin="01:04.850" end="01:08.420"><span begin="01:04.850" end="01:05.240">I'm </span><span begin="01:05.240" end="01:06.260">chasing </span><span begin="01:06.260" end="01:07.130">roller </span><span begin="01:07.130" end="01:08.420">coasters</span></p><p ttm:agent="v1" begin="01:08.630" end="01:12.170"><span begin="01:08.630" end="01:09.080">I've </span><span begin="01:09.080" end="01:09.560">got </span><span begin="01:09.560" end="01:10.010">to </span><span begin="01:10.010" end="01:10.550">have </span><span begin="01:10.550" end="01:10.700">you </span><span begin="01:10.700" end="01:11.630">closer </span><span begin="01:11.630" end="01:12.170">now</span></p><p ttm:agent="v1" begin="01:12.410" end="01:15.920"><span begin="01:12.410" end="01:13.340">Endless </span><span begin="01:13.340" end="01:14.600">romantic </span><span begin="01:14.600" end="01:15.920">stories</span></p><p ttm:agent="v1" begin="01:16.130" end="01:19.130"><span begin="01:16.130" end="01:16.610">You </span><span begin="01:16.610" end="01:17.540">never </span><span begin="01:17.540" end="01:18.080">could </span><span begin="01:18.080" end="01:19.010">control </span><span begin="01:19.010" end="01:19.130">me</span></p><p ttm:agent="v1" begin="01:19.130" end="01:22.580"><span begin="01:19.130" end="01:19.430">Well </span><span begin="01:19.430" end="01:19.460">I </span><span begin="01:19.460" end="01:19.940">never </span><span begin="01:19.940" end="01:20.360">really </span><span begin="01:20.360" end="01:20.720">thought </span><span begin="01:20.720" end="01:20.930">that </span><span begin="01:20.930" end="01:21.110">you'd </span><span begin="01:21.110" end="01:21.590">come </span><span begin="01:21.590" end="01:22.580">tonight</span></p><