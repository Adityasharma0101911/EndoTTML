/p><p ttm:agent="v1" begin="00:36.810" end="00:42.480"><span begin="00:36.810" end="00:41.580">"</span><span begin="00:41.580" end="00:41.970">Ladies </span><span begin="00:41.970" end="00:42.060">and </span><span begin="00:42.060" end="00:42.480">gentlemen</span><span begin="00:42.480" end="00:42.480">,</span></p><p ttm:agent="v1" begin="00:42.480" end="00:44.250"><span begin="00:42.480" end="00:42.660">due </span><span begin="00:42.660" end="00:42.780">to </span><span begin="00:42.780" end="00:43.410">circumstances </span><span begin="00:43.410" end="00:43.710">beyond </span><span begin="00:43.710" end="00:43.830">our </span><span begin="00:43.830" end="00:44.250">control</span><span begin="00:44.250" end="00:44.250">,</span></p><p ttm:agent="v1" begin="00:44.250" end="00:47.040"><span begin="00:44.250" end="00:44.400">we </span><span begin="00:44.400" end="00:44.520">are </span><span begin="00:44.520" end="00:44.790">unable </span><span begin="00:44.790" end="00:44.940">to </span><span begin="00:44.940" end="00:45.300">continue </span><span begin="00:45.300" end="00:45.420">our </span><span begin="00:45.420" end="00:45.840">broadcast </span><span begin="00:45.840" end="00:45.900">of </span><span begin="00:45.900" end="00:46.860">dance </span><span begin="00:46.860" end="00:47.040">music</span><span begin="00:47.040" end="00:47.040">.</span></p><p ttm:agent="v1" begin="00:47.040" end="02:33.870"><span begin="00:47.040" end="00:57.723">We </span><span begin="00:57.723" end="01:08.406">shall </span><span begin="01:08.406" end="01:19.089">continue </span><span begin="01:19.089" end="01:29.772">now </span><span begin="01:29.772" end="01:40.455">with </span><span begin="01:40.455" end="01:51.138">our </span><span begin="01:51.138" end="02:01.821">piano </span><span begin="02:01.821" end="02:12.504">instrumental</span><span begin="02:12.504" end="02:23.187">.</span><span begin="02:23.187" end="02:33.870">"</span></p><p ttm:agent="v1" begin="02:33.870" end="02:35.500"><s