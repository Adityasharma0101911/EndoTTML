<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>The Ballad of Mona Lisa</ttm:title><ttm:agent type="person" xml:id="v1">Panic! At The Disco</ttm:agent><ttm:item type="album">Vices &amp; Virtues</ttm:item><ttm:item type="spotify_id">5rLi8B8qgk6qThwRnKHW2P</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:16.040" end="00:19.850"><span begin="00:16.040" end="00:16.370">She  </span><span begin="00:16.370" end="00:16.760">paints  </span><span begin="00:16.760" end="00:16.850">her  </span><span begin="00:16.850" end="00:17.450">fingers  </span><span begin="00:17.450" end="00:17.720">with  </span><span begin="00:17.720" end="00:17.810">a  </span><span begin="00:17.810" end="00:18.380">close  </span><span begin="00:18.380" end="00:19.850">precision</span></p><p ttm:agent="v1" begin="00:19.880" end="00:23.480"><span begin="00:19.880" end="00:20.210">He  </span><span begin="00:20.210" end="00:20.600">starts  </span><span begin="00:20.600" end="00:20.720">to  </span><span begin="00:20.720" end="00:21.350">notice  </span><span begin="00:21.350" end="00:21.710">empty  </span><span begin="00:21.710" end="00:22.340">bottles  </span><span begin="00:22.340" end="00:22.430">of  </span><span begin="00:22.430" end="00:23.480">gin</span></p><p ttm:agent="v1" begin="00:23.990" end="00:27.020"><span begin="00:23.990" end="00:24.170">And  </span><span begin="00:24.170" end="00:24.530">takes  </span><span begin="00:24.530" end="00:24.590">a  </span><span begin="00:24.590" end="00:25.160">moment  </span><span begin="00:25.160" end="00:25.460">to  </span><span begin="00:25.460" end="00:26.150">assess  </span><span begin="00:26.150" end="00:26.240">the  </span><span begin="00:26.240" end="00:27.020">sin</span></p><p ttm:agent="v1" begin="00:27.020" end="00:29.060"><span begin="00:27.020" end="00:27.290">She's  </span><span begin="00:27.290" end="00:27.770">paid  </span><span begin="00:27.770" end="00:29.060">for</span></p><p ttm:agent="v1" begin="00:31.700" end="00:35.450"><span begin="00:31.700" end="00:31.820">A  </span><span begin="00:31.820" end="00:32.300">lonely  </span><span begin="00:32.300" end="00:33.020">speaker  </span><span begin="00:33.020" end="00:33.230">in  </span><span begin="00:33.230" end="00:33.320">a  </span><span begin="00:33.320" end="00:35.450">conversation</span></p><p ttm:agent="v1" begin="00:35.540" end="00:39.050"><span begin="00:35.540" end="00:35.720">Her  </span><span begin="00:35.720" end="00:36.140">words  </span><span begin="00:36.140" end="00:36.230">are  </span><span begin="00:36.230" end="00:36.740">swimming  </span><span begin="00:36.740" end="00:37.010">through  </span><span begin="00:37.010" end="00:37.340">his  </span><span begin="00:37.340" end="00:37.820">ears  </span><span begin="00:37.820" end="00:39.050">again</span></p><p ttm:agent="v1" begin="00:39.350" end="00:42.740"><span begin="00:39.350" end="00:39.680">There's  </span><span begin="00:39.680" end="00:40.130">nothing  </span><span begin="00:40.130" end="00:40.460">wrong  </span><span begin="00:40.460" end="00:40.610">with  </span><span begin="00:40.610" end="00:40.940">just  </span><span begin="00:40.940" end="00:41.030">a  </span><span begin="00:41.030" end="00:41.690">taste  </span><span begin="00:41.690" end="00:41.870">of  </span><span begin="00:41.870" end="00:42.410">what  </span><span begin="00:42.410" end="00:42.740">you've</span></p><p ttm:agent="v1" begin="00:42.740" end="00:44.570"><span begin="00:42.740" end="00:43.280">paid  </span><span begin="00:43.280" end="00:44.570">for</span></p><p ttm:agent="v1" begin="00:47.720" end="00:49.820"><span begin="00:47.720" end="00:48.170">Say  </span><span begin="00:48.170" end="00:48.440">what  </span><span begin="00:48.440" end="00:48.650">you  </span><span begin="00:48.650" end="00:49.820">mean</span></p><p ttm:agent="v1" begin="00:49.820" end="00:51.800"><span begin="00:49.820" end="00:50.120">Tell  </span><span begin="00:50.120" end="00:50.390">me  </span><span begin="00:50.390" end="00:50.570">I'm  </span><span begin="00:50.570" end="00:51.800">right</span></p><p ttm:agent="v1" begin="00:51.830" end="00:55.280"><span begin="00:51.830" end="00:52.040">And  </span><span begin="00:52.040" end="00:52.280">let  </span><span begin="00:52.280" end="00:52.340">the  </span><span begin="00:52.340" end="00:53.000">sun  </span><span begin="00:53.000" end="00:53.450">rain  </span><span begin="00:53.450" end="00:54.050">down  </span><span begin="00:54.050" end="00:54.260">on  </span><span begin="00:54.260" end="00:55.280">me</span></p><p ttm:agent="v1" begin="00:55.580" end="00:57.410"><span begin="00:55.580" end="00:55.910">Give  </span><span begin="00:55.910" end="00:56.210">me  </span><span begin="00:56.210" end="00:56.270">a  </span><span begin="00:56.270" end="00:57.410">sign</span></p><p ttm:agent="v1" begin="00:57.410" end="01:01.700"><span begin="00:57.410" end="00:57.560">I  </span><span begin="00:57.560" end="00:57.890">want  </span><span begin="00:57.890" end="00:58.040">to  </span><span begin="00:58.040" end="01:01.700">believe</span></p><p ttm:agent="v1" begin="01:02.330" end="01:06.450"><span begin="01:02.330" end="01:04.730">Woah</span><span begin="01:04.730" end="01:04.760">,</span><span begin="01:04.760" end="01:05.180">Mona  </span><span begin="01:05.180" end="01:06.440">Lisa</span><span begin="01:06.440" end="01:06.450">,</span></p><p ttm:agent="v1" begin="01:06.450" end="01:09.710"><span begin="01:06.450" end="01:06.630">You're  </span><span begin="01:06.630" end="01:07.580">guaranteed  </span><span begin="01:07.580" end="01:08.060">to  </span><span begin="01:08.060" end="01:08.420">run  </span><span begin="01:08.420" end="01:08.780">this  </span><span begin="01:08.780" end="01:09.710">town</span></p><p ttm:agent="v1" begin="01:09.740" end="01:13.970"><span begin="01:09.740" end="01:12.200">Woah</span><span begin="01:12.200" end="01:12.230">,</span><span begin="01:12.230" end="01:12.890">Mona  </span><span begin="01:12.890" end="01:13.940">Lisa</span><span begin="01:13.940" end="01:13.970">,</span></p><p ttm:agent="v1" begin="01:13.970" end="01:19.040"><span begin="01:13.970" end="01:14.210">I'd  </span><span begin="01:14.210" end="01:14.480">pay  </span><span begin="01:14.480" end="01:14.600">to  </span><span begin="01:14.600" end="01:14.990">see  </span><span begin="01:14.990" end="01:15.260">you  </span><span begin="01:15.260" end="01:19.040">frown</span></p><p ttm:agent="v1" begin="01:21.530" end="01:25.340"><span begin="01:21.530" end="01:21.800">He  </span><span begin="01:21.800" end="01:22.310">senses  </span><span begin="01:22.310" end="01:22.820">something</span><span begin="01:22.820" end="01:22.820">,</span><span begin="01:22.820" end="01:23.180">call  </span><span begin="01:23.180" end="01:23.300">it  </span><span begin="01:23.300" end="01:25.340">desperation</span></p><p ttm:agent="v1" begin="01:25.520" end="01:29.030"><span begin="01:25.520" end="01:26.180">Another  </span><span begin="01:26.180" end="01:26.810">dollar</span><span begin="01:26.810" end="01:26.810">,</span><span begin="01:26.810" end="01:27.890">another  </span><span begin="01:27.890" end="01:29.030">day</span></p><p ttm:agent="v1" begin="01:29.390" end="01:32.210"><span begin="01:29.390" end="01:29.690">And  </span><span begin="01:29.690" end="01:29.780">if  </span><span begin="01:29.780" end="01:30.080">she  </span><span begin="01:30.080" end="01:30.380">had  </span><span begin="01:30.380" end="01:30.500">the  </span><span begin="01:30.500" end="01:31.010">proper  </span><span begin="01:31.010" end="01:31.610">words  </span><span begin="01:31.610" end="01:31.700">to  </span><span begin="01:31.700" end="01:32.210">say</span><span begin="01:32.210" end="01:32.210">,</span></p><p ttm:agent="v1" begin="01:32.210" end="01:33.560"><span begin="01:32.210" end="01:32.510">She  </span><span begin="01:32.510" end="01:32.690">would  </span><span begin="01:32.690" end="01:33.080">tell  </span><span begin="01:33.080" end="01:33.560">him</span></p><p ttm:agent="v1" begin="01:34.160" end="01:36.890"><span begin="01:34.160" end="01:34.370">But  </span><span begin="01:34.370" end="01:34.730">she'd  </span><span begin="01:34.730" end="01:34.910">have  </span><span begin="01:34.910" end="01:35.360">nothing  </span><span begin="01:35.360" end="01:35.630">left  </span><span begin="01:35.630" end="01:35.780">to  </span><span begin="01:35.780" end="01:36.200">sell  </span><span begin="01:36.200" end="01:36.890">him</span></p><p ttm:agent="v1" begin="01:41.480" end="01:43.640"><span begin="01:41.480" end="01:41.960">Say  </span><span begin="01:41.960" end="01:42.230">what  </span><span begin="01:42.230" end="01:42.410">you  </span><span begin="01:42.410" end="01:43.640">mean</span></p><p ttm:agent="v1" begin="01:43.640" end="01:45.590"><span begin="01:43.640" end="01:43.940">Tell  </span><span begin="01:43.940" end="01:44.210">me  </span><span begin="01:44.210" end="01:44.390">I'm  </span><span begin="01:44.390" end="01:45.590">right</span></p><p ttm:agent="v1" begin="01:45.620" end="01:49.130"><span begin="01:45.620" end="01:45.860">And  </span><span begin="01:45.860" end="01:46.100">let  </span><span begin="01:46.100" end="01:46.190">the  </span><span begin="01:46.190" end="01:46.880">sun  </span><span begin="01:46.880" end="01:47.240">rain  </span><span begin="01:47.240" end="01:47.870">down  </span><span begin="01:47.870" end="01:48.230">on  </span><span begin="01:48.230" end="01:49.130">me</span></p><p ttm:agent="v1" begin="01:49.400" end="01:51.230"><span begin="01:49.400" end="01:49.760">Give  </span><span begin="01:49.760" end="01:50.000">me  </span><span begin="01:50.000" end="01:50.060">a  </span><span begin="01:50.060" end="01:51.230">sign</span></p><p ttm:agent="v1" begin="01:51.230" end="01:55.760"><span begin="01:51.230" end="01:51.380">I  </span><span begin="01:51.380" end="01:51.710">want  </span><span begin="01:51.710" end="01:51.860">to  </span><span begin="01:51.860" end="01:55.760">believe</span></p><p ttm:agent="v1" begin="01:56.150" end="02:00.260"><span begin="01:56.150" end="01:58.520">Woah</span><span begin="01:58.520" end="01:58.550">,</span><span begin="01:58.550" end="01:59.000">Mona  </span><span begin="01:59.000" end="02:00.260">Lisa</span><span begin="02:00.260" end="02:00.260">,</span></p><p ttm:agent="v1" begin="02:00.260" end="02:03.500"><span begin="02:00.260" end="02:00.410">You're  </span><span begin="02:00.410" end="02:01.400">guaranteed  </span><span begin="02:01.400" end="02:01.880">to  </span><span begin="02:01.880" end="02:02.240">run  </span><span begin="02:02.240" end="02:02.570">this  </span><span begin="02:02.570" end="02:03.500">town</span></p><p ttm:agent="v1" begin="02:03.530" end="02:07.790"><span begin="02:03.530" end="02:06.050">Woah</span><span begin="02:06.050" end="02:06.080">,</span><span begin="02:06.080" end="02:06.620">Mona  </span><span begin="02:06.620" end="02:07.760">Lisa</span><span begin="02:07.760" end="02:07.790">,</span></p><p ttm:agent="v1" begin="02:07.790" end="02:17.930"><span begin="02:07.790" end="02:08.030">I'd  </span><span begin="02:08.030" end="02:08.300">pay  </span><span begin="02:08.300" end="02:08.420">to  </span><span begin="02:08.420" end="02:08.810">see  </span><span begin="02:08.810" end="02:09.080">you  </span><span begin="02:09.080" end="02:17.930">frown</span></p>