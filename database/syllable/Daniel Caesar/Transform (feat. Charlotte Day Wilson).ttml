<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Transform (feat. Charlotte Day Wilson)</ttm:title><ttm:agent type="group" xml:id="v1">Daniel Caesar, Charlotte Day Wilson</ttm:agent><ttm:item type="album">Freudian</ttm:item><ttm:item type="spotify_id">1jQfgl9WRle7D8a3GXLwaD</ttm:item><itunes:duration>04:40.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.900" end="00:04.765"><span begin="00:00.900" end="00:01.068">If </span><span begin="00:01.068" end="00:01.330">a </span><span begin="00:01.330" end="00:02.313">leopard </span><span begin="00:02.313" end="00:03.408">never </span><span begin="00:03.408" end="00:03.791">changes </span><span begin="00:03.791" end="00:04.014">it's </span><span begin="00:04.014" end="00:04.765">spots</span></p><p ttm:agent="v1" begin="00:05.756" end="00:08.437"><span begin="00:05.756" end="00:05.947">How </span><span begin="00:05.947" end="00:06.098">can </span><span begin="00:06.098" end="00:06.337">I </span><span begin="00:06.337" end="00:07.024">change </span><span begin="00:07.024" end="00:07.359">what </span><span begin="00:07.359" end="00:07.750">I've </span><span begin="00:07.750" end="00:08.437">got</span></p><p ttm:agent="v1" begin="00:09.613" end="00:15.840"><span begin="00:09.613" end="00:11.843">Transform </span><span begin="00:11.843" end="00:13.074">transform </span><span begin="00:13.074" end="00:14.177">transform </span><span begin="00:14.177" end="00:15.840">transform</span></p><p ttm:agent="v1" begin="00:18.044" end="00:22.371"><span begin="00:18.044" end="00:18.235">We </span><span begin="00:18.235" end="00:18.370">don't </span><span begin="00:18.370" end="00:18.961">punish </span><span begin="00:18.961" end="00:19.160">the </span><span begin="00:19.160" end="00:20.591">tiger </span><span begin="00:20.591" end="00:20.750">for </span><span begin="00:20.750" end="00:21.445">catching </span><span begin="00:21.445" end="00:21.644">it's </span><span begin="00:21.644" end="00:22.371">prey</span></p><p ttm:agent="v1" begin="00:22.940" end="00:25.955"><span begin="00:22.940" end="00:23.108">So </span><span begin="00:23.108" end="00:23.354">how </span><span begin="00:23.354" end="00:23.521">am </span><span begin="00:23.521" end="00:23.911">I </span><span begin="00:23.911" end="00:24.286">the </span><span begin="00:24.286" end="00:24.798">one </span><span begin="00:24.798" end="00:25.292">to </span><span begin="00:25.292" end="00:25.955">blame</span></p><p ttm:agent="v1" begin="00:26.635" end="00:28.748"><span begin="00:26.635" end="00:26.850">If </span><span begin="00:26.850" end="00:27.082">it's </span><span begin="00:27.082" end="00:27.272">in </span><span begin="00:27.272" end="00:27.567">my </span><span begin="00:27.567" end="00:28.748">nature</span></p><p ttm:agent="v1" begin="00:29.633" end="00:34.037"><span begin="00:29.633" end="00:30.832">Transform </span><span begin="00:30.832" end="00:32.071">transform </span><span begin="00:32.071" end="00:34.037">transform</span></p><p ttm:agent="v1" begin="00:38.937" end="00:42.459"><span begin="00:38.937" end="00:39.112">And </span><span begin="00:39.112" end="00:39.303">I </span><span begin="00:39.303" end="00:39.774">don't </span><span begin="00:39.774" end="00:40.157">know </span><span begin="00:40.157" end="00:41.422">why </span><span begin="00:41.422" end="00:41.589">I </span><span begin="00:41.589" end="00:41.876">fight </span><span begin="00:41.876" end="00:42.459">it</span></p><p ttm:agent="v1" begin="00:43.627" end="00:47.389"><span begin="00:43.627" end="00:43.794">The </span><span begin="00:43.794" end="00:43.993">least </span><span begin="00:43.993" end="00:44.616">I </span><span begin="00:44.616" end="00:44.935">could </span><span begin="00:44.935" end="00:45.839">do </span><span begin="00:45.839" end="00:46.093">is </span><span begin="00:46.093" end="00:47.389">try</span></p><p ttm:agent="v1" begin="00:48.379" end="00:50.828"><span begin="00:48.379" end="00:48.578">But </span><span begin="00:48.578" end="00:49.146">ego's </span><span begin="00:49.146" end="00:49.757">in </span><span begin="00:49.757" end="00:50.004">the </span><span begin="00:50.004" end="00:50.828">way</span></p><p ttm:agent="v1" begin="00:56.464" end="01:00.473"><span begin="00:56.464" end="00:56.639">I </span><span begin="00:56.639" end="00:57.319">know </span><span begin="00:57.319" end="00:57.519">that </span><span begin="00:57.519" end="00:58.324">you </span><span begin="00:58.324" end="00:58.683">feel </span><span begin="00:58.683" end="00:59.642">mad </span><span begin="00:59.642" end="01:00.473">today</span></p><p ttm:agent="v1" begin="01:01.217" end="01:05.023"><span begin="01:01.217" end="01:01.407">But </span><span begin="01:01.407" end="01:01.902">that </span><span begin="01:01.902" end="01:03.324">anger </span><span begin="01:03.324" end="01:03.515">will </span><span begin="01:03.515" end="01:04.233">fade </span><span begin="01:04.233" end="01:05.023">away</span></p><p ttm:agent="v1" begin="01:05.749" end="01:10.349"><span begin="01:05.749" end="01:05.988">And </span><span begin="01:05.988" end="01:06.298">you'll </span><span begin="01:06.298" end="01:06.586">wish </span><span begin="01:06.586" end="01:07.057">she </span><span begin="01:07.057" end="01:08.702">was </span><span begin="01:08.702" end="01:10.349">here</span></p><p ttm:agent="v1" begin="01:16.347" end="01:21.853"><span begin="01:16.347" end="01:16.698">It's </span><span begin="01:16.698" end="01:17.505">never </span><span begin="01:17.505" end="01:19.865">over </span><span begin="01:19.865" end="01:20.511">until </span><span begin="01:20.511" end="01:20.950">life </span><span begin="01:20.950" end="01:21.853">ends</span></p><p ttm:agent="v1" begin="01:23.235" end="01:28.860"><span begin="01:23.235" end="01:23.618">Lay </span><span begin="01:23.618" end="01:24.009">down </span><span begin="01:24.009" end="01:26.176">beside </span><span begin="01:26.176" end="01:26.719">me </span><span begin="01:26.719" end="01:27.054">do </span><span begin="01:27.054" end="01:27.397">it </span><span begin="01:27.397" end="01:28.860">again</span></p><p ttm:agent="v1" begin="01:30.107" end="01:36.892"><span begin="01:30.107" end="01:30.426">It's </span><span begin="01:30.426" end="01:31.329">never </span><span begin="01:31.329" end="01:33.536">over </span><span begin="01:33.536" end="01:34.335">until </span><span begin="01:34.335" end="01:34.806">life </span><span begin="01:34.806" end="01:36.278">ends </span><span begin="01:36.278" end="01:36.892">yeah</span></p><p ttm:agent="v1" begin="01:37.179" end="01:39.872"><span begin="01:37.179" end="01:37.458">Lay </span><span begin="01:37.458" end="01:37.897">down </span><span begin="01:37.897" end="01:39.872">beside</span></p><p ttm:agent="v1" begin="01:44.131" end="01:50.023"><span begin="01:44.131" end="01:44.410">Don't </span><span begin="01:44.410" end="01:44.698">be </span><span begin="01:44.698" end="01:45.200">a </span><span begin="01:45.200" end="01:47.220">fool </span><span begin="01:47.220" end="01:47.563">baby </span><span begin="01:47.563" end="01:47.906">I </span><span begin="01:47.906" end="01:48.297">know </span><span begin="01:48.297" end="01:48.704">you've </span><span begin="01:48.704" end="01:50.023">changed</span></p><p ttm:agent="v1" begin="01:51.008" end="01:57.761"><span begin="01:51.008" end="01:51.383">It's </span><span begin="01:51.383" end="01:51.710">in </span><span begin="01:51.710" end="01:52.149">my </span><span begin="01:52.149" end="01:54.307">nature </span><span begin="01:54.307" end="01:54.618">and </span><span begin="01:54.618" end="01:55.250">it's </span><span begin="01:55.250" end="01:56.907">okay </span><span begin="01:56.907" end="01:57.178">it's </span><span begin="01:57.178" end="01:57.761">okay</span></p><p ttm:agent="v1" begin="01:58.194" end="02:03.829"><span begin="01:58.194" end="01:58.393">And </span><span begin="01:58.393" end="01:58.592">I'll </span><span begin="01:58.592" end="01:58.799">be </span><span begin="01:58.799" end="01:59.119">your </span><span begin="01:59.119" end="02:01.277">goddess </span><span begin="02:01.277" end="02:01.468">and </span><span begin="02:01.468" end="02:01.715">you </span><span begin="02:01.715" end="02:02.122">a </span><span begin="02:02.122" end="02:02.657">part </span><span begin="02:02.657" end="02:03.050">of </span><span begin="02:03.050" end="02:03.829">me</span></p><p ttm:agent="v1" begin="02:04.953" end="02:10.169"><span begin="02:04.953" end="02:05.304">Lay </span><span begin="02:05.304" end="02:05.671">down </span><span begin="02:05.671" end="02:06.037">your </span><span begin="02:06.037" end="02:08.485">pride </span><span begin="02:08.485" end="02:08.795">lay </span><span begin="02:08.795" end="02:09.219">down </span><span begin="02:09.219" end="02:09.594">with </span><span begin="02:09.594" end="02:10.169">me</span></p><p ttm:agent="v1" begin="02:10.353" end="02:13.602"><span begin="02:10.353" end="02:11.056">So </span><span begin="02:11.056" end="02:11.935">ugly </span><span begin="02:11.935" end="02:12.605">but </span><span begin="02:12.605" end="02:12.860">you </span><span begin="02:12.860" end="02:13.100">love </span><span begin="02:13.100" end="02:13.602">me</span></p><p ttm:agent="v1" begin="02:13.608" end="02:16.948"><span begin="02:13.608" end="02:14.127">Keep </span><span begin="02:14.127" end="02:15.271">nobody </span><span begin="02:15.271" end="02:16.086">else </span><span begin="02:16.086" end="02:16.558">above </span><span begin="02:16.558" end="02:16.948">me</span></p><p ttm:agent="v1" begin="02:17.161" end="02:20.953"><span begin="02:17.161" end="02:17.447">And </span><span begin="02:17.447" end="02:17.879">that's </span><span begin="02:17.879" end="02:18.270">why </span><span begin="02:18.270" end="02:18.724">I </span><span begin="02:18.724" end="02:19.140">keep </span><span begin="02:19.140" end="02:19.547">you </span><span begin="02:19.547" end="02:20.953">around</span></p><p ttm:agent="v1" begin="02:23.961" end="02:26.995"><span begin="02:23.961" end="02:24.279">Ain't </span><span begin="02:24.279" end="02:24.911">it </span><span begin="02:24.911" end="02:25.758">funny </span><span begin="02:25.758" end="02:26.309">now </span><span begin="02:26.309" end="02:26.540">you're </span><span begin="02:26.540" end="02:26.995">money</span></p><p ttm:agent="v1" begin="02:27.472" end="02:30.607"><span begin="02:27.472" end="02:27.992">Act </span><span begin="02:27.992" end="02:28.295">like </span><span begin="02:28.295" end="02:28.693">you </span><span begin="02:28.693" end="02:29.101">don't </span><span begin="02:29.101" end="02:29.960">know </span><span begin="02:29.960" end="02:30.607">nobody</span></p><p ttm:agent="v1" begin="02:31.053" end="02:35.104"><span begin="02:31.053" end="02:31.372">What </span><span begin="02:31.372" end="02:31.827">goes </span><span begin="02:31.827" end="02:32.230">round </span><span begin="02:32.230" end="02:32.643">gon' </span><span begin="02:32.643" end="02:33.122">come </span><span begin="02:33.122" end="02:33.537">back </span><span begin="02:33.537" end="02:35.104">around</span></p><p ttm:agent="v1" begin="02:39.999" end="02:45.105"><span begin="02:39.999" end="02:40.166">It's </span><span begin="02:40.166" end="02:41.053">never </span><span begin="02:41.053" end="02:43.188">over </span><span begin="02:43.188" end="02:44.035