96" end="00:19.660">That </span><span begin="00:19.660" end="00:20.321">be </span><span begin="00:20.321" end="00:20.792">known </span><span begin="00:20.792" end="00:21.351">let </span><span begin="00:21.351" end="00:21.993">me </span><span begin="00:21.993" end="00:22.513">know</span></p><p ttm:agent="v1" begin="00:27.484" end="00:33.951"><span begin="00:27.484" end="00:28.048">Seems </span><span begin="00:28.048" end="00:28.483">like </span><span begin="00:28.483" end="00:29.188">street </span><span begin="00:29.188" end="00:30.203">lights </span><span begin="00:30.203" end="00:31.854">glowing </span><span begin="00:31.854" end="00:32.882">happen </span><span begin="00:32.882" end="00:33.403">to </span><span begin="00:33.403" end="00:33.951">be</span></p><p ttm:agent="v1" begin="00:34.167" end="00:40.270"><span begin="00:34.167" end="00:34.636">Just </span><span begin="00:34.636" end="00:35.173">like </span><span begin="00:35.173" end="00:36.765">moments </span><span begin="00:36.765" end="00:38.355">passing </span><span begin="00:38.355" end="00:38.835">in </span><span begin="00:38.835" end="00:39.381">front </span><span begin="00:39.381" end="00:39.852">of </span><span begin="00:39.852" end="00:40.270">me</span></p><p ttm:agent="v1" begin="00:40.531" end="00:46.908"><span begin="00:40.531" end="00:41.020">So </span><span begin="00:41.020" end="00:41.559">I </span><span begin="00:41.559" end="00:42.344">hopped </span><span begin="00:42.344" end="00:43.043">in </span><span begin="00:43.043" end="00:43.255">the </span><span begin="00:43.255" end="00:43.839">cab </span><span begin="00:43.839" end="00:44.888">and </span><span begin="00:44.888" end="00:45.299">I </span><span begin="00:45.299" end="00:45.915">paid </span><span begin="00:45.915" end="00:46.456">my </span><span begin="00:46.456" end="00:46.908">fare</span></p><p ttm:agent="v1" begin="00:47.366" end="00:53.443"><span begin="00:47.366" end="00:47.703">See </span><span begin="00:47.703" end="00:48.026">I </span><span begin="00:48.026" end="00:48.682">know </span><span begin="00:48.682" end="00:49.239">my </span><span begin="00:49.239" end="00:51.515">destination </span><span begin="00:51.515" end="00:51.943">I'm </span><span begin="00:51.943" end="00:52.453">just </span><span begin="00:52.453" end="00:52.952">not </span><span begin="00:52.952" end="00:53.443">there</span></p><p ttm:agent="v1" begin="00:53.689" end="00:59.869"><span begin="00:53.689" end="00:54.094">All </span><span begin="00:54.094" end="00:54.543">the </span><span begin="00:54.543" end="00:55.291">street </span><span begin="00:55.291" end="00:56.284">lights </span><span begin="00:56.284" end="00:57.980">glowing </span><span begin="00:57.980" end="00:58.996">happen </span><span begin="00:58.996" end="00:59.530">to </span><span begin="00:59.530" end="00:59.869">be</span></p><p ttm:agent="v1" begin="01:00.174" end="01:06.297"><span begin="01:00.174" end="01:00.692">Just </span><span begin="01:00.692" end="01:01.187">like </span><span begin="01:01.187" end="01:02.866">moments </span><span begin="01:02.866" end="01:04.515">passing </span><span begin="01:04.515" end="01:04.975">in </span><span begin="01:04.975" end="01:05.532">front </span><span begin="01:05.532" end="01:05.992">of </span><span begin="01:05.992" end="01:06.297">me</span></p><p ttm:agent="v1" begin="01:06.654" end="01:12.887"><span begin="01:06.654" end="01:07.139">So </span><span begin="01:07.139" end="01:07.771">I </span><span begin="01:07.771" end="01:08.417">hopped </span><span begin="01:08.417" end="01:09.234">in </span><span begin="01:09.234" end="01:09.452">the </span><span begin="01:09.452" end="01:11.064">cab </span><span begin="01:11.064" end="01:11.428">and </span><span begin="01:11.428" end="01:11.696">I </span><span begin="01:11.696" end="01:12.048">paid </span><span begin="01:12.048" end="01:12.560">my </span><span begin="01:12.560" end="01:12.887">fare</span></p><p ttm:agent="v1" begin="01:13.553" end="01:19.624"><span begin