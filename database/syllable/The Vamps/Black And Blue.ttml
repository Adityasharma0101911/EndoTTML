<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Black And Blue</ttm:title><ttm:agent type="person" xml:id="v1">The Vamps</ttm:agent><ttm:item type="album">Night &amp; Day (Day Edition – Extra Tracks)</ttm:item><ttm:item type="spotify_id">3hpyJoGe3N31LuIJFBT90u</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:11.030" end="00:13.310"><span begin="00:11.030" end="00:11.180">I </span><span begin="00:11.180" end="00:11.360">Just </span><span begin="00:11.360" end="00:11.570">wanna </span><span begin="00:11.570" end="00:11.870">get </span><span begin="00:11.870" end="00:13.280">drunk</span></p><p ttm:agent="v1" begin="00:13.310" end="00:18.230"><span begin="00:13.310" end="00:13.700">Cause </span><span begin="00:13.700" end="00:13.850">I'm </span><span begin="00:13.850" end="00:14.360">hardly </span><span begin="00:14.360" end="00:14.660">over </span><span begin="00:14.660" end="00:16.280">you</span><span begin="00:16.280" end="00:16.310">, </span><span begin="00:16.310" end="00:18.140">no</span></p><p ttm:agent="v1" begin="00:18.230" end="00:20.690"><span begin="00:18.230" end="00:18.440">I'm </span><span begin="00:18.440" end="00:18.710">begging </span><span begin="00:18.710" end="00:18.860">just </span><span begin="00:18.860" end="00:18.920">to </span><span begin="00:18.920" end="00:19.280">feel </span><span begin="00:19.280" end="00:20.660">numb</span></p><p ttm:agent="v1" begin="00:20.690" end="00:25.010"><span begin="00:20.690" end="00:21.020">Cause </span><span begin="00:21.020" end="00:21.170">my </span><span begin="00:21.170" end="00:21.530">mind </span><span begin="00:21.530" end="00:21.710">has </span><span begin="00:21.710" end="00:21.980">been </span><span begin="00:21.980" end="00:22.430">so </span><span begin="00:22.430" end="00:23.780">cruel</span><span begin="00:23.780" end="00:23.840">, </span><span begin="00:23.840" end="00:24.980">aye</span></p><p ttm:agent="v1" begin="00:25.010" end="00:26.570"><span begin="00:25.010" end="00:25.400">There </span><span begin="00:25.400" end="00:25.730">was </span><span begin="00:25.730" end="00:25.820">a </span><span begin="00:25.820" end="00:26.480">light</span></p><p ttm:agent="v1" begin="00:26.570" end="00:27.920"><span begin="00:26.570" end="00:26.840">Up </span><span begin="00:26.840" end="00:27.020">in </span><span begin="00:27.020" end="00:27.110">the </span><span begin="00:27.110" end="00:27.860">sky</span></p><p ttm:agent="v1" begin="00:27.920" end="00:30.140"><span begin="00:27.920" end="00:28.190">It </span><span begin="00:28.190" end="00:28.580">doesn't </span><span begin="00:28.580" end="00:29.180">shine </span><span begin="00:29.180" end="00:30.110">anymore</span></p><p ttm:agent="v1" begin="00:30.140" end="00:31.580"><span begin="00:30.140" end="00:30.380">We've </span><span begin="00:30.380" end="00:30.710">turned </span><span begin="00:30.710" end="00:31.550">tonight</span></p><p ttm:agent="v1" begin="00:31.580" end="00:32.690"><span begin="00:31.580" end="00:31.760">But </span><span begin="00:31.760" end="00:32.120">were </span><span begin="00:32.120" end="00:32.690">alright</span></p><p ttm:agent="v1" begin="00:32.690" end="00:33.800"><span begin="00:32.690" end="00:32.912">And </span><span begin="00:32.912" end="00:33.134">when </span><span begin="00:33.134" end="00:33.356">the </span><span begin="00:33.356" end="00:33.578">stars</span></p><p ttm:agent="v1" begin="00:33.800" end="00:35.270"><span begin="00:33.800" end="00:34.220">They </span><span begin="00:34.220" end="00:34.460">all </span><span begin="00:34.460" end="00:35.240">align</span></p><p ttm:agent="v1" begin="00:35.270" end="00:36.500"><span begin="00:35.270" end="00:35.540">They </span><span begin="00:35.540" end="00:35.780">don't </span><span begin="00:35.780" end="00:36.500">divide</span></p><p ttm:agent="v1" begin="00:36.500" end="00:38.000"><span begin="00:36.500" end="00:36.770">They </span><span begin="00:36.770" end="00:36.920">are </span><span begin="00:36.920" end="00:37.310">burning </span><span begin="00:37.310" end="00:37.970">bright</span></p><p ttm:agent="v1" begin="00:38.000" end="00:39.890"><span begin="00:38.000" end="00:38.480">Burning </span><span begin="00:38.480" end="00:39.860">bright</span></p><p ttm:agent="v1" begin="00:39.890" end="00:40.940"><span begin="00:39.890" end="00:40.100">In </span><span begin="00:40.100" end="00:40.370">my </span><span begin="00:40.370" end="00:40.940">head</span></p><p ttm:agent="v1" begin="00:40.940" end="00:41.900"><span begin="00:40.940" end="00:41.090">In </span><span begin="00:41.090" end="00:41.330">my </span><span begin="00:41.330" end="00:41.900">heart</span></p><p ttm:agent="v1" begin="00:41.900" end="00:44.630"><span begin="00:41.900" end="00:42.050">It </span><span begin="00:42.050" end="00:42.290">will </span><span begin="00:42.290" end="00:43.160">always </span><span begin="00:43.160" end="00:43.610">be </span><span begin="00:43.610" end="00:44.000">with </span><span begin="00:44.000" end="00:44.030"> </span><span begin="00:44.030" end="00:44.630">you</span></p><p ttm:agent="v1" begin="00:44.630" end="00:45.560"><span begin="00:44.630" end="00:44.840">In </span><span begin="00:44.840" end="00:44.960">the </span><span begin="00:44.960" end="00:45.560">dark</span></p><p ttm:agent="v1" begin="00:45.560" end="00:50.930"><span begin="00:45.560" end="00:45.770">It </span><span begin="00:45.770" end="00:46.040">will </span><span begin="00:46.040" end="00:46.820">always </span><span begin="00:46.820" end="00:47.300">be </span><span begin="00:47.300" end="00:47.750">with </span><span begin="00:47.750" end="00:50.900">you</span></p><p ttm:agent="v1" begin="00:50.930" end="00:54.710"><span begin="00:50.930" end="00:51.140">But </span><span begin="00:51.140" end="00:51.410">now </span><span begin="00:51.410" end="00:51.620">you </span><span begin="00:51.620" end="00:52.160">left </span><span begin="00:52.160" end="00:52.550">me </span><span begin="00:52.550" end="00:52.880">black </span><span begin="00:52.880" end="00:53.030">and </span><span begin="00:53.030" end="00:54.650">blue</span></p><p ttm:agent="v1" begin="00:54.710" end="00:55.730"><span begin="00:54.710" end="00:54.860">In </span><span begin="00:54.860" end="00:55.130">my </span><span begin="00:55.130" end="00:55.730">head</span></p><p ttm:agent="v1" begin="00:55.730" end="00:56.660"><span begin="00:55.730" end="00:55.850">In </span><span begin="00:55.850" end="00:56.090">my </span><span begin="00:56.090" end="00:56.660">heart</span></p><p ttm:agent="v1" begin="00:56.660" end="00:59.420"><span begin="00:56.660" end="00:56.810">It </span><span begin="00:56.810" end="00:57.050">will </span><span begin="00:57.050" end="00:57.890">always </span><span begin="00:57.890" end="00:58.370">be </span><span begin="00:58.370" end="00:58.790">with </span><span begin="00:58.790" end="00:58.820"> </span><span begin="00:58.820" end="00:59.420">you</span></p><p ttm:agent="v1" begin="00:59.420" end="01:00.290"><span begin="00:59.420" end="00:59.570">And </span><span begin="00:59.570" end="00:59.660">the </span><span begin="00:59.660" end="01:00.290">scars</span></p><p ttm:agent="v1" begin="01:00.290" end="01:01.130"><span begin="01:00.290" end="01:00.410">Oh </span><span begin="01:00.410" end="01:00.590">they </span><span begin="01:00.590" end="01:01.130">show</span></p><p ttm:agent="v1" begin="01:01.130" end="01:05.720"><span begin="01:01.130" end="01:01.580">What </span><span begin="01:01.580" end="01:02.090">weve </span><span begin="01:02.090" end="01:02.480">been </span><span begin="01:02.480" end="01:05.690">through</span></p><p ttm:agent="v1" begin="01:05.720" end="01:11.990"><span begin="01:05.720" end="01:05.930">But </span><span begin="01:05.930" end="01:06.200">now </span><span begin="01:06.200" end="01:06.410">you've </span><span begin="01:06.410" end="01:06.950">left </span><span begin="01:06.950" end="01:07.310">me </span><span begin="01:07.310" end="01:07.700">black </span><span begin="01:07.700" end="01:07.880">and </span><span begin="01:07.880" end="01:11.270">blue</span></p><p ttm:agent="v1" begin="01:11.990" end="01:14.090"><span begin="01:11.990" end="01:12.150">I </span><span begin="01:12.150" end="01:12.300">don't </span><span begin="01:12.300" end="01:12.440">wanna </span><span begin="01:12.440" end="01:12.800">feel </span><span begin="01:12.800" end="01:14.000">love</span></p><p ttm:agent="v1" begin="01:14.090" end="01:16.760"><span begin="01:14.090" end="01:14.540">Unless </span><span begin="01:14.540" end="01:14.660">the </span><span begin="01:14.660" end="01:15.050">love </span><span begin="01:15.050" end="01:15.200">has </span><span begin="01:15.200" end="01:15.440">come </span><span begin="01:15.440" end="01:15.710">from </span><span begin="01:15.710" end="01:16.730">you</span></p><p ttm:agent="v1" begin="01:16.760" end="01:18.890"><span begin="01:16.760" end="01:17.210">My </span><span begin="01:17.210" end="01:18.860">darling</span></p><p ttm:agent="v1" begin="01:18.890" end="01:22.550"><span begin="01:18.890" end="01:19.220">Who </span><span begin="01:19.220" end="01:19.640">knew </span><span begin="01:19.640" end="01:20.120">this </span><span begin="01:20.120" end="01:20.330">would </span><span begin="01:20.330" end="01:20.570">be </span><span begin="01:20.570" end="01:20.810">this </span><span begin="01:20.810" end="01:22.520">tough</span></p><p ttm:agent="v1" begin="01:22.550" end="01:25.940"><span begin="01:22.550" end="01:22.910">But </span><span begin="01:22.910" end="01:23.030">I </span><span begin="01:23.030" end="01:23.480">hope </span><span begin="01:23.480" end="01:23.810">you </span><span begin="01:23.810" end="01:24.020">don't </span><span begin="01:24.020" end="01:24.350">feel </span><span begin="01:24.350" end="01:24.500">it </span><span begin="01:24.500" end="01:25.910">too</span></p><p ttm:agent="v1" begin="01:25.940" end="01:27.470"><span begin="01:25.940" end="01:26.330">There </span><span begin="01:26.330" end="01:26.630">was </span><span begin="01:26.630" end="01:26.750">a </span><span begin="01:26.750" end="01:27.410">light</span></p><p ttm:agent="v1" begin="01:27.470" end="01:28.820"><span begin="01:27.470" end="01:27.770">Up </span><span begin="01:27.770" end="01:27.950">in </span><span begin="01:27.950" end="01:28.040">the </span><span begin="01:28.040" end="01:28.790">sky</span></p><p ttm:agent="v1" begin="01:28.820" end="01:31.070"><span begin="01:28.820" end="01:29.120">It </span><span begin="01:29.120" end="01:29.510">doesn't </span><span begin="01:29.510" end="01:30.110">shine </span><span begin="01:30.110" end="01:31.040">anymore</span></p><p ttm:agent="v1" begin="01:31.070" end="01:32.480"><span begin="01:31.070" end="01:31.310">Weve </span><span begin="01:31.310" end="01:31.610">turned </span><span begin="01:31.610" end="01:32.450">tonight</span></p><p ttm:agent="v1" begin="01:32.480" end="01:33.620"><span begin="01:32.480" end="01:32.690">But </span><span begin="01:32.690" end="01:33.050">we're </span><span begin="01:33.050" end="01:33.620">alright</span></p><p ttm:agent="v1" begin="01:33.620" end="01:34.820"><span begin="01:33.620" end="01:33.860">And </span><span begin="01:33.860" end="01:34.100">when </span><span begin="01:34.100" end="01:34.340">the </span><span begin="01:34.340" end="01:34.580">stars</span></p><p ttm:agent="v1" begin="01:34.820" end="01:36.170"><span begin="01:34.820" end="01:35.150">They </span><span begin="01:35.150" end="01:35.390">all </span><span begin="01:35.390" end="01:36.140">align</span></p><p ttm:agent="v1" begin="01:36.170" end="01:37.430"><span begin="01:36.170" end="01:36.470">They </span><span begin="01:36.470" end="01:36.710">don't </span><span begin="01:36.710" end="01:37.430">divide</span></p><p ttm:agent="v1" begin="01:37.430" end="01:38.930"><span begin="01:37.430" end="01:37.700">They </span><span begin="01:37.700" end="01:37.820">are </span><span begin="01:37.820" end="01:38.240">burning </span><span begin="01:38.240" end="01:38.900">bright</span></p><p ttm:agent="v1" begin="01:38.930" end="01:40.850"><span begin="01:38.930" end="01:39.410">Burning </span><span begin="01:39.410" end="01:40.760">bright</span></p><p ttm:agent="v1" begin="01:40.850" end="01:41.870"><span begin="01:40.850" end="01:41.000">In </span><span begin="01:41.000" end="01:41.300">my </span><span begin="01:41.300" end="01:41.870">head</span></p><p ttm:agent="v1" begin="01:41.870" end="01:42.800"><span begin="01:41.870" end="01:42.020">In </span><span begin="01:42.020" end="01:42.260">my </span><span begin="01:42.260" end="01:42.800">heart</span></p><p ttm:agent="v1" begin="01:42.800" end="01:45.560"><span begin="01:42.800" end="01:42.980">It </span><span begin="01:42.980" end="01:43.220">will </span><span begin="01:43.220" end="01:44.060">always </span><span begin="01:44.060" end="01:44.510">be </span><span begin="01:44.510" end="01:44.930">with </span><span begin="01:44.930" end="01:44.960"> </span><span begin="01:44.960" end="01:45.560">you</span></p><p ttm:agent="v1" begin="01:45.560" end="01:46.490"><span begin="01:45.560" end="01:45.740">In </span><span begin="01:45.740" end="01:45.860">the </span><span begin="01:45.860" end="01:46.490">dark</span></p><p ttm:agent="v1" begin="01:46.490" end="01:51.860"><span begin="01:46.490" end="01:46.700">It </span><span begin="01:46.700" end="01:46.970">will 