an begin="00:47.850" end="00:47.940">I </span><span begin="00:47.940" end="00:48.210">should </span><span begin="00:48.210" end="00:48.930">go</span><span begin="00:48.930" end="00:49.020">,</span></p><p ttm:agent="v1" begin="00:49.020" end="00:52.710"><span begin="00:49.020" end="00:49.650">Oh</span><span begin="00:49.650" end="00:49.710">, </span><span begin="00:49.710" end="00:50.310">oh</span><span begin="00:50.310" end="00:50.610">, </span><span begin="00:50.610" end="00:50.940">maybe </span><span begin="00:50.940" end="00:51.180">she </span><span begin="00:51.180" end="00:51.420">might </span><span begin="00:51.420" end="00:51.720">like </span><span begin="00:51.720" end="00:51.870">me </span><span begin="00:51.870" end="00:52.620">though</span><span begin="00:52.620" end="00:52.710">.</span></p><p ttm:agent="v1" begin="00:52.710" end="00:56.070"><span begin="00:52.710" end="00:53.340">Oh</span><span begin="00:53.340" end="00:53.400">, </span><span begin="00:53.400" end="00:54.120">oh</span><span begin="00:54.120" end="00:54.120">, </span><span begin="00:54.120" end="00:54.180">I </span><span begin="00:54.180" end="00:54.540">just </span><span begin="00:54.540" end="00:54.720">can't </span><span begin="00:54.720" end="00:54.990">think </span><span begin="00:54.990" end="00:55.110">of </span><span begin="00:55.110" end="00:55.380">what </span><span begin="00:55.380" end="00:55.530">to </span><span begin="00:55.530" end="00:56.040">say</span><span begin="00:56.040" end="00:56.070">,</span></p><p ttm:agent="v1" begin="00:56.070" end="00:57.930"><span begin="00:56.070" end="00:56.400">Should </span><span begin="00:56.400" end="00:56.520">I </span><span begin="00:56.520" end="00:56.910">go</span><span begin="00:56.910" end="00:56.970">, </span><span begin="00:56.970" end="00:57.300">should </span><span begin="00:57.300" end="00:57.390">I </span><span begin="00:57.390" end="00:57.930">stay</span><span begin="00:57.930" end="00:57.930">?</span></p><p ttm:agent="v1" b