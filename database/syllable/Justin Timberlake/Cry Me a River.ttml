<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Cry Me a River</ttm:title><ttm:agent type="person" xml:id="v1">Justin Timberlake</ttm:agent><ttm:item type="album">Justified</ttm:item><ttm:item type="spotify_id">7Lf7oSEVdzZqTA0kEDSlS5</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:27.060" end="00:29.190"><span begin="00:27.060" end="00:27.300">You </span><span begin="00:27.300" end="00:27.510">were </span><span begin="00:27.510" end="00:27.660">my </span><span begin="00:27.660" end="00:29.190">sun</span></p><p ttm:agent="v1" begin="00:30.180" end="00:32.280"><span begin="00:30.180" end="00:30.540">You </span><span begin="00:30.540" end="00:30.750">were </span><span begin="00:30.750" end="00:30.990">my </span><span begin="00:30.990" end="00:32.280">earth</span></p><p ttm:agent="v1" begin="00:33.390" end="00:39.270"><span begin="00:33.390" end="00:33.630">But </span><span begin="00:33.630" end="00:33.840">you </span><span begin="00:33.840" end="00:34.170">didn't </span><span begin="00:34.170" end="00:34.680">know </span><span begin="00:34.680" end="00:34.890">all </span><span begin="00:34.890" end="00:34.980">the </span><span begin="00:34.980" end="00:35.700">ways </span><span begin="00:35.700" end="00:35.790">I </span><span begin="00:35.790" end="00:36.300">loved </span><span begin="00:36.300" end="00:37.200">you</span><span begin="00:37.200" end="00:37.410">, </span><span begin="00:37.410" end="00:39.270">no</span></p><p ttm:agent="v1" begin="00:39.780" end="00:42.450"><span begin="00:39.780" end="00:40.020">So </span><span begin="00:40.020" end="00:40.260">you </span><span begin="00:40.260" end="00:40.560">took </span><span begin="00:40.560" end="00:40.620">a </span><span begin="00:40.620" end="00:42.450">chance</span></p><p ttm:agent="v1" begin="00:43.140" end="00:45.660"><span begin="00:43.140" end="00:43.290">And </span><span begin="00:43.290" end="00:43.620">made </span><span begin="00:43.620" end="00:43.890">other </span><span begin="00:43.890" end="00:45.660">plans</span></p><p ttm:agent="v1" begin="00:46.350" end="00:47.970"><span begin="00:46.350" end="00:46.530">But </span><span begin="00:46.530" end="00:46.590">I </span><span begin="00:46.590" end="00:46.830">bet </span><span begin="00:46.830" end="00:46.950">you </span><span begin="00:46.950" end="00:47.220">didn't </span><span begin="00:47.220" end="00:47.820">think </span><span begin="00:47.820" end="00:47.970">that</span></p><p ttm:agent="v1" begin="00:47.970" end="00:51.300"><span begin="00:47.970" end="00:48.390">they </span><span begin="00:48.390" end="00:48.570">woulde </span><span begin="00:48.570" end="00:49.620">crashing </span><span begin="00:49.620" end="00:50.280">down</span><span begin="00:50.280" end="00:50.460">, </span><span begin="00:50.460" end="00:51.300">no</span></p><p ttm:agent="v1" begin="00:52.230" end="00:55.320"><span begin="00:52.230" end="00:52.470">You </span><span begin="00:52.470" end="00:52.680">don't </span><span begin="00:52.680" end="00:52.890">have </span><span begin="00:52.890" end="00:53.010">to </span><span begin="00:53.010" end="00:53.550">say</span><span begin="00:53.550" end="00:53.850">, </span><span begin="00:53.850" end="00:54.150">what </span><span begin="00:54.150" end="00:54.270">you </span><span begin="00:54.270" end="00:54.960">did</span><span begin="00:54.960" end="00:55.320">,</span></p><p ttm:agent="v1" begin="00:55.320" end="00:58.050"><span begin="00:55.320" end="00:55.470">I </span><span begin="00:55.470" end="00:55.920">already </span><span begin="00:55.920" end="00:56.190">know</span><span begin="00:56.190" end="00:56.910">, </span><span begin="00:56.910" end="00:57.030">I </span><span begin="00:57.030" end="00:57.390">found </span><span begin="00:57.390" end="00:57.540">out </span><span begin="00:57.540" end="00:57.840">from </span><span begin="00:57.840" end="00:58.050">him</span></p><p ttm:agent="v1" begin="00:58.050" end="01:01.800"><span begin="00:58.050" end="00:58.980">Now </span><span begin="00:58.980" end="00:59.160">there's </span><span begin="00:59.160" end="00:59.400">just </span><span begin="00:59.400" end="00:59.520">no </span><span begin="00:59.520" end="00:59.970">chance</span><span begin="00:59.970" end="01:00.000">, </span><span begin="01:00.000" end="01:00.330">for </span><span begin="01:00.330" end="01:00.660">you </span><span begin="01:00.660" end="01:00.810">and </span><span begin="01:00.810" end="01:01.440">me</span><span begin="01:01.440" end="01:01.800">,</span></p><p ttm:agent="v1" begin="01:01.800" end="01:03.030"><span begin="01:01.800" end="01:01.980">there'll </span><span begin="01:01.980" end="01:02.370">never </span><span begin="01:02.370" end="01:03.030">be</span></p><p ttm:agent="v1" begin="01:03.210" end="01:05.910"><span begin="01:03.210" end="01:03.420">And </span><span begin="01:03.420" end="01:03.930">don't </span><span begin="01:03.930" end="01:04.020">it </span><span begin="01:04.020" end="01:04.290">make </span><span begin="01:04.290" end="01:04.380">you </span><span begin="01:04.380" end="01:04.920">sad </span><span begin="01:04.920" end="01:05.580">about </span><span begin="01:05.580" end="01:05.910">it</span></p><p ttm:agent="v1" begin="01:05.910" end="01:07.590"><span begin="01:05.910" end="01:05.970">You </span><span begin="01:05.970" end="01:06.300">told </span><span begin="01:06.300" end="01:06.480">me </span><span begin="01:06.480" end="01:06.630">you </span><span begin="01:06.630" end="01:07.110">loved </span><span begin="01:07.110" end="01:07.590">me</span></p><p ttm:agent="v1" begin="01:07.710" end="01:11.220"><span begin="01:07.710" end="01:07.920">Why </span><span begin="01:07.920" end="01:08.100">did </span><span begin="01:08.100" end="01:08.250">you </span><span begin="01:08.250" end="01:08.700">leave </span><span begin="01:08.700" end="01:09.180">me</span><span begin="01:09.180" end="01:09.330">, </span><span begin="01:09.330" end="01:09.780">all </span><span begin="01:09.780" end="01:11.220">alone</span></p><p ttm:agent="v1" begin="01:12.120" end="01:14.070"><span begin="01:12.120" end="01:12.360">Now </span><span begin="01:12.360" end="01:12.480">you </span><span begin="01:12.480" end="01:12.780">tell </span><span begin="01:12.780" end="01:12.990">me </span><span begin="01:12.990" end="01:13.140">you </span><span begin="01:13.140" end="01:13.590">need </span><span begin="01:13.590" end="01:14.070">me</span></p><p ttm:agent="v1" begin="01:14.220" end="01:17.640"><span begin="01:14.220" end="01:14.580">When </span><span begin="01:14.580" end="01:14.730">you </span><span begin="01:14.730" end="01:15.180">call </span><span begin="01:15.180" end="01:15.660">me</span><span begin="01:15.660" end="01:15.840">, </span><span begin="01:15.840" end="01:16.200">on </span><span begin="01:16.200" end="01:16.260">the </span><span begin="01:16.260" end="01:17.640">phone</span></p><p ttm:agent="v1" begin="01:18.990" end="01:22.110"><span begin="01:18.990" end="01:19.350">Girl </span><span begin="01:19.350" end="01:19.470">I </span><span begin="01:19.470" end="01:20.550">refuse</span><span begin="01:20.550" end="01:20.550">, </span><span begin="01:20.550" end="01:20.610">you </span><span begin="01:20.610" end="01:20.910">must </span><span begin="01:20.910" end="01:21.060">have </span><span begin="01:21.060" end="01:21.210">me </span><span begin="01:21.210" end="01:22.110">confused</span></p><p ttm:agent="v1" begin="01:22.110" end="01:24.630"><span begin="01:22.110" end="01:22.200">With </span><span begin="01:22.200" end="01:22.560">some </span><span begin="01:22.560" end="01:22.860">other </span><span begin="01:22.860" end="01:24.630">guy</span></p><p ttm:agent="v1" begin="01:25.320" end="01:26.790"><span begin="01:25.320" end="01:25.500">Your </span><span begin="01:25.500" end="01:25.980">bridges </span><span begin="01:25.980" end="01:26.100">were </span><span begin="01:26.100" end="01:26.790">burned</span><span begin="01:26.790" end="01:26.790">,</span></p><p ttm:agent="v1" begin="01:26.790" end="01:28.920"><span begin="01:26.790" end="01:27.060">and </span><span begin="01:27.060" end="01:27.420">now </span><span begin="01:27.420" end="01:27.600">it's </span><span begin="01:27.600" end="01:27.720">your </span><span begin="01:27.720" end="01:28.920">turn</span></p><p ttm:agent="v1" begin="01:29.100" end="01:32.580"><span begin="01:29.100" end="01:29.310">To </span><span begin="01:29.310" end="01:30.300">cry</span><span begin="01:30.300" end="01:30.300">, </span><span begin="01:30.300" end="01:30.600">cry </span><span begin="01:30.600" end="01:30.870">me </span><span begin="01:30.870" end="01:30.990">a </span><span begin="01:30.990" end="01:32.580">river</span></p><p ttm:agent="v1" begin="01:33.570" end="01:36.900"><span begin="01:33.570" end="01:33.870">Cry </span><span begin="01:33.870" end="01:34.140">me </span><span begin="01:34.140" end="01:34.230">a </span><span begin="01:34.230" end="01:36.840">river</span><span begin="01:36.840" end="01:36.870">-</span><span begin="01:36.870" end="01:36.900">er</span></p><p ttm:agent="v1" begin="01:36.900" end="01:38.940"><span begin="01:36.900" end="01:37.080">Cry </span><span begin="01:37.080" end="01:37.380">me </span><span begin="01:37.380" end="01:37.470">a </span><span begin="01:37.470" end="01:38.940">river</span></p><p ttm:agent="v1" begin="01:40.050" end="01:44.220"><span begin="01:40.050" end="01:40.350">Cry </span><span begin="01:40.350" end="01:40.650">me </span><span begin="01:40.650" end="01:40.740">a </span><span begin="01:40.740" end="01:41.700">river</span><span begin="01:41.700" end="01:41.790">-</span><span begin="01:41.790" end="01:41.820">er</span><span begin="01:41.820" end="01:41.820">, </span><span begin="01:41.820" end="01:42.570">yea </span><span begin="01:42.570" end="01:44.220">yea</span></p><p ttm:agent="v1" begin="01:44.820" end="01:46.050"><span begin="01:44.820" end="01:44.940">I </span><span begin="01:44.940" end="01:45.240">know </span><span begin="01:45.240" end="01:45.420">that </span><span begin="01:45.420" end="01:45.570">they </span><span begin="01:45.570" end="01:46.050">say</span></p><p ttm:agent="v1" begin="01:46.050" end="01:49.470"><span begin="01:46.050" end="01:46.200">That </span><span begin="01:46.200" end="01:47.130">somethings </span><span begin="01:47.130" end="01:47.400">are </span><span begin="01:47.400" end="01:48.030">better </span><span begin="01:48.030" end="01:48.510">left </span><span begin="01:48.510" end="01:49.470">unsaid</span></p><p ttm:agent="v1" begin="01:51.540" end="01:54.150"><span begin="01:51.540" end="01:51.720">It </span><span begin="01:51.720" end="01:52.110">wasn't </span><span begin="01:52.110" end="01:52.770">like </span><span begin="01:52.770" end="01:52.920">you </span><span begin="01:52.920" end="01:53.730">only </span><span begin="01:53.730" end="01:54.150">talked</span></p><p ttm:agent="v1" begin="01:54.150" end="01:56.100"><span begin="01:54.150" end="01:54.570">to </span><span begin="01:54.570" end="01:54.990">him </span><span begin="01:54.990" end="01:55.170">and </span><span begin="01:55.170" end="01:55.290">you </span><span begin="01:55.290" end="01:55.800">know </span><span begin="01:55.800" end="01:56.100">it</span></p><p ttm:agent="v1" begin="01:56.100" end="01:58.050"><span begin="01:56.100" end="01:56.160">（</span><span begin="01:56.160" end="01:56.430">Don't </span><span begin="01:56.430" end="01:56.610">act </span><span begin="01:56.610" end="01:56.820">like </span><span begin="01:56.820" end="01:57.000">you </span><span begin="01:57.000" end="01:57.180">don't </span><span begin="01:57.180" end="01:57.660">know </span><span begin="01:57.660" end="01:58.050">it</span><span begin="01:58.050" end="01:58.050">）</span></p><p ttm:agent="v1" begin="01:58.050" end="02:00.150"><span begin="01:58.050" end="01:58.290">All </span><span begin="01:58.290" end="01:58.410">of </span><span begin="01:58.410" end="01:58.620">these </span><span begin="01:58.620" end="01:59.220">things </span><span begin="01:59.220" end="01:59.580">people </span><span begin="01:59.580" end="01:59.850">told </span><span begin="01:59.850" end="02:00.150">me</span></p><p ttm:agent="v1" begin="02:00.180" end="02:02.670"><span begin="02:00.180" end="02:00.480">Keep </span><span begin="02:00.480" end="02:01.080">messing </span><span begin="02:01.080" end="02:01.470">with </span><span begin="02:01.470" end="02:01.710">my </span><span begin="02:01.710" end="02:02.670">head</span></p><p ttm:agent="v1" begin="02:02.670" end="02:04.230"><span begin="02:02.670" end="02:02.670">（</span><span begin="02:02.670" end="02:02.880">Messing </span><span begin="02:02.880" end="02:03.090">with </span><span begin="02:03.090" end="02:03.360">my </span><span begin="02:03.360" end="02:04.230">head</span><span begin="02:04.230" end="02:04.230">）</span></p><p ttm:agent="v1" begin="02:04.230" end="02:06.510"><span begin="02:04.230" end="02:04.320">You </span><span begin="02:04.320" end="02:04.890">should've </span><span begin="02:04.890" end="02:05.220">picked </span><span begin="02:05.220" end="02:06.510">honesty</span></p><p ttm:agent="v1" begin="02:06.510" end="02:09.060"><span begin="02:06.510" end="02:06.780">Then </span><span begin="02:06.780" end="02:07.110">you </span><span begin="02:07.110" end="02:07.500">may </span><span begin="02:07.500" end="02:07.890">not </span>