05.700">like </span><span begin="01:05.700" end="01:05.820">a </span><span begin="01:05.820" end="01:06.900">stallion</span></p><p ttm:agent="v1" begin="01:06.930" end="01:09.600"><span begin="01:06.930" end="01:07.200">They </span><span begin="01:07.200" end="01:07.710">love </span><span begin="01:07.710" end="01:07.920">it </span><span begin="01:07.920" end="01:08.280">more </span><span begin="01:08.280" end="01:08.520">when </span><span begin="01:08.520" end="01:08.760">it's </span><span begin="01:08.760" end="01:09.600">broken</span></p><p ttm:agent="v1" begin="01:09.600" end="01:12.240"><span begin="01:09.600" end="01:09.780">Do </span><span begin="01:09.780" end="01:09.930">you </span><span begin="01:09.930" end="01:10.890">wanna </span><span begin="01:10.890" end="01:11.250">feel </span><span begin="01:11.250" end="01:12.240">beautiful</span></p><p ttm:agent="v1" begin="01:12.270" end="01:15.300"><span begin="01:12.270" end="01:12.480">Do </span><span begin="01:12.480" end="01:12.600">you </span><span begin="01:12.600" end="01:13.080">wanna</span><span begin="01:13.080" end="01:15.300">?</span></p><p ttm:agent="v1" begin="01:15.300" end="01:17.670"><span begin="01:15.300" end="01:15.510">I'm </span><span begin="01:15.510" end="01:15.810">outside </span><span begin="01:15.810" end="01:15.930">the </span><span begin="01:15.930" end="01:16.350">door</span><span begin="01:16.350" end="01:16.350">, </span><span begin="01:16.350" end="01:16.740">invite </span><span begin="01:16.740" end="01:17.070">me </span><span begin="01:17.070" end="01:17.670">in</span></p><p ttm:agent="v1" begin="01:17.700" end="01:20.550"><span begin="01:17.700" end="01:17.910">So </span><span begin="01:17.910" end="01:18.120">we </span><span begin="01:18.120" end="01:18.300">can </span><span begin="01:18.300" end="01:18.540">go </span><span begin="01:18.540" end="01:18.990">back </span><span begin="01:18.990" end="01:19.110">and </span><span begin="01:19.110" end="01:19.590">play </span><spa