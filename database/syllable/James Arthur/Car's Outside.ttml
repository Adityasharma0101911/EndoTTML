5.325">times </span><span begin="00:15.325" end="00:15.663">it's </span><span begin="00:15.663" end="00:16.086">becomin' </span><span begin="00:16.086" end="00:16.270">my </span><span begin="00:16.270" end="00:16.775">type </span><span begin="00:16.975" end="00:17.415">line</span></p><p ttm:agent="v1" begin="00:19.551" end="00:20.698"><span begin="00:19.551" end="00:19.751">But </span><span begin="00:19.751" end="00:20.005">you </span><span begin="00:20.005" end="00:20.195">know </span><span begin="00:20.195" end="00:20.382">the </span><span begin="00:20.382" end="00:20.698">truth</span></p><p ttm:agent="v1" begin="00:20.698" end="00:22.714"><span begin="00:20.698" end="00:20.899">I'd </span><span begin="00:20.899" end="00:21.406">rather </span><span begin="00:21.406" end="00:21.933">hold </span><span begin="00:21.933" end="00:22.320">you</span></p><p ttm:agent="v1" begin="00:22.714" end="00:25.935"><span begin="00:22.714" end="00:22.911">Than </span><span begin="00:22.911" end="00:23.515">tryna </span><span begin="00:23.515" end="00:23.959">catch </span><span begin="00:23.959" end="00:24.153">this </span><span begin="00:24.153" end="00:24.808">flight</span></p><p ttm:agent="v1" begin="00:25.935" end="00:28.260"><span begin="00:25.935" end="00:26.095">So </span><span begin="00:26.095" end="00:26.511">many </span><span begin="00:26.511" end="00:26.927">things </span><span begin="00:26.927" end="00:27.247">I'd </span><span begin="00:27.247" end="00:27.551">rather </span><span begin="00:27.551" end="00:27.975">say</span></p><p ttm:agent="v1" begin="00:28.260" end="00:32.396"><span begin="00:28.260" end="00:28.419">But </span><span begin="00:28.419" end="00:28.612">for </span><span begin="00:28.612" end="00:28.963">now </span><span begin="00:28.963" end="00:29.146">it's </span><span begin="00:29.146" end="00:30.291">goodbye</span></p><p ttm:agent="v1" begin="00:32.396" end="00:38.865"><span begin="00:32.396" end="00:34.577">You </span><span begin="00:34.577" end="00:34.804">say </span><span begin="00:34.804" end="00:34.976">I'm </span><span begin="00:34.976" end="00:35.528">always </span><span begin="00:35.528" end="00:36.658">leavin'</span></p><p ttm:agent="v1" begin="00:38.865" end="00:44.029"><span begin="00:38.865" end="00:40.809">You </span><span begin="00:41.169" end="00:41.354">when </span><span begin="00:41.354" end="00:41.753">you're </span><span begin="00:41.753" end="00:42.949">sleepin' </span><span begin="00:42.949" end="00:43.948">alone</span></p><p ttm:agent="v1" begin="00:44.029" end="00:47.119"><span begin="00:44.029" end="00:44.437">But </span><span begin="00:45.577" end="00:45.758">the </span><span begin="00:45.758" end="00:46.199">car's </span><span begin="00:46.199" end="00:47.084">outside</span></p><p ttm:agent="v1" begin="00:47.119" end="00:51.782"><span begin="00:47.119" end="00:47.317">But </span><span begin="00:47.317" end="00:47.637">I </span><span begin="00:48.037" end="00:48.294">don't </span><span begin="00:48.608" end="00:48.999">wanna </span><span begin="00:48.999" end="00:49.312">go </span><span begin="00:49.312" end="00:50.399">tonight</span></p><p ttm:agent="v1" begin="00:51.782" end="00:56.972"><span begin="00:51.782" end="00:52.490">I'm </span><span begin="00:52.490" end="00:53.316">not </span><span begin="00:53.316" end="00:54.080">gettin' </span><span begin="00:54.080" end="00:54.523">in </span><span begin="00:54.523" end="00:54.890">the </span><span begin="00:54.890" end="00:56.178">Addison </span><span begin="00:56.178" end="00:56.787">Lee</span></p><p ttm:agent="v1" begin="00:56.972" end="01:00.875"><span begin="00:56.972" end="00:57.699">Unless </span><span begin="00:57.699" end="00:58.040">you </span><span begin="00:58.040" end="00:58.667">pack </span><span begin="00:58.667" end="00:59.298">your </span><span begin="00:59.298" end="01:00.245">bags</span></p><p ttm:agent="v1" begin="01:00.875" end="01:05.621"><span begin="01:00.875" end="01:01.276">You're </span><span begin="01:01.276" end=