720">.</span><span begin="01:54.720" end="01:54.870">.</span></p><p ttm:agent="v1" begin="01:54.870" end="01:55.920"><span begin="01:54.870" end="01:55.380">It's </span><span begin="01:55.380" end="01:55.920">it</span></p><p ttm:agent="v1" begin="01:55.950" end="01:57.600"><span begin="01:55.950" end="01:56.190">What </span><span begin="01:56.190" end="01:56.550">is </span><span begin="01:56.550" end="01:57.120">it</span><span begin="01:57.120" end="01:57.600">?</span></p><p ttm:agent="v1" begin="01:57.600" end="01:58.680"><span begin="01:57.600" end="01:58.110">It's </span><span begin="01:58.110" end="01:58.680">it</span></p><p ttm:agent="v1" begin="01:58.710" end="01:59.550"><span begin="01:58.710" end="01:59.040">What </span><span begin="01:59.040" end="01:59.310">is </span><span begin="01:59.310" end="01:59.550">it</span><span begin="01:59.550" end="01:59.550">?</span></p><p ttm:agent="v1" begin="01:59.550" end="02:40.440"><span begin="01:59.550" end="02:19.995">It's </span><span begin="02:19.995" end="02:40.440">it</span></p><p ttm:agent="v1" begin="02:44.730" end="02:48.450"><span begin="02:44.730" end="02:45.480">What </span><span begin="02:45.480" end="02:48.030">is </span><span begin="02:48.030" end="02:48.270">it</span><span begin="02:48.270" end="02:48.310">? </span><span begin="02:48.310" end="02:48.350">.</span><span begin="02:48.350" end="02:48.390">.</span><span begin="02:48.390" end="02:48.450">.</span></p><p ttm:agent="v1" begin="02:48.450" end="02:49.530"><span begin="02:48.450" end="02:48.840">It's </span><span begin="02:48.840" end="02:49.530">it</span></p><p ttm:agent="v1" begin="02:50.940" end="02:52.980"><span begin="02:50.940" end="02:51.300">What </span><span begin="02:51.300" end="02:51.570">is </span><span begin="02:51.570" end="02:52.110">it</span><span begin="02:52.110" end="02:52.320">? </span><span begin="02:52.320" end="02:52.530">.</span><span begin="02:52.530" end="02:52.740">.</span><span begin="02:52.740" end="02:52.980">.</span></p><p ttm:agent="v1" begin="02:52.980" end="02:53.670"><span begin="02:52.980" end="02:53.325">It's </span><span begin="02:53.325" end="02:53.670">it</span></p><p ttm:agent="v1" begin="02:53.700" end="02:55.740"><span begin="02:53.700" end="02:54.000">What </span><span begin="02:54.000" end="02:54.330">is </span><span begin="02:54.330" end="02:54.750">it</span><span begin="02:54.750" end="02:54.990">? </span><span begin="02:54.990" end="02:55.230">.</span><span begin="02:55.230" end="02:55.470">.</span><span begin="02:55.470" end="02:55.740">.</span></p><p ttm:agent="v1" begin="02:55.740" end="03:02.940"><span begin="02:55.740" end="02:56.820">You </span><span begin="02:56.820" end="02:57.990">want </span><span begin="02:57.990" end="02:58.350">it </span><span begin="02:58.350" end="02:59.280">all </span><span begin="02:59.280" end="02:59.640">but </span><span begin="02:59.640" end="03:00.240">you </span><span begin="03:00.240" end="03:00.930">can't </span><span begin="03:00.930" end="03:01.950">have </span><span begin="03:01.950" end="03:02.940">it</span></p><p ttm:agent="v1" begin="03:06.840" end="03:23.940"><span begin="03:06.840" end="03:07.980">It's </span><span begin="03:07.980" end="03:08.880">in </span><span begin="03:08.880" end="03:09.210">your </span><span begin="03:09.210" end="03:10.320">face </span><span begin="03:10.320" end="03:10.680">but </span><span begin="03:10.680" end="03:11.250">you </span><span begin="03:11.250" end="03:12.030">can't </span><span begin="03:12.030" end="03:23.670">grab </span><span begin="03:23.670" end="03:23.940">it</span></p></div></body></tt>