<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Something I Need</ttm:title><ttm:agent type="person" xml:id="v1">OneRepublic</ttm:agent><ttm:item type="album">Native</ttm:item><ttm:item type="spotify_id">5aIZ2jtxZ4o4GHQXTybkIa</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.630" end="00:03.990"><span begin="00:00.630" end="00:00.900">I </span><span begin="00:00.900" end="00:01.260">had </span><span begin="00:01.260" end="00:01.320">a </span><span begin="00:01.320" end="00:01.830">dream </span><span begin="00:01.830" end="00:02.130">the </span><span begin="00:02.130" end="00:02.370">other </span><span begin="00:02.370" end="00:03.990">night</span></p><p ttm:agent="v1" begin="00:05.280" end="00:09.300"><span begin="00:05.280" end="00:05.730">About </span><span begin="00:05.730" end="00:06.000">how </span><span begin="00:06.000" end="00:06.300">we </span><span begin="00:06.300" end="00:06.960">only </span><span begin="00:06.960" end="00:07.290">get </span><span begin="00:07.290" end="00:07.830">one </span><span begin="00:07.830" end="00:09.300">life</span></p><p ttm:agent="v1" begin="00:10.410" end="00:12.960"><span begin="00:10.410" end="00:10.950">Woke </span><span begin="00:10.950" end="00:11.280">me </span><span begin="00:11.280" end="00:11.610">up </span><span begin="00:11.610" end="00:11.910">right </span><span begin="00:11.910" end="00:12.300">after </span><span begin="00:12.300" end="00:12.960">two</span></p><p ttm:agent="v1" begin="00:13.170" end="00:15.420"><span begin="00:13.170" end="00:13.590">Stayed </span><span begin="00:13.590" end="00:14.040">awake </span><span begin="00:14.040" end="00:14.190">and </span><span begin="00:14.190" end="00:14.790">stared </span><span begin="00:14.790" end="00:15.000">at </span><span begin="00:15.000" end="00:15.420">you</span></p><p ttm:agent="v1" begin="00:15.600" end="00:19.020"><span begin="00:15.600" end="00:15.930">So </span><span begin="00:15.930" end="00:16.050">I </span><span begin="00:16.050" end="00:16.410">wouldn't </span><span begin="00:16.410" end="00:17.190">lose </span><span begin="00:17.190" end="00:17.340">my </span><span begin="00:17.340" end="00:19.020">mind</span></p><p ttm:agent="v1" begin="00:19.890" end="00:23.400"><span begin="00:19.890" end="00:20.130">And </span><span begin="00:20.130" end="00:20.280">I </span><span begin="00:20.280" end="00:20.640">had </span><span begin="00:20.640" end="00:20.790">the </span><span begin="00:20.790" end="00:21.210">week </span><span begin="00:21.210" end="00:21.390">that </span><span begin="00:21.390" end="00:21.810">came </span><span begin="00:21.810" end="00:22.110">from </span><span begin="00:22.110" end="00:23.400">hell</span></p><p ttm:agent="v1" begin="00:24.810" end="00:28.530"><span begin="00:24.810" end="00:25.140">And </span><span begin="00:25.140" end="00:25.560">yes </span><span begin="00:25.560" end="00:25.710">I </span><span begin="00:25.710" end="00:26.370">know </span><span begin="00:26.370" end="00:26.640">that </span><span begin="00:26.640" end="00:26.760">you </span><span begin="00:26.760" end="00:26.940">can </span><span begin="00:26.940" end="00:28.530">tell</span></p><p ttm:agent="v1" begin="00:29.490" end="00:32.340"><span begin="00:29.490" end="00:29.760">But </span><span begin="00:29.760" end="00:29.970">you're </span><span begin="00:29.970" end="00:30.270">like </spa