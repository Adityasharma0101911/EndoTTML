<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Moving to New York</ttm:title><ttm:agent type="person" xml:id="v1">The Wombats</ttm:agent><ttm:item type="album">Proudly Present... A Guide to Love, Loss &amp; Desperation</ttm:item><ttm:item type="spotify_id">7GvkOFkNsM6Exnkyqeajqm</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.000" end="00:28.980"><span begin="00:00.000" end="00:23.670"> </span><span begin="00:23.670" end="00:24.360">I've </span><span begin="00:24.360" end="00:24.990">just </span><span begin="00:24.990" end="00:26.040">had </span><span begin="00:26.040" end="00:26.220"> </span><span begin="00:26.220" end="00:26.430">the </span><span begin="00:26.430" end="00:27.930">craziest </span><span begin="00:27.930" end="00:28.830">week</span><span begin="00:28.830" end="00:28.980">,</span></p><p ttm:agent="v1" begin="00:28.980" end="00:34.590"><span begin="00:28.980" end="00:29.400">Like </span><span begin="00:29.400" end="00:29.460">a </span><span begin="00:29.460" end="00:30.840">party </span><span begin="00:30.840" end="00:31.470">bag </span><span begin="00:31.470" end="00:31.560">of </span><span begin="00:31.560" end="00:32.280">lies</span><span begin="00:32.280" end="00:32.430">, </span><span begin="00:32.430" end="00:32.970">booze </span><span begin="00:32.970" end="00:33.090">and </span><span begin="00:33.090" end="00:33.420">then </span><span begin="00:33.420" end="00:34.500">deceit</span><span begin="00:34.500" end="00:34.590">.</span></p><p ttm:agent="v1" begin="00:34.590" end="00:41.520"><span begin="00:34.590" end="00:34.980">And </span><span begin="00:34.980" end="00:35.220">I </span><span begin="00:35.220" end="00:36.150">don't </span><span begin="00:36.150" end="00:36.660">know </span><span begin="00:36.660" end="00:37.380">why </span><span begin="00:37.380" end="00:37.470">I </span><span begin="00:37.470" end="00:37.980">want </span><span begin="00:37.980" end="00:38.160">to </span><span begin="00:38.160" end="00:38.400"> </span><span begin="00:38.400" end="00:39.210">voice </span><span begin="00:39.210" end="00:39.510">this </span><span begin="00:39.510" end="00:39.780">out </span><span begin="00:39.780" end="00:40.740">loud</span><span begin="00:40.740" end="00:41.520">,</span></p><p ttm:agent="v1" begin="00:41.520" end="00:46.710"><span begin="00:41.520" end="00:41.790">It's </span><span begin="00:41.790" end="00:42.630">theraputic </span><span begin="00:42.630" end="00:43.890">somehow</span><span begin="00:43.890" end="00:46.710">.</span></p><p ttm:agent="v1" begin="00:46.710" end="00:49.200"><span begin="00:46.710" end="00:47.130">So </span><span begin="00:47.130" end="00:47.340">I'm </span><span begin="00:47.340" end="00:48.060">moving </span><span begin="00:48.060" end="00:48.270">to </span><span begin="00:48.270" end="00:48.600">New </span><span begin="00:48.600" end="00:49.170">York</span></p><p ttm:agent="v1" begin="00:49.200" end="00:52.320"><span begin="00:49.200" end="00:49.500">Cos </span><span begin="00:49.500" end="00:49.770">I've </span><span begin="00:49.770" end="00:50.220">got </span><span begin="00:50.220" end="00:51.060">problems </span><span begin="00:51.060" end="00:51.240">with </span><span begin="00:51.240" end="00:51.540">my </span><span begin="00:51.540" end="00:52.290">sleep</span><span begin="00:52.290" end="00:52.320">,</span></p><p ttm:agent="v1" begin="00:52.320" end="00:55.440"><span begin="00:52.320" end="00:52.830">And </span><span begin="00:52.830" end="00:53.040">we're </span><span begin="00:53.040" end="00:54.210">not </span><span begin="00:54.210" end="00:54.450">the </span><span begin="00:54.450" end="00:55.230">same </span><span begin="00:55.230" end="00:55.440">and</span></p><p ttm:agent="v1" begin="00:55.440" end="00:58.470"><span begin="00:55.440" end="00:55.650">I </span><span begin="00:55.650" end="00:56.010">will </span><span begin="00:56.010" end="00:56.400">wear </span><span begin="00:56.400" end="00:56.790">that </span><span begin="00:56.790" end="00:57.090">on </span><span begin="00:57.090" end="00:57.390">my </span><span begin="00:57.390" end="00:58.200">sleeve</span><span begin="00:58.200" end="00:58.470">.</span></p><p ttm:agent="v1" begin="00:58.470" end="01:01.020"><span begin="00:58.470" end="00:58.890">So </span><span begin="00:58.890" end="00:59.100">I'm </span><span begin="00:59.100" end="00:59.850">moving </span><span begin="00:59.850" end="01:00.060">to </span><span begin="01:00.060" end="01:00.390">New </span><span begin="01:00.390" end="01:00.990">York</span></p><p ttm:agent="v1" begin="01:01.020" end="01:04.470"><span begin="01:01.020" end="01:01.290">Cos </span><span begin="01:01.290" end="01:01.560">I've </span><span begin="01:01.560" end="01:02.040">got </span><span begin="01:02.040" end="01:02.670">issues </span><span begin="01:02.670" end="01:02.850"> </span><span begin="01:02.850" end="01:03.000">with </span><span begin="01:03.000" end="01:03.270">my </span><span begin="01:03.270" end="01:04.140">sleep</span><span begin="01:04.140" end="01:04.470">,</span></p><p ttm:agent="v1" begin="01:04.470" end="01:07.860"><span begin="01:04.470" end="01:04.740">Looks </span><span begin="01:04.740" end="01:04.980">like </span><span begin="01:04.980" end="01:05.940">Christmas </span><span begin="01:05.940" end="01:06.450">came </span><span begin="01:06.450" end="01:07.500">early</span><span begin="01:07.500" end="01:07.860">,</span></p><p ttm:agent="v1" begin="01:07.860" end="01:16.470"><span begin="01:07.860" end="01:08.940">Christmas </span><span begin="01:08.940" end="01:09.600">came </span><span begin="01:09.600" end="01:09.660"> </span><span begin="01:09.660" end="01:10.500">early </span><span begin="01:10.500" end="01:10.530"> </span><span begin="01:10.530" end="01:10.980">for </span><span begin="01:10.980" end="01:12.000">me</span><span begin="01:12.000" end="01:16.470">.</span></p><p ttm:agent="v1" begin="01:16.470" end="01:21.900"><span begin="01:16.470" end="01:16.650">I </span><span begin="01:16.650" end="01:17.010">put </span><span begin="01:17.010" end="01:17.700">one </span><span begin="01:17.700" end="01:18.240">foot </span><span begin="01:18.240" end="01:18.990">forward </span><span begin="01:18.990" end="01:19.170">and </span><span begin="01:19.170" end="01:19.560">ended </span><span begin="01:19.560" end="01:19.860">up </span><span begin="01:19.860" end="01:19.890"> </span><span begin="01:19.890" end="01:20.490">thirty </span><span begin="01:20.490" end="01:21.240">yards </span><span begin="01:21.240" end="01:21.750">back</span><span begin="01:21.750" end="01:21.900">.</span></p><p ttm:agent="v1" begin="01:21.900" end="01:28.320"><span begin="01:21.900" end="01:22.140">And </span><span begin="01:22.140" end="01:22.470">am </span><span begin="01:22.470" end="01:22.830">I </span><span begin="01:22.830" end="01:24.180">losing </span><span begin="01:24.180" end="01:24.720">touch </span><span begin="01:24.720" end="01:24.870">or </span><span begin="01:24.870" end="01:25.050">am </span><span begin="01:25.050" end="01:25.320">I </span><span begin="01:25.320" end="01:25.620">just </span><span begin="01:25.620" end="01:25.740"> </span><span begin="01:25.740" end="01:26.490">completely </span><span begin="01:26.490" end="01:26.910">off </span><span begin="01:26.910" end="01:27.060">the </span><span begin="01:27.060" end="01:28.080">track</span><span begin="01:28.080" end="01:28.320">?</span></p><p ttm:agent="v1" begin="01:28.320" end="01:34.860"><span begin="01:28.320" end="01:28.440">And </span><span begin="01:28.440" end="01:28.590">I </span><span begin="01:28.590" end="01:29.520">don't </span><span begin="01:29.520" end="01:30.060">know </span><span begin="01:30.060" end="01:30.810">why </span><span begin="01:30.810" end="01:30.870">I </span><span begin="01:30.870" end="01:31.380">want </span><span begin="01:31.380" end="01:31.740">to </span><span begin="01:31.740" end="01:31.770"> </span><span begin="01:31.770" end="01:32.580">voice </span><span begin="01:32.580" end="01:32.880">this </span><span begin="01:32.880" end="01:33.150">out </span><span begin="01:33.150" end="01:34.320">loud</span><span begin="01:34.320" end="01:34.860">,</span></p><p ttm:agent="v1" begin="01:34.860" end="01:40.050"><span begin="01:34.860" end="01:35.130">It's </span><span begin="01:35.130" end="01:35.970">theraputic </span><span begin="01:35.970" end="01:37.320">somehow</span><span begin="01:37.320" end="01:40.050">.</span></p><p ttm:agent="v1" begin="01:40.050" end="01:42.540"><span begin="01:40.050" end="01:40.440">So </span><span begin="01:40.440" end="01:40.680">I'm </span><span begin="01:40.680" end="01:41.400">moving </span><span begin="01:41.400" end="01:41.610">to </span><span begin="01:41.610" end="01:41.940">New </span><span begin="01:41.940" end="01:42.510">York</span></p><p ttm:agent="v1" begin="01:42.540" end="01:45.990"><span begin="01:42.540" end="01:42.840">Cos </span><span begin="01:42.840" end="01:43.110">I've </span><span begin="01:43.110" end="01:43.560">got </span><span begin="01:43.560" end="01:44.400">problems </span><span begin="01:44.400" end="01:44.550">with </span><span begin="01:44.550" end="01:44.820">my </span><span begin="01:44.820" end="01:45.540">sleep</span><span begin="01:45.540" end="01:45.990">,</span></p><p ttm:agent="v1" begin="01:45.990" end="01:48.720"><span begin="01:45.990" end="01:46.140">And </span><span begin="01:46.140" end="01:46.320">we're </span><span begin="01:46.320" end="01:47.460">not </span><span begin="01:47.460" end="01:47.760">the </span><span begin="01:47.760" end="01:48.540">same </span><span begin="01:48.540" end="01:48.720">and</span></p><p ttm:agent="v1" begin="01:48.720" end="01:51.840"><span begin="01:48.720" end="01:48.960">I </span><span begin="01:48.960" end="01:49.350">will </span><span begin="01:49.350" end="01:49.740">wear </span><span begin="01:49.740" end="01:49.890">that </span><span begin="01:49.890" end="01:50.400">on </span><span begin="01:50.400" end="01:50.700">my </span><span begin="01:50.700" end="01:51.570">sleeve</span><span begin="01:51.570" end="01:51.840">.</span></p><p ttm:agent="v1" begin="01:51.840" end="01:54.270"><span begin="01:51.840" end="01:52.230">So </span><span begin="01:52.230" end="01:52.440">I'm </span><span begin="01:52.440" end="01:53.130">moving </span><span begin="01:53.130" end="01:53.340">to </span><span begin="01:53.340" end="01:53.670">New </span><span begin="01:53.670" end="01:54.240">York</span></p><p ttm:agent="v1" begin="01:54.270" end="01:57.780"><span begin="01:54.270" end="01:54.570">Cos </span><span begin="01:54.570" end="01:54.840">I've </span><span begin="01:54.840" end="01:55.290">got </span><span begin="01:55.290" end="01:55.980">issues </span><span begin="01:55.980" end="01:56.130"> </span><span begin="01:56.130" end="01:56.310">with </span><span begin="01:56.310" end="01:56.580">my </span><span begin="01:56.580" end="01:57.420">sleep</span><span begin="01:57.420" end="01:57.780">,</span></p><p ttm:agent="v1" begin="01:57.780" end="02:01.200"><span begin="01:57.780" end="01:58.020">Looks </span><span begin="01:58.020" end="01:58.290">like </span><span begin="01:58.290" end="01:59.280">Christmas </span><span begin="01:59.280" end="01:59.790">came </span><span begin="01:59.790" end="02:00.840">early</span><span begin="02:00.840" end="02:01.200">,</span></p><p ttm:agent="v1" begin="02:01.200" end="02:33.720"><span begin="02:01.200" end="02:02.310">Christmas </span><span begin="02:02.310" end="02:02.940">came </span><span begin="02:02.940" end="02:03.060"> </span><span begin="02:03.060" end="02:03.840">early </span><span begin="02:03.840" end="02:03.870"> </span><span begin="02:03.870" end="02:04.320">for </span><span begin="02:04.320" end="02:05.370">me</span><span begin="02:05.370" end="02:33.720">.</span></p><p ttm:agent="v1" begin="02:33.720" end="02:36.450"><span begin="02:33.720" end="02:34.350">So </span><span begin="02:34.350" end="02:34.620">I'm </span><span begin="02:34.620" end="02:35.310">moving </span><span begin="02:35.310" end="02:35.550">to </span><span begin="02:35.550" end="02:35.850">New </span><span begin="02:35.850" end="02:36.420">York</span></p><p ttm:agent="v1" begin="02:36.450" end="02:39.600"><span begin="02:36.450" end="02:36.750">Cos </span><span begin="02:36.750" end="02:36.990">I've </span><span begin="02:36.990" end="02:37.470">got </span><span begin="02:37.470" end="02:38.310">problems </span><span begin="02:38.310" end="02:38.460">with </span><span begin="02:38.460" end="02:38.760">my </span><span begin="02:38.760" end="02:39.600">sleep</span><span begin="02:39.600" end="02:39.600">,</span></p><p ttm:agent="v1" begin="02:39.600" end="02:42.660"><span begin="02:39.600" end="02:40.050">And </span><span begin="02:40.050" end="02:40.260">we're </span><span begin="02:40.260" end="02:41.400">not </span><span begin="02:41.400" end="02:41.700">the </span><span begin="02:41.700" end="02:42.480">same </span><span begin="02:42.480" end="02:42.660">and</span></p><p ttm:agent="v1" begin="02:42.660" end="02:45.750"><span begin="02:42.660" end="02:42.900">I </span><span begin="02:42.900" end="02:43.260">will </span><span begin="02:43.260" end="02:43.590">wear </span><span begin="02:43.590" end="02:43.770">that </span><span begin="02:43.770" end="02:44.370">on </span><span begin="02:44.370" end="02: