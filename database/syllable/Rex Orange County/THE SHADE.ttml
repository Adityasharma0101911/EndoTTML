<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>THE SHADE</ttm:title><ttm:agent type="person" xml:id="v1">Rex Orange County</ttm:agent><ttm:item type="album">WHO CARES?</ttm:item><ttm:item type="spotify_id">1gH1h30wkQdd9zhY3j7a8T</ttm:item><itunes:duration>03:01.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:17.329" end="00:18.870"><span begin="00:17.329" end="00:17.465">I </span><span begin="00:17.465" end="00:17.671">was </span><span begin="00:17.671" end="00:17.863">closing </span><span begin="00:17.863" end="00:18.079">all </span><span begin="00:18.079" end="00:18.518">the </span><span begin="00:18.518" end="00:18.870">blinds</span></p><p ttm:agent="v1" begin="00:19.333" end="00:23.789"><span begin="00:19.333" end="00:19.589">Just </span><span begin="00:19.589" end="00:19.904">so </span><span begin="00:19.904" end="00:20.173">you </span><span begin="00:20.173" end="00:20.554">could </span><span begin="00:20.554" end="00:20.989">sleep </span><span begin="00:20.989" end="00:21.309">the </span><span begin="00:21.309" end="00:21.805">night </span><span begin="00:21.805" end="00:23.789">through</span></p><p ttm:agent="v1" begin="00:25.270" end="00:27.057"><span begin="00:25.270" end="00:25.454">I </span><span begin="00:25.454" end="00:25.733">was </span><span begin="00:25.733" end="00:26.030">staying </span><span begin="00:26.030" end="00:26.213">by </span><span begin="00:26.213" end="00:26.661">your </span><span begin="00:26.661" end="00:27.057">side</span></p><p ttm:agent="v1" begin="00:27.333" end="00:31.725"><span begin="00:27.333" end="00:27.637">Just </span><span begin="00:27.637" end="00:28.013">so </span><span begin="00:28.013" end="00:28.232">I </span><span begin="00:28.232" end="00:28.677">knew </span><span begin="00:28.677" end="00:29.124">you </span><span begin="00:29.124" end="00:29.397">were </span><span begin="00:29.397" end="00:31.725">okay</span></p><p ttm:agent="v1" begin="00:33.229" end="00:35.101"><span begin="00:33.229" end="00:33.373">And </span><span begin="00:33.373" end="00:33.509">I </span><span begin="00:33.509" end="00:33.781">was </span><span begin="00:33.781" end="00:34.167">opening </span><span begin="00:34.167" end="00:34.525">the </span><span begin="00:34.525" end="00:35.101">door</span></p><p ttm:agent="v1" begin="00:35.341" end="00:40.126"><span begin="00:35.341" end="00:35.616">Just </span><span begin="00:35.616" end="00:36.085">to </span><span begin="00:36.085" end="00:36.349">see </span><span begin="00:36.349" end="00:36.677">if </span><span begin="00:36.677" end="00:37.037">you </span><span begin="00:37.037" end="00:37.448">would </span><span begin="00:37.448" end="00:37.933">walk </span><span begin="00:37.933" end="00:40.126">through</span></p><p ttm:agent="v1" begin="00:41.245" end="00:43.220"><span begin="00:41.245" end="00:41.390">I </span><span begin="00:41.390" end="00:41.686">started </span><span begin="00:41.686" end="00:42.085">painting </span><span begin="00:42.085" end="00:42.262">all </span><span begin="00:42.262" end="00:42.653">the </span><span begin="00:42.653" end="00:43.220">walls</span></p><p ttm:agent="v1" begin="00:43.502" end="00:47.845"><span begin="00:43.502" end="00:43.725">Just </span><span begin="00:43.725" end="00:44.101">to </span><span begin="00:44.101" end="00:44.349">see </span><span begin="00:44.349" end="00:44.701">if </span><span begin="00:44.701" end="00:45.013">you </span><span begin="00:45.013" end="00:45.229">liked </span><span begin="00:45.229" end="00:45.797">the </span><span begin="00:45.797" end="00:47.845">shade</span></p><p ttm:agent="v1" begin="00:49.205" end="00:53.197"><span begin="00:49.205" end="00:49.357">I </span><span begin="00:49.357" end="00:49.565">would </span><span begin="00:49.565" end="00:49.997">love </span><span begin="00:49.997" end="00:50.277">just </span><span begin="00:50.277" end="00:50.557">to </span><span begin="00:50.557" end="00:51.325">be </span><span begin="00:51.590" end="00:51.893">stuck </span><span begin="00:51.893" end="00:52.108">to </span><span begin="00:52.108" end="00:52.493">your </span><span begin="00:52.493" end="00:53.197">side</span></p><p ttm:agent="v1" begin="00:53.472" end="00:56.856"><span begin="00:53.472" end="00:53.629">Not </span><span begin="00:53.629" end="00:53.861">with </span><span begin="00:53.861" end="00:54.621">anybody </span><span begin="00:54.621" end="00:55.237">else </span><span begin="00:55.485" end="00:56.405">anybody </span><span begin="00:56.405" end="00:56.856">else</span></p><p ttm:agent="v1" begin="00:57.187" end="01:00.963"><span begin="00:57.187" end="00:57.378">It's </span><span begin="00:57.378" end="00:57.612">enough </span><span begin="00:57.612" end="00:57.850">just </span><span begin="00:57.850" end="00:58.234">to </span><span begin="00:58.234" end="00:58.932">keep </span><span begin="00:59.410" end="00:59.929">us </span><span begin="00:59.929" end="01:00.963">occupied</span></p><p ttm:agent="v1" begin="01:00.963" end="01:03.675"><span begin="01:00.963" end="01:01.115">Please </span><span begin="01:01.115" end="01:01.530">don't </span><span begin="01:01.530" end="01:03.675">go</span></p><p ttm:agent="v1" begin="01:05.033" end="01:09.274"><span begin="01:05.033" end="01:05.242">I </span><span begin="01:05.242" end="01:05.547">would </span><span begin="01:05.547" end="01:05.763">love </span><span begin="01:05.763" end="01:05.985">just </span><span begin="01:05.985" end="01:06.220">to </span><span begin="01:06.220" end="01:07.140">be </span><span begin="01:07.506" end="01:07.731">stuck </span><span begin="01:07.731" end="01:07.958">to </span><span begin="01:07.958" end="01:08.469">your </span><span begin="01:08.469" end="01:09.274">side</span></p><p ttm:agent="v1" begin="01:09.463" end="01:13.235"><span begin="01:09.463" end="01:09.611">Not </span><span begin="01:09.611" end="01:09.786">with </span><span begin="01:09.786" end="01:10.611">anybody </span><span begin="01:10.611" end="01:11.274">else </span><span begin="01:11.506" end="01:12.651">anybody </span><span begin="01:12.651" end="01:13.235">else</span></p><p ttm:agent="v1" begin="01:13.339" end="01:16.810"><span begin="01:13.339" end="01:13.461">It's </span><span begin="01:13.461" end="01:13.722">enough </span><span begin="01:13.722" end="01:13.960">just </span><span begin="01:13.960" end="01:14.355">to </span><span begin="01:14.355" end="01:15.059">keep </span><span begin="01:15.473" end="01:16.002">us </span><span begin="01:16.002" end="01:16.810">occupied</span></p><p ttm:agent="v1" begin="01:17.026" end="01:19.378"><span begin="01:17.026" end="01:17.194">Please </span><span begin="01:17.194" end="01:17.635">don't </span><span begin="01:17.635" end="01:19.378">go</span></p><p ttm:agent="v1" begin="01:21.050" end="01:23.211"><span begin="01:21.050" end="01:21.292">You </span><span begin="01:21.292" end="01:21.668">were </span><span begin="01:21.668" end="01:21.989">holding </span><span begin="01:21.989" end="01:22.238">out </span><span begin="01:22.238" end="01:22.642">your </span><span begin="01:22.642" end="01:23.211">hand</span></p><p ttm:agent="v1" begin="01:23.498" end="01:27.290"><span begin="01:23.498" end="01:24.051">Hoping </span><span begin="01:24.051" end="01:24.258">I'd </span><span begin="01:24.258" end="01:24.659">be </span><span begin="01:24.659" end="01:25.108">therе </span><span begin="01:25.108" end="01:25.498">to </span><span begin="01:25.498" end="01:25.922">hold </span><span begin="01:25.922" end="01:27.290">too</span></p><p ttm:agent="v1" begin="01:29.260" end="01:31.186"><span begin="01:29.260" end="01:29.452">I </span><span begin="01:29.452" end="01:29.691">went </span><span begin="01:29.691" end="01:29.980">out </span><span begin="01:29.980" end="01:30.202">to </span><span begin="01:30.202" end="01:31.186">Amsterdam</span></p><p ttm:agent="v1" begin="01:31.450" end="01:35.771"><span begin="01:31.450" end="01:31.682">Just </span><span begin="01:31.682" end="01:32.033">so </span><span begin="01:32.033" end="01:32.402">I </span><span begin="01:32.402" end="01:32.674">could </span><span begin="01:32.674" end="01:33.013">give </span><span begin="01:33.013" end="01:33.378">you </span><span begin="01:33.378" end="01:33.818">somе </span><span begin="01:33.818" end="01:35.771">space</span></p><p ttm:agent="v1" begin="01:37.178" end="01:39.424"><span begin="01:37.178" end="01:37.355">Then </span><span begin="01:37.355" end="01:37.627">I </span><span begin="01:37.627" end="01:37.780">kept </span><span begin="01:37.780" end="01:38.020">opening </span><span begin="01:38.020" end="01:38.242">my </span><span begin="01:38.242" end="01:39.424">door</span></p><p ttm:agent="v1" begin="01:39.424" end="01:44.658"><span begin="01:39.424" end="01:39.641">Just </span><span begin="01:39.641" end="01:40.025">to </span><span begin="01:40.025" end="01:40.209">see </span><span begin="01:40.209" end="01:40.611">if </span><span begin="01:40.611" end="01:41.019">you </span><span begin="01:41.019" end="01:41.440">would </span><span begin="01:41.440" end="01:41.833">walk </span><span begin="01:41.833" end="01:44.658">through</span></p><p ttm:agent="v1" begin="01:44.979" end="01:47.187"><span begin="01:44.979" end="01:45.152">But </span><span begin="01:45.152" end="01:45.336">I </span><span begin="01:45.336" end="01:45.696">want </span><span begin="01:45.696" end="01:46.081">painting </span><span begin="01:46.081" end="01:46.266">all </span><span begin="01:46.266" end="01:46.672">my </span><span begin="01:46.672" end="01:47.187">walls</span></p><p ttm:agent="v1" begin="01:47.500" end="01:52.769"><span begin="01:47.500" end="01:47.713">Just </span><span begin="01:47.713" end="01:48.127">to </span><span begin="01:48.127" end="01:48.352">see </span><span begin="01:48.352" end="01:48.665">if </span><span begin="01:48.665" end="01:48.943">you </span><span begin="01:48.943" end="01:49.179">liked </span><span begin="01:49.179" end="01:49.680">the </span><span begin="01:49.680" end="01:52.769">shade</span></p><p ttm:agent="v1" begin="01:53.161" end="01:57.200"><span begin="01:53.161" end="01:53.344">I </span><span begin="01:53.344" end="01:53.537">would </span><span begin="01:53.537" end="01:53.970">love </span><span begin="01:53.970" end="01:54.242">just </span><span begin="01:54.242" end="01:54.505">to </span><span begin="01:54.505" end="01:55.152">be </span><span begin="01:55.528" end="01:55.785">stuck </span><span begin="01:55.785" end="01:56.016">to </span><span begin="01:56.016" end="01:56.521">your </span><span begin="01:56.521" end="01:57.200">side</span></p><p ttm:agent="v1" begin="01:57.446" end="02:01.042"><span begin="01:57.446" end="01:57.601">Not </span><span begin="01:57.601" end="01:57.791">with </span><span begin="01:57.791" end="01:58.578">anybody </span><span begin="01:58.578" end="01:59.320">else </span><span begin="01:59.576" end="02:00.584">anybody </span><span begin="02:00.584" end="02:01.042">else</span></p><p ttm:agent="v1" begin="02:01.240" end="02:04.795"><span begin="02:01.240" end="02:01.392">It's </span><span begin="02:01.392" end="02:01.736">enough </span><span begin="02:01.736" end="02:02.118">just </span><span begin="02:02.118" end="02:02.481">to </span><span begin="02:02.481" end="02:03.107">keep </span><span begin="02:03.476" end="02:03.967">us </span><span begin="02:03.967" end="02:04.795">occupied</s