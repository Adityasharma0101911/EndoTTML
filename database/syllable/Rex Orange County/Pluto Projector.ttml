p ttm:agent="v1" begin="03:05.580" end="03:11.550"><span begin="03:05.580" end="03:06.180">Old </span><span begin="03:06.180" end="03:06.900">enough </span><span begin="03:06.900" end="03:07.200">to </span><span begin="03:07.200" end="03:11.550">understand</span></p><p ttm:agent="v1" begin="03:20.250" end="03:28.260"><span begin="03:20.250" end="03:21.000">Old </span><span begin="03:21.000" end="03:21.630">enough </span><span begin="03:21.630" end="03:21.990">to </span><span begin="03:21.990" end="03:28.260">understand</span></p><p ttm:agent="v1" begin="03:56.400" end="04:07.500"><span begin="03:56.400" end="03:56.940">Stay </span><span begin="03:56.940" end="03:58.320">forever</span><span begin="03:58.320" end="03:58.710">, </span><span begin="03:58.710" end="03:59.220">you </span><span begin="03:59.220" end="03:59.550">know </span><span begin="03:59.550" end="03:59.970">more </span><span begin="03:59.970" end="04:00.420">than </span><span begin="04:00.420" end="04:04.260">anyone </span><span begin="04:04.260" end="04:04.620">（</span><span begin="04:04.620" end="04:05.580">Yeah</span><span begin="04:05.580" end="04:06.030">, </span><span begin="04:06.030" end="04:07.380">woah</span><span begin="04:07.380" end="04:07.500">）</span></p><p ttm:agent="v1" begin="04:07.500" end="04:10.560"><span begin="04:07.500" end="04:07.800">And </span><span begin="04:07.800" end="04:08.070">it's </span><span begin="04:08.070" end="04:08.400">you </span><span begin="04:08.400" end="04:08.640">that </span><span begin="04:08.640" end="04:09.060">knows </span><span begin="04:09.060" end="04:09.480">my </span><span begin="04:09.480" end="04:10.560">darkness</span></p><p ttm:agent="v1" begin="04:10.650" end="04:13.770"><span begin="04:10.650" end="04:10.890">And </span><span begin="04:10.890" end="04:11.070">you </span><span begin="04:11.070" end="04:11.430">know </span><span begin="04:11.430" end="04:11.790">my </span><span begin="04:11.790" end="04:12.480">bedroom </span><span begin="04:12.480" end="04:13.770">needs</span></p><p ttm:agent="v1" begin="04:13.770" end="04:16.650"><span begin="04:13.770" end="04:13.890">You </span><span begin="04:13.890" end="04:14.130">could </span><span begin="04:14.130" end="04:14.700">blast </span><span begin="04:14.700" end="04:14.970">me </span><span begin="04:14.970" end="04:15.090">and </span><span begin="04:15.090" end="04:15.540">my </span><span begin="04:15.540" end="04:16.650">secrets</span></p><p ttm:agent="v1" begin="04:16.680" end="04:20.370"><span begin="04:16.680" end="04:17.295">Because </span><span begin="04:17.295" end="04:17.910">there's </span><span begin="04:17.910" end="04:18.525">probably </span><span begin="04:18.525" end="04:19.140">just </span><span begin="04:19.140" end="04:19.755">no </span><span begin="04:19.755" end="04:20.370">need</span></p></div></body></tt>