.630">having </span><span begin="02:00.630" end="02:00.720">a </span><span begin="02:00.720" end="02:01.350">sing</span></p><p ttm:agent="v1" begin="02:01.350" end="02:05.910"><span begin="02:01.350" end="02:01.500">I'll </span><span begin="02:01.500" end="02:01.710">be </span><span begin="02:01.710" end="02:02.310">here </span><span begin="02:02.310" end="02:03.390">waiting </span><span begin="02:03.390" end="02:03.750">ever </span><span begin="02:03.750" end="02:04.020">so </span><span begin="02:04.020" end="02:04.920">patiently </span><span begin="02:04.920" end="02:05.340">for </span><span begin="02:05.340" end="02:05.520">you </span><span begin="02:05.520" end="02:05.910">to</span></p><p ttm:agent="v1" begin="02:05.910" end="02:10.140"><span begin="02:05.910" end="02:06.930">Snap</span><span begin="02:06.930" end="02:06.960">, </span><span begin="02:06.960" end="02:07.830">out</span><span begin="02:07.830" end="02:07.890">, </span><span begin="02:07.890" end="02:08.790">of</span><span begin="02:08.790" end="02:08.850">, </span><span begin="02:08.850" end="02:10.140">it</span><span begin="02:10.140" end="02:10.140">.</span></p><p ttm:agent="v1" begin="02:10.140" end="02:14.490"><span begin="02:10.140" end="02:10.800">Under </span><span begin="02:10.800" end="02:10.920">a </span><span begin="02:10.920" end="02:11.610">spell </span><span begin="02:11.610" end="02:12.210">you're </span><span begin="02:12.210" end="02:14.490">hypnotized</span></p><p ttm:agent="v1" begin="02:17.130" end="02:24.480"><span begin="02:17.130" end="02:18.030">Darling </span><span begin="02:18.030" end="02:18.510">how </span><span begin="02:18.510" end="02:18.990">could </span><span begin="02:18.990" end="02:19.470">you </span><span begin="02:19.470" end="02:19.740">be </span><span begin="02:19.740" end="02:20.760">so </span><span begin="02:20.760" end="02:22.080">blind</span><span begin="02:22.080" end="02:24.480">?</span></p><p ttm:agent="v1" begin="02:24.480" end="02:29.430"><span begin