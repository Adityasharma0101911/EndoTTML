/span><span begin="00:15.900" end="00:16.590">hoe</span></p><p ttm:agent="v1" begin="00:16.620" end="00:17.640"><span begin="00:16.620" end="00:16.830">Flo </span><span begin="00:16.830" end="00:17.100">Milli </span><span begin="00:17.100" end="00:17.640">shit</span></p><p ttm:agent="v1" begin="00:17.670" end="00:19.980"><span begin="00:17.670" end="00:18.120">Yeah</span><span begin="00:18.120" end="00:18.190">, </span><span begin="00:18.190" end="00:18.260">*</span><span begin="00:18.260" end="00:18.330">*</span><span begin="00:18.330" end="00:18.400">*</span><span begin="00:18.400" end="00:18.480">*</span><span begin="00:18.480" end="00:18.540">s </span><span begin="00:18.540" end="00:18.720">up </span><span begin="00:18.720" end="00:18.930">when </span><span begin="00:18.930" end="00:19.020">I </span><span begin="00:19.020" end="00:19.230">step </span><span begin="00:19.230" end="00:19.290">up </span><span begin="00:19.290" end="00:19.380">in </span><span begin="00:19.380" end="00:19.470">the </span><span begin="00:19.470" end="00:19.890">party </span><span begin="00:19.890" end="00:19.920">（</span><span begin="00:19.920" end="00:19.980">hey</span><span begin="00:19.980" end="00:19.980">）</span></p><p ttm:agent="v1" begin="00:19.980" end="00:21.690"><span begin="00:19.980" end="00:20.100">Yo </span><span begin="00:20.100" end="00:20.280">main </span><span begin="00:20.280" end="00:20.550">dude </span><span begin="00:20.550" end="00:20.820">wanna </span><span begin="00:20.820" end="00:21.030">feel </span><span begin="00:21.030" end="00:21.150">on </span><span begin="00:21.150" end="00:21.270">my </span><span begin="00:21.270" end="00:21.600">body </span><span begin="00:21.600" end="00:21.600">（</span><span begin="00:21.600" end="00:21.630">he </span><span begin="00:21.630" end="00:21.690">do</span><span begin="00:21.690" end="00:21.690">）</span></p><p ttm:agent="v1" begin="00:21.690" end="00:22.320"><span begin="00:21.690" end="00:21.795">And </span><span begin="00:21.795" end="00:21.900">if </span><span begin="00:21.900" end="00:22.005">I </span><span begin="00:22.005" end="00:22.110">take </span><span begin="00:22.110" end="00:22.215">I </span><span begin="00:22.215" end="00:22.320">him</span></p><p ttm:agent="v1" begin="00:22.320" end="00:23.550"><span begin="00:22.320" end="00:22.350">*</span><span begin="00:22.350" end="00:22.380">*</span><span begin="00:22.380" end="00:22.410">*</span><span begin="00:22.410" end="00:22.440">*</span><span begin="00:22.440" end="00:22.470">*</span><span begin="00:22.470" end="00:22.530">, </span><span begin="00:22.530" end="00:22.620">I </span><span begin="00:22.620" end="00:22.800">won't </span><span begin="00:22.800" end="00:22.920">say </span><span begin="00:22.920" end="00:23.040">I'm </span><span begin="00:23.040" end="00:23.400">sorry </span><span begin="00:23.400" end="00:23.400">（</span><span begin="00:23.400" end="00:23.490">hell </span><span begin="00:23.490" end="00:23.550">nah</span><span begin="00:23.550" end="00:23.550">）</span></p><p ttm:agent="v1" begin="00:23.550" end="00:24.180"><span begin="00:23.550" end="00:23.580">I </span><span begin="00:23.580" end="00:23.670">do </span><span begin="00:23.670" end="00:23.850">what </span><span begin="00:23.850" end="00:23.940">I </span><span begin="00:23.940" end="00:24.180">want</span></p><p ttm:agent="v1" begin="00:24.180" end="00:25.560"><span begin="00:24.180" end="00:24.270">Don't </span><span begin="00:24.270" end="00:24.600">report </span><span begin="00:24.600" end="00:24.720">to </span><span begin="00:24.720" end="00:25.230">nobody </span><span begin="00:25.230" end="00:25.230">（</span><span begin="00:25.230" end="00:25.560">huh</span><span begin="00:25.560" end="00:25.560">）</span></p><p ttm:agent="v1" begin="00:25.560" end="00:26.430"><span begin="00:25.560" end="00:25.650">I'm </span><span begin="00:25.650" end="00:25.740">a </span><span begin="00:25.740" end="00:26.070">bad </span><span begin="00:26.070" end="00:26.140">*</span><span begin="00:26.140" end="00:26.210">*</span><span begin="00:26.210" end="00:26.280">*</span><span begin="00:26.280" end="00:26.350">*</span><span begin="00:26.350" end="00:26.430">*</span></p><p ttm:agent="v1" begin="00:26.430" end="00:27.300"><span begin="00:26.430" end="00:26.700">Don't </span><span begin="00:26.700" end="00:26.820">let </span><span begin="00:26.820" end="00:26.910">'em </span><span begin="00:26.910" end="00:27.090">tell </span><span begin="00:27.090" end="00:27.180">you </span><span begin="00:27.180" end="00:27.180">（</span><span begin="00:27.180" end="00:27.300">what</span><span begin="00:27.300" end="00:27.300">）</span></p><p ttm:agent="v1" begin="00:27.300" end="00:28.200"><span begin="00:27.300" end="00:27.390">That </span><span begin="00:27.390" end="00:27.570">I'm </span><span begin="00:27.570" end="00:28.080">average </span><span begin="00:28.080" end="00:28.080">（</span><span begin="00:28.080" end="00:28.140">yea</span><span begin="00:28.140" end="00:28.200">）</span></p><p ttm:agent="v1" begin="00:28.200" end="00:29.910"><span begin="00:28.200" end="00:28.440">Ex </span><span begin="00:28.440" end="00:28.650">dude </span><span begin="00:28.650" end="00:28.860">mad </span><span begin="00:28.860" end="00:29.010">'cause </span><span begin="00:29.010" end="00:29.040">he </span><span begin="00:29.040" end="00:29.340">can't </span><span begin="00:29.340" end="00:29.640">have </span><span begin="00:29.640" end="00:29.730">it </span><span begin="00:29.730" end="00:29.730">（</span><span begin="00:29.730" end="00:29.910">yea</span><span begin="00:29.910" end="00:29.910">）</span></p><p ttm:agent="v1" begin="00:29.910" end="00:30.570"><span begin="00:29.910" end="00:29.976">He </span><span begin="00:29.976" end="00:30.042">think </span><span begin="00:30.042" end="00:30.108">I </span><span begin="00:30.108" end="00:30.174">miss </span><span begin="00:30.174" end="00:30.240">him </span><span begin="00:30.240" end="00:30.306">（</span><span begin="00:30.306" end="00:30.372">yea</span><span begin="00:30.372" end="00:30.438">, </span><span begin="00:30.438" end="00:30.504">yea</span><span begin="00:30.504" end="00:30.570">）</span></p><p ttm:agent="v1" begin="00:30.570" end="00:31.680"><span begin="00:30.570" end="00:30.660">Don't </span><span begin="00:30.660" end="00:30.810">want </span><span begin="00:30.810" end="00:30.930">him </span><span begin="00:30.930" end="00:31.020">a </span><span begin="00:31.020" end="00:31.380">tad </span><span begin="00:31.380" end="00:31.590">bit </span><span begin="00:31.590" end="00:31.590">（</span><span begin="00:31.590" end="00:31.590">*</span><span begin="00:31.590" end="00:31.590">*</span><span begin="00:31.590" end="00:31.590">*</span><span begin="00:31.590" end="00:31.590">* </span><span begin="00:31.590" end="00:31.650">him</span><span begin="00:31.650" end="00:31.680">）</span></p><p ttm:agent="v1" begin="00:31.680" end="00:32.730"><span begin="00:31.680" end="00:31.830">If </span><span begin="00:31.830" end="00:31.950">he </span><span begin="00:31.950" end="00:32.190">take </span><span begin="00:32.190" end="00:32.250">a </span><span begin="00:32.250" end="00:32.490">hit </span><span begin="00:32.490" end="00:32.550">of </span><span begin="00:32.550" end="00:32.730">this</span></p><p ttm:agent="v1" begin="00:32.730" end="00:33.780"><span begin="00:32.730" end="00:32.820">I </span><span begin="00:32.820" end="00:33.060">know </span><span begin="00:33.060" end="00:33.210">he </span><span begin="00:33.210" end="00:33.660">addicted </span><span begin="00:33.660" end="00:33.660">（</span><span begin="00:33.660" end="00:33.780">hello</span><span begin="00:33.780" end="00:33.780">）</span></p><p ttm:agent="v1" begin="00:33.780" end="00:35.580"><span begin="00:33.780" end="00:34.110">I'm </span><span begin="00:34.110" end="00:34.170">a </span><span begin="00:34.170" end="00:34.440">boss </span><span begin="00:34.440" end="00:34.560">so </span><span begin="00:34.560" en