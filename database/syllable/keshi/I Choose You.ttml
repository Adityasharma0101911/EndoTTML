<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>I Choose You</ttm:title><ttm:agent type="person" xml:id="v1">keshi</ttm:agent><ttm:item type="album">Requiem (Deluxe)</ttm:item><ttm:item type="spotify_id">41EnM4giX9PJYZIBUCPmiI</ttm:item><itunes:duration>02:48.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:15.273" end="00:17.287"><span begin="00:15.273" end="00:15.561">Too </span><span begin="00:15.561" end="00:16.393">many </span><span begin="00:16.393" end="00:16.905">drunken </span><span begin="00:16.905" end="00:17.287">nights</span></p><p ttm:agent="v1" begin="00:18.154" end="00:20.692"><span begin="00:18.154" end="00:18.498">Another </span><span begin="00:18.498" end="00:18.843">day </span><span begin="00:18.843" end="00:19.106">in </span><span begin="00:19.106" end="00:20.308">paradise </span><span begin="00:20.308" end="00:20.692">but</span></p><p ttm:agent="v1" begin="00:21.307" end="00:24.400"><span begin="00:21.307" end="00:21.483">I </span><span begin="00:21.483" end="00:21.843">can't </span><span begin="00:21.843" end="00:22.662">remember </span><span begin="00:22.662" end="00:23.119">where </span><span begin="00:23.119" end="00:23.363">I've </span><span begin="00:23.363" end="00:24.400">been</span></p><p ttm:agent="v1" begin="00:26.911" end="00:29.092"><span begin="00:26.911" end="00:27.071">It's </span><span begin="00:27.071" end="00:27.303">just </span><span begin="00:27.303" end="00:27.787">smoke </span><span begin="00:27.787" end="00:27.995">and </span><span begin="00:27.995" end="00:28.507">flashing </span><span begin="00:28.507" end="00:29.092">lights</span></p><p ttm:agent="v1" begin="00:29.773" end="00:32.293"><span begin="00:29.773" end="00:30.147">Sweet </span><span begin="00:30.147" end="00:30.708">lows </span><span begin="00:30.708" end="00:30.916">and </span><span begin="00:30.916" end="00:31.475">crashing </span><span begin="00:31.475" end="00:32.293">highs</span></p><p ttm:agent="v1" begin="00:32.911" end="00:36.087"><span begin="00:32.911" end="00:33.137">And </span><span begin="00:33.137" end="00:33.460">all </span><span begin="00:33.460" end="00:33.689">the </span><span begin="00:33.689" end="00:34.462">money </span><span begin="00:34.462" end="00:34.775">I </span><span begin="00:34.775" end="00:35.055">could </span><span begin="00:35.055" end="00:36.087">spend</span></p><p ttm:agent="v1" begin="00:37.288" end="00:41.935"><span begin="00:37.288" end="00:37.470">And </span><span begin="00:37.470" end="00:37.695">I </span><span begin="00:37.695" end="00:38.583">choose </span><span begin="00:38.583" end="00:41.935">you</span></p><p ttm:agent="v1" begin="00:43.279" end="00:47.952"><span begin="00:43.279" end="00:43.575">I </span><span begin="00:43.575" end="00:44.142">choose </span><span begin="00:44.142" end="00:47.952">you</span></p><p ttm:agent="v1" begin="00:50.616" end="00:52.484"><span begin="00:50.616" end="00:50.767">And </span><span begin="00:50.767" end="00:51.144">out </span><span begin="00:51.144" end="00:51.309">of </span><span begin="00:51.309" end="00:51.783">all </span><span begin="00:51.783" end="00:52.023">the </span><span begin="00:52.023" end="00:52.484">rest</span></p><p ttm:agent="v1" begin="00:53.419" end="00:55.772"><span begin="00:53.419" end="00:53.699">You </span><span begin="00:53.699" end="00:54.204">always </span><span begin="00:54.204" end="00:54.622">knew </span><span begin="00:54.622" end="00:54.988">me </span><span begin="00:54.988" end="00:55.772">best</span></p><p ttm:agent="v1" begin="00:56.517" end="00:59.300"><span begin="00:56.517" end="00:56.955">Despite </span><span begin="00:56.955" end="00:57.211">the </span><span begin="00:57.211" end="00:57.844">things </span><span begin="00:57.844" end="00:58.048">you </span><span begin="00:58.048" end="00:58.411">never </span><span begin="00:58.411" end="00:59.300">saw</span></p><p ttm:agent="v1" begin="01:02.195" end="01:04.135"><span begin="01:02.195" end="01:02.422">I </span><span begin="01:02.422" end="01:02.739">got </span><span begin="01:02.739" end="01:02.948">a </span><span begin="01:02.948" end="01:03.471">few </span><span begin="01:03.471" end="01:04.135">regrets</span></p><p ttm:agent="v1" begin="01:04.975" end="01:07.151"><span begin="01:04.975" end="01:05.159">That </span><span begin="01:05.159" end="01:05.471">you </span><span begin="01:05.471" end="01:05.815">make </span><span begin="01:05.815" end="01:06.447">me </span><span begin="01:06.447" end="01:07.151">forget</span></p><p ttm:agent="v1" begin="01:07.903" end="01:11.007"><span begin="01:07.903" end="01:08.103">Who </span><span begin="01:08.103" end="01:08.559">said </span><span begin="01:08.559" end="01:08.775">that </span><span begin="01:08.775" end="01:09.098">you </span><span begin="01:09.098" end="01:09.583">can't </span><span begin="01:09.583" end="01:09.758">have </span><span begin="01:09.758" end="01:10.015">it </span><span begin="01:10.015" end="01:11.007">all?</span></p><p ttm:agent="v1" begin="01:12.360" end="01:17.336"><span begin="01:12.360" end="01:12.546">'Cause </span><span begin="01:12.546" end="01:12.783">I </span><span begin="01:12.783" end="01:13.687">choose </span><span begin="01:13.687" end="01:17.336">you</span></p><p ttm:agent="v1" begin="01:18.408" end="01:23.439"><span begin="01:18.408" end="01:18.655">I </span><span begin="01:18.655" end="01:19.247">choose </span><span begin="01:19.247" end="01:23.439">you</span></p><p ttm:agent="v1" begin="01:24.015" end="01:29.274"><span begin="01:24.015" end="01:24.192">Yeah </span><span begin="01:24.192" end="01:24.487">I </span><span begin="01:24.487" end="01:25.383">choose </span><span begin="01:25.383" end="01:29.274">you</span></p><p ttm:agent="v1" begin="01:30.032" end="01:34.319"><span begin="01:30.032" end="01:30.351">I </span><span begin="01:30.351" end="01:30.895">choose </span><span begin="01:30.895" end="01:34.319">you</span></p><p ttm:agent="v1" begin="01:34.319" end="01:36.243"><span begin="01:34.319" end="01:34.539">No </span><span begin="01:34.539" end="01:35.139">matter </span><span begin="01:35.139" end="01:35.435">what </span><span begin="01:35.435" end="01:35.587">it </span><span begin="01:35.587" end="01:36.243">takes</span></p><p ttm:agent="v1" begin="01:37.075" end="01:39.235"><span begin="01:37.075" end="01:37.483">I'm </span><span begin="01:37.483" end="01:38.123">staying </span><span begin="01:38.123" end="01:39.235">anyway</span></p><p ttm:agent="v1" begin="01:40.027" end="01:42.532"><span begin="01:40.027" end="01:40.387">Through </span><span begin="01:40.387" end="01:40.899">good </span><span begin="01:40.899" end="01:41.044">and </span><span begin="01:41.044" end="01:41.427">bad </span><span begin="01:41.427" end="01:41.797">you </span><span begin="01:41.797" end="01:42.075">know </span><span begin="01:42.075" end="01:42.532">that</span></p><p ttm:agent="v1" begin="01:42.755" end="01:51.086"><span begin="01:42.755" end="01:43.771">Baby </span><span begin="01:44.059" end="01:44.795">I'll </span><span begin="01:44.795" end="01:47.339">forever </span><span begin="01:48.124" end="01:48.443">and </span><span begin="01:48.443" end="01:51.086">always</span></p><p ttm:agent="v1" begin="01:51.086" end="01:52.695"><span begin="01:51.086" end="01:51.782">Choose </span><span begin="01:51.782" end="01:52.695">you</span></p><p ttm:agent="v1" begin="01:56.574" end="02:00.966"><span begin="01:56.574" end="01:56.782">I'll </span><span begin="01:56.782" end="01:57.697">choose </span><span begin="01:57.697" end="02:00.966">you</span></p><p ttm:agent="v1" begin="02:02.518" end="02:06.957"><span begin="02:02.518" end="02:02.694">I'll </span><span begin="02:02.694" end="02:03.574">choose </span><span begin="02:03.574" end="02:06.957">you</span></p><p ttm:agent="v1" begin="02:08.581" end="02:11.085"><span begin="02:08.581" end="02:08.740">I'll </span><span begin="02:08.740" end="02:09.436">choose </span><span begin="02:09.436" end="02:11.085">you</span></p><p ttm:agent="v1" begin="02:14.534" end="02:18.788"><span begin="02:14.534" end="02:15.261">Choose </span><span begin="02:15.261" end="02:18.788">you</span></p><p ttm:agent="v1" begin="02:20.342" end="02:25.309"><span begin="02:20.342" end="02:21.151">Choose </span><span begin="02:21.151" end="02:25.309">you</span></p></div></body></tt>