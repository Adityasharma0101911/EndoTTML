<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>SMILEY(Feat. BIBI)</ttm:title><ttm:agent type="person" xml:id="v1">YENA</ttm:agent><ttm:agent type="person" xml:id="v2">BIBI</ttm:agent><ttm:item type="album">ˣ‿ˣ (SMiLEY)</ttm:item><ttm:item type="spotify_id">4zCIxSnVWpGNghERX4uWZF</ttm:item><itunes:duration>00:38.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.000" end="00:01.900"><span begin="00:00.000" end="00:00.570">Smiley</span><span begin="00:00.570" end="00:00.665"> </span><span begin="00:00.665" end="00:00.760">(</span><span begin="00:00.760" end="00:01.140">Live</span><span begin="00:01.140" end="00:01.235">)</span><span begin="00:01.235" end="00:01.330"> </span><span begin="00:01.330" end="00:01.425">-</span><span begin="00:01.425" end="00:01.520"> </span><span begin="00:01.520" end="00:01.900">YENA</span></p><p ttm:agent="v1" begin="00:01.900" end="00:03.800"><span begin="00:01.900" end="00:01.957">词</span><span begin="00:01.957" end="00:02.015">：</span><span begin="00:02.015" end="00:02.245">트웰브(</span><span begin="00:02.245" end="00:02.590">twlv)/</span><span begin="00:02.590" end="00:02.763">비비(</span><span begin="00:02.763" end="00:03.109">BIBI)/</span><span begin="00:03.109" end="00:03.396">YENA(</span><span begin="00:03.396" end="00:03.684">최예나)/</span><span begin="00:03.684" end="00:03.800">72</span></p><p ttm:agent="v1" begin="00:03.800" end="00:05.700"><span begin="00:03.800" end="00:03.845">曲</span><span begin="00:03.845" end="00:03.890">：</span><span begin="00:03.890" end="00:04.116">Olof </span><span begin="00:04.116" end="00:04.523">Lindskog/</span><span begin="00:04.523" end="00:04.840">Hayley </span><span begin="00:04.840" end="00:05.157">Aitken/</span><span begin="00:05.157" end="00:05.338">트웰브(</span><span begin="00:05.338" end="00:05.609">twlv)/</span><span begin="00:05.609" end="00:05.700">72</span></p><p ttm:agent="v1" begin="00:05.995" end="00:07.587"><span begin="00:05.995" end="00:06.185">And </span><span begin="00:06.185" end="00:06.578">I </span><span begin="00:06.578" end="00:06.988">say </span><span begin="00:06.988" end="00:07.587">hey</span></p><p ttm:agent="v1" begin="00:07.587" end="00:10.635"><span begin="00:07.587" end="00:07.792">I'm </span><span begin="00:07.792" end="00:08.194">gonna </span><span begin="00:08.194" end="00:08.369">make </span><span begin="00:08.369" end="00:08.636">it </span><span begin="00:08.636" end="00:09.018">smile </span><span begin="00:09.018" end="00:09.422">smile </span><span begin="00:09.422" end="00:09.837">smile </span><span begin="00:09.837" end="00:10.635">away</span></p><p ttm:agent="v1" begin="00:10.875" end="00:13.858"><span begin="00:10.875" end="00:11.468">예쁘게 </span><span begin="00:11.468" end="00:11.883">웃고 </span><span begin="00:11.883" end="00:13.858">넘겨버릴래</span></p><p ttm:agent="v1" begin="00:16.903" end="00:19.127"><span begin="00:16.903" end="00:17.337">아픔 </span><span begin="00:17.337" end="00:17.702">슬픔 </span><span begin="00:17.702" end="00:18.329">외로움 </span><span begin="00:18.329" end="00:19.127">잊게</span></p><p ttm:agent="v1" begin="00:19.387" end="00:20.828"><span begin="00:19.387" end="00:19.776">I </span><span begin="00:19.776" end="00:20.240">say </span><span begin="00:20.240" end="00:20.828">hey</span></p><p ttm:agent="v1" begin="00:20.828" end="00:23.989"><span begin="00:20.828" end="00:21.029">I </span><span begin="00:21.029" end="00:21.420">never </span><span begin="00:21.420" end="00:21.860">wanna </span><span begin="00:21.860" end="00:22.263">cry </span><span begin="00:22.263" end="00:22.675">cry </span><span begin="00:22.675" end="00:23.091">cry </span><span begin="00:23.091" end="00:23.537">all </span><span begin="00:23.537" end="00:23.989">day</span></p><p ttm:agent="v1" begin="00:24.105" end="00:27.208"><span begin="00:24.105" end="00:24.720">갑자기 </span><span begin="00:24.720" end="00:25.526">눈물이 </span><span begin="00:25.526" end="00:26.703">차오를 </span><span begin="00:26.703" end="00:27.208">땐</span></p><p ttm:agent="v1" begin="00:30.191" end="00:34.336"><span begin="00:30.191" end="00:31.013">안녕이라 </span><span begin="00:31.013" end="00:31.701">말할래 </span><span begin="00:31.701" end="00:32.102">with </span><span begin="00:32.102" end="00:32.685">my </span><span begin="00:32.685" end="00:33.535">smiley </span><span begin="00:33.535" end="00:34.336">face</span></p></div></body></tt>