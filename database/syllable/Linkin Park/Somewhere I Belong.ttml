/p><p ttm:agent="v1" begin="00:47.700" end="00:48.630"><span begin="00:47.700" end="00:47.820">I </span><span begin="00:47.820" end="00:48.060">was </span><span begin="00:48.060" end="00:48.630">confused</span></p><p ttm:agent="v1" begin="00:48.660" end="00:51.000"><span begin="00:48.660" end="00:48.840">And </span><span begin="00:48.840" end="00:48.960">I </span><span begin="00:48.960" end="00:49.230">let </span><span begin="00:49.230" end="00:49.440">it </span><span begin="00:49.440" end="00:49.800">all </span><span begin="00:49.800" end="00:50.100">out </span><span begin="00:50.100" end="00:50.160">to </span><span begin="00:50.160" end="00:50.640">find </span><span begin="00:50.640" end="00:50.880">that </span><span begin="00:50.880" end="00:51.000">I'm</span></p><p ttm:agent="v1" begin="00:51.000" end="00:53.700"><span begin="00:51.000" end="00:51.210">not </span><span begin="00:51.210" end="00:51.450">the </span><span begin="00:51.450" end="00:51.720">only </span><span begin="00:51.720" end="00:52.110">person </span><span begin="00:52.110" end="00:52.290">with </span><span begin="00:52.290" end="00:52.620">these </span><span begin="00:52.620" end="00:53.100">things </span><span begin="00:53.100" end="00:53.190">in </span><span begin="00:53.190" end="00:53.700">mind</span></p><p ttm:agent="v1" begin="00:53.700" end="00:54.330"><span begin="00:53.700" end="00:54.090">Inside </span><span begin="00:54.090" end="00:54.180">of </span><span begin="00:54.180" end="00:54.330">me</span></p><p ttm:agent="v1" begin="00:54.360" end="00:56.580"><span begin="00:54.360" end="00:54.600">But </span><span begin="00:54.600" end="00:54.750">all </span><span begin="00:54.750" end="00:54.870">the </span><span begin="00:54.870" end="00:55.440">vacancy </span><span begin="00:55.440" end="00:55.590">the </span><span begin="00:55.590" end="00:56.040">words </span><span begin="00:56.040" end="00:56.580">revealed</span></p><p ttm:agent="v1" begin="00:56.580" end="00:59.550"><span begin="00:56.580" end="00:56.820">this </span><span begin="00:56.820" end="00:56.880">is </span><span begin="00:56.880" end="00:57.000">the </span><span begin="00:57.000" end="00:57.270">only </span><span begin="00:57.270" end="00:57.600">real </span><span begin="00:57.600" end="00:58.020">thing </span><span begin="00:58.020" end="00:58.290">that </span><span begin="00:58.290" end="00:58.410">I've </span><span begin="00:58.410" end="00:58.590">got </span><span begin="00:58.590" end="00:58.980">left </span><span begin="00:58.980" end="00:59.100">to </span><span begin="00:59.100" end="00:59.550">feel</span></p><p ttm:agent="v1" begin="00:59.550" end="01:00.420"><span begin="00:59.550" end="00:59.880">Nothing </span><span begin="00:59.880" end="01:00.120">to </span><span begin="01:00.120" end="01:00.420">lose</span></p><p ttm:agent="v1" begin="01:00.420" end="01:02.520"><span begin="01:00.420" end="01:00.720">Just </span><span begin="01:00.720" end="01:01.290">stuck </span><span begin="01:01.290" end="01:01.830">hollow </span><span begin="01:01.830" end="01:01.980">and </span><span begin="01:01.980" end="01:02.520">alone</span></p><p ttm:agent="v1" begin="01:02.550" end="01:03.600"><span begin="01:02.550" end="01:02.700">And </span><span begin="01:02.700" end="01:02.790">the </span><span begin="01:02.790" end="01:03.270">fault </span><span begin="01:03.270" end="01:03.420">is </span><span begin="01:03.420" end="01:03.540">my </span><span begin="01:03.540" end="01:03.600">own</span></p><p ttm:agent="v1" begin="01:03.600" end="01:05.460"><span begin="01:03.600" end="01:03.910">And </span><span begin="01:03.910" end="01:04.220">the </span><span begin="01:04.220" end="01:04.530">fault </span><span begin="01:04.530" end="01:04.840">is </span><span begin="01:04.840" end="01:05.150">my </span><span begin="01:05.150" end="01:05.460">own</span></p><p ttm:agent="v1" begin="01:05.490" end="01:06.840"><span begin="01:05.490" end="01:05.610">I </span><span begin="01:05.610" end="01:05.970">