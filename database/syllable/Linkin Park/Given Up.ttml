<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Given Up</ttm:title><ttm:agent type="person" xml:id="v1">Linkin Park</ttm:agent><ttm:item type="album">Minutes to Midnight</ttm:item><ttm:item type="spotify_id">1fLlRApgzxWweF1JTf8yM5</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:24.130" end="00:26.200"><span begin="00:24.130" end="00:24.670">Wake </span><span begin="00:24.670" end="00:24.910">in </span><span begin="00:24.910" end="00:25.030">a  </span><span begin="00:25.030" end="00:25.540">sweat </span><span begin="00:25.540" end="00:26.200">again</span></p><p ttm:agent="v1" begin="00:26.710" end="00:29.770"><span begin="00:26.710" end="00:27.490">Another </span><span begin="00:27.490" end="00:27.910">day's </span><span begin="00:27.910" end="00:28.120">been </span><span begin="00:28.120" end="00:28.450">laid </span><span begin="00:28.450" end="00:28.690">to </span><span begin="00:28.690" end="00:29.770">waste</span></p><p ttm:agent="v1" begin="00:30.250" end="00:32.140"><span begin="00:30.250" end="00:30.520">In </span><span begin="00:30.520" end="00:30.850">my </span><span begin="00:30.850" end="00:32.140">disgrace</span></p><p ttm:agent="v1" begin="00:33.640" end="00:35.860"><span begin="00:33.640" end="00:34.240">Stuck </span><span begin="00:34.240" end="00:34.450">in </span><span begin="00:34.450" end="00:34.690">my </span><span begin="00:34.690" end="00:35.140">head </span><span begin="00:35.140" end="00:35.860">again</span></p><p ttm:agent="v1" begin="00:35.980" end="00:39.340"><span begin="00:35.980" end="00:36.610">Feels </span><span begin="00:36.610" end="00:36.910">like </span><span begin="00:36.910" end="00:37.120">I'll </span><span begin="00:37.120" end="00:37.720">never </span><span begin="00:37.720" end="00:38.080">leave </span><span begin="00:38.080" end="00:38.350">this </span><span begin="00:38.350" end="00:39.340">place</span></p><p ttm:agent="v1" begin="00:39.730" end="00:41.320"><span begin="00:39.730" end="00:40.150">There's </span><span begin="00:40.150" end="00:40.450">no </span><span begin="00:40.450" end="00:41.320">escape</span></p><p ttm:agent="v1" begin="00:42.460" end="00:46.390"><span begin="00:42.460" end="00:42.820">I'm </span><span begin="00:42.820" end="00:43.270">my </span><span begin="00:43.270" end="00:43.750">own </span><span begin="00:43.750" end="00:44.470">worst </span><span begin="00:44.470" end="00:46.390">enemy</span></p><p ttm:agent="v1" begin="00:46.420" end="00:51.250"><span begin="00:46.420" end="00:46.750">I've </span><span begin="00:46.750" end="00:50.770">given </span><span begin="00:50.770" end="00:51.220">up</span><span begin="00:51.220" end="00:51.230">.</span><span begin="00:51.230" end="00:51.240">.</span><span begin="00:51.240" end="00:51.250">.</span></p><p ttm:agent="v1" begin="00:51.250" end="00:52.960"><span begin="00:51.250" end="00:51.520">I'm </span><span begin="00:51.520" end="00:51.940">sick </span><span begin="00:51.940" end="00:52.150">of </span><span begin="00:52.150" end="00:52.960">feeling</span></p><p ttm:agent="v1" begin="00:53.290" end="00:56.260"><span begin="00:53.290" end="00:53.650">Is </span><span begin="00:53.650" end="00:53.890">there </span><span begin="00:53.890" end="00:54.430">nothing </span><span begin="00:54.430" end="00:54.640">you </span><span begin="00:54.640" end="00:55.060">can </span><span begin="00:55.060" end="00:56.230">say</span><span begin="00:56.230" end="00:56.260">?</span></p><p ttm:agent="v1" begin="00:56.260" end="01:00.760"><span begin="00:56.260" end="00:56.980">Take </span><span begin="00:56.980" end="00:59.260">this </span><span begin="00:59.260" end="00:59.440">all </span><span begin="00:59.440" end="01:00.760">away</span></p><p ttm:agent="v1" begin="01:00.820" end="01:02.860"><span begin="01:00.820" end="01:01.060">I'm </span><span begin="01:01.060" end="01:02.620">suffocating</span><span begin="01:02.620" end="01:02.860">!</span></p><p ttm:agent="v1" begin="01:02.860" end="01:04.750"><span begin="01:02.860" end="01:03.250">Tell </span><span begin="01:03.250" end="01:03.490">me </span><span begin="01:03.490" end="01:03.820">what </span><span begin="01:03.820" end="01:03.940">the </span><span begin="01:03.940" end="01:04.090">*</span><span begin="01:04.090" end="01:04.240">*</span><span begin="01:04.240" end="01:04.390">*</span><span begin="01:04.390" end="01:04.540">* </span><span begin="01:04.540" end="01:04.750">is</span></p><p ttm:agent="v1" begin="01:04.750" end="01:09.850"><span begin="01:04.750" end="01:06.460">Wrong </span><span begin="01:06.460" end="01:07.090">with </span><span begin="01:07.090" end="01:07.300">me</span><span begin="01:07.300" end="01:09.850">!</span></p><p ttm:agent="v1" begin="01:09.850" end="01:12.010"><span begin="01:09.850" end="01:10.120">I </span><span begin="01:10.120" end="01:10.450">don't </span><span begin="01:10.450" end="01:10.690">know </span><span begin="01:10.690" end="01:11.020">what </span><span begin="01:11.020" end="01:11.230">to </span><span begin="01:11.230" end="01:12.010">take</span></p><p ttm:agent="v1" begin="01:12.160" end="01:15.310"><span begin="01:12.160" end="01:12.610">Thought </span><span begin="01:12.610" end="01:12.820">I </span><span begin="01:12.820" end="01:13.090">was </span><span begin="01:13.090" end="01:13.750">focused </span><span begin="01:13.750" end="01:14.080">but </span><span begin="01:14.080" end="01:14.230">I'm </span><span begin="01:14.230" end="01:15.310">scared</span></p><p ttm:agent="v1" begin="01:15.790" end="01:18.010"><span begin="01:15.790" end="01:16.060">I'm </span><span begin="01:16.060" end="01:16.420">not </span><span begin="01:16.420" end="01:18.010">prepared</span></p><p ttm:agent="v1" begin="01:19.390" end="01:21.340"><span begin="01:19.390" end="01:19.630">I </span><span begin="01:19.630" end="01:21.340">hyperventilate</span></p><p ttm:agent="v1" begin="01:21.820" end="01:24.730"><span begin="01:21.820" end="01:22.390">Looking </span><span begin="01:22.390" end="01:22.690">for </span><span begin="01:22.690" end="01:22.990">help </span><span begin="01:22.990" end="01:23.560">somehow </span><span begin="01:23.560" end="01:24.730">somewhere</span></p><p ttm:agent="v1" begin="01:25.360" end="01:27.580"><span begin="01:25.360" end="01:25.660">And </span><span begin="01:25.660" end="01:25.990">no </span><span begin="01:25.990" end="01:26.260">one </span><span begin="01:26.260" end="01:27.580">cares</span></p><p ttm:agent="v1" begin="01:28.090" end="01:31.960"><span begin="01:28.090" end="01:28.420">I'm </span><span begin="01:28.420" end="01:28.840">my </span><span begin="01:28.840" end="01:29.320">own </span><span begin="01:29.320" end="01:30.010">worst </span><span begin="01:30.010" end="01:31.960">enemy</span></p><p ttm:agent="v1" begin="01:31.990" end="01:36.850"><span begin="01:31.990" end="01:32.350">I've </span><span begin="01:32.350" end="01:36.400">given </span><span begin="01:36.400" end="01:36.790">up</span><span begin="01:36.790" end="01:36.810">.</span><span begin="01:36.810" end="01:36.830">.</span><span begin="01:36.830" end="01:36.850">.</span></p><p ttm:agent="v1" begin="01:36.850" end="01:38.590"><span begin="01:36.850" end="01:37.090">I'm </span><span begin="01:37.090" end="01:37.540">sick </span><span begin="01:37.540" end="01:37.720">of </span><span begin="01:37.720" end="01:38.590">feeling</span></p><p ttm