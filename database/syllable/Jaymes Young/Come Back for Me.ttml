<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Come Back for Me</ttm:title><ttm:agent type="person" xml:id="v1">Jaymes Young</ttm:agent><ttm:item type="album">Habits of My Heart</ttm:item><ttm:item type="spotify_id">0cOrNgkbsWJYmxzf7T9nUd</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:11.790" end="00:17.130"><span begin="00:11.790" end="00:12.450">There's </span><span begin="00:12.450" end="00:12.570">a </span><span begin="00:12.570" end="00:13.500">dark </span><span begin="00:13.500" end="00:14.010">room </span><span begin="00:14.010" end="00:14.820">inside </span><span begin="00:14.820" end="00:15.030">of </span><span begin="00:15.030" end="00:15.600">my </span><span begin="00:15.600" end="00:17.130">head</span></p><p ttm:agent="v1" begin="00:17.760" end="00:23.790"><span begin="00:17.760" end="00:19.020">Developing </span><span begin="00:19.020" end="00:20.340">images </span><span begin="00:20.340" end="00:20.670">I'd </span><span begin="00:20.670" end="00:21.210">rather </span><span begin="00:21.210" end="00:23.790">forget</span></p><p ttm:agent="v1" begin="00:24.840" end="00:29.700"><span begin="00:24.840" end="00:25.290">You </span><span begin="00:25.290" end="00:25.860">laced </span><span begin="00:25.860" end="00:26.100">your </span><span begin="00:26.100" end="00:26.850">tongue </span><span begin="00:26.850" end="00:27.390">with </span><span begin="00:27.390" end="00:27.510">a </span><span begin="00:27.510" end="00:29.700">poison</span></p><p ttm:agent="v1" begin="00:30.450" end="00:34.470"><span begin="00:30.450" end="00:30.630">And </span><span begin="00:30.630" end="00:30.720">it </span><span begin="00:30.720" end="00:31.050">makes </span><span begin="00:31.050" end="00:31.290">me </span><span begin="00:31.290" end="00:34.470">remember</span></p><p ttm:agent="v1" begin="00:37.140" end="00:42.720"><span begin="00:37.140" end="00:37.830">Every </span><span begin="00:37.830" end="00:38.820">night </span><span begin="00:38.820" end="00:39.360">I </span><span begin="00:39.360" end="00:40.110">look </span><span begin="00:40.110" end="00:40.380">out </span><span begin="00:40.380" end="00:40.650">my </span><span begin="00:40.650" end="00:42.720">window</span></p><p ttm:agent="v1" begin="00:43.950" end="00:48.780"><span begin="00:43.950" end="00:45.330">Afraid </span><span begin="00:45.330" end="00:45.480">you </span><span begin="00:45.480" end="00:45.810">might </span><span begin="00:45.810" end="00:46.920">return </span><span begin="00:46.920" end="00:47.160">for </span><span begin="00:47.160" end="00:48.780">more</span></p><p ttm:agent="v1" begin="00:50.250" end="00:53.280"><span begin="00:50.250" end="00:50.460">I </span><span begin="00:50.460" end="00:50.970">miss </span><span begin="00:50.970" end="00:51.240">your </span><span begin="00:51.240" end="00:52.050">frozen </span><span begin="00:52.050" end="00:52.560">love </span><span begin="00:52.560" end="00:52.830">too </span><span begin="00:52.830" end="00:53.280">much</span></p><p ttm:agent="v1" begin="00:53.370" end="00:56.400"><span begin="00:53.370" end="00:53.580">And </span><span begin="00:53.580" end="00:53.790">I'd </span><span begin="00:53.790" end="00:55.020">overdose </span><span begin="00:55.020" end="00:55.290">from </span><span begin="00:55.290" end="00:55.830">just </span><span begin="00:55.830" end="00:55.980">a </span><span begin="00:55.980" end="00:56.400">touch</span></p><p ttm:agent="v1" begin="00:56.400" end="01:01.890"><span begin="00:56.400" end="00:57.420">So</span><span begin="00:57.420" end="00:58.350">, </span><span begin="00:58.350" end="00:59.250">baby </span><span begin="00:59.250" end="00:59.730">don't </span><span begin="00:59.730" end="01:00.120">come </span><span begin="01:00.120" end="01:01.890">back</span></p><p ttm:agent="v1" begin="01:03.090" end="01:07.920"><span begin="01:03.090" end="01:04.830">Oh</span><span begin="01:04.830" end="01:05.220">, </span><span begin="01:05.220" end="01:06.060">whatever </span><span begin="01:06.060" end="01:06.330">you </span><span begin="01:06.330" end="01:07.920">do</span></p><p ttm:agent="v1" begin="01:08.580" end="01:11.910"><span begin="01:08.580" end="01:09.150">Don't </span><span begin="01:09.150" end="01:09.480">come </span><span begin="01:09.480" end="01:10.140">back </span><span begin="01:10.140" end="01:10.980">for </span><span begin="01:10.980" end="01:11.910">me</span></p><p ttm:agent="v1" begin="01:15.000" end="01:20.550"><span begin="01:15.000" end="01:15.870">After </span><span begin="01:15.870" end="01:17.760">all </span><span begin="01:17.760" end="01:18.090">I've </span><span begin="01:18.090" end="01:18.690">bled </span><span begin="01:18.690" end="01:18.900">for </span><span begin="01:18.900" end="01:20.550">you</span></p><p ttm:agent="v1" begin="01:21.240" end="01:24.540"><span begin="01:21.240" end="01:21.780">I </span><span begin="01:21.780" end="01:22.110">can </span><span begin="01:22.110" end="01:23.970">hardly </span><span begin="01:23.970" end="01:24.540">breathe</span></p><p ttm:agent="v1" begin="01:28.200" end="01:32.610"><span begin="01:28.200" end="01:28.440">And </span><span begin="01:28.440" end="01:30.930">one </span><span begin="01:30.930" end="01:31.500">more </span><span begin="01:31.500" end="01:32.610">kiss</span></p><p ttm:agent="v1" begin="01:32.640" end="01:40.200"><span begin="01:32.6