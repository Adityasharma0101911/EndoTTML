ttm:agent="v1" begin="00:41.800" end="00:45.820"><span begin="00:41.800" end="00:42.250">At </span><span begin="00:42.250" end="00:45.310">peace</span></p><p ttm:agent="v1" begin="00:45.820" end="00:49.600"><span begin="00:45.820" end="00:46.060">My </span><span begin="00:46.060" end="00:46.450">clothes </span><span begin="00:46.450" end="00:46.600">are </span><span begin="00:46.600" end="00:47.080">dripping </span><span begin="00:47.080" end="00:49.300">wet</span></p><p ttm:agent="v1" begin="00:49.600" end="00:53.200"><span begin="00:49.600" end="00:50.140">Water </span><span begin="00:50.140" end="00:50.350">was </span><span begin="00:50.350" end="00:50.680">full </span><span begin="00:50.680" end="00:50.800">of </span><span begin="00:50.800" end="00:53.140">sharks</span></p><p ttm:agent="v1" begin="00:53.200" end="00:57.100"><span begin="00:53.200" end="00:53.530">And </span><span begin="00:53.530" end="00:53.980">instead </span><span begin="00:53.980" end="00:54.130">of </span><span begin="00:54.130" end="00:54.610">missing </span><span begin="00:54.610" end="00:56.800">legs</span></p><p ttm:agent="v1" begin="00:57.100" end="01:00.820"><span begin="00:57.100" end="00:57.430">I</span><span begin="00:57.430" end="00:57.430">’</span><span begin="00:57.430" end="00:57.490">m </span><span begin="00:57.490" end="00:58.090">missing </span><span begin="00:58.090" end="00:58.330">my </span><span begin="00:58.330" end="01:00.820">heart</span></p><p ttm:agent="v1" begin="01:00.820" end="01:07.420"><span begin="01:00.820" end="01:00.940">I</span><span begin="01:00.940" end="01:00.940">’</span><span begin="01:00.940" end="01:01.060">m </span><span begin="01:01.060" end="01:01.360">still </span><span begin="01:03.880" end="01:04.930">standing </span><span begin="01:04.930" end="01:07.420">here</span></p><p ttm:agent="v1" begin="01:07.420" end="01:11.230"><span begin="01:07.420" end="01:07.780">Met </span><span begin="01:07.780" end="01:08.170">your </span><span begin="01:08.170" end="01:09.340">demands </span><span begin="01:09.370" end="01:09.640">and </span><span begin="01:09.640" end="01:10.120">then </span><span begin="01:10.120" end="01:10.510">you </span><span begin="01:10.510" end="01:11.170">ran</span></p><p ttm:agent="v1" begin="01:11.230" end="01:14.980"><span begin="01:11.230" end="01:11.440">And </span><span begin="01:11.440" end="01:11.950">left </span><span begin="01:11.950" end="01:12.250">me </span><span begin="01:12.250" end="01:14.920">stranded</span></p><p ttm:agent="v1" begin="01:14.980" end="01:22.480"><span begin="01:14.980" end="01:15.280">I </span><span begin="01:15.280" end="01:15.730">ask </span><span begin="01:15.730" end="01:15.970">the </span><span begin="01:15.970" end="01:18.700">stars </span><span begin="01:18.700" end="01:18.730">“</span><span begin="01:18.730" end="01:19.000">why </span><span begin="01:19.000" end="01:19.540">did </span><span begin="01:19.540" end="01:19.840">I </span><span begin="01:19.840" end="01:22.480">fall</span><span begin="01:22.480" end="01:22.480">?</span><span begin="01:22.480" end="01:22.480">”</span></p><p ttm:agent="v1" begin="01:22.480" end="01:26.200"><span begin="01:22.480" end="01:22.660">You</span><span begin="01:22.660" end="01:22.660">’</span><span begin="01:22.660" end="01:22.720">re </span><span begin="01:22.720" end="01:23.230">like </span><span begin="01:23.230" end="01:23.560">the </span><span begin="01:23.560" end="01:24.250">sand</span><span begin="01:24.250" end="01:24.310">, </span><span begin="01:24.310" end="01:24.640">slipped </span><span begin="01:24.640" end="01:25.060">through </span><span begin="01:25.060" end="01:25.540">my </span><span begin="01:25.540" end="01:26.170">hands</span></p><p ttm:agent="v1" begin="01:26.200" end="01:32.830"><span begin="01:26.200" end="01:26.470">You </span><span begin="01:26.470" end="01:26.920">left </span><span begin="01:26.920" end="01:27.310">me </span><span begin="01:27.310" end="01:32.800">stranded</span></p><p ttm:agent="v1" begin="01:32.830" end="01:36.670"><span begin="01:32.830" end="01:33.790">You </span><span begin="01:33.790" end="01:34.600">said </span><span begin="01:34.600" end="01:36.400">goodbye</span></p><p ttm:agent="v1" begin="01:36.670" end="01:40.510"><span begin="01:36.670" end="01:37.330">I </span><span begin="01:37.330" end="01:37.630">can </span><span begin="01:37.630" end="01:38.320">hear </span><span begin="01:38.320" end="01:38.620">your </span><span begin="01:38.620" end="01:40.480">cries</span></p><p ttm:agent="v1" begin="01:40.510" end="01:45.430"><span begin="01:40.510" end="01:41.170">Don</span><span begin="01:41.170" end="01:41.170">’</span><span begin="01:41.170" end="01:41.230">t </span><span begin="01:41.260" end="01:43.990">apologize </span><span begin="01:43.990" end="01:45.400">now</span></p><p ttm:agent="v1" begin="01:45.430" end="01:48.400"><span begin="01:45.430" end="01:45.880">All </span><span begin="01:45.880" end="01:46.150">those </span><span begin="01:46.150" end="01:48.040">tears</span></p><p ttm:agent="v1" begin="01:48.400" end="01:51.970"><span begin="01:48.400" end="01:48.760">Are </span><span begin="01:48.760" end="01:49.600">finally </span><span begin="01:49.600" end="01:51.760">sincere</span></p><p ttm:agent="v1" begin="01:51.970" end="01:55.690"><span begin="01:51.970" end="01:52.480">Now </span><span begin="01:52.480" end="01:52.840">that </span><span begin="01:52.840" end="01:53.080">I </span><span begin="01:53.080" end="01:53.380">am </span><span begin="01:53.380" end="01:53.710">not </span><span begin="01:53.710" end="01:55.480">near</span></p><p ttm:agent="v1" begin="01:55.690" end="02:01.000"><span begin="01:55.690" end="01:56.170">Tell </span><span begin="01:56.170" end="01:56.440">me </span><span begin="01:56.440" end="01:57.400">how </span><span begin="01:57.400" end="01:57.970">that </span><span begin="01:57.970" end="02:00.970">feels</span></p><p ttm:agent="v1" begin="02:01.000" end="02:07.060"><span begin="02:01.000" end="02:03.100">Here</span><span begin="02:03.100" end="02:03.340">, </span><span begin="02:03.340" end="02:03.640">I</span><span begin="02:03.640" end="02:03.640">’</span><span begin="02:03.640" end="02:03.790">m </span><span begin="02:03.790" end="02:04.420">always </span><span begin="02:04.420" end="02:04.690">in </span><span begin="02:04.690" end="02:05.050">your </span><span begin="02:05.050" end="02:06.760">ear</span></p><p ttm:agent="v1" begin="02:07.060" end="02:11.380"><span begin="02:07.060" end="02:07.690">Oh </span><span begin="02:07.690" end="02:08.080">you </span><span begin="02:08.080" end="02:08.470">can</span><span begin="02:08.470" end="02:08.470">’</span><span begin="02:08.470" end="02:08.530">t </span><span begin="02:08.530" end="02:08.890">think </span><span begin="02:08.890" end="02:11.350">clear</span></p><p ttm:agent="v1" begin="02:11.380" end="02:15.190"><span begin="02:11.380" end="02:11.830">How </span><span begin="02:11.830" end="02:12.280">does </span><span begin="02:12.280" end="02:12.520">it </span><span begin="02:12.520" end="02:14.830">feel</span><span begin="02:14.830" end="02:15.190">?</span></p><p ttm:agent="v1" begin="02:15.190" end="02:18.580"><span begin="02:15.190" end="02:15.640">Oh </span><span begin="02:15.640" end="02:15.820">it</span><span begin="02:15.820" end="02:15.820">’</span><span begin="02:15.820" end="02:15.940">s </span><span begin="02:15.940" end="02:16.090">your </span><span begin="02:16.090" end="02:18.400">turn</span></p><p ttm:agent="v1" begin="02:18.580" end="02:22.780"><span begin="02:18.580" end="02:18.940">To </span><span begin="02:18.940" end="02:19.420">be </span><span begin="02:19.420" end="02:19.630">at </span><span begin="02:19.630" end="02:19.870">your </span><span begin="02:19.870" end="02:22.780">worst</span></p><p ttm:agent="v1" begin="02:22.780" end="02:26.080"><span begin="02:22.780" end="02:23.020">I </span><span begin="02:23.020" end="02:23.470">hope </span><span begin="02:23.470" end="02:23.650">you </span><span begin="02:23.650" end="02:25.810">learn</span></p><p ttm:agent="v1" begin="02:26.080" end="02:30.790"><span begin="02:26.080" end="02:26.380">To </span><span begin="02:26.380" end="02:27.250">have </span><span begin="02:27.250" end="02:27.340">a </span><span begin="02:27.340" end="02:30.790">heart</span></p><p ttm:agent="v1" begin="02:30.790" end="02:37.420"><span begin="02:30.790" end="02:30.940">I</span><span begin="02:30.940" end="02:30.940">’</span><span begin="02:30.940" end="02:31.030">m </span><span begin="02:31.030" end="02:31.360">still </span><span begin="02:33.880" end="02:34.930">standing </span><span begin="02:34.930" end="02:37.420">here</span></p><p ttm:agent="v1" begin="02:37.420" end="02:41.230"><span begin="02:37.420" end="02:37.780">Met </span><span begin="02:37.780" end="02:38.170">your </span><span begin="02:38.170" end="02:39.340">demands </span><span begin="02:39.370" end="02:39.640">and </span><span begin="02:39.640" end="02:40.120">then </span><span begin="02:40.120" end="02:40.480">you </span><span begin="02:40.480" end="02:41.170">ran</span></p><p ttm:agent="v1" begin="02:41.230" end="02:44.980"><span begin="02:41.230" end="02:41.440">And </span><span begin="02:41.440" end="02:41.950">left </span><span begin="02:41.950" end="02:42.250">me </span><span begin="02:42.250" end="02:44.920">stranded</span></p><p ttm:agent="v1" begin="02:44.980" end="02:52.480"><span begin="02:44.980" end="02:45.280">I </span><span begin="02:45.280" end="02:45.730">ask </span><span begin="02:45.730" end="02:45.970">the </span><span begin="02:45.970" end="02:48.730">stars </span><span begin="02:48.730" end="02:48.730">“</span><span begin="02:48.730" end="02:49.000">why </span><span begin="02:49.000" end="02:49.540">did </span><span begin="02:49.540" end="02:49.840">I </span><span begin="02:49.840" end="02:52.480">fall</span><span begin="02:52.480" end="02:52.480">?</span><span begin="02:52.480" end="02:52.480">”</span></p><p ttm:agen