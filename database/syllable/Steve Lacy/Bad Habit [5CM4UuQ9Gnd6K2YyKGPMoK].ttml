.890">wanted </span><span begin="01:04.890" end="01:05.430">me </span><span begin="01:05.430" end="01:05.430">（</span><span begin="01:05.430" end="01:05.460">Oh</span><span begin="01:05.460" end="01:05.460">）</span></p><p ttm:agent="v1" begin="01:05.460" end="01:11.130"><span begin="01:05.460" end="01:05.760">I </span><span begin="01:05.760" end="01:06.180">wish </span><span begin="01:06.180" end="01:06.330">I </span><span begin="01:06.330" end="01:07.560">knew</span><span begin="01:07.560" end="01:08.190">, </span><span begin="01:08.190" end="01:08.520">I </span><span begin="01:08.520" end="01:09.000">wish </span><span begin="01:09.000" end="01:09.180">I </span><span begin="01:09.180" end="01:09.570">knew </span><span begin="01:09.570" end="01:09.990">you </span><span begin="01:09.990" end="01:10.500">wanted </span><span begin="01:10.500" end="01:11.130">me</span></p><p ttm:agent="v1" begin="01:11.130" end="01:18.570"><span begin="01:11.130" end="01:12.390">Please </span><span begin="01:12.390" end="01:12.450">say </span><span begin="01:12.450" end="01:12.510">to </span><span begin="01:12.510" end="01:12.600">me </span><span begin="01:12.600" end="01:12.600">（</span><span begin="01:12.600" end="01:12.720">Please</span><span begin="01:12.720" end="01:12.720">, </span><span begin="01:12.720" end="01:12.930">just </span><span begin="01:12.930" end="01:13.170">say </span><span begin="01:13.170" end="01:13.530">to </span><span begin="01:13.530" end="01:18.510">me</span><span begin="01:18.510" end="01:18.570">）</span></p><p ttm:agent="v1" begin="01:18.570" end="01:20.010"><span begin="01:18.570" end="01:18.630">If </span><span begin="01:18.630" end="01:18.780">you </span><span begin="01:18.780" end="01:19.200">still </span><span begin="01:19.200" end="01:20.010">wanna</span></p><p ttm:agent="v1" begin="01:21.750" end="01:26.730"><span begin="01:21.750" end="01:22.050">I </span><span begin="01:22.050" end="01:24.150">wish </span><span begin="01:24.150" end="01:24.540">you </span><span begin="01:24.540" end="01:24.930">wouldn't </span><span begin="01:24.930" end="01:25.290">play </span><span begin="01:25.290" end="01:25.650">with </span><span begin="01:25.650" end="01:26.730">me</span></p><p ttm:agent="v1" begin="01:27.000" end="01:35.220"><span begin="01:27.000" end="01:27.360">I </span><span begin="01:27.360" end="01:27.690">wanna </span><span begin="01:27.690" end="01:29.910">know </span><span begin="01:29.910" end="01:29.970">（</span><span begin="01:29.970" end="01:33.930">Oh</span><span begin="01:33.930" end="01:33.930">, </span><span begin="01:33.930" end="01:35.100">no</span><span begin="01:35.100" end="01:35.220">）</span></p><p ttm:agent="v1" begin="01:35.220" end="01:41.580"><span begin="01:35.220" end="01:35.610">Uh</span><span begin="01:35.610" end="01:35.820">, </span><span begin="01:35.820" end="01:36.120">can </span><span begin="01:36.120" end="01:36.240">I </span><span begin="01:36.240" end="01:36.660">bite </span><span begin="01:36.660" end="01:36.930">your </span><span begin="01:36.930" end="01:37.290">tongue </span><span begin="01:37.290" end="01:37.500">like </span><span begin="01:37.500" end="01:37.650">my </span><span begin="01:37.650" end="01:38.310">bad </span><span begin="01:38.310" end="01:39.690">habit</span><span begin="01:39.690" end="01:41.580">?</span></p><p ttm:agent="v1" begin="01:41.580" end="01:44.700"><span begin="01:41.580" end="01:41.760">Would </span><span begin="01:41.760" end="01:41.910">you </span><span begin="01:41.910" end="01:42.360">mind </span><span begin="01:42.360" end="01:42.510">if </span><span begin="01:42.510" end="01:42.600">I </span><span begin="01:42.600" end="01:42.840">tried </span><span begin="01:42.840" end="01:42.960">to </span><span begin="01:42.960" end="01:43.230">make </span><span begin="01:43.230" end="01:43.290">a </span><span begin="01:43.290" end="01:44.130">pass </span><span begin="01:44.130" end="01:44.340">at </span><span begin="01:44.340" end="01:44.670">it</span