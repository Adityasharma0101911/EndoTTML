<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Cody Freestyle</ttm:title><ttm:agent type="person" xml:id="v1">Steve Lacy</ttm:agent><ttm:item type="album">Gemini Rights</ttm:item><ttm:item type="spotify_id">2kk2trjT2JXhEHtCnz9FWA</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:12.940" end="00:16.690"><span begin="00:12.940" end="00:13.960">Sometimes </span><span begin="00:13.960" end="00:14.170">I </span><span begin="00:14.170" end="00:14.620">feel </span><span begin="00:14.620" end="00:14.800">the </span><span begin="00:14.800" end="00:16.690">weight</span></p><p ttm:agent="v1" begin="00:19.120" end="00:21.100"><span begin="00:19.120" end="00:19.480">Of </span><span begin="00:19.480" end="00:20.230">golden </span><span begin="00:20.230" end="00:20.650">bein' </span><span begin="00:20.650" end="00:21.100">contained</span></p><p ttm:agent="v1" begin="00:25.090" end="00:28.750"><span begin="00:25.090" end="00:25.420">I </span><span begin="00:25.420" end="00:25.900">don't </span><span begin="00:25.900" end="00:26.710">deserve </span><span begin="00:26.710" end="00:26.830">to </span><span begin="00:26.830" end="00:28.750">pain</span></p><p ttm:agent="v1" begin="00:31.090" end="00:34.780"><span begin="00:31.090" end="00:31.420">I </span><span begin="00:31.420" end="00:31.870">just </span><span begin="00:31.870" end="00:32.170">don't </span><span begin="00:32.170" end="00:32.650">feel </span><span begin="00:32.650" end="00:32.800">the </span><span begin="00:32.800" end="00:34.780">same</span></p><p ttm:agent="v1" begin="00:37.090" end="00:40.210"><span begin="00:37.090" end="00:37.420">My </span><span begin="00:37.420" end="00:38.380">feelings </span><span begin="00:38.380" end="00:38.740">I </span><span begin="00:38.740" end="00:40.210">attained</span></p><p ttm:agent="v1" begin="00:43.060" end="00:46.780"><span begin="00:43.060" end="00:43.390">They </span><span begin="00:43.390" end="00:44.200">trickle </span><span begin="00:44.200" end="00:44.680">down </span><span begin="00:44.680" end="00:44.800">the </span><span begin="00:44.800" end="00:46.780">drain</span></p><p ttm:agent="v1" begin="00:49.150" end="00:51.700"><span begin="00:49.150" end="00:49.510">I'm </span><span begin="00:49.510" end="00:49.900">just </span><span begin="00:49.900" end="00:50.350">not </span><span begin="00:50.350" end="00:51.700">entertained</span></p><p ttm:agent="v1" begin="00:55.060" end="00:58.750"><span begin="00:55.060" end="00:55.540">There </span><span begin="00:55.540" end="00:56.260">isn't </span><span begin="00:56.260" end="00:56.650">much </span><span begin="00:56.650" end="00:56.890">to </span><span begin="00:56.890" end="00:58.750">gain</span></p><p ttm:agent="v1" begin="01:01.090" end="01:06.880"><span begin="01:01.090" end="01:01.360">Why </span><span begin="01:01.360" end="01:01.510">you </span><span begin="01:01.510" end="01:01.900">bother </span><span begin="01:01.900" end="01:03.190">me</span><span begin="01:03.190" end="01:06.880">?</span></p><p ttm:agent="v1" begin="01:06.880" end="01:10.390"><span begin="01:06.880" end="01:07.300">Don't </span><span begin="01:07.300" end="01:07.960">depend </span><span begin="01:07.960" end="01:08.200">on </span><span begin="01:08.200" end="01:08.560">me</span><span begin="01:08.560" end="01:08.560">, </span><span begin="01:08.560" end="01:10.390">no</span></p><p ttm:agent="v1" begin="01:12.970" end="01:14.350"><span begin="01:12.970" end="01:13.390">Unless </span><span begin="01:13.390" end="01:13.480">you're </span><span begin="01:13.480" end="01:14.350">swallowing</span></p><p ttm:agent="v1" begin="01:18.910" end="01:21.040"><span begin="01:18.910" end="01:19.210">I </span><span begin="01:19.210" end="01:19.900">could </span><span begin="01:19.900" end="01:20.200">your </span><span begin="01:20.200" end="01:20.590">deep </span><span begin="01:20.590" end="01:21.040">throat</span></p><p ttm:agent="v1" begin="01:25.150" end="01:31.360"><span begin="01:25.150" end="01:25.390">We </span><span begin="01:25.390" end="01:25.570">don't </span><span begin="01:25.570" end="01:25.900">gotta </span><span begin="01:25.900" end="01:28.330">be </span><span begin="01:28.330" end="01:29.350">together </span><span begin="01:29.350" end="01:29.350">（</span><span begin="01:29.350" end="01:29.860">Together</span><span begin="01:29.860" end="01:29.860">）</span><span begin="01:29.860" end="01:29.860">, </span><span begin="01:29.860" end="01:30.700">forever </span><span begin="01:30.700" end="01:30.700">（</span><span begin="01:30.700" end="01:31.360">Forever</span><span begin="01:31.360" end="01:31.360">）</span></p><p ttm:agent="v1" begin="01:31.360" end="01:34.390"><span begin="01:31.360" end="01:31.570">'Cause </span><span begin="01:31.570" end="01:31.750">I </span><span begin="01:31.750" end="01:32.020">could </span><span begin="01:32.020" end="01:32.020">（</span><span begin="01:32.020" end="01:32.320">'Cause </span><span begin="01:32.320" end="01:32.500">I </span><span begin="01:32.500" end="01:32.950">could</span><span begin="01:32.950" end="01:32.950">） </span><span begin="01:32.950" end="01:33.040">do </span><span begin="01:33.040" end="01:34.120">better </span><span begin="01:34.120" end="01:34.120">（</span><span begin="01:34.120" end="01:34.240">Do </span><span begin="01:34.240" end="01:34.300">b</span><span begin="01:34.300" end="01:34.330">е</span><span begin="01:34.330" end="01:34.390">tter</span><span begin="01:34.390" end="01:34.390">）</span></p><p ttm:agent="v1" begin="01:34.390" end="01:37.390"><span begin="01:34.390" end="01:34.510">Or </span><span begin="01:34.510" end="01:35.230">settle </span><span begin="01:35.230" end="01:35.230">（</span><span begin="01:35.230" end="01:35.260">Or </span><span begin="01:35.260" end="01:35.410">s</span><span begin="01:35.410" end="01:35.620">е</span><span begin="01:35.620" end="01:35.890">ttle</span><span begin="01:35.890" end="01:35.890">） </span><span begin="01:35.890" end="01:36.010">for </span><span begin="01:36.010" end="01:36.730">lesser </span><span begin="01:36.730" end="01:36.730">（</span><span begin="01:36.730" end="01:36.790">For </span><span begin="01:36.790" end="01:37.390">lesser</span><span begin="01:37.390" end="01:37.390">）</span></p><p ttm:agent="v1" begin="01:37.390" end="01:40.450"><span begin="01:37.390" end="01:37.510">Or </span><span begin="01:37.510" end="01:38.290">Hector </span><span begin="01:38.290" end="01:38.290">（</span><span begin="01:38.290" end="01:38.320">Or </span><span begin="01:38.320" end="01:38.980">Hector</span><span begin="01:38.980" end="01:38.980">）</span><span begin="01:38.980" end="01:38.980">, </span><span begin="01:38.980" end="01:39.010">or </span><span begin="01:39.010" end="01:39.820">Jacob </span><span begin="01:39.820" end="01:39.820">（</span><span begin="01:39.820" end="01:39.850">Or </span><span begin="01:39.850" end="01:40.450">Jacob</span><span begin="01:40.450" end="01:40.450">）</span></p><p ttm:agent="v1" begin="01:40.450" end="01:42.760"><span begin="01:40.450" end="01:40.510">Or </span><span begin="01:40.510" end="01:41.140">Kenny </span><span begin="01:41.140" end="01:41.140">（</span><span begin="01:41.140" end="01:41.410">Or </span><span begin="01:41.410" end="01:41.890">Kenny</span><span begin="01:41.890" end="01:41.890">）</span><span begin="01:41.890" end="01:41.890">, </span><span begin="01:41.890" end="01:42.040">there's </span><span begin="01:42.040" end="01:42.760">plenty</span></p><p ttm:agent="v1" begin="01:42.760" end="01:44.620"><span begin="01:42.760" end="01:43.000">Through </span><span begin="01:43.000" end="01:43.120">the </span><span begin="01:43.120" end="01:43.840">city</span><span begin="01:43.840" end="01:43.840">, </span><span begin="01:43.840" end="01:44.110">so </span><span begin="01:44.110" end="01:44.260">be </span><span begin="01:44.260" end="01:44.620">ghetto</span></p><p ttm:agent="v1" begin="01:44.620" end="01:46.690"><span begin="01:44.620" end="01:44.800">I'll </span><span begin="01:44.800" end="01:44.950">be </span><span begin="01:44.950" end="01:45.670">tempted</span><span begin="01:45.670" end="01:45.700">, </span><span begin="01:45.700" end="01:46.090">temper </span><span begin="01:46.090" end="01:46.690">tantrum</span></p><p ttm:agent="v1" begin="01:46.810" end="01:48.550"><span begin="01:46.810" end="01:47.110">Said</span><span begin="01:47.110" end="01:47.110">, </span><span begin="01:47.110" end="01:47.140">"</span><span begin="01:47.140" end="01:47.230">I </span><span begin="01:47.230" end="01:47.500">love </span><span begin="01:47.500" end="01:47.620">you</span><span begin="01:47.620" end="01:47.620">,</span><span begin="01:47.620" end="01:47.650">" </span><span begin="01:47.650" end="01:47.980">never </span><span begin="01:47.980" end="01:48.370">meant </span><span begin="01:48.370" end="01:48.550">it</span></p><p ttm:agent="v1" begin="01:48.730" end="01:51.550"><span begin="01:48.730" end="01:48.940">You </span><span begin="01:48.940" end="01:49.180">were </span><span begin="01:49.180" end="01:49.780">handsome</span><span begin="01:49.780" end="01:49.900">, </span><span begin="01:49.900" end="01:50.170">with </span><span begin="01:50.170" end="01:50.260">a </span><span begin="01:50.260" end="01:50.650">heavy </span><span begin="01:50.650" end="01:50.920">dick</span><span begin="01:50.920" end="01:50.920">, </span><span begin="01:50.920" end="01:51.010">a </span><span begin="01:51.010" end="01:51.550">cannon</span></p><p ttm:agent="v1" begin="01:51.760" end="01:52.750"><span begin="01:51.760" end="01:52.000">You </span><span begin="01:52.000" end="01:52.150">do </span><span begin="01:52.150" end="01:52.750">damage</span></p><p ttm:agent="v1" begin="01:52.780" end="01:55.990"><span begin="01:52.780" end="01:52.960">You </span><span begin="01:52.960" end="01:53.290">really </span><span begin="01:53.290" end="01:53.710">workin' </span><span begin="01:53.710" end="01:53.920">with </span><span begin="01:53.920" end="01:54.070">your </span><span begin="01:54.070" end="01:55.990">resources</span></p><p ttm:agent="v1" begin="01:56.130" end="01:58.600"><span begin="01:56.130" end="01:56.310">And </span><span begin="01:56.310" end="01:56.710">baby</span><span begin="01:56.710" end="01:56.710">, </span><span begin="01:56.710" end="01:56.850">I </span><span begin="01:56.850" end="01:57.030">ain't </span><span begin="01:57.030" end="01:57.490">mad </span><span begin="01:57.490" end="01:58.210">at </span><span begin="01:58.210" end="01:58.600">it</span></p><p ttm:agent="v1" begin="01:58.600" end="02:01.780"><span begin="01:58.600" end="01:58.900">It's </span><span begin="01:58.900" end="01:59.110">just </span><span begin="01:59.110" end="01:59.350">that </span><span begin="01:59.350" end="01:59.470">I </span><span begin="01:59.470" end="01:59.620">don't </span><span begin="01:59.620" end="01:59.860">like </span><span begin="01:59.860" end="02:00.010">that </span><span begin="02:00.010" end="02:00.430">type </span><span begin="02:00.430" end="02:01.780">passion</span></p><p ttm:agent="v1" begin="02:01.780" end="02:04.720"><span begin="02:01.780" end="02:01.960">If </span><span begin="02:01.960" end="02:02.110">you </span><span begin="02:02.110" end="02:02.290">not </span><span begin="02:02.290" end="02:02.620">tryna </span><span begin="02:02.620" end="02:02.890">put </span><span begin="02:02.890" end="02:03.010">the </span><span begin="02:03.010" end="02:03.460">leg </span><span begin="02:03.460" end="02:04.300">work </span><span begin="02:04.300" end="02:04.720">in</span></p><p ttm:agent="v1" begin="02:07.090" end="02:08.710"><span begin="02:07.090" end="02:07.360">Please </span><span begin="02:07.360" end="02:07.540">don't </span><span begin="02:07.540" end="02:07.900">bother </span><span begin="02:07.900" end="02:08.710">me</span></p><p ttm:agent="v1" begin="02:12.940" end="02:15.730"><span begin="02:12.940" end="02:13.360">Don't </span><span begin="02:13.360" end="02:13.990">depend </span><span begin="02:13.990" end="02:14.260">on </span><span begin="02:14.260" end="02:14.590">me</span><span begin="02:14.590" end="02:14.590">, </span><span begin="02:14.590" end="02:15.730">no</span></p><p ttm:agent="v1" begin="02:19.150" end="02:24.760"><span begin="02:19.150" end="02:19.360">Are </span><span begin="02:19.360" end="02:19.540">you </span><span begin="02:19.540" end="02:20.350">following</span><span begin="02:20.350" end="02:24.760">?</span></p><p ttm:agent="v1" begin="02:24.760" end="02:26.950"><span begin="02:24.760" end="02:25.120">I </span><span begin="02:25.120" end="02:25.540">never </span><span begin="02:25.540" end="02:25.990">asked </span><span begin="02:25.990" end="02:26.140">for </span><span begin="02:26.140" end="02:26.440">that </span><span begin="02:26.440" end="02:26.950">much</span></p><p ttm:agent="v1" begin="02:26.950" end="02:37.720"><span begin="02:26.950" end="02:27.516">Mm</span><span begin="02:27.516" end="02:28.082">, </span><span begin="02:28.082" end="02:28.648">mm</span><span begin="02:28.648" end="02:29.214">, </span><span begin="02:29.214" end="02:29.780">mm</span><span begin="02:29.780" end="02:30.346">-</span><span begin="02:30.346" end="02:30.912">mm</span><span begin="02:30.912" end="02:31.478">-</span><span begin="02:31.478" end="02:32.044">mm</span><span begin="02:32.044" end="02:32.610">-</span><span begin="02:32.6