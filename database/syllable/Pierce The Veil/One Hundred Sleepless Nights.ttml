<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>One Hundred Sleepless Nights</ttm:title><ttm:agent type="person" xml:id="v1">Pierce The Veil</ttm:agent><ttm:item type="album">Collide With The Sky</ttm:item><ttm:item type="spotify_id">5TNX6rJ91T8PdEt94X50Y9</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:05.340" end="00:09.900"><span begin="00:05.340" end="00:05.490">I </span><span begin="00:05.490" end="00:06.000">can't </span><span begin="00:06.000" end="00:07.230">wait </span><span begin="00:07.230" end="00:07.410">to </span><span begin="00:07.410" end="00:07.830">see </span><span begin="00:07.830" end="00:08.010">your </span><span begin="00:08.010" end="00:08.970">brilliant </span><span begin="00:08.970" end="00:09.870">face</span><span begin="00:09.870" end="00:09.900">,</span></p><p ttm:agent="v1" begin="00:09.900" end="00:13.500"><span begin="00:09.900" end="00:10.350">Light </span><span begin="00:10.350" end="00:10.530">up </span><span begin="00:10.530" end="00:10.770">the </span><span begin="00:10.770" end="00:11.340">room </span><span begin="00:11.340" end="00:11.790">around </span><span begin="00:11.790" end="00:11.910">the </span><span begin="00:11.910" end="00:13.500">pillowcase</span></p><p ttm:agent="v1" begin="00:13.770" end="00:17.310"><span begin="00:13.770" end="00:14.220">can </span><span begin="00:14.220" end="00:14.370">you </span><span begin="00:14.370" end="00:14.730">come </span><span begin="00:14.730" end="00:15.330">over </span><span begin="00:15.330" end="00:15.570">to </span><span begin="00:15.570" end="00:16.290">my </span><span begin="00:16.290" end="00:16.740">LA </span><span begin="00:16.740" end="00:17.280">place</span><span begin="00:17.280" end="00:17.310">,</span></p><p ttm:agent="v1" begin="00:17.310" end="00:21.660"><span begin="00:17.310" end="00:17.730">Got </span><span begin="00:17.730" end="00:18.390">something </span><span begin="00:18.390" end="00:18.510">to </span><span begin="00:18.510" end="00:19.050">tell </span><span begin="00:19.050" end="00:19.470">you </span><span begin="00:19.470" end="00:19.620">and </span><span begin="00:19.620" end="00:19.740">it </span><span begin="00:19.740" end="00:20.250">just </span><span begin="00:20.250" end="00:20.700">can't </span><span begin="00:20.700" end="00:21.660">wait</span><span begin="00:21.660" end="00:21.660">!</span></p><p ttm:agent="v1" begin="00:21.660" end="00:25.350"><span begin="00:21.660" end="00:21.780">And </span><span begin="00:21.780" end="00:21.900">I </span><span begin="00:21.900" end="00:22.650">showed </span><span begin="00:22.650" end="00:22.920">up</span><span begin="00:22.920" end="00:22.950">, </span><span begin="00:22.950" end="00:23.220">you </span><span begin="00:23.220" end="00:23.520">held </span><span begin="00:23.520" end="00:23.640">the </span><span begin="00:23.640" end="00:24.240">door </span><span begin="00:24.240" end="00:24.570">in </span><span begin="00:24.570" end="00:25.350">tears</span></p><p ttm:agent="v1" begin="00:25.500" end="00:29.100"><span begin="00:25.500" end="00:26.010">Sat </span><span begin="00:26.010" end="00:26.190">on </span><span begin="00:26.190" end="00:26.310">the </span><span begin="00:26.310" end="00:27.000">couch </span><span begin="00:27.000" end="00:27.420">under </span><span begin="00:27.420" end="00:27.540">the </span><span begin="00:27.540" end="00:29.100">chandelier</span></p><p ttm:agent="v1" begin="00:29.100" end="00:33.240"><span begin="00:29.100" end="00:29.160">You </span><span begin="00:29.160" end="00:29.370">said</span><span begin="00:29.370" end="00:29.370">, </span><span begin="00:29.370" end="00:29.550">you're </span><span begin="00:29.550" end="00:30.150">having </span><span begin="00:30.150" end="00:30.270">a </span><span begin="00:30.270" end="00:31.200">baby </span><span begin="00:31.200" end="00:31.350">and </span><span begin="00:31.350" end="00:31.890">before </span><span begin="00:31.890" end="00:32.070">I </span><span begin="00:32.070" end="00:32.370">could </span><span begin="00:32.370" end="00:33.210">cry</span><span begin="00:33.210" end="00:33.240">,</span></p><p ttm:agent="v1" begin="00:33.240" end="00:37.260"><span begin="00:33.240" end="00:33.450">You're </span><span begin="00:33.450" end="00:34.080">leaving </span><span begin="00:34.080" end="00:34.320">me </span><span begin="00:34.320" end="00:34.830">just </span><span begin="00:34.830" end="00:35.190">when </span><span begin="00:35.190" end="00:35.310">I </span><span begin="00:35.310" end="00:35.760">thought </span><span begin="00:35.760" end="00:36.060">you </span><span begin="00:36.060" end="00:36.300">were </span><span begin="00:36.300" end="00:37.260">mine</span></p><p ttm:agent="v1" begin="00:37.260" end="00:42.570"><span begin="00:37.260" end="00:37.470">But </span><span begin="00:37.470" end="00:38.400">I </span><span begin="00:38.400" end="00:39.180">don't </span><span begin="00:39.180" end="00:40.170">see </span><span begin="00:40.170" end="00:40.950">your </span><span begin="00:40.950" end="00:42.570">face</span></p><p ttm:agent="v1" begin="00:42.930" end="00:45.840"><span begin="00:42.930" end="00:43.710">Taken </span><span begin="00:43.710" end="00:44.040">by </span><span begin="00:44.040" end="00:44.190">the </span><span begin="00:44.190" end="00:44.490">one </span><span begin="00:44.490" end="00:45.000">hearted </span><span begin="00:45.000" end="00:45.840">race</span></p><p ttm:agent="v1" begin="00:45.960" end="00:50.010"><span begin="00:45.960" end="00:46.440">Oh</span><span begin="00:46.440" end="00:46.950">, </span><span begin="00:46.950" end="00:47.100">no</span><span begin="00:47.100" end="00:47.100">! </span><span begin="00:47.100" end="00:47.610">Don't </span><span begin="00:47.610" end="00:48.120">tell </span><span begin="00:48.120" end="00:48.390">your </span><span begin="00:48.390" end="00:48.840">other </span><span begin="00:48.840" end="00:50.010">man</span></p><p ttm:agent="v1" begin="00:50.280" end="00:52.890"><span begin="00:50.280" end="00:50.490">I've </span><span begin="00:50.490" end="00:50.910">got </span><span begin="00:50.910" end="00:50.940">a </span><span begin="00:50.940" end="00:51.780">hell </span><span begin="00:51.780" end="00:52.050">of </span><span begin="00:52.050" end="00:52.110">a </span><span begin="00:52.110" end="00:52.890">plan</span></p><p ttm:agent="v1" begin="00:52.890" end="00:56.040"><span begin="00:52.890" end="00:54.480">Failing </span><span begin="00:54.480" end="00:56.040">lights</span><span begin="00:56.040" end="00:56.040">!</span></p><p ttm:agent="v1" begin="00:56.040" end="00:59.760"><span begin="00:56.040" end="00:56.190">And </span><span begin="00:56.190" end="00:56.430">that's </span><span begin="00:56.430" end="00:56.880">one </span><span begin="00:56.880" end="00:57.690">hundred </span><span begin="00:57.690" end="00:58.650">sleepless </span><span begin="00:58.650" end="00:59.760">nights</span></p><p ttm:agent="v1" begin="00:59.760" end="01:03.600"><span begin="00:59.760" end="00:59.970">And </span><span begin="00:59.970" end="01:00.150">I </span><span begin="01:00.150" end="01:00.510">might </span><span begin="01:00.510" end="01:00.750">be </span><span begin="01:00.750" end="01:01.740">holding </span><span begin="01:01.740" end="01:02.070">on </span><span begin="01:02.070" end="01:02.490">too </span><span begin="01:02.490" end="01:03.600">tight</span></p><p ttm:agent="v1" begin="01:03.630" end="01:06.090"><span begin="01:03.630" end="01:03.780">But </span><span begin="01:03.780" end="01:04.350">there's </span><span begin="01:04.350" end="01:04.470">a </span><span begin="01:04.470" end="01:05.160">beast </span><span begin="01:05.160" end="01:05.280">in </span><span begin="01:05.280" end="01:05.520">my </span><span begin="01:05.520" end="01:06.090">heart</span></p><p ttm:agent="v1" begin="01:06.090" end="01:11.610"><span begin="01:06.090" end="01:06.300">and </span><span begin="01:06.300" end="01:06.420">he </span><span begin="01:06.420" end="01:07.050">won't </span><span begin="01:07.050" end="01:07.260">let </span><span begin="01:07.260" end="01:07.500">you </span><span begin="01:07.500" end="01:08.100">leave </span><span begin="01:08.100" end="01:11.610">alive</span></p><p ttm:agent="v1" begin="01:11.820" end="01:16.470"><span begin="01:11.820" end="01:13.650">Nightmares</span><span begin="01:13.650" end="01:13.830">, </span><span begin="01:13.830" end="01:14.010">no </span><span begin="01:14.010" end="01:14.520">longer </span><span begin="01:14.520" end="01:15.000">wait </span><span begin="01:15.000" end="01:15.360">for </span><span begin="01:15.360" end="01:16.470">sleep</span></p><p ttm:agent="v1" begin="01:16.470" end="01:19.740"><span begin="01:16.470" end="01:16.860">Crawl </span><span begin="01:16.860" end="01:17.070">on </span><span begin="01:17.070" end="01:17.190">the </span><span begin="01:17.190" end="01:17.880">ground</span><span begin="01:17.880" end="01:17.880">, </span><span begin="01:17.880" end="01:18.060">up </span><span begin="01:18.060" end="01:18.270">on </span><span begin="01:18.270" end="01:18.450">your </span><span begin="01:18.450" end="01:19.020">hands </span><span begin="01:19.020" end="01:19.410">and </span><span begin="01:19.410" end="01:19.740">knees</span></p><p ttm:agent="v1" begin="01:19.740" end="01:24.150"><span begin="01:19.740" end="01:19.980">Just </span><span begin="01:19.980" end="01:20.310">like </span><span begin="01:20.310" end="01:20.430">a</span><span begin="01:20.430" end="01:21.210">, </span><span begin="01:21.210" end="01:21.780">lion </span><span begin="01:21.780" end="01:21.900">and </span><span begin="01:21.900" end="01:22.170">you're </span><span begin="01:22.170" end="01:22.320">the </span><span begin="01:22.320" end="01:22.770">queen </span><span begin="01:22.770" end="01:23.040">of </span><span begin="01:23.040" end="01:23.250">the </span><span begin="01:23.250" end="01:24.150">pride</span></p><p ttm:agent="v1" begin="01:24.150" end="01:28.140"><span begin="01:24.150" end="01:24.300">And </span><span begin="01:24.300" end="01:24.630">we </span><span begin="01:24.630" end="01:24.810">will </span><span begin="01:24.810" end="01:25.170">feast </span><span begin="01:25.170" end="01:25.770">together </span><span begin="01:25.770" end="01:26.070">till </span><span begin="01:26.070" end="01:26.250">the </span><span begin="01:26.250" end="01:26.850">bones </span><span begin="01:26.850" end="01:27.180">are </span><span begin="01:27.180" end="01:28.110">dry</span><span begin="01:28.110" end="01:28.140">!</span></p><p ttm:agent="v1" begin="01:28.140" end="01:32.430"><span begin="01:28.140" end="01:28.350">But </span><span begin="01:28.350" end="01:29.100">I </span><span begin="01:29.100" end="01:30.060">don't </span><span begin="01:30.060" end="01:30.990">see </span><span begin="01:30.990" end="01:31.800">your </span><span begin="01:31.800" end="01:32.430">face</span></p><p ttm:agent="v1" begin="01:33.900" end="01:36.810"><span begin="01:33.900" end="01:34.560">Taken </span><span begin="01:34.560" end="01:34.920">by </span><span begin="01:34.920" end="01:35.070">the </span><span begin="01:35.070" end="01:35.400">one </span><span begin="01:35.400" end="01:36.060">hearted </span><span begin="01:36.060" end="01:36.810">race</span></p><p ttm:agent="v1" begin="01:36.840" end="01:41.610"><span begin="01:36.840" end="01:37.200">Oh</span><span begin="01:37.200" end="01:37.200">, </span><span begin="01:37.200" end="01:37.800">no</span><span begin="01:37.800" end="01:37.980">! </span><span begin="01:37.980" end="01:38.460">Don't </span><span begin="01:38.460" end="01:38.970">tell </span><span begin="01:38.970" end="01:39.390">your </span><span begin="01:39.390" end="01:39.720">other </span><span begin="01:39.720" end="01:41.610">man</span></p><p ttm:agent="v1" begin="01:41.610" end="01:43.800"><span begin="01:41.610" end="01:41.730">It's </span><span begin="01:41.730" end="01:41.880">a </span><span begin="01:41.880" end="01:42.810">wonderful </span><span begin="01:42.810" end="01:43.800">plan</span><span begin="01:43.800" end="01:43.800">!</span></p><p ttm:agent="v1" begin="01:43.800" end="01:46.770"><span begin="01:43.800" end="01:45.330">Failing </span><span begin="01:45.330" end="01:46.770">lights</span><span begin="01:46.770" end="01:46.770">!</span></p><p ttm:agent="v1" begin="01:46.770" end="01:50.640"><span begin="01:46.770" end="01:46.860">And </span><span begin="01:46.860" end="01:47.310">that's </span><span begin="01:47.310" end="01:47.760">one </span><span begin="01:47.760" end="01:48.570">hundred </span><span begin="01:48.570" end="01:49.530">sleepless </span><span begin="01:49.530" end="01:50.640">nights</span></p><p ttm:agent="v1" begin="01:50.640" end="01:54.450"><span begin="01:50.640" end="01:50.850">And </span><span begin="01:50.850" end="01:51.000">I </span><span begin="01:51.000" end="01:51.390">might </span><span begin="01:51.390" end="01:51.600">be </span><span begin="01:51.600" end="01:52.590">holding </span><span begin="01:52.590" end="01:52.950">on </span><span begin="01:52.950" end="01:53.340">too </span><span begin="01:53.340" end="01:54.450">tight</span></p><p ttm:agent="v1" begin="01:54.480" end="01:56.970"><span begin="01:54.480" end="01:54.630">But </span><span begin="01:54.630" end="01:55.230">there's </span><span begin="01:55.230" end="01:55.350">a </span><span begin="01:55.350" end="01:56.040">beast </span><span begin="01:56.040" end="01:56.160">in </span><span begin="01:56.160" end="01:56.370">my </span><span begin="01:56.370" end="01:56.970">heart</span></p><p ttm:agent="v1" begin="01:56.970" end="01:59.190"><span begin="01:56.970" end="01:57.150">and </span><span begin="01:57.150" end="01:57.300">he </span><span begin="01:57.300" end="01:57.900">won't </span><span begin="01:57.900" end="01:58.140">let </span><span begin="01:58.140" end="01:58.380">you </span><span begin="01:58.380" end="01:58.950">leave </span><span begin="01:58.950" end="01:59.190">alive</span><span begin="01:59.190" end="01:59.190">!</span></p><p ttm:agent="v1" begin="01:59.190" end="02:02.490"><span begin="01:59.190" end="02:00.030">Do </span><span begin="02:00.030" end="02:00.330">you </span><span begin="02:00.330" end="02:01.050">still </span><span begin="02:01.050" end="02:01.980">love </span><span begin="02:01.980" end="02:02.460">me</span><span begin="02:02.460" end="02:02.490">?</span></p><p ttm:agent="v1" begin="02:02.490" end="02:06.060"><span begin="02:02.490" end="02:03.030">I </span><span begin="02:03.030" end="02:03.420">am </span><span begin="02:03.420" end="02:04.320">dying </span><span begin="02:04.320" end="02:04.710">to </span><span begin="02:04.710" end="02:06.030">know</span><span begin="02:06.030" end="02:06.060">!</span></p><p ttm:agent="v1" begin="02:06.060" end="02:10.500"><span begin="02:06.060" end="02:06.330">Or </span><span begin="02:06.330" end="02:06.720">did </span><span begin="02:06.720" end="02:06.990">you </span><span begin="02:06.990" end="02:07.830">forget </span><span begin="02:07.830" end="02:08.280">what </span><span begin="02:08.280" end="02:08.670">we </span><span begin="02:08.670" end="02:10.140">shared</span><span begin="02:10.140" end="02:10.500">?</span></p><p ttm:agent="v1" begin="02:10.500" end="02:12.690"><span begin="02:10.500" end="02:11.010">Out </span><span begin="02:11