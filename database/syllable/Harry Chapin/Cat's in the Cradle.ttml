4.569">other </span><span begin="00:14.569" end="00:14.929">day</span></p><p ttm:agent="v1" begin="00:15.769" end="00:18.379"><span begin="00:15.769" end="00:15.999">He </span><span begin="00:15.999" end="00:16.469">came </span><span begin="00:16.469" end="00:16.659">to </span><span begin="00:16.659" end="00:17.019">the </span><span begin="00:17.019" end="00:17.369">world </span><span begin="00:17.369" end="00:17.609">in </span><span begin="00:17.609" end="00:17.809">the </span><span begin="00:17.809" end="00:17.989">usual </span><span begin="00:17.989" end="00:18.379">way</span></p><p ttm:agent="v1" begin="00:18.749" end="00:20.829"><span begin="00:18.749" end="00:18.899">But </span><span begin="00:18.899" end="00:19.129">there </span><span begin="00:19.129" end="00:19.319">were </span><span begin="00:19.319" end="00:19.499">planes </span><span begin="00:19.499" end="00:19.689">to </span><span begin="00:19.689" end="00:20.389">catch </span></p><p ttm:agent="v1" begin="00:20.389" end="00:21.539"><span begin="00:20.389" end="00:20.689">And </span><span begin="00:20.689" end="00:20.939">bills </span><span begin="00:20.939" end="00:21.119">to </span><span begin="00:21.119" end="00:21.539">pay</span></p><p ttm:agent="v1" begin="00:22.619" end="00:25.739"><span begin="00:22.619" end="00:22.819">He </span><span begin="00:22.819" end="00:23.059">learned </span><span begin="00:23.059" end="00:23.319">to </span><span begin="00:23.319" end="00:23.669">walk </span><span begin="00:23.669" end="00:23.889">while </span><span begin="00:23.889" end="00:24.059">I </span><span begin="00:24.059" end="00:24.249">was </span><span begin="00:24.249" end="00:24.609">away  </span><span begin="00:24.989" end="00:25.219">and </span><span begin="00:25.219" end="00:25.389">he </span><span begin="00:25.389" end="00:25.739">was</span></p><p ttm:agent="v1" begin="00:25.739" end="00:26.919"><span begin="00:25.739" end="00:25.889">Talkin' </span><span begin="00:25.889" end="00:26.069">'fore </span><span begin="00:26.069" end="00:26.229">I </span><span begin="00:26.229" end="00:26.419">knew </span><span begin="00:26.419" end="00:26.919">it </span></p><p ttm:agent="v1" begin="00:26.919" end="00:28.599"><span begin="00:26.919" end="00:27.109">And </span><span begin="00:27.109" end="00:27.289">as </span><span begin="00:27.289" end="00:27.479">he </span><span begin="00:27.479" end="00:27.809">grew  </span><span begin="00:27.809" end="00:28.189">he </span><span begin="00:28.189" end="00:28.599">said:</span></p><p ttm:agent="v1" begin="00:28.599" end="00:31.667"><span begin="00:28.599" end="00:28.789">I'm </span><span begin="00:28.789" end="00:29.078">gonna </span><span begin="00:29.078" end="00:29.567">be </span><span begin="00:29.567" end="00:29.957">like </span><span begin="00:29.957" end="00:31.207">you  </span><span begin="00:31.207" end="00:31.667">dad </span></p><p ttm:agent="v1" begin="00:31.917" end="00:34.717"><span begin="00:31.917" end="00:32.107">You </span><span begin="00:32.107" end="00:32.317">know </span><span begin="00:32.317" end="00:32.517">I'm </span><span begin="00:32.517" end="00:33.007">gonna </span><span begin="00:33.007" end="00:33.277">be </span><span begin="00:33.277" end="00:33.517">like </span><span begin="00:33.517" end="00:34.717">you</span></p><p ttm:agent="v1" begin="00:36.467" end="00:38.037"><span begin="00:36.467" end="00:36.687">And </span><span begin="00:36.687" end="00:36.877">the </span><span begin="00:36.877" end="00:37.117">cat's </span><span begin="00:37.117" end="00:37.347">in </span><span begin="00:37.347" end="00:37.567">the </span><span begin="00:37.567" end="00:38.037">cradle </span></p><p ttm:agent="v1" begin="00:38.037" end="00:39.977"><span begin="00:38.037" end="00:38.257">And </span><span begin="00:38.257" end="00:38.467">the </span><span begin="00:38.467" end="00:38.807">silver </span><span begin="00:38.807" end="00:39.977">spoon</span></p><p ttm:agent="v1" begin="00:39.977" end="00:42.997"><span begin="00:39.977" end="00:40.197">Little </span><span begin="00:40.197" end="00:40.407">boy </span><span begin="00:40.407" end="00:40.617">blue </span><span begin="00:40.617" end="00:40.847">and </span><span begin="00:40.847" end="00:41.077">the </span><span begin="00:41.077" end="00:41.287">man </span><span begin="00:41.287" end="00:41.487">on </span><span begin="00:41.487" end="00:41.697">the </span><span begin="00:41.697" end="00:42.997">moon</span></p><p ttm:agent="v1" begin="00:42.997" end="00:44.247"><span begin="00:42.997" end="00:43.237">When </span><span begin="00:43.237" end="00:43.467">you </span><span begin="00:43.467" end="00:43.687">comin' </span><span begin="00:43.687" end="00:44.247">home </span></p><p ttm:agent="v1" begin="00:44.247" end="00:46.037"><span begin="00:44.247" end="00:44.477">Dad  </span><span begin="00:44.477" end="00:44.697">I </span><span begin="00:44.697" end="00:44.927">don't </span><span begin="00:44.927" end="00:45.127">know </span><span begin="00:45.127" end="00:46.037">when</span></p><p ttm:agent="v1" begin="00:46.037" end="00:48.137"><span begin="00:46.037" end="00:46.287">But </span><span begin="00:46.287" end="00:46.537">we'll </span><span begin="00:46.537" end="00:46.797">get </span><span begin="00:46.797" end="00:47.047">together </span><span begin="00:47.047" end="00:48.137">then </span></p><p ttm:agent="v1" begin="00:49.147" end="00:51.527"><span begin="00:49.147" end="00:49.417">You </span><span begin="00:49.417" end="00:49.627">know </span><span begin="00:49.627" end="00:49.917">we'll </span><span begin="00:49.917" end="00:50.267">have </span><span begin="00:50.267" end="00:50.557">a </span><span begin="00:50.557" end="00:50.807">good </span><span begin="00:50.807" end="00:50.987">time </span><span begin="00:50.987" end="00:51.527">then </span></p><p ttm:agent="v1" begin="01:01.146" end="01:04.446"><span begin="01:01.146" end="01:01.356">My </span><span begin="01:01.356" end="01:01.556">son </span><span begin="01:01.556" end="01:01.77