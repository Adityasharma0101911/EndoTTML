<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>The Best Day Ever (with Sandy, Mr. Krabs, Plankton &amp; Patrick)</ttm:title><ttm:agent type="group" xml:id="v1">SpongeBob SquarePants, Sandy, Mr. Krabs, Plankton, Patrick</ttm:agent><ttm:item type="album">SpongeBob's Greatest Hits</ttm:item><ttm:item type="spotify_id">3w1y6784w2YbKqGR7gGdoe</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:09.250" end="00:13.600"><span begin="00:09.250" end="00:09.760">Mr</span><span begin="00:09.760" end="00:09.760">. </span><span begin="00:09.760" end="00:10.210">Sun </span><span begin="00:10.210" end="00:10.780">came </span><span begin="00:10.780" end="00:11.200">up </span><span begin="00:11.200" end="00:11.530">and </span><span begin="00:11.530" end="00:11.620">he </span><span begin="00:11.620" end="00:12.100">smiled </span><span begin="00:12.100" end="00:12.400">at </span><span begin="00:12.400" end="00:13.600">me</span></p><p ttm:agent="v1" begin="00:16.660" end="00:21.100"><span begin="00:16.660" end="00:17.170">Said </span><span begin="00:17.170" end="00:17.290">it's </span><span begin="00:17.290" end="00:17.740">gonna </span><span begin="00:17.740" end="00:18.100">be </span><span begin="00:18.100" end="00:18.190">a </span><span begin="00:18.190" end="00:18.550">good </span><span begin="00:18.550" end="00:18.730">one </span><span begin="00:18.730" end="00:19.120">just </span><span begin="00:19.120" end="00:19.540">wait </span><span begin="00:19.540" end="00:19.870">and </span><span begin="00:19.870" end="00:21.100">see</span></p><p ttm:agent="v1" begin="00:25.090" end="00:29.950"><span begin="00:25.090" end="00:25.810">Jumped </span><span begin="00:25.810" end="00:26.170">out </span><span begin="00:26.170" end="00:26.440">of </span><span begin="00:26.440" end="00:27.520">bed </span><span begin="00:27.520" end="00:28.120">and </span><span begin="00:28.120" end="00:28.480">I </span><span begin="00:28.480" end="00:28.930">ran </span><span begin="00:28.930" end="00:29.950">outside</span></p><p ttm:agent="v1" begin="00:29.950" end="00:32.680"><span begin="00:29.950" end="00:30.400">Feeling </span><span begin="00:30.400" end="00:30.970">so </span><span begin="00:30.970" end="00:31.870">extra </span><span begin="00:31.870" end="00:32.680">exsatisfied</span></p><p ttm:agent="v1" begin="00:32.680" end="00:38.380"><span begin="00:32.680" end="00:33.940">It's </span><span begin="00:33.940" end="00:34.060">the </span><span begin="00:34.060" end="00:35.080">best </span><span begin="00:35.080" end="00:36.100">day </span><span begin="00:36.100" end="00:38.380">ever</span></p><p ttm:agent="v1" begin="00:38.380" end="00:41.350"><span begin="00:38.380" end="00:38.380">（</span><span begin="00:38.380" end="00:38.890">Best </span><span begin="00:38.890" end="00:40.660">day </span><span begin="00:40.660" end="00:41.350">ever</span><span begin="00:41.350" end="00:41.350">）</span></p><p ttm:agent="v1" begin="00:41.350" end="00:45.430"><span begin="00:41.350" end="00:42.166">It's </span><span begin="00:42.166" end="00:42.982">the </span><span begin="00:42.982" end="00:43.798">best </span><span begin="00:43.798" end="00:44.614">day </span><span begin="00:44.614" end="00:45.430">ever</span></p><p ttm:agent="v1" begin="00:45.430" end="00:49.090"><span begin="00:45.430" end="00:45.430">（</span><span begin="00:45.430" end="00:46.330">Best </span><span begin="00:46.330" end="00:48.130">day </span><span begin="00:48.130" end="00:49.030">ever</span><span begin="00:49.030" end="00:49.090">）</span></p><p ttm:agent="v1" begin="00:49.090" end="00:53.410"><span begin="00:49.090" end="00:49.510">I'm </span><span begin="00:49.510" end="00:49.960">so </span><span begin="00:49.960" end="00:50.560">busy </span><span begin="00:50.560" end="00:50.950">got </span><span begin="00:50.950" end="00:51.550">nothing </span><span begin="00:51.550" end="00:51.760">to </span><span begin="00:51.760" end="00:53.410">do</span></p><p ttm:agent="v1" begin="00:55.900" end="01:00.460"><span begin="00:55.900" end="00:56.500">Spent </span><span begin="00:56.500" end="00:56.650">the </span><span begin="00:56.650" end="00:57.130">last </span><span begin="00:57.130" end="00:57.610">two </span><span begin="00:57.610" end="00:58.120">hours </span><span begin="00:58.120" end="00:58.510">just </span><span begin="00:58.510" end="00:59.050">tying </span><span begin="00:59.050" end="00:59.380">my </span><span begin="00:59.380" end="01:00.460">shoe</span></p><p ttm:agent="v1" begin="01:05.110" end="01:09.460"><span begin="01:05.110" end="01:05.950">Every </span><span begin="01:05.950" end="01:07.060">flower</span><span begin="01:07.060" end="01:07.060">, </span><span begin="01:07.060" end="01:07.840">every </span><span begin="01:07.840" end="01:08.350">grain </span><span begin="01:08.350" end="01:08.590">of </span><span begin="01:08.590" end="01:09.460">sand</span></p><p ttm:agent="v1" begin="01:09.490" end="01:13.060"><span begin="01:09.490" end="01:09.790">Is </span><span begin="01:09.790" end="01:10.630">reaching </span><span begin="01:10.630" end="01:11.200">out </span><span begin="01:11.200" end="01:11.560">to </span><span begin="01:11.560" end="01:11.980">shake </span><span begin="01:11.980" end="01:12.340">my </span><span begin="01:12.340" end="01:13.060">hand</span></p><p ttm:agent="v1" begin="01:13.090" end="01:17.740"><span begin="01:13.090" end="01:13.360">It's </span><span begin="01:13.360" end="01:13.480">the </span><span begin="01:13.480" end="01:14.500">best </span><span begin="01:14.500" end="01:15.460">day </span><span begin="01:15.460" end="01:17.740">ever</span></p><p ttm:agent="v1" begin="01:17.740" end="01:20.740"><span begin="01:17.740" end="01:17.740">（</span><span begin="01:17.740" end="01:18.280">Best </span><span begin="01:18.280" end="01:19.990">day </span><span begin="01:19.990" end="01:20.740">ever</span><span begin="01:20.740" end="01:20.740">）</span></p><p ttm:agent="v1" begin="01:20.740" end="01:24.730"><span begin="01:20.740" end="01:20.860">It's </span><span begin="01:20.860" end="01:20.980">the </span><span begin="01:20.980" end="01:21.970">best </span><span begin="01:21.970" end="01:23.560">day </span><span begin="01:23.560" end="01:24.730">ever</span></p><p ttm:agent="v1" begin="01:24.730" end="01:28.750"><span begin="01:24.730" end="01:24.730">（</span><span begin="01:24.730" end="01:25.720">Best </span><span begin="01:25.720" end="01:27.520">day </span><span begin="01:27.520" end="01:28.540">ever</span><span begin="01:28.540" end="01:28.750">）</span></p><p ttm:agent="v1" begin="01:28.750" end="01:35.410"><span begin="01:28.750" end="01:30.010">Sometimes </span><span begin="01:30.010" end="01:30.250">the </span><span begin="01:30.250" end="01:31.000">little </span><span begin="01:31.000" end="01:31.780">things </span><span begin="01:31.780" end="01:32.200">start </span><span begin="01:32.200" end="01:33.340">closing </span><span begin="01:33.340" end="01:33.670">in </span><span begin="01:33.670" end="01:34.030">on </span><span begin="01:34.030" end="01:35.410">me</span></p><p ttm:agent="v1" begin="01:35.440" end="01:39.040"><span begin="01:35.440" end="01:35.890">When </span><span begin="01:35.890" end="01:36.040">I'm </span><span begin="01:36.040" end="01:36.730">feeling </span><span begin="01:36.730" end="01:37.360">down </span><span begin="01:37.360" end="01:37.480">I </span><span begin="01:37.480" end="01:37.900">wanna </span><span begin="01:37.900" end="01:38.260">lose </span><span begin="01:38.260" end="01:38.560">that </span><span begin="01:38.560" end="01:39.040">frown</span></p><p ttm:agent="v1" begin="01:39.130" end="01:43.030"><span begin="01:39.130" end="01:39.250">I </span><span begin="01:39.250" end="01:39.550">stick </span><span begin="01:39.550" end="01:39.730">my </span><span begin="01:39.730" end="01:40.270">head </span><span begin="01:40.270" end="01:40.510">out </span><span begin="01:40.510" end="01:40.630">the </span><span begin="01:40.630" end="01:41.170">window </span><span begin="01:41.170" end="01:41.410">and </span><span begin="01:41.410" end="01:41.560">I </span><span begin="01:41.560" end="01:41.980">look </span><span begin="01:41.980" end="01:43.030">around</span></p><p ttm:agent="v1" begin="01:43.030" end="01:47.380"><span begin="01:43.030" end="01:43.420">Those </span><span begin="01:43.420" end="01:43.960">clouds </span><span begin="01:43.960" end="01:44.320">don't </span><span begin="01:44.320" end="01:44.740">scare </span><span begin="01:44.740" end="01:44.920">me</span><span begin="01:44.920" end="01:44.920">, </span><span begin="01:44.920" end="01:45.250">they </span><span begin="01:45.250" end="01:45.700">can't </span><span begin="01:45.700" end="01:47.380">disguise</span></p><p ttm:agent="v1" begin="01:50.530" end="01:55.180"><span begin="01:50.530" end="01:50.980">This </span><span begin="01:50.980" end="01:51.520">magic </span><span begin="01:51.520" end="01:51.940">that's </span><span begin="01:51.940" end="01:52.480">happening </span><span begin="01:52.480" end="01:52.780">right </span><span begin="01:52.780" end="01:53.260">before </span><span begin="01:53.260" end="01:53.800">my </span><span begin="01:53.800" end="01:55.180">eyes</span></p><p ttm:agent="v1" begin="01:58.870" end="02:03.700"><span begin="01:58.870" end="01:59.470">Soon </span><span begin="01:59.470" end="02:00.250">Mr</spa