32.712">in </span><span begin="00:32.712" end="00:33.048">this </span><span begin="00:33.048" end="00:33.776">darkness</span></p><p ttm:agent="v1" begin="00:34.832" end="00:36.968"><span begin="00:34.832" end="00:35.071">And </span><span begin="00:35.071" end="00:35.360">there's </span><span begin="00:35.360" end="00:35.631">no </span><span begin="00:35.631" end="00:35.912">one </span><span begin="00:35.912" end="00:36.177">to </span><span begin="00:36.177" end="00:36.487">light </span><span begin="00:36.487" end="00:36.736">it </span><span begin="00:36.736" end="00:36.968">up</span></p><p ttm:agent="v1" begin="00:36.968" end="00:38.584"><span begin="00:36.968" end="00:37.176">To </span><span begin="00:37.176" end="00:37.384">bright </span><span begin="00:37.384" end="00:37.663">it </span><span begin="00:37.663" end="00:37.904">up </span><span begin="00:38.312" end="00:38.584">yeah</span></p><p ttm:agent="v1" begin="00:39.456" end="00:42.407"><span begin="00:39.456" end="00:39.672">And </span><span begin="00:39.672" end="00:39.880">I </span><span begin="00:39.880" end="00:40.127">keep </span><span begin="00:40.127" end="00:40.513">falling </span><span begin="00:40.513" end="00:40.760">in </span><span begin="00:40.760" end="00:41.048">this </span><span begin="00:41.048" end="00:42.407">darkness</span></p><p ttm:agent="v1" begin="00:42.977" end="00:45.088"><span begin="00:42.977" end="00:43.191">And </span><span begin="00:43.191" end="00:43.392">there's </span><span begin="00:43.392" end="00:43.633">no </span><span begin="00:43.633" end="00:43.888">one </span><span begin="00:43.888" end="00:44.160">to </span><span begin="00:44.160" end="00:44.424">light </span><span begin="00:44.424" end="00:44.680">it </span><span begin="00:44.680" end="00:45.088">up</span></p><p ttm:agent="v1" begin="00:45.231" end="00:46.664"><span begin="00:45.231" end="00:45.455">To </span><span begin="00:45.455" end="00:45.696">bright </span><span begin="00:45.696" end="00:46.016">it </span><span begin="00:46.016" end="00:46.352">up </span><span begin="00:46.352" end="00:46.664">yeah</span></p><p ttm:agent="v1" begin="00:47.427" end="00:50.163"><span begin="00:47.427" end="00:47.626">And </span><span begin="00:47.626" end="00:47.827">I </span><span begin="00:47.827" end="00:48.099">keep </span><span begin="00:48.099" end="00:48.499">falling </span><span begin="00:48.499" end="00:48.763">in </span><span begin="00:48.763" end="00:49.115">this </span><span begin="00:49.115" end="00:50.163">darkness</span></p><p ttm:agent="v1" begin="00:50.931" end="00:52.971"><span begin="00:50.931" end="00:51.147">And </span><span begin="00:51.147" end="00:51.354">there's </span><span begin="00:51.354" end="00:51.586">no </span><span begin="00:51.586" end="00:51.858">one </span><span begin="00:51.858" end="00:52.114">to </span><span begin="00:52.114" end="00:52.378">light </span><span begin="00:52.378" end="00:52.666">it </span><span begin="00:52.666" end="00:52.971">up</span></p><p ttm:agent="v1" begin="00:52.971" end="00:54.586"><span begin="00:52.971" end="00:53.236">To </span><span begin="00:53.236" end="00:53.490">bright </span><span begin="00:53.490" end="00:53.724">it </span><span begin="00:53.724" end="00:54.075">up </span><span begin="00:54.075" end="00:54.586">yeah</span></p><p ttm:agent="v1" begin="00:55.411" end="00:58.323"><span begin="00:55.411" end="00:55.619">And </span><span begin="00:55.619" end="00:55.826">I </span><span begin="00:55.826" end="00:56.058">keep </span><span begin="00:56.058" end="00:56.435">falling </span><span begin="00:56.435" end="00:56.651">in </span><span begin="00:56.651" end="00:57.106">this </span><span begin="00:57.106" end="00:58.323">darkness</span></p><p ttm:agent="v1" begin="00:58.898" end="01:00.826"><span begin="00:58.898" end="00:59.123">And </span><span begin="00:59.123" end="00:59.362">there's </span><span begin="00:59.362" end="00:59.611">no </span><span begin="00:59.611" end="00:59.882">one </span><span begin="00:59.882" 