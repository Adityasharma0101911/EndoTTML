70">it</span></p><p ttm:agent="v1" begin="01:10.470" end="01:12.900"><span begin="01:10.470" end="01:10.800">You </span><span begin="01:10.800" end="01:11.070">don't </span><span begin="01:11.070" end="01:11.160">mean </span><span begin="01:11.160" end="01:11.340">it</span><span begin="01:11.340" end="01:11.340">, </span><span begin="01:11.340" end="01:11.520">you </span><span begin="01:11.520" end="01:11.880">don't </span><span begin="01:11.880" end="01:12.300">mean </span><span begin="01:12.300" end="01:12.540">it</span><span begin="01:12.540" end="01:12.690">, </span><span begin="01:12.690" end="01:12.900">no</span></p><p ttm:agent="v1" begin="01:13.380" end="01:15.570"><span begin="01:13.380" end="01:13.530">I </span><span begin="01:13.530" end="01:13.740">wish </span><span begin="01:13.740" end="01:13.890">that </span><span begin="01:13.890" end="01:13.980">I </span><span begin="01:13.980" end="01:14.130">could </span><span begin="01:14.130" end="01:14.520">take </span><span begin="01:14.520" end="01:14.700">it </span><span begin="01:14.700" end="01:15.570">back</span></p><p ttm:agent="v1" begin="01:15.750" end="01:17.790"><span begin="01:15.750" end="01:15.960">You </span><span begin="01:15.960" end="01:16.170">want </span><span begin="01:16.170" end="01:16.320">it </span><span begin="01:16.320" end="01:16.410">all</span><span begin="01:16.410" end="01:16.410">, </span><span begin="01:16.410" end="01:16.620">but </span><span begin="01:16.620" end="01:16.770">you </span><span begin="01:16.770" end="01:17.100">can't </span><span begin="01:17.100" end="01:17.460">have </span><span begin="01:17.460" end="01:17.790">that</span></p><p ttm:agent="v1" begin="01:18.300" end="01:19.950"><span begin="01:18.300" end="01:18.630">People </span><span begin="01:18.630" end="01:18.990">falling </span><span begin="01:18.990" end="01:19.260">at </span><span begin="01:19.260" end="01:19.470">your </span><span begin="01:19.470" end="01:19.950">feet</span></p><p ttm:agent="v1" begi