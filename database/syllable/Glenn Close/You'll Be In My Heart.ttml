<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>You'll Be In My Heart</ttm:title><ttm:agent type="group" xml:id="v1">Glenn Close, Phil Collins</ttm:agent><ttm:item type="album">Tarzan (Original Motion Picture Soundtrack)</ttm:item><ttm:item type="spotify_id">7C11GdiguhLd9j7Y6jHFm9</ttm:item><itunes:duration>01:38.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:08.120" end="00:13.050"><span begin="00:08.120" end="00:08.380">Come  </span><span begin="00:08.380" end="00:08.740">stop </span><span begin="00:08.740" end="00:09.000">your </span><span begin="00:09.000" end="00:10.310">crying  </span><span begin="00:10.310" end="00:10.610">it </span><span begin="00:10.610" end="00:10.930">will </span><span begin="00:10.930" end="00:11.240">be </span><span begin="00:11.240" end="00:11.550">all </span><span begin="00:11.550" end="00:13.050">right</span></p><p ttm:agent="v1" begin="00:13.490" end="00:17.730"><span begin="00:13.490" end="00:13.730">Just </span><span begin="00:13.730" end="00:13.920">take </span><span begin="00:13.920" end="00:14.240">my </span><span begin="00:14.240" end="00:15.490">hand  </span><span begin="00:15.490" end="00:15.730">hold </span><span begin="00:15.730" end="00:16.170">it </span><span begin="00:16.170" end="00:17.730">tight</span></p><p ttm:agent="v1" begin="00:18.040" end="00:23.040"><span begin="00:18.040" end="00:18.350">I </span><span begin="00:18.350" end="00:18.550">will </span><span begin="00:18.550" end="00:19.040">protect </span><span begin="00:19.040" end="00:19.660">you </span><span begin="00:19.660" end="00:20.600">from  </span><span begin="00:20.600" end="00:20.850">all </span><span begin="00:20.850" end="00:21.610">around </span><span begin="00:21.610" end="00:23.040">you</span></p><p ttm:agent="v1" begin="00:23.040" end="00:27.420"><span begin="00:23.040" end="00:23.220">I </span><span begin="00:23.220" end="00:23.480">will </span><span begin="00:23.480" end="00:23.840">be </span><span begin="00:23.840" end="00:24.350">here  </span><span begin="00:24.350" end="00:24.590">don't </span><span begin="00:24.590" end="00:24.910">you </span><span begin="00:24.910" end="00:27.420">cry</span></p><p ttm:agent="v1" begin="00:28.480" end="00:33.470"><span begin="00:28.480" end="00:28.730">For </span><span begin="00:28.730" end="00:28.980">one </span><span begin="00:28.980" end="00:29.230">so </span><span begin="00:29.230" end="00:30.480">small  </span><span begin="00:30.480" end="00:30.720">you </span><span begin="00:30.720" end="00:31.040">seem </span><span begin="00:31.040" end="00:31.350">so </span><span begin="00:31.350" end="00:33.470">strong</span></p><p ttm:agent="v1" begin="00:33.470" end="00:38.270"><span begin="00:33.470" end="00:33.660">My </span><span begin="00:33.660" end="00:33.840">arms </span><span begin="00:33.840" end="00:34.160">will </span><span begin="00:34.160" end="00:34.410">hold </span><span begin="00:34.410" end="00:34.910">you  </span><span begin="00:34.910" end="00:35.150">keep </span><span begin="00:35.150" end="00:35.350">you </span><span begin="00:35.350" end="00:35.710">safe </span><span begin="00:35.710" end="00:36.160">and </span><span begin="00:36.160" end="00:38.270">warm</span></p><p ttm:agent="v1" begin="00:38.270" end="00:43.000"><span begin="00:38.270" end="00:38.460">This </span><span begin="00:38.460" end="00:38.710">bond </span><span begin="00:38.710" end="00:39.190">between </span><span begin="00:39.190" end="00:40.380">us  </span><span begin="00:40.380" end="00:40.750">can't </span><span begin="00:40.750" end="00:41.130">be </span><span begin="00:41.130" end="00:43.000">broken</span></p><p ttm:agent="v1" begin="00:43.000" end="00:47.080"><span begin="00:43.000" end="00:43.240">I </span><span begin="00:43.240" end="00:43.430">will </span><span begin="00:43.430" end="00:43.690">be </span><span begin="00:43.690" end="00:44.550">here  </span><span begin="00:44.550" end="00:44.750">don't </span><span begin="00:44.750" end="00:45.240">you </span><span begin="00:45.240" end="00:47.080">cry</span></p><p ttm:agent="v1" begin="00:47.390" end="00:52.020"><span begin="00:47.390" end="00:47.590">Cause </span><span begin="00:47.590" end="00:48.160">you'll </span><span begin="00:48.160" end="00:48.780">be </span><span begin="00:48.780" end="00:49.280">in </span><span begin="00:49.280" end="00:49.650">my </span><span begin="00:49.650" end="00:52.020">heart</span></p><p ttm:agent="v1" begin="00:52.020" end="00:56.760"><span begin="00:52.020" end="00:52.270">Yes  </span><span begin="00:52.270" end="00:53.020">you'll </span><span begin="00:53.020" end="00:53.510">be </span><span begin="00:53.510" end="00:53.950">in </span><span begin="00:53.950" end="00:54.460">my </span><span begin="00:54.460" end="00:56.760">heart</span></p><p ttm:agent="v1" begin="00:57.020" end="00:59.260"><span begin="00:57.020" end="00:57.200">From </span><span begin="00:57.200" end="00:57.460">this </span><span begin="00:57.460" end="00:57.760">day </span><span begin="00:57.760" end="00:59.260">on</span></p><p ttm:agent="v1" begin="00:59.260" end="01:04.030"><span begin="00:59.260" end="00:59.450">Now </span><span begin="00:59.450" end="01:00.350">and </span><span begin="01:00.350" end="01:01.780">forever </span><span begin="01:01.780" end="01:04.030">more</span></p><p ttm:agent="v1" begin="01:06.900" end="01:11.270"><span begin="01:06.900" end="01:07.150">You'll </span><span begin="01:07.150" end="01:08.030">be </span><span begin="01:08.030" end="01:08.460">in </span><span begin="01:08.460" end="01:08.900">my </span><span begin="01:08.900" end="01:11.270">heart</span></p><p ttm:agent="v1" begin="01:11.270" end="01:15.700"><span begin="01:11.270" end="01:11.580">No </span><span begin="01:11.580" end="01:12.020">matter </span><span begin="01:12.020" end="01:13.140">what </span><span begin="01:13.140" end="01:13.570">they </span><span begin="01:13.570" end="01:15.700">say</span></p><p ttm:agent="v1" begin="01:16.130" end="01:20.320"><span begin="01:16.130" end="01:16.450">You'll </span><span begin="01:16.450" end="01:17.200">be </span><span begin="01:17.200" end="01:17.880">here </span><span begin="01:17.880" end="01:18.140">in </span><span begin="01:18.140" end="01:18.440">my </span><span begin="01:18.440" end="01:20.320">heart</span></p><p ttm:agent="v1" begin="01:20.880" end="01:23.560"><span begin="01:20.880" end="01:23.560">Always</span></p></div></body></tt>