<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Last Goodbye</ttm:title><ttm:agent type="person" xml:id="v1">Jeff Buckley</ttm:agent><ttm:item type="album">Grace</ttm:item><ttm:item type="spotify_id">0y5CnV2idm2KkQEudDjfDT</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:57.920" end="01:02.000"><span begin="00:57.920" end="00:58.580">This </span><span begin="00:58.580" end="00:59.090">is </span><span begin="00:59.090" end="00:59.300">our </span><span begin="00:59.300" end="01:00.080">last </span><span begin="01:00.080" end="01:02.000">goodbye</span></p><p ttm:agent="v1" begin="01:02.540" end="01:07.610"><span begin="01:02.540" end="01:02.690">I </span><span begin="01:02.690" end="01:03.230">hate </span><span begin="01:03.230" end="01:03.410">to </span><span begin="01:03.410" end="01:03.830">feel </span><span begin="01:03.830" end="01:03.980">the </span><span begin="01:03.980" end="01:04.520">love </span><span begin="01:04.520" end="01:05.840">between </span><span begin="01:05.840" end="01:06.260">us </span><span begin="01:06.260" end="01:07.610">die</span></p><p ttm:agent="v1" begin="01:08.270" end="01:10.580"><span begin="01:08.270" end="01:08.600">But </span><span begin="01:08.600" end="01:08.930">it's </span><span begin="01:08.930" end="01:10.580">over</span></p><p ttm:agent="v1" begin="01:11.000" end="01:13.850"><span begin="01:11.000" end="01:11.510">Just </span><span begin="01:11.510" end="01:11.750">hear </span><span begin="01:11.750" end="01:12.350">this </span><span begin="01:12.350" end="01:12.500">and </span><span begin="01:12.500" end="01:12.710">then </span><span begin="01:12.710" end="01:12.950">I'll </span><span begin="01:12.950" end="01:13.850">go</span></p><p ttm:agent="v1" begin="01:14.270" end="01:17.270"><span begin="01:14.270" end="01:14.510">You </span><span begin="01:14.510" end="01:15.050">gave </span><span begin="01:15.050" end="01:15.290">me </span><span begin="01:15.290" end="01:15.800">more </span><span begin="01:15.800" end="01:15.920">to </span><span begin="01:15.920" end="01:16.190">live </span><span begin="01:16.190" end="01:17.000">for</span><span begin="01:17.000" end="01:17.270">,</span></p><p ttm:agent="v1" begin="01:17.270" end="01:31.040"><span begin="01:17.270" end="01:17.840">More </span><span begin="01:17.840" end="01:18.050">than </span><span begin="01:18.050" end="01:18.380">you'll </span><span begin="01:18.380" end="01:19.400">ever </span><span begin="01:19.400" end="01:22.160">know</span><span begin="01:22.160" end="01:31.040">.</span></p><p ttm:agent="v1" begin="01:31.040" end="01:35.480"><span begin="01:31.040" end="01:31.610">This </span><span begin="01:31.610" end="01:32.210">is </span><span begin="01:32.210" end="01:32.420">our </span><span begin="01:32.420" end="01:33.260">last </span><span begin="01:33.260" end="01:35.390">embrace</span><span begin="01:35.390" end="01:35.480">,</span></p><p ttm:agent="v1" begin="01:35.480" end="01:41.090"><span begin="01:35.480" end="01:35.930">Must </span><span begin="01:35.930" end="01:36.110">I </span><span begin="01:36.110" end="01:36.980">dream </span><span begin="01:36.980" end="01:37.160">and </span><span begin="01:37.160" end="01:38.180">always </span><span begin="01:38.180" end="01:38.840">see </span><span begin="01:38.840" end="01:39.260">your </span><span begin="01:39.260" end="01:41.090">face</span></p><p ttm:agent="v1" begin="01:41.540" end="01:45.950"><span begin="01:41.540" end="01:41.990">Why </span><span begin="01:41.990" end="01:42.590">can't </span><span begin="01:42.590" end="01:42.890">we </span><span begin="01:42.890" end="01:44.000">overcome </span><span begin="01:44.000" end="01:44.390">this </span><span begin="01:44.390" end="01:45.950">wall</span></p><p ttm:agent="v1" begin="01:46.730" end="02:03.680"><span begin="01:46.730" end="01:47.690">Baby</span><span begin="01:47.690" end="01:47.690">, </span><span begin="01:47.690" end="01:48.380">maybe </span><span begin="01:48.380" end="01:48.680">it </span><span begin="01:48.680" end="01:48.800">is </span><span begin="01:48.800" end="01:49.190">just </span><span begin="01:49.190" end="01:49.940">because </span><span begin="01:49.940" end="01:50.030">I </span><span begin="01:50.030" end="01:50.270">didn't </span><span begin="01:50.270" end="01:50.840">know </span><span begin="01:50.840" end="01:51.140">you </span><span begin="01:51.140" end="01:51.380">at </span><span begin="01:51.380" end="01:53.990">all</span><span begin="01:53.990" end="02:03.680">.</span></p><p ttm:agent="v1" begin="02:03.680" end="02:06.890"><span begin="02:03.680" end="02:04.730">Kiss </span><span begin="02:04.730" end="02:05.720">me</span><span begin="02:05.720" end="02:05.750">, </span><span begin="02:05.750" end="02:06.890">please</span><span begin="02:06.890" end="02:06.890">,</span></p><p ttm:agent="v1" begin="02:06.890" end="02:08.540"><span begin="02:06.890" end="02:07.430">Kiss </span><span begin="02:07.430" end="02:08.540">me</span></p><p ttm:agent="v1" begin="02:08.780" end="02:13.940"><span begin="02:08.780" end="02:08.990">But </span><span begin="02:08.990" end="02:09.380">kiss </span><span begin="02:09.380" end="02:09.680">me </span><span begin="02:09.680" end="02:10.130">out </span><span begin="02:10.130" end="02:10.370">of </span><span begin="02:10.370" end="02:11.360">desire</span><span begin="02:11.360" end="02:11.360">, </span><span begin="02:11.360" end="02:12.020">babe</span><span begin="02:12.020" end="02:12.020">, </span><span begin="02:12.020" end="02:12.140">and </span><span begin="02:12.140" end="02:12.380">not </span><span begin="02:12.380" end="02:13.940">consolation</span></p><p ttm:agent="v1" begin="02:14.720" end="02:15.110"><span begin="02:14.720" end="02:14.900">You </span><span begin="02:14.900" end="02:15.110">know</span><span begin="02:15.110" end="02:15.110">,</span></p><p ttm:agent="v1" begin="02:15.110" end="02:20.060"><span begin="02:15.110" end="02:15.230">It </span><span begin="02:15.230" end="02:15.620">makes </span><span begin="02:15.620" end="02:15.830">me </span><span begin="02:15.830" end="02:16.280">so </span><span begin="02:16.280" end="02:17.330">angry </span><span begin="02:17.330" end="02:17.720">'cause </span><span begin="02:17.720" end="02:17.960">I </span><span begin="02:17.960" end="02:18.530">know </span><span begin="02:18.530" end="02:18.800">that </span><span begin="02:18.800" end="02:18.980">in </span><span begin="02:18.980" end="02:20.060">time</span></p><p ttm:agent="v1" begin="02:20.690" end="03:05.750"><span begin="02:20.690" end="02:21.380">I'll </span><span begin="02:21.380" end="02:21.860">only </span><span begin="02:21.860" end="02:22.730">make </span><span begin="02:22.730" end="02:23.060">you </span><span begin="02:23.060" end="02:23.960">cry</span><span begin="02:23.960" end="02:23.960">, </span><span begin="02:23.960" end="02:24.290">this </span><span begin="02:24.290" end="02:24.560">is </span><span begin="02:24.560" end="02:24.830">our </span><span begin="02:24.830" end="02:25.610">last </span><span begin="02:25.610" end="02:28.940">goodbye</span><span begin="02:28.940" end="03:05.750">.</span></p><p ttm:agent="v1" begin="03:05.750" end="03:11.240"><span begin="03:05.750" end="03:06.050">Did </span><span begin="03:06.050" end="03:06.170">you </span><span begin="03:06.170" end="03:07.130">say </span><span begin="03:07.130" end="03:07.910">no</span><span begin="03:07.910" end="03:07.910">, </span><span begin="03:07.910" end="03:08.240">this </span><span begin="03:08.240" end="03:08.570">can't </span><span begin="03:08.570" end="03:09.320">happen </span><span begin="03:09.320" end="03:09.620">to </span><span begin="03:09.620" end="03:10.400">me</span><span begin="03:10.400" end="03:11.240">,</span></p><p ttm:agent="v1" begin="03:11.240" end="03:15.290"><span begin="03:11.240" end="03:11.390">And </span><span begin="03:11.390" end="03:11.600">did </span><span begin="03:11.600" end="03:11.720">you </span><span begin="03:11.720" end="03:12.290">rush </span><span begin="03:12.290" end="03:12.440">to </span><span begin="03:12.440" end="03:12.680">the </span><span begin="03:12.680" end="03:13.550">phone </span><span begin="03:13.550" end="03:13.610">to </span><span begin="03:13.610" end="03:14.900">call</span><span begin="03:14.900" end="03:15.290">?</span></p><p ttm:agent="v1" begin="03:15.290" end="03:21.470"><span begin="03:15.290" end="03:15.560">Was </span><span begin="03:15.560" end="03:15.800">there </span><span begin="03:15.800" end="03:15.830">a </span><span begin="03:15.830" end="03:16.520">voice </span><span begin="03:16.520" end="03:18.290">unkind </span><span begin="03:18.290" end="03:18.530">in </span><span begin="03:18.530" end="03:18.620">the </span><span begin="03:18.620" end="03:19.070">back </span><span begin="03:19.070" end="03:19.190">of </span><span begin="03:19.190" end="03:19.670">your </span><span begin="03:19.670" end="03:20.960">mind </span><span begin="03:20.960" end="03:21.470">saying</span><span begin="03:21.470" end="03:21.470">,</span></p><p ttm:agent="v1" begin="03:21.470" end="03:42.680"><span begin="03:21.470" end="03:26.120">Maybe</span><span begin="03:26.120" end="03:26.210">.</span><span begin="03:26.210" end="03:26.300">.</span><span begin="03:26.300" end="03:26.390">. </span><span begin="03:26.390" end="03:26.630">you </span><span begin="03:26.630" end="03:26.900">didn't </span><span begin="03:26.900" end="03:27.410">know </span><span begin="03:27.410" end="03:27.620">him </span><span begin="03:27.620" end="03:27.830">at </span><span begin="03:27.830" end="03:28.790">all</span><span begin="03:28.790" end="03:42.680">.</span></p><p ttm:agent="v1" begin="03:42.680" end="03:46.700"><span begin="03:42.680" end="03:43.370">Well</span><span begin="03:43.370" end="03:43.370">, </span><span begin="03:43.370" end="03:43.460">the </span><span begin="03:43.460" end="03:44.090">bells </span><span begin="03:44.090" end="03:44.480">out </span><span begin="03:44.480" end="03:44.750">in </span><span begin="03:44.750" end="03:44.810">the </span><span begin="03:44.810" end="03:45.350">church </span><span begin="03:45.350" end="03:45.830">tower </span><span begin="03:45.830" end="03:46.700">chime</span></p><p ttm:agent="v1" begin="03:48.260" end="03:52.490"><span begin="03:48.260" end="03:49.100">Burning </span><span begin="03:49.100" end="03:49.550">clues </span><span begin="03:49.550" end="03:50.000">into </span><span begin="03:50.000" end="03:50.330">this </span><span begin="03:50.330" end="03:51.140">heart </span><span begin="03:51.140" end="03:51.350">of </span><span begin="03:51.350" end="03:52.490">mine</span></p><p ttm:agent="v1" begin="03:53.960" end="04:00.830"><span begin="03:53.960" end="03:54.470">Thinking </span><span begin="03:54.470" end="03:55.010">so </span><span begin="03:55.010" end="03:56.750">hard </span><span begin="03:56.750" end="03:57.080">on </span><span begin="03:57.080" end="03:57.170">her </span><span begin="03:57.170" end="03:57.950">soft </span><span begin="03:57.950" end="03:59.480">eyes </span><span begin="03:59.480" end="03:59.900">and </span><span begin="03:59.900" end="03:59.990">the </span><span begin="03:59.990" end="04:00.830">memory</span></p><p ttm:agent="v1" begin="04:02.030" end="04:22.130"><span begin="04:02.030" end="04:02.300">Of </span><span begin="04:02.300" end="04:02.510">her </span><span begin="04:02.510" end="04:04.010">sighs </span><span begin="04:04.010" end="04:04.430">that</span><span begin="04:04.430" end="04:04.430">, </span><span begin="04:04.430" end="04:04.700">it's </span><span begin="04:04.700" end="04:05.240">over</span><span begin="04:05.240" end="04:08.730">.</span><span begin="04:08.730" end="04:12.220">.</span><span begin="04:12.220" end="04:15.710">. </span><span begin="04:15.710" end="04:16.040">it's </span><span begin="04:16.040" end="04:22.130">over</span></p></div></body></tt>