635" end="01:42.971">a </span><span begin="01:42.971" end="01:44.043">star </span><span begin="01:44.043" end="01:44.347">to </span><span begin="01:44.347" end="01:45.611">bed</span></p><p ttm:agent="v1" begin="01:46.251" end="01:49.595"><span begin="01:46.251" end="01:46.700">Woke </span><span begin="01:46.700" end="01:47.083">up </span><span begin="01:47.083" end="01:47.451">with </span><span begin="01:47.451" end="01:48.299">me </span><span begin="01:48.299" end="01:49.595">instead</span></p><p ttm:agent="v1" begin="01:49.835" end="01:59.467"><span begin="01:49.835" end="01:50.075">You </span><span begin="01:50.075" end="01:50.476">must </span><span begin="01:50.476" end="01:50.907">have </span><span begin="01:50.907" end="01:51.659">felt </span><span begin="01:51.659" end="01:52.075">so </span><span begin="01:52.075" end="01:54.011">damn </span><span begin="01:54.011" end="01:56.795">deceived </span><span begin="01:56.795" end="01:57.867">when </span><span begin="01:57.867" end="01:59.467">you</span></p><p ttm:agent="v1" begin="02:00.035" end="02:04.019"><span begin="02:00.035" end="02:00.979">Made </span><span begin="02:00.979" end="02:01.219">up </span><span begin="02:01.219" end="02:01.603">a </span><span begin="02:01.603" end="02:02.483">version </span><span begin="02:02.483" end="02:04.019">of</span></p><p ttm:agent="v1" begin="02:04.707" end="02:08.117"><span begin="02:04.707" end="02:05.187">Me </span><span begin="02:05.187" end="02:05.491">that </span><span begin="02:05.491" end="02:05.875">you </span><span begin="02:05.875" end="02:06.515">thought </span><span begin="02:06.515" end="02:07.075">you </span><span begin="02:07.075" end="02:08.117">loved</span></p><p ttm:agent="v1" begin="02:08.151" end="02:16.999"><span begin="02:08.151" end="02:08.375">But </span><span begin="02:08.375" end="02:08.759">I </span><span begin="02:08.759" end="02:09.127">am </span><span begin="02:09.127" end="02:09.943">not </span><span begin="02:09.943" end="02:10.391">your <