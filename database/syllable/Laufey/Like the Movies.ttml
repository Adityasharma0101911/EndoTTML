<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Like the Movies</ttm:title><ttm:agent type="person" xml:id="v1">Laufey</ttm:agent><ttm:item type="album">Typical of Me EP</ttm:item><ttm:item type="spotify_id">1hUXDEqjNIIbfjTcaz3jzb</ttm:item><itunes:duration>02:42.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:14.049" end="00:19.424"><span begin="00:14.049" end="00:15.039">Maybe </span><span begin="00:15.039" end="00:15.407">one </span><span begin="00:15.407" end="00:15.831">day </span><span begin="00:16.343" end="00:16.672">I'll </span><span begin="00:16.672" end="00:17.223">fall </span><span begin="00:17.416" end="00:17.816">in </span><span begin="00:17.816" end="00:18.208">a </span><span begin="00:18.208" end="00:19.424">bookstore</span></p><p ttm:agent="v1" begin="00:19.879" end="00:24.369"><span begin="00:19.879" end="00:20.503">Into </span><span begin="00:20.503" end="00:20.831">the </span><span begin="00:20.831" end="00:21.897">arms </span><span begin="00:22.097" end="00:22.441">of </span><span begin="00:22.441" end="00:22.825">a </span><span begin="00:22.825" end="00:24.369">guy</span></p><p ttm:agent="v1" begin="00:24.744" end="00:27.361"><span begin="00:24.744" end="00:25.168">We'll </span><span begin="00:25.168" end="00:25.735">sneak </span><span begin="00:25.904" end="00:26.351">into </span><span begin="00:26.497" end="00:27.361">bars</span></p><p ttm:agent="v1" begin="00:27.561" end="00:30.217"><span begin="00:27.561" end="00:28.041">And </span><span begin="00:28.041" end="00:28.698">gaze </span><span begin="00:28.887" end="00:29.232">at </span><span begin="00:29.232" end="00:29.689">the </span><span begin="00:29.689" end="00:30.217">stars</span></p><p ttm:agent="v1" begin="00:31.096" end="00:34.953"><span begin="00:31.096" end="00:31.487">Surrounded </span><span begin="00:31.487" end="00:32.264">by </span><span begin="00:32.264" end="00:34.953">fireflies</span></p><p ttm:agent="v1" begin="00:35.473" end="00:41.337"><span begin="00:35.473" end="00:36.441">Oh </span><span begin="00:36.441" end="00:36.816">I'd </span><span begin="00:36.816" end="00:37.282">like </span><span begin="00:37.282" end="00:37.881">to </span><span begin="00:37.881" end="00:38.689">sleep </span><span begin="00:38.689" end="00:39.009">in </span><span begin="00:39.009" end="00:39.336">'til </span><span begin="00:39.336" end="00:40.017">two </span><span begin="00:40.017" end="00:40.297">on </span><span begin="00:40.297" end="00:40.633">a </span><span begin="00:40.633" end="00:41.337">Sunday</span></p><p ttm:agent="v1" begin="00:41.522" end="00:46.137"><span begin="00:41.522" end="00:41.881">And </span><span begin="00:41.881" end="00:42.592">listen </span><span begin="00:42.592" end="00:42.873">to </span><span begin="00:42.873" end="00:43.193">the </span><span begin="00:43.193" end="00:44.401">bluebirds </span><span begin="00:44.401" end="00:46.137">sigh</span></p><p ttm:agent="v1" begin="00:46.841" end="00:49.432"><span begin="00:46.841" end="00:47.344">Get </span><span begin="00:47.344" end="00:48.137">soaked </span><span begin="00:48.137" end="00:48.473">in </span><span begin="00:48.473" end="00:48.721">the </span><span begin="00:48.721" end="00:49.432">rain</span></p><p ttm:agent="v1" begin="00:49.720" end="00:51.906"><span begin="00:49.720" end="00:50.047">And </span><span begin="00:50.047" end="00:50.769">smile </span><span begin="00:50.769" end="00:51.089">through </span><span begin="00:51.089" end="00:51.329">the </span><span begin="00:51.329" end="00:51.906">pain</span></p><p ttm:agent="v1" begin="00:52.440" end="00:57.481"><span begin="00:52.440" end="00:53.153">Slow </span><span begin="00:53.153" end="00:53.761">dance </span><span begin="00:53.761" end="00:54.201">under </span><span begin="00:54.352" end="00:54.905">stormy </span><span begin="00:55.017" end="00:57.481">skies</span></p><p ttm:agent="v1" begin="00:58.145" end="01:02.631"><span begin="00:58.145" end="00:58.777">Maybe </span><span begin="00:58.777" end="00:59.449">I'm </span><span begin="00:59.449" end="01:00.073">just </span><span begin="01:00.073" end="01:02.631">old-fashioned</span></p><p ttm:agent="v1" begin="01:03.360" end="01:08.016"><span begin="01:03.360" end="01:04.417">Read </span><span begin="01:04.417" end="01:05.209">too </span><span begin="01:05.209" end="01:06.015">many </span><span begin="01:06.015" end="01:08.016">fairytales</span></p><p ttm:agent="v1" begin="01:09.818" end="01:14.089"><span begin="01:09.818" end="01:10.146">It's </span><span begin="01:10.146" end="01:10.689">no </span><span begin="01:10.689" end="01:11.281">wonder </span><span begin="01:11.441" end="01:12.145">I've </span><span begin="01:12.361" end="01:12.751">had </span><span begin="01:12.897" end="01:13.249">no </span><span begin="01:13.249" end="01:14.089">luck</span></p><p ttm:agent="v1" begin="01:15.199" end="01:20.121"><span begin="01:15.199" end="01:15.704">No </span><span begin="01:15.704" end="01:16.959">one's </span><span begin="01:17.241" end="01:18.128">ever </span><span begin="01:18.128" end="01:18.761">good </span><span begin="01:18.761" end="01:20.121">enough</span></p><p ttm:agent="v1" begin="01:20.961" end="01:25.714"><span begin="01:20.961" end="01:21.392">I </span><span begin="01:21.392" end="01:21.657">want </span><span begin="01:21.657" end="01:21.929">a </span><span begin="01:21.929" end="01:22.417">love </span><span begin="01:22.609" end="01:22.881">like </span><span begin="01:22.881" end="01:23.193">I've </span><span begin="01:23.193" end="01:23.969">seen </span><span begin="01:24.089" end="01:24.320">in </span><span begin="01:24.320" end="01:24.689">the </span><span begin="01:24.689" end="01:25.714">movies</span></p><p ttm:agent="v1" begin="01:26.655" end="01:31.448"><span begin="01:26.655" end="01:27.033">That's </span><span begin="01:27.033" end="01:27.321">why </span><span begin="01:27.321" end="01:27.671">I'll </span><span begin="01:27.671" end="01:28.368">never </span><span begin="01:28.368" end="01:28.888">fall </span><span begin="01:28.888" end="01:29.352">in </span><span begin="01:29.352" end="01:31.448">love</span></p><p ttm:agent="v1" begin="01:56.674" end="02:01.103"><span begin="01:56.674" end="01:56.897">Oh </span><span begin="01:56.897" end="01:57.105">maybe </span><span begin="01:57.105" end="01:57.472">I'm </span><span begin="01:57.472" end="01:57.809">just </span><span begin="01:57.976" end="02:01.103">old-fashioned</span></p><p ttm:agent="v1" begin="02:01.719" end="02:06.239"><span begin="02:01.719" end="02:01.967">Read </span><span begin="02:02.095" end="02:02.421">too </span><span begin="02:02.703" end="02:02.936">many </span><span begin="02:03.103" end="02:06.239">fairytales</span></p><p ttm:agent="v1" begin="02:07.702" end="02:11.575"><span begin="02:07.702" end="02:07.910">It's </span><span begin="02:07.910" end="02:08.615">no </span><span begin="02:08.783" end="02:09.143">wonder </span><span begin="02:09.342" end="02:10.103">I've </span><span begin="02:10.415" end="02:10.631">had </span><span begin="02:10.631" end="02:10.887">no </span><span begin="02:11.063" end="02:11.575">luck</span></p><p ttm:agent="v1" begin="02:13.495" end="02:18.095"><span begin="02:13.495" end="02:13.854">No </span><span begin="02:14.007" end="02:14.287">one's </span><span begin="02:14.709" end="02:14.998">ever </span><span begin="02:15.295" end="02:16.063">good </span><span begin="02:16.350" end="02:18.095">enough</span></p><p ttm:agent="v1" begin="02:18.791" end="02:23.886"><span begin="02:18.791" end="02:19.118">I </span><span begin="02:19.263" end="02:19.527">want </span><span begin="02:19.527" end="02:20.023">a </span><span begin="02:20.023" end="02:20.488">love </span><span begin="02:20.655" end="02:21.062">like </span><span begin="02:21.062" end="02:21.503">I've </span><span begin="02:21.503" end="02:21.861">seen </span><span begin="02:22.031" end="02:22.287">in </span><span begin="02:22.287" end="02:22.632">the </span><span begin="02:22.632" end="02:23.886">movies</span></p><p ttm:agent="v1" begin="02:24.447" end="02:40.247"><span begin="02:24.447" end="02:24.847">That's </span><span begin="02:24.847" end="02:25.399">why </span><span begin="02:25.399" end="02:25.743">I'll </span><span begin="02:25.743" end="02:26.239">never </span><span begin="02:28.887" end="02:31.638">fall </span><span begin="02:31.815" end="02:34.166">in </span><span begin="02:34.310" end="02:40.247">love</span></p></div></body></tt>