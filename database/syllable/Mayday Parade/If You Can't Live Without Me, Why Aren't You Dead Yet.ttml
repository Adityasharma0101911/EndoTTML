<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>If You Can't Live Without Me, Why Aren't You Dead Yet?</ttm:title><ttm:agent type="person" xml:id="v1">Mayday Parade</ttm:agent><ttm:item type="album">Anywhere but Here (Deluxe Edition)</ttm:item><ttm:item type="spotify_id">0Z9rmJOeCBaW4fBQjSaijR</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:18.040" end="00:24.940"><span begin="00:18.040" end="00:19.240">Baby</span><span begin="00:19.240" end="00:19.390">, </span><span begin="00:19.390" end="00:19.510">I </span><span begin="00:19.510" end="00:20.230">sorely </span><span begin="00:20.230" end="00:20.710">miss </span><span begin="00:20.710" end="00:20.950">the </span><span begin="00:20.950" end="00:21.760">vibrant </span><span begin="00:21.760" end="00:22.150">gleam </span><span begin="00:22.150" end="00:22.600">that's </span><span begin="00:22.600" end="00:22.870">in </span><span begin="00:22.870" end="00:23.350">your </span><span begin="00:23.350" end="00:24.940">eyes</span></p><p ttm:agent="v1" begin="00:25.180" end="00:29.260"><span begin="00:25.180" end="00:25.540">I'll </span><span begin="00:25.540" end="00:26.050">write </span><span begin="00:26.050" end="00:26.170">a </span><span begin="00:26.170" end="00:26.800">song </span><span begin="00:26.800" end="00:27.520">about </span><span begin="00:27.520" end="00:29.260">it</span></p><p ttm:agent="v1" begin="00:29.590" end="00:33.370"><span begin="00:29.590" end="00:29.740">And </span><span begin="00:29.740" end="00:30.850">maybe </span><span begin="00:30.850" end="00:31.090">if </span><span begin="00:31.090" end="00:31.180">the </span><span begin="00:31.180" end="00:32.290">melody's </span><span begin="00:32.290" end="00:32.710">just </span><span begin="00:32.710" end="00:33.370">right</span></p><p ttm:agent="v1" begin="00:33.400" end="00:36.520"><span begin="00:33.400" end="00:33.580">I </span><span begin="00:33.580" end="00:33.910">hope </span><span begin="00:33.910" end="00:34.570">tonight </span><span begin="00:34.570" end="00:34.690">it </span><span begin="00:34.690" end="00:34.930">will </span><span begin="00:34.930" end="00:35.650">find </span><span begin="00:35.650" end="00:36.520">you</span></p><p ttm:agent="v1" begin="00:36.880" end="00:39.520"><span begin="00:36.880" end="00:37.120">It </span><span begin="00:37.120" end="00:37.600">will </span><span begin="00:37.600" end="00:38.560">remind </span><span begin="00:38.560" end="00:39.520">you</span></p><p ttm:agent="v1" begin="00:39.550" end="00:45.790"><span begin="00:39.550" end="00:39.790">But </span><span begin="00:39.790" end="00:40.150">what's </span><span begin="00:40.150" end="00:40.540">holding </span><span begin="00:40.540" end="00:40.810">me </span><span begin="00:40.810" end="00:42.700">back </span><span begin="00:42.700" end="00:42.910">is </span><span begin="00:42.910" end="00:43.000">the </span><span begin="00:43.000" end="00:43.510">thought </span><span begin="00:43.510" end="00:43.690">of </span><span begin="00:43.690" end="00:44.170">time </span><span begin="00:44.170" end="00:44.320">we </span><span begin="00:44.320" end="00:45.070">never </span><span begin="00:45.070" end="00:45.790">had</span></p><p ttm:agent="v1" begin="00:45.820" end="00:51.820"><span begin="00:45.820" end="00:46.150">My </span><span begin="00:46.150" end="00:46.540">world's </span><span begin="00:46.540" end="00:47.200">hanging </span><span begin="00:47.200" end="00:47.560">by </span><span begin="00:47.560" end="00:47.920">three </span><span begin="00:47.920" end="00:48.370">words </span><span begin="00:48.370" end="00:48.760">that </span><span begin="00:48.760" end="00:49.000">I </span><span begin="00:49.000" end="00:49.390">can't </span><span begin="00:49.390" end="00:49.810">bear </span><span begin="00:49.810" end="00:50.050">to </span><span begin="00:50.050" end="00:51.820">say</span></p><p ttm:agent="v1" begin="00:51.850" end="00:55.060"><span begin="00:51.850" end="00:52.210">When </span><span begin="00:52.210" end="00:52.480">you </span><span begin="00:52.480" end="00:53.170">hear </span><span begin="00:53.170" end="00:53.890">this </span><span begin="00:53.890" end="00:55.060">chorus</span></p><p ttm:agent="v1" begin="00:55.060" end="00:58.990"><span begin="00:55.060" end="00:55.210">Do </span><span begin="00:55.210" end="00:55.390">you </span><span begin="00:55.390" end="00:55.780">miss </span><span begin="00:55.780" end="00:55.930">the </span><span begin="00:55.930" end="00:56.290">way </span><span begin="00:56.290" end="00:56.500">the </span><span begin="00:56.500" end="00:57.070">world </span><span begin="00:57.070" end="00:57.340">was </span><span begin="00:57.340" end="00:58.060">spinning </span><span begin="00:58.060" end="00:58.600">for </span><span begin="00:58.600" end="00:58.960">us</span><span begin="00:58.960" end="00:58.990">?</span></p><p ttm:agent="v1" begin="00:58.990" end="01:01.960"><span begin="00:58.990" end="00:59.260">Do </span><span begin="00:59.260" end="00:59.590">you </span><span begin="00:59.590" end="00:59.980">hurt </span><span begin="00:59.980" end="01:00.250">the </span><span begin="01:00.250" end="01:00.700">way </span><span begin="01:00.700" end="01:01.060">that </span><span begin="01:01.060" end="01:01.360">I </span><span begin="01:01.360" end="01:01.900">do</span><span begin="01:01.900" end="01:01.960">?</span></p><p ttm:agent="v1" begin="01:01.960" end="01:06.790"><span begin="01:01.960" end="01:02.590">After </span><span begin="01:02.590" end="01:02.890">all </span><span begin="01:02.890" end="01:03.190">this </span><span begin="01:03.190" end="01:03.670">time </span><span begin="01:03.670" end="01:04.060">you </span><span begin="01:04.060" end="01:04.870">leave </span><span begin="01:04.870" end="01:05.530">me </span><span begin="01:05.530" end="01:06.790">broken</span></p><p ttm:agent="v1" begin="01:06.820" end="01:10.570"><span begin="01:06.820" end="01:07.000">This </span><span begin="01:07.000" end="01:07.450">song </span><span begin="01:07.450" end="01:07.660">is </span><span begin="01:07.660" end="01:08.260">every </span><span begin="01:08.260" end="01:08.770">word </span><span begin="01:08.770" end="01:08.920">I </span><span begin="01:08.920" end="01:09.490">left </span><span begin="01:09.490" end="01:10.570">unspoken</span></p><p ttm:agent="v1" begin="01:10.600" end="01:17.650"><span begin="01:10.600" end="01:10.960">When </span><span begin="01:10.960" end="01:11.200">you </span><span begin="01:11.200" end="01:11.590">hear </span><span begin="01:11.590" end="01:11.950">this</span><span begin="01:11.950" end="01:11.950">, </span><span begin="01:11.950" end="01:12.370">girl</span><span begin="01:12.370" end="01:12.370">, </span><span begin="01:12.370" end="01:12.670">I'm </span><span begin="01:12.670" end="01:14.170">hoping </span><span begin="01:14.170" end="01:14.680">that </span><span begin="01:14.680" end="01:14.830">you </span><span begin="01:14.830" end="01:15.490">think </span><span begin="01:15.490" end="01:15.670">of </span><span begin="01:15.670" end="01:17.650">us</span></p><p ttm:agent="v1" begin="01:19.990" end="01:24.040"><span begin="01:19.990" end="01:20.500">That </span><span begin="01:20.500" end="01:20.650">you </span><span begin="01:20.650" end="01:21.310">think </span><span begin="01:21.310" end="01:21.490">of </span><span begin="01:21.490" end="01: