930" end="00:35.110">can </span><span begin="00:35.110" end="00:35.320">beat </span><span begin="00:35.320" end="00:35.440">the </span><span begin="00:35.440" end="00:36.130">clock</span></p><p ttm:agent="v1" begin="00:36.130" end="00:37.540"><span begin="00:36.130" end="00:36.340">You </span><span begin="00:36.340" end="00:36.520">can </span><span begin="00:36.520" end="00:36.760">move </span><span begin="00:36.760" end="00:36.850">a </span><span begin="00:36.850" end="00:37.540">mountain</span></p><p ttm:agent="v1" begin="00:37.600" end="00:38.890"><span begin="00:37.600" end="00:37.720">You </span><span begin="00:37.720" end="00:37.930">can </span><span begin="00:37.930" end="00:38.260">break </span><span begin="00:38.260" end="00:38.890">rocks</span></p><p ttm:agent="v1" begin="00:38.920" end="00:40.390"><span begin="00:38.920" end="00:39.160">You </span><span begin="00:39.160" end="00:39.310">can </span><span begin="00:39.310" end="00:39.550">be </span><span begin="00:39.550" end="00:39.640">a </span><span begin="00:39.640" end="00:40.390">master</span></p><p ttm:agent="v1" begin="00:40.420" end="00:41.740"><span begin="00:40.420" end="00:40.720">Don't </span><span begin="00:40.720" end="00:40.990">wait </span><span begin="00:40.990" end="00:41.140">for </span><span begin="00:41.140" end="00:41.740">luck</span></p><p ttm:agent="v1" begin="00:41.770" end="00:43.930"><span begin="00:41.770" end="00:42.340">Dedicate </span><span begin="00:42.340" end="00:42.790">yourself </span><span begin="00:42.790" end="00:42.910">and </span><span begin="00:42.910" end="00:43.000">you </span><span begin="00:43.000" end="00:43.180">can </span><span begin="00:43.180" end="00:43.480">find </span><span begin="00:43.480" end="00:43.930">yourself</span></p><p ttm:agent="v1" begin="00:43.930" end="00:46.360"><span begin="00:43.930" end="00:44.380">Standing </span><span begin="00:44.380" end="00:44.530">in </span><span begin="00:44.530" end="00:44.680">the </span><span begin="00:44.680" end="00:45.100">hall </span><span begin="00:45.100" end="00:45.160">of </span><span begin="00:45.160" end="00:46.360">fame</span></p><p ttm:agent="v1" begin="00:49.030" end="00:51.940"><span begin="00:49.030" end="00:49.240">And </span><span begin="00:49.240" end="00:49.360">the </span><span begin="00:49.360" end="00:49.930">world's </span><span begin="00:49.930" end="00:50.260">gonna </span><span begin="00:50.260" end="00:50.470">know </span><span begin="00:50.470" end="00:50.770">your </span><span begin="00:50.770" end="00:51.940">name</span></p><p ttm:agent="v1" begin="00:54.610" end="00:57.610"><span begin="00:54.610" end="00:54.910">Cause </span><span begin="00:54.910" end="00:55.030">you </span><span begin="00:55.030" end="00:55.600">burn </span><span begin="00:55.600" end="00:55.750">with </span><span begin="00:55.750" end="00:55.870">the </span><span begin="00:55.870" end="00:56.440">brightest </span><span begin="00:56.440" end="00:57.610">flame</span></p><p ttm:agent="v1" begin="01:00.340" end="01:04.870"><span begin="01:00.340" end="01:00.520">And </span><span begin="01:00.520" end="01:00.640">the </span><span begin="01:00.640" end="01:01.210">world's </span><span begin="01:01.210" end="01:01.540">gonna </span><span begin="01:01.540" end="01:01.780">know </span><span begin="01:01.780" end="01:02.050">your </span><span begin="01:02.050" end="01:04.870">name</span></p><p ttm:agent="v1" begin="01:04.930" end="01:07.480"><span begin="01:04.930" end="01:05.140">And </span><span begin="01:05.140" end="01:05.290">you'll </span><span begin="01:05.290" end="01:05.530">be </span><span begin="01:05.530" end="01:05.680">on </span><span begin="01:05.680" end="01:05.800">the </span><span begin="01:05.800" end="01:06.280">walls </span><span begin="01:06.280" end="01:06.370">of </span><span begin="01:06.370" end="01:06.580">the </span><span begin="01:06.580" end="01:06.970">hall </span><span begin="01:06.970" end="01:07.030">of </span><span begin="01:07.030" end="01:07.