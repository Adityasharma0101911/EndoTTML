12.990" end="00:13.140">it </span><span begin="00:13.140" end="00:13.500">hard </span><span begin="00:13.500" end="00:13.650">it </span><span begin="00:13.650" end="00:13.980">was </span><span begin="00:13.980" end="00:14.550">over </span><span begin="00:14.550" end="00:14.820">your </span><span begin="00:14.820" end="00:15.360">face</span></p><p ttm:agent="v1" begin="00:15.360" end="00:17.790"><span begin="00:15.360" end="00:15.690">Since </span><span begin="00:15.690" end="00:15.840">you</span><span begin="00:15.840" end="00:15.960">’</span><span begin="00:15.960" end="00:16.020">re </span><span begin="00:16.020" end="00:16.890">slippin </span><span begin="00:16.890" end="00:17.130">and </span><span begin="00:17.130" end="00:17.790">flippin</span></p><p ttm:agent="v1" begin="00:17.880" end="00:19.590"><span begin="00:17.880" end="00:18.090">But </span><span begin="00:18.090" end="00:18.390">here </span><span begin="00:18.390" end="00:18.630">is </span><span begin="00:18.630" end="00:18.750">the </span><span begin="00:18.750" end="00:19.590">sitch</span></p><p ttm:agent="v1" begin="00:19.860" end="00:21.720"><span begin="00:19.860" end="00:20.010">I </span><span begin="00:20.010" end="00:20.460">signed </span><span begin="00:20.460" end="00:20.610">up </span><span begin="00:20.610" end="00:20.970">for </span><span begin="00:20.970" end="00:21.030">a </span><span begin="00:21.030" end="00:21.720">membership</span></p><p ttm:agent="v1" begin="00:21.720" end="00:23.430"><span begin="00:21.720" end="00:21.900">You </span><span begin="00:21.900" end="00:22.080">are </span><span begin="00:22.080" end="00:22.710">just </span><span begin="00:22.710" end="00:23.040">a </span><span begin="00:23.040" end="00:23.110">*</span><span begin="00:23.110" end="00:23.180">*</span><span begin="00:23.180" end="00:23.250">*</span><span begin="00:23.250" end="00:23.320">*</span><span begin="00:23.320" end="00:23.430">*</span></p><p ttm:agent="v1" begin="00:23.430" end="00:24.060"><span begin="00:23.430" end="00:23.580">You </span><span begin="00:23.580" end="00:23.850">should </span><span begin="00:23.850" end="00:24.060">know</span></p><p ttm:agent="v1" begin="00:27.330" end="00:32.070"><span begin="00:27.330" end="00:27.720">That </span><span begin="00:27.720" end="00:27.810">I </span><span begin="00:27.810" end="00:31.350">love </span><span begin="00:31.350" end="00:31.710">you </span><span begin="00:31.710" end="00:32.070">alone</span></p><p ttm:agent="v1" begin="00:35.460" end="00:39.690"><span begin="00:35.460" end="00:35.940">But </span><span begin="00:35.940" end="00:36.060">I </span><span begin="00:36.060" end="00:36.600">just </span><span begin="00:36.600" end="00:37.020">can</span><span begin="00:37.020" end="00:37.050">’</span><span begin="00:37.050" end="00:37.110">t </span><span begin="00:37.110" end="00:37.680">date </span><span begin="00:37.680" end="00:37.830">a </span><span begin="00:37.830" end="00:38.310">dude </span><span begin="00:38.310" end="00:38.700">with </span><span begin="00:38.700" end="00:39.060">a </span><span begin="00:39.060" end="00:39.690">vag</span></p><p ttm:agent="v1" begin="00:39.690" end="00:41.520"><span begin="00:39.690" end="00:39.870">When </span><span begin="00:39.870" end="00:40.110">we </span><span begin="00:40.110" end="00:40.620">fell </span><span begin="00:40.620" end="00:41.100">in </span><span begin="00:41.100" end="00:41.520">love</span></p><p ttm:agent="v1" begin="00:41.610" end="00:43.650"><span begin="00:41.610" end="00:41.820">You </span><span begin="00:41.820" end="00:42.300">made </span><span begin="00:42.300" end="00:42.630">my </span><span begin="00:42.630" end="00:43.050">heart </span><span begin="00:43.050" end="00:43.650">drop</span></p><p ttm:agent="v1" begin="00:43.710" end="00:47.460"><span begin="00:43.710" end="00:43.920">And </span><span begin="00:43.920" end="00:44.130">you </span><span begin="00:44.130" end="00:44.520">had </span><span begin="00:44.520" end="00:45.030">me </spa