<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Wish You Were Here</ttm:title><ttm:agent type="person" xml:id="v1">Incubus</ttm:agent><ttm:item type="album">Morning View</ttm:item><ttm:item type="spotify_id">6KtLECDztnah63TNmV4Plw</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:45.510" end="00:49.200"><span begin="00:45.510" end="00:45.720">I </span><span begin="00:45.720" end="00:46.140">dig </span><span begin="00:46.140" end="00:46.440">my </span><span begin="00:46.440" end="00:47.070">toes </span><span begin="00:47.070" end="00:47.490">into </span><span begin="00:47.490" end="00:47.640">the </span><span begin="00:47.640" end="00:49.200">sand</span></p><p ttm:agent="v1" begin="00:51.000" end="00:54.450"><span begin="00:51.000" end="00:51.510">The </span><span begin="00:51.510" end="00:52.080">ocean </span><span begin="00:52.080" end="00:52.500">looks </span><span begin="00:52.500" end="00:52.890">like </span><span begin="00:52.890" end="00:52.950">a </span><span begin="00:52.950" end="00:53.670">thousand </span><span begin="00:53.670" end="00:54.450">diamonds</span></p><p ttm:agent="v1" begin="00:54.450" end="00:56.430"><span begin="00:54.450" end="00:54.840">Strewn </span><span begin="00:54.840" end="00:55.380">across </span><span begin="00:55.380" end="00:55.470">a </span><span begin="00:55.470" end="00:55.740">blue </span><span begin="00:55.740" end="00:56.430">blanket</span></p><p ttm:agent="v1" begin="00:56.880" end="00:59.640"><span begin="00:56.880" end="00:57.090">I </span><span begin="00:57.090" end="00:57.630">lean </span><span begin="00:57.630" end="00:58.320">against </span><span begin="00:58.320" end="00:58.440">the </span><span begin="00:58.440" end="00:59.610">wind</span><span begin="00:59.610" end="00:59.640">,</span></p><p ttm:agent="v1" begin="00:59.640" end="01:02.460"><span begin="00:59.640" end="01:00.270">Pretend </span><span begin="01:00.270" end="01:00.630">that </span><span begin="01:00.630" end="01:01.020">I </span><span begin="01:01.020" end="01:01.260">am </span><span begin="01:01.260" end="01:02.460">weightless</span></p><p ttm:agent="v1" begin="01:02.490" end="01:08.850"><span begin="01:02.490" end="01:02.820">And </span><span begin="01:02.820" end="01:03.120">in </span><span begin="01:03.120" end="01:03.450">this </span><span begin="01:03.450" end="01:04.170">moment </span><span begin="01:04.170" end="01:04.440">I </span><span begin="01:04.440" end="01:04.950">am </span><span begin="01:04.950" end="01:06.420">happy</span><span begin="01:06.420" end="01:06.500">.</span><span begin="01:06.500" end="01:06.580">.</span><span begin="01:06.580" end="01:06.660">.</span><span begin="01:06.660" end="01:06.740">.</span><span begin="01:06.740" end="01:06.840">（</span><span begin="01:06.840" end="01:08.610">happy</span><span begin="01:08.610" end="01:08.850">）</span></p><p ttm:agent="v1" begin="01:08.850" end="01:14.400"><span begin="01:08.850" end="01:12.000">I </span><span begin="01:12.000" end="01:12.450">wish </span><span begin="01:12.450" end="01:12.720">you </span><span begin="01:12.720" end="01:13.080">were </span><span begin="01:13.080" end="01:14.400">here</span></p><p ttm:agent="v1" begin="01:14.490" end="01:20.070"><span begin="01:14.490" end="01:17.340">I </span><span begin="01:17.340" end="01:18.180">wish </span><span begin="01:18.180" end="01:18.390">you </span><span begin="01:18.390" end="01:18.840">were </span><span begin="01:18.840" end="01:20.070">here</span></p><p ttm:agent="v1" begin="01:20.130" end="01:25.710"><span begin="01:20.130" end="01:23.310">I </span><span begin="01:23.310" end="01:23.790">wish </span><span begin="01:23.790" end="01:24.060">you </span><span begin="01:24.060" end="01:24.420">were </span><span begin="01:24.420" end="01:25.710">here</span></p><p ttm:agent="v1" begin="01:25.770" end="01:33.330"><span begin="01:25.770" end="01:28.620">I </span><span begin="01:28.620" end="01:29.460">wish </span><span begin="01:29.460" end="01:30.300">you </span><span begin="01:30.300" end="01:30.750">were</span><span begin="01:30.750" end="01:30.830">.</span><span begin="01:30.830" end="01:30.910">.</span><span begin="01:30.910" end="01:30.990">.</span><span begin="01:30.990" end="01:31.070">.</span><span begin="01:31.070" end="01:31.150">.</span><span begin="01:31.150" end="01:31.230">.</span><span begin="01:31.230" end="01:31.320">.</span><span begin="01:31.320" end="01:33.330">here</span></p><p ttm:agent="v1" begin="01:42.030" end="01:45.930"><span begin="01:42.030" end="01:42.180">I </span><span begin="01:42.180" end="01:42.690">lay </span><span begin="01:42.690" end="01:42.930">my </span><span begin="01:42.930" end="01:43.380">head </span><span begin="01:43.380" end="01:43.980">onto </span><span begin="01:43.980" end="01:44.130">the </span><span begin="01:44.130" end="01:45.930">sand</span></p><p ttm:agent="v1" begin="01:47.610" end="01:50.970"><span begin="01:47.610" end="01:47.820">The </span><span begin="01:47.820" end="01:48.210">sky </span><span begin="01:48.210" end="01:49.350">resembles </span><span begin="01:49.350" end="01:49.470">a </span><span begin="01:49.470" end="01:50.100">backlit </span><span begin="01:50.100" end="01:50.970">canopy</span></p><p ttm:agent="v1" begin="01:50.970" end="01:53.070"><span begin="01:50.970" end="01:51.360">With </span><span begin="01:51.360" end="01:51.930">holes </span><span begin="01:51.930" end="01:52.380">punched </span><span begin="01:52.380" end="01:52.560">in </span><span begin="01:52.560" end="01:53.070">it</span></p><p ttm:agent="v1" begin="01:53.310" end="01:55.920"><span begin="01:53.310" end="01:53.640">I'm </span><span begin="01:53.640" end="01:54.210">Counting </span><span begin="01:54.210" end="01:54.510">U</span><span begin="01:54.510" end="01:54.510">.</span><span begin="01:54.510" end="01:54.840">F</span><span begin="01:54.840" end="01:54.840">.</span><span begin="01:54.840" end="01:55.920">O's</span></p><p ttm:agent="v1" begin="01:55.950" end="01:58.860"><span begin="01:55.950" end="01:56.100">I </span><span begin="01:56.100" end="01:56.640">signal </span><span begin="01:56.640" end="01:57.030">them </span><span begin="01:57.030" end="01:57.570">with </span><span begin="01:57.570" end="01:57.930">my </span><span begin="01:57.930" end="01:58.860">lighter</span></p><p ttm:agent="v1" begin="01:58.950" end="02:04.740"><span begin="01:58.950" end="01:59.280">And </span><span begin="01:59.280" end="01:59.550">in </span><span begin="01:59.550" end="01:59.880">this </span><span begin="01:59.880" end="02:00.600">moment </span><span begin="02:00.600" end="02:00.960">I </span><span begin="02:00.960" end="02:01.440">am </span><span begin="02:01.440" end="02:02.970">happy</span><span begin="02:02.970" end="02:03.040">.</span><span begin="02:03.040" end="02:03.110">.</span><span begin="02:03.110" end="02:03.180">.</span><span begin="02:03.180" end="02:03.250">.</span><span begin="02:03.250" end="02:03.360">.</span><span begin="02:03.360" end="02:04.740">happy</span></p><p ttm:agent="v1" begin="02:05.310" end="02:10.920"><span begin="02:05.310" end="02:08.460">I </span><span begin="02:08.460" end="02:08.940">wish </span><span begin="02:08.940" end="02:09.210">you </span><span begin="02:09.210" end="02:09.570">were </span><span begin="02:09.570" end="02:10.920">here</span></p><p ttm:agent="v1" begin="02:10.950" end="02:16.530"