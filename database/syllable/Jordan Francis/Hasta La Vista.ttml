<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Hasta La Vista</ttm:title><ttm:agent type="group" xml:id="v1">Jordan Francis, Roshon Bernard Fegan</ttm:agent><ttm:item type="album">Camp Rock</ttm:item><ttm:item type="spotify_id">2tQjS2hrxfrtJQFIdHeXGD</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:01.410" end="00:02.040"><span begin="00:01.410" end="00:02.040">Yeah</span></p><p ttm:agent="v1" begin="00:02.400" end="00:03.780"><span begin="00:02.400" end="00:02.745">It's </span><span begin="00:02.745" end="00:03.090">Your </span><span begin="00:03.090" end="00:03.435">boy </span><span begin="00:03.435" end="00:03.780">Barron</span></p><p ttm:agent="v1" begin="00:04.770" end="00:05.070"><span begin="00:04.770" end="00:05.070">Yo</span></p><p ttm:agent="v1" begin="00:05.130" end="00:06.240"><span begin="00:05.130" end="00:05.280">And </span><span begin="00:05.280" end="00:05.370">the </span><span begin="00:05.370" end="00:05.700">place </span><span begin="00:05.700" end="00:05.820">to </span><span begin="00:05.820" end="00:06.240">be</span></p><p ttm:agent="v1" begin="00:06.300" end="00:07.200"><span begin="00:06.300" end="00:06.540">It's </span><span begin="00:06.540" end="00:07.200">crazy</span></p><p ttm:agent="v1" begin="00:07.410" end="00:09.810"><span begin="00:07.410" end="00:07.800">Come </span><span begin="00:07.800" end="00:08.130">rock </span><span begin="00:08.130" end="00:08.280">with </span><span begin="00:08.280" end="00:08.970">me</span><span begin="00:08.970" end="00:09.810">!</span></p><p ttm:agent="v1" begin="00:09.810" end="00:10.950"><span begin="00:09.810" end="00:10.230">Couldn't </span><span begin="00:10.230" end="00:10.410">wait </span><span begin="00:10.410" end="00:10.530">to </span><span begin="00:10.530" end="00:10.920">leave</span><span begin="00:10.920" end="00:10.950">,</span></p><p ttm:agent="v1" begin="00:10.950" end="00:12.240"><span begin="00:10.950" end="00:11.130">But </span><span begin="00:11.130" end="00:11.310">now </span><span begin="00:11.310" end="00:11.400">I </span><span begin="00:11.400" end="00:11.550">hate </span><span begin="00:11.550" end="00:11.700">to </span><span begin="00:11.700" end="00:12.240">go</span></p><p ttm:agent="v1" begin="00:12.270" end="00:13.380"><span begin="00:12.270" end="00:12.660">Last </span><span begin="00:12.660" end="00:12.840">day </span><span begin="00:12.840" end="00:12.930">of </span><span begin="00:12.930" end="00:13.350">camp</span><span begin="00:13.350" end="00:13.380">,</span></p><p ttm:agent="v1" begin="00:13.380" end="00:14.790"><span begin="00:13.380" end="00:13.710">Packing </span><span begin="00:13.710" end="00:13.800">my </span><span begin="00:13.800" end="00:14.130">bags </span><span begin="00:14.130" end="00:14.790">slow</span></p><p ttm:agent="v1" begin="00:14.790" end="00:15.840"><span begin="00:14.790" end="00:14.880">Made </span><span begin="00:14.880" end="00:15.000">so </span><span begin="00:15.000" end="00:15.300">many </span><span begin="00:15.300" end="00:15.810">friends</span><span begin="00:15.810" end="00:15.840">,</span></p><p ttm:agent="v1" begin="00:15.840" end="00:17.010"><span begin="00:15.840" end="00:15.990">Why </span><span begin="00:15.990" end="00:16.170">does </span><span begin="00:16.170" end="00:16.260">it </span><span begin="00:16.260" end="00:16.410">have </span><span begin="00:16.410" end="00:16.560">to </span><span begin="00:16.560" end="00:17.010">end</span></p><p ttm:agent="v1" begin="00:17.160" end="00:18.420"><span begin="00:17.160" end="00:17.370">In </span><span begin="00:17.370" end="00:17.490">the </span><span begin="00:17.490" end="00:17.850">end </span><span begin="00:17.850" end="00:18.000">its </span><span begin="00:18.000" end="00:18.060">a </span><span begin="00:18.060" end="00:18.390">win</span><span begin="00:18.390" end="00:18.420">,</span></p><p ttm:agent="v1" begin="00:18.420" end="00:19.800"><span begin="00:18.420" end="00:18.570">Because </span><span begin="00:18.570" end="00:18.690">we </span><span begin="00:18.690" end="00:18.870">grown </span><span begin="00:18.870" end="00:18.990">so </span><span begin="00:18.990" end="00:19.200">close </span><span begin="00:19.200" end="00:19.800">together</span></p><p ttm:agent="v1" begin="00:19.800" end="00:21.360"><span begin="00:19.800" end="00:20.190">Remember </span><span begin="00:20.190" end="00:20.370">when </span><span begin="00:20.370" end="00:20.490">we </span><span begin="00:20.490" end="00:20.820">first </span><span begin="00:20.820" end="00:21.330">met</span><span begin="00:21.330" end="00:21.360">,</span></p><p ttm:agent="v1" begin="00:21.360" end="00:22.350"><span begin="00:21.360" end="00:21.780">First </span><span begin="00:21.780" end="00:22.350">day</span></p><p ttm:agent="v1" begin="00:22.350" end="00:23.760"><span begin="00:22.350" end="00:22.620">Figured </span><span begin="00:22.620" end="00:22.770">this </span><span begin="00:22.770" end="00:22.950">would </span><span begin="00:22.950" end="00:23.040">be </span><span begin="00:23.040" end="00:23.190">no </span><span begin="00:23.190" end="00:23.610">fun</span><span begin="00:23.610" end="00:23.760">,</span></p><p ttm:agent="v1" begin="00:23.760" end="00:24.540"><span begin="00:23.760" end="00:24.120">No </span><span begin="00:24.120" end="00:24.540">way</span></p><p ttm:agent="v1" begin="00:24.540" end="00:25.860"><span begin="00:24.540" end="00:24.690">And </span><span begin="00:24.690" end="00:24.930">now </span><span begin="00:24.930" end="00:25.050">its </span><span begin="00:25.050" end="00:25.260">time </span><span begin="00:25.260" end="00:25.350">to </span><span begin="00:25.350" end="00:25.770">leave</span><span begin="00:25.770" end="00:25.770">, </span><span begin="00:25.770" end="00:25.770">（</span><span begin="00:25.770" end="00:25.860">leave</span><span begin="00:25.860" end="00:25.860">）</span></p><p ttm:agent="v1" begin="00:25.860" end="00:29.040"><span begin="00:25.860" end="00:25.950">But </span><span begin="00:25.950" end="00:26.100">now </span><span begin="00:26.100" end="00:26.250">we </span><span begin="00:26.250" end="00:26.520">wanna </span><span begin="00:26.520" end="00:27.390">stay</span><span begin="00:27.390" end="00:27.390">, </span><span begin="00:27.390" end="00:27.390">（</span><span begin="00:27.390" end="00:27.840">stay</span><span begin="00:27.840" end="00:27.840">, </span><span begin="00:27.840" end="00:28.140">stay</span><span begin="00:28.140" end="00:28.140">, </span><span begin="00:28.140" end="00:28.560">stay</span><span begin="00:28.560" end="00:28.560">, </span><span begin="00:28.560" end="00:29.010">stay</span><span begin="00:29.010" end="00:29.040">）</span></p><p ttm:agent="v1" begin="00:29.040" end="00:29.520"><span begin="00:29.040" end="00:29.520">Oh</span><span begin="00:29.520" end="00:29.520">!</span></p><p ttm:agent="v1" begin="00:29.520" end="00:31.110"><span begin="00:29.520" end="00:30.060">Hasta </span><span begin="00:30.060" end="00:30.210">la </span><span begin="00:30.210" end="00:31.110">vista</span></p><p ttm:agent="v1" begin="00:31.110" end="00:33.000"><span begin="00:31.110" end="00:31.470">I'm </span><span begin="00:31.470" end="00:31.680">gonna </span><span begin="00:31.680" end="00:31.890">say </span><span begin="00:31.890" end="00:32.400">goodbye </span><span begin="00:32.400" end="00:32.610">to </span><span begin="00:32.610" end="00:33.000">you</span></p><p ttm:agent="v1" begin="00:33.360" end="00:35.370"><span begin="00:33.360" end="00:33.840">Whatever </span><span begin="00:33.840" end="00:34.200">happens </span><span begin="00:34.200" end="00:34.320">I'll </span><span begin="00:34.320" end="00:34.440">be </span><span begin="00:34.440" end="00:34.890">cool </span><span begin="00:34.890" end="00:35.100">with </span><span begin="00:35.100" end="00:35.370">you</span></p><p ttm:agent="v1" begin="00:35.370" end="00:37.470"><span begin="00:35.370" end="00:35.640">Wanna </span><span begin="00:35.640" end="00:35.820">give </span><span begin="00:35.820" end="00:35.970">me </span><span begin="00:35.970" end="00:36.120">your </span><span begin="00:36.120" end="00:36.780">number </span><span begin="00:36.780" end="00:36.900">I'll </span><span begin="00:36.900" end="00:37.200">call </span><span begin="00:37.200" end="00:37.470">ya</span></p><p ttm:agent="v1" begin="00:37.470" end="00:39.180"><span begin="00:37.470" end="00:37.860">Promise </span><span begin="00:37.860" end="00:37.950">I </span><span begin="00:37.950" end="00:38.220">won't </span><span begin="00:38.220" end="00:38.760">forget </span><span begin="00:38.760" end="00:39.180">ya</span></p><p ttm:agent="v1" begin="00:39.210" end="00:40.800"><span begin="00:39.210" end="00:39.750">Hasta </span><span begin="00:39.750" end="00:39.930">la </span><span begin="00:39.930" end="00:40.800">vista</span></p><p ttm:agent="v1" begin="00:40.830" end="00:42.930"><span begin="00:40.830" end="00:41.190">We'll </span><span begin="00:41.190" end="00:41.280">all </span><span begin="00:41.280" end="00:41.430">be </span><span begin="00:41.430" end="00:41.700">going </span><span begin="00:41.700" end="00:42.360">seperate </span><span begin="00:42.360" end="00:42.930">ways</span></p><p ttm:agent="v1" begin="00:43.080" end="00:44.460"><span begin="00:43.080" end="00:43.590">Say </span><span begin="00:43.590" end="00:43.980">everything </span><span begin="00:43.980" end="00:44.070">you </span><span begin="00:44.070" end="00:44.190">didn't </span><span begin="00:44.190" end="00:44.460">say</span></p><p ttm:agent="v1" begin="00:44.460" end="00:46.500"><span begin="00:44.460" end="00:44.820">This </span><span begin="00:44.820" end="00:45.090">is </span><span begin="00:45.090" end="00:45.210">your </span><span begin="00:45.210" end="00:45.780">moment</span><span begin="00:45.780" end="00:45.780">, </span><span begin="00:45.780" end="00:46.080">before </span><span begin="00:46.080" end="00:46.260">you </span><span begin="00:46.260" end="00:46.500">go</span></p><p ttm:agent="v1" begin="00:46.500" end="00:48.420"><span begin="00:46.500" end="00:46.740">Come </span><span begin="00:46.740" end="00:46.860">on </span><span begin="00:46.860" end="00:47.160">now </span><span begin="00:47.160" end="00:47.370">get </span><span begin="00:47.370" end="00:47.520">up </span><span begin="00:47.520" end="00:47.610">and </span><span begin="00:47.610" end="00:47.910">show </span><span begin="00:47.910" end="00:48.420">them</span></p><p ttm:agent="v1" begin="00:48.420" end="00:50.250"><span begin="00:48.420" end="00:48.648">Keep </span><span begin="00:48.648" end="00:48.876">doing </span><span begin="00:48.876" end="00:49.104">your </span><span begin="00:49.104" end="00:49.332">thing</span><span begin="00:49.332" end="00:49.560">, </span><span begin="00:49.560" end="00:49.788">thing</span><span begin="00:49.788" end="00:50.016">, </span><span begin="00:50.016" end="00:50.250">thing</span></p><p ttm:agent="v1" begin="00:50.280" end="00:52.170"><span begin="00:50.280" end="00:50.760">Keep </span><span begin="00:50.760" end="00:51.120">doing </span><span begin="00:51.120" end="00:51.360">your </span><span begin="00:51.360" end="00:51.780">thing</span><span begin="00:51.780" end="00:51.780">, </span><span begin="00:51.780" end="00:52.020">thing</span><span begin="00:52.020" end="00:52.020">, </span><span begin="00:52.020" end="00:52.170">thing</span></p><p ttm:agent="v1" begin="00:52.170" end="00:53.580"><span begin="00:52.170" end="00:52.200">（</span><span begin="00:52.200" end="00:52.380">And </span><span begin="00:52.380" end="00:52.500">I'm </span><span begin="00:52.500" end="00:52.620">gonna </span><span begin="00:52.620" end="00:52.860">do </span><span begin="00:52.860" end="00:53.190">my </span><span begin="00:53.190" end="00:53.580">thing</span><span begin="00:53.580" end="00:53.580">）</span></p><p ttm:agent="v1" begin="00:53.580" end="00:55.770"><span begin="00:53.580" end="00:53.700">There's </span><span begin="00:53.700" end="00:53.820">so </span><span begin="00:53.820" end="00:54.840">much </span><span begin="00:54.840" end="00:55.290">inside </span><span begin="00:55.290" end="00:55.350">of </span><span begin="00:55.350" end="00:55.770">me</span></p><p ttm:agent="v1" begin="00:55.920" end="00:58.200"><span begin="00:55.920" end="00:56.130">There's </span><span begin="00:56.130" end="00:56.250">so </span><span begin="00:56.250" end="00:56.610">much </span><span begin="00:56.610" end="00:57.120">more </span><span begin="00:57.120" end="00:57.180">I </span><span begin="00:57.180" end="00:57.480">just </span><span begin="00:57.480" end="00:57.690">want </span><span begin="00:57.690" end="00:57.750">to </span><span begin="00:57.750" end="00:58.200">be</span></p><p ttm:agent="v1" begin="00:58.350" end="01:00.900"><span begin="00:58.350" end="00:58.560">All </span><span begin="00:58.560" end="00:58.650">the </span><span begin="00:58.650" end="00:59.070">things </span><span begin="00:59.070" end="00:59.250">I've </span><span begin="00:59.250" end="00:59.610">seen</span><span begin="00:59.610" end="00:59.610">, </span><span begin="00:59.610" end="01:00.210">obviously </span><span begin="01:00.210" end="01:00.390">I'm </span><span begin="01:00.390" end="01:00.900">inspired</span></p><p ttm:agent="v1" begin="01:00.900" end="01:03.360"><span begin="01:00.900" end="01:01.110">Got </span>