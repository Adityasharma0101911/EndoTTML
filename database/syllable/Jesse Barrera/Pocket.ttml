<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Pocket</ttm:title><ttm:agent type="group" xml:id="v1">Jesse Barrera, Albert Posis, Patrick Hizon</ttm:agent><ttm:item type="album">Pocket</ttm:item><ttm:item type="spotify_id">4lb0Dxf9b2aywF6AN2ZJdh</ttm:item><itunes:duration>02:36.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:15.828" end="00:16.964"><span begin="00:15.828" end="00:16.068">There's </span><span begin="00:16.068" end="00:16.340">something </span><span begin="00:16.340" end="00:16.587">I </span><span begin="00:16.587" end="00:16.964">need</span></p><p ttm:agent="v1" begin="00:17.451" end="00:20.699"><span begin="00:17.451" end="00:17.691">And </span><span begin="00:17.691" end="00:17.956">I </span><span begin="00:17.956" end="00:18.269">think </span><span begin="00:18.269" end="00:18.716">you </span><span begin="00:18.716" end="00:19.013">know </span><span begin="00:19.013" end="00:19.252">what </span><span begin="00:19.252" end="00:19.475">I'm </span><span begin="00:19.475" end="00:19.797">talking </span><span begin="00:19.797" end="00:20.699">about</span></p><p ttm:agent="v1" begin="00:21.316" end="00:22.572"><span begin="00:21.316" end="00:21.548">Yeah </span><span begin="00:21.548" end="00:21.764">you're </span><span begin="00:21.764" end="00:22.572">different</span></p><p ttm:agent="v1" begin="00:22.868" end="00:24.356"><span begin="00:22.868" end="00:23.076">And </span><span begin="00:23.076" end="00:23.340">it </span><span begin="00:23.340" end="00:24.356">feels</span></p><p ttm:agent="v1" begin="00:24.540" end="00:25.476"><span begin="00:24.540" end="00:24.708">Like </span><span begin="00:24.708" end="00:24.860">you're </span><span begin="00:24.860" end="00:25.124">something </span><span begin="00:25.124" end="00:25.476">that</span></p><p ttm:agent="v1" begin="00:25.669" end="00:27.459"><span begin="00:25.669" end="00:25.820">I </span><span begin="00:25.820" end="00:26.037">could </span><span begin="00:26.037" end="00:26.740">never </span><span begin="00:26.740" end="00:27.459">doubt</span></p><p ttm:agent="v1" begin="00:27.644" end="00:27.995"><span begin="00:27.644" end="00:27.819">No </span><span begin="00:27.819" end="00:27.995">doubt</span></p><p ttm:agent="v1" begin="00:27.995" end="00:28.421"><span begin="00:27.995" end="00:28.131">No </span><span begin="00:28.131" end="00:28.421">doubt</span></p><p ttm:agent="v1" begin="00:28.421" end="00:28.964"><span begin="00:28.421" end="00:28.604">No </span><span begin="00:28.604" end="00:28.764">doubt </span><span begin="00:28.764" end="00:28.964">no</span></p><p ttm:agent="v1" begin="00:28.964" end="00:30.004"><span begin="00:28.964" end="00:29.124">Baby </span><span begin="00:29.124" end="00:29.284">just </span><span begin="00:29.284" end="00:29.443">scream </span><span begin="00:29.443" end="00:29.748">it </span><span begin="00:29.748" end="00:30.004">loud</span></p><p ttm:agent="v1" begin="00:30.284" end="00:31.467"><span begin="00:30.284" end="00:30.676">I </span><span begin="00:30.676" end="00:30.916">like </span><span begin="00:30.916" end="00:31.108">the </span><span begin="00:31.108" end="00:31.276">way </span><span begin="00:31.276" end="00:31.467">we</span></p><p ttm:agent="v1" begin="00:31.467" end="00:32.628"><span begin="00:31.467" end="00:31.732">**** </span><span begin="00:31.732" end="00:32.628">around</span></p><p ttm:agent="v1" begin="00:32.916" end="00:34.340"><span begin="00:32.916" end="00:33.131">I'm </span><span begin="00:33.131" end="00:33.453">in </span><span begin="00:33.684" end="00:33.876">and </span><span begin="00:33.876" end="00:34.340">out</span></p><p ttm:agent="v1" begin="00:34.540" end="00:35.988"><span begin="00:34.540" end="00:34.692">And </span><span begin="00:34.692" end="00:34.836">then </span><span begin="00:34.836" end="00:34.996">we're </span><span begin="00:34.996" end="00:35.476">upside </span><span begin="00:35.476" end="00:35.988">down</span></p><p ttm:agent="v1" begin="00:36.372" end="00:37.828"><span begin="00:36.372" end="00:36.740">Call </span><span begin="00:36.740" end="00:36.987">me </span><span begin="00:36.987" end="00:37.828">later</span></p><p ttm:agent="v1" begin="00:38.067" end="00:39.613"><span begin="00:38.067" end="00:38.372">You </span><span begin="00:38.372" end="00:38.820">know </span><span begin="00:38.820" end="00:39.108">I'm </span><span begin="00:39.108" end="00:39.324">always </span><span begin="00:39.324" end="00:39.613">down</span></p><p ttm:agent="v1" begin="00:39.900" end="00:41.047"><span begin="00:39.900" end="00:40.180">Know </span><span begin="00:40.180" end="00:40.371">I'm </span><span begin="00:40.371" end="00:40.716">always </span><span begin="00:40.716" end="00:41.047">down</span></p><p ttm:agent="v1" begin="00:42.903" end="00:45.054"><span begin="00:42.903" end="00:43.167">I </span><span begin="00:43.167" end="00:43.983">know </span><span begin="00:43.983" end="00:45.054">you</span></p><p ttm:agent="v1" begin="00:45.304" end="00:47.822"><span begin="00:45.304" end="00:45.606">Got </span><span begin="00:45.606" end="00:46.263">something </span><span begin="00:46.263" end="00:46.575">that </span><span begin="00:46.575" end="00:47.247">I </span><span begin="00:47.247" end="00:47.464">need </span><span begin="00:47.464" end="00:47.822">now</span></p><p ttm:agent="v1" begin="00:48.047" end="00:49.943"><span begin="00:48.047" end="00:48.223">Yeah </span><span begin="00:48.223" end="00:48.375">you </span><span begin="00:48.375" end="00:48.526">could </span><span begin="00:48.526" end="00:48.703">put </span><span begin="00:48.703" end="00:48.887">me </span><span begin="00:48.887" end="00:49.031">in </span><span begin="00:49.031" end="00:49.463">your </span><span begin="00:49.463" end="00:49.943">pocket</span></p><p ttm:agent="v1" begin="00:50.191" end="00:51.622"><span begin="00:50.191" end="00:50.407">Zip </span><span begin="00:50.407" end="00:50.695">it </span><span begin="00:50.695" end="00:50.910">up </span><span begin="00:50.910" end="00:51.086">and </span><span begin="00:51.086" end="00:51.359">lock </span><span begin="00:51.359" end="00:51.622">it</span></p><p ttm:agent="v1" begin="00:51.912" end="00:53.407"><span begin="00:51.912" end="00:52.103">We </span><span begin="00:52.103" end="00:52.319">could </span><span begin="00:52.319" end="00:52.527">be </span><span begin="00:52.527" end="00:52.735">a </span><span begin="00:52.735" end="00:53.407">secret</span></p><p ttm:agent="v1" begin="00:53.535" end="00:54.952"><span begin="00:53.535" end="00:53.743">But </span><span begin="00:53.743" end="00:53.959">take </span><span begin="00:53.959" end="00:54.191">me </span><span begin="00:54.191" end="00:54.375">off </span><span begin="00:54.375" end="00:54.623">the </span><span begin="00:54.623" end="00:54.952">market</span></p><p ttm:agent="v1" begin="00:55.183" end="00:57.190"><span begin="00:55.183" end="00:55.399">Yeah </span><span begin="00:55.399" end="00:55.567">we </span><span begin="00:55.567" end="00:55.742">could </span><span begin="00:55.742" end="00:55.927">be </span><span begin="00:55.927" end="00:56.103">in </span><span begin="00:56.103" end="00:56.502">lust </span><span begin="00:56.502" end="00:56.734">or </span><span begin="00:56.734" end="00:56.951">in </span><span begin="00:56.951" end="00:57.190">love</span></p><p ttm:agent="v1" begin="00:57.422" end="00:58.830"><span begin="00:57.422" end="00:57.631">Or </span><span begin="00:57.631" end="00:57.830">just </span><span begin="00:57.830" end="00:58.103">call </span><span begin="00:58.103" end="00:58.335">it </span><span begin="00:58.335" end="00:58.511">a </span><span begin="00:58.511" end="00:58.830">fling</span></p><p ttm:agent="v1" begin="00:59.502" end="01:01.815"><span begin="00:59.502" end="00:59.718">I </span><span begin="00:59.718" end="00:59.918">just </span><span begin="00:59.918" end="01:00.246">really </span><span begin="01:00.246" end="01:00.623">know </span><span begin="01:00.623" end="01:00.871">that </span><span begin="01:00.871" end="01:01.134">I </span><span begin="01:01.134" end="01:01.495">want </span><span begin="01:01.495" end="01:01.815">it</span></p><p ttm:agent="v1" begin="01:01.967" end="01:02.575"><span begin="01:01.967" end="01:02.119">I </span><span begin="01:02.119" end="01:02.375">want </span><span begin="01:02.375" end="01:02.575">it</span></p><p ttm:agent="v1" begin="01:02.855" end="01:03.447"><span begin="01:02.855" end="01:03.447">Pocket</span></p><p ttm:agent="v1" begin="01:03.751" end="01:05.111"><span begin="01:03.751" end="01:03.950">Zip </span><span begin="01:03.950" end="01:04.127">it </span><span begin="01:04.127" end="01:04.336">up </span><span begin="01:04.336" end="01:04.542">and </span><span begin="01:04.542" end="01:04.871">lock </span><span begin="01:04.871" end="01:05.111">it</span></p><p ttm:agent="v1" begin="01:05.423" end="01:06.863"><span begin="01:05.423" end="01:05.630">We </span><span begin="01:05.630" end="01:05.822">could </span><span begin="01:05.822" end="01:06.015">be </span><span begin="01:06.015" end="01:06.255">a </span><span begin="01:06.255" end="01:06.863">secret</span></p><p ttm:agent="v1" begin="01:07.079" end="01:08.470"><span begin="01:07.079" end="01:07.254">But </span><span begin="01:07.254" end="01:07.423">take </span><span begin="01:07.423" end="01:07.583">me </span><span begin="01:07.583" end="01:07.815">off </span><span begin="01:07.815" end="01:07.992">the </span><span begin="01:07.992" end="01:08.470">market</span></p><p ttm:agent="v1" begin="01:08.710" end="01:10.727"><span begin="01:08.710" end="01:08.918">Yeah </span><span begin="01:08.918" end="01:09.095">we </span><span begin="01:09.095" end="01:09.287">could </span><span begin="01:09.287" end="01:09.470">be </span><span begin="01:09.470" end="01:09.686">in </span><span begin="01:09.686" end="01:10.030">lust </span><span begin="01:10.030" end="01:10.238">or </span><span begin="01:10.238" end="01:10.430">in </span><span begin="01:10.430" end="01:10.727">love</span></p><p ttm:agent="v1" begin="01:10.935" end="01:12.534"><span begin="01:10.935" end="01:11.168">Or </span><span begin="01:11.168" end="01:11.368">just </span><span begin="01:11.368" end="01:11.727">call </span><span begin="01:11.727" end="01:11.927">it </span><span begin="01:11.927" end="01:12.150">a </span><span begin="01:12.150" end="01:12.534">fling</span></p><p ttm:agent="v1" begin="01:12.998" end="01:15.375"><span begin="01:12.998" end="01:13.231">I </span><span begin="01:13.231" end="01:13.430">just </span><span begin="01:13.430" end="01:13.822">really </span><span begin="01:13.822" end="01:14.198">know </span><span begin="01:14.198" end="01:14.431">that </span><span begin="01:14.431" end="01:14.639">I </span><span begin="01:14.639" end="01:15.054">want </span><span begin="01:15.054" end="01:15.375">it</span></p><p ttm:agent="v1" begin="01:15.375" end="01:16.270"><span begin="01:15.375" end="01:15.567">I </span><span begin="01:15.567" end="01:15.935">want </span><span begin="01:15.935" end="01:16.270">it</span></p><p ttm:agent="v1" begin="01:17.255" end="01:18.430"><span begin="01:17.255" end="01:17.455">Not </span><span begin="01:17.455" end="01:17.630">tryna </span><span begin="01:17.630" end="01:17.985">be </span><span begin="01:17.985" end="01:18.430">mean</span></p><p ttm:agent="v1" begin="01:18.647" end="01:21.879"><span begin="01:18.647" end="01:18.806">But </span><span begin="01:18.806" end="01:18.982">a </span><span begin="01:18.982" end="01:19.247">ring </span><span begin="01:19.247" end="01:19.447">don't </span><span begin="01:19.447" end="01:19.935">gotta </span><span begin="01:19.935" end="01:20.310">be </span><span begin="01:20.310" end="01:20.671">a </span><span begin="01:20.671" end="01:21.879">reality</span></p><p ttm:agent="v1" begin="01:22.455" end="01:23.647"><span begin="01:22.455" end="01:22.647">We </span><span begin="01:22.647" end="01:22.823">might </span><span begin="01:22.823" end="01:22.975">be </span><span begin="01:22.975" end="01:23.143">a </span><span begin="01:23.143" end="01:23.647">maybe</span></p><p ttm:agent="v1" begin="01:23.863" end="01:25.351"><span begin="01:23.863" end="01:24.087">A </span><span begin="01:24.087" end="01:24.439">little </span><span begin="01:24.439" end="01:24.823">bit </span><span begin="01:24.823" end="01:25.351">crazy</span></p><p ttm:agent="v1" begin="01:25.591" end="01:27.439"><span begin="01:25.591" end="01:25.798">As </span><span begin="01:25.798" end="01:26.030">l </span><span begin="01:26.030" end="01:26.270">long </span><span begin="01:26.270" end="01:26.447">as </span><span begin="01:26.447" end="01:26.671">you </span><span begin="01:26.671" end="01:26.953">say </span><span begin="01:26.953" end="01:27.151">the </span><span begin="01:27.151" end="01:27.439">word</span></p><p ttm:agent="v1" begin="01:27.599" end="01:28.783"><span begin="01:27.599" end="01:27.759">And </span><span begin="01:27.759" end="01:27.934">don't </span><span begin="01:27.934" end="01:28.110">let </span><span begin="01:28.110" end="01:28.287">me </span><span begin="01:28.287" end="01:28.783">go</span></p><p ttm:agent="v1" begin="01:28.967" end="01:30.471"><span begin="01:28.967" end="01:29.119">Just </span><span begin="01:29.119" end="01:29.287">say </span><span begin="01:29.287" end="01:29.454">the </span><span begin="01:29.454" end="01:29.630"