0:10.440">that </span><span begin="00:10.440" end="00:11.430">will</span><span begin="00:11.430" end="00:11.820">,</span></p><p ttm:agent="v1" begin="00:11.820" end="00:14.820"><span begin="00:11.820" end="00:12.450">Never </span><span begin="00:12.450" end="00:12.630">be </span><span begin="00:12.630" end="00:14.250">tamed</span><span begin="00:14.250" end="00:14.820">,</span></p><p ttm:agent="v1" begin="00:14.820" end="00:18.300"><span begin="00:14.820" end="00:15.450">I </span><span begin="00:15.450" end="00:15.870">knew </span><span begin="00:15.870" end="00:16.110">you </span><span begin="00:16.110" end="00:16.230">were </span><span begin="00:16.230" end="00:16.920">something </span><span begin="00:16.920" end="00:18.300">special</span></p><p ttm:agent="v1" begin="00:18.330" end="00:22.110"><span begin="00:18.330" end="00:18.780">When </span><span begin="00:18.780" end="00:18.870">you </span><span begin="00:18.870" end="00:19.380">spoke </span><span begin="00:19.380" end="00:19.500">my </span><span begin="00:19.500" end="00:20.940">name</span><span begin="00:20.940" end="00:22.110">,</span></p><p ttm:agent="v1" begin="00:22.110" end="00:28.860"><span begin="00:22.110" end="00:22.410">Now</span><span begin="00:22.410" end="00:22.410">, </span><span begin="00:22.410" end="00:22.560">I </span><span begin="00:22.560" end="00:22.920">can't </span><span begin="00:22.920" end="00:23.880">wait </span><span begin="00:23.880" end="00:24.030">to </span><span begin="00:24.030" end="00:24.360">see </span><span begin="00:24.360" end="00:24.600">you </span><span begin="00:24.600" end="00:26.190">again</span><span begin="00:26.190" end="00:27.080">.</span><span begin="00:27.080" end="00:27.970">.</span><span begin="00:27.970" end="00:28.860">.</span></p><p ttm:agent="v1" begin="00:28.860" end="00:32.430"><span begin="00:28.860" end="00:29.280">I've </span><span begin="00:29.280" end="00:29.790">got </span><span begin="00:29.790" end="00:29.880">a </span><span begin="00:29.880" end="00:30.720">way </span><span begin="00:30.720" end="00:30.780">of </span><span begin="00:30.780" end="00:32.130">knowing</span><span begin="00:32.130" end="00:32.430">,</span></p><p ttm:agent="v1" begin="00:32.430" end="00:35.550"><span begin="00:32.430" end="00:32.700">When </span><span begin="00:32.700" end="00:33.240">something </span><span begin="00:33.240" end="00:33.450">is </span><span begin="00:33.450" end="00:35.070">right</span><span begin="00:35.070" end="00:35.550">,</span></p><p ttm:agent="v1" begin="00:35.550" end="00:39.120"><span begin="00:35.550" end="00:36.120">I </span><span begin="00:36.120" end="00:36.630">feel </span><span begin="00:36.630" end="00:36.900">like </span><span begin="00:36.900" end="00:36.990">I </span><span begin="00:36.990" end="00:37.560">must </span><span begin="00:37.560" end="00:37.650">have </span><span begin="00:37.650" end="00:38.190">known </span><span begin="00:38.190" end="00:39.030">you</span><span begin="00:39.030" end="00:39.120">,</span></p><p ttm:agent="v1" begin="00:39.120" end="00:42.420"><span begin="00:39.120" end="00:39.540">In </span><span begin="00:39.540" end="00:40.260">another </span><span begin="00:40.260" end="00:42.390">life</span><span begin="00:42.390" end="00:42.420">,</span></p><p ttm:agent="v1" begin="00:42.420" end="00:45.990"><span begin="00:42.420" end="00:42.750">Cause </span><span begin="00:42.750" end="00:43.050">I </span><span begin="00:43.050" end="00:43.560">felt </span><span begin="00:43.560" end="00:43.980">this </span><span begin="00:43.980" end="00:44.400">deep </span><span begin="00:44.400" end="00:45.780">connection</span><span begin="00:45.780" end="00:45.990">,</span></p><p ttm:agent="v1" begin="00:45.990" end="00:49.770"><span begin="00:45.990" end="00:46.380">When </span><span begin="00:46.380" end="00:46.500">you </span><span begin="00:46.500" end="00:46.860">looked </span><span begin="00:46.860" end="00:47.010">in </span><span begin="00:47.010" end="00:47.310">my </span><span begin="00:47.310" end="00:48.210">eyes</span><span begin="00:48.210" end="00:49.770">,</span></p><p ttm:agent="v1" begin="00:49.770" end="00:56.190"><span begin="00:49.770" end="00:50.070">Now </span><span begin="00:50.070" end="00:50.220">I </span><span begin="00:50.220" end="00:50.580">can't </span><span begin="00:50.580" end="00:51.600">wait </span><span begin="00:51.600" end="00:51.720">to </span><span begin="00:51.720" end="00:51.930">see </span><span begin="00:51.930" end="00:52.260">you </span><span begin="00:52.260" end="00:54.360">again</span><span begin="00:54.360" end="00:56.190">,</span></p><p ttm:agent="v1" begin="00:56.190" end="00:57.990"><span begin="00:56.190" end="00:56.400">The </span><span begin="00:56.400" end="00:56.700">last </span><span begin="00:56.700" end="00:56.940">time </span><span begin="00:56.940" end="00:57.090">I </span><span begin="00:57.090" end="00:57.480">freaked </span><span begin="00:57.480" end="00:57.930">out</span><span begin="00:57.930" end="00:57.990">,</span></p><p ttm:agent="v1" begin="00:57.990" end="00:59.700"><span begin="00:57.990" end="00:58.200">I </span><span begin="00:58.200" end="00:58.470">just </span><span begin="00:58.470" end="00:58.650">kept </span><span begin="00:58.650" end="00:59.070">looking </span><span begin="00:59.070" end="00:59.640">down</span><span begin="00:59.640" end="00:59.700">,</span></p><p ttm:agent="v1" begin="00:59.700" end="01:01.140"><span begin="00:59.700" end="00:59.905">I </span><span begin="00:59.905" end="01:00.110">st</span><span begin="01:00.110" end="01:00.315">-</span><span begin="01:00.315" end="01:00.520">st</span><span begin="01:00.520" end="01:00.725">-</span><span begin="01:00.725" end="01:00.930">stuttered </span><span begin="01:00.930" end="01:01.140">when</span></p><p ttm:agent="v1" begin="01:01.140" end="01:03.120"><span begin="01:01.140" end="01:01.260">You </span><span begin="01:01.260" end="01:01.530">asked </span><span begin="01:01.530" end="01:01.680">me </