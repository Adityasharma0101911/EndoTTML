<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Friends</ttm:title><ttm:agent type="person" xml:id="v1">Vacations</ttm:agent><ttm:item type="album">Vibes</ttm:item><ttm:item type="spotify_id">0jYfN0oxUjdYmAifDBORz9</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:22.980" end="00:28.140"><span begin="00:22.980" end="00:24.600">Drift </span><span begin="00:24.600" end="00:26.910">away</span></p><p ttm:agent="v1" begin="00:28.140" end="00:33.660"><span begin="00:28.140" end="00:29.760">Further </span><span begin="00:29.760" end="00:29.820"> </span><span begin="00:29.820" end="00:30.750">each </span><span begin="00:30.750" end="00:32.310">day</span></p><p ttm:agent="v1" begin="00:33.660" end="00:39.030"><span begin="00:33.660" end="00:34.380">Towards </span><span begin="00:34.380" end="00:35.010">a </span><span begin="00:35.010" end="00:36.060">different </span><span begin="00:36.060" end="00:37.620">life</span></p><p ttm:agent="v1" begin="00:39.030" end="00:44.340"><span begin="00:39.030" end="00:39.450">Leave </span><span begin="00:39.450" end="00:40.440">behind </span><span begin="00:40.440" end="00:41.400">no </span><span begin="00:41.400" end="00:43.200">past</span></p><p ttm:agent="v1" begin="00:44.340" end="00:55.050"><span begin="00:44.340" end="00:44.910">Where </span><span begin="00:44.910" end="00:45.450">did </span><span begin="00:45.450" end="00:47.520">you </span><span begin="00:47.520" end="00:48.030"> </span><span begin="00:48.030" end="00:52.860">go</span><span begin="00:52.860" end="00:55.050">?</span></p><p ttm:agent="v1" begin="00:55.050" end="01:11.070"><span begin="00:55.050" end="00:55.620">Where </span><span begin="00:55.620" end="00:56.160">did </span><span begin="00:56.160" end="00:57.240">you </span><span begin="00:57.240" end="00:58.740"> </span><span begin="00:58.740" end="01:03.420">go</span><span begin="01:03.420" end="01:11.070">?</span></p><p ttm:agent="v1" begin="01:11.070" end="01:15.720"><span begin="01:11.070" end="01:11.760">Was </span><span begin="01:11.760" end="01:12.360">it </span><span begin="01:12.360" end="01:13.380">something </span><span begin="01:13.380" end="01:15.060">sad</span></p><p ttm:agent="v1" begin="01:15.720" end="01:21.780"><span begin="01:15.720" end="01:16.440">Or </span><span begin="01:16.440" end="01:17.550">nothing </span><span begin="01:17.550" end="01:17.880">at </span><span begin="01:17.880" end="01:20.190">all</span><span begin="01:20.190" end="01:21.780">?</span></p><p ttm:agent="v1" begin="01:21.780" end="01:26.400"><span begin="01:21.780" end="01:22.440">Was </span><span begin="01:22.440" end="01:22.920">it </span><span begin="01:22.920" end="01:23.010">a </span><span begin="01:23.010" end="01:23.760">change </span><span begin="01:23.760" end="01:24.060">of </span><span begin="01:24.060" end="01:26.190">color</span></p><p ttm:agent="v1" begin="01:26.400" end="01:32.430"><span begin="01:26.400" end="01:26.970">Or </span><span begin="01:26.970" end="01:28.380">something </span><span begin="01:28.380" end="01:30.480">more</span><span begin="01:30.480" end="01:32.430">?</span></p><p ttm:agent="v1" begin="01:32.430" end="01:43.050"><span begin="01:32.430" end="01:32.940">Where </span><span begin="01:32.940" end="01:33.480">did </span><span begin="01:33.480" end="01:33.900">you </span><span begin="01:33.900" end="01:36.060"> </span><span begin="01:36.060" end="01:40.830">go</span><span begin="01:40.830" end="01:43.050">?</span></p><p ttm:agent="v1" begin="01:43.050" end="02:32.360"><span begin="01:43.050" end="01:43.560">Where </span><span begin="01:43.560" end="01:44.130">did </span><span begin="01:44.130" end="01:45.150">you </span><span begin="01:45.150" end="01:46.740"> </span><span begin="01:46.740" end="01:51.300">go</span><span begin="01:51.300" end="02:32.360">?</span></p></div></body></tt>