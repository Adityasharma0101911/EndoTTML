<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Telephones</ttm:title><ttm:agent type="person" xml:id="v1">Vacations</ttm:agent><ttm:item type="album">Changes</ttm:item><ttm:item type="spotify_id">0JIMT9gzLIIz0esKLyjbKf</ttm:item><itunes:duration>03:32.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:27.050" end="00:31.987"><span begin="00:27.050" end="00:27.651">Rise </span><span begin="00:27.651" end="00:28.002">with </span><span begin="00:28.002" end="00:28.845">the </span><span begin="00:28.845" end="00:31.987">morning</span></p><p ttm:agent="v1" begin="00:33.348" end="00:38.382"><span begin="00:33.348" end="00:34.011">You </span><span begin="00:34.011" end="00:34.812">call </span><span begin="00:34.812" end="00:36.125">to </span><span begin="00:36.125" end="00:38.382">me</span></p><p ttm:agent="v1" begin="00:40.695" end="00:45.665"><span begin="00:40.695" end="00:40.967">My </span><span begin="00:40.967" end="00:41.276">thoughts </span><span begin="00:41.276" end="00:41.601">are </span><span begin="00:41.601" end="00:45.665">crawling</span></p><p ttm:agent="v1" begin="00:46.227" end="00:49.735"><span begin="00:46.227" end="00:46.817">You're </span><span begin="00:46.817" end="00:47.670">all </span><span begin="00:47.670" end="00:48.043">I </span><span begin="00:48.043" end="00:49.735">see</span></p><p ttm:agent="v1" begin="00:51.833" end="00:57.776"><span begin="00:51.833" end="00:52.425">I </span><span begin="00:52.425" end="00:53.242">wish </span><span begin="00:53.242" end="00:54.028">I </span><span begin="00:54.028" end="00:54.845">could </span><span begin="00:54.845" end="00:55.624">live </span><span begin="00:55.624" end="00:57.228">without </span><span begin="00:57.228" end="00:57.776">you</span></p><p ttm:agent="v1" begin="00:57.776" end="01:01.959"><span begin="00:57.776" end="00:58.042">But </span><span begin="00:58.042" end="00:58.920">you're </span><span begin="00:59.264" end="00:59.500">a </span><span begin="00:59.500" end="01:00.401">part </span><span begin="01:00.401" end="01:00.838">of </span><span begin="01:00.838" end="01:01.959">me</span></p><p ttm:agent="v1" begin="01:04.443" end="01:07.647"><span begin="01:04.443" end="01:05.257">Wherever </span><span begin="01:05.257" end="01:05.987">I </span><span begin="01:05.987" end="01:07.647">go</span></p><p ttm:agent="v1" begin="01:07.647" end="01:12.329"><span begin="01:07.647" end="01:08.434">You'll </span><span begin="01:08.434" end="01:09.235">always </span><span begin="01:09.235" end="01:09.972">be </span><span begin="01:09.972" end="01:10.399">next </span><span begin="01:10.399" end="01:11.200">to </span><span begin="01:11.200" end="01:12.329">me</span></p><p ttm:agent="v1" begin="01:50.046" end="01:53.666"><span begin="01:50.046" end="01:50.387">Fall </span><span begin="01:50.387" end="01:51.253">into </span><span begin="01:51.253" end="01:51.966">the </span><span begin="01:51.966" end="01:53.666">night</span></p><p ttm:agent="v1" begin="01:56.059" end="02:00.559"><span begin="01:56.059" end="01:56.359">As </span><span begin="01:56.359" end="01:57.197">I </span><span begin="01:57.197" end="01:57.712">gaze </span><span begin="01:57.712" end="01:59.361">into </span><span begin="01:59.361" end="02:00.559">you</span></p><p ttm:agent="v1" begin="02:02.790" end="02:06.592"><span begin="02:02.790" end="02:04.003">Shine </span><span begin="02:04.003" end="02:04.739">so </span><span begin="02:04.739" end="02:06.592">bright</span></p><p ttm:agent="v1" begin="02:09.388" end="02:12.385"><span begin="02:09.388" end="02:10.025">It's </span><span begin="02:10.025" end="02:10.463">all </span><span begin="02:10.463" end="02:11.186">I </span><span begin="02:11.186" end="02:12.385">do</span></p><p ttm:agent="v1" begin="02:14.830" end="02:20.960"><span begin="02:14.830" end="02:15.524">I </span><span begin="02:15.524" end="02:16.456">wish </span><span begin="02:16.456" end="02:17.161">I </span><span begin="02:17.161" end="02:17.998">could </span><span begin="02:17.998" end="02:18.726">live </span><span begin="02:18.726" end="02:20.327">without </span><span begin="02:20.327" end="02:20.960">you</span></p><p ttm:agent="v1" begin="02:20.960" end="02:25.048"><span begin="02:20.960" end="02:21.204">But </span><span begin="02:21.204" end="02:22.062">you're </span><span begin="02:22.423" end="02:22.765">a </span><span begin="02:22.765" end="02:23.555">part </span><span begin="02:23.555" end="02:23.946">of </span><span begin="02:23.946" end="02:25.048">me</span></p><p ttm:agent="v1" begin="02:27.590" end="02:30.788"><span begin="02:27.590" end="02:28.396">Wherever </span><span begin="02:28.396" end="02:29.184">I </span><span begin="02:29.184" end="02:30.788">go</span></p><p ttm:agent="v1" begin="02:30.788" end="02:35.477"><span begin="02:30.788" end="02:31.603">You'll </span><span begin="02:31.603" end="02:32.379">always </span><span begin="02:32.379" end="02:33.052">be </span><span begin="02:33.052" end="02:33.601">next </span><span begin="02:33.601" end="02:34.350">to </span><span begin="02:34.350" end="02:35.477">me</span></p><p ttm:agent="v1" begin="02:44.419" end="02:46.825"><span begin="02:44.419" end="02:44.723">You'll </span><span begin="02:44.723" end="02:44.998">always </span><span begin="02:44.998" end="02:45.314">be </span><span begin="02:45.314" end="02:45.662">next </span><span begin="02:45