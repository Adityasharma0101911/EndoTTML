<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Telephones</ttm:title><ttm:agent type="person" xml:id="v1">Vacations</ttm:agent><ttm:item type="album">Changes</ttm:item><ttm:item type="spotify_id">0JIMT9gzLIIz0esKLyjbKf</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:26.620" end="00:32.320"><span begin="00:26.620" end="00:27.640">Rise </span><span begin="00:27.640" end="00:28.090">with </span><span begin="00:28.090" end="00:28.750">the </span><span begin="00:28.750" end="00:32.320">morning</span></p><p ttm:agent="v1" begin="00:33.040" end="00:38.860"><span begin="00:33.040" end="00:33.910">You </span><span begin="00:33.910" end="00:34.720">call </span><span begin="00:34.720" end="00:36.040">to </span><span begin="00:36.040" end="00:38.860">me</span></p><p ttm:agent="v1" begin="00:40.270" end="00:45.790"><span begin="00:40.270" end="00:40.690">My </span><span begin="00:40.690" end="00:41.260">thoughts </span><span begin="00:41.260" end="00:41.500">are </span><span begin="00:41.500" end="00:45.790">crawling</span></p><p ttm:agent="v1" begin="00:45.820" end="00:50.110"><span begin="00:45.820" end="00:46.090">You're </span><span begin="00:46.090" end="00:47.740">all </span><span begin="00:47.740" end="00:47.860">I </span><span begin="00:47.860" end="00:50.110">see</span></p><p ttm:agent="v1" begin="00:51.520" end="00:57.610"><span begin="00:51.520" end="00:52.360">I </span><span begin="00:52.360" end="00:53.320">wish </span><span begin="00:53.320" end="00:53.920">I </span><span begin="00:53.920" end="00:54.790">could </span><span begin="00:54.790" end="00:55.540">live </span><span begin="00:55.540" end="00:57.130">without </span><span begin="00:57.130" end="00:57.610">you</span></p><p ttm:agent="v1" begin="00:57.610" end="01:02.200"><span begin="00:57.610" end="00:57.880">But </span><span begin="00:57.880" end="00:59.170">you're </span><span begin="00:59.170" end="00:59.530">a </span><span begin="00:59.530" end="01:00.460">part </span><span begin="01:00.460" end="01:00.790">of </span><span begin="01:00.790" end="01:02.200">me</span></p><p ttm:agent="v1" begin="01:04.180" end="01:07.480"><span begin="01:04.180" end="01:05.200">Wherever </span><span begin="01:05.200" end="01:05.980">I </span><span begin="01:05.980" end="01:07.480">go</span></p><p ttm:agent="v1" begin="01:07.480" end="01:12.970"><span begin="01:07.480" end="01:08.410">You'll </span><span begin="01:08.410" end="01:09.190">always </span><span begin="01:09.190" end="01:09.790">be </span><span begin="01:09.790" end="01:10.390">next </span><span begin="01:10.390" end="01:11.110">to </span><span begin="01:11.110" end="01:12.970">me</span></p><p ttm:agent="v1" begin="01:49.810" end="01:54.040"><span begin="01:49.810" end="01:50.560">Fall </span><span begin="01:50.560" end="01:51.190">into </span><span begin="01:51.190" end="01:51.940">the </span><span begin="01:51.940" end="01:54.040">night</span></p><p ttm:agent="v1" begin="01:55.990" end="02:01.210"><span begin="01:55.990" end="01:56.440">As </span><span begin="01:56.440" end="01:57.160">I </span><span begin="01:57.160" end="01:57.670">gaze </span><span begin="01:57.670" end="01:59.170">into </span><span begin="01:59.170" end="02:01.210">you</span></p><p ttm:agent="v1" begin="02:02.470" end="02:07.300"><span begin="02:02.470" end="02:03.820">Shine </span><span begin="02:03.820" end="02:04.690">so </span><span begin="02:04.690" end="02:07.300">bright</span></p><p ttm:agent="v1" begin="02:09.130" end="02:13.210"><span begin="02:09.130" end="02:10.000">It's </span><span begin="02:10.000" end="02:10.630">all </span><span begin="02:10.630" end="02:11.140">I </span><span begin="02:11.140" end="02:13.210">do</span></p><p ttm:agent="v1" begin="02:14.680" end="02:20.800"><span begin="02:14.680" end="02:15.520">I </span><span begin="02:15.520" end="02:16.480">wish </span><span begin="02:16.480" end="02:17.080">I </span><span begin="02:17.080" end="02:17.980">could </span><span begin="02:17.980" end="02:18.700">live </span><span begin="02:18.700" end="02:20.320">without </span><span begin="02:20.320" end="02:20.800">you</span></p><p ttm:agent="v1" begin="02:20.800" end="02:25.390"><span begin="02:20.800" end="02:21.040">But </span><span begin="02:21.040" end="02:22.330">you're </span><span begin="02:22.330" end="02:22.690">a </span><span begin="02:22.690" end="02:23.620">part </span><span begin="02:23.620" end="02:23.950">of </span><span begin="02:23.950" end="02:25.390">me</span></p><p ttm:agent="v1" begin="02:27.340" end="02:30.640"><span begin="02:27.340" end="02:28.360">Wherever </span><span begin="02:28.360" end="02:29.170">I </span><span begin="02:29.170" end="02:30.640">go</span></p><p ttm:agent="v1" begin="02:30.640" end="02:35.710"><span begin="02:30.640" end="02:31.600">You'll </span><span begin="02:31.600" end="02:32.350">always </span><span begin="02:32.350" end="02:32.950">be </span><span begin="02:32.950" end="02:33.550">next </span><span begin="02:33.550" end="02:34.300">to </span><span begin="02:34.300" end="02:35.710">me</span></p><p ttm:agent="v1" begin="02:44.200" end="02:46.030"><span begin="02:44.200" end="02:44.500">You'll </span><span begin="02:44.500" end="02:44.860">always </span><span begin="02:44.860" end="02:45.190">be </span><span begin="02:45.190" end="02:45.610">next </span><span begin="02:45.610" end="02:45.850">to </span><span begin="02:45.850" end="02:46.030">me</span></p><p ttm:agent="v1" begin="02:50.560" end="02:52.570"><span begin="02:50.560" end="02:50.860">You'll </span><span begin="02:50.860" end="02:51.190">always </span><span begin="02:51.190" end="02:51.550">be </span><span begin="02:51.550" end="02:52.030">next </span><span begin="02:52.030" end="02:52.180">to </span><span begin="02:52.180" end="02:52.570">me</span></p><p ttm:agent="v1" begin="02:56.950" end="02:59.920"><span begin="02:56.950" end="02:57.280">You'll </span><span begin="02:57.280" end="02:57.610">always </span><span begin="02:57.610" end="02:57.910">be </span><span begin="02:57.910" end="02:58.390">next </span><span begin="02:58.390" end="02:58.570">to </span><span begin="02:58.570" end="02:59.920">me</span></p><p ttm:agent="v1" begin="03:03.340" end="03:05.080"><span begin="03:03.340" end="03:03.640">You'll </span><span begin="03:03.640" end="03:04.000">always </span><span begin="03:04.000" end="03:04.330">be </span><span begin="03:04.330" end="03:04.810">next </span><span begin="03:04.810" end="03:04.930">to </span><span begin="03:04.930" end="03:05.080">me</span></p></div></body></tt>