gin="00:45.210" end="00:49.170"><span begin="00:45.210" end="00:45.840">Sleight </span><span begin="00:45.840" end="00:45.990">of </span><span begin="00:45.990" end="00:46.830">hand </span><span begin="00:46.830" end="00:47.250">and </span><span begin="00:47.250" end="00:47.700">twist </span><span begin="00:47.700" end="00:48.030">of </span><span begin="00:48.030" end="00:49.170">fate</span></p><p ttm:agent="v1" begin="00:49.200" end="00:53.490"><span begin="00:49.200" end="00:49.380">On </span><span begin="00:49.380" end="00:49.440">a </span><span begin="00:49.440" end="00:49.920">bed </span><span begin="00:49.920" end="00:50.310">of </span><span begin="00:50.310" end="00:51.060">nails </span><span begin="00:51.060" end="00:51.570">she </span><span begin="00:51.570" end="00:52.050">makes </span><span begin="00:52.050" end="00:52.410">me </span><span begin="00:52.410" end="00:53.490">wait</span></p><p ttm:agent="v1" begin="00:54.120" end="00:59.700"><span begin="00:54.120" end="00:54.510">And </span><span begin="00:54.510" end="00:54.690">I </span><span begin="00:54.690" end="00:56.370">wait </span><span begin="00:56.370" end="00:57.510">without </span><span begin="00:57.510" end="00:59.700">you</span></p><p ttm:agent="v1" begin="01:00.180" end="01:04.020"><span begin="01:00.180" end="01:00.780">With </span><span begin="01:00.780" end="01:00.990">or </span><span begin="01:00.990" end="01:01.950">without </span><span begin="01:01.950" end="01:04.020">you</span></p><p ttm:agent="v1" begin="01:04.560" end="01:09.240"><span begin="01:04.560" end="01:05.190">With </span><span begin="01:05.190" end="01:05.580">or </span><span begin="01:05.580" end="01:07.350">without </span><span begin="01:07.350" end="01:09.240">you</span></p><p ttm:agent="v1" begin="01:11.400" end="01:15.240"><span begin="01:11.400" end="01:11.880">Through </span><span begin="01:11.880" end="01:12.030">the </span><span begin="01:12.030" end="01:13.020">storm </span><span begin="01:13.020" end="01:13.440">we </span><span begin="01:13.440" end="01:13.860">reach </span><span begin="01:13.860" end="01:14.160">the </span><span begin="01:14.160" end="01:15.240">shore</span></p><p ttm:agent="v1" begin="01:15.420" end="01:19.860"><span begin="01:15.420" end="01:15.690">You </span><span begin="01:15.690" end="01:16.170">give </span><span begin="01:16.170" end="01:16.560">it </span><span begin="01:16.560" end="01:17.370">all </span><span begin="01:17.370" end="01:17.700">but </span><span begin="01:17.700" end="01:18.150">I </span><span begin="01:18.150" end="01:18.720">want </span><span begin="01:18.720" end="01:19.860">more</span></p><p ttm:agent="v1" begin="01:20.370" end="01:25.230"><span begin="01:20.370" end="01:20.730">And </span><span begin="01:20.730" end="01:20.970">I'm </span><span begin="01:20.970" end="01:22.920">waiting </span><span begin="01:22.920" end="01:23.610">for </span><span begin="01:23.610" end="01:25.230">you</span></p><p ttm:agent="v1" begin="01:26.340" end="01:30.240"><span begin="01:26.340" end="01:27.000">With </span><span begin="01:27.000" end="01:27.180">or </span><span begin="01:27.180" end="01:28.140">without </span><span begin="01:28.140" end="01:30.240">you</span></p><p ttm:agent="v1" begin="01:30.660" end="01:33.420"><span begin="01:30.660" end="01:31.410">With </span><span begin="01:31.410" end="01:31.830">or </span><span begin="01:31.830" end="01:33.000">without </span><span begin="01:33.000" end="01:33.420">you</span></p><p ttm:agent="v1" begin="01:33.450" end="01:36.690"><span begin="01:33.450" end="01:35.580">I </span><span begin="01:35.580" end="01:36.210">can't </span><span begin="01:36.210" end="01:36.690">live</span></p><p ttm:agent="v1" begin="01:39.450" end="01:44.160"><span begin="01:39.450" end="01:40.170">With </span><span begin="01:40.170" end="01:40.500">or </span><span begin="01:40.500" end="01:42.180">without </span><span begin="01:42.180" end="01:44.160">you</span></p><p ttm:agent="v1" begin="01:53.070" end="01:57.210"><