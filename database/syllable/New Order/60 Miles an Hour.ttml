<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>60 Miles an Hour</ttm:title><ttm:agent type="person" xml:id="v1">New Order</ttm:agent><ttm:item type="album">Get Ready</ttm:item><ttm:item type="spotify_id">3u0WAeE58IqNlHv2gsvlRY</ttm:item><itunes:duration>04:34.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:36.984" end="00:39.524"><span begin="00:36.984" end="00:37.214">I </span><span begin="00:37.214" end="00:37.384">don't </span><span begin="00:37.384" end="00:37.674">know </span><span begin="00:37.674" end="00:38.074">if </span><span begin="00:38.074" end="00:38.484">i </span><span begin="00:38.484" end="00:39.004">told </span><span begin="00:39.004" end="00:39.524">you</span></p><p ttm:agent="v1" begin="00:40.404" end="00:42.734"><span begin="00:40.404" end="00:40.614">But </span><span begin="00:40.614" end="00:40.834">I'm </span><span begin="00:40.834" end="00:41.534">seeking </span><span begin="00:41.534" end="00:42.734">sanctuary</span></p><p ttm:agent="v1" begin="00:43.804" end="00:47.124"><span begin="00:43.804" end="00:44.034">You'd </span><span begin="00:44.034" end="00:44.434">never </span><span begin="00:44.434" end="00:44.914">guess </span><span begin="00:44.914" end="00:45.204">the </span><span begin="00:45.204" end="00:45.634">things </span><span begin="00:45.634" end="00:45.904">that </span><span begin="00:45.904" end="00:46.494">i </span><span begin="00:46.494" end="00:47.124">do</span></p><p ttm:agent="v1" begin="00:47.634" end="00:50.384"><span begin="00:47.634" end="00:47.844">I've </span><span begin="00:47.844" end="00:48.054">had </span><span begin="00:48.054" end="00:48.274">the </span><span begin="00:48.274" end="00:48.654">devil </span><span begin="00:48.654" end="00:49.404">around </span><span begin="00:49.404" end="00:49.884">for </span><span begin="00:49.884" end="00:50.384">tea</span></p><p ttm:agent="v1" begin="00:51.384" end="00:54.514"><span begin="00:51.384" end="00:51.754">Don't </span><span begin="00:51.754" end="00:52.014">you </span><span begin="00:52.014" end="00:52.604">know </span><span begin="00:52.604" end="00:52.824">that </span><span begin="00:52.824" end="00:53.034">i'm </span><span begin="00:53.034" end="00:53.344">here </span><span begin="00:53.344" end="00:54.044">beside </span><span begin="00:54.044" end="00:54.514">you</span></p><p ttm:agent="v1" begin="00:55.224" end="00:58.054"><span begin="00:55.224" end="00:55.504">Can't </span><span begin="00:55.504" end="00:55.764">you </span><span begin="00:55.764" end="00:56.204">see </span><span begin="00:56.204" end="00:56.464">that </span><span begin="00:56.464" end="00:56.774">i </span><span begin="00:56.774" end="00:57.314">can't </span><span begin="00:57.314" end="00:58.054">relax</span></p><p ttm:agent="v1" begin="00:59.044" end="01:02.124"><span begin="00:59.044" end="00:59.304">When </span><span begin="00:59.304" end="00:59.554">i </span><span begin="00:59.554" end="00:59.934">saw </span><span begin="00:59.934" end="01:00.164">you </span><span begin="01:00.164" end="01:00.564">in </span><span begin="01:00.564" end="01:01.054">my </span><span begin="01:01.054" end="01:01.584">rear </span><span begin="01:01.584" end="01:02.124">view</span></p><p ttm:agent="v1" begin="01:02.714" end="01:05.484"><span begin="01:02.714" end="01:02.904">You </span><span begin="01:02.904" end="01:03.224">could </span><span begin="01:03.224" end="01:03.574">have </span><span begin="01:03.574" end="01:03.944">stopped </span><span begin="01:03.944" end="01:04.314">me </span><span begin="01:04.314" end="01:04.574">in </span><span begin="01:04.574" end="01:04.914">my </span><span begin="01:04.914" end="01:05.484">tracks</span></p><p ttm:agent="v1" begin="01:06.354" end="01:09.204"><span begin="01:06.354" end="01:06.554">I'll </span><span begin="01:06.554" end="01:06.724">be </span><span begin="01:06.724" end="01:07.024">there </span><span begin="01:07.024" end="01:07.244">for </span><span begin="01:07.244" end="01:07.664">you </span><span begin="01:07.664" end="01:07.874">when </span><span begin="01:07.874" end="01:08.054">you </span><span begin="01:08.054" end="01:08.334">want </span><span begin="01:08.334" end="01:08.614">me </span><span begin="01:08.614" end="01:09.204">to</span></p><p ttm:agent="v1" begin="01:09.774" end="01:12.914"><span begin="01:09.774" end="01:10.064">I'll </span><span begin="01:10.064" end="01:10.304">stand </span><span begin="01:10.304" end="01:10.584">by </span><span begin="01:10.584" end="01:10.844">your </span><span begin="01:10.844" end="01:11.284">side </span><span begin="01:11.284" end="01:11.534">like </span><span begin="01:11.534" end="01:11.824">i </span><span begin="01:11.824" end="01:12.354">always </span><span begin="01:12.354" end="01:12.914">do</span></p><p ttm:agent="v1" begin="01:13.804" end="01:15.204"><span begin="01:13.804" end="01:14.034">In </span><span begin="01:14.034" end="01:14.214">the </span><span begin="01:14.214" end="01:14.594">dead </span><span begin="01:14.594" end="01:14.774">of </span><span begin="01:14.774" end="01:15.204">night</span></p><p ttm:agent="v1" begin="01:15.204" end="01:16.313"><span begin="01:15.204" end="01:15.444">It'll </span><span begin="01:15.444" end="01:15.644">be </span><span begin="01:15.644" end="01:16.313">alright</span></p><p ttm:agent="v1" begin="01:16.913" end="01:18.823"><span begin="01:16.913" end="01:17.363">Because </span><span begin="01:17.363" end="01:17.703">i'll </span><span begin="01:17.703" end="01:17.903">be </span><span begin="01:17.903" end="01:18.113">there </span><span begin="01:18.113" end="01:18.373">for </span><span begin="01:18.373" end="01:18.823">you</span></p><p ttm:agent="v1" begin="01:18.823" end="01:20.492"><span begin="01:18.823" end="01:19.063">When </span><span begin="01:19.063" end="01:19.303">you </span><span begin="01:19.303" end="01:19.613">want </span><span begin="01:19.613" end="01:19.893">me </span><span begin="01:19.893" end="01:20.492">to</span></p><p ttm:agent="v1" begin="01:29.370" end="01:32.100"><span begin="01:29.370" end="01:29.620">You </span><span begin="01:29.620" end="01:29.830">could </span><span begin="01:29.830" end="01:30.020">take </span><span begin="01:30.020" end="01:30.220">me </span><span begin="01:30.220" end="01:30.450">to </span><span begin="01:30.450" end="01:30.980">an </span><span begin="01:30.980" end="01:32.100">island</span></p><p ttm:agent="v1" begin="01:32.870" end="01:35.690"><span begin="01:32.870" end="01:33.250">Ride </span><span begin="01:33.250" end="01:33.700">across </span><span begin="01:33.700" end="01:34.100">a </span><span begin="01:34.100" end="01:35.030">stormy </span><span begin="01:35.030" end="01:35.690">sea</span></p><p ttm:agent="v1" begin="01:36.540" end="01:39.800"><span begin="01:36.540" end="01:36.810">We </span><span begin="01:36.810" end="01:37.230">could </span><span begin="01:37.230" end="01:37.910">worship </span><span begin="01:37.910" end="01:38.680">pagan </span><span begin="01:38.680" end="01:39.800">idols</span></p><p ttm:agent="v1" begin="01:40.420" end="01:43.160"><span begin="01:40.420" end="01:40.750">There </span><span begin="01:40.750" end="01:41.450">together </span><span begin="01:41.450" end="01:42.080">you </span><span begin="01:42.080" end="01:42.520">and </span><span begin="01:42.520" end="01:43.160">me</span></p><p ttm:agent="v1" begin="01:44.200" end="01:47.620"><span begin="01:44.200" end="01:44.410">Why </span><span begin="01:44.410" end="01:44.610">don't </span><span begin="01:44.610" end="01:44.840">you </span><span begin="01:44.840" end="01:45.230">run </span><span begin="01:45.230" end="01:45.690">over </span><span begin="01:45.690" end="01:46.110">here </span><span begin="01:46.110" end="01:46.460">and </span><span begin="01:46.460" end="01:47.080">rescue </span><span begin="01:47.080" end="01:47.620">me</span></p><p ttm:agent="v1" begin="01:47.960" end="01:50.850"><span begin="01:47.960" end="01:48.250">You </span><span begin="01:48.250" end="01:48.520">could </span><span begin="01:48.520" end="01:49.000">drive </span><span begin="01:49.000" end="01:49.420">down </span><span begin="01:49.420" end="01:49.720">in </span><span begin="01:49.720" end="01:50.130">your </span><span begin="01:50.130" end="01:50.850">car</span></p><p ttm:agent="v1" begin="01:51.720" end="01:53.680"><span begin="01:51.720" end="01:51.940">Why </span><span begin="01:51.940" end="01:52.130">don't </span><span begin="01:52.130" end="01:52.370">we </span><span begin="01:52.370" end="01:52.760">both </span><span begin="01:52.760" end="01:52.990">take </span><span begin="01:52.990" end="01:53.240">a </span><span begin="01:53.240" end="01:53.680">ride</span></p><p ttm:agent="v1" begin="01:53.680" end="01:55.450"><span begin="01:53.680" end="01:53.990">And </span><span begin="01:53.990" end="01:54.430">turn </span><span begin="01:54.430" end="01:54.820">that </span><span begin="01:54.820" end="01:55.450">key</span></p><p ttm:agent="v1" begin="01:55.450" end="01:58.260"><span begin="01:55.450" end="01:55.680">We'll </span><span begin="01:55.680" end="01:55.950">drive </span><span begin="01:55.950" end="01:56.140">at </span><span begin="01:56.140" end="01:56.680">sixty </span><span begin="01:56.680" end="01:57.190">miles </span><span begin="01:57.190" end="01:57.630">an </span><span begin="01:57.630" end="01:58.260">hour</span></p><p ttm:agent="v1" begin="01:58.900" end="02:01.900"><span begin="01:58.900" end="01:59.230">I'll </span><span begin="01:59.230" end="01:59.420">be </span><span begin="01:59.420" end="01:59.680">there </span><span begin="01:59.680" end="01:59.880">for </span><span begin="01:59.880" end="02:00.290">you </span><span begin="02:00.290" end="02:00.510">when </span><span begin="02:00.510" end="02:00.750">you </span><span begin="02:00.750" end="02:01.080">want </span><span begin="02:01.080" end="02:01.400">me </span><span begin="02:01.400" end="02:01.900">to</span></p><p ttm:agent="v1" begin="02:02.560" end="02:05.760"><span begin="02:02.560" end="02:02.830">I'll </span><span begin="02:02.830" end="02:03.080">stand </span><span begin="02:03.080" end="02:03.340">by </span><span begin="02:03.340" end="02:03.590">your </span><span begin="02:03.590" end="02:04.030">side </span><span begin="02:04.030" end="02:04.270">like </span><span begin="02:04.270" end="02:04.570">i </span><span begin="02:04.570" end="02:05.270">always </span><span begin="02:05.270" end="02:05.760">do</span></p><p ttm:agent="v1" begin="02:06.300" end="02:07.860"><span begin="02:06.300" end="02:06.590">In </span><span begin="02:06.590" end="02:06.880">the </span><span begin="02:06.880" end="02:07.260">dead </span><span begin="02:07.260" end="02:07.450">of </span><span begin="02:07.450" end="02:07.860">night</span></p><p ttm:agent="v1" begin="02:07.860" end="02:09.390"><span begin="02:07.860" end="02:08.100">It'll </span><span begin="02:08.100" end="02:08.420">be </span><span begin="02:08.420" end="02:09.390">alright</span></p><p ttm:agent="v1" begin="02:10.120" end="02:11.540"><span begin="02:10.120" end="02:10.340">Because </span><span begin="02:10.340" end="02:10.540">i'll </span><span begin="02:10.540" end="02:10.730">be </span><span begin="02:10.730" end="02:10.940">there </span><span begin="02:10.940" end="02:11.140">for </span><span begin="02:11.140" end="02:11.540">you</span></p><p ttm:agent="v1" begin="02:11.540" end="02:13.240"><span begin="02:11.540" end="02:11.800">When </span><span begin="02:11.800" end="02:12.050">you </span><span begin="02:12.050" end="02:12.330">want </span><span begin="02:12.330" end="02:12.690">me </span><span begin="02:12.690" end="02:13.240">to</span></p><p ttm:agent="v1" begin="02:13.910" end="02:15.350"><span begin="02:13.910" end="02:14.180">I'll </span><span begin="02:14.180" end="02:14.420">be </span><span begin="02:14.420" end="02:14.650">there </span><span begin="02:14.650" end="02:14.920">for </span><span begin="02:14.920" end="02:15.350">you</span></p><p ttm:agent="v1" begin="02:15.350" end="02:17.050"><span begin="02:15.350" end="02:15.570">When </span><span begin="02:15.570" end="02:15.820">you </span><span begin="02:15.820" end="02:16.040">want </span><span begin="02:16.040" end="02:16.500">me </span><span begin="02:16.500" end="02:17.050">to</span></p><p ttm:agent="v1" begin="02:17.640" end="02:20.800"><span begin="02:17.640" end="02:17.930">I'll </span><span begin="02:17.930" end="02:18.220">stand </span><span begin="02:18.220" end="02:18.460">by </span><span begin="02:18.460" end="02:18.710">your </span><span begin="02:18.710" end="02:19.130">side </span><span begin="02:19.130" end="02:19.370">like </span><span begin="02:19.370" end="02:19.620">I </span><span begin="02:19.620" end="02:20.250">always </span><span begin="02:20.250" end="02:20.800">do</span></p><p ttm:agent="v1" begin="02:21.390" end="02:24.410"><span begin="02:21.390" end="02:21.650">In </span><span begin="02:21.650" end="02:21.900">the </span><span begin="02:21.900" end="02:22.130">dead </span><span begin="02:22.130" end="02:22.400">of </span><span begin="02:22.400" end="02:22.860">night </span><span begin="02:22.860" end="02:23.120">it'll </span><span begin="02:23.120" end="02:23.450">be </span><span begin="02:23.450" end="02:24.410">alright</span></p><p ttm:agent="v1" begin="02:25.250" end="02:26.660"><span begin="02:25.250" end="02:25.450">Because </span><span begin="02:25.450" end="02:25.630">i'll </span><span begin="02:25.630" end="02:25.850">be </span><span begin="02:25.850" end="02:26.100">there </span><span begin="02:26.100" end="02:26.300">for </span><span begin="02:26.300" end="02:26.660">you</span></p><p ttm:agent="v1" begin="02:26.660" end="02:28.300"><span begin="02:26.660" end="02:26.900">When </span><span begin="02:26.900" end="02:27.140">you </span><span begin="02:27.140" end="02:27.380">want </span><span begin="02:27.380" end="02:27.820">me </span><span begin="02:27.820" end="02:28.300">to</span></p><p ttm:agent="v1" begin="03:29.467" end="03:30.697"><span begin="03:29.467" end="03:29.677">I'll </span><span begin="03:29.677" end="03:29.857">be </span><span begin="03:29.857" end="03:30.067">there </span><span begin="03:30.067" end="03:30.267">for </span><span begin="03:30.267" end="03:30.697">you</span></p><p ttm:agent="v1" begin="03:30.697" end="03:32.307"><span begin="03:30.697" end="03:30.917">When </span><span begin="03:30.917" end="03:31.127">you </span><span begin="03:31.127" end="03:31.417">want </span><span begin="03:31.417" end="03:31.807">me </span><span begin="03:31.807" end="03:32.307">to</span></p><p ttm:agent="v1" begin="03:32.887" end="03:36.037"><span begin="03:32.887" end="03:33.217">I'll </span><span begin="03:33.217" end="03:33.497">stand </span><span begin="03:33.497" end="03:33.737">by </span><span begin="03:33.737" end="03:33.967">your </span><span begin="03:33.967" end="03:34.417">side </span><span begin="03:34.417" end="03:34.647">like </span><span begin="03:34.647" end="03:34.907">i </span><span begin="03:34.907" end="03:35.477">always </span><span begin="03:35.477" end="03:36.037">do</span></p><p ttm:agent="v1" begin="03:36.687" end="03:39.837"><span begin="03:36.687" end="03:36.927">In </span><span begin="03:36.927" end="03:37.207">the </span><span begin="03:37.207" end="03:37.437">dead </span><span begin="03:37.437" end="03:37.687">of </span><span begin="03:37.687" end