<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Francis Forever</ttm:title><ttm:agent type="person" xml:id="v1">Mitski</ttm:agent><ttm:item type="album">Bury Me At Makeout Creek</ttm:item><ttm:item type="spotify_id">5411TEB6tlzvuF5A4oyldr</ttm:item><itunes:duration>02:29.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:07.872" end="00:11.741"><span begin="00:07.872" end="00:08.192">I </span><span begin="00:08.192" end="00:08.482">don't </span><span begin="00:08.482" end="00:08.832">know </span><span begin="00:08.832" end="00:09.132">what </span><span begin="00:09.132" end="00:09.412">to </span><span begin="00:09.412" end="00:10.191">do </span><span begin="00:10.191" end="00:11.041">without </span><span begin="00:11.041" end="00:11.741">you</span></p><p ttm:agent="v1" begin="00:12.561" end="00:16.851"><span begin="00:12.561" end="00:12.931">I </span><span begin="00:12.931" end="00:13.241">don't </span><span begin="00:13.241" end="00:13.561">know </span><span begin="00:13.561" end="00:13.821">where </span><span begin="00:13.821" end="00:14.151">to </span><span begin="00:14.151" end="00:14.751">put </span><span begin="00:14.751" end="00:15.501">my </span><span begin="00:15.501" end="00:16.851">hands</span></p><p ttm:agent="v1" begin="00:17.261" end="00:21.159"><span begin="00:17.261" end="00:17.741">I've </span><span begin="00:17.741" end="00:18.071">been </span><span begin="00:18.071" end="00:18.640">trying </span><span begin="00:18.640" end="00:19.110">to </span><span begin="00:19.110" end="00:19.580">lay </span><span begin="00:19.580" end="00:19.920">my </span><span begin="00:19.920" end="00:20.330">head </span><span begin="00:20.330" end="00:21.159">down</span></p><p ttm:agent="v1" begin="00:21.609" end="00:25.809"><span begin="00:21.609" end="00:22.189">I'm </span><span begin="00:22.189" end="00:22.899">writing </span><span begin="00:22.899" end="00:23.249">this </span><span begin="00:23.249" end="00:23.539">at </span><span begin="00:23.539" end="00:24.169">3 </span><span begin="00:24.169" end="00:25.809">Am</span></p><p ttm:agent="v1" begin="00:26.119" end="00:30.068"><span begin="00:26.119" end="00:26.539">I </span><span begin="00:26.539" end="00:26.959">don't </span><span begin="00:26.959" end="00:27.529">need </span><span begin="00:27.529" end="00:28.199">the </span><span begin="00:28.199" end="00:28.799">world </span><span begin="00:28.799" end="00:29.398">to </span><span begin="00:29.398" end="00:30.068">see</span></p><p ttm:agent="v1" begin="00:30.068" end="00:34.578"><span begin="00:30.068" end="00:30.468">That </span><span begin="00:30.468" end="00:30.798">I've </span><span begin="00:30.798" end="00:31.258">been </span><span begin="00:31.258" end="00:31.728">the </span><span begin="00:31.728" end="00:32.738">best </span><span begin="00:32.738" end="00:32.958">I </span><span begin="00:32.958" end="00:33.288">can </span><span begin="00:33.288" end="00:34.578">be</span></p><p ttm:agent="v1" begin="00:34.578" end="00:39.376"><span begin="00:34.578" end="00:35.447">But </span><span begin="00:35.447" end="00:35.956">I </span><span begin="00:35.956" end="00:36.476">don't </span><span begin="00:36.476" end="00:37.096">think </span><span begin="00:37.096" end="00:37.496">I </span><span begin="00:37.496" end="00:37.816">could </span><span begin="00:37.816" end="00:38.236">stand </span><span begin="00:38.236" end="00:38.866">to </span><span begin="00:38.866" end="00:39.376">be</span></p><p ttm:agent="v1" begin="00:39.866" end="00:45.576"><span begin="00:39.866" end="00:40.076">Where </span><span begin="00:40.076" end="00:40.576">you </span><span begin="00:40.576" end="00:41.196">don't </span><span begin="00:41.196" end="00:42.876">see </span><span begin="00:42.876" end="00:45.576">me</span></p><p ttm:agent="v1" begin="01:03.366" end="01:07.376"><span begin="01:03.366" end="01:03.616">On </span><span begin="01:03.616" end="01:04.096">sunny </span><span begin="01:04.096" end="01:04.606">days </span><span begin="01:04.606" end="01:04.896">I </span><span begin="01:04.896" end="01:05.206">go </span><span begin="01:05.206" end="01:05.636">out </span><span begin="01:05.636" end="01:07.376">walking</span></p><p ttm:agent="v1" begin="01:07.816" end="01:12.096"><span begin="01:07.816" end="01:08.306">I </span><span begin="01:08.306" end="01:08.516">end </span><span begin="01:08.516" end="01:08.816">up </span><span begin="01:08.816" end="01:09.116">on </span><span begin="01:09.116" end="01:09.426">a </span><span begin="01:09.426" end="01:09.926">tree </span><span begin="01:09.926" end="01:10.896">lined </span><span begin="01:10.896" end="01:12.096">street</span></p><p ttm:agent="v1" begin="01:12.506" end="01:16.786"><span begin="01:12.506" end="01:12.846">I </span><span begin="01:12.846" end="01:13.206">look </span><span begin="01:13.206" end="01:13.496">up </span><span begin="01:13.496" end="01:13.786">at </span><span begin="01:13.786" end="01:14.106">the </span><span begin="01:14.106" end="01:14.826">gaps </span><span begin="01:14.826" end="01:15.176">of </span><span begin="01:15.176" end="01:16.786">sunlight</span></p><p ttm:agent="v1" begin="01:17.006" end="01:21.235"><span begin="01:17.006" end="01:17.575">I </span><span begin="01:17.575" end="01:17.785">miss </span><span begin="01:17.785" end="01:18.205">you </span><span begin="01:18.205" end="01:18.605">more </span><span begin="01:18.605" end="01:19.005">than </span><span begin="01:19.005" end="01:21.235">anything</span></p><p ttm:agent="v1" begin="01:21.235" end="01:25.305"><span begin="01:21.235" end="01:21.635">I </span><span begin="01:21.635" end="01:22.145">don't </span><span begin="01:22.145" end="01:22.805">need </span><span begin="01:22.805" end="01:23.355">the </span><span begin="01:23.355" end="01:24.025">world </span><span begin="01:24.025" end="01:24.795">to </span><span begin="01:24.795" end="01:25.305">see</span></p><p ttm:agent="v1" begin="01:25.305" end="01:29.844"><span begin="01:25.305" end="01:25.715">That </span><span begin="01:25.715" end="01:26.065">I've </span><span begin="01:26.065" end="01:26.435">been </span><span begin="01:26.435" end="01:27.045">the </span><span begin="01:27.045" end="01:27.655">best </span><span begin="01:27.655" end="01:28.065">I </span><span begin="01:28.065" end="01:28.715">can </span><span begin="01:28.715" end="01:29.844">be</span></p><p ttm:agent="v1" begin="01:29.844" end="01:34.643"><span begin="01:29.844" end="01:30.584">But </span><span begin="01:30.864" end="01:31.204">I </span><span begin="01:31.204" end="01:31.724">don't </span><span begin="01:31.724" end="01:32.303">think </span><span begin="01:32.303" end="01:32.613">I </span><span begin="01:32.613" end="01:32.923">could </span><span begin="01:32.923" end="01:33.403">stand </span><span begin="01:33.403" end="01:34.113">to </span><span begin="01:34.113" end="01:34.643">be</span></p><p ttm:agent="v1" begin="01:35.082" end="01:40.120"><span begin="01:35.082" end="01:35.392">Where </span><span begin="01:35.392" end="01:35.892">you </span><span begin="01:35.892" end="01:36.821">don't </span><span begin="01:36.821" end="01:38.130">see </span><span begin="01:38.130" end="01:40.120">me</span></p><p ttm:agent="v1" begin="01:40.410" end="01:44.100"><span begin="01:40.410" end="01:40.660">And </span><span begin="01:40.660" end="01:41.180">autumn </span><span begin="01:41.180" end="01:41.720">comes </span><span begin="01:41.720" end="01:41.980">when </span><span begin="01:41.980" end="01:42.370">you're </span><span begin="01:42.370" end="01:42.820">not </span><span begin="01:42.820" end="01:43.560">yet </span><span begin="01:43.560" end="01:44.100">done</span></p><p ttm:agent="v1" begin="01:44.100" end="01:48.770"><span begin="01:44.100" end="01:44.470">With </span><span begin="01:44.470" end="01:44.760">the </span><span begin="01:44.760" end="01:45.870">summer </span><span begin="01:45.870" end="01:47.530">passing </span><span begin="01:47.530" end="01:48.770">by</span></p><p ttm:agent="v1" begin="01:48.770" end="01:53.620"><span begin="01:48.770" end="01:49.500">But </span><span begin="01:49.500" end="01:49.970">I </span><span begin="01:49.970" end="01:50.480">don't </span><span begin="01:50.480" end="01:51.100">think </span><span begin="01:51.100" end="01:51.550">I </span><span begin="01:51.550" end="01:51.860">could </span><span begin="01:51.860" end="01:52.290">stand </span><span begin="01:52.290" end="01:52.960">to </span><span begin="01:52.960" end="01:53.620">be</span></p><p ttm:agent="v1" begin="01:53.949" end="02:00.268"><span begin="01:53.949" end="01:54.139">Where </span><span begin="01:54.139" end="01:54.599">you </span><span begin="01:54.599" end="01:55.318">don't </span><span begin="01:55.318" end="01:57.038">see </span><span begin="01:57.038" end="02:00.268">me</span></p></div></body></tt>