90">go</span><span begin="00:27.990" end="00:27.990">, </span><span begin="00:27.990" end="00:28.320">let </span><span begin="00:28.320" end="00:28.500">go</span><span begin="00:28.500" end="00:28.530">）</span></p><p ttm:agent="v1" begin="00:28.530" end="00:30.810"><span begin="00:28.530" end="00:29.100">Faced </span><span begin="00:29.100" end="00:29.550">again </span><span begin="00:29.550" end="00:29.910">with </span><span begin="00:29.910" end="00:30.000">a </span><span begin="00:30.000" end="00:30.420">taste </span><span begin="00:30.420" end="00:30.600">of </span><span begin="00:30.600" end="00:30.810">it</span></p><p ttm:agent="v1" begin="00:30.810" end="00:32.700"><span begin="00:30.810" end="00:31.260">Still </span><span begin="00:31.260" end="00:31.380">I'll </span><span begin="00:31.380" end="00:31.830">never </span><span begin="00:31.830" end="00:32.700">change</span></p><p ttm:agent="v1" begin="00:32.700" end="00:34.110"><span begin="00:32.700" end="00:32.856">（</span><span begin="00:32.856" end="00:33.012">We </span><span begin="00:33.012" end="00:33.168">won't </span><span begin="00:33.168" end="00:33.324">let </span><span begin="00:33.324" end="00:33.480">go</span><span begin="00:33.480" end="00:33.636">, </span><span begin="00:33.636" end="00:33.792">let </span><span begin="00:33.792" end="00:33.948">go</span><span begin="00:33.948" end="00:34.110">）</span></p><p ttm:agent="v1" begin="00:34.110" end="00:38.910"><span begin="00:34.110" end="00:36.180">Understand </span><span begin="00:36.180" end="00:36.420">I'm </span><span begin="00:36.420" end="00:37.710">losing </span><span begin="00:37.710" end="00:38.910">faith</span></p><p ttm:agent="v1" begin="00:39.000" end="00:44.400"><span begin="00:39.000" end="00:40.380">Reminding </span><span begin="00:40.380" end="00:41.460">self </span><span begin="00:41.460" end="00:41.940">there </span><span begin="00:41.940" end="00:42.750">are </span><span begin="00:42.750" end="00:43.050">no </span><span begin="00:43.050" end="00:44.400">saints</span></p><p ttm:agent="v1" begin="00:44.700" end="00:49.920"><span begin="00:44.700" end="00:46.950">Comprehend </span><span begin="00:46.950" end="00:47.160">I'm </span><span begin="00:47.160" end="00:48.210">through </span><span begin="00:48.210" end="00:48.540">with </span><span begin="00:48.540" end="00:49.920">running</span></p><p ttm:agent="v1" begin="00:49.920" end="00:56.610"><span begin="00:49.920" end="00:50.340">And </span><span begin="00:50.340" end="00:51.420">I </span><span begin="00:51.420" end="00:52.800">can't </span><span begin="00:52.800" end="00:53.910">stop </span><span begin="00:53.910" end="00:54.180">my </span><span begin="00:54.180" end="00:54.630">long </span><span begin="00:54.630" end="00:54.960">for </span><span begin="00:54.960" end="00:56.610">belief</span></p><p ttm:agent="v1" begin="00:56.610" end="00:57.360"><span begin="00:56.610" end="00:56.693">（</span><span begin="00:56.693" end="00:56.776">On </span><span begin="00:56.776" end="00:56.859">and </span><span begin="00:56.859" end="00:56.942">on </span><span begin="00:56.942" end="00:57.025">and </span><span begin="00:57.025" end="00:57.108">on </span><span begin="00:57.108" end="00:57.191">and </span><span begin="00:57.191" end="00:57.274">on</span><span begin="00:57.274" end="00:57.360">）</span></p><p ttm:agent="v1" begin="00:57.360" end="00:58.680"><span begin="00:57.360" end="00:57.630">It </span><span begin="00:57.630" end="00:58.680">goes</span></p><p ttm:agent="v1" begin="00:58.680" end="01:00.690"><span begin="00:58.680" end="00:58.680">（</span><span begin="00:58.680" end="00:58.740">On </span><span begin="00:58.740" end="00:58.890">and </span><span begin="00:58.890" end="00:59.280">on </span><span begin="00:59.280" end="00:59.400">and </span><span begin="00:59.400" end="00:59.730">on </span><span begin="00:59.730" end="00:59.940">and </span><span begin="00:59.940" end="01:00.630">on</span><span begin="01:00.630" end="01:00.690">）</span></p><p ttm:agent="v1" begin="01:00.690" end="01:07.170"><span begin="01:00.690" end="01:00.900">And </span><span begin="01:00.900" end="01:02.340">now </span><span begin="01:02.340" end="01:03.660">I </span><span begin="01:03.660" end="01:04.620">feel </span><span begin="01:04.620" end="01:04.980">so </span><span begin="01:04.980" end="01:05.490">lost </span><span begin="01:05.490" end="01:05.760">and </span><span begin="01:05.760" end="01:07.170">deceived</span></p><p ttm:agent="v1" begin="01:07.170" end="01:08.640"><span begin="01:07.170" end="01:07.333">（</span><span begin="01:07.333" end="01:07.496">On </span><span begin="01:07.496" end="01:07.659">and </span><span begin="01:07.659" end="01:07.822">on </span><span begin="01:07.822" end="01:07.985">and </span><span begin="01:07.985" end="01:08.148">on </span><span begin="01:08.148" end="01:08.311">and </span><span begin="01:08.311" end="01:08.474">on</span><span begin="01:08.474" end="01:08.640">）</span></p><p ttm:agent="v1" begin="01:08.640" end="01:14.020"><span begin="01:08.640" end="01:09.030">How </span><span begin="01:09.030" end="01:09.600">will </span><span begin="01:09.600" end="01:10.020">we </span><span begin="01:10.020" end="01:10.710">rest </span><span begin="01:10.710" end="01:11.070">in </span><span begin="01:11.070" end="01:13.830">peace</span><span begin="01:13.830" end="01:14.020">?</span></p><p ttm:agent="v1" begin="01:14.020" end="01:17.610"><span begin="01:14.020" end="01:14.210">*</span><span begin="01:14.210" end="01:14.400">*</span><span begin="01:14.400" end="01:14.590">*</span><span begin="01:14.590" end="01:14.820">* </span><span begin="01:14.820" end="01:14.970">the </span><span begin="01:14.970" end="01:15.390">sins </span><span begin="01:15.390" end="01:15.660">that </span><span begin="01:15.660" end="01:15.840">we </span><span begin="01:15.840" end="01:16.200">fear </span><span begin="01:16.200" end="01:16.290">to </span><span begin="01:16.290" end="01:16.740">live </span><span begin="01:16.740" end="01:17.070">in </span><span begin="01:17.070" end="01:17.280">the </span><span begin="01:17.280" end="01:17.610">end</span></p><p ttm:agent="v1" begin="01:17.610" end="01:19.770"><span begin="01:17.610" end="01:17.880">（</span><span begin="01:17.880" end="01:18.150">We </span><span begin="01:18.150" end="01:18.420">won't </span><span begin="01:18.420" end="01:18.690">ever </span><span begin="01:18.690" end="01:18.960">follow</span><span begin="01:18.960" end="01:19.230">, </span><span begin="01:19.230" end="01:19.500">follow</span><span begin="01:19.500" end="01:19.770">）</span></p><p ttm:agent="v1" begin="01:19.770" end="01:22.140"><span begin="01:19.770" end="01:20.280">Stand </span><span begin="01:20.280" end="01:20.700">against </span><span begin="01:20.700" end="01:21.060">preach </span><span begin="01:21.060" end="01:21.180">the </span><span begin="01:21.180" end="01:21.630">same </span><span begin="01:21.630" end="01:21.810">old </span><span begin="01:21.810" end="01:21.890">*</span><span begin="01:21.890" end="01:21.970">*</span><span begin="01:21.970" end="01:22.050">*</span><span begin="01:22.050" end="01:22.140">*</span></p><p ttm:agent="v1" begin="01:22.140" end="01:23.730"><span begin="01:22.140" end="01:22.500">You're </span><span begin="01:22.500" end="01:22.920">afraid </span><span begin="01:22.920" end="01:23.070">to </span><span begin="01:23.070" end="01:23.730">live</span></p><p ttm:agent="v1" begin="01:23.730" end="01:25.860"><span begin="01:23.730" end="01:24.034">（</span><span begin="01:24.034" end="01:24.338">We </span><span begin="01:24.338" end="01:24.642">won't </span><span begin="01:24.642" end="01:24.946">follow</span><span begin="01:24.946" end="01:25.250">, </span><span begin="01:25.250" end="01:25.554">follow</span><span begin="01:25.554" end="01:25.860">）</span></p><p ttm:agent="v1" begin="01:25.860" end="01:30.210"><span begin="01:25.860" end="01:27.390">Understand </span><span begin="01:27.390" end="01:27.660">I </span><span begin="01:27.660" end="01:28.620">bow </span><span begin="01:28.620" end="01:28.950">to </span><span begin="01:28.950" end="01:30.210">nothing</span></p><p ttm:agent="v1" begin="01:30.240" end="01:35.220"><span begin="01:30.240" end="01:31.620">Reminding </span><span begin="01:31.620" end="01:32.790">self </span><span begin="01:32.790" end="01:32.970">of </span><span begin="01:32.970" end="01:34.140">pain </span><span begin="01:34.140" end="01:34.350">AND </span><span begin="01:34.350" end="01:35.220">TRUSTING</span></p><p ttm:agent="v1" begin="01:36.000" end="01:41.520"><span begin="01:36.000" end="01:38.190">Comprehend </span><span begin="01:38.190" end="01:38.400">I'm </span><span begin="01:38.400" end="01:39.330">through </span><span begin="01:39.330" end="01:39.780">with </span><span begin="01:39.780" end="01:41.520">running</span></p><p ttm:agent="v1" begin="01:41.520" end="01:47.850"><span begin="01:41.520" end="01:41.700">And </span><span begin="01:41.700" end="01:42.660">I </span><span begin="01:42.660" end="01:44.040">can't </span><span begin="01:44.040" end="01:45.150">stop </span><span begin="01:45.150" end="01:45.420">my </span><span begin="01:45.420" end="01:45.870">long </span><span begin="01:45.870" end="01:46.200">for </span><span begin="01:46.200" end="01:47.850">belief</span></p><p ttm:agent="v1" begin="01:47.850" end="01:48.600"><span begin="01:47.850" end="01:47.933">（</span><span begin="01:47.933" end="01:48.016">On </span><span begin="01:48.016" end="01:48.099">and </span><span begin="01:48.099" end="01:48.182">on </span><span begin="01:48.182" end="01:48.265">and </span><span begin="01:48.265" end="01:48.348">on </span><span begin="01:48.348" end="01:48.431">and </span><span begin="01:48.431" end="01:48.514">on</span><span begin="01:48.514" end="01:48.600">）</span></p><p ttm:agent="v1" begin="01:48.600" end="01:49.890"><span begin="01:48.600" end="01:48.870">It </span><span begin="01:48.870" end="01:49.890">goes</span></p><p ttm:agent="v1" begin="01:49.890" end="01:51.900"><span begin="01:49.890" end="01:49.890">（</span><span begin="01:49.890" end="01:49.980">On </span><span begin="01:49.980" end="01:50.130">and </span><span begin="01:50.130" end="01:50.520">on </span><span begin="01:50.520" end="01:50.610">and </span><span begin="01:50.610" end="01:50.970">on </span><span begin="01:50.970" end="01:51.180">and </span><span begin="01:51.180" end="01:51.840">on</span><span begin="01:51.840" end="01:51.900">）</span></p><p ttm:agent="v1" begin="01:51.900" end="01:58.770"><span begin="01:51.900" end="01:52.140">And </span><span begin="01:52.140" end="01:53.580">now </span><span begin="01:53.580" end="01:54.900">I </span><span begin="01:54.900" end="01:55.860">feel </span><span begin="01:55.860" end="01:56.220">so </span><span begin="01:56.220" end="01:56.730">lost </span><span begin="01:56.730" end="01:57.000">and </span><span begin="01:57.000" end="01:58.770">deceived</span></p><p ttm:agent="v1" begin="01:58.770" end="01:59.880"><span begin="01:58.770" end="01:58.893">（</span><span begin="01:58.893" end="01:59.016">On </span><span begin="01:59.016" end="01:59.139">and </span><span begin="01:59.139" end="01:59.262">on </span><span begin="01:59.262" end="01:59.385">and </span><span begin="01:59.385" end="01:59.508">on </span><span begin="01:59.508" end="01:59.631">and </span><span begin="01:59.631" end="01:59.754">on</span><span begin="01:59.754" end="01:59.880">）</span></p><p ttm:agent="v1" begin="01:59.880" end="02:13.860"><span begin="01:59.880" end="02:00.270">How </span><span begin="02:00.270" end="02:00.840">will </span><span begin="02:00.840" end="02:01.260">we </span><span begin="02:01.260" end="02:01.950">rest </span><span begin="02:01.950" end="02:02.310">in </span><span begin="02:02.310" end="02:05.040">peace</span><span begin="02:05.040" end="02:13.860">?</span></p><p ttm:agent="v1" begin="02:13.860" end="02:19.500"><span begin="02:13.860" end="02:14.370">I </span><span begin="02:14.370" e