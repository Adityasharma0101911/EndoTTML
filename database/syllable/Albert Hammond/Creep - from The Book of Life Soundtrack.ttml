  <body>
    <div>
      <p begin="00:19.590" end="00:20.910" ttm:agent="v1">
        <span begin="00:19.590" end="00:19.980">Hi </span>
        <span begin="00:19.980" end="00:19.980">, </span>
        <span begin="00:19.980" end="00:20.910">Maria</span>
      </p>
      <p begin="00:22.020" end="00:23.580" ttm:agent="v1">
        <span begin="00:22.020" end="00:22.260">When </span>
        <span begin="00:22.260" end="00:22.410">you </span>
        <span begin="00:22.410" end="00:22.560">were </span>
        <span begin="00:22.560" end="00:22.800">here </span>
        <span begin="00:22.800" end="00:23.580">before</span>
      </p>
      <p begin="00:26.790" end="00:28.500" ttm:agent="v1">
        <span begin="00:26.790" end="00:27.150">couldn't </span>
        <span begin="00:27.150" end="00:27.390">look </span>
        <span begin="00:27.390" end="00:27.540">you </span>
        <span begin="00:27.540" end="00:27.690">in </span>
        <span begin="00:27.690" end="00:27.840">the </span>
        <span begin="00:27.840" end="00:28.500">eye</span>
      </p>
      <p begin="00:31.650" end="00:35.040" ttm:agent="v1">
        <span begin="00:31.650" end="00:31.980">You're </span>
        <span begin="00:31.980" end="00:32.400">just </span>
        <span begin="00:32.400" end="00:32.790">like </span>
        <span begin="00:32.790" end="00:33.060">an </span>
        <span begin="00:33.060" end="00:35.040">angel</span>
      </p>
      <p begin="00:36.900" end="00:39.810" ttm:agent="v1">
        <span begin="00:36.900" end="00:37.200">your </span>
        <span begin="00:37.200" end="00:37.590">skin </span>
        <span begin="00:37.590" end="00:37.980">makes </span>
        <span begin="00:37.980" end="00:38.130">me </span>
        <span begin="00:38.130" end="00:39.810">cry</span>
      </p>
      <p begin="00:42.300" end="00:44.370" ttm:agent="v1">
        <span begin="00:42.300" end="00:42.510">But </span>
        <span begin="00:42.510" end="00:42.870">I'm </span>
        <span begin="00:42.870" end="00:43.320">a </span>
        <span begin="00:43.320" end="00:44.370">creep</span>
      </p>
      <p begin="00:47.610" end="00:51.720" ttm:agent="v1">
        <span begin="00:47.610" end="00:48.150">I'm </span>
        <span begin="00:48.150" end="00:48.540">a </span>
        <span begin="00:48.540" end="00:51.720">weirdo</span>
      </p>
      <p begin="00:52.770" end="00:58.110" ttm:agent="v1">
        <span begin="00:52.770" end="00:53.220">What </span>
        <span begin="00:53.220" end="00:53.280">is </span>
        <span begin="00:53.280" end="00:53.340">the </span>
        <span begin="00:53.340" end="00:53.520">hell </span>
        <span begin="00:53.520" end="00:53.640">am </span>
        <span begin="00:53.640" end="00:53.700">I </span>
        <span begin="00:53.700" end="00:54.240">doing </span>
        <span begin="00:54.240" end="00:57.690">here </span>
        <span begin="00:57.690" end="00:58.110">?</span>
      </p>
      <p begin="00:58.110" end="01:00.750" ttm:agent="v1">
        <span begin="00:58.110" end="00:58.440">i </span>
        <span begin="00:58.440" end="00:58.800">don't </span>
        <span begin="00:58.800" end="00:59.730">belong </span>
        <span begin="00:59.730" end="01:00.750">here</span>
      </p>
      <p begin="01:03.420" end="01:20.890" ttm:agent="v1">
        <span begin="01:03.420" end="01:03.810">i </span>
        <span begin="01:03.810" end="01:05.700">don't </span>
        <span begin="01:05.700" end="01:09.540">belong </span>
        <span begin="01:09.540" end="01:13.320">. </span>
        <span begin="01:13.320" end="01:17.100">. </span>
        <span begin="01:17.100" end="01:20.890">.</span>
      </p>
    </div>
