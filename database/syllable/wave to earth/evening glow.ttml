<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>evening glow</ttm:title><ttm:agent type="person" xml:id="v1">wave to earth</ttm:agent><ttm:item type="album">0.1 flaws and all.</ttm:item><ttm:item type="spotify_id">4ti11xaTQ4ZrLBglUyrkMX</ttm:item><itunes:duration>03:36.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:21.783" end="00:26.247"><span begin="00:21.783" end="00:22.023">If </span><span begin="00:22.023" end="00:23.142">I </span><span begin="00:23.142" end="00:24.391">feel </span><span begin="00:24.391" end="00:26.247">broken</span></p><p ttm:agent="v1" begin="00:26.858" end="00:30.472"><span begin="00:26.858" end="00:27.111">You </span><span begin="00:27.111" end="00:27.639">will </span><span begin="00:27.639" end="00:28.857">find </span><span begin="00:28.857" end="00:30.472">me</span></p><p ttm:agent="v1" begin="00:31.273" end="00:37.606"><span begin="00:31.273" end="00:31.736">Those </span><span begin="00:31.736" end="00:32.919">useless </span><span begin="00:32.919" end="00:33.750">words </span><span begin="00:33.750" end="00:34.008">were </span><span begin="00:34.008" end="00:35.032">falling </span><span begin="00:35.032" end="00:35.896">apart </span><span begin="00:35.896" end="00:36.246">on </span><span begin="00:36.246" end="00:37.606">me</span></p><p ttm:agent="v1" begin="00:41.186" end="00:47.122"><span begin="00:41.186" end="00:42.355">I'm </span><span begin="00:42.355" end="00:44.995">struggling </span><span begin="00:44.995" end="00:45.441">in </span><span begin="00:45.441" end="00:45.954">my </span><span begin="00:45.954" end="00:47.122">world</span></p><p ttm:agent="v1" begin="00:50.578" end="00:54.994"><span begin="00:50.578" end="00:50.817">I </span><span begin="00:50.817" end="00:51.377">might </span><span begin="00:51.377" end="00:51.858">be </span><span begin="00:51.858" end="00:52.417">full </span><span begin="00:52.417" end="00:53.123">of </span><span begin="00:53.123" end="00:54.994">flaws</span></p><p ttm:agent="v1" begin="00:55.266" end="01:00.402"><span begin="00:55.266" end="00:55.507">But </span><span begin="00:55.507" end="00:56.339">you </span><span begin="00:56.339" end="00:56.835">will </span><span begin="00:56.835" end="00:57.346">crave </span><span begin="00:57.346" end="00:57.906">my </span><span begin="00:57.906" end="01:00.402">heart</span></p><p ttm:agent="v1" begin="01:02.541" end="01:11.950"><span begin="01:02.541" end="01:02.783">I'm </span><span begin="01:02.783" end="01:07.229">broken </span><span begin="01:07.229" end="01:07.503">so </span><span begin="01:07.503" end="01:08.078">take </span><span begin="01:08.078" end="01:08.734">me </span><span begin="01:08.734" end="01:09.326">to </span><span begin="01:09.326" end="01:09.885">the </span><span begin="01:09.885" end="01:11.137">evening </span><span begin="01:11.137" end="01:11.950">glow</span></p><p ttm:agent="v1" begin="01:12.189" end="01:25.054"><span begin="01:12.189" end="01:12.433">And </span><span begin="01:12.433" end="01:13.571">lay </span><span begin="01:13.571" end="01:14.815">me </span><span begin="01:14.815" end="01:16.029">down </span><span begin="01:16.029" end="01:16.526">on </span><span begin="01:16.526" end="01:17.069">the </span><span begin="01:17.069" end="01:20.477">sun </span><span begin="01:20.477" end="01:20.733">the </span><span begin="01:20.733" end="01:21.901">tender </span><span begin="01:21.901" end="01:25.054">sun</span></p><p ttm:agent="v1" begin="01:41.304" end="01:45.771"><span begin="01:41.304" end="01:41.545">I'm </span><span begin="01:41.545" end="01:43.784">feeling </span><span begin="01:43.784" end="01:45.771">empty</span></p><p ttm:agent="v1" begin="01:46.042" end="01:53.561"><span begin="01:46.042" end="01:48.410">Under </span><span begin="01:48.410" end="01:49.673">you </span><span begin="01:49.673" end="01:50.312">calm </span><span begin="01:50.312" end="01:50.648">like </span><span begin="01:50.648" end="01:50.968">the </span><span begin="01:50.968" end="01:53.561">ocean</span></p><p ttm:agent="v1" begin="01:54.936" end="01:59.336"><span begin="01:54.936" end="01:55.225">Look </span><span begin="01:55.225" end="01:55.498">the </span><span begin="01:55.498" end="01:56.568">sun </span><span begin="01:56.568" end="01:56.905">is </span><span begin="01:56.905" end="01:57.897">really </span><span begin="01:57.897" end="01:59.336">low</span></p><p ttm:agent="v1" begin="01:59.802" end="02:06.202"><span begin="01:59.802" end="02:00.265">Wouldn't </span><span begin="02:00.265" end="02:00.986">my </span><span begin="02:00.986" end="02:02.121">travel </span><span begin="02:02.121" end="02:02.793">be </span><span begin="02:02.793" end="02:06.202">warm</span></p><p ttm:agent="v1" begin="02:07.386" end="02:16.698"><span begin="02:07.386" end="02:07.611">I'm </span><span begin="02:07.611" end="02:12.059">broken </span><span begin="02:12.059" end="02:12.346">so </span><span begin="02:12.346" end="02:12.846">take </span><span begin="02:12.846" end="02:13.450">me </span><span begin="02:13.450" end="02:14.090">to </span><span begin="02:14.090" end="02:14.699">the </span><span begin="02:14.699" end="02:15.914">evening </span><span begin="02:15.914" end="02:16.698">glow</span></p><p ttm:agent="v1" begin="02:16.970" end="02:29.959"><span begin="02:16.970" end="02:17.225">And </span><span begin="02:17.225" end="02:18.345">lay </span><span begin="02:18.345" end="02:19.563">me </span><span begin="02:19.563" end="02:20.873">down </span><span begin="02:20.873" end="02:21.373">on </span><span begin="02:21.373" end="02:21.914">the </span><span begin="02:21.914" end="02:25.308">sun </span><span begin="02:25.308" end="02:25.615">the </span><span begin="02:25.615" end="02:26.731">tender </span><span begin="02:26.731" end="02:29.959">sun</span></p><p ttm:agent="v1" begin="02:30.440" end="02:34.807"><span begin="02:30.440" end="02:31.560">Tender </span><span begin="02:31.560" end="02:34.807">sun</span></p><p ttm:agent="v1" begin="02:34.984" end="02:39.547"><span begin="02:34.984" end="02:36.313">Tender </span><span begin="02:36.313" end="02:39.547">sun</span></p><p ttm:agent="v1" begin="02:39.961" end="02:44.620"><span begin="02:39.961" end="02:41.161">Tender </span><span begin="02:41.161" end="02:44.620">sun</span></p></div></body></tt>