<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>ride</ttm:title><ttm:agent type="person" xml:id="v1">wave to earth</ttm:agent><ttm:item type="album">summer flows 0.02</ttm:item><ttm:item type="spotify_id">67KfktISVA3XHSRqge5JiB</ttm:item><itunes:duration>03:48.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:24.093" end="00:28.849"><span begin="00:24.093" end="00:26.095">바닥에 </span><span begin="00:27.191" end="00:28.849">눌러붙어</span></p><p ttm:agent="v1" begin="00:30.298" end="00:34.815"><span begin="00:30.298" end="00:31.020">하루 </span><span begin="00:31.020" end="00:32.052">종일 </span><span begin="00:32.976" end="00:34.121">창밖만 </span><span begin="00:34.121" end="00:34.815">보자</span></p><p ttm:agent="v1" begin="00:36.005" end="00:39.323"><span begin="00:36.005" end="00:36.802">햇살 </span><span begin="00:36.802" end="00:38.014">가득한 </span><span begin="00:38.014" end="00:39.323">방안에</span></p><p ttm:agent="v1" begin="00:42.198" end="00:45.479"><span begin="00:42.198" end="00:42.950">너의 </span><span begin="00:42.950" end="00:44.157">향기가 </span><span begin="00:44.157" end="00:45.479">가득해</span></p><p ttm:agent="v1" begin="00:48.730" end="00:57.208"><span begin="00:48.730" end="00:50.749">가끔은 </span><span begin="00:51.429" end="00:52.173">바쁜 </span><span begin="00:52.173" end="00:53.588">하루에 </span><span begin="00:54.483" end="00:56.215">힘겨워질 </span><span begin="00:56.215" end="00:57.208">때</span></p><p ttm:agent="v1" begin="00:57.208" end="00:59.786"><span begin="00:57.208" end="00:57.979">너의 </span><span begin="00:57.979" end="00:58.732">작은 </span><span begin="00:58.732" end="00:59.786">손이</span></p><p ttm:agent="v1" begin="01:00.613" end="01:03.945"><span begin="01:00.613" end="01:01.809">나에겐 </span><span begin="01:01.809" end="01:02.580">가장 </span><span begin="01:02.580" end="01:03.945">커다란</span></p><p ttm:agent="v1" begin="01:06.757" end="01:10.357"><span begin="01:06.757" end="01:07.965">의미를 </span><span begin="01:07.965" end="01:09.530">가지게 </span><span begin="01:09.530" end="01:10.357">해줘</span></p><p ttm:agent="v1" begin="01:19.456" end="01:24.299"><span begin="01:19.456" end="01:20.227">그저 </span><span begin="01:20.227" end="01:21.812">바라만 </span><span begin="01:21.812" end="01:22.562">봐도 </span><span begin="01:22.562" end="01:23.335">좋은 </span><span begin="01:23.335" end="01:24.299">거야</span></p><p ttm:agent="v1" begin="01:25.620" end="01:31.663"><span begin="01:25.620" end="01:25.988">I'm </span><span begin="01:25.988" end="01:26.386">on </span><span begin="01:26.386" end="01:26.779">a </span><span begin="01:26.779" end="01:29.416">ride </span><span begin="01:29.826" end="01:31.663">ride</span></p><p ttm:agent="v1" begin="01:31.753" end="01:40.402"><span begin="01:31.753" end="01:32.139">You </span><span begin="01:32.139" end="01:32.521">are </span><span begin="01:32.521" end="01:32.918">ma </span><span begin="01:32.918" end="01:36.654">city </span><span begin="01:38.306" end="01:40.402">everything</span></p><p ttm:agent="v1" begin="02:05.220" end="02:13.603"><span begin="02:05.220" end="02:06.354">가려운 </span><span begin="02:06.354" end="02:07.436">마음은 </span><span begin="02:08.738" end="02:10.738">언제나 </span><span begin="02:11.426" end="02:12.544">부풀어 </span><span begin="02:12.544" end="02:13.603">올라</span></p><p ttm:agent="v1" begin="02:14.466" end="02:17.840"><span begin="02:14.466" end="02:16.111">터질듯한 </span><span begin="02:16.111" end="02:17.840">모습이야</span></p><p ttm:agent="v1" begin="02:20.642" end="02:24.071"><span begin="02:20.642" end="02:21.396">너의 </span><span begin="02:21.396" end="02:22.574">말들로 </span><span begin="02:22.574" end="02:24.071">가득해</span></p><p ttm:agent="v1" begin="02:30.604" end="02:42.276"><span begin="02:30.604" end="02:31.975">버려질 </span><span begin="02:32.581" end="02:34.996">마음들을 </span><span begin="02:36.407" end="02:37.173">가득 </span><span begin="02:37.173" end="02:38.249">채워 </span><span begin="02:38.707" end="02:40.285">나에게 </span><span begin="02:40.614" end="02:42.276">줘</span></p><p ttm:agent="v1" begin="02:42.903" end="02:53.595"><span begin="02:42.903" end="02:43.686">모든 </span><span begin="02:43.686" end="02:45.235">기억 </span><span begin="02:45.235" end="02:46.436">속에 </span><span begin="02:46.776" end="02:48.847">너를 </span><span begin="02:49.885" end="02:51.880">담아둘 </span><span begin="02:52.194" end="02:53.595">거야</span></p><p ttm:agent="v1" begin="02:57.964" end="03:02.728"><span begin="02:57.964" end="02:58.728">그저 </span><span begin="02:58.728" end="03:00.233">바라만 </span><span begin="03:00.233" end="03:00.998">봐도 </span><span begin="03:00.998" end="03:01.794">좋은 </span><span begin="03:01.794" end="03:02.728">거야</span></p><p ttm:agent="v1" begin="03:04.114" end="03:09.964"><span begin="03:04.114" end="03:04.471">I'm </span><span begin="03:04.471" end="03:04.849">on </span><span begin="03:04.849" end="03:05.233">a </span><span begin="03:05.233" end="03:07.826">ride </span><span begin="03:08.343" end="03:09.964">ride</span></p><p ttm:agent="v1" begin="03:10.261" end="03:18.771"><span begin="03:10.261" end="03:10.621">You </span><span begin="03:10.621" end="03:10.991">are </span><span begin="03:10.991" end="03:11.379">ma </span><span begin="03:11.379" end="03:14.833">city </span><span begin="03:16.790" end="03:18.771">everything</span></p></div></body></tt>