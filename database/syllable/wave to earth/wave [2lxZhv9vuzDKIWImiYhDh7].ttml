<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>wave</ttm:title><ttm:agent type="person" xml:id="v1">wave to earth</ttm:agent><ttm:item type="album">wave</ttm:item><ttm:item type="spotify_id">2lxZhv9vuzDKIWImiYhDh7</ttm:item><itunes:duration>04:30.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:21.640" end="00:30.723"><span begin="00:21.640" end="00:22.320">If </span><span begin="00:22.320" end="00:23.639">we </span><span begin="00:23.639" end="00:24.923">go </span><span begin="00:24.923" end="00:25.483">far </span><span begin="00:25.483" end="00:26.435">away </span><span begin="00:26.435" end="00:26.979">out </span><span begin="00:26.979" end="00:27.499">of </span><span begin="00:27.499" end="00:28.124">this </span><span begin="00:28.124" end="00:29.115">land</span></p><p ttm:agent="v1" begin="00:30.723" end="00:39.924"><span begin="00:30.723" end="00:31.675">I </span><span begin="00:31.675" end="00:32.547">want </span><span begin="00:32.547" end="00:33.955">to </span><span begin="00:33.955" end="00:34.523">spend </span><span begin="00:34.523" end="00:35.275">this </span><span begin="00:35.275" end="00:36.379">all </span><span begin="00:36.379" end="00:36.827">night </span><span begin="00:36.827" end="00:37.371">with </span><span begin="00:37.371" end="00:38.747">you</span></p><p ttm:agent="v1" begin="00:39.924" end="00:45.836"><span begin="00:39.924" end="00:41.596">There </span><span begin="00:41.596" end="00:41.924">are </span><span begin="00:41.924" end="00:43.188">waves </span><span begin="00:43.188" end="00:43.660">in </span><span begin="00:43.660" end="00:44.317">your </span><span begin="00:44.317" end="00:45.756">eyes</span></p><p ttm:agent="v1" begin="00:45.836" end="00:52.244"><span begin="00:45.836" end="00:46.676">I'm </span><span begin="00:46.676" end="00:47.732">getting </span><span begin="00:47.732" end="00:49.004">into </span><span begin="00:49.004" end="00:51.428">you</span></p><p ttm:agent="v1" begin="00:52.244" end="00:58.388"><span begin="00:52.244" end="00:53.564">Into </span><span begin="00:53.564" end="00:56.092">you</span></p><p ttm:agent="v1" begin="00:58.388" end="01:02.645"><span begin="00:58.388" end="01:00.124">When </span><span begin="01:00.124" end="01:00.430">you </span><span begin="01:00.430" end="01:00.970">spoke </span><span begin="01:00.970" end="01:01.601">to </span><span begin="01:01.601" end="01:02.418">me</span></p><p ttm:agent="v1" begin="01:02.645" end="01:07.603"><span begin="01:02.645" end="01:03.012">The </span><span begin="01:03.012" end="01:03.564">words </span><span begin="01:03.564" end="01:04.084">are </span><span begin="01:04.084" end="01:04.508">like </span><span begin="01:04.508" end="01:05.148">a </span><span begin="01:05.148" end="01:06.204">flowing </span><span begin="01:06.204" end="01:07.124">star</span></p><p ttm:agent="v1" begin="01:07.603" end="01:11.786"><span begin="01:07.603" end="01:09.315">Now </span><span begin="01:09.315" end="01:09.835">I'm </span><span begin="01:09.835" end="01:10.251">next </span><span begin="01:10.251" end="01:10.843">to </span><span begin="01:10.843" end="01:11.667">you</span></p><p ttm:agent="v1" begin="01:11.786" end="01:54.103"><span begin="01:11.786" end="01:12.169">The </span><span begin="01:12.169" end="01:13.074">waves </span><span begin="01:13.074" end="01:14.321">will </span><span begin="01:14.321" end="01:14.834">take </span><span begin="01:14.834" end="01:15.386">us </span><span begin="01:15.386" end="01:16.042">far </span><span begin="01:16.042" end="01:20.017">away</span></p><p ttm:agent="v1" begin="01:54.103" end="02:01.373"><span begin="01:54.103" end="01:54.975">Oh </span><span begin="01:54.975" end="01:56.031">we </span><span begin="01:56.031" end="01:57.066">will </span><span begin="01:57.066" end="01:58.114">wither </span><span begin="01:58.114" end="02:01.373">someday</span></p><p ttm:agent="v1" begin="02:01.373" end="02:12.319"><span begin="02:01.373" end="02:01.725">It </span><span begin="02:01.725" end="02:02.293">has </span><span begin="02:02.293" end="02:02.773">no </span><span begin="02:02.773" end="02:05.789">scent </span><span begin="02:05.789" end="02:06.397">it </span><span begin="02:06.397" end="02:06.909">has </span><span begin="02:06.909" end="02:07.597">no </span><span begin="02:07.597" end="02:09.453">warmth</span></p><p ttm:agent="v1" begin="02:12.319" end="02:19.623"><span begin="02:12.319" end="02:13.503">Oh </span><span begin="02:13.503" end="02:14.583">we'll </span><span begin="02:14.583" end="02:15.487">be </span><span begin="02:15.487" end="02:16.575">forgotten </span><span begin="02:16.575" end="02:18.783">someday</span></p><p ttm:agent="v1" begin="02:19.623" end="02:25.420"><span begin="02:19.623" end="02:20.007">But </span><span begin="02:20.007" end="02:20.647">with </span><span begin="02:20.647" end="02:21.255">that </span><span begin="02:21.255" end="02:24.100">wave </span><span begin="02:24.100" end="02:24.356">it </span><span begin="02:24.356" end="02:24.756">will </span><span begin="02:24.756" end="02:25.364">be</span></p><p ttm:agent="v1" begin="02:25.420" end="02:30.712"><span begin="02:25.420" end="02:28.196">Remembered </span><span begin="02:28.196" end="02:30.420">forever</span></p><p ttm:agent="v1" begin="02:30.712" end="02:35.089"><span begin="02:30.712" end="02:32.297">When </span><span begin="02:32.297" end="02:32.760">you </span><span begin="02:32.760" end="02:33.441">spoke </span><span begin="02:33.441" end="02:33.897">to </span><span begin="02:33.897" end="02:34.777">me</span></p><p ttm:agent="v1" begin="02:35.089" end="02:40.033"><span begin="02:35.089" end="02:35.416">The </span><span begin="02:35.416" end="02:36.049">words </span><span begin="02:36.049" end="02:36.265">are </span><span begin="02:36.265" end="02:36.657">like </span><span begin="02:36.657" end="02:37.289">a </span><span begin="02:37.289" end="02:38.552">flowing </span><span begin="02:38.552" end="02:39.825">star</span></p><p ttm:agent="v1" begin="02:40.033" end="02:44.152"><span begin="02:40.033" end="02:41.664">Now </span><span begin="02:41.664" end="02:42.169">I'm </span><span begin="02:42.169" end="02:42.721">next </span><span begin="02:42.721" end="02:43.153">to </span><span begin="02:43.153" end="02:43.873">you</span></p><p ttm:agent="v1" begin="02:44.152" end="02:53.172"><span begin="02:44.152" end="02:44.536">The </span><span begin="02:44.536" end="02:45.456">waves </span><span begin="02:45.456" end="02:46.696">will </span><span begin="02:46.696" end="02:47.304">take </span><span begin="02:47.304" end="02:47.936">us </span><span begin="02:47.936" end="02:48.331">far </span><span begin="02:48.331" end="02:53.035">away</span></p></div></body></tt>