<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>light</ttm:title><ttm:agent type="person" xml:id="v1">wave to earth</ttm:agent><ttm:item type="album">light</ttm:item><ttm:item type="spotify_id">1MNHqDjKxhtn7YwLCpm7Nt</ttm:item><itunes:duration>03:45.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:27.124" end="00:37.947"><span begin="00:27.124" end="00:29.027">You </span><span begin="00:29.027" end="00:31.323">always </span><span begin="00:31.323" end="00:32.187">wanted </span><span begin="00:32.187" end="00:32.499">to </span><span begin="00:32.499" end="00:34.699">see </span><span begin="00:34.699" end="00:35.339">the </span><span begin="00:35.339" end="00:36.691">moonlight</span></p><p ttm:agent="v1" begin="00:37.947" end="00:50.631"><span begin="00:37.947" end="00:38.524">And </span><span begin="00:38.524" end="00:40.964">I </span><span begin="00:40.964" end="00:41.484">I </span><span begin="00:41.484" end="00:43.204">just </span><span begin="00:43.204" end="00:44.079">wanted </span><span begin="00:44.079" end="00:44.407">to </span><span begin="00:44.407" end="00:46.503">see </span><span begin="00:46.503" end="00:47.215">your </span><span begin="00:47.215" end="00:49.983">smile</span></p><p ttm:agent="v1" begin="00:50.631" end="01:02.213"><span begin="00:50.631" end="00:51.287">There </span><span begin="00:51.287" end="00:51.735">is </span><span begin="00:51.735" end="00:52.119">a </span><span begin="00:52.119" end="00:53.559">light </span><span begin="00:53.559" end="00:54.071">not </span><span begin="00:54.071" end="00:54.602">far </span><span begin="00:54.602" end="00:56.018">away </span><span begin="00:56.018" end="00:56.594">from </span><span begin="00:56.594" end="00:58.014">us</span></p><p ttm:agent="v1" begin="01:02.213" end="01:11.965"><span begin="01:02.213" end="01:02.621">The </span><span begin="01:02.621" end="01:04.749">light </span><span begin="01:04.749" end="01:05.446">will </span><span begin="01:05.446" end="01:07.149">shine </span><span begin="01:07.149" end="01:07.853">with </span><span begin="01:07.853" end="01:08.453">the </span><span begin="01:08.453" end="01:11.445">clouds</span></p><p ttm:agent="v1" begin="01:11.965" end="01:18.847"><span begin="01:11.965" end="01:12.317">We're </span><span begin="01:12.317" end="01:13.053">gonna </span><span begin="01:13.053" end="01:13.480">fly </span><span begin="01:13.480" end="01:13.880">up </span><span begin="01:13.880" end="01:14.207">into </span><span begin="01:14.207" end="01:14.615">the </span><span begin="01:14.615" end="01:15.927">blue </span><span begin="01:15.927" end="01:17.191">sky </span><span begin="01:17.191" end="01:17.407">so </span><span begin="01:17.407" end="01:18.847">slowly</span></p><p ttm:agent="v1" begin="01:18.847" end="01:25.865"><span begin="01:18.847" end="01:19.151">And </span><span begin="01:19.151" end="01:19.879">we </span><span begin="01:19.879" end="01:20.199">held </span><span begin="01:20.199" end="01:20.519">the </span><span begin="01:20.519" end="01:22.775">moon </span><span begin="01:22.775" end="01:23.330">in </span><span begin="01:23.330" end="01:24.153">our </span><span begin="01:24.153" end="01:25.561">arms</span></p><p ttm:agent="v1" begin="01:25.865" end="01:31.774"><span begin="01:25.865" end="01:26.513">You </span><span begin="01:26.513" end="01:28.809">always </span><span begin="01:28.809" end="01:29.377">had </span><span begin="01:29.377" end="01:31.046">me</span></p><p ttm:agent="v1" begin="01:31.774" end="01:41.790"><span begin="01:31.774" end="01:32.822">You're </span><span begin="01:32.822" end="01:34.934">always </span><span begin="01:34.934" end="01:38.414">shining</span></p><p ttm:agent="v1" begin="01:41.790" end="01:53.550"><span begin="01:41.790" end="01:44.494">I've </span><span begin="01:44.494" end="01:46.006">seen </span><span begin="01:46.006" end="01:46.222">a </span><span begin="01:46.222" end="01:47.398">wonderful </span><span begin="01:47.398" end="01:50.190">sight </span><span begin="01:50.190" end="01:50.398">with </span><span begin="01:50.398" end="01:50.710">a </span><span begin="01:50.710" end="01:51.070">bright </span><span begin="01:51.070" end="01:52.598">glow</span></p><p ttm:agent="v1" begin="01:53.550" end="01:59.333"><span begin="01:53.550" end="01:54.110">You </span><span begin="01:54.110" end="01:54.542">are </span><span begin="01:54.542" end="01:54.966">my </span><span begin="01:54.966" end="01:56.566">sea </span><span begin="01:56.566" end="01:57.022">you </span><span begin="01:57.022" end="01:57.518">are </span><span begin="01:57.518" end="01:57.886">my </span><span begin="01:57.886" end="01:59.333">sunshine</span></p><p ttm:agent="v1" begin="01:59.333" end="02:05.676"><span begin="01:59.333" end="01:59.613">The </span><span begin="01:59.613" end="02:02.157">star </span><span begin="02:02.157" end="02:02.534">the </span><span begin="02:02.534" end="02:04.044">moon</span></p><p ttm:agent="v1" begin="02:05.676" end="02:17.234"><span begin="02:05.676" end="02:06.172">There </span><span begin="02:06.172" end="02:06.492">is </span><span begin="02:06.492" end="02:06.948">a </span><span begin="02:06.948" end="02:08.502">light </span><span begin="02:08.502" end="02:09.037">not </span><span begin="02:09.037" end="02:09.605">far </span><span begin="02:09.605" end="02:10.956">away </span><span begin="02:10.956" end="02:11.380">from </span><span begin="02:11.380" end="02:13.130">us</span></p><p ttm:agent="v1" begin="02:17.234" end="02:27.123"><span begin="02:17.234" end="02:17.626">The </span><span begin="02:17.626" end="02:19.754">light </span><span begin="02:19.754" end="02:20.474">will </span><span begin="02:20.474" end="02:22.066">shine </span><span begin="02:22.066" end="02:22.914">with </span><span begin="02:22.914" end="02:23.514">the </span><span begin="02:23.514" end="02:27.027">clouds</span></p><p ttm:agent="v1" begin="02:27.123" end="02:33.855"><span begin="02:27.123" end="02:27.410">We're </span><span begin="02:27.410" end="02:28.034">gonna </span><span begin="02:28.034" end="02:28.481">fly </span><span begin="02:28.481" end="02:28.873">up </span><span begin="02:28.873" end="02:29.345">into </span><span begin="02:29.345" end="02:29.601">the </span><span begin="02:29.601" end="02:30.945">blue </span><span begin="02:30.945" end="02:32.153">sky </span><span begin="02:32.153" end="02:32.481">so </span><span begin="02:32.481" end="02:33.855">slowly</span></p><p ttm:agent="v1" begin="02:33.855" end="02:40.775"><span begin="02:33.855" end="02:34.167">And </span><span begin="02:34.167" end="02:34.695">we </span><span begin="02:34.695" end="02:35.015">held </span><span begin="02:35.015" end="02:35.479">the </span><span begin="02:35.479" end="02:37.759">moon </span><span begin="02:37.759" end="02:38.333">in </span><span begin="02:38.333" end="02:38.838">our </span><span begin="02:38.838" end="02:40.414">arms</span></p><p ttm:agent="v1" begin="02:40.775" end="02:46.791"><span begin="02:40.775" end="02:41.399">You </span><span begin="02:41.399" end="02:43.879">always </span><span begin="02:43.879" end="02:44.455">had </span><span begin="02:44.455" end="02:46.095">me</span></p><p ttm:agent="v1" begin="02:46.791" end="02:53.015"><span begin="02:46.791" end="02:47.647">You're </span><span begin="02:47.647" end="02:49.799">always </span><span begin="02:49.799" end="02:52.807">shining</span></p></div></body></tt>