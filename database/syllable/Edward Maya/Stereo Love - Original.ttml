        <span begin="02:57.310" end="02:58.360">dream </span>
        <span begin="02:58.360" end="02:58.660">is </span>
        <span begin="02:58.660" end="02:59.110">about </span>
        <span begin="02:59.110" end="02:59.320">you </span>
        <span begin="02:59.320" end="02:59.560">and </span>
        <span begin="02:59.560" end="03:01.000">I</span>
      </p>
    </div>
  </body>
</tt>
