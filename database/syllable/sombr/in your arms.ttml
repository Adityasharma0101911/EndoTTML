9.680" end="00:19.690">I'll</span><span begin="00:20.220" end="00:20.250"> hold</span><span begin="00:20.610" end="00:20.620"> my</span><span begin="00:20.880" end="00:21.830"> breath</span><span begin="00:22.530" end="00:22.550"> and</span><span begin="00:22.740" end="00:22.820"> count</span><span begin="00:23.680" end="00:23.750"> to</span><span begin="00:24.610" end="00:25.810"> ten</span></p><p ttm:agent="v1" begin="00:25.810" end="00:31.570"><span begin="00:25.810" end="00:25.840">When</span><span begin="00:26.310" end="00:26.340"> you're</span><span begin="00:26.590" end="00:26.640"> out</span><span begin="00:27.280" end="00:27.310"> of</span><span begin="00:27.620" end="00:28.190"> my</span><span begin="00:28.280" end="00:28.360"> system,</span><span begin="00:29.460" end="00:29.480"> it's</span><span begin="00:29.710" end="00:29.740"> hard</span><span begin="00:30.160" end="00:30.170"> to</span><span begin="00:30.400" end="00:31.570"> breathe</span></p><p ttm:agent="v1" begin="00:31.570" end="00:34.200" itunes:key="role" itunes:value="background"><span begin="00:31.570" end="00:31.590">(It's</span><span begin="00:31.620" end="00:31.670"> hard</span><span begin="00:32.070" end="00:32.140"> to</span><span begin="00:32.210" end="00:33.710"> breathe)</span></p><p ttm:agent="v1" begin="00:34.200" end="00:42.050"><span begin="00:34.200" end="00:34.210">If</span><span begin="00:34.380" end="00:34.390"> your</span><span begin="00:34.670" end="00:34.720"> love</span><span begin="00:35.330" end="00:35.370"> was</span><span begin="00:35.870" end="00:35.880"> a</span><span begin="00:35.910" end="00:35.970"> pill,</span><span begin="00:36.720" end="00:36.750"> I'd</span><span begin="00:37.220" end="00:37.460"> overdose</span><span begin="00:38.780" end="00:38.860"> (I'd</span><span begin="00:41.830" end="00:42.330"> overdose)</span></p><p ttm:agent="v1" begin="00:42.050" end="00:49.540"><span begin="00:42.050" end="00:42.090">Wrap</span><span begin="00:42.590" end="00:42.630"> me</span><span begin="00:43.050" end="00:43.070"> in</span><span begin="00:43.460" end="00:43.480"> your</span><span begin="00:43.790" end="00:43.840"> arms</span><span begin="00:44.420" end="00:44.450"> 'til</span><span begin="00:44.720" end="00:44.740"> my</span><span begin="00:45.050" end="00:45.260"> heartbeat</span><span begin="00:45.930" end="00:47.430"> slows</span></p><p ttm:agent="v1" begin="00:49.540" end="00:56.750"><span begin="00:49.540" end="00:49.540">If</span><span begin="00:49.660" end="00:49.680"> your</span><span begin="00:49.980" end="00:50.030"> love</span><span begin="00:50.610" end="00:50.620"> was</span><span begin="00:51.350" end="00:51.350"> a</span><span begin="00:51.930" end="00:52.030"> cig',</span><span begin="00:52.060" end="00:52.090"> I'd</span><span begin="00:52.370" end="00:52.550"> smoke</span><span begin="00:52.910" end="00:52.940"> my</span><span begin="00:53.000" end="00:53.030"> lungs</span><span begin="00:53.140" end="00:53.160"> (I'd</span><span begin="00:53.200" end="00:53.230"> smoke</span><span begin="00:54.110" end="00:54.170"> my</span><span begin="00:56.690" end="00:57.190"> lungs)</span></p><p ttm:agent="v1" begin="00:56.750" end="01:04.750"><span begin="00:56.750" end="00:56.780">Every</span><span begin="00:57.170" end="00:57.210"> time</span><span begin="00:57.790" end="00:57.820"> I</span><span begin="00:58.070" end="00:58.110"> think</span><span begin="00:58.720" end="00:58.740"> I'm</span><span begin="00:58.930" end="00:58.970"> done,</span><span begin="00:59.440" end="00:59.450"> I</span><span begin="00:59.590" end="00:59.610"> need</span><span begin="00:59.920" end="00:59.970"> another</span><span begin="01:00.920" end="01:02.070"> one</span><span begin="01:04.720" end="01:04.740"> (I</span><span begin="01:04.820" end="01:04.840"> need</span><span begin="01:04.930" end="01:04.970"> another</span><span begin="01:05.110" end="01:05.610"> one)</span></p><p ttm:agent="v1" begin="01:05.270" end="01:11.560"><s