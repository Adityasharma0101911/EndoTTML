<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Love Is Only a Feeling</ttm:title><ttm:agent type="person" xml:id="v1">The Darkness</ttm:agent><ttm:item type="album">Permission to Land</ttm:item><ttm:item type="spotify_id">1Xiziz94CF3sFctb1udhAm</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:32.110" end="00:36.070"><span begin="00:32.110" end="00:32.260">The </span><span begin="00:32.260" end="00:32.710">first </span><span begin="00:32.710" end="00:32.980">flush </span><span begin="00:32.980" end="00:33.100">of </span><span begin="00:33.100" end="00:33.550">youth </span><span begin="00:33.550" end="00:33.730">was </span><span begin="00:33.730" end="00:34.120">upon </span><span begin="00:34.120" end="00:34.270">you </span><span begin="00:34.270" end="00:34.510">when </span><span begin="00:34.510" end="00:34.750">our </span><span begin="00:34.750" end="00:35.020">eyes </span><span begin="00:35.020" end="00:35.380">first </span><span begin="00:35.380" end="00:36.070">met</span></p><p ttm:agent="v1" begin="00:37.960" end="00:42.130"><span begin="00:37.960" end="00:38.320">And </span><span begin="00:38.320" end="00:38.380">I </span><span begin="00:38.380" end="00:38.800">knew </span><span begin="00:38.800" end="00:38.950">that </span><span begin="00:38.950" end="00:39.130">to </span><span begin="00:39.130" end="00:39.610">you </span><span begin="00:39.610" end="00:39.790">and </span><span begin="00:39.790" end="00:40.150">into </span><span begin="00:40.150" end="00:40.300">your </span><span begin="00:40.300" end="00:40.570">life </span><span begin="00:40.570" end="00:40.660">I </span><span begin="00:40.660" end="00:41.020">had </span><span begin="00:41.020" end="00:41.350">to </span><span begin="00:41.350" end="00:42.130">get</span></p><p ttm:agent="v1" begin="00:44.290" end="00:48.400"><span begin="00:44.290" end="00:44.380">I </span><span begin="00:44.380" end="00:44.890">felt </span><span begin="00:44.890" end="00:45.190">light</span><span begin="00:45.190" end="00:45.220">-</span><span begin="00:45.220" end="00:45.730">headed </span><span begin="00:45.730" end="00:45.820">at </span><span begin="00:45.820" end="00:45.940">the </span><span begin="00:45.940" end="00:46.480">touch </span><span begin="00:46.480" end="00:46.570">of </span><span begin="00:46.570" end="00:46.720">this </span><span begin="00:46.720" end="00:47.440">stranger's </span><span begin="00:47.440" end="00:48.400">hand</span></p><p ttm:agent="v1" begin="00:50.110" end="00:55.420"><span begin="00:50.110" end="00:50.440">An </span><span begin="00:50.440" end="00:50.980">assault </span><span begin="00:50.980" end="00:51.160">my </span><span begin="00:51.160" end="00:51.670">defences </span><span begin="00:51.670" end="00:52.780">systematically </span><span begin="00:52.780" end="00:53.200">failed </span><span begin="00:53.200" end="00:53.410">to </span><span begin="00:53.410" end="00:55.420">withstand</span></p><p ttm:agent="v1" begin="00:55.420" end="00:57.640"><span begin="00:55.420" end="00:55.720">'Cos </span><span begin="00:55.720" end="00:55.840">you </span><span begin="00:55.840" end="00:56.320">came </span><span begin="00:56.320" end="00:56.500">at </span><span begin="00:56.500" end="00:56.560">a </span><span begin="00:56.560" end="00:57.640">time</span></p><p ttm:agent="v1" begin="00:57.640" end="01:03.160"><span begin="00:57.640" end="00:57.820">When </span><span begin="00:57.820" end="00:57.940">the </span><span begin="00:57.940" end="00:58.600">pursuit </span><span begin="00:58.600" end="00:58.870">of </span><span begin="00:58.870" end="00:59.260">one </span><span begin="00:59.260" end="00:59.680">true </span><span begin="00:59.680" end="01:00.640">love </span><span begin="01:00.640" end="01:00.820">in </span><span begin="01:00.820" end="01:01.030">which </span><span begin="01:01.030" end="01:01.180">to </span><span begin="01:01.180" end="01:03.160">fall</span></p><p ttm:agent="v1" begin="01:03.550" end="01:06.520"><span begin="01:03.550" end="01:04.090">Was </span><span begin="01:04.090" end="01:04.210">the </span><span begin="01:04.210" end="01:04.660">be </span><span begin="01:04.660" end="01:05.080">all </span><span begin="01:05.080" end="01:05.440">and </span><span begin="01:05.440" end="01:05.830">end </span><span begin="01:05.830" end="01:06.520">all</span></p><p ttm:agent="v1" begin="01:06.520" end="01:10.240"><span begin="01:06.520" end="01:06.850">Love </span><span begin="01:06.850" end="01:07.180">is </span><span begin="01:07.180" end="01:08.350">only </span><span begin="01:08.350" end="01:08.500">a </span><span begin="01:08.500" end="01:10.240">feeling</span></p><p ttm:agent="v1" begin="01:10.240" end="01:12.160"><span begin="01:10.240" end="01:10.240">（</span><span begin="01:10.240" end="01:11.110">Drifting </span><span begin="01:11.110" end="01:12.130">away</span><span begin="01:12.130" end="01:12.160">）</span></p><p ttm:agent="v1" begin="01:12.160" end="01:16.450"><span begin="01:12.160" end="01:12.880">When </span><span begin="01:12.880" end="01:13.090">I'm </span><span begin="01:13.090" end="01:13.240">in </span><span begin="01:13.240" end="01:13.420">your </span><span begin="01:13.420" end="01:13.840">arms </span><span begin="01:13.840" end="01:13.990">I </span><span begin="01:13.990" end="01:14.470">start </span><span begin="01:14.470" end="01:16.450">believing</span