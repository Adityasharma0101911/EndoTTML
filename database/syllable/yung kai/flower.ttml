<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>flower</ttm:title><ttm:agent type="person" xml:id="v1">yung kai</ttm:agent><ttm:item type="album">flower</ttm:item><ttm:item type="spotify_id">7aCwy7gBrR3dOeBv0zGKlF</ttm:item><itunes:duration>02:28.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:01.201" end="00:07.911"><span begin="00:01.201" end="00:02.569">Hold </span><span begin="00:02.569" end="00:02.873">my </span><span begin="00:02.873" end="00:03.985">heart </span><span begin="00:04.553" end="00:04.719">in </span><span begin="00:04.719" end="00:04.935">your </span><span begin="00:04.935" end="00:06.367">hands </span><span begin="00:06.367" end="00:06.759">a </span><span begin="00:06.759" end="00:07.911">flower</span></p><p ttm:agent="v1" begin="00:08.559" end="00:12.002"><span begin="00:08.559" end="00:08.807">Like </span><span begin="00:08.807" end="00:09.071">you </span><span begin="00:09.071" end="00:10.495">loved </span><span begin="00:10.495" end="00:10.799">me </span><span begin="00:10.799" end="00:12.002">then</span></p><p ttm:agent="v1" begin="00:13.337" end="00:16.801"><span begin="00:13.337" end="00:13.729">How </span><span begin="00:13.729" end="00:14.010">did </span><span begin="00:14.010" end="00:14.601">it </span><span begin="00:14.601" end="00:16.801">wither?</span></p><p ttm:agent="v1" begin="00:17.337" end="00:20.225"><span begin="00:17.337" end="00:18.801">Sea </span><span begin="00:18.801" end="00:19.057">to </span><span begin="00:19.057" end="00:20.225">cloud</span></p><p ttm:agent="v1" begin="00:20.713" end="00:27.197"><span begin="00:20.713" end="00:20.993">In </span><span begin="00:20.993" end="00:21.218">my </span><span begin="00:21.218" end="00:22.818">eyes </span><span begin="00:22.818" end="00:23.177">you </span><span begin="00:23.177" end="00:24.841">are </span><span begin="00:24.841" end="00:25.274">the </span><span begin="00:25.274" end="00:27.197">ocean</span></p><p ttm:agent="v1" begin="00:27.197" end="00:32.367"><span begin="00:27.197" end="00:28.669">I'll </span><span begin="00:28.669" end="00:28.933">be </span><span begin="00:28.933" end="00:29.317">the </span><span begin="00:29.317" end="00:30.077">stars </span><span begin="00:30.077" end="00:30.941">over </span><span begin="00:30.941" end="00:32.367">you</span></p><p ttm:agent="v1" begin="00:35.367" end="00:38.622"><span begin="00:35.367" end="00:35.623">I'll </span><span begin="00:35.623" end="00:36.151">watch </span><span begin="00:36.151" end="00:36.351">your </span><span begin="00:36.351" end="00:37.407">flowers </span><span begin="00:37.407" end="00:38.622">dry</span></p><p ttm:agent="v1" begin="00:39.974" end="00:43.206"><span begin="00:39.974" end="00:40.206">I'll </span><span begin="00:40.206" end="00:40.638">find </span><span begin="00:40.638" end="00:41.110">a </span><span begin="00:41.110" end="00:42.158">face </span><span begin="00:42.158" end="00:42.606">for </span><span begin="00:42.606" end="00:43.206">it</span></p><p ttm:agent="v1" begin="00:44.494" end="00:48.510"><span begin="00:44.494" end="00:44.718">Though </span><span begin="00:44.718" end="00:45.359">they're </span><span begin="00:45.359" end="00:47.158">already </span><span begin="00:47.158" end="00:48.510">gone</span></p><p ttm:agent="v1" begin="00:49.670" end="00:59.383"><span begin="00:49.670" end="00:49.894">It's </span><span begin="00:49.894" end="00:51.007">filled </span><span begin="00:52.583" end="00:52.831">with </span><span begin="00:52.831" end="00:53.319">all </span><span begin="00:53.319" end="00:53.695">the </span><span begin="00:53.695" end="00:55.991">tears </span><span begin="00:56.719" end="00:56.991">I </span><span begin="00:56.991" end="00:57.391">left </span><span begin="00:57.391" end="00:58.311">for </span><span begin="00:58.311" end="00:59.383">you</span></p><p ttm:agent="v1" begin="01:01.231" end="01:05.141"><span begin="01:01.231" end="01:01.503">And </span><span begin="01:01.503" end="01:01.991">I </span><span begin="01:01.991" end="01:02.975">hope </span><span begin="01:02.975" end="01:03.462">they'll </span><span begin="01:03.462" end="01:03.869">come </span><span begin="01:03.869" end="01:05.141">back</span></p><p ttm:agent="v1" begin="01:06.078" end="01:13.070"><span begin="01:06.078" end="01:07.517">Hold </span><span begin="01:07.517" end="01:07.853">my </span><span begin="01:07.853" end="01:08.973">heart </span><span begin="01:09.541" end="01:09.829">in </span><span begin="01:09.829" end="01:10.117">your </span><span begin="01:10.117" end="01:11.534">hands </span><span begin="01:11.534" end="01:11.886">a </span><span begin="01:11.886" end="01:13.070">flower</span></p><p ttm:agent="v1" begin="01:13.701" end="01:17.037"><span begin="01:13.701" end="01:13.950">Like </span><span begin="01:13.950" end="01:14.229">you </span><span begin="01:14.229" end="01:15.613">loved </span><span begin="01:15.613" end="01:15.957">me </span><span begin="01:15.957" end="01:17.037">then</span></p><p ttm:agent="v1" begin="01:18.013" end="01:21.845"><span begin="01:18.013" end="01:18.549">How </span><span begin="01:18.549" end="01:19.029">did </span><span begin="01:19.029" end="01:19.557">it </span><span begin="01:19.557" end="01:21.845">wither?</span></p><p ttm:agent="v1" begin="01:22.253" end="01:25.237"><span begin="01:22.253" end="01:23.797">Sea </span><span begin="01:23.797" end="01:24.085">to </span><span begin="01:24.085" end="01:25.237">cloud</span></p><p ttm:agent="v1" begin="01:25.885" end="01:32.237"><span begin="01:25.885" end="01:26.085">In </span><span begin="01:26.085" end="01:26.374">my </span><span begin="01:26.374" end="01:27.901">eyes </span><span begin="01:27.901" end="01:28.253">you </span><span begin="01:28.253" end="01:29.885">are </span><span begin="01:29.885" end="01:30.125">the </span><span begin="01:30.125" end="01:32.237">ocean</span></p><p ttm:agent="v1" begin="01:32.237" end="01:37.661"><span begin="01:32.237" end="01:33.693">I'll </span><span begin="01:33.693" end="01:33.973">be </span><span begin="01:33.973" end="01:34.333">the </span><span begin="01:34.333" end="01:35.150">stars </span><span begin="01:35.150" end="01:36.029">over </span><span begin="01:36.029" end="01:37.661">you</span></p></div></body></tt>