<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>BOY OF THE YEAR</ttm:title><ttm:agent type="person" xml:id="v1">Warren Hue</ttm:agent><ttm:item type="album">BOY OF THE YEAR</ttm:item><ttm:item type="spotify_id">5elqEKVSqcGkAxI86tvS7W</ttm:item><itunes:duration>03:32.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.666" end="00:06.090"><span begin="00:00.666" end="00:01.022">I </span><span begin="00:01.022" end="00:03.354">know </span><span begin="00:03.355" end="00:03.899">it's </span><span begin="00:03.900" end="00:06.090">strange</span></p><p ttm:agent="v1" begin="00:06.756" end="00:11.709"><span begin="00:06.756" end="00:07.001">I </span><span begin="00:07.002" end="00:07.290">left </span><span begin="00:07.290" end="00:07.691">you </span><span begin="00:07.692" end="00:08.082">when </span><span begin="00:08.082" end="00:08.546">I </span><span begin="00:08.547" end="00:09.283">promised </span><span begin="00:09.284" end="00:09.654">to </span><span begin="00:09.654" end="00:11.709">stay</span></p><p ttm:agent="v1" begin="00:13.091" end="00:23.941"><span begin="00:13.091" end="00:13.419">When </span><span begin="00:13.419" end="00:14.102">you </span><span begin="00:14.103" end="00:14.700">see </span><span begin="00:14.700" end="00:15.551">me </span><span begin="00:15.552" end="00:16.055">on </span><span begin="00:16.056" end="00:16.957">stage </span><span begin="00:16.957" end="00:17.482">just </span><span begin="00:17.482" end="00:17.969">know </span><span begin="00:18.612" end="00:19.011">I'm </span><span begin="00:19.012" end="00:19.734">searching </span><span begin="00:19.734" end="00:20.125">the </span><span begin="00:20.125" end="00:21.030">crowds </span><span begin="00:21.031" end="00:21.697">for </span><span begin="00:21.698" end="00:23.941">you</span></p><p ttm:agent="v1" begin="00:24.566" end="00:29.631"><span begin="00:24.566" end="00:25.039">I </span><span begin="00:25.040" end="00:26.458">know </span><span begin="00:27.205" end="00:27.988">it's </span><span begin="00:27.989" end="00:29.631">strange</span></p><p ttm:agent="v1" begin="00:30.604" end="00:36.030"><span begin="00:30.604" end="00:30.989">The </span><span begin="00:30.990" end="00:31.785">cupid </span><span begin="00:31.785" end="00:32.306">arrow </span><span begin="00:32.306" end="00:32.987">ain't </span><span begin="00:32.987" end="00:33.314">got </span><span begin="00:33.315" end="00:33.595">the </span><span begin="00:33.595" end="00:36.030">range</span></p><p ttm:agent="v1" begin="00:36.984" end="00:40.658"><span begin="00:36.984" end="00:37.498">When </span><span begin="00:37.498" end="00:38.285">you </span><span begin="00:38.286" end="00:38.895">see </span><span begin="00:38.895" end="00:39.750">me </span><span begin="00:39.751" end="00:40.264">with </span><span begin="00:40.264" end="00:40.657">her</span></p><p ttm:agent="v1" begin="00:40.960" end="00:47.559"><span begin="00:40.960" end="00:41.457">Just </span><span begin="00:41.457" end="00:42.492">know </span><span begin="00:42.492" end="00:42.963">that </span><span begin="00:42.964" end="00:43.398">she </span><span begin="00:43.398" end="00:44.098">doesn't </span><span begin="00:44.099" end="00:45.013">love </span><span begin="00:45.013" end="00:45.749">me </span><span begin="00:45.749" end="00:47.558">too</span></p><p ttm:agent="v1" begin="00:48.963" end="00:53.678"><span begin="00:48.963" end="00:49.200">Look </span><span begin="00:49.200" end="00:49.564">out </span><span begin="00:49.565" end="00:49.906">to </span><span begin="00:49.907" end="00:51.200">hills </span><span begin="00:51.200" end="00:53.678">everyday</span></p><p ttm:agent="v1" begin="00:54.796" end="00:59.674"><span begin="00:54.796" end="00:55.063">The </span><span begin="00:55.063" end="00:55.437">sun </span><span begin="00:55.438" end="00:56.126">doesn't </span><span begin="00:56.127" end="00:56.958">rise </span><span begin="00:56.958" end="00:57.299">the </span><span begin="00:57.300" end="00:57.794">same </span><span begin="00:57.794" end="00:59.674">way</span></p><p ttm:agent="v1" begin="01:00.777" end="01:04.462"><span begin="01:00.777" end="01:01.886">Shotgun </span><span begin="01:01.886" end="01:02.284">in </span><span begin="01:02.284" end="01:02.682">my </span><span begin="01:02.683" end="01:04.462">458</span></p><p ttm:agent="v1" begin="01:04.899" end="01:06.282"><span begin="01:04.899" end="01:05.224">Would </span><span begin="01:05.224" end="01:06.282">you</span></p><p ttm:agent="v1" begin="01:06.999" end="01:11.057"><span begin="01:06.999" end="01:07.475">Fill </span><span begin="01:07.475" end="01:07.902">this </span><span begin="01:07.903" end="01:08.575">empty </span><span begin="01:08.576" end="01:11.057">seat</span></p><p ttm:agent="v1" begin="01:12.011" end="01:14.320"><span begin="01:12.011" end="01:12.343">And </span><span begin="01:12.343" end="01:12.984">I </span><span begin="01:12.985" end="01:14.320">know</span></p><p ttm:agent="v1" begin="01:15.082" end="01:18.160"><span begin="01:15.082" end="01:15.368">It's </span><span begin="01:15.369" end="01:15.930">already </span><span begin="01:15.930" end="01:16.682">dark </span><span begin="01:16.683" end="01:17.196">outside </span><span begin="01:17.196" end="01:17.472">where </span><span begin="01:17.473" end="01:17.790">I'm </span><span begin="01:17.790" end="01:18.160">from</span></p><p ttm:agent="v1" begin="01:18.597" end="01:24.491"><span begin="01:18.597" end="01:18.850">I </span><span begin="01:18.850" end="01:19.097">can't </span><span begin="01:19.097" end="01:19.575">cry </span><span begin="01:20.029" end="01:20.256">I </span><span begin="01:20.256" end="01:20.568">can't </span><span begin="01:20.568" end="01:21.230">cry </span><span begin="01:21.231" end="01:21.590">I </span><span begin="01:21.591" end="01:21.997">can't </span><span begin="01:21.997" end="01:24.491">lie</span></p><p ttm:agent="v1" begin="01:24.947" end="01:30.304"><span begin="01:24.947" end="01:25.436">I'm </span><span begin="01:25.436" end="01:26.094">thinking </span><span begin="01:26.095" end="01:27.636">maybe </span><span begin="01:27.636" end="01:28.077">this </span><span begin="01:28.077" end="01:28.455">life </span><span begin="01:28.455" end="01:28.812">ain't </span><span begin="01:28.813" end="01:29.253">meant </span><span begin="01:29.253" end="01:29.619">for </span><span begin="01:29.620" end="01:30.304">me</span></p><p ttm:agent="v1" begin="01:30.806" end="01:35.757"><span begin="01:30.806" end="01:31.078">Can </span><span begin="01:31.079" end="01:31.374">I </span><span begin="01:31.374" end="01:31.832">fly </span><span begin="01:31.833" end="01:32.163">back </span><span begin="01:32.164" end="01:33.342">home </span><span begin="01:33.342" end="01:33.713">to </span><span begin="01:33.714" end="01:35.758">you</span></p><p ttm:agent="v1" begin="01:36.708" end="01:39.982"><span begin="01:36.708" end="01:37.288">Cause </span><span begin="01:37.288" end="01:37.560">life </span><span begin="01:37.561" end="01:37.817">ain't </span><span begin="01:37.818" end="01:38.213">worth </span><span begin="01:38.213" end="01:38.474">it </span><span begin="01:38.474" end="01:38.796">if </span><span begin="01:38.797" end="01:39.175">you </span><span begin="01:39.175" end="01:39.642">ain't </span><span begin="01:39.642" end="01:39.982">involved</span></p><p ttm:agent="v1" begin="01:40.242" end="01:41.803"><span begin="01:40.242" end="01:40.501">Trust </span><span begin="01:40.501" end="01:40.721">I'll </span><span begin="01:40.721" end="01:41.161">wait </span><span begin="01:41.161" end="01:41.486">till </span><span begin="01:41.487" end="01:41.803">dawn</span></p><p ttm:agent="v1" begin="01:42.024" end="01:45.319"><span begin="01:42.024" end="01:42.303">Till </span><span begin="01:42.304" end="01:42.682">dawn </span><span begin="01:42.682" end="01:42.909">but </span><span begin="01:42.910" end="01:43.075">the </span><span begin="01:43.075" end="01:43.294">sun </span><span begin="01:43.295" end="01:43.491">just </span><span begin="01:43.491" end="01:43.954">set </span><span begin="01:44.220" end="01:44.393">and </span><span begin="01:44.394" end="01:44.618">I'm </span><span begin="01:44.618" end="01:44.798">the </span><span begin="01:44.799" end="01:45.319">shade</span></p><p ttm:agent="v1" begin="01:45.770" end="01:46.811"><span begin="01:45.770" end="01:45.889">Won't </span><span begin="01:45.889" end="01:46.099">you </span><span begin="01:46.100" end="01:46.277">call </span><span begin="01:46.278" end="01:46.486">my </span><span begin="01:46.486" end="01:46.811">name</span></p><p ttm:agent="v1" begin="01:47.110" end="01:48.986"><span begin="01:47.110" end="01:47.334">Like </span><span begin="01:47.335" end="01:47.572">you </span><span begin="01:47.573" end="01:47.803">did </span><span begin="01:47.803" end="01:48.986">before</span></p><p ttm:agent="v1" begin="01:49.314" end="01:54.226"><span begin="01:49.314" end="01:49.542">I'm </span><span begin="01:49.542" end="01:49.747">sick </span><span begin="01:49.748" end="01:50.080">of </span><span begin="01:50.081" end="01:51.372">waiting </span><span begin="01:51.628" end="01:51.806">on </span><span begin="01:51.806" end="01:52.015">the </span><span begin="01:52.016" end="01:52.437">day </span><span begin="01:52.437" end="01:52.716">that </span><span begin="01:52.717" end="01:53.104">I </span><span begin="01:53.104" end="01:54.225">escape</span></p><p ttm:agent="v1" begin="01:54.840" end="01:59.728"><span begin="01:54.840" end="01:55.491">Escape </span><span begin="01:55.492" end="01:55.738">from </span><span begin="01:55.738" end="01:56.009">the </span><span begin="01:56.009" end="01:57.309">hills </span><span begin="01:57.310" end="01:57.620">to </span><span begin="01:57.620" end="01:59.728">you</span></p><p ttm:agent="v1" begin="02:00.995" end="02:05.757"><span begin="02:00.995" end="02:01.170">Look </span><span begin="02:01.170" end="02:01.922">out </span><span begin="02:01.923" end="02:02.190">to </span><span begin="02:02.190" end="02:03.180">hills </span><span begin="02:03.180" end="02:05.757">everyday</span></p><p ttm:agent="v1" begin="02:06.638" end="02:11.631"><span begin="02:06.638" end="02:06.923">The </span><span begin="02:06.924" end="02:07.353">sun </span><span begin="02:07.353" end="02:08.032">doesn't </span><span begin="02:08.032" end="02:08.909">rise </span><span begin="02:08.910" end="02:09.222">the </span><span begin="02:09.223" end="02:09.686">same </span><span begin="02:09.687" end="02:11.631">way</span></p><p ttm:agent="v1" begin="02:12.903" end="02:16.546"><span begin="02:12.903" end="02:13.719">Shotgun </span><span begin="02:13.719" end="02:14.055">in </span><span begin="02:14.055" end="02:14.519">my </span><span begin="02:14.520" end="02:16.546">458</span></p><p ttm:agent="v1" begin="02:16.848" end="02:23.572"><span begin="02:16.848" end="02:17.147">Would </span><span begin="02:17.147" end="02:18.346">you </span><span begin="02:19.138" end="02:19.437">fill </span><span begin="02:19.437" end="02:19.776">this </span><span begin="02:19.776" end="02:20.668">empty </span><span begin="02:20.669" end="02:23.572">seat</span></p><p ttm:agent="v1" begin="02:31.092" end="02:36.095"><span begin="02:31.092" end="02:31.278">Look </span><span begin="02:31.278" end="02:31.547">out </span><span begin="02:31.548" end="02:31.823">t