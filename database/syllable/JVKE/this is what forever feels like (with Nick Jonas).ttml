<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>this is what forever feels like (with Nick Jonas)</ttm:title><ttm:agent type="person" xml:id="v1">JVKE</ttm:agent><ttm:agent type="person" xml:id="v2">Nick Jonas</ttm:agent><ttm:item type="album">this is what forever feels like</ttm:item><ttm:item type="spotify_id">3uTsiaNxy6h6EAd7MsCf9D</ttm:item><itunes:duration>02:34.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.000" end="00:00.758"><span begin="00:00.000" end="00:00.084">this </span><span begin="00:00.084" end="00:00.168">is </span><span begin="00:00.169" end="00:00.253">what </span><span begin="00:00.253" end="00:00.337">forever </span><span begin="00:00.337" end="00:00.421">feels </span><span begin="00:00.422" end="00:00.506">like - </span><span begin="00:00.506" end="00:00.590">JVKE/</span><span begin="00:00.590" end="00:00.674">Nick </span><span begin="00:00.675" end="00:00.759">Jonas</span></p><p ttm:agent="v1" begin="00:00.759" end="00:02.276"><span begin="00:00.759" end="00:00.867">Lyrics </span><span begin="00:00.867" end="00:00.975">by：</span><span begin="00:00.976" end="00:01.084">Zac </span><span begin="00:01.084" end="00:01.192">Lawson/</span><span begin="00:01.193" end="00:01.301">Nick </span><span begin="00:01.301" end="00:01.409">Jonas/</span><span begin="00:01.410" end="00:01.518">Jake </span><span begin="00:01.518" end="00:01.626">Lawson/</span><span begin="00:01.627" end="00:01.735">Andrew </span><span begin="00:01.735" end="00:01.843">Fortier/</span><span begin="00:01.843" end="00:01.951">Kevin </span><span begin="00:01.952" end="00:02.060">Jonas/</span><span begin="00:02.060" end="00:02.168">Joe </span><span begin="00:02.169" end="00:02.277">Jonas</span></p><p ttm:agent="v1" begin="00:02.277" end="00:03.794"><span begin="00:02.277" end="00:02.385">Composed </span><span begin="00:02.386" end="00:02.494">by：</span><span begin="00:02.494" end="00:02.602">Zac </span><span begin="00:02.602" end="00:02.710">Lawson/</span><span begin="00:02.711" end="00:02.819">Nick </span><span begin="00:02.819" end="00:02.927">Jonas/</span><span begin="00:02.928" end="00:03.036">Jake </span><span begin="00:03.036" end="00:03.144">Lawson/</span><span begin="00:03.145" end="00:03.253">Andrew </span><span begin="00:03.253" end="00:03.361">Fortier/</span><span begin="00:03.362" end="00:03.470">Kevin </span><span begin="00:03.470" end="00:03.578">Jonas/</span><span begin="00:03.578" end="00:03.686">Joe </span><span begin="00:03.687" end="00:03.795">Jonas</span></p><p ttm:agent="v1" begin="00:03.795" end="00:04.187"><span begin="00:03.795" end="00:03.903">Produced </span><span begin="00:03.904" end="00:04.012">by：</span><span begin="00:04.012" end="00:04.100">JVKE/</span><span begin="00:04.100" end="00:04.187">ZVC</span></p><p ttm:agent="v1" begin="00:04.188" end="00:08.589"><span begin="00:04.188" end="00:05.460">Seventeen </span><span begin="00:06.380" end="00:06.532">I </span><span begin="00:06.532" end="00:06.652">had </span><span begin="00:06.652" end="00:06.796">my </span><span begin="00:06.796" end="00:07.036">first </span><span begin="00:07.036" end="00:07.724">heartbreak </span><span begin="00:07.724" end="00:07.884">and </span><span begin="00:07.884" end="00:08.036">it </span><span begin="00:08.036" end="00:08.187">was </span><span begin="00:08.187" end="00:08.589">terrible</span></p><p ttm:agent="v1" begin="00:08.804" end="00:12.573"><span begin="00:08.804" end="00:08.956">And </span><span begin="00:08.956" end="00:09.093">I </span><span begin="00:09.093" end="00:09.260">pray </span><span begin="00:09.260" end="00:09.412">that </span><span begin="00:09.412" end="00:09.548">it </span><span begin="00:09.548" end="00:09.836">won't </span><span begin="00:09.836" end="00:10.237">happen </span><span begin="00:10.237" end="00:10.725">again </span><span begin="00:10.725" end="00:10.894">but </span><span begin="00:10.894" end="00:11.038">then </span><span begin="00:11.038" end="00:11.612">again </span><span begin="00:11.612" end="00:11.773">I </span><span begin="00:11.773" end="00:12.021">hope </span><span begin="00:12.021" end="00:12.204">it </span><span begin="00:12.204" end="00:12.573">does</span></p><p ttm:agent="v1" begin="00:12.691" end="00:15.684"><span begin="00:12.691" end="00:12.849">Because </span><span begin="00:12.849" end="00:13.001">I </span><span begin="00:13.001" end="00:13.177">wanna </span><span begin="00:13.177" end="00:13.618">fall </span><span begin="00:13.618" end="00:13.778">in </span><span begin="00:13.778" end="00:14.162">love </span><span begin="00:14.162" end="00:14.498">without </span><span begin="00:14.498" end="00:14.705">the </span><span begin="00:14.705" end="00:14.962">part </span><span begin="00:14.962" end="00:15.226">where </span><span begin="00:15.226" end="00:15.449">we </span><span begin="00:15.449" end="00:15.500">give </span><span begin="00:15.500" end="00:15.684">up</span></p><p ttm:agent="v1" begin="00:15.804" end="00:18.131"><span begin="00:15.804" end="00:15.955">I </span><span begin="00:15.955" end="00:16.227">wonder </span><span begin="00:16.227" end="00:16.395">if </span><span begin="00:16.395" end="00:16.579">this </span><span begin="00:16.579" end="00:16.923">still </span><span begin="00:16.923" end="00:17.171">exists </span><span begin="00:17.171" end="00:17.491">I </span><span begin="00:17.491" end="00:17.683">hope </span><span begin="00:17.683" end="00:17.915">it </span><span begin="00:17.915" end="00:18.131">does</span></p><p ttm:agent="v1" begin="00:18.555" end="00:23.130"><span begin="00:18.555" end="00:18.731">I </span><span begin="00:18.731" end="00:18.947">wonder </span><span begin="00:18.947" end="00:19.163">what </span><span begin="00:19.163" end="00:19.371">it's </span><span begin="00:19.371" end="00:20.962">like </span><span begin="00:20.962" end="00:21.122">how </span><span begin="00:21.122" end="00:21.266">it </span><span begin="00:21.266" end="00:21.497">feels </span><span begin="00:21.497" end="00:21.762">to </span><span begin="00:21.762" end="00:21.945">be </span><span begin="00:21.945" end="00:22.385">loved </span><span begin="00:22.385" end="00:22.618">by </span><span begin="00:22.618" end="00:23.130">someone</span></p><p ttm:agent="v1" begin="00:23.281" end="00:24.402"><span begin="00:23.281" end="00:23.441">Who </span><span begin="00:23.441" end="00:23.594">will </span><span begin="00:23.594" end="00:23.898">never </span><span begin="00:23.898" end="00:24.402">leave</span></p><p ttm:agent="v1" begin="00:24.610" end="00:28.168"><span begin="00:24.610" end="00:24.771">I </span><span begin="00:24.771" end="00:24.962">wanna </span><span begin="00:24.962" end="00:25.354">know </span><span begin="00:25.354" end="00:25.706">if </span><span begin="00:25.706" end="00:25.898">you </span><span begin="00:25.898" end="00:26.219">wanna </span><span begin="00:26.219" end="00:26.482">be </span><span begin="00:26.482" end="00:27.026">growing </span><span begin="00:27.026" end="00:27.319">old </span><span begin="00:27.319" end="00:27.520">with </span><span begin="00:27.520" end="00:28.168">me</span></p><p ttm:agent="v1" begin="00:28.280" end="00:34.717"><span begin="00:28.280" end="00:28.669">Until </span><span begin="00:28.669" end="00:29.005">we're </span><span begin="00:29.005" end="00:31.981">seventy </span><span begin="00:32.525" end="00:33.093">dancing </span><span begin="00:33.093" end="00:33.517">with </span><span begin="00:33.517" end="00:34.717">me</span></p><p ttm:agent="v1" begin="00:35.462" end="00:41.231"><span begin="00:35.462" end="00:35.733">Just </span><span begin="00:35.733" end="00:36.276">passing </span><span begin="00:36.276" end="00:36.645">the </span><span begin="00:36.645" end="00:38.253">time </span><span begin="00:38.253" end="00:38.541">with </span><span begin="00:38.541" end="00:38.869">you </span><span begin="00:38.869" end="00:39.133">right </span><span begin="00:39.133" end="00:39.461">by </span><span begin="00:39.461" end="00:39.877">my </span><span begin="00:39.877" end="00:41.231">side</span></p><p ttm:agent="v1" begin="00:41.821" end="00:47.629"><span begin="00:41.821" end="00:42.021">Just </span><span begin="00:42.021" end="00:42.605">stay </span><span begin="00:42.605" end="00:43.069">with </span><span begin="00:43.069" end="00:44.598">me </span><span begin="00:44.741" end="00:45.333">promise </span><span begin="00:45.333" end="00:45.709">you'll </span><span begin="00:45.709" end="00:46.388">never </span><span begin="00:46.388" end="00:47.629">leave</span></p><p ttm:agent="v1" begin="00:48.573" end="00:56.989"><span begin="00:48.573" end="00:48.781">I </span><span begin="00:48.781" end="00:49.597">wanna </span><span begin="00:49.597" end="00:50.597">love </span><span begin="00:50.597" end="00:50.861">you </span><span begin="00:50.861" end="00:51.133">for </span><span begin="00:51.133" end="00:51.613">the </span><span begin="00:51.613" end="00:52.029">rest </span><span begin="00:52.029" end="00:52.381">of </span><span begin="00:52.381" end="00:52.852">my </span><span begin="00:52.852" end="00:53.837">life </span><span begin="00:53.925" end="00:54.293">until </span><span begin="00:54.293" end="00:54.821">we're </span><span begin="00:54.821" end="00:56.989">seventy</span></p><p ttm:agent="v1" begin="01:03.885" end="01:05.341"><span begin="01:03.885" end="01:04.293">Baby </span><span begin="01:04.293" end="01:04.485">I'm </span><span begin="01:04.485" end="01:04.628">so </span><span begin="01:04.628" end="01:05.125">into </span><span begin="01:05.125" end="01:05.341">you</span></p><p ttm:agent="v1" begin="01:05.629" end="01:09.966"><span begin="01:05.629" end="01:05.797">I've </span><span begin="01:05.797" end="01:05.973">lived </span><span begin="01:05.973" end="01:06.165">a </span><span begin="01:06.165" end="01:06.821">thousand </span><span begin="01:06.821" end="01:07.301">lives </span><span begin="01:07.301" end="01:07.461">can't </span><span begin="01:07.461" end="01:07.621">go </span><span begin="01:07.621" end="01:07.800">a </span><span begin="01:07.800" end="01:08.358">single </span><span begin="01:08.358" end="01:08.877">night </span><span begin="01:08.877" end="01:09.269">without </span><span begin="01:09.269" end="01:09.966">you</span></p><p ttm:agent="v1" begin="01:10.118" end="01:15.979"><span begin="01:10.118" end="01:10.239">In </span><span begin="01:10.239" end="01:10.943">whatever </span><span begin="01:10.943" end="01:12.440">feeling </span><span begin="01:12.935" end="01:13.079">I </span><span begin="01:13.079" end="01:13.256">think </span><span begin="01:13.256" end="01:13.480">I'm </span><span begin="01:13.480" end="01:13.871">ready </span><span begin="01:13.871" end="01:14.063">for </span><span begin="01:14.063" end="01:14.272">the </span><span begin="01:14.272" end="01:14.632">real </span><span begin="01:14.632" end="01:15.554">thing </span><span begin="01:15.554" end="01:15.979">yeah</span></p><p ttm:agent="v1" begin="01:16.241" end="01:19.129"><span begin="01:16.241" end="01:16.377">And </span><span begin="01:16.377" end="01:16.513">I </span><span begin="01:16.513" end="01:16.664">want </span><span begin="01:16.664" end="01:16.817">that </span><span begin="01:16.817" end="01:17.329">love </span><span begin="01:17.329" end="01:17.513">that </span><span begin="01:17.513" end="01:17.689">type </span><span begin="01:17.689" end="01:17.897">of </span><span begin="01:17.897" end="01:18.545">love </span><span begin="01:18.545" end="01:18.729">that's </span><span begin="01:18.729" end="01:19.129">steady</span></p><p ttm:agent="v1" begin="01:19.321" end="01:21.417"><span begin="01:19.321" end="01:19.522">And </span><span begin="01:19.522" end="01:19.713">kitchen </span><span begin="01:19.713" end="01:20.457">hugs </span><span begin="01:20.457" end="01:20.657">so </span><span begin="01:20.657" end="01:20.809">many </span><span begin="01:20.809" end="01:21.417">stuff</span></p><p ttm:agent="v1" begin="01:21.793" end="01:24.033"><span begin="01:21.793" end="01:21.961">You </span><span begin="01:21.961" end="01:22.097">give </span><span begin="01:22.097" end="01:22.489">me </span><span begin="01:22.489" end="01:23.049">everything </span><span begin="01:23.049" end="01:23.209">I </span><span begin="01:23.209" end="01:23.369">wanna </span><span begin="01:23.369" end="01:24.033">be</span></p><p ttm:agent="v1" begin="01:24.153" end="01:25.344"><span begin="01:24.153" end="01:24.473">Everything </span><span begin="01:24.473" end="01:24.649">I </span><span begin="01:24.649" end="01:24.839">want </span><span begin="01:24.839" end="01:25.048">and </span><span begin="01:25.048" end="01:25.344">be</span></p><p ttm:agent="v1" begin="01:25.511" end="01:28.000"><span begin="01:25.511" end="01:25.687">I </span><span begin="01:25.687" end="01:25.839">find </span><span begin="01:25.839" end="01:26.007">it </span><span begin="01:26.007" end="01:26.223">here </span><span begin="01:26.223" end="01:26.417">with </span><span begin="01:26.417" end="01:26.592">you </span><span begin="01:26.592" end="01:27.007">and </span><span begin="01:27.007" end="01:27.559">me </span><span begin="01:27.559" end="01:28.000">yeah</span></p><p ttm:agent="v1" begin="01:29.407" end="01:34.048"><span begin="01:29.407" end="01:29.560">And </span><span begin="01:29.560" end="01:29.695">I </span><span begin="01:29.695" end="01:29.847">wo