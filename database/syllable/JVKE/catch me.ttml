<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>catch me</ttm:title><ttm:agent type="person" xml:id="v1">JVKE</ttm:agent><ttm:item type="album">this is what ____ feels like (Vol. 1-4)</ttm:item><ttm:item type="spotify_id">4C3ZV2ZeVh5A7LOkCZpjj1</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:12.550" end="00:16.510"><span begin="00:12.550" end="00:13.030">Last </span><span begin="00:13.030" end="00:13.330">week</span><span begin="00:13.330" end="00:13.360">, </span><span begin="00:13.360" end="00:13.630">been </span><span begin="00:13.630" end="00:13.720">a </span><span begin="00:13.720" end="00:14.140">whole </span><span begin="00:14.140" end="00:14.530">year </span><span begin="00:14.530" end="00:14.560"> </span><span begin="00:14.560" end="00:14.800">but </span><span begin="00:14.800" end="00:14.920">it </span><span begin="00:14.920" end="00:15.340">feel </span><span begin="00:15.340" end="00:15.730">like </span><span begin="00:15.730" end="00:16.180">last </span><span begin="00:16.180" end="00:16.480">week</span></p><p ttm:agent="v1" begin="00:16.510" end="00:21.070"><span begin="00:16.510" end="00:16.780">When </span><span begin="00:16.780" end="00:16.870">I </span><span begin="00:16.870" end="00:17.110">was </span><span begin="00:17.110" end="00:17.260">your </span><span begin="00:17.260" end="00:17.680">boy </span><span begin="00:17.680" end="00:18.100">fallin' </span><span begin="00:18.100" end="00:18.580">hard </span><span begin="00:18.580" end="00:18.730">in </span><span begin="00:18.730" end="00:18.850">the </span><span begin="00:18.850" end="00:19.990">backstreets</span></p><p ttm:agent="v1" begin="00:21.070" end="00:22.810"><span begin="00:21.070" end="00:21.340">But </span><span begin="00:21.340" end="00:21.490">you </span><span begin="00:21.490" end="00:21.670">were </span><span begin="00:21.670" end="00:21.910">there </span><span begin="00:21.910" end="00:22.000">to </span><span begin="00:22.000" end="00:22.510">catch </span><span begin="00:22.510" end="00:22.780">me</span></p><p ttm:agent="v1" begin="00:22.810" end="00:25.990"><span begin="00:22.810" end="00:23.050">Then </span><span begin="00:23.050" end="00:23.170">I </span><span begin="00:23.170" end="00:23.680">grew </span><span begin="00:23.680" end="00:24.040">up </span><span begin="00:24.040" end="00:24.070"> </span><span begin="00:24.070" end="00:24.280">and </span><span begin="00:24.280" end="00:24.370">the </span><span begin="00:24.370" end="00:24.790">sun </span><span begin="00:24.790" end="00:25.150">got </span><span begin="00:25.150" end="00:25.930">cloudy</span></p><p ttm:agent="v1" begin="00:25.990" end="00:27.970"><span begin="00:25.990" end="00:26.260">Used </span><span begin="00:26.260" end="00:26.350">to </span><span begin="00:26.350" end="00:26.590">fill </span><span begin="00:26.590" end="00:26.680">the </span><span begin="00:26.680" end="00:27.220">sun </span><span begin="00:27.220" end="00:27.340">on </span><span begin="00:27.340" end="00:27.490">my </span><span begin="00:27.490" end="00:27.970">skin</span></p><p ttm:agent="v1" begin="00:27.970" end="00:28.900"><span begin="00:27.970" end="00:28.180">Yeah</span><span begin="00:28.180" end="00:28.180">, </span><span begin="00:28.180" end="00:28.300">it's </span><span begin="00:28.300" end="00:28.900">sappy</span></p><p ttm:agent="v1" begin="00:28.900" end="00:34.150"><span begin="00:28.900" end="00:29.110">But </span><span begin="00:29.110" end="00:29.380">that's </span><span begin="00:29.380" end="00:29.530">the </span><span begin="00:29.530" end="00:29.950">last </span><span begin="00:29.950" end="00:30.400">time </span><span begin="00:30.400" end="00:30.520">I </span><span begin="00:30.520" end="00:30.790">was </span><span begin="00:30.790" end="00:31.480">truly </span><span begin="00:31.480" end="00:32.410">happy</span></p><p ttm:agent="v1" begin="00:34.150" end="00:35.470"><span begin="00:34.150" end="00:34.510">So </span><span begin="00:34.510" end="00:34.720">I'm </span><span begin="00:34.720" end="00:35.410">asking</span></p><p ttm:agent="v1" begin="00:35.470" end="00:41.770"><span begin="00:35.470" end="00:35.710">If </span><span begin="00:35.710" end="00:35.800">I </span><span begin="00:35.800" end="00:36.220">fell </span><span begin="00:36.220" end="00:36.700">down </span><span begin="00:36.700" end="00:37.030">right </span><span begin="00:37.030" end="00:37.390">now</span><span begin="00:37.390" end="00:37.390">, </span><span begin="00:37.390" end="00:37.630">would </span><span begin="00:37.630" end="00:37.810">you </span><span begin="00:37.810" end="00:38.440">catch </span><span begin="00:38.440" end="00:39.190">me</span><span begin="00:39.190" end="00:41.770">?</span></p><p ttm:agent="v1" begin="00:41.770" end="00:48.130"><span begin="00:41.770" end="00:42.010">If </span><span begin="00:42.010" end="00:42.100">I </span><span begin="00:42.100" end="00:42.490">fell </span><span begin="00:42.490" end="00:43.030">down </span><span begin="00:43.030" end="00:43.360">right </span><span begin="00:43.360" end="00:43.720">now</span><span begin="00:43.720" end="00:43.720">, </span><span begin="00:43.720" end="00:43.930">would </span><span begin="00:43.930" end="00:44.080">you</span></p><p ttm:agent="v1" begin="00:48.130" end="00:51.220"><span begin="00:48.130" end="00:48.370">If </span><span begin="00:48.370" end="00:48.460">I </span><span begin="00:48.460" end="00:48.850">fell </span><span begin="00:48.850" end="00:49.300">down </span><span begin="00:49.300" end="00:49.660">right </span><span begin="00:49.660" end="00:50.080">now</span><span begin="00:50.080" end="00:50.080">, </span><span begin="00:50.080" end="00:50.290">would </span><span begin="00:50.290" end="00:50.410">you </span><span begin="00:50.410" end="00:50.950">catch </span><span begin="00:50.950" end="00:51.190">me</span><span begin="00:51.190" end="00:51.220">?</span></p><p ttm:agent="v1" begin="00:51.220" end="00:53.650"><span begin="00:51.220" end="00:51.730">Catch </span><span begin="00:51.730" end="00:52.000">me</span><span begin="00:52.000" end="00:52.030">, </span><span begin="00:52.030" end="00:52.420">baby</span><span begin="00:52.420" end="00:52.420">, </span><span begin="00:52.420" end="00:52.660">would </span><span begin="00:52.660" end="00:52.810">you </span><span begin="00:52.810" end="00:53.320">catch </span><span begin="00:53.320" end="00:53.470">me</span><span begin="00:53.470" end="00:53.650">?</span></p><p ttm:agent="v1" begin="00:53.650" end="00:54.970"><span begin="00:53.650" end="00:53.890">I've </span><span begin="00:53.890" end="00:54.040">been </span><span begin="00:54.040" end="00:54.310">hurt </span><span begin="00:54.310" end="00:54.970">before</span></p><p ttm:agent="v1" begin="00:54.970" end="01:00.730"><span begin="00:54.970" end="00:55.030">Are </span><span begin="00:55.030" end="00:55.180">you </span><span begin="00:55.180" end="00:55.690">sure </span><span begin="00:55.690" end="00:55.870">that </span><span begin="00:55.870" end="00:55.990">you're </span><span begin="00:55.990" end="00:56.320">still </span><span begin="00:56.320" end="00:56.740">gonna </span><span begin="00:56.740" end="00:57.370">catch </span><span begin="00:57.370" end="00:57.550">me</span><span begin="00:57.550" end="01:00.730">?</span></p><p ttm:agent="v1" begin="01:00.730" end="01:03.850"><span begin="01:00.730" end="01:00.970">If </span><span begin="01:00.970" end="01:01.090">I </span><span begin="01:01.090" end="01:01.480">fell </span><span begin="01:01.480" end="01:01.960">down </span><span begin="01:01.960" end="01:02.320">right </span><span begin="01:02.320" end="01:02.710">now</span><span begin="01:02.710" end="01:02.710">, </span><span begin="01:02.710" end="01:02.950">would </span><span begin="01:02.950" end="01:03.070">you </span><span begin="01:03.070" end="01:03.610">catch </span><span begin="01:03.610" end="01:03.820">me</span><span begin="01:03.820" end="01:03.850">?</span></p><p ttm:agent="v1" begin="01:03.850" end="01:06.310"><span begin="01:03.850" end="01:04.360">Catch </span><span begin="01:04.360" end="01:04.630">me</span><span begin="01:04.630" end="01:04.660">, </span><span begin="01:04.660" end="01:05.110">baby</span><span begin="01:05.110" end="01:05.110">, </span><span begin="01:05.110" end="01:05.290">would </span><span begin="01:05.290" end="01:05.440">you </span><span begin="01:05.440" end="01:05.920">catch </span><span begin="01:05.920" end="01:06.310">me</span><span begin="01:06.310" end="01:06.310">?</span></p><p ttm:agent="v1" begin="01:06.310" end="01:12.160"><span begin="01:06.310" end="01:06.640">I'ma </span><span begin="01:06.640" end="01:07.000">let </span><span begin="01:07.000" end="01:07.510">go</span><span begin="01:07.510" end="01:07.510">, </span><span begin="01:07.510" end="01:07.720">all </span><span begin="01:07.720" end="01:07.810">I </span><span begin="01:07.810" end="01:08.320">know </span><span begin="01:08.320" end="01:08.530">is </span><span begin="01:08.530" end="01:08.620">I </span><span begin="01:08.620" end="01:08.980">need </span><span begin="01:08.980" end="01:09.220">you </span><span begin="01:09.220" end="01:09.340">to </span><span begin="01:09.340" end="01:09.940">catch </span><span begin="01:09.940" end="01:10.540">me</span></p><p ttm:agent="v1" begin="01:12.160" end="01:13.360"><span begin="01:12.160" end="01:12.430">Would </span><span begin="01:12.430" end="01:12.550">you </span><span begin="01:12.550" end="01:13.090">catch </span><span begin="01:13.090" end="01:13.150">me</span><span begin="01:13.150" end="01:13.360">?</span></p><p ttm:agent="v1" begin="01:13.360" end="01:16.480"><span begin="01:13.360" end="01:13.600">I </span><span begin="01:13.600" end="01:13.810">ain't </span><span begin="01:13.810" end="01:14.290">written </span><span begin="01:14.290" end="01:14.500">on</span><span begin="01:14.500" end="01:14.680">е </span><span begin="01:14.680" end="01:14.860">love </span><span begin="01:14.860" end="01:15.310">song </span><span begin="01:15.310" end="01:15.580">since </span><span begin="01:15.580" end="01:15.730">she </span><span begin="01:15.730" end="01:15.820">l</span><span begin="01:15.820" end="01:15.850">е</span><span begin="01:15.850" end="01:15.880"> </span><span begin="01:15.880" end="01:16.210">ft </span><span begin="01:16.210" end="01:16.360">me</span></p><p ttm:agent="v1" begin="01:16.480" end="01:18.100"><span begin="01:16.480" end="01:16.990">Trauma </span><span begin="01:16.990" end="01:17.140">in </span><span begin="01:17.140" end="01:17.320">my </span><span begin="01:17.320" end="01:18.010">memories</span></p><p ttm:agent="v1" begin="01:18.100" end="01:21.070"><span begin="01:18.100" end="01:18.430">When </span><span begin="01:18.430" end="01:18.520">I </span><span begin="01:18.520" end="01:18.790">try </span><span begin="01:18.790" end="01:18.940">to </span><span begin="01:18.940" end="01:19.360">hold </span><span begin="01:19.360" end="01:19.390"> </span><span begin="01:19.390" end="01:19.510">you</span><span begin="01:19.510" end="01:19.510">, </span><span begin="01:19.510" end="01:19.690">my </span><span begin="01:19.690" end="01:20.110">body </span><span begin="01:20.110" end="01:20.470">doesn't </span><span begin="01:20.470" end="01:21.010">let </span><span begin="01:21.010" end="01:21.070">me</span></p><p ttm:agent="v1" begin="01:21.070" end="01:24.460"><span begin="01:21.070" end="01:21.280">So</span><span begin="01:21.280" end="01:21.280">, </span><span begin="01:21.280" end="01:21.700">baby</span><span begin="01:21.700" end="01:21.700">, </span><span begin="01:21.700" end="01:21.910">would </span><span begin="01:21.910" end="01:22.060">you </span><span begin="01:22.060" end="01:22.540">catch </span><span begin="01:22.540" end="01:22.960">me</span><span begin="01:22.960" end="01:23.330">? </span><span begin="01:23.330" end="01:23.700">（</span><span begin="01:23.700" end="01:24.070">Oh</span><span begin="01:24.070" end="01:24.460">）</span></p><p ttm:agent="v1" begin="01:24.460" end="01:27.610"><span begin="01:24.460" end="01:24.880">Baby</span><span begin="01:24.880" end="01:24.880">, </span><span begin="01:24.880" end="01:25.060">would </span><span begin="01:25.060" end="01:25.210">you </span><span begin="01:25.210" end="01:25.660">catch </span><span begin="01:25.660" end="01:26.110">me</span><span begin="01:26.110" end="01:27.610">?</span></p><p ttm:agent="v1" begin="01:27.610" end="01:29.980"><span begin="01:27.610" end="01:27.940">Baby</span><span begin="01:27.940" end="01:27.940">, </span><span begin="01:27.940" end="01:28.240">would </span><span begin="01:28.240" end="01:28.330">you </span><span begin="01:28.330" end="01:28.930">catch </span><span begin="01:28.930" end="01:29.140"> </span><span begin="01:29.140" end="01:29.710">me</span><span begin="01:29.710" end="01:29.980">?</span></p><p ttm:agent="v1" begin="01:29.980" end="01:31.570"><span begin="01:29.980" end="01:30.280">Make </span><span begin="01:30.280" end="01:30.490">it </span><span begin="01:30.490" end="01:31.540">alright</span></p><p ttm:agent="v1" begin="01:31.570" end="01:34.390"><span begin="01:31.570" end="01:31.840">I </span><span begin="01:31.840" end="01:31.960">ain't </span><span begin="01:31.960" end="01:32.230">fell </span><span begin="01:32.230" end="01:32.380">in </span><span begin="01:32.380" end="01:32.830">lov