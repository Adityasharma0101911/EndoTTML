<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Intro</ttm:title><ttm:agent type="person" xml:id="v1">Shawn Mendes</ttm:agent><ttm:item type="album">Wonder</ttm:item><ttm:item type="spotify_id">138oQeapLds5IeJrdRfeUd</ttm:item><itunes:duration>01:02.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:14.093" end="00:19.662"><span begin="00:14.093" end="00:14.325">You </span><span begin="00:14.325" end="00:15.710">have </span><span begin="00:15.925" end="00:16.149">a </span><span begin="00:16.149" end="00:16.918">million </span><span begin="00:16.918" end="00:17.757">different </span><span begin="00:17.757" end="00:19.662">faces</span></p><p ttm:agent="v1" begin="00:20.381" end="00:23.837"><span begin="00:20.381" end="00:20.597">But </span><span begin="00:20.597" end="00:20.965">they'll </span><span begin="00:20.965" end="00:21.637">never </span><span begin="00:21.637" end="00:23.837">understand</span></p><p ttm:agent="v1" begin="00:26.349" end="00:29.596"><span begin="00:26.349" end="00:26.941">Unless </span><span begin="00:26.941" end="00:27.357">you </span><span begin="00:27.357" end="00:28.069">let </span><span begin="00:28.069" end="00:28.885">them </span><span begin="00:28.885" end="00:29.596">in</span></p><p ttm:agent="v1" begin="00:29.884" end="00:35.340"><span begin="00:29.884" end="00:30.092">You've </span><span begin="00:30.092" end="00:31.364">been </span><span begin="00:31.676" end="00:31.884">a </span><span begin="00:31.884" end="00:32.716">million </span><span begin="00:32.716" end="00:33.508">different </span><span begin="00:33.508" end="00:35.340">places</span></p><p ttm:agent="v1" begin="00:35.860" end="00:40.268"><span begin="00:35.860" end="00:36.204">So </span><span begin="00:36.204" end="00:36.716">I </span><span begin="00:36.716" end="00:37.293">guess </span><span begin="00:37.293" end="00:37.796">I'll </span><span begin="00:37.796" end="00:38.092">have </span><span begin="00:38.092" end="00:38.292">a </span><span begin="00:38.292" end="00:39.068">chance </span><span begin="00:39.068" end="00:40.268">to</span></p><p ttm:agent="v1" begin="00:41.900" end="00:45.866"><span begin="00:41.900" end="00:42.164">Get </span><span begin="00:42.164" end="00:42.556">lost </span><span begin="00:42.556" end="00:42.924">in </span><span begin="00:42.924" end="00:45.866">wonderland</span></p><p ttm:agent="v1" begin="00:57.347" end="01:00.547"><span begin="00:57.347" end="01:00.547">Ooh</span></p></div></body></tt>