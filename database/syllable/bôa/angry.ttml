<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>angry</ttm:title><ttm:agent type="person" xml:id="v1">bôa</ttm:agent><ttm:item type="album">get there</ttm:item><ttm:item type="spotify_id">1dwJ0toXevD9Stcuuq6Jyg</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:35.340" end="00:38.100"><span begin="00:35.340" end="00:36.330">Moving </span><span begin="00:36.330" end="00:37.140">moving </span><span begin="00:37.140" end="00:38.100">out</span></p><p ttm:agent="v1" begin="00:38.280" end="00:41.190"><span begin="00:38.280" end="00:38.820">Said </span><span begin="00:38.820" end="00:39.090">too </span><span begin="00:39.090" end="00:39.660">many </span><span begin="00:39.660" end="00:40.140">things </span><span begin="00:40.140" end="00:40.380">to </span><span begin="00:40.380" end="00:41.190">shout</span></p><p ttm:agent="v1" begin="00:41.220" end="00:43.350"><span begin="00:41.220" end="00:41.520">Had </span><span begin="00:41.520" end="00:42.000">enough </span><span begin="00:42.000" end="00:42.270">of </span><span begin="00:42.270" end="00:43.350">you</span></p><p ttm:agent="v1" begin="00:43.410" end="00:46.260"><span begin="00:43.410" end="00:43.620">And </span><span begin="00:43.620" end="00:43.710">the </span><span begin="00:43.710" end="00:44.160">things </span><span begin="00:44.160" end="00:44.340">in </span><span begin="00:44.340" end="00:44.790">life </span><span begin="00:44.790" end="00:44.940">you </span><span begin="00:44.940" end="00:45.390">choose </span><span begin="00:45.390" end="00:45.660">to </span><span begin="00:45.660" end="00:46.260">do</span></p><p ttm:agent="v1" begin="00:46.290" end="00:48.690"><span begin="00:46.290" end="00:46.860">Could've </span><span begin="00:46.860" end="00:47.160">been </span><span begin="00:47.160" end="00:48.690">beautiful</span></p><p ttm:agent="v1" begin="00:48.720" end="00:51.660"><span begin="00:48.720" end="00:48.960">But </span><span begin="00:48.960" end="00:50.010">everything </span><span begin="00:50.010" end="00:50.250">is </span><span begin="00:50.250" end="00:50.850">growing </span><span begin="00:50.850" end="00:51.660">cold</span></p><p ttm:agent="v1" begin="00:51.690" end="00:55.050"><span begin="00:51.690" end="00:51.960">This </span><span begin="00:51.960" end="00:52.080">is </span><span begin="00:52.080" end="00:52.620">now</span><span begin="00:52.620" end="00:52.650">, </span><span begin="00:52.650" end="00:53.130">when </span><span begin="00:53.130" end="00:53.310">i </span><span begin="00:53.310" end="00:54.090">grow </span><span begin="00:54.090" end="00:55.050">old</span></p><p ttm:agent="v1" begin="00:59.040" end="01:02.910"><span begin="00:59.040" end="00:59.250">You </span><span begin="00:59.250" end="00:59.430">know </span><span begin="00:59.430" end="00:59.580">it </span><span begin="00:59.580" end="00:59.910">makes </span><span begin="00:59.910" end="01:00.030">me </span><span begin="01:00.030" end="01:00.750">very </span><span begin="01:00.750" end="01:02.910">angry</span></p><p ttm:agent="v1" begin="01:09.600" end="01:13.290"><span begin="01:09.600" end="01:09.720">And </span><span begin="01:09.720" end="01:09.780">i </span><span begin="01:09.780" end="01:10.440">never </span><span begin="01:10.440" end="01:10.770">get </span><span begin="01:10.770" end="01:11.220">so </span><span begin="01:11.220" end="01:13.290">angry</span></p><p ttm:agent="v1" begin="01:17.070" end="01:19.830"><span begin="01:17.070" end="01:17.460">Taking </span><span begin="01:17.460" end="01:18.060">back </span><span begin="01:18.060" end="01:18.390">what </span><span begin="01:18.390" end="01:18.780">was </span><span begin="01:18.780" end="01:19.830">mine</span></p><p ttm:agent="v1" begin="01:20.040" end="01:22.950"><span begin="01:20.040" end="01:20.220">At </span><span begin="01:20.220" end="01:20.670">least </span><span begin="01:20.670" end="01:20.820">i </span><span begin="01:20.820" end="01:21.180">thought </span><span begin="01:21.180" end="01:21.630">so </span><span begin="01:21.630" end="01:21.840">at </span><span begin="01:21.840" end="01:22.170">the </span><span begin="01:22.170" end="01:22.950">time</span></p><p ttm:agent="v1" begin="01:23.040" end="01:25.080"><span begin="01:23.040" end="01:23.610">Everything </span><span begin="01:23.610" end="01:25.080">changes</span></p><p ttm:agent="v1" begin="01:25.320" end="01:28.080"><span begin="01:25.320" end="01:25.560">And </span><span begin="01:25.560" end="01:25.740">i </span><span begin="01:25.740" end="01:26.070">don't </span><span begin="01:26.070" end="01:26.400">know </span><span begin="01:26.400" end="01:26.700">what </span><span begin="01:26.700" end="01:27.090">was </span><span begin="01:27.090" end="01:27.300">there </span><span begin="01:27.300" end="01:28.080">before</span></p><p ttm:agent="v1" begin="01:28.080" end="01:30.390"><span begin="01:28.080" end="01:28.500">Something </span><span begin="01:28.500" end="01:28.890">should </span><span begin="01:28.890" end="01:29.220">be </span><span begin="01:29.220" end="01:30.390">there</span></p><p ttm:agent="v1" begin="01:30.420" end="01:33.390"><span begin="01:30.420" end="01:30.690">But </span><span begin="01:30.690" end="01:30.930">i </span><span begin="01:30.930" end="01:31.290">have </span><span begin="01:31.290" end="01:31.740">known </span><span begin="01:31.740" end="01:32.040">and </span><span begin="01:32.040" end="01:32.250">i </span><span begin="01:32.250" end="01:32.610">don't </span><span begin="01:32.610" end="01:33.390">know</span></p><p ttm:agent="v1" begin="01:33.420" end="01:36.870"><span begin="01:33.420" end="01:33.690">This </span><span begin="01:33.690" end="01:33.810">is </span><span begin="01:33.810" end="01:34.350">now</span><span begin="01:34.350" end="01:34.380">, </span><span begin="01:34.380" end="01:34.860">when </span><span begin="01:34.860" end="01:35.040">i </span><span begin="01:35.040" end="01:35.820">grow </span><span begin="01:35.820" end="01:36.870">old</span></p><p ttm:agent="v1" begin="01:40.770" end="01:44.670"><span begin="01:40.770" end="01:40.980">You </span><span begin="01:40.980" end="01:41.160">know </span><span begin="01:41.160" end="01:41.310">it </span><span begin="01:41.310" end="01:41.640">makes </span><span begin="01:41.640" end="01:41.790">me </span><span begin="01:41.790" end="01:42.450">very </span><span begin="01:42.450" end="01:44.670">angry</span></p><p ttm:agent="v1" begin="01:51.330" end="01:55.050"><span begin="01:51.330" end="01:51.450">And </span><span begin="01:51.450" end="01:51.540">i </span><span begin="01:51.540" end="01:52.200">never </span><span begin="01:52.200" end="01:52.500">get </span><span begin="01:52.500" end="01:52.950">so </span><span begin="01:52.950" end="01:55.050">angry</span></p><p ttm:agent="v1" begin="01:58.260" end="02:01.590"><span begin="01:58.260" end="01:58.650">This </span><span begin="01:58.650" end="01:59.220">is </span><span begin="01:59.220" end="01:59.820">the </span><span begin="01:59.820" end="02:00.480">last </span><span begin="02:00.480" end="02:01.590">time</span></p><p ttm:agent="v1" begin="02:01.800" end="02:03.420"><span begin="02:01.800" end="02:02.100">I'll </span><span begin="02:02.100" end="02:02.490">take </span><span begin="02:02.490" end="02:02.790">this </span><span begin="02:02.790" end="02:03.180">from </span><span begin="02:03.180" end="02:03.420">you</span></p><p ttm:agent="v1" begin="02:03.420" end="02:06.990"><span begin="02:03.420" end="02:03.870">This </span><span begin="02:03.870" end="02:04.500">is </span><span begin="02:04.500" end="02:05.040">the </span><span begin="02:05.040" end="02:05.760">last </span><span begin="02:05.760" end="02:06.990">time</span></p><p ttm:agent="v1" begin="02:07.020" end="02:09.030"><span begin="02:07.020" end="02:07.320">I'll </span><span begin="02:07.320" end="02:07.710">take </span><span begin="02:07.710" end="02:08.010">this </span><span begin="02:08.010" end="02:08.430">from </span><span begin="02:08.430" end="02:09.030">you</span></p></div></body></tt>