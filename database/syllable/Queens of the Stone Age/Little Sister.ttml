<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Little Sister</ttm:title><ttm:agent type="person" xml:id="v1">Queens of the Stone Age</ttm:agent><ttm:item type="album">Lullabies To Paralyze</ttm:item><ttm:item type="spotify_id">6Td8HRLhdV39kKdOQpfQum</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:14.250" end="00:17.460"><span begin="00:14.250" end="00:14.580">Hey </span><span begin="00:14.580" end="00:15.240">sister </span><span begin="00:15.240" end="00:15.690">are </span><span begin="00:15.690" end="00:16.140">you </span><span begin="00:16.140" end="00:16.740">all </span><span begin="00:16.740" end="00:17.400">alone</span><span begin="00:17.400" end="00:17.460">?</span></p><p ttm:agent="v1" begin="00:17.460" end="00:20.400"><span begin="00:17.460" end="00:17.610">I'm </span><span begin="00:17.610" end="00:18.480">standing </span><span begin="00:18.480" end="00:18.780">out </span><span begin="00:18.780" end="00:19.080">your </span><span begin="00:19.080" end="00:20.400">window</span></p><p ttm:agent="v1" begin="00:20.430" end="00:26.430"><span begin="00:20.430" end="00:20.580">Hey </span><span begin="00:20.580" end="00:21.300">little </span><span begin="00:21.300" end="00:22.050">sister </span><span begin="00:22.050" end="00:22.590">can </span><span begin="00:22.590" end="00:22.800">I </span><span begin="00:22.800" end="00:24.270">come </span><span begin="00:24.270" end="00:25.170">inside </span><span begin="00:25.170" end="00:26.430">there</span></p><p ttm:agent="v1" begin="00:26.490" end="00:29.490"><span begin="00:26.490" end="00:26.610">I </span><span begin="00:26.610" end="00:27.300">want </span><span begin="00:27.300" end="00:27.360">to </span><span begin="00:27.360" end="00:27.750">show </span><span begin="00:27.750" end="00:28.290">you </span><span begin="00:28.290" end="00:28.530">all </span><span begin="00:28.530" end="00:28.920">my </span><span begin="00:28.920" end="00:29.490">love</span></p><p ttm:agent="v1" begin="00:29.520" end="00:32.460"><span begin="00:29.520" end="00:29.640">I </span><span begin="00:29.640" end="00:30.330">want </span><span begin="00:30.330" end="00:30.420">to </span><span begin="00:30.420" end="00:30.960">be </span><span begin="00:30.960" end="00:31.320">the </span><span begin="00:31.320" end="00:31.950">only </span><span begin="00:31.950" end="00:32.460">one</span></p><p ttm:agent="v1" begin="00:32.520" end="00:38.580"><span begin="00:32.520" end="00:32.670">I </span><span begin="00:32.670" end="00:33.030">know </span><span begin="00:33.030" end="00:33.420">you </span><span begin="00:33.420" end="00:33.810">like </span><span begin="00:33.810" end="00:35.070">nobody </span><span begin="00:35.070" end="00:36.390">ever</span><span begin="00:36.390" end="00:36.390">, </span><span begin="00:36.390" end="00:38.580">baby</span></p><p ttm:agent="v1" begin="00:38.730" end="00:44.190"><span begin="00:38.730" end="00:39.360">Little </span><span begin="00:39.360" end="00:40.080">sister </span><span begin="00:40.080" end="00:40.620">can't </span><span begin="00:40.620" end="00:40.860">you </span><span begin="00:40.860" end="00:41.580">find </span><span begin="00:41.580" end="00:42.720">another </span><span begin="00:42.720" end="00:44.190">way</span></p><p ttm:agent="v1" begin="00:44.670" end="00:49.560"><span begin="00:44.670" end="00:45.060">No </span><span begin="00:45.060" end="00:45.360">more </span><span begin="00:45.360" end="00:46.080">living </span><span begin="00:46.080" end="00:46.500">life </span><span begin="00:46.500" end="00:47.520">behind </span><span begin="00:47.520" end="00:47.700">a </span><span begin="00:47.700" end="00:49.560">shadow</span></p><p ttm:agent="v1" begin="00:50.640" end="00:55.650"><span begin="00:50.640" end="00:51.240">Little </span><span begin="00:51.240" end="00:51.960">sister </span><span begin="00:51.960" end="00:52.470">can't </span><span begin="00:52.470" end="00:52.680">you </span><span begin="00:52.680" end="00:53.460">find </span><span begin="00:53.460" end="00:54.600">another </span><span begin="00:54.600" end="00:55.650">way</span></p><p ttm:agent="v1" begin="00:56.550" end="01:02.730"><span begin="00:56.550" end="00:56.910">No </span><span begin="00:56.910" end="00:57.210">more </span><span begin="00:57.210" end="00:57.960">living </span><span begin="00:57.960" end="00:58.350">life </span><span begin="00:58.350" end="01:00.840">behind </span><span begin="01:00.840" end="01:00.990">a </span><span begin="01:00.990" end="01:02.730">shadow</span></p><p ttm:agent="v1" begin="01:14.100" end="01:17.190"><span begin="01:14.100" end="01:14.280">You </span><span begin="01:14.280" end="01:15.000">whisper </span><span begin="01:15.000" end="01:15.930">secrets </span><span begin="01:15.930" end="01:16.200">in </span><span begin="01:16.200" end="01:16.650">my </span><span begin="01:16.650" end="01:17.190">ear</span></p><p ttm:agent="v1" begin="01:17.220" end="01:20.190"><span begin="01:17.220" end="01:18.090">Slowly </span><span begin="01:18.090" end="01:18.780">dancing </span><span begin="01:18.780" end="01:19.410">cheek </span><span begin="01:19.410" end="01:19.560">to </span><span begin="01:19.560" end="01:20.190">cheek</span></p><p ttm:agent="v1" begin="01:20.220" end="01:25.980"><span begin="01:20.220" end="01:20.820">Such </span><span begin="01:20.820" end="01:21.000">a </span><span begin="01:21.000" end="01:21.420">sweet </span><span begin="01:21.420" end="01:21.840">thing </span><span begin="01:21.840" end="01:22.230">when </span><span begin="01:22.230" end="01:22.620">you </span><span begin="01:22.620" end="01:23.790">open </span><span begin="01:23.790" end="01:24.090">up</span><span begin="01:24.090" end="01:24.090">, </span><span begin="01:24.090" end="01:25.980">baby</span></p><p ttm:agent="v1" begin="01:26.010" end="01:29.070"><span begin="01:26.010" end="01:26.220">They </span><span begin="01:26.220" end="01:26.880">say </span><span begin="01:26.880" end="01:27.060">I'll </span><span begin="01:27.060" end="01:27.660">only </span><span begin="01:27.660" end="01:28.290">do </span><span begin="01:28.290" end="01:28.470">you </span><span begin="01:28.470" end="01:29.070">wrong</span></p><p ttm:agent="v1" begin="01:29.100" end="01:32.790"><span begin="01:29.100" end="01:29.820">Come </span><span begin="01:29.820" end="01:30.660">together </span><span begin="01:30.660" end="01:31.230">cause </span><span begin="01:31.230" end="01:31.530">I </span><span begin="01:31.530" end="01:32.790">understand</span></p><p ttm:agent="v1" begin="01:32.790" end="01:38.070"><span begin="01:32.790" end="01:33.030">Just </span><span begin="01:33.030" end="01:33.270">who </span><span begin="01:33.270" end="01:33.690">you </span><span begin="01:33.690" end="01:34.470">really </span><span begin="01:34.470" end="01:35.190">are </span><span begin="01:35.190" end="01:35.850">yeah</span><span begin="01:35.850" end="01:35.880">, </span><span begin="01:35.880" end="01:38.070">baby</span></p><p ttm:agent="v1" begin="01:38.160" end="01:43.170"><span begin="01:38.160" end="01:38.760">Little </span><span begin="01:38.760" end="01:39.480">sister </span><span begin="01:39.480" end="01:40.020">can't </span><span begin="01:40.020" end="01:40.230">you </span><span begin="01:40.230" end="01:40.980">find </span><span begin="01:40.980" end="01:42.090">another </span><span begin="01:42.090" end="01:43.170">way</span></p><p ttm:agent="v1" begin="01:44.070" end="01:48.690"><span begin="01:44.070" end="01:44.370">No </span><span begin="01:44.370" end="01:44.700">more </span><span begin="01:44.700" end="01:45.420">living </span><span begin="01:45.420" end="01:45.810">life </span><span begin="01:45.810" end="01:46.830">behind </span><span begin="01:46.830" end="01:46.980">a </span><span begin="01:46.980" end="01:48.690">shadow</span></p><p ttm:agent="v1" begin="01:49.890" end="01:54.810"><span begin="01:49.890" end="01:50.490">Little </span><span begin="01:50.490" end="01:51.180">sister </span><span begin="01:51.180" end="01:51.690">can't </span><span begin="01:51.690" end="01:51.930">you </span><span begin="01:51.930" end="01:52.650">find </span><span begin="01:52.650" end="01:53.760">another </span><span begin="01:53.760" end="01:54.810">way</span></p><p ttm:agent="v1" begin="01:55.710" end="02:02.160"><span begin="01:55.710" end="01:56.040">No </span><span begin="01:56.040" end="01:56.370">more </span><span begin="01:56.370" end="01:57.090">living </span><span begin="01:57.090" end="01:57.480">life </span><span begin="01:57.480" end="01:59.940">behind </span><span begin="01:59.940" end="02:00.090">a </span><span begin="02:00.090" end="02:02.160">shadow</span></p></div></body></tt>