<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>If Only</ttm:title><ttm:agent type="person" xml:id="v1">Queens of the Stone Age</ttm:agent><ttm:item type="album">Queens of the Stone Age</ttm:item><ttm:item type="spotify_id">60wTHSJ0PxxwZDiSLiFaQX</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:14.850" end="00:15.540"><span begin="00:14.850" end="00:14.965">maybe </span><span begin="00:14.965" end="00:15.080">then </span><span begin="00:15.080" end="00:15.195">you'd </span><span begin="00:15.195" end="00:15.310">be </span><span begin="00:15.310" end="00:15.425">with </span><span begin="00:15.425" end="00:15.540">me</span></p><p ttm:agent="v1" begin="00:15.540" end="00:18.490"><span begin="00:15.540" end="00:16.130">If </span><span begin="00:16.130" end="00:16.720">only </span><span begin="00:16.720" end="00:17.310">I </span><span begin="00:17.310" end="00:17.900">was </span><span begin="00:17.900" end="00:18.490">eighteen</span></p><p ttm:agent="v1" begin="00:18.490" end="00:20.290"><span begin="00:18.490" end="00:18.747">and </span><span begin="00:18.747" end="00:19.004">had </span><span begin="00:19.004" end="00:19.261">the </span><span begin="00:19.261" end="00:19.518">courage </span><span begin="00:19.518" end="00:19.775">of </span><span begin="00:19.775" end="00:20.032">the </span><span begin="00:20.032" end="00:20.290">ATeam</span></p><p ttm:agent="v1" begin="00:20.290" end="00:24.090"><span begin="00:20.290" end="00:20.923">maybe </span><span begin="00:20.923" end="00:21.556">then </span><span begin="00:21.556" end="00:22.189">you'd </span><span begin="00:22.189" end="00:22.822">be </span><span begin="00:22.822" end="00:23.455">with </span><span begin="00:23.455" end="00:24.090">me</span></p><p ttm:agent="v1" begin="00:24.890" end="00:31.810"><span begin="00:24.890" end="00:25.878">But </span><span begin="00:25.878" end="00:26.866">for </span><span begin="00:26.866" end="00:27.854">now </span><span begin="00:27.854" end="00:28.842">I'll </span><span begin="00:28.842" end="00:29.830">have </span><span begin="00:29.830" end="00:30.818">to </span><span begin="00:30.818" end="00:31.810">dream</span></p><p ttm:agent="v1" begin="00:31.810" end="00:33.400"><span begin="00:31.810" end="00:32.075">about </span><span begin="00:32.075" end="00:32.340">your </span><span begin="00:32.340" end="00:32.605">smile </span><span begin="00:32.605" end="00:32.870">'cause </span><span begin="00:32.870" end="00:33.135">you're </span><span begin="00:33.135" end="00:33.400">not</span></p><p ttm:agent="v1" begin="00:33.400" end="00:34.300"><span begin="00:33.400" end="00:33.512">here </span><span begin="00:33.512" end="00:33.624">and </span><span begin="00:33.624" end="00:33.736">all </span><span begin="00:33.736" end="00:33.848">I </span><span begin="00:33.848" end="00:33.960">want </span><span begin="00:33.960" end="00:34.072">to </span><span begin="00:34.072" end="00:34.184">say </span><span begin="00:34.184" end="00:34.300">is</span></p><p ttm:agent="v1" begin="00:34.300" end="00:39.250"><span begin="00:34.300" end="00:35.290">that </span><span begin="00:35.290" end="00:36.280">I </span><span begin="00:36.280" end="00:37.270">really </span><span begin="00:37.270" end="00:38.260">miss </span><span begin="00:38.260" end="00:39.250">you</span></p><p ttm:agent="v1" begin="00:39.250" end="00:40.830"><span begin="00:39.250" end="00:39.475">If </span><span begin="00:39.475" end="00:39.700">I </span><span begin="00:39.700" end="00:39.925">could </span><span begin="00:39.925" end="00:40.150">surf </span><span begin="00:40.150" end="00:40.375">a </span><span begin="00:40.375" end="00:40.600">little </span><span begin="00:40.600" end="00:40.830">better</span></p><p ttm:agent="v1" begin="00:40.860" end="00:43.050"><span begin="00:40.860" end="00:41.225">maybe </span><span begin="00:41.225" end="00:41.590">then </span><span begin="00:41.590" end="00:41.955">you'd </span><span begin="00:41.955" end="00:42.320">be </span><span begin="00:42.320" end="00:42.685">with </span><span begin="00:42.685" end="00:43.050">me</span></p><p ttm:agent="v1" begin="00:45.800" end="01:27.770"><span begin="00:45.800" end="00:47.850">If </span><span begin="00:47.850" end="00:48.370">only </span><span begin="00:48.370" end="01:09.760">I </span><span begin="01:09.760" end="01:23.280">had </span><span begin="01:23.280" end="01:27.680">more </span><span begin="01:27.680" end="01:27.770">time</span></p><p ttm:agent="v1" begin="01:35.200" end="01:41.460"><span begin="01:35.200" end="01:36.243">If </span><span begin="01:36.243" end="01:37.286">I </span><span begin="01:37.286" end="01:38.329">had </span><span begin="01:38.329" end="01:39.372">Mike </span><span begin="01:39.372" end="01:40.415">Ness' </span><span begin="01:40.415" end="01:41.460">hairline</span></p><p ttm:agent="v1" begin="01:41.460" end="01:52.130"><span begin="01:41.460" end="01:42.984">then </span><span begin="01:42.984" end="01:44.508">you'd </span><span begin="01:44.508" end="01:46.032">want </span><span begin="01:46.032" end="01:47.556">to </span><span begin="01:47.556" end="01:49.080">be </span><span begin="01:49.080" end="01:50.604">with </span><span begin="01:50.604" end="01:52.130">me</span></p><p ttm:agent="v1" begin="01:53.980" end="02:15.960"><span begin="01:53.980" end="01:57.120">But </span><span begin="01:57.120" end="02:00.260">for </span><span begin="02:00.260" end="02:03.400">now </span><span begin="02:03.400" end="02:06.540">I'll </span><span begin="02:06.540" end="02:09.680">have </span><span begin="02:09.680" end="02:12.820">to </span><span begin="02:12.820" end="02:15.960">dream</span></p><p ttm:agent="v1" begin="02:15.960" end="02:16.210"><span begin="02:15.960" end="02:16.085">By </span><span begin="02:16.085" end="02:16.210">LeVeL</span></p><p ttm:agent="v1" begin="02:16.210" end="02:20.030"><span begin="02:16.210" end="02:17.165">to </span><span begin="02:17.165" end="02:18.120">make </span><span begin="02:18.120" end="02:19.075">you </span><span begin="02:19.075" end="02:20.030">stay</span></p><p ttm:agent="v1" begin="02:20.030" end="02:21.380"><span begin="02:20.030" end="02:20.300">then </span><span begin="02:20.300" end="02:20.570">maybe </span><span begin="02:20.570" end="02:20.840">I'd </span><span begin="02:20.840" end="02:21.110">see </span><span begin="02:21.110" end="02:21.380">you</span></p><p ttm:agent="v1" begin="02:21.380" end="02:22.080"><span begin="02:21.380" end="02:21.555">If </span><span begin="02:21.555" end="02:21.730">I </span><span begin="02:21.730" end="02:21.905">woke </span><span begin="02:21.905" end="02:22.080">up</span></p><p ttm:agent="v1" begin="02:22.080" end="02:22.600"><span begin="02:22.080" end="02:22.210">with </span><span begin="02:22.210" end="02:22.340">all </span><span begin="02:22.340" end="02:22.470">these </span><span begin="02:22.470" end="02:22.600">things</span></p><p ttm:agent="v1" begin="02:23.690" end="02:25.400"><span begin="02:23.690" end="02:23.975">Would </span><span begin="02:23.975" end="02:24.260">it </span><span begin="02:24.260" end="02:24.545">even </span><span begin="02:24.545" end="02:24.830">change </span><span begin="02:24.830" end="02:25.115">your </span><span begin="02:25.115" end="02:25.400">feelings</span></p><p ttm:agent="v1" begin="02:27.360" end="02:28.100"><span begin="02:27.360" end="02:27.483">None </span><span begin="02:27.483" end="02:27.606">of </span><span begin="02:27.606" end="02:27.729">that </span><span begin="02:27.729" end="02:27.852">is </span><span begin="02:27.852" end="02:27.975">even </span><span begin="02:27.975" end="02:28.100">me</span></p><p ttm:agent="v1" begin="02:28.210" end="02:31.150"><span begin="02:28.210" end="02:29.190">But </span><span begin="02:29.190" end="02:30.170">for </span><span begin="02:30.170" end="02:31.150">now</span></p><p ttm:agent="v1" begin="02:31.150" end="02:35.140"><span begin="02:31.150" end="02:31.948">I'll </span><span begin="02:31.948" end="02:32.746">have </span><span begin="02:32.746" end="02:33.544">to </span><span begin="02:33.544" end="02:34.342">wait </span><span begin="02:34.342" end="02:35.140">another</span></p><p ttm:agent="v1" begin="02:35.140" end="02:50.420"><span begin="02:35.140" end="02:36.413">week </span><span begin="02:36.413" end="02:37.686">to </span><span begin="02:37.686" end="02:38.959">see </span><span begin="02:38.959" end="02:40.232">your </span><span begin="02:40.232" end="02:41.505">face </span><span begin="02:41.505" end="02:42.778">and </span><span begin="02:42.778" end="02:44.051">all </span><span begin="02:44.051" end="02:45.324">I </span><span begin="02:45.324" end="02:46.597">want </span><span begin="02:46.597" end="02:47.870">to </span><span begin="02:47.870" end="02:49.143">say </span><span begin="02:49.143" end="02:50.420">is</span></p><p ttm:agent="v1" begin="02:52.610" end="03:18.760"><span begin="02:52.610" end="02:57.840">that </span><span begin="02:57.840" end="03:03.070">I </span><span begin="03:03.070" end="03:08.300">really </span><span begin="03:08.300" end="03:13.530">miss </span><span begin="03:13.530" end="03:18.760">you</span></p></div></body></tt>