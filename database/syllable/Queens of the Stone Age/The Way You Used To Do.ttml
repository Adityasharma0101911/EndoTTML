<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>The Way You Used To Do</ttm:title><ttm:agent type="person" xml:id="v1">Queens of the Stone Age</ttm:agent><ttm:item type="album">Villains</ttm:item><ttm:item type="spotify_id">52LL3IFB8N3PaJmoZ8Xii1</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:16.720" end="00:18.190"><span begin="00:16.720" end="00:18.190">Seventeen</span></p><p ttm:agent="v1" begin="00:28.090" end="00:31.570"><span begin="00:28.090" end="00:28.570">Burned </span><span begin="00:28.570" end="00:31.570">alive</span></p><p ttm:agent="v1" begin="00:39.040" end="00:42.250"><span begin="00:39.040" end="00:39.460">Girl</span><span begin="00:39.460" end="00:39.460">, </span><span begin="00:39.460" end="00:39.700">we </span><span begin="00:39.700" end="00:40.600">outrun </span><span begin="00:40.600" end="00:42.250">everyone</span></p><p ttm:agent="v1" begin="00:47.650" end="00:49.600"><span begin="00:47.650" end="00:47.860">Like </span><span begin="00:47.860" end="00:48.040">the </span><span begin="00:48.040" end="00:48.340">way </span><span begin="00:48.340" end="00:48.520">you </span><span begin="00:48.520" end="00:48.910">used </span><span begin="00:48.910" end="00:49.030">to </span><span begin="00:49.030" end="00:49.600">do</span></p><p ttm:agent="v1" begin="01:02.260" end="01:04.780"><span begin="01:02.260" end="01:02.650">Fine </span><span begin="01:02.650" end="01:02.950">with </span><span begin="01:02.950" end="01:04.780">either</span></p><p ttm:agent="v1" begin="01:08.350" end="01:18.820"><span begin="01:08.350" end="01:16.870">They'll </span><span begin="01:16.870" end="01:18.820">terrorize</span></p><p ttm:agent="v1" begin="01:27.340" end="01:31.930"><span begin="01:27.340" end="01:27.580">If </span><span begin="01:27.580" end="01:27.700">the </span><span begin="01:27.700" end="01:28.240">world </span><span begin="01:28.240" end="01:29.530">exploded </span><span begin="01:29.530" end="01:30.550">behind </span><span begin="01:30.550" end="01:31.930">us</span></p><p ttm:agent="v1" begin="01:42.700" end="01:46.360"><span begin="01:42.700" end="01:43.030">I'll </span><span begin="01:43.030" end="01:43.750">bury </span><span begin="01:43.750" end="01:44.710">anyone </span><span begin="01:44.710" end="01:44.800">who </span><span begin="01:44.800" end="01:46.360">does</span></p><p ttm:agent="v1" begin="01:49.540" end="01:51.340"><span begin="01:49.540" end="01:49.810">Just </span><span begin="01:49.810" end="01:50.050">come </span><span begin="01:50.050" end="01:50.140">and </span><span begin="01:50.140" end="01:50.500">love </span><span begin="01:50.500" end="01:50.740">me </span><span begin="01:50.740" end="01:51.340">how</span></p><p ttm:agent="v1" begin="01:51.340" end="01:51.490"><span begin="01:51.340" end="01:51.490">Now</span></p><p ttm:agent="v1" begin="01:51.550" end="01:54.370"><span begin="01:51.550" end="01:51.760">The </span><span begin="01:51.760" end="01:52.030">way </span><span begin="01:52.030" end="01:52.210">you </span><span begin="01:52.210" end="01:52.660">used </span><span begin="01:52.660" end="01:52.780">to </span><span begin="01:52.780" end="01:54.370">do</span></p><p ttm:agent="v1" begin="02:30.460" end="02:32.080"><span begin="02:30.460" end="02:30.580">A </span><span begin="02:30.580" end="02:31.180">puppet </span><span begin="02:31.180" end="02:31.510">on </span><span begin="02:31.510" end="02:31.600">a </span><span begin="02:31.600" end="02:32.080">string</span></p><p ttm:agent="v1" begin="02:32.080" end="02:32.830"><span begin="02:32.080" end="02:32.470">C'est </span><span begin="02:32.470" end="02:32.770">la </span><span begin="02:32.770" end="02:32.830">vie</span></p><p ttm:agent="v1" begin="02:38.170" end="02:46.690"><span begin="02:38.170" end="02:38.620">So </span><span begin="02:38.620" end="02:38.980">lay </span><span begin="02:38.980" end="02:39.370">your </span><span begin="02:39.370" end="02:39.760">hands </span><span begin="02:39.760" end="02:40.240">across </span><span begin="02:40.240" end="02:40.420">my </span><span begin="02:40.420" end="02:41.080">beating </span><span begin="02:41.080" end="02:41.890">heart</span><span begin="02:41.890" end="02:43.270">, </span><span begin="02:43.270" end="02:46.690">love</span></p><p ttm:agent="v1" begin="02:55.270" end="02:59.980"><span begin="02:55.270" end="02:55.510">If </span><span begin="02:55.510" end="02:55.630">the </span><span begin="02:55.630" end="02:56.140">world </span><span begin="02:56.140" end="02:57.460">exploded </span><span begin="02:57.460" end="02:58.540">behind </span><span begin="02:58.540" end="02:59.980">us</span></p><p ttm:agent="v1" begin="03:10.720" end="03:14.230"><span begin="03:10.720" end="03:10.900">I'll </span><span begin="03:10.900" end="03:11.650">bury </span><span begin="03:11.650" end="03:12.580">anyone </span><span begin="03:12.580" end="03:12.670">who </span><span begin="03:12.670" end="03:14.230">does</span></p><p ttm:agent="v1" begin="03:17.410" end="03:21.760"><span begin="03:17.410" end="03:17.710">Just </span><span begin="03:17.710" end="03:18.010">come </span><span begin="03:18.010" end="03:18.100">and </span><span begin="03:18.100" end="03:18.490">love </span><span begin="03:18.490" end="03:18.760">me </span><span begin="03:18.760" end="03:21.760">how</span></p><p ttm:agent="v1" begin="03:22.690" end="03:24.790"><span begin="03:22.690" end="03:23.290">Used </span><span begin="03:23.290" end="03:23.410">to </span><span begin="03:23.410" end="03:24.790">do</span></p><p ttm:agent="v1" begin="03:37.810" end="03:41.290"><span begin="03:37.810" end="03:37.990">The </span><span begin="03:37.990" end="03:38.710">way </span><span begin="03:38.710" end="03:38.770">you </span><span begin="03:38.770" end="03:39.130">used </span><span begin="03:39.130" end="03:39.250">to </span><span begin="03:39.250" end="03:41.290">do</span></p><p ttm:agent="v1" begin="03:52.360" end="03:55.180"><span begin="03:52.360" end="03:52.750">Come </span><span begin="03:52.750" end="03:52.900">and </span><span begin="03:52.900" end="03:53.440">love </span><span begin="03:53.440" end="03:53.560">me </span><span begin="03:53.560" end="03:55.180">now</span></p><p ttm:agent="v1" begin="03:57.820" end="04:00.460"><span begin="03:57.820" end="03:58.030">The </span><span begin="03:58.030" end="03:58.450">way </span><span begin="03:58.450" end="03:58.690">you </span><span begin="03:58.690" end="03:59.140">used </span><span begin="03:59.140" end="03:59.230">to </span><span begin="03:59.230" end="04:00.460">do</span></p><p ttm:agent="v1" begin="04:02.860" end="04:06.340"><span begin="04:02.860" end="04:03.040">The </span><span begin="04:03.040" end="04:03.520">way </span><span begin="04:03.520" end="04:03.760">you </span><span begin="04:03.760" end="04:04.150">used </span><span begin="04:04.150" end="04:04.270">to </span><span begin="04:04.270" end="04:06.340">do</span></p></div></body></tt>