<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>How Did We Get So Dark?</ttm:title><ttm:agent type="person" xml:id="v1">Royal Blood</ttm:agent><ttm:item type="album">How Did We Get So Dark?</ttm:item><ttm:item type="spotify_id">51txLjbvSBRvtxjCjAFLkM</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:08.100" end="00:10.560"><span begin="00:08.100" end="00:08.370">I </span><span begin="00:08.370" end="00:08.880">saw </span><span begin="00:08.880" end="00:09.150">it </span><span begin="00:09.150" end="00:10.410">coming</span></p><p ttm:agent="v1" begin="00:10.560" end="00:15.240"><span begin="00:10.560" end="00:10.890">Like </span><span begin="00:10.890" end="00:10.950">a </span><span begin="00:10.950" end="00:12.030">shadow </span><span begin="00:12.030" end="00:12.660">on </span><span begin="00:12.660" end="00:12.780">the </span><span begin="00:12.780" end="00:14.070">road</span></p><p ttm:agent="v1" begin="00:15.240" end="00:18.120"><span begin="00:15.240" end="00:15.600">You </span><span begin="00:15.600" end="00:16.620">started </span><span begin="00:16.620" end="00:17.910">running</span></p><p ttm:agent="v1" begin="00:18.120" end="00:21.780"><span begin="00:18.120" end="00:18.420">We </span><span begin="00:18.420" end="00:19.050">never </span><span begin="00:19.050" end="00:19.560">felt </span><span begin="00:19.560" end="00:19.920">so </span><span begin="00:19.920" end="00:19.950"> </span><span begin="00:19.950" end="00:21.750">cold</span></p><p ttm:agent="v1" begin="00:21.780" end="00:25.260"><span begin="00:21.780" end="00:23.160">How </span><span begin="00:23.160" end="00:23.730">did </span><span begin="00:23.730" end="00:24.750">I</span></p><p ttm:agent="v1" begin="00:25.260" end="00:28.800"><span begin="00:25.260" end="00:25.980">Become </span><span begin="00:25.980" end="00:27.240">looking </span><span begin="00:27.240" end="00:28.740">like</span></p><p ttm:agent="v1" begin="00:28.800" end="00:32.490"><span begin="00:28.800" end="00:28.920">oh </span><span begin="00:28.920" end="00:29.940">someone </span><span begin="00:29.940" end="00:30.150">you </span><span begin="00:30.150" end="00:30.660">used </span><span begin="00:30.660" end="00:30.840">to </span><span begin="00:30.840" end="00:31.950">love</span></p><p ttm:agent="v1" begin="00:32.490" end="00:36.030"><span begin="00:32.490" end="00:33.570">Someone </span><span begin="00:33.570" end="00:33.780">you </span><span begin="00:33.780" end="00:34.290">used </span><span begin="00:34.290" end="00:34.440">to </span><span begin="00:34.440" end="00:35.910">love</span></p><p ttm:agent="v1" begin="00:36.030" end="00:39.810"><span begin="00:36.030" end="00:36.810">So </span><span begin="00:36.810" end="00:37.980"> </span><span begin="00:37.980" end="00:39.390">dark</span></p><p ttm:agent="v1" begin="00:39.810" end="00:45.300"><span begin="00:39.810" end="00:40.380">How </span><span begin="00:40.380" end="00:40.710">did </span><span begin="00:40.710" end="00:41.580">something </span><span begin="00:41.580" end="00:42.000">so </span><span begin="00:42.000" end="00:42.540">sweet </span><span begin="00:42.540" end="00:43.140">tear </span><span begin="00:43.140" end="00:43.380">us </span><span begin="00:43.380" end="00:44.820">apart</span></p><p ttm:agent="v1" begin="00:45.300" end="00:47.100"><span begin="00:45.300" end="00:46.500">Oh</span></p><p ttm:agent="v1" begin="00:47.100" end="00:52.530"><span begin="00:47.100" end="00:47.640">On </span><span begin="00:47.640" end="00:47.970">this </span><span begin="00:47.970" end="00:48.780">sinking </span><span begin="00:48.780" end="00:49.320">ship </span><span begin="00:49.320" end="00:49.680">with </span><span begin="00:49.680" end="00:49.830">a </span><span begin="00:49.830" end="00:50.700">heavy </span><span begin="00:50.700" end="00:51.840">heart</span></p><p ttm:agent="v1" begin="00:52.530" end="00:57.870"><span begin="00:52.530" end="00:56.760">Oh </span><span begin="00:56.760" end="00:56.850"> </span><span begin="00:56.850" end="00:57.210">oh</span></p><p ttm:agent="v1" begin="00:57.870" end="01:05.670"><span begin="00:57.870" end="00:59.250">How </span><span begin="00:59.250" end="00:59.520">did </span><span begin="00:59.520" end="00:59.760">we </span><span begin="00:59.760" end="01:00.840">get </span><span begin="01:00.840" end="01:00.960"> </span><span begin="01:00.960" end="01:01.500">so </span><span begin="01:01.500" end="01:03.690">dark</span><span begin="01:03.690" end="01:05.670">?</span></p><p ttm:agent="v1" begin="01:05.670" end="01:08.700"><span begin="01:05.670" end="01:06.900">Nobody </span><span begin="01:06.900" end="01:07.500">wants </span><span begin="01:07.500" end="01:07.650">your </span><span begin="01:07.650" end="01:08.670">love</span></p><p ttm:agent="v1" begin="01:08.700" end="01:13.140"><span begin="01:08.700" end="01:08.940">But </span><span begin="01:08.940" end="01:10.170">tables </span><span begin="01:10.170" end="01:10.410">were </span><span begin="01:10.410" end="01:12.240">turned</span></p><p ttm:agent="v1" begin="01:13.140" end="01:16.170"><span begin="01:13.140" end="01:13.410">I </span><span begin="01:13.410" end="01:13.860">could </span><span begin="01:13.860" end="01:14.070">have </span><span begin="01:14.070" end="01:14.670">told </span><span begin="01:14.670" end="01:15.870">you</span></p><p ttm:agent="v1" begin="01:16.170" end="01:19.140"><span begin="01:16.170" end="01:17.370">Everything </span><span begin="01:17.370" end="01:17.670">you </span><span begin="01:17.670" end="01:17.700"> </span><span begin="01:17.700" end="01:19.110">want</span></p><p ttm:agent="v1" begin="01:19.140" end="01:22.710"><span begin="01:19.140" end="01:19.560">We've </span><span begin="01:19.560" end="01:21.150">been </span><span begin="01:21.150" end="01:21.360">to </span><span begin="01:21.360" end="01:22.680">dust</span></p><p ttm:agent="v1" begin="01:22.710" end="01:26.280"><span begin="01:22.710" end="01:23.040">Now </span><span begin="01:23.040" end="01:23.250">there's </span><span begin="01:23.250" end="01:23.670">no </span><span begin="01:23.670" end="01:24.150">one </span><span begin="01:24.150" end="01:24.510">you </span><span begin="01:24.510" end="01:24.900">can </span><span begin="01:24.900" end="01:26.250">trust</span></p><p ttm:agent="v1" begin="01:26.280" end="01:30.270"><span begin="01:26.280" end="01:26.670">Just </span><span begin="01:26.670" end="01:27.750">someone </span><span begin="01:27.750" end="01:27.930">you </span><span begin="01:27.930" end="01:28.410">used </span><span begin="01:28.410" end="01:28.590">to </span><span begin="01:28.590" end="01:29.700">love</span></p><p ttm:agent="v1" begin="01:30.270" end="01:33.810"><span begin="01:30.270" end="01:31.290">Someone </span><span begin="01:31.290" end="01:31.530">you </span><span begin="01:31.530" end="01:32.040">used </span><span begin="01:32.040" end="01:32.190">to </span><span begin="01:32.190" end="01:33.630">love</span></p><p ttm:agent="v1" begin="01:33.810" end="01:37.560"><span begin="01:33.810" end="01:34.650">So </span><span begin="01:34.650" end="01:35.730"> </span><span begin="01:35.730" end="01:37.110">dark</span></p><p ttm:agent="v1" begin="01:37.560" end="01:43.050"><span begin="01:37.560" end="01:38.130">How </span><span begin="01:38.130" end="01:38.430">did </span><span begin="01:38.430" end="01:39.330">something </span><span begin="01:39.330" end="01:39.780">so </span><span begin="01:39.780" end="01:40.290">sweet </span><span begin="01:40.290" end="01:40.860">tear </span><span begin="01:40.860" end="01:41.100">us </span><span begin="01:41.100" end="01:42.570">apart</span></p><p ttm:agent="v1" begin="01:43.050" end="01:44.880"><span begin="01:43.050" end="01:44.310">Oh</span></p><p ttm:agent="v1" begin="01:44.880" end="01:50.280"><span begin="01:44.880" end="01:45.390">On </span><span begin="01:45.390" end="01:45.720">this </span><span begin="01:45.720" end="01:46.530">sinking </span><span begin="01:46.530" end="01:47.070">ship </span><span begin="01:47.070" end="01:47.430">with </span><span begin="01:47.430" end="01:47.610">a </span><span begin="01:47.610" end="01:48.420">heavy </span><span begin="01:48.420" end="01:50.190">heart</span></p><p ttm:agent="v1" begin="01:50.280" end="01:55.620"><span begin="01:50.280" end="01:54.300">Oh </span><span begin="01:54.300" end="01:55.050"> </span><span begin="01:55.050" end="01:55.590">oh</span></p><p ttm:agent="v1" begin="01:55.620" end="02:17.820"><span begin="01:55.620" end="01:57.000">How </span><span begin="01:57.000" end="01:57.270">did </span><span begin="01:57.270" end="01:57.480">we </span><span begin="01:57.480" end="01:58.650">get </span><span begin="01:58.650" end="01:58.680"> </span><span begin="01:58.680" end="01:59.220">so </span><span begin="01:59.220" end="02:01.710">dark</span><span begin="02:01.710" end="02:01.740">?</span></p><p ttm:agent="v1" begin="02:17.820" end="03:17.930"><span begin="02:17.820" end="02:18.240">How </span><span begin="02:18.240" end="02:18.780">we </span><span begin="02:18.780" end="02:25.680"> </span><span begin="02:25.680" end="02:26.160">get </span><span begin="02:26.160" end="02:26.190"> </span><span begin="02:26.190" end="02:26.730">so </span><span begin="02:26.730" end="03:00.840"> </span><span begin="03:00.840" end="03:01.320">dark</span><span begin="03:01.320" end="03:17.930">?</span