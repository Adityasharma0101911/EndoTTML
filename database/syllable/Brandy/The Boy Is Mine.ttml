<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>The Boy Is Mine</ttm:title><ttm:agent type="group" xml:id="v1">Brandy, Monica</ttm:agent><ttm:item type="album">Never Say Never</ttm:item><ttm:item type="spotify_id">6sHsXIJoEN5JpdkGMQDJxt</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.330" end="00:00.990"><span begin="00:00.330" end="00:00.450">The </span><span begin="00:00.450" end="00:00.630">boy </span><span begin="00:00.630" end="00:00.720">is </span><span begin="00:00.720" end="00:00.990">mine</span></p><p ttm:agent="v1" begin="00:01.020" end="00:01.710"><span begin="00:01.020" end="00:01.110">The </span><span begin="00:01.110" end="00:01.290">boy </span><span begin="00:01.290" end="00:01.410">is </span><span begin="00:01.410" end="00:01.710">mine</span></p><p ttm:agent="v1" begin="00:01.710" end="00:02.430"><span begin="00:01.710" end="00:01.800">The </span><span begin="00:01.800" end="00:02.010">boy </span><span begin="00:02.010" end="00:02.160">is </span><span begin="00:02.160" end="00:02.430">mine</span></p><p ttm:agent="v1" begin="00:02.430" end="00:03.240"><span begin="00:02.430" end="00:02.520">The </span><span begin="00:02.520" end="00:02.760">boy </span><span begin="00:02.760" end="00:02.910">is </span><span begin="00:02.910" end="00:03.240">mine</span></p><p ttm:agent="v1" begin="00:03.270" end="00:04.590"><span begin="00:03.270" end="00:03.390">The </span><span begin="00:03.390" end="00:03.660">boy </span><span begin="00:03.660" end="00:03.900">is </span><span begin="00:03.900" end="00:04.590">mine</span></p><p ttm:agent="v1" begin="00:25.170" end="00:27.600"><span begin="00:25.170" end="00:25.200">- </span><span begin="00:25.200" end="00:25.560">Excuse </span><span begin="00:25.560" end="00:25.710">me</span><span begin="00:25.710" end="00:25.710">! </span><span begin="00:25.710" end="00:25.830">Can </span><span begin="00:25.830" end="00:25.920">I</span><span begin="00:25.920" end="00:25.920">, </span><span begin="00:25.920" end="00:26.220">please</span><span begin="00:26.220" end="00:26.220">, </span><span begin="00:26.220" end="00:26.400">talk </span><span begin="00:26.400" end="00:26.490">to </span><span begin="00:26.490" end="00:26.550">you </span><span begin="00:26.550" end="00:26.700">for </span><span begin="00:26.700" end="00:26.730">a </span><span begin="00:26.730" end="00:27.420">minute</span><span begin="00:27.420" end="00:27.600">?</span></p><p ttm:agent="v1" begin="00:27.600" end="00:31.410"><span begin="00:27.600" end="00:27.630">- </span><span begin="00:27.630" end="00:27.660">Uh </span><span begin="00:27.660" end="00:28.350">huh</span><span begin="00:28.350" end="00:28.560">. </span><span begin="00:28.560" end="00:29.040">Sure</span><span begin="00:29.040" end="00:29.040">. </span><span begin="00:29.040" end="00:29.160">You </span><span begin="00:29.160" end="00:29.490">know</span><span begin="00:29.490" end="00:30.060">, </span><span begin="00:30.060" end="00:30.240">you </span><span begin="00:30.240" end="00:30.420">look </span><span begin="00:30.420" end="00:30.780">kinda </span><span begin="00:30.780" end="00:31.410">familiar</span></p><p ttm:agent="v1" begin="00:31.710" end="00:33.180"><span begin="00:31.710" end="00:31.770">- </span><span begin="00:31.770" end="00:32.100">Yeah</span><span begin="00:32.100" end="00:32.100">, </span><span begin="00:32.100" end="00:32.280">you </span><span begin="00:32.280" end="00:32.430">do </span><span begin="00:32.430" end="00:33.150">too</span><span begin="00:33.150" end="00:33.180">.</span></p><p ttm:agent="v1" begin="00:33.180" end="00:36.750"><span begin="00:33.180" end="00:33.570">But </span><span begin="00:33.570" end="00:33.660">I </span><span begin="00:33.660" end="00:33.840">just </span><span begin="00:33.840" end="00:34.080">wanted </span><span begin="00:34.080" end="00:34.170">to </span><span begin="00:34.170" end="00:34.410">know</span><span begin="00:34.410" end="00:34.410">, </span><span begin="00:34.410" end="00:34.560">do </span><span begin="00:34.560" end="00:34.710">you </span><span begin="00:34.710" end="00:35.070">know </span><span begin="00:35.070" end="00:35.580">somebody </span><span begin="00:35.580" end="00:36.510">named</span><span begin="00:36.510" end="00:36.590">.</span><span begin="00:36.590" end="00:36.670">.</span><span begin="00:36.670" end="00:36.750">.</span></p><p ttm:agent="v1" begin="00:36.750" end="00:38.010"><span begin="00:36.750" end="00:37.290">You </span><span begin="00:37.290" end="00:37.530">know </span><span begin="00:37.530" end="00:37.650">his </span><span begin="00:37.650" end="00:38.010">name</span></p><p ttm:agent="v1" begin="00:38.010" end="00:40.740"><span begin="00:38.010" end="00:38.400">- </span><span begin="00:38.400" end="00:38.580">Oh </span><span begin="00:38.580" end="00:38.820">yeah</span><span begin="00:38.820" end="00:38.850">, </span><span begin="00:38.850" end="00:39.450">definitely </span><span begin="00:39.450" end="00:39.570">I </span><span begin="00:39.570" end="00:39.870">know </span><span begin="00:39.870" end="00:40.050">his </span><span begin="00:40.050" end="00:40.740">name</span></p><p ttm:agent="v1" begin="00:40.830" end="00:42.780"><span begin="00:40.830" end="00:40.992">- </span><span begin="00:40.992" end="00:41.154">Well</span><span begin="00:41.154" end="00:41.316">, </span><span begin="00:41.316" end="00:41.478">I </span><span begin="00:41.478" end="00:41.640">just </span><span begin="00:41.640" end="00:41.802">want </span><span begin="00:41.802" end="00:41.964">to </span><span begin="00:41.964" end="00:42.126">let </span><span begin="00:42.126" end="00:42.288">you </span><span begin="00:42.288" end="00:42.450">that </span><span begin="00:42.450" end="00:42.612">he's </span><span begin="00:42.612" end="00:42.780">mine</span></p><p ttm:agent="v1" begin="00:42.990" end="00:46.200"><span begin="00:42.990" end="00:43.080">- </span><span begin="00:43.080" end="00:43.260">Huh</span><span begin="00:43.260" end="00:43.530">. </span><span begin="00:43.530" end="00:43.800">No</span><span begin="00:43.800" end="00:43.800">, </span><span begin="00:43.800" end="00:44.250">no</span><span begin="00:44.250" end="00:44.400">. </span><span begin="00:44.400" end="00:44.700">He's </span><span begin="00:44.700" end="00:45.390">mine</span><span begin="00:45.390" end="00:46.200">!</span></p><p ttm:agent="v1" begin="00:46.200" end="00:48.960"><span begin="00:46.200" end="00:46.500">You </span><span begin="00:46.500" end="00:46.920">need </span><span begin="00:46.920" end="00:47.220">to </span><span begin="00:47.220" end="00:47.640">give </span><span begin="00:47.640" end="00:47.970">it </span><span begin="00:47.970" end="00:48.960">up</span></p><p ttm:agent="v1" begin="00:48.990" end="00:51.660"><span begin="00:48.990" end="00:49.560">Had </span><span begin="00:49.560" end="00:50.190">about </span><span begin="00:50.190" end="00:51.660">enough</span></p><p ttm:agent="v1" begin="00:51.720" end="00:53.670"><span begin="00:51.720" end="00:52.080">It's </span><span begin="00:52.080" end="00:52.350">not </span><span begin="00:52.350" end="00:52.710">hard </span><span begin="00:52.710" end="00:52.860">to </span><span begin="00:52.860" end="00:53.670">see</span></p><p ttm:agent="v1" begin="00:53.700" end="00:56.610"><span begin="00:53.700" end="00:54.240">The </span><span begin="00:54.240" end="00:54.960">boy </span><span begin="00:54.960" end="00:55.590">is </span><span begin="00:55.590" end="00:56.610">mine</span></p><p ttm:agent="v1" begin="00:56.880" end="00:59.220"><span begin="00:56.880" end="00:57.150">I'm </span><span begin="00:57.150" end="00:57.840">sorry </span><span begin="00:57.840" end="00:58.200">that </span><span begin="00:58.200" end="00:59.220">you</span></p><p ttm:agent="v1" begin="00:59.280" end="01:01.950"><span begin="00:59.280" end="00:59.760">Seem </span><span begin="00:59.760" end="01:00.030">to </span><span begin="01:00.030" end="01:00.360">be </span><span begin="01:00.360" end="01:01.950">confused</span></p><p ttm:agent="v1" begin="01:01.980" end="01:03.930"><span begin="01:01.980" end="01:02.340">He </span><span begin="01:02.340" end="01:03.000">belongs </span><span begin="01:03.000" end="01:03.180">to </span><span begin="01:03.180" end="01:03.930">me</span></p><p ttm:agent="v1" begin="01:03.960" end="01:06.510"><span begin="01:03.960" end="01:04.530">The </span><span begin="01:04.530" end="01:05.250">boy </span><span begin="01:05.250" end="01:05.910">is </span><span begin="01:05.910" end="01:06.510">mine</span></p><p ttm:agent="v1" begin="01:06.540" end="01:08.970"><span begin="01:06.540" end="01:06.930">Think </span><span begin="01:06.930" end="01:07.200">it's </span><span begin="01:07.200" end="01:07.560">time </span><span begin="01:07.560" end="01:07.650">we </span><span begin="01:07.650" end="01:07.980">got </span><span begin="01:07.980" end="01:08.310">this </span><span begin="01:08.310" end="01:08.970">straight</span></p><p ttm:agent="v1" begin="01:09.060" end="01:11.730"><span begin="01:09.060" end="01:09.510">Sit </span><span begin="01:09.510" end="01:09.720">and </span><span begin="01:09.720" end="01:10.230">talk </span><span begin="01:10.230" end="01:10.590">face </span><span begin="01:10.590" end="01:10.860">to </span><span begin="01:10.860" end="01:11.730">face</span></p><p ttm:agent="v1" begin="01:11.730" end="01:14.100"><span begin="01:11.730" end="01:11.940">There </span><span begin="01:11.940" end="01:12.030">is </span><span begin="01:12.030" end="01:12.330">no </span><span begin="01:12.330" end="01:12.720">way </span><span begin="01:12.720" end="01:12.810">you </span><span begin="01:12.810" end="01:13.080">could </span><span begin="01:13.080" end="01:14.100">mistake</span></p><p ttm:agent="v1" begin="01:14.160" end="01:16.740"><span begin="01:14.160" end="01:14.280">Him </span><span begin="01:14.280" end="01:14.580">for </span><span begin="01:14.580" end="01:14.820">your </span><span begin="01:14.820" end="01:15.330">man</span><span begin="01:15.330" end="01:15.330">, </span><span begin="01:15.330" end="01:15.390">are </span><span begin="01:15.390" end="01:15.780">you </span><span begin="01:15.780" end="01:16.740">insane</span><span begin="01:16.740" end="01:16.740">?</span></p><p ttm:agent="v1" begin="01:16.740" end="01:19.200"><span begin="01:16.740" end="01:16.830">But </span><span begin="01:16.830" end="01:17.280">see </span><span begin="01:17.280" end="01:17.520">I </span><span begin="01:17.520" end="01:17.820">know </span><span begin="01:17.820" end="01:18.030">that </span><span begin="01:18.030" end="01:18.210">you </span><span begin="01:18.210" end="01:18.630">may </span><span begin="01:18.630" end="01:19.200">be</span></p><p ttm:agent="v1" begin="01:19.350" end="01:21.750"><span begin="01:19.350" end="01:19.680">Just </span><span begin="01:19.680" end="01:19.710">a </span><span begin="01:19.710" end="01:20.070">bit </span><span begin="01:20.070" end="01:20.970">jealous </span><span begin="01:20.970" end="01:21.150">of </span><span begin="01:21.150" end="01:21.750">me</span></p><p ttm:agent="v1" begin="01:21.930" end="01:24.360"><span begin="01:21.930" end="01:22.410">But </span><span begin="01:22.410" end="01:22.530">you're </span><span begin="01:22.530" end="01:23.070">blind </span><span begin="01:23.070" end="01:23.190">if </span><span begin="01:23.190" end="01:23.460">you </span><span begin="01:23.460" end="01:23.790">can't </span><span begin="01:23.790" end="01:24.360">see</span></p><p ttm:agent="v1" begin="01:24.540" end="01:27.090"><span begin="01:24.540" end="01:24.990">That </span><span begin="01:24.990" end="01:25.140">his </span><span begin="01:25.140" end="01:25.650">love </span><span begin="01:25.650" end="01:25.800">is </span><span begin="01:25.800" end="01:26.160">all </span><span begin="01:26.160" end="01:26.310">in </span><span begin="01:26.310" end="01:27.090">me</span></p><p ttm:agent="v1" begin="01:27.090" end="01:29.580"><span begin="01:27.090" end="01:27.570">See</span><span begin="01:27.570" end="01:27.570">, </span><span begin="01:27.570" end="01:27.750">I </span><span begin="01:27.750" end="01:28.170">tried </span><span begin="01:28.170" end="01:28.230">to </span><span begin="01:28.230" end="01:29.580">hesitate</span></p><p ttm:agent="v1" begin="01:29.640" end="01:31.980"><span begin="01:29.640" end="01:29.730">I </span><span begin="01:29.730" end="01:30.090">didn't </span><span begin="01:30.090" end="01:30.270">want </span><span begin="01:30.270" end="01:30.330">to </span><span begin="01:30.330" end="01:30.690">say </span><span begin="01:30.690" end="01:30.870">what </span><span begin="01:30.870" end="01:31.170">he </span><span begin="01:31.170" end="01:31.470">told </span><span begin="01:31.470" end="01:31.980">me</span></p><p ttm:agent="v1" begin="01:32.010" end="01:34.890"><span begin="01:32.010" end="01:32.280">He </span><span begin="01:32.280" end="01:32.520">said </span><span begin="01:32.520" end="01:32.910">without </span><span begin="01:32.910" end="01:33.390">me </span><span begin="01:33.390" end="01:33.420">he </span><span begin="01:33.420" end="01:33.990">couldn't </span><span begin="01:33.990" end="01:34.800">make </span><span begin="01:34.800" end="01:34.890">it</span></p><p ttm:agent="v1" begin="01:34.890" end="01:37.350"><span begin="01:34.890" end="01:35.190">Through </span><span beg