<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Ghost</ttm:title><ttm:agent type="person" xml:id="v1">Katy Perry</ttm:agent><ttm:item type="album">PRISM (Deluxe)</ttm:item><ttm:item type="spotify_id">665T5MrQUl7sSwivPm7pEW</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:09.000" end="00:10.800"><span begin="00:09.000" end="00:09.240">You </span><span begin="00:09.240" end="00:09.630">sent </span><span begin="00:09.630" end="00:09.690">a  </span><span begin="00:09.690" end="00:10.800">text</span></p><p ttm:agent="v1" begin="00:12.900" end="00:16.350"><span begin="00:12.900" end="00:13.110">It's </span><span begin="00:13.110" end="00:13.380">like </span><span begin="00:13.380" end="00:13.560">the </span><span begin="00:13.560" end="00:14.190">wind </span><span begin="00:14.190" end="00:14.880">changed </span><span begin="00:14.880" end="00:15.120">your </span><span begin="00:15.120" end="00:16.350">mind</span></p><p ttm:agent="v1" begin="00:16.590" end="00:18.630"><span begin="00:16.590" end="00:16.950">We </span><span begin="00:16.950" end="00:17.160">were </span><span begin="00:17.160" end="00:17.460">best </span><span begin="00:17.460" end="00:18.630">friends</span></p><p ttm:agent="v1" begin="00:20.520" end="00:22.830"><span begin="00:20.520" end="00:20.820">Yeah</span><span begin="00:20.820" end="00:20.820">, </span><span begin="00:20.820" end="00:21.030">we </span><span begin="00:21.030" end="00:21.240">were </span><span begin="00:21.240" end="00:21.840">burning </span><span begin="00:21.840" end="00:21.990">our </span><span begin="00:21.990" end="00:22.830">lives</span></p><p ttm:agent="v1" begin="00:22.860" end="00:26.820"><span begin="00:22.860" end="00:23.250">With </span><span begin="00:23.250" end="00:24.090">every </span><span begin="00:24.090" end="00:24.630">kiss</span><span begin="00:24.630" end="00:24.690">, </span><span begin="00:24.690" end="00:25.230">and </span><span begin="00:25.230" end="00:26.010">every </span><span begin="00:26.010" end="00:26.820">letter</span></p><p ttm:agent="v1" begin="00:27.030" end="00:31.800"><span begin="00:27.030" end="00:27.840">Every </span><span begin="00:27.840" end="00:29.010">promise </span><span begin="00:29.010" end="00:29.370">of </span><span begin="00:29.370" end="00:30.870">forever</span><span begin="00:30.870" end="00:30.930">, </span><span begin="00:30.930" end="00:31.800">oh</span></p><p ttm:agent="v1" begin="00:32.010" end="00:33.990"><span begin="00:32.010" end="00:32.340">But </span><span begin="00:32.340" end="00:32.550">you </span><span begin="00:32.550" end="00:32.760">hit </span><span begin="00:32.760" end="00:33.990">send</span></p><p ttm:agent="v1" begin="00:35.460" end="00:38.190"><span begin="00:35.460" end="00:35.670">And </span><span begin="00:35.670" end="00:36.480">disappeared </span><span begin="00:36.480" end="00:36.600">in </span><span begin="00:36.600" end="00:36.990">front </span><span begin="00:36.990" end="00:37.110">of </span><span begin="00:37.110" end="00:37.410">my </span><span begin="00:37.410" end="00:38.190">eyes</span></p><p ttm:agent="v1" begin="00:38.190" end="00:42.870"><span begin="00:38.190" end="00:38.610">And </span><span begin="00:38.610" end="00:39.960">now </span><span begin="00:39.960" end="00:40.230">you</span><span begin="00:40.230" end="00:40.260">’</span><span begin="00:40.260" end="00:40.320">re </span><span begin="00:40.320" end="00:41.550">just </span><span begin="00:41.550" end="00:42.090">a </span><span begin="00:42.090" end="00:42.870">ghost</span></p><p ttm:agent="v1" begin="00:42.900" end="00:46.290"><span begin="00:42.900" end="00:43.200">When </span><span begin="00:43.200" end="00:43.350">I </span><span begin="00:43.350" end="00:43.830">look </span><span begin="00:43.830" end="00:44.340">back </span><span begin="00:44.340" end="00:44.790">never </span><span begin="00:44.790" end="00:45.120">would </span><span begin="00:45.120" end="00:45.210">have </span><span begin="00:45.210" end="00:45.780">known </span><span begin="00:45.780" end="00:46.290">that</span></p><p ttm:agent="v1" begin="00:46.290" end="00:50.580"><span begin="00:46.290" end="00:47.640">You </span><span begin="00:47.640" end="00:47.970">could </span><span begin="00:47.970" end="00:48.930">be </span><span begin="00:48.930" end="00:49.740">so </span><span begin="00:49.740" end="00:50.580">cold</span></p><p ttm:agent="v1" begin="00:50.580" end="00:53.940"><span begin="00:50.580" end="00:50.880">Like </span><span begin="00:50.880" end="00:50.940">a </span><span begin="00:50.940" end="00:51.960">stranger </span><span begin="00:51.960" end="00:52.530">vanish </span><span begin="00:52.530" end="00:52.830">like </span><span begin="00:52.830" end="00:52.920">a </span><span begin="00:52.920" end="00:53.940">vapor</span></p><p ttm:agent="v1" begin="00:53.940" end="00:57.300"><span begin="00:53.940" end="00:54.450">There's </span><span begin="00:54.450" end="00:54.750">just </span><span begin="00:54.750" end="00:54.930">an </span><span begin="00:54.930" end="00:55.410">echo </span><span begin="00:55.410" end="00:55.620">where </span><span begin="00:55.620" end="00:55.800">your </span><span begin="00:55.800" end="00:56.100">heart </span><span begin="00:56.100" end="00:56.400">used </span><span begin="00:56.400" end="00:56.490">to </span><span begin="00:56.490" end="00:57.300">be</span></p><p ttm:agent="v1" begin="00:57.540" end="01:00.810"><span begin="00:57.540" end="00:58.320">Now </span><span begin="00:58.320" end="00:58.530">I </span><span begin="00:58.530" end="00:59.250">see </span><span begin="00:59.250" end="00:59.430">it </span><span begin="00:59.430" end="01:00.810">clearly</span></p><p ttm:agent="v1" begin="01:01.140" end="01:04.890"><span begin="01:01.140" end="01:01.590">And </span><span begin="01:01.590" end="01:02.100">there's </span><span begin="01:02.100" end="01:02.400">just </span><span begin="01:02.400" end="01:02.490">a </span><span begin="01:02.490" end="01:03.060">pillow </span><span begin="01:03.060" end="01:03.210">where </span><span begin="01:03.210" end="01:03.450">your </span><span begin="01:03.450" end="01:03.780">head </span><span begin="01:03.780" end="01:04.080">used </span><span begin="01:04.080" end="01:04.170">to </span><span begin="01:04.170" end="01:04.890">sleep</span></p><p ttm:agent="v1" begin="01:05.130" end="01:08.010"><span begin="01:05.130" end="01:05.430">My </span><span begin="01:05.430" end="01:06.390">vision's </span><span begin="01:06.390" end="01:07.080">20</span><span begin="01:07.080" end="01:07.080">/</span><span begin="01:07.080" end="01:08.010">20</span></p><p ttm:agent="v1" begin="01:08.100" end="01:10.140"><span begin="01:08.100" end="01:08.220">I </span><span begin="01:08.220" end="01:08.550">see </span><span begin="01:08.550" end="01:08.760">through </span><span begin="01:08.760" end="01:09.210">you </span><span begin="01:09.210" end="01:10.140">now</span></p><p ttm:agent="v1" begin="01:10.320" end="01:12.240"><span begin="01:10.320" end="01:11.010">Something </span><span begin="01:11.010" end="01:11.220">is </span><span begin="01:11.220" end="01:12.240">tight</span></p><p ttm:agent="v1" begin="01:13.920" end="01:17.970"><span begin="01:13.920" end="01:14.280">Now </span><span begin="01:14.280" end="01:14.640">that </span><span begin="01:14.640" end="01:14.760">I </span><span begin="01:14.760" end="01:15.030">have </span><span begin="01:15.030" end="01:15.780">made </span><span begin="01:15.780" end="01:16.080">up </span><span begin="01:16.080" end="01:16.530">my </span><span begin="01:16.530" end="01:17.970">mind</span></p><p ttm:agent="v1" begin="01:18.120" end="01:21.600"><span begin="01:18.120" end="01:18.390">I'll </span><span begin="01:18.390" end="01:18.720">be </span><span begin="01:18.720" end="01:21.600">alright</span></p><p ttm:agent="v1" begin="01:21.960" end="01:24.210"><span begin="01:21.960" end="01:22.260">It </span><span begin="01:22.260" end="01:22.680">doesn't </span><span begin="01:22.680" end="01:23.010">harm </span><span begin="01:23.010" end="01:23.250">me </span><span begin="01:23.250" end="01:23.400">at </span><span begin="01:23.400" end="01:24.210">night</span></p><p ttm:agent="v1" begin="01:24.240" end="01:32.160"><span begin="01:24.240" end="01:24.720">'Cause </span><span begin="01:24.720" end="01:25.560">every </span><span begin="01:25.560" end="01:26.070">gift</span><span begin="01:26.070" end="01:26.100">, </span><span begin="01:26.100" end="01:27.390">every </span><span begin="01:27.390" end="01:28.320">letter</span><span begin="01:28.320" end="01:28.500">, </span><span begin="01:28.500" end="01:29.400">every </span><span begin="01:29.400" end="01:30.450">promise </span><span begin="01:30.450" end="01:30.810">of </span><span begin="01:30.810" end="01:32.160">forever</span></p><p ttm:agent="v1" begin="01:32.160" end="01:35.580"><span begin="01:32.160" end="01:33.120">Now</span><span begin="01:33.120" end="01:33.480">, </span><span begin="01:33.480" end="01:33.870">it's </span><span begin="01:33.870" end="01:34.140">out </span><span begin="01:34.140" end="01:34.200">of </span><span begin="01:34.200" end="01:35.580">sight</span></p><p ttm:agent="v1" begin="01:37.320" end="01:39.600"><span begin="01:37.320" end="01:37.680">Like </span><span begin="01:37.680" end="01:37.860">you </span><span begin="01:37.860" end="01:38.010">were </span><span begin="01:38.010" end="01:38.640">never </span><span begin="01:38.640" end="01:39.600">alive</span></p><p ttm:agent="v1" begin="01:39.630" end="01:44.310"><span begin="01:39.630" end="01:40.050">And </span><span begin="01:40.050" end="01:41.400">now </span><span begin="01:41.400" end="01:41.670">you</span><span begin="01:41.670" end="01:41.700">’</span><span begin="01:41.700" end="01:41.760">re </span><span begin="01:41.760" end="01:42.990">just </span><span begin="01:42.990" end="01:43.530">a </span><span begin="01:43.530" end="01:44.310">ghost</span></p><p ttm:agent="v1" begin="01:44.340" end="01:47.730"><span begin="01:44.340" end="01:44.640">When </span><span begin="01:44.640" end="01:44.790">I </span><span begin="01:44.790" end="01:45.270">look </span><span begin="01:45.270" end="01:45.780">back </span><span begin="01:45.780" end="01:46.230">never </span><span begin="01:46.230" end="01:46.560">would </span><span begin="01:46.560" end="01:46.680">have </span><span begin="01:46.680" end="01:47.220">known </span><span begin="01:47.220" end="01:47.730">that</span></p><p ttm:agent="v1" begin="01:47.730" end="01:52.080"><span begin="01:47.730" end="01:49.080">You </span><span begin="01:49.080" end="01:49.410">could </span><span begin="01:49.410" end="01:50.370">be </span><span begin="01:50.370" end="01:51.150">so </span><span begin="01:51.150" end="01:52.080">cold</span></p><p ttm:agent="v1" begin="01:52.080" end="01:55.380"><span begin="01:52.080" end="01:52.320">Like </span><span begin="01:52.320" end="01:52.380">a </span><span begin="01:52.380" end="01:53.370">stranger </span><span begin="01:53.370" end="01:53.970">vanish </span><span begin="01:53.970" end="01:54.270">like </span><span begin="01:54.270" end="01:54.360">a </span><span begin="01:54.360" end="01:55.380">vapor</span></p><p ttm:agent="v1" begin="01:55.380" end="01:58.740"><span begin="01:55.380" end="01:55.890">There's </span><span begin="01:55.890" end="01:56.190">just </span><span begin="01:56.190" end="01:56.370">an </span><span begin="01:56.370" end="01:56.850">echo </span><span begin="01:56.850" end="01:57.000">where </span><span begin="01:57.000" end="01:57.210">your </span><span begin="01:57.210" end="01:57.570">heart </span><span begin="01:57.570" end="01:57.840">used </span><span begin="01:57.840" end="01:57.930">to </span><span begin="01:57.930" end="01:58.740">be</span></p><p ttm:agent="v1" begin="01:58.980" end="02:02.280"><span begin="01:58.980" end="01:59.790">Now </span><span begin="01:59.790" end="01:59.970">I </span><span begin="01:59.970" end="02:00.720">see </span><span begin="02:00.720" end="02:00.840">it </span><span begin="02:00.840" end="02:02.280">clearly</span></p><p ttm:agent="v1" begin="02:02.580" end="02:06.240"><span begin="02:02.580" end="02:03.030">And </span><span begin="02:03.030" end="02:03.540">there's </span><span begin="02:03.540" end="02:03.840">just </span><span begin="02:03.840" end="02:03.930">a </span><span begin="02:03.930" end="02:04.500">pillow </span><span begin="02:04.500" end="02:04.710">where </span><span begin="02:04.710" end="02:04.890">your </span><span begin="02:04.890" end="02:05.220">head </span><span begin="02:05.220" end="02:05.520">used </span><span begin="02:05.520" end="02:05.610">to </span><span begin="02:05.610" end="02:06.240">sleep</span></p><p ttm:agent="v1" begin="02:06.270" end="02:09.510"><span begin="02:06.270" end="02:06.870">My </span><span begin="02:06.870" end="02:07.830">vision's </span><span begin="02:07.830" end="02:08.490">20</span><span begin="02:08.490" end="02:08.490">/</span><span begin="02:08.490" end="02:09.510">20</span></p><p ttm:agent="v1" begin="02:09.540" end="02:11.160"><span begin="02:09.540" end="02:09.660">I </span><span begin="02:09.660" end="02:09.960">see </span><span begin="02:09.960" end="02:10.170">through </span><span begin="02:10.170" end="02:10.650">you </span><span begin="02:10.650" end="02:11.160">now</span></p><p ttm:agent="v1" begin="02:11.160" end