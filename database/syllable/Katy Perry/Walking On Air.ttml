40" end="00:14.910">air</span></p><p ttm:agent="v1" begin="00:15.270" end="00:18.390"><span begin="00:15.270" end="00:15.420">You're </span><span begin="00:15.420" end="00:15.900">givine </span><span begin="00:15.900" end="00:16.470">me </span><span begin="00:16.470" end="00:16.890">sweet</span><span begin="00:16.890" end="00:16.890">, </span><span begin="00:16.890" end="00:17.280">sweet </span><span begin="00:17.280" end="00:18.390">ecstasy</span></p><p ttm:agent="v1" begin="00:18.420" end="00:22.410"><span begin="00:18.420" end="00:18.840">Yeah</span><span begin="00:18.840" end="00:18.840">, </span><span begin="00:18.840" end="00:19.080">you </span><span begin="00:19.080" end="00:19.830">take </span><span begin="00:19.830" end="00:20.070">me </span><span begin="00:20.070" end="00:20.730">to </span><span begin="00:20.730" end="00:22.410">utopia</span></p><p ttm:agent="v1" begin="00:22.680" end="00:25.890"><span begin="00:22.680" end="00:22.920">You're </span><span begin="00:22.920" end="00:23.400">reading </span><span begin="00:23.400" end="00:24.060">me </span><span begin="00:24.060" end="00:24.630">like </span><span begin="00:24.630" end="00:25.740">erotica</span><span begin="00:25.740" end="00:25.890">,</span></p><p ttm:agent="v1" begin="00:25.890" end="00:29.910"><span begin="00:25.890" end="00:26.310">Boy</span><span begin="00:26.310" end="00:26.310">, </span><span begin="00:26.310" end="00:26.580">you </span><span begin="00:26.580" end="00:27.330">make </span><span begin="00:27.330" end="00:27.540">me </span><span begin="00:27.540" end="00:28.350">feel </span><span begin="00:28.350" end="00:29.040">exotic</span><span begin="00:29.040" end="00:29.040">, </span><span begin="00:29.040" end="00:29.910">yeah</span></p><p ttm:agent="v1" begin="00:30.300" end="00:33.570"><span begin="00:30.300" end="00:30.840">Just </span><span begin="00:30.840" end="00:31.200">when </span><span begin="00:31.200" end="00:31.320">I </span><span begin="00:31.320" end="00:31.800">think </span><span begin="00:31.800" end="00:31.980">I </span><span begin="00:31.980" end="00:32.280">can't </span><span begin="00:32.280" end="00:32.790">take </span><span begin="00:32.790" end="00:33.570">anymore</span></p><p ttm:agent="v1" begin="00:33.600" end="00:37.320"><span begin="00:33.600" end="00:33.840">We </span><span begin="00:33.840" end="00:34.080">go </span><span begin="00:34.080" end="00:34.860">deeper </span><span begin="00:34.860" end="00:35.040">and </span><span begin="00:35.040" end="00:35.730">harder </span><span begin="00:35.730" end="00:36.090">than </span><span begin="00:36.090" end="00:36.630">ever </span><span begin="00:36.630" end="00:37.320">before</span></p><p ttm:agent="v1" begin="00:37.320" end="00:39.570"><span begin="00:37.320" end="00:37.530">We </span><span begin="00:37.530" end="00:37.830">go </span><span begin="00:37.830" end="00:38.610">higher </span><span begin="00:38.610" end="00:38.790">and </span><span begin="00:38.790" end="00:39.570">higher</span></p><p ttm:agent="v1" begin="00:39.570" end="00:44.010"><span begin="00:39.570" end="00:39.690">I </span><span begin="00:39.690" end="00:40.110">feel </span><span begin="00:40.110" end="00:40.530">like </span><span begin="00:40.530" end="00:40.770">I'm </span><span begin="00:40.770" end="00:41.640">already </span><span begin="00:41.640" end="00:44.010">there</span></p><p ttm:agent="v1" begin="00:44.190" end="00:50.760"><span begin="00:44.190" end="00:44.460">I'm </span><span begin="00:44.460" end="00:45.120">walking </span><span begin="00:45.120" end="00:45.270">on </span><span begin="00:45.270" end="00:45.870">air </span><span begin="00:45.870" end="00:45.870">（</span><span begin="00:45.870" end="00:47.940">tonight</span><span begin="00:47.940" end="00:48.000">） </span><span begin="00:48.000" end="00:48.240">I'm </span><span begin="00:48.240" end="00:48.750">walking </span><span begin="00:48.750" end="00:48.990">on </span><span begin="00:48.990" end="00:50.760">air</span></p><p ttm:agent="v1" begin="00:50.820" end="00:55.500"><span begin="00:50.820" end="00:51.000">I'm </span><span begin="00:51.000" end="00:51.570">walking</span><span begin="00:51.570" end="00:51.570">, </span><span begin="00:51.570" end="00:51.750">I'm </span><span begin="00:51.750" end="00:52.260">walking </span><span begin="00:52.260" end="00:52.530">on </span><span begin="00:52.530" end="00:53.310">air </span><span begin="00:53.310" end="00:53.340">（</span><span begin="00:53.340" end="00:55.440">tonight</span><span begin="00:55.440" end="00:55.500">）</span></p><p ttm:agent="v1" begin="00:55.500" end="01:03.000"><span begin="00:55.500" end="00:55.740">I'm </span><span begin="00:55.740" end="00:56.250">walking </span><span begin="00:56.250" end="00:56.520">on </span><span begin="00:56.520" end="00:57.810">air</span><span begin="00:57.810" end="00:59.190">, </span><span begin="00:59.190" end="00:59.460">I'm </span><span begin="00:59.460" end="01:00.120">walking </span><span begin="01:00.120" end="01:00.270">on </span><span begin="01:00.270" end="01:00.870">air </span><span begin="01:00.870" end="01:00.870">（</span><span begin="01:00.870" end="01:02.760">tonight</span><span begin="01:02.760" end="01:03.000">）</span></p><p ttm:agent="v1" begin="01:03.000" end="01:05.670"><span begin="01:03.000" end="01:03.240">I'm </span><span begin="01:03.240" end="01:03.750">walking </span><span begin="01:03.750" end="01:03.990">on </span><span begin="01:03.990" end="01:05.670">air</span></p><p ttm:agent="v1" begin="01:05.820" end="01:10.500"><span begin="01:05.820" end="01:06.030">I'm </span><span begin="01:06.030" end="01:06.570">walking</span><span begin="01:06.570" end="01:06.570">, </span><span begin="01:06.570" end="01:06.750">I'm </span><span begin="01:06.750" end="01:07.260">walking </span><span begin="01:07.260" end="01:07.530">on </span><span begin="01:07.530" end="01:08.280">air </span><span begin="01:08.280" end="01:08.310">（</span><span begin="01:08.310" end="01:10.260">tonight</span><span begin="01:10.260" end="01:10.500">）</span></p><p ttm:agent="v1" begin="01:10.500" end="01:16.560"><span begin="01:10.500" end="01:10.740">I'm </span><span begin="01:10.740" end="01:11.280">walking </span><span begin="01:11.280" end="01:11.520">on </span><span begin="01:11.520" end="01:13.620">air</span><span begin="01:13.620" end="01:14.190">, </span><span begin="01:14.190" end="01:14.430">I'm </span><span begin="01:14.430" end="01:15.060">walking </span><span begin="01:15.060" end="01:15.270">on </span><span begin="01:15.270" end="01:16.560">air</span></p><p ttm:agent="v1" begin="01:16.560" end="01:19.170"><span begin="01:16.560" end="01:16.590">（</span><span begin="01:16.590" end="01:16.830">to</span><span begin="01:16.830" end="01:16.860">-</span><span begin="01:16.860" end="01:17.010">to</span><span begin="01:17.010" end="01:17.130">-</span><span begin="01:17.130" end="01:18.420">tonight</span><span begin="01:18.420" end="01:18.420">, </span><span begin="01:18.420" end="01:18.570">to</span><span begin="01:18.570" end="01:18.750">-</span><span begin="01:18.750" end="01:19.170">to</span><span begin="01:19.170" end="01:19.170">）</span></p><p ttm:agent="v1" begin="01:19.170" end="01:26.310"><span begin="01:19.170" end="01:20.310">There's </span><span begin="01:20.310" end="01:20.970">disco </span><span begin="01:20.970" end="01:22.230">paradise</span><span begin="01:22.230" end="01:22.230">, </span><span begin="01:22.230" end="01:22.830">even </span><span begin="01:22.830" end="01:23.640">heaven </span><span begin="01:23.640" end="01:23.820">is </span><span begin="01:23.820" end="01:24.870">jealous </span><span begin="01:24.870" end="01:25.080">of </span><span begin="01:25.080" end="01:25.230">our </span><span begin="01:25.230" end="01:26.310">love</span></p><p ttm:agent="v1" begin="01:26.520" end="01:33.720"><span begin="01:26.520" end="01:27.780">Yes</span><span begin="01:27.780" end="01:27.810">, </span><span begin="01:27.810" end="01:28.140">we </span><span begin="01:28.140" end="01:28.560">make </span><span begin="01:28.560" end="01:29.040">angels </span><span begin="01:29.040" end="01:29.640">cry</span><span begin="01:29.640" end="01:29.670">, </span><span begin="01:29.670" end="01:30.390">raining </span><span begin="01:30.390" end="01:31.140">down </span><span begin="01:31.140" end="01:31.440">on </span><span begin="01:31.440" end="01:32.040">earth </span><span begin="01:32.040" end="01:32.340">from </span><span begin="01:32.340" end="01:32.580">up </span><span begin="01:32.580" end="01:33.720">above</span></p><p ttm:agent="v1" begin="01:34.020" end="01:37.320"><span begin="01:34.020" end="01:34.590">Just </span><span begin="01:34.590" end="01:34.920">when </span><span begin="01:34.920" end="01:35.070">I </span><span begin="01:35.070" end="01:35.550">think </span><span begin="01:35.550" end="01:35.730">I </span><span begin="01:35.730" end="01:36.030">can't </span><span begin="01:36.030" end="01:36.510">take </span><span begin="01:36.510" end="01:37.320">anymore</span></p><p ttm:agent="v1" begin="01:37.320" end="01:41.070"><span begin="01:37.320" end="01:37.560">We </span><span begin="01:37.560" end="01:37.830">go </span><span begin="01:37.830" end="01:38.610">deeper </span><span begin="01:38.610" end="01:38.790">and </span><span begin="01:38.790" end="01:39.480">harder </span><span begin="01:39.480" end="01:39.840">than </span><span begin="01:39.840" end="01:40.380">ever </span><span begin="01:40.380" end="01:41.070">before</span></p><p ttm:agent="v1" begin="01:41.070" end="01:43.290"><span begin="01:41.070" end="01:41.310">We </span><span begin="01:41.310" end="01:41.580">go </span><span begin="01:41.580" end="01:42.390">higher </span><span begin="01:42.390" end="01:42.540">and </span><span begin="01:42.540" end="01:43.290">higher</span></p><p ttm:agent="v1" begin="01:43.290" end="01:47.760"><span begin="01:43.290" end="01:43.440">I </span><span begin="01:43.440" end="01:43.890">feel </span><span begin="01:43.890" end="01:44.280">like </span><span begin="01:44.280" end="01:44.490">I'm </span><span begin="01:44.490" end="01:45.390">already </span><span begin="01:45.390" end="01:47.760">there</span></p><p ttm:agent="v1" begin="01:47.940" end="01:54.360"><span begin="01:47.940" end="01:48.180">I'm </span><span begin="01:48.180" end="01:48.870">walking </span><span begin="01:48.870" end="01:49.020">on </span><span begin="01:49.020" end="01:49.620">air </span><span begin="01:49.620" end="01:49.620">（</span><span begin="01:49.620" end="01:51.510">tonight</span><span begin="01:51.510" end="01:51.720">） </span><span begin="01:51.720" end="01:51.990">I'm </span><span begin="01:51.990" end="01:52.500">walking </span><span begin="01:52.500" end="01:52.740">on </span><span begin="01:52.740" end="01:54.360">air</span></p><p ttm:agent="v1" begin="01:54.570" end="01:59.250"><span begin="01:54.570" end="01:54.780">I'm </span><span begin="01:54.780" end="01:55.320">walking</span><span begin="01:55.320" end="01:55.320">, </span><span begin="01:55.320" end="01:55.530">I'm </span><span begin="01:55.530" end="01:56.010">walking </span><span begin="01:56.010" end="01:56.280">on </span><span begin="01:56.280" end="01:57.030">air </span><span begin="01:57.030" end="01:57.060">（</span><span begin="01:57.060" end="01:59.010">tonight</span><span begin="01:59.010" end="01:59.250">）</span></p><p ttm:agent="v1" begin="01:59.250" end="02:03.000"><span begin="01:59.250" end="01:59.460">I'm </span><span begin="01:59.460" end="02:00.030">walking </span><span begin="02:00.030" end="02:00.270">on </span><span begin="02:00.270" end="02:01.920">air</span><span begin="02:01.920" end="02:02.010">, </span><span begin="02:02.010" end="02:03.000">ohhh</span></p><p ttm:agent="v1" begin="02:03.000" end="02:06.810"><span begin="02:03.000" end="02:03.180">I'm </span><span begin="02:03.180" end="02:03.870">walking </span><span begin="02:03.870" end="02:04.020">on </span><span begin="02:04.020" end="02:04.620">air </