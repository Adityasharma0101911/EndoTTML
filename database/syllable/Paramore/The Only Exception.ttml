2.320" end="00:32.800">own </span><span begin="00:32.800" end="00:33.370">heart </span><span begin="00:33.370" end="00:33.610">And </span><span begin="00:33.610" end="00:34.060">I </span><span begin="00:34.060" end="00:35.020">watched</span></p><p ttm:agent="v1" begin="00:35.230" end="00:40.090"><span begin="00:35.230" end="00:35.530">As </span><span begin="00:35.530" end="00:35.770">he </span><span begin="00:35.770" end="00:36.310">tried </span><span begin="00:36.310" end="00:36.610">to </span><span begin="00:36.610" end="00:39.250">reassemble </span><span begin="00:39.250" end="00:40.090">it</span></p><p ttm:agent="v1" begin="00:41.680" end="00:43.840"><span begin="00:41.680" end="00:41.920">And </span><span begin="00:41.920" end="00:42.340">my </span><span begin="00:42.340" end="00:42.880">mama </span><span begin="00:42.880" end="00:43.840">swore</span></p><p ttm:agent="v1" begin="00:43.870" end="00:50.740"><span begin="00:43.870" end="00:44.080">That </span><span begin="00:44.080" end="00:44.470">she </span><span begin="00:44.470" end="00:45.700">would </span><span begin="00:45.700" end="00:46.750">never </span><span begin="00:46.750" end="00:47.200">let </span><span begin="00:47.200" end="00:49.360">herself </span><span begin="00:49.360" end="00:50.740">forget</span></p><p ttm:agent="v1" begin="00:52.210" end="00:55.960"><span begin="00:52.210" end="00:52.420">And </span><span begin="00:52.420" end="00:52.840">that </span><span begin="00:52.840" end="00:53.320">was </span><span begin="00:53.320" end="00:53.500">the </span><span begin="00:53.500" end="00:54.130">day </span><span begin="00:54.130" end="00:54.430">that </span><span begin="00:54.430" end="00:54.880">I </span><span begin="00:54.880" end="00:55.960">promised</span></p><p ttm:agent="v1" begin="00:56.080" end="00:58.450"><span begin="00:56.080" end="00:56.320">I'd </span><span begin="00:56.320" end="00:56.800">never </span><span begin="00:56.800" end="00:57.280">sing </span><span begin="00:57.280" end="00:57.490">of </span><span begin="00:57.490" end="00:58.450">love</span></p><p ttm:agent="v1" begin="00:58.600" end="01:01.180"><span begin="00:58.600" end="00:58.780">If </span><span begin="00:58.780" end="00:58.900">it </span><span begin="00:58.900" end="00:59.350">does </span><span begin="00:59.350" end="00:59.890">not </span><span begin="00:59.890" end="01:01.180">exist</span></p><p ttm:agent="v1" begin="01:01.300" end="01:07.570"><span begin="01:01.300" end="01:01.510">But</span><span begin="01:01.510" end="01:01.510">, </span><span begin="01:01.510" end="01:02.860">darling</span><span begin="01:02.860" end="01:02.860">, </span><span begin="01:02.860" end="01:04.150">you </span><span begin="01:04.150" end="01:05.230">are </span><span begin="01:05.230" end="01:05.440">the </span><span begin="01:05.440" end="01:06.190">only </span><span begin="01:06.190" end="01:07.570">exception</span></p><p ttm:agent="v1" begin="01:07.780" end="01:13.030"><span begin="01:07.780" end="01:08.020">But </span><span begin="01:08.020" end="01:09.340">you </span><span begin="01:09.340" end="01:10.390">are </span><span begin="01:10.390" end="01:10.630">the </span><span begin="01:10.630" end="01:11.440">only </span><span begin="01:11.440" end="01:13.030">exception</span></p><p ttm:agent="v1" begin="01:13.060" end="01:18.070"><span begin="01:13.060" end="01:13.240">But </span><span begin="01:13.240" end="01:14.590">you </span><span begin="01:14.590" end="01:15.670">are </span><span begin="01:15.670" end="01:15.880">the </span><span begin="01:15.880" end="01:16.630">only </span><span begin="01:16.630" end="01:18.070">exception</span></p><p ttm:agent="v1" begin="01:18.220" end="01:24.160"><span begin="01:18.220" end="01:18.460">But </span><span begin="01:18.460" end="01:19.780">you </span><span begin="01:19.780" end="01:20.860">are </span><span begin="01:20.860" end="01:21.100">the </span><span begin="01:21.100" end="01:21.850">only </span><span begin="01:21.850" end="01:24.160">exception</span></p><p ttm:agent="v1" begin="01:28.720" end="01:32.380"><span begin="01:28.720" end="01:28.900">Well</span><span begin="01:28.900" end="01:28.900">, </span><span begin="01:28.900" end="01:29.800">maybe </span><span begin="01:29.800" end="01:30.250">I </span><span begin="01:30.250" end="01:30.940">know </span><span begin="01:30.940" end="01:32.380">somewhere</span></p><p ttm:agent="v1" begin="01:32.680" end="01:34.780"><span begin="01:32.680" end="01:33.370">Deep </span><span begin="01:33.370" end="01:33.520">in </span><span begin="01:33.520" end="01:33.790">my </span><span begin="01:33.790" end="01:34.780">soul</span></p><p ttm:agent="v1" begin="01:35.170" end="01:37.960"><span begin="01:35.170" end="01:35.440">That </span><span begin="01:35.440" end="01:35.860">love </span><span begin="01:35.860" end="01:36.580">never </span><span begin="01:36.580" end="01:37.960">lasts</span></p><p ttm:agent="v1" begin="01:39.130" end="01:42.850"><span begin="01:39.130" end="01:39.340">And </span><span begin="01:39.340" end="01:39.760">we've </span><span begin="01:39.760" end="01:40.240">got </span><span begin="01:40.240" end="01:40.390">to </span><span begin="01:40.390" end="01:41.200">find </span><span begin="01:41.200" end="01:41.710">other </span><span begin="01:41.710" end="01:42.850">ways</span></p><p ttm:agent="v1" begin="01:43.000" end="01:45.430"><span begin="01:43.000" end="01:43.240">To </span><span begin="01:43.240" end="01:43.810">make </span><span begin="01:43.810" end="01:44.080">it </span><span begin="01:44.080" end="01:45.430">alone</span></p><p ttm:agent="v1" begin="01:45.670" end="01:48.550"><span begin="01:45.670" end="01:45.820">Or </span><span begin="01:45.820" end="01:46.240">keep </span><span begin="01:46.240" end="01:46.360">a </span><span begin="01:46.360" end="01:47.110">straight </span><span begin="01:47.110" end="01:48.550">face</span></p><p ttm:agent="v1" begin="01:49.510" end="01:53.290"><span begin="01:49.510" end="01:49.870">And </span><span begin="01:49.870" end="01:50.290">I've </span><span begin="01:50.290" end="01:51.010">always </span><span begin="01:51.010" end="01:51.970">lived </span><span begin="01:51.970" end="01:52.420">like </span><span begin="01:52.420" end="01:53.290">this</span></p><p ttm:agent="v1" begin="01:53.590" end="01:59.170"><span begin="01:53.590" end="01:54.490">Keeping </span><span begin="01:54.490" end="01:54.640">a </span><span begin="01:54.640" end="01:57.460">comfortable </span><span begin="01:57.460" end="01:59.170">distance</span></p><p ttm:agent="v1" begin="02:00.040" end="02:04.420"><span begin="02:00.040" end="02:00.250">And </span><span begin="02:00.250" end="02:00.730">up </span><span begin="02:00.730" end="02:01.450">until </span><span begin="02:01.450" end="02:01.930">now</span><span begin="02:01.930" end="02:01.930">, </span><span begin="02:01.930" end="02:02.260">I </span><span begin="02:02.260" end="02:02.470">had </span><span begin="02:02.470" end="02:03.250">sworn </span><span begin="02:03.250" end="02:03.430">to </span><span begin="02:03.430" end="02:04.420">myself</span></p><p ttm:agent="v1" begin="02:04.420" end="02:09.220"><span begin="02:04.420" end="02:04.690">That </span><span begin="02:04.690" end="02:04.960">I'm </span><span begin="02:04.960" end="02:06.490">content </span><span begin="02:06.490" end="02:06.730">with </span><span begin="02:06.730" end="02:09.220">loneliness</span></p><p ttm:agent="v1" begin="02:10.000" end="02:13.120"><span begin="02:10.000" end="02:10.630">Because </span><span begin="02:10.630" end="02:10.990">none </span><span begin="02:10.990" end="02:11.170">of </span><span begin="02:11.170" end="02:11.350">it </span><span begin="02:11.350" end="02:11.620">was </span><span begin="02:11.620" end="02:11.950">ever </span><span begin="02:11.950" end="02:12.400">worth </span><span begin="02:12.400" end="02:12.610">the </span><span begin="02:12.610" end="02:13.120">risk</span></p><p ttm:agent="v1" begin="02:13.120" end="02:18.220"><spa