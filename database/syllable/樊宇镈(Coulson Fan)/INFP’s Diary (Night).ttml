<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>INFP’s Diary (Night)</ttm:title><ttm:agent type="person" xml:id="v1">樊宇镈(Coulson Fan)</ttm:agent><ttm:item type="album">INFP’s Diary</ttm:item><ttm:item type="spotify_id">3BVMu9SvnEuwRK67AYtdCm</ttm:item><itunes:duration>03:07.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:01.467" end="00:04.891"><span begin="00:01.467" end="00:01.707">I </span><span begin="00:01.707" end="00:01.931">keep </span><span begin="00:01.931" end="00:02.171">my </span><span begin="00:02.171" end="00:02.547">world </span><span begin="00:02.547" end="00:03.499">behind </span><span begin="00:03.499" end="00:03.803">the </span><span begin="00:03.803" end="00:04.891">curtains</span></p><p ttm:agent="v1" begin="00:05.299" end="00:08.676"><span begin="00:05.299" end="00:05.563">Speak </span><span begin="00:05.563" end="00:05.859">in </span><span begin="00:05.859" end="00:07.291">lowercase </span><span begin="00:07.291" end="00:08.676">emotions</span></p><p ttm:agent="v1" begin="00:09.132" end="00:11.144"><span begin="00:09.132" end="00:09.668">People </span><span begin="00:09.668" end="00:09.916">say </span><span begin="00:09.916" end="00:10.164">I'm </span><span begin="00:10.164" end="00:10.404">hard </span><span begin="00:10.404" end="00:10.644">to </span><span begin="00:10.644" end="00:11.144">read</span></p><p ttm:agent="v1" begin="00:11.144" end="00:14.496"><span begin="00:11.144" end="00:11.600">But </span><span begin="00:11.600" end="00:11.976">I've </span><span begin="00:11.976" end="00:12.520">written </span><span begin="00:12.520" end="00:13.264">novels </span><span begin="00:13.264" end="00:13.536">in </span><span begin="00:13.536" end="00:14.496">silence</span></p><p ttm:agent="v1" begin="00:15.704" end="00:18.032"><span begin="00:15.704" end="00:15.968">I </span><span begin="00:15.968" end="00:16.208">sit </span><span begin="00:16.208" end="00:16.456">in </span><span begin="00:16.456" end="00:16.848">corners </span><span begin="00:16.848" end="00:17.096">of </span><span begin="00:17.096" end="00:17.544">loud </span><span begin="00:17.544" end="00:18.032">rooms</span></p><p ttm:agent="v1" begin="00:18.032" end="00:19.335"><span begin="00:18.032" end="00:18.296">Not </span><span begin="00:18.296" end="00:18.560">'cause </span><span begin="00:18.560" end="00:18.808">I </span><span begin="00:18.808" end="00:19.032">don't </span><span begin="00:19.032" end="00:19.335">care</span></p><p ttm:agent="v1" begin="00:19.695" end="00:22.123"><span begin="00:19.695" end="00:20.175">Just </span><span begin="00:20.175" end="00:20.455">don't </span><span begin="00:20.455" end="00:20.799">wanna </span><span begin="00:20.799" end="00:21.295">say </span><span begin="00:21.295" end="00:22.123">something</span></p><p ttm:agent="v1" begin="00:22.123" end="00:27.570"><span begin="00:22.123" end="00:22.507">That </span><span begin="00:22.507" end="00:22.891">echoes </span><span begin="00:22.891" end="00:23.347">back </span><span begin="00:23.347" end="00:23.643">as </span><span begin="00:23.643" end="00:24.642">air </span><span begin="00:25.626" end="00:27.570">haa</span></p><p ttm:agent="v1" begin="00:29.218" end="00:31.580"><span begin="00:29.218" end="00:29.634">I </span><span begin="00:29.634" end="00:30.042">feel </span><span begin="00:30.042" end="00:30.530">too </span><span begin="00:30.530" end="00:31.580">deeply</span></p><p ttm:agent="v1" begin="00:31.996" end="00:35.710"><span begin="00:31.996" end="00:32.452">But </span><span begin="00:32.452" end="00:33.100">love </span><span begin="00:33.100" end="00:33.415">too </span><span begin="00:33.863" end="00:35.710">quietly</span></p><p ttm:agent="v1" begin="00:36.766" end="00:39.412"><span begin="00:36.766" end="00:37.014">So </span><span begin="00:37.014" end="00:37.278">I </span><span begin="00:37.278" end="00:37.542">stay </span><span begin="00:37.542" end="00:37.790">a </span><span begin="00:37.790" end="00:38.144">little </span><span begin="00:38.144" end="00:38.928">further </span><span begin="00:38.928" end="00:39.412">back</span></p><p ttm:agent="v1" begin="00:39.412" end="00:40.631"><span begin="00:39.412" end="00:39.684">Where </span><span begin="00:39.684" end="00:39.948">I </span><span begin="00:39.948" end="00:40.188">can </span><span begin="00:40.188" end="00:40.631">watch</span></p><p ttm:agent="v1" begin="00:40.631" end="00:44.791"><span begin="00:40.631" end="00:40.903">And </span><span begin="00:40.903" end="00:41.506">never </span><span begin="00:42.026" end="00:43.906">crash </span><span begin="00:43.906" end="00:44.791">oh</span></p><p ttm:agent="v1" begin="00:46.623" end="00:50.024"><span begin="00:46.623" end="00:47.175">I'm </span><span begin="00:47.175" end="00:47.711">just </span><span begin="00:47.711" end="00:49.048">someone </span><span begin="00:49.048" end="00:50.024">quiet</span></p><p ttm:agent="v1" begin="00:51.144" end="00:53.536"><span begin="00:51.144" end="00:51.448">But </span><span begin="00:51.448" end="00:51.680">I </span><span begin="00:51.680" end="00:52.432">notice </span><span begin="00:52.432" end="00:53.536">everything</span></p><p ttm:agent="v1" begin="00:53.984" end="00:57.303"><span begin="00:53.984" end="00:54.376">You </span><span begin="00:54.376" end="00:54.816">laugh </span><span begin="00:54.816" end="00:55.128">I </span><span begin="00:55.128" end="00:55.760">fold </span><span begin="00:55.760" end="00:56.112">you </span><span begin="00:56.112" end="00:56.624">talk </span><span begin="00:56.624" end="00:57.072">I </span><span begin="00:57.072" end="00:57.303">write</span></p><p ttm:agent="v1" begin="00:57.679" end="01:01.212"><span begin="00:57.679" end="00:57.991">You </span><span begin="00:57.991" end="00:58.575">leave </span><span begin="00:58.575" end="00:58.951">I </span><span begin="00:58.951" end="01:00.497">replay </span><span begin="01:00.497" end="01:01.017">that </span><span begin="01:01.017" end="01:01.212">night</span></p><p ttm:agent="v1" begin="01:01.948" end="01:05.456"><span begin="01:01.948" end="01:02.268">I'm </span><span begin="01:02.268" end="01:02.708">not </span><span begin="01:02.708" end="01:03.356">loud </span><span begin="01:03.356" end="01:03.724">but </span><span begin="01:03.724" end="01:04.332">I'm </span><span begin="01:04.332" end="01:05.456">alive</span></p><p ttm:agent="v1" begin="01:05.820" end="01:07.316"><span begin="01:05.820" end="01:06.108">Just </span><span begin="01:06.108" end="01:07.316">inside</span></p><p ttm:agent="v1" begin="01:07.788" end="01:10.108"><span begin="01:07.788" end="01:08.204">Where </span><span begin="01:08.204" end="01:08.652">it's </span><span begin="01:08.652" end="01:10.108">softer</span></p><p ttm:agent="v1" begin="01:11.363" end="01:13.427"><span begin="01:11.363" end="01:11.635">And </span><span begin="01:11.635" end="01:11.907">no </span><span begin="01:11.907" end="01:12.131">one </span><span begin="01:12.131" end="01:12.531">can </span><span begin="01:12.531" end="01:13.427">bite</span></p><p ttm:agent="v1" begin="01:16.251" end="01:17.735"><span begin="01:16.251" end="01:16.396">I </span><span begin="01:16.396" end="01:16.732">dream </span><span begin="01:16.732" end="01:17.028">like </span><span begin="01:17.028" end="01:17.292">it's </span><span begin="01:17.292" end="01:17.735">real</span></p><p ttm:agent="v1" begin="01:18.399" end="01:19.679"><span begin="01:18.399" end="01:18.687">Love </span><span begin="01:18.687" end="01:18.967">like </span><span begin="01:18.967" end="01:19.255">a </span><span begin="01:19.255" end="01:19.679">poem</span></p><p ttm:agent="v1" begin="01:20.143" end="01:21.652"><span begin="01:20.143" end="01:20.559">Lose </span><span begin="01:20.559" end="01:20.855">like </span><span begin="01:20.855" end="01:21.127">a </span><span begin="01:21.127" end="01:21.652">pattern</span></p><p ttm:agent="v1" begin="01:21.652" end="01:23.454"><span begin="01:21.652" end="01:22.044">But </span><span begin="01:22.044" end="01:22.428">stay </span><span begin="01:22.428" end="01:22.764">like </span><span begin="01:22.764" end="01:23.092">a </span><span begin="01:23.092" end="01:23.454">ghost</span></p><p ttm:agent="v1" begin="01:23.734" end="01:26.383"><span begin="01:23.734" end="01:24.062">You'd </span><span begin="01:24.062" end="01:24.646">never </span><span begin="01:24.646" end="01:24.966">know </span><span begin="01:24.966" end="01:25.294">how </span><span begin="01:25.294" end="01:25.598">much </span><span begin="01:25.598" end="01:25.862">I </span><span begin="01:25.862" end="01:26.383">cared</span></p><p ttm:agent="v1" begin="01:27.455" end="01:31.121"><span begin="01:27.455" end="01:27.767">'Cause </span><span begin="01:27.767" end="01:28.151">I'd </span><span begin="01:28.151" end="01:28.679">never </span><span begin="01:28.679" end="01:29.047">ask </span><span begin="01:29.047" end="01:29.391">you </span><span begin="01:29.391" end="01:29.703">to </span><span begin="01:29.703" end="01:30.649">care </span><span begin="01:30.649" end="01:31.121">back</span></p><p ttm:agent="v1" begin="01:31.121" end="01:32.403"><span begin="01:31.121" end="01:31.315">I </span><span begin="01:31.315" end="01:31.795">don't </span><span begin="01:31.795" end="01:32.403">chase</span></p><p ttm:agent="v1" begin="01:32.963" end="01:34.260"><span begin="01:32.963" end="01:33.267">But </span><span begin="01:33.267" end="01:33.554">I </span><span begin="01:33.554" end="01:34.260">stay</span></p><p ttm:agent="v1" begin="01:35.212" end="01:37.088"><span begin="01:35.212" end="01:35.492">In </span><span begin="01:35.492" end="01:36.052">playlists </span><span begin="01:36.052" end="01:36.388">in </span><span begin="01:36.388" end="01:37.088">dreams</span></p><p ttm:agent="v1" begin="01:37.088" end="01:43.457"><span begin="01:37.088" end="01:37.384">In </span><span begin="01:37.384" end="01:37.728">words </span><span begin="01:37.728" end="01:38.024">in </span><span begin="01:38.024" end="01:38.304">my </span><span begin="01:38.304" end="01:38.696">heart </span><span begin="01:38.696" end="01:39.161">you'll </span><span begin="01:40.953" end="01:42.393">never </span><span begin="01:42.393" end="01:43.457">read</span></p><p ttm:agent="v1" begin="01:47.761" end="01:51.124"><span begin="01:47.761" end="01:48.273">I'm </span><span begin="01:48.273" end="01:48.705">just </span><span begin="01:48.705" end="01:50.145">someone </span><span begin="01:50.145" end="01:51.124">quiet</span></p><p ttm:agent="v1" begin="01:51.928" end="01:54.488"><span begin="01:51.928" end="01:52.168">But </span><span begin="01:52.168" end="01:52.552">I </span><span begin="01:52.552" end="01:53.456">remember </span><span begin="01:53.456" end="01:54.488">everything</span></p><p ttm:agent="v1" begin="01:54.904" end="01:56.728"><span begin="01:54.904" end="01:55.208">The </span><span begin="01:55.208" end="01:55.848">scarf </span><span begin="01:55.848" end="01:56.152">you </span><span begin="01:56.152" end="01:56.728">left</span></p><p ttm:agent="v1" begin="01:56.728" end="01:58.336"><span begin="01:56.728" end="01:57.072">The </span><span begin="01:57.072" end="01:57.528">song </span><span begin="01:57.528" end="01:57.976">you </span><span begin="01:57.976" end="01:58.336">skipped</span></p><p ttm:agent="v1" begin="01:58.736" end="02:02.200"><span begin="01:58.736" end="01:59.024">The </span><span begin="01:59.024" end="01:59.600">look </span><span begin="01:59.600" end="01:59.888">you </span><span begin="01:59.888" end="02:00.536">gave </span><span begin="02:00.536" end="02:01.344">before </span><span begin="02:01.344" end="02:01.864">that's </span><span begin="02:01.864" end="02:02.200">it</span></p><p ttm:agent="v1" begin="02:02.832" end="02:04.444"><span begin="02:02.832" end="02:03.264">I'm </span><span begin="02:03.264" end="02:03.720">not </span><span begin="02:03.720" end="02:04.444">loud</span></p><p ttm:agent="v1" begin="02:04.444" end="02:06.188"><span begin="02:04.444" end="02:04.732">But </span><span begin="02:04.732" end="02:05.180">I'm </span><span begin="02:05.180" end="02:05.628">still </span><span begin="02:05.628" end="02:06.188">here</span></p><p ttm:agent="v1" begin="02:06.664" end="02:08.114"><span begin="02:06.664" end="02:06.714">I </span><span begin="02:06.714" end="02:07.066">don't </span><span begin="02:07.066" end="02:08.114">disappear</span></p><p ttm:agent="v1" begin="02:08.722" end="02:12.933"><span begin="02:08.722" end="02:08.980">I </span><span begin="02:08.980" end="02:09.508">just </span><span begin="02:09.508" end="02:10.741">wait </span><span begin="02:12.165" end="02:12.517">in </span><span begin="02:12.517" end="02:12.933">case</span></p><p ttm:agent="v1" begin="02:12.933" end="02:14.421"><span begin="02:12.933" end="02:13.189">You </span><span begin="02:13.189" end="02:13.549">come </span><span begin="02:13.549" end="02:14.421">near</span></p><p ttm:agent="v1" begin="02:16.247" end="02:23.223"><span begin="02:16.247" end="02:16.727">Don't </span><span begin="02:16.727" end="02:18.143">confuse </span><span begin="02:18.143" end="02:19.607">silence </span><span begin="02:20.567" end="02:21.095">with </span><span begin="02:21.095" end="02:23.223">emptiness</span></p><p ttm:agent="v1" begin="02:23.975" end="02:29.875"><span begin="02:23.975" end="02:24.431">Some </span><span begin="02:24.431" end="02:24.919">hearts </span><span begin="02:24.919" end="02:26.315">scream </span><span begin="02:27.659" end="02:28.539">without </span><span begin="02:28.539" end="02:29.875">sound</span></p><p ttm:agent="v1" begin="02:33.603" end="02:36.871"><span begin="02:33.603" end="02:33.995">I'm </span><span begin="02:33.995" end="02:34.427">just </span><span begin="02:34.427" end="02:35.891">someone </span><span begin="02:35.891" end="02:36.871">quiet</span></p><p ttm:agent="v1" begin="02:37.439" end="02:40.191"><span begin="02:37.439" end="02:37.735">But </span><span begin="02:37.735" end="02:38.007">if </span><span begin="02:38.007" end="02:38.271">you </span><span begin="02:38.271" end="02:38.679">read </span><span begin="02:38.679" end="02:39.431">between </span><span begin="02:39.431" end="02:39.695">the </span><span begin="02:39.695" end="02:40.191">lines</span></p><p ttm:agent="v1" begin="02:40.575" end="02:43.975"><span begin="02:40.575" end="02:40.887">You'd </span><span begin="02:40.887" end="02:41.503">see </span><span begin="02:41.503" end="02:41.807">I </span><span begin="02:41.807" end="02:42.283">was </span><span begin="02:42.691" end="02:43.731">writing </span><span begin="02:43.731" end="02:43.975">you</span></p><p ttm:agent="v1" begin="02:45.687" end="02:48.015"><span begin="02:45.687" end="02:45.967">The </span><span begin="02:45.967" end="02:46.607">whole </span><span begin="02:46.607" end="02:47.495">treasure </span><span begin="02:47.495" end="02:48.015">time</span></p><p ttm:agent="v1" begin="02:49.678" end="02:56.520"><span begin="02:49.678" end="02:52.950">Ohohoh </span><span begin="02:53.470" end="02:54.342">dear </span><span begin="02:54.342" end="02:56.520">diary</span></p><p ttm:agent="v1" begin="02:57.600" end="02:59.859"><span begin="02:57.600" end="02:57.722">I </span><span begin="02:57.722" end="02:58.010">think </span><span begin="02:58.010" end="02:58.163">I </span><span begin="02:58.163" end="02:58.643">miss </span><span begin="02:58.643" end="02:59.859">someone</span></p><p ttm:agent="v1" begin="03:01.563" end="03:03.523"><span begin="03:01.563" end="03:02.019">I </span><span begin="03:02.019" end="03:02.483">never </span><span begin="03:02.483" end="03:03.523">had</span></p></div></body></tt>