<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>What do you want from me?</ttm:title><ttm:agent type="person" xml:id="v1">Bad Omens</ttm:agent><ttm:item type="album">THE DEATH OF PEACE OF MIND</ttm:item><ttm:item type="spotify_id">5vf08i7oQHGPKFAkSxJBcv</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:18.060" end="00:26.060"><span begin="00:18.060" end="00:18.360">This</span><span begin="00:18.490" end="00:19.240"> isn't</span><span begin="00:19.320" end="00:20.270"> over</span><span begin="00:20.400" end="00:20.870"> 'til</span><span begin="00:20.950" end="00:21.420"> we</span><span begin="00:21.520" end="00:22.020"> talk</span><span begin="00:22.190" end="00:22.300"> in</span><span begin="00:23.240" end="00:23.610"> the</span><span begin="00:23.690" end="00:25.190"> light</span></p><p ttm:agent="v1" begin="00:26.450" end="00:34.450"><span begin="00:26.450" end="00:26.730">Said</span><span begin="00:26.830" end="00:26.860"> I</span><span begin="00:27.130" end="00:27.690"> was</span><span begin="00:27.810" end="00:28.470"> sober,</span><span begin="00:28.790" end="00:29.240"> but</span><span begin="00:29.340" end="00:29.810"> you</span><span begin="00:29.930" end="00:30.390"> knew</span><span begin="00:30.480" end="00:30.940"> that</span><span begin="00:31.610" end="00:31.680"> I</span><span begin="00:31.980" end="00:33.480"> lied</span></p><p ttm:agent="v1" begin="00:34.940" end="00:42.940"><span begin="00:34.940" end="00:35.190">You</span><span begin="00:35.250" end="00:35.580"> grip</span><span begin="00:35.650" end="00:36.060"> the</span><span begin="00:36.180" end="00:37.190"> wheel,</span><span begin="00:37.370" end="00:38.280"> maybe</span><span begin="00:38.370" end="00:38.800"> I'd</span><span begin="00:38.870" end="00:39.220"> like</span><span begin="00:40.100" end="00:40.450"> to</span><span begin="00:40.490" end="00:41.990"> try</span></p><p ttm:agent="v1" begin="00:43.400" end="00:51.400"><span begin="00:43.400" end="00:43.680">I'll</span><span begin="00:43.740" end="00:44.080"> flip</span><span begin="00:44.190" end="00:44.560"> it</span><span begin="00:44.740" end="00:45.490"> over,</span><span begin="00:45.650" end="00:46.190"> with</span><span begin="00:46.290" end="00:46.760"> you</span><span begin="00:46.860" end="00:47.290"> and</span><span begin="00:47.360" end="00:47.680"> me</span><span begin="00:48.660" end="00:50.160"> inside</span></p><p ttm:agent="v1" begin="01:09.360" end="01:17.360"><span begin="01:09.360" end="01:09.390">I</span><span begin="01:09.460" end="01:09.900"> won't</span><span begin="01:10.020" end="01:10.970"> atone</span><span begin="01:11.050" end="01:11.500"> for</span><span begin="01:11.600" end="01:12.110"> debts</span><span begin="01:12.270" end="01:12.540"> I</span><span begin="01:12.670" end="01:13.170"> paid</span><span begin="01:13.250" end="01:14.160"> for</span><span begin="01:14.300" end="01:14.640"> in</span><span begin="01:14.700" end="01:16.200"> full</span></p><p ttm:agent="v1" begin="01:17.810" end="01:25.810"><span begin="01:17.810" end="01:18.100">Hang</span><span begin="01:18.190" end="01:18.470"> up</span><span begin="01:18.520" end="01:18.970"> my</span><span begin="01:19.020" end="01:19.600"> shame</span><span begin="01:19.700" end="01:20.100"> on</span><span begin="01:20.200" end="01:21.240"> display</span><span begin="01:21.340" end="01:21.700"> for</span><span begin="01:21.790" end="01:22.110"> you</span><span begin="01:23.190" end="01:23.770"> (for</span><span begin="01:23.840" end="01:25.340"> you)</span></p><p ttm:agent="v1" begin="01:26.370" end="01:34.370"><span begin="01:26.370" end="01:26.610">I'm</span><span begin="01:26.680" end="01:27.030"> not</span><span begin="01:27.100" end="01:27.550"> the</span><span begin="01:27.610" end="01:28.150"> same,</span><span begin="01:28.200" end="01:28.610"> and</span><span begin="01:28.700" end="01:29.100"> you</span><span begin="01:29.180" end="01:29.730"> don't</span><span begin="01:29.800" end="01:30.210"> get</span><span begin="01:30.280" end="01:30.380"> to</span><span begin="01:31.460" end="01:32.960"> decide</span></p><p ttm:agent="v1" begin="01:34.930" end="01:42.930"><span begin="01:34.930" end="01:35.210">Who</span><span begin="01:35.240" end="01:35.570"> gets</span><span begin="01:35.660" end="01:36.710"> replaced,</span><span begin="01:36.790" end="01:37.260"> who</span><span begin="01:37.370" end="01:37.810"> gets</span><span begin="01:37.870" end="01:38.260"> to</span><span begin="01:38.360" end="01:38.760"> live</span><span begin="01:38.840" end="01:39.370"> and</span><span begin="01:40.070" end="01:40.260"> to</span><span begin="01:40.510" end="01:42.010"> die</span></p><p ttm:agent="v1" begin="01:43.180" end="01:47.510"><span begin="01:43.180" end="01:43.340">So</span><span begin="01:43.380" end="01:43.540"> what</span><span begin="01:43.590" end="01:43.710"> do</span><span begin="01:43.720" end="01:43.820"> you</span><span begin="01:43.860" end="01:44.090"> want</span><span begin="01:44.120" end="01:44.300"> from</span><span begin="01:44.390" end="01:44.800"> me,</span><span begin="01:45.140" end="01:45.430"> so</span><span begin="01:45.490" end="01:45.720"> what</span><span begin="01:45.810" end="01:45.920"> do</span><span begin="01:45.950" end="01:46.020"> you</span><span begin="01:46.060" end="01:47.510"> want?</span></p><p ttm:agent="v1" begin="01:47.510" end="01:51.940"><span begin="01:47.510" end="01:47.660">So</span><span begin="01:47.670" end="01:47.820"> what</span><span begin="01:47.870" end="01:48.000"> do</span><span begin="01:48.040" end="01:48.090"> you</span><span begin="01:48.120" end="01:48.400"> want</span><span begin="01:48.450" end="01:48.570"> from</span><span begin="01:48.620" end="01:49.440"> me,</span><span begin="01:49.490" end="01:49.750"> so</span><span begin="01:49.780" end="01:49.990"> what</span><span begin="01:50.010" end="01:50.150"> do</span><span begin="01:50.190" end="01:50.280"> you</span><span begin="01:50.300" end="01:51.800"> want?</span></p><p ttm:agent="v1" begin="01:51.940" end="01:56.020"><span begin="01:51.940" end="01:52.020">So</span><span begin="01:52.150" end="01:52.330"> what</span><span begin="01:52.400" end="01:52.520"> do</span><span begin="01:52.550" end="01:52.620"> you</span><span begin="01:52.620" end="01:52.850"> want</span><span begin="01:52.870" end="01:53.030"> from</span><span begin="01:53.060" end="01:53.780"> me,</span><span begin="01:54.020" end="01:54.230"> so</span><span begin="01:54.270" end="01:54.480"> what</span><span begin="01:54.520" end="01:54.690"> do</span><span begin="01:54.730" end="01:54.780"> you</span><span begin="01:54.820" end="01:56.020"> want?</span></p><p ttm:agent="v1" begin="01:56.020" end="02:04.020"><span begin="01:56.020" end="01:56.230">So</span><span begin="01:56.270" end="01:56.410"> what</span><span begin="01:56.450" end="01:56.560"> do</span><span begin="01:56.600" end="01:56.680"> you</span><span begin="01:56.700" end="01:56.950"> want</span><span begin="01:56.960" end="01:57.130"> from</span><span begin="01:57.150" end="01:58.060"> me?</span><span begin="01:58.130" end="01:58.360"> (So</span><span begin="01:58.400" end="01:58.600"> what</span><span begin="01:58.680" end="01:58.750"> do</span><span begin="01:58.760" end="01:58.900"> you</span><span begin="01:58.910" end="02:00.410"> want?)</span></p><p ttm:agent="v1" begin="02:25.910" end="02:30.470"><span begin="02:25.910" end="02:26.040">So</span><span begin="02:26.070" end="02:26.270"> what</span><span begin="02:26.320" end="02:26.440"> do</span><span begin="02:26.470" end="02:26.520"> you</span><span begin="02:26.540" end="02:26.720"> want</span><span begin="02:26.750" end="02:26.900"> from</span><span begin="02:26.920" end="02:27.070"> me,</span><span begin="02:27.890" end="02:28.120"> so</span><span begin="02:28.170" end="02:28.370"> what</span><span begin="02:28.400" end="02:28.520"> do</span><span begin="02:28.550" end="02:28.700"> you</span><span begin="02:28.720" end="02:30.220"> want?</span></p><p ttm:agent="v1" begin="02:30.470" end="02:38.470"><span begin="02:30.470" end="02:30.700">So</span><span begin="02:30.710" end="02:30.900"> what</span><span begin="02:30.930" end="02:31.050"> do</span><span begin="02:31.080" end="02:31.130"> you</span><span begin="02:31.150" end="02:31.380"> want</span><span begin="02:31.410" end="02:31.550"> from</span><span begin="02:31.580" end="02:31.840"> me,</span><span begin="02:32.250" end="02:32.600"> what</span><span begin="02:32.630" end="02:32.910"> do</span><span begin="02:32.960" end="02:33.220"> you</span><span begin="02:33.280" end="02:34.000"> want?</span><span begin="02:34.030" end="02:35.530"> Oh</span></p><p ttm:agent="v1" begin="02:49.560" end="02:53.560"><span begin="02:49.560" end="02:49.740">So</span><span begin="02:49.770" end="02:50.000"> what</span><span begin="02:50.050" end="02:50.170"> do</span><span begin="02:50.200" end="02:50.290"> you</span><span begin="02:50.320" end="02:51.820"> want?</span></p></div></body></tt>