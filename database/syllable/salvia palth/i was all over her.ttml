<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>i was all over her</ttm:title><ttm:agent type="person" xml:id="v1">salvia palth</ttm:agent><ttm:item type="album">melanchole</ttm:item><ttm:item type="spotify_id">6mSnSuOhgHHohqeBw76jRV</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:37.680" end="00:42.480"><span begin="00:37.680" end="00:38.070">Don't </span><span begin="00:38.070" end="00:38.340">know </span><span begin="00:38.340" end="00:38.700">what </span><span begin="00:38.700" end="00:38.910">I </span><span begin="00:38.910" end="00:40.200">wanted</span><span begin="00:40.200" end="00:40.260">, </span><span begin="00:40.260" end="00:40.710">I </span><span begin="00:40.710" end="00:40.950">have </span><span begin="00:40.950" end="00:41.130">a </span><span begin="00:41.130" end="00:42.480">memory</span></p><p ttm:agent="v1" begin="00:42.540" end="00:47.100"><span begin="00:42.540" end="00:42.990">Back </span><span begin="00:42.990" end="00:43.170">at </span><span begin="00:43.170" end="00:43.470">that </span><span begin="00:43.470" end="00:44.850">party </span><span begin="00:44.850" end="00:45.240">I </span><span begin="00:45.240" end="00:45.540">was </span><span begin="00:45.540" end="00:45.990">all </span><span begin="00:45.990" end="00:46.260">over </span><span begin="00:46.260" end="00:47.100">her</span></p><p ttm:agent="v1" begin="00:47.130" end="00:51.300"><span begin="00:47.130" end="00:47.430">We </span><span begin="00:47.430" end="00:48.000">didn't </span><span begin="00:48.000" end="00:48.630">make </span><span begin="00:48.630" end="00:49.320">out</span><span begin="00:49.320" end="00:49.410">, </span><span begin="00:49.410" end="00:49.740">or </span><span begin="00:49.740" end="00:50.340">do </span><span begin="00:50.340" end="00:51.300">anything</span></p><p ttm:agent="v1" begin="00:51.690" end="00:55.980"><span begin="00:51.690" end="00:52.020">I </span><span begin="00:52.020" end="00:52.350">just </span><span begin="00:52.350" end="00:54.000">remember </span><span begin="00:54.000" end="00:54.360">I </span><span begin="00:54.360" end="00:54.870">was </span><span begin="00:54.870" end="00:55.980">lonely</span></p><p ttm:agent="v1" begin="01:14.340" end="01:19.050"><span begin="01:14.340" end="01:14.520">I </span><span begin="01:14.520" end="01:14.970">guess </span><span begin="01:14.970" end="01:15.210">I </span><span begin="01:15.210" end="01:15.510">am </span><span begin="01:15.510" end="01:16.740">always</span><span begin="01:16.740" end="01:16.800">, </span><span begin="01:16.800" end="01:17.190">it's </span><span begin="01:17.190" end="01:17.550">not </span><span begin="01:17.550" end="01:17.640">a </span><span begin="01:17.640" end="01:19.050">problem</span></p><p ttm:agent="v1" begin="01:19.080" end="01:23.370"><span begin="01:19.080" end="01:19.440">It's </span><span begin="01:19.440" end="01:19.860">just </span><span begin="01:19.860" end="01:21.150">something</span><span begin="01:21.150" end="01:21.360">, </span><span begin="01:21.360" end="01:21.690">I </span><span begin="01:21.690" end="01:22.290">got </span><span begin="01:22.290" end="01:22.650">used </span><span begin="01:22.650" end="01:22.980">to </span><span begin="01:22.980" end="01:23.370">it</span></p><p ttm:agent="v1" begin="01:23.730" end="01:28.140"><span begin="01:23.730" end="01:24.510">Every </span><span begin="01:24.510" end="01:26.010">stranger </span><span begin="01:26.010" end="01:26.370">makes </span><span begin="01:26.370" end="01:26.520">me </span><span begin="01:26.520" end="01:26.790">feel </span><span begin="01:26.790" end="01:28.140">safer</span></p><p ttm:agent="v1" begin="01:28.170" end="01:33.240"><span begin="01:28.170" end="01:28.380">And </span><span begin="01:28.380" end="01:29.130">every </span><span begin="01:29.130" end="01:30.390">person </span><span begin="01:30.390" end="01:31.170">seems </span><span begin="01:31.170" end="01:31.710">more </span><span begin="01:31.710" end="01:33.240">beautiful</span></p></div></body></tt>