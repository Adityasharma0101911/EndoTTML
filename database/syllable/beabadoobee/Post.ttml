<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Post</ttm:title><ttm:agent type="person" xml:id="v1">beabadoobee</ttm:agent><ttm:item type="album">This Is How Tomorrow Moves</ttm:item><ttm:item type="spotify_id">6wpcfnVXNj4705DPx2aqvs</ttm:item><itunes:duration>02:41.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:06.232" end="00:08.885"><span begin="00:06.232" end="00:06.416">Said </span><span begin="00:06.416" end="00:06.561">he's </span><span begin="00:06.561" end="00:06.874">getting </span><span begin="00:06.874" end="00:07.141">tired </span><span begin="00:07.141" end="00:07.297">from </span><span begin="00:07.297" end="00:07.432">running </span><span begin="00:07.432" end="00:07.585">as </span><span begin="00:07.585" end="00:07.741">fast </span><span begin="00:07.741" end="00:07.933">as </span><span begin="00:07.933" end="00:08.125">he </span><span begin="00:08.125" end="00:08.885">can</span></p><p ttm:agent="v1" begin="00:08.885" end="00:11.647"><span begin="00:08.885" end="00:09.423">Daddy </span><span begin="00:09.423" end="00:09.798">always </span><span begin="00:09.798" end="00:10.030">said </span><span begin="00:10.030" end="00:10.197">he </span><span begin="00:10.197" end="00:10.438">was </span><span begin="00:10.438" end="00:10.862">half </span><span begin="00:10.862" end="00:10.999">of </span><span begin="00:10.999" end="00:11.165">a </span><span begin="00:11.165" end="00:11.647">man</span></p><p ttm:agent="v1" begin="00:12.085" end="00:14.567"><span begin="00:12.085" end="00:12.397">Life </span><span begin="00:12.397" end="00:12.758">worth </span><span begin="00:12.758" end="00:13.074">living </span><span begin="00:13.074" end="00:13.214">but </span><span begin="00:13.214" end="00:13.383">as </span><span begin="00:13.383" end="00:13.759">hard </span><span begin="00:13.759" end="00:13.943">as </span><span begin="00:13.943" end="00:14.127">it </span><span begin="00:14.127" end="00:14.567">gets</span></p><p ttm:agent="v1" begin="00:15.009" end="00:17.685"><span begin="00:15.009" end="00:15.263">Guess </span><span begin="00:15.263" end="00:15.964">sometimes </span><span begin="00:15.964" end="00:16.324">you </span><span begin="00:16.324" end="00:16.772">learn </span><span begin="00:16.772" end="00:17.113">to </span><span begin="00:17.113" end="00:17.685">forget</span></p><p ttm:agent="v1" begin="00:17.685" end="00:20.255"><span begin="00:17.685" end="00:17.845">And </span><span begin="00:17.845" end="00:18.268">all </span><span begin="00:18.268" end="00:18.694">I </span><span begin="00:18.694" end="00:19.166">wanted </span><span begin="00:19.166" end="00:19.390">the </span><span begin="00:19.390" end="00:20.255">most</span></p><p ttm:agent="v1" begin="00:23.597" end="00:26.312"><span begin="00:23.597" end="00:23.750">Was </span><span begin="00:23.750" end="00:23.925">to </span><span begin="00:23.925" end="00:24.286">see </span><span begin="00:24.286" end="00:24.664">your </span><span begin="00:24.664" end="00:25.070">name </span><span begin="00:25.070" end="00:25.214">on </span><span begin="00:25.214" end="00:25.382">the </span><span begin="00:25.382" end="00:26.312">post</span></p><p ttm:agent="v1" begin="00:29.910" end="00:33.141"><span begin="00:29.910" end="00:31.197">He </span><span begin="00:31.197" end="00:33.141">said</span></p><p ttm:agent="v1" begin="00:35.606" end="00:39.112"><span begin="00:35.606" end="00:37.130">He </span><span begin="00:37.130" end="00:39.112">said</span></p><p ttm:agent="v1" begin="00:42.126" end="00:44.704"><span begin="00:42.126" end="00:42.417">Something </span><span begin="00:42.417" end="00:42.984">about </span><span begin="00:42.984" end="00:43.262">her </span><span begin="00:43.262" end="00:43.438">is </span><span begin="00:43.438" end="00:43.711">hard </span><span begin="00:43.711" end="00:44.047">to </span><span begin="00:44.047" end="00:44.704">regret</span></p><p ttm:agent="v1" begin="00:45.040" end="00:48.072"><span begin="00:45.040" end="00:46.016">Falling </span><span begin="00:46.016" end="00:48.072">slowly</span></p><p ttm:agent="v1" begin="00:48.072" end="00:50.649"><span begin="00:48.072" end="00:48.401">Every </span><span begin="00:48.401" end="00:48.632">time </span><span begin="00:48.632" end="00:48.793">she </span><span begin="00:48.793" end="00:49.032">looks </span><span begin="00:49.032" end="00:49.186">at </span><span begin="00:49.186" end="00:49.385">him </span><span begin="00:49.385" end="00:49.585">he's </span><span begin="00:49.585" end="00:49.937">breaking </span><span begin="00:49.937" end="00:50.113">a </span><span begin="00:50.113" end="00:50.649">sweat</span></p><p ttm:agent="v1" begin="00:50.841" end="00:53.865"><span begin="00:50.841" end="00:51.017">I </span><span begin="00:51.017" end="00:51.560">think </span><span begin="00:51.560" end="00:52.201">I'm </span><span begin="00:52.201" end="00:53.865">lonely</span></p><p ttm:agent="v1" begin="00:53.865" end="00:56.321"><span begin="00:53.865" end="00:54.000">And </span><span begin="00:54.000" end="00:54.369">all </span><span begin="00:54.369" end="00:54.656">I </span><span begin="00:54.656" end="00:55.218">wanted </span><span begin="00:55.218" end="00:55.378">the </span><span begin="00:55.378" end="00:56.321">most</span></p><p ttm:agent="v1" begin="00:59.585" end="01:02.421"><span begin="00:59.585" end="00:59.730">Was </span><span begin="00:59.730" end="00:59.913">to </span><span begin="00:59.913" end="01:00.241">see </span><span begin="01:00.241" end="01:00.594">her </span><span begin="01:00.594" end="01:01.003">name </span><span begin="01:01.003" end="01:01.176">on </span><span begin="01:01.176" end="01:01.445">the </span><span begin="01:01.445" end="01:02.421">post</span></p><p ttm:agent="v1" begin="01:05.724" end="01:09.364"><span begin="01:05.724" end="01:07.160">She </span><span begin="01:07.160" end="01:09.364">said</span></p><p ttm:agent="v1" begin="01:11.654" end="01:15.105"><span begin="01:11.654" end="01:13.151">She </span><span begin="01:13.151" end="01:15.105">said</span></p><p ttm:agent="v1" begin="01:17.640" end="01:21.285"><span begin="01:17.640" end="01:19.195">She </span><span begin="01:19.195" end="01:21.285">said</span></p><p ttm:agent="v1" begin="01:23.639" end="01:27.098"><span begin="01:23.639" end="01:25.158">She </span><span begin="01:25.158" end="01:27.098">said</span></p><p ttm:agent="v1" begin="01:30.788" end="01:36.038"><span begin="01:30.788" end="01:30.998">I'm </span><span begin="01:30.998" end="01:31.778">not </span><span begin="01:32.231" end="01:33.321">waiting </span><span begin="01:33.743" end="01:34.432">any </span><span begin="01:34.432" end="01:35.148">longer </span><span begin="01:35.148" end="01:35.501">for </span><span begin="01:35.501" end="01:36.038">you</span></p><p ttm:agent="v1" begin="01:36.700" end="01:41.404"><span begin="01:36.700" end="01:39.122">Realising </span><span begin="01:39.362" end="01:39.530">you've </span><span begin="01:39.530" end="01:39.697">got </span><span begin="01:39.697" end="01:40.402">nothing </span><span begin="01:40.402" end="01:40.594">to </span><span begin="01:40.594" end="01:41.404">give</span></p><p ttm:agent="v1" begin="01:42.697" end="01:48.126"><span begin="01:42.697" end="01:43.025">Took </span><span begin="01:43.025" end="01:43.843">too </span><span begin="01:44.105" end="01:44.494">long </span><span begin="01:44.494" end="01:45.229">for </span><span begin="01:45.689" end="01:45.978">you </span><span begin="01:45.978" end="01:46.329">to </span><span begin="01:46.329" end="01:47.309">show </span><span begin="01:47.309" end="01:48.126">it</span></p><p ttm:agent="v1" begin="01:53.718" end="01:57.091"><span begin="01:53.718" end="01:55.190">He </span><span begin="01:55.190" end="01:57.091">said</span></p><p ttm:agent="v1" begin="01:59.705" end="02:03.136"><span begin="01:59.705" end="02:01.189">He </span><span begin="02:01.189" end="02:03.136">said</span></p><p ttm:agent="v1" begin="02:05.725" end="02:09.255"><span begin="02:05.725" end="02:07.158">He </span><span begin="02:07.158" end="02:09.255">said</span></p><p ttm:agent="v1" begin="02:11.662" end="02:15.021"><span begin="02:11.662" end="02:13.153">He </span><span begin="02:13.153" end="02:15.021">said</span></p><p ttm:agent="v1" begin="02:17.647" end="02:21.919"><span begin="02:17.647" end="02:19.214">He </span><span begin="02:19.214" end="02:21.919">said</span></p><p ttm:agent="v1" begin="02:23.662" end="02:27.421"><span begin="02:23.662" end="02:25.142">He </span><span begin="02:25.142" end="02:27.421">said</span></p></div></body></tt>