<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Tired</ttm:title><ttm:agent type="person" xml:id="v1">beabadoobee</ttm:agent><ttm:item type="album">Patched Up</ttm:item><ttm:item type="spotify_id">6F5mZpEEjhsAW8UEqbIpz1</ttm:item><itunes:duration>03:19.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:15.947" end="00:22.123"><span begin="00:15.947" end="00:16.331">You </span><span begin="00:16.331" end="00:17.108">haven't </span><span begin="00:17.108" end="00:17.578">been </span><span begin="00:17.578" end="00:18.404">good </span><span begin="00:19.252" end="00:20.684">for </span><span begin="00:20.684" end="00:22.123">long</span></p><p ttm:agent="v1" begin="00:22.844" end="00:28.900"><span begin="00:22.844" end="00:23.196">Is </span><span begin="00:23.196" end="00:23.556">it </span><span begin="00:23.556" end="00:23.988">the </span><span begin="00:23.988" end="00:25.398">sound </span><span begin="00:26.220" end="00:26.548">of </span><span begin="00:26.548" end="00:26.971">your </span><span begin="00:26.971" end="00:27.900">own </span><span begin="00:27.900" end="00:28.900">thoughts</span></p><p ttm:agent="v1" begin="00:29.651" end="00:35.556"><span begin="00:29.651" end="00:30.028">That </span><span begin="00:30.028" end="00:30.796">always </span><span begin="00:30.796" end="00:31.869">keeps </span><span begin="00:31.869" end="00:32.747">you </span><span begin="00:32.747" end="00:33.404">up </span><span begin="00:33.404" end="00:34.259">at </span><span begin="00:34.259" end="00:35.556">night</span></p><p ttm:agent="v1" begin="00:36.421" end="00:42.180"><span begin="00:36.421" end="00:37.268">Maybe </span><span begin="00:37.268" end="00:37.691">it's </span><span begin="00:37.691" end="00:38.492">time </span><span begin="00:38.492" end="00:39.357">to </span><span begin="00:39.357" end="00:40.292">say </span><span begin="00:40.292" end="00:42.180">goodbye</span></p><p ttm:agent="v1" begin="00:43.380" end="00:48.372"><span begin="00:43.380" end="00:43.741">'Cause </span><span begin="00:43.741" end="00:44.580">I'm </span><span begin="00:44.580" end="00:45.987">getting </span><span begin="00:45.987" end="00:46.699">pretty </span><span begin="00:46.699" end="00:47.548">f**king </span><span begin="00:47.548" end="00:48.372">tired</span></p><p ttm:agent="v1" begin="01:17.731" end="01:23.566"><span begin="01:17.731" end="01:18.019">You </span><span begin="01:18.019" end="01:18.900">haven't </span><span begin="01:18.900" end="01:19.364">felt </span><span begin="01:19.364" end="01:20.134">right </span><span begin="01:20.990" end="01:22.341">for </span><span begin="01:22.341" end="01:23.566">days</span></p><p ttm:agent="v1" begin="01:24.574" end="01:30.511"><span begin="01:24.574" end="01:24.879">Is </span><span begin="01:24.879" end="01:25.246">it </span><span begin="01:25.246" end="01:25.672">the </span><span begin="01:25.672" end="01:26.607">fact </span><span begin="01:27.565" end="01:27.933">you </span><span begin="01:27.933" end="01:29.614">never </span><span begin="01:29.614" end="01:30.511">say</span></p><p ttm:agent="v1" begin="01:31.382" end="01:37.296"><span begin="01:31.382" end="01:31.767">What </span><span begin="01:31.767" end="01:32.545">comes </span><span begin="01:32.545" end="01:33.512">in </span><span begin="01:33.512" end="01:34.286">your </span><span begin="01:34.286" end="01:35.111">mind </span><span begin="01:35.111" end="01:35.975">that </span><span begin="01:35.975" end="01:37.296">day</span></p><p ttm:agent="v1" begin="01:38.103" end="01:43.783"><span begin="01:38.103" end="01:39.115">Maybe </span><span begin="01:39.115" end="01:39.415">it's </span><span begin="01:39.415" end="01:40.216">time </span><span begin="01:40.216" end="01:40.751">to </span><span begin="01:41.111" end="01:42.007">shut </span><span begin="01:42.007" end="01:43.783">away</span></p><p ttm:agent="v1" begin="01:44.999" end="01:50.112"><span begin="01:44.999" end="01:45.375">'Cause </span><span begin="01:45.375" end="01:46.268">I've </span><span begin="01:46.268" end="01:47.591">never </span><span begin="01:47.591" end="01:48.375">really </span><span begin="01:48.375" end="01:48.801">felt </span><span begin="01:48.801" end="01:50.112">okay</span></p><p ttm:agent="v1" begin="02:17.595" end="02:23.124"><span begin="02:17.595" end="02:17.771">'Cause </span><span begin="02:17.771" end="02:18.324">I've </span><span begin="02:18.324" end="02:19.259">been </span><span begin="02:19.259" end="02:20.564">eating </span><span begin="02:20.564" end="02:21.348">less </span><span begin="02:21.348" end="02:22.228">all </span><span begin="02:22.228" end="02:23.124">day</span></p><p ttm:agent="v1" begin="02:23.332" end="02:31.707"><span begin="02:23.332" end="02:24.004">To </span><span begin="02:24.004" end="02:24.807">give </span><span begin="02:25.249" end="02:25.721">my </span><span begin="02:25.721" end="02:26.575">brain </span><span begin="02:26.575" end="02:27.456">some </span><span begin="02:27.456" end="02:28.754">extra </span><span begin="02:29.031" end="02:29.938">space </span><span begin="02:30.393" end="02:30.873">to </span><span begin="02:30.873" end="02:31.707">think</span></p><p ttm:agent="v1" begin="02:32.241" end="02:38.563"><span begin="02:32.241" end="02:32.761">'Bout </span><span begin="02:32.761" end="02:33.461">all </span><span begin="02:33.461" end="02:34.249">the </span><span begin="02:34.249" end="02:35.105">things </span><span begin="02:35.105" end="02:35.994">to </span><span begin="02:35.994" end="02:36.826">do </span><span begin="02:36.826" end="02:37.673">to </span><span begin="02:37.673" end="02:38.563">help</span></p><p ttm:agent="v1" begin="02:39.017" end="02:48.273"><span begin="02:39.017" end="02:40.282">Distract </span><span begin="02:40.282" end="02:40.850">me </span><span begin="02:41.121" end="02:42.002">from </span><span begin="02:42.002" end="02:42.594">the </span><span begin="02:42.865" end="02:43.683">rude </span><span begin="02:43.683" end="02:44.578">of </span><span begin="02:44.578" end="02:48.273">heart</span></p></div></body></tt>