<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>1AM FREESTYLE</ttm:title><ttm:agent type="person" xml:id="v1">Joji</ttm:agent><ttm:item type="album">SMITHEREENS</ttm:item><ttm:item type="spotify_id">0FqBNLXlTNimxmVRdDMj6b</ttm:item><itunes:duration>01:53.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:07.996" end="00:11.791"><span begin="00:07.996" end="00:08.239">You </span><span begin="00:08.239" end="00:08.499">know </span><span begin="00:08.500" end="00:08.696">you </span><span begin="00:08.697" end="00:09.722">can </span><span begin="00:09.722" end="00:10.270">make </span><span begin="00:10.271" end="00:11.791">it</span></p><p ttm:agent="v1" begin="00:11.792" end="00:18.388"><span begin="00:11.792" end="00:12.035">But </span><span begin="00:12.035" end="00:12.377">you </span><span begin="00:12.378" end="00:12.566">can't </span><span begin="00:12.566" end="00:13.081">make </span><span begin="00:13.081" end="00:13.358">it </span><span begin="00:13.359" end="00:18.387">alone</span></p><p ttm:agent="v1" begin="00:23.322" end="00:25.784"><span begin="00:23.322" end="00:23.580">You </span><span begin="00:23.581" end="00:23.826">know </span><span begin="00:23.826" end="00:24.042">you </span><span begin="00:24.042" end="00:24.481">can </span><span begin="00:24.482" end="00:25.229">make </span><span begin="00:25.230" end="00:25.784">it</span></p><p ttm:agent="v1" begin="00:27.036" end="00:30.492"><span begin="00:27.036" end="00:27.240">But </span><span begin="00:27.241" end="00:27.605">you </span><span begin="00:27.606" end="00:27.812">can't </span><span begin="00:27.812" end="00:28.198">make </span><span begin="00:28.199" end="00:28.430">it </span><span begin="00:28.430" end="00:30.493">alone</span></p><p ttm:agent="v1" begin="00:31.050" end="00:35.610"><span begin="00:31.050" end="00:31.329">I've </span><span begin="00:31.329" end="00:31.538">been </span><span begin="00:31.538" end="00:32.543">writing </span><span begin="00:32.544" end="00:33.752">letters </span><span begin="00:33.753" end="00:34.178">on </span><span begin="00:34.178" end="00:34.376">the </span><span begin="00:34.377" end="00:35.610">wall</span></p><p ttm:agent="v1" begin="00:36.616" end="00:45.652"><span begin="00:36.616" end="00:36.810">I </span><span begin="00:36.811" end="00:37.022">hope </span><span begin="00:37.023" end="00:37.329">one </span><span begin="00:37.330" end="00:37.832">day </span><span begin="00:37.832" end="00:38.090">you'll </span><span begin="00:38.091" end="00:39.108">see </span><span begin="00:39.109" end="00:39.299">them </span><span begin="00:39.300" end="00:41.562">all </span><span begin="00:41.562" end="00:41.766">and </span><span begin="00:41.767" end="00:42.180">that </span><span begin="00:42.181" end="00:42.583">you're </span><span begin="00:42.583" end="00:43.061">not </span><span begin="00:43.062" end="00:43.492">that </span><span begin="00:43.493" end="00:45.652">alone</span></p><p ttm:agent="v1" begin="00:46.304" end="00:50.702"><span begin="00:46.304" end="00:46.639">I've </span><span begin="00:46.640" end="00:46.921">been </span><span begin="00:46.921" end="00:47.811">playing </span><span begin="00:47.812" end="00:48.667">memories </span><span begin="00:48.667" end="00:49.135">in </span><span begin="00:49.136" end="00:49.569">my </span><span begin="00:49.570" end="00:50.703">mind</span></p><p ttm:agent="v1" begin="00:52.185" end="00:55.869"><span begin="00:52.185" end="00:52.797">Wishing </span><span begin="00:52.797" end="00:52.995">you </span><span begin="00:52.996" end="00:53.400">were </span><span begin="00:53.401" end="00:54.407">there </span><span begin="00:54.407" end="00:54.597">like </span><span begin="00:54.598" end="00:54.978">all </span><span begin="00:54.978" end="00:55.270">the </span><span begin="00:55.270" end="00:55.869">time</span></p><p ttm:agent="v1" begin="00:57.117" end="01:00.249"><span begin="00:57.117" end="00:57.334">So </span><span begin="00:57.335" end="00:57.933">that </span><span begin="00:57.934" end="00:58.150">I'm </span><span begin="00:58.150" end="00:58.456">not </span><span begin="00:58.456" end="01:00.249">alone</span></p><p ttm:agent="v1" begin="01:01.517" end="01:07.599"><span begin="01:01.517" end="01:01.741">And </span><span begin="01:01.742" end="01:04.586">I'm </span><span begin="01:04.587" end="01:04.783">tired </span><span begin="01:04.784" end="01:05.003">of </span><span begin="01:05.003" end="01:05.502">this </span><span begin="01:05.503" end="01:07.599">madness</span></p><p ttm:agent="v1" begin="01:08.165" end="01:11.082"><span begin="01:08.165" end="01:08.383">Tired </span><span begin="01:08.383" end="01:08.626">of </span><span begin="01:08.627" end="01:08.975">being </span><span begin="01:08.975" end="01:11.082">stranded</span></p><p ttm:agent="v1" begin="01:12.001" end="01:16.361"><span begin="01:12.001" end="01:12.179">I </span><span begin="01:12.180" end="01:12.369">don't </span><span begin="01:12.369" end="01:12.557">wanna </span><span begin="01:12.557" end="01:13.936">be </span><span begin="01:13.937" end="01:16.360">alone</span></p><p ttm:agent="v1" begin="01:20.576" end="01:23.617"><span begin="01:20.576" end="01:23.617">Ooh</span></p><p ttm:agent="v1" begin="01:24.338" end="01:26.729"><span begin="01:24.338" end="01:24.523">You </span><span begin="01:24.524" end="01:24.763">know </span><span begin="01:24.763" end="01:24.958">you </span><span begin="01:24.959" end="01:25.445">can </span><span begin="01:25.445" end="01:26.451">make </span><span begin="01:26.452" end="01:26.729">it</span></p><p ttm:agent="v1" begin="01:27.862" end="01:31.848"><span begin="01:27.862" end="01:28.050">But </span><span begin="01:28.050" end="01:28.242">you </span><span begin="01:28.243" end="01:28.475">can't </span><span begin="01:28.475" end="01:28.691">make </span><span begin="01:28.691" end="01:29.310">it </span><span begin="01:29.310" end="01:31.848">alone</span></p><p ttm:agent="v1" begin="01:32.020" end="01:37.635"><span begin="01:32.020" end="01:32.201">And </span><span begin="01:32.202" end="01:34.585">I'm </span><span begin="01:34.585" end="01:34.818">tired </span><span begin="01:34.818" end="01:35.250">of </span><span begin="01:35.250" end="01:35.664">this </span><span begin="01:35.665" end="01:37.635">madness</span></p><p ttm:agent="v1" begin="01:38.573" end="01:41.288"><span begin="01:38.573" end="01:38.800">Tired </span><span begin="01:38.800" end="01:39.033">of </span><span begin="01:39.034" end="01:39.434">being </span><span begin="01:39.434" end="01:41.288">stranded</span></p><p ttm:agent="v1" begin="01:42.395" end="01:45.030"><span begin="01:42.395" end="01:42.610">I </span><span begin="01:42.611" end="01:42.788">don't </span><span begin="01:42.788" end="01:43.124">wanna </span><span begin="01:43.125" end="01:44.473">be </span><span begin="01:44.474" end="01:45.030">alone</span></p></div></body></tt>