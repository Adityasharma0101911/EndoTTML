<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Sunsets With You</ttm:title><ttm:agent type="group" xml:id="v1">Cliff, Yden</ttm:agent><ttm:item type="album">Sunsets With You</ttm:item><ttm:item type="spotify_id">43t6oyPWJ67nifk7JgDgoI</ttm:item><itunes:duration>04:13.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:28.033" end="00:35.775"><span begin="00:28.033" end="00:29.880">Girl </span><span begin="00:30.407" end="00:30.607">oh </span><span begin="00:30.607" end="00:30.823">I've </span><span begin="00:30.823" end="00:31.033">been </span><span begin="00:31.033" end="00:31.591">thinking </span><span begin="00:31.591" end="00:32.087">'bout </span><span begin="00:32.087" end="00:32.583">you </span><span begin="00:32.583" end="00:33.159">every </span><span begin="00:33.159" end="00:33.665">day </span><span begin="00:33.665" end="00:34.135">and </span><span begin="00:34.135" end="00:35.775">night</span></p><p ttm:agent="v1" begin="00:36.263" end="00:41.327"><span begin="00:36.263" end="00:36.743">I've </span><span begin="00:36.743" end="00:37.295">been </span><span begin="00:37.295" end="00:37.839">missing </span><span begin="00:37.839" end="00:38.344">you </span><span begin="00:38.344" end="00:38.861">and </span><span begin="00:38.861" end="00:39.332">I </span><span begin="00:39.332" end="00:39.909">wanna </span><span begin="00:39.909" end="00:40.164">hold </span><span begin="00:40.164" end="00:40.527">you </span><span begin="00:40.527" end="00:41.327">tight</span></p><p ttm:agent="v1" begin="00:41.836" end="00:47.364"><span begin="00:41.836" end="00:42.029">You </span><span begin="00:42.029" end="00:43.013">know </span><span begin="00:43.540" end="00:43.964">all </span><span begin="00:43.964" end="00:44.364">my </span><span begin="00:44.364" end="00:44.812">songs </span><span begin="00:44.812" end="00:45.020">are </span><span begin="00:45.020" end="00:45.756">all </span><span begin="00:45.756" end="00:46.548">about </span><span begin="00:46.548" end="00:47.364">you</span></p><p ttm:agent="v1" begin="00:47.757" end="00:52.445"><span begin="00:47.757" end="00:47.980">And </span><span begin="00:47.980" end="00:48.180">the </span><span begin="00:48.180" end="00:48.597">things </span><span begin="00:48.597" end="00:48.885">that </span><span begin="00:48.885" end="00:49.629">we </span><span begin="00:49.629" end="00:52.445">do</span></p><p ttm:agent="v1" begin="00:52.892" end="00:55.549"><span begin="00:52.892" end="00:53.028">Oh </span><span begin="00:53.028" end="00:53.284">be </span><span begin="00:53.284" end="00:53.468">my </span><span begin="00:53.468" end="00:53.757">ride </span><span begin="00:53.757" end="00:53.908">or </span><span begin="00:53.908" end="00:54.436">die </span><span begin="00:54.436" end="00:55.549">baby</span></p><p ttm:agent="v1" begin="00:55.892" end="00:57.908"><span begin="00:55.892" end="00:56.092">I'll </span><span begin="00:56.092" end="00:56.437">never </span><span begin="00:56.437" end="00:56.838">let </span><span begin="00:56.838" end="00:56.996">you </span><span begin="00:56.996" end="00:57.908">go</span></p><p ttm:agent="v1" begin="00:58.460" end="01:03.370"><span begin="00:58.460" end="00:58.660">Oh </span><span begin="00:58.660" end="00:59.052">girl </span><span begin="00:59.052" end="00:59.238">it's </span><span begin="00:59.238" end="00:59.949">you </span><span begin="01:00.324" end="01:00.629">and </span><span begin="01:00.629" end="01:01.221">me </span><span begin="01:01.509" end="01:01.876">against </span><span begin="01:01.876" end="01:02.204">the </span><span begin="01:02.204" end="01:03.370">world</span></p><p ttm:agent="v1" begin="01:03.370" end="01:06.194"><span begin="01:03.370" end="01:03.666">Oh </span><span begin="01:03.666" end="01:04.170">baby </span><span begin="01:04.170" end="01:04.690">take </span><span begin="01:04.690" end="01:05.322">my </span><span begin="01:05.322" end="01:06.194">hand</span></p><p ttm:agent="v1" begin="01:06.595" end="01:09.316"><span begin="01:06.595" end="01:06.858">We'll </span><span begin="01:06.858" end="01:07.121">walk </span><span begin="01:07.121" end="01:07.737">toward </span><span begin="01:07.737" end="01:08.289">the </span><span begin="01:08.289" end="01:09.316">sand</span></p><p ttm:agent="v1" begin="01:09.713" end="01:12.450"><span begin="01:09.713" end="01:09.962">I </span><span begin="01:09.962" end="01:10.345">wanna </span><span begin="01:10.345" end="01:10.890">go </span><span begin="01:10.890" end="01:11.435">with </span><span begin="01:11.435" end="01:12.450">you</span></p><p ttm:agent="v1" begin="01:12.756" end="01:15.503"><span begin="01:12.756" end="01:13.097">And </span><span begin="01:13.097" end="01:13.523">only </span><span begin="01:13.523" end="01:14.025">you </span><span begin="01:14.025" end="01:14.571">my </span><span begin="01:14.571" end="01:15.503">boo</span></p><p ttm:agent="v1" begin="01:15.790" end="01:18.633"><span begin="01:15.790" end="01:16.050">I </span><span begin="01:16.050" end="01:16.540">wanna </span><span begin="01:16.540" end="01:17.066">be </span><span begin="01:17.066" end="01:17.665">your </span><span begin="01:17.665" end="01:18.633">man</span></p><p ttm:agent="v1" begin="01:18.952" end="01:21.825"><span begin="01:18.952" end="01:19.232">The </span><span begin="01:19.232" end="01:19.680">future </span><span begin="01:19.680" end="01:20.144">we </span><span begin="01:20.144" end="01:20.777">will </span><span begin="01:20.777" end="01:21.825">plan</span></p><p ttm:agent="v1" begin="01:22.104" end="01:24.680"><span begin="01:22.104" end="01:22.376">The </span><span begin="01:22.376" end="01:22.682">things </span><span begin="01:22.682" end="01:22.872">we </span><span begin="01:22.872" end="01:23.777">wanna </span><span begin="01:23.777" end="01:24.680">do</span></p><p ttm:agent="v1" begin="01:24.888" end="01:27.890"><span begin="01:24.888" end="01:25.064">Like </span><span begin="01:25.064" end="01:25.240">watch </span><span begin="01:25.240" end="01:25.439">the </span><span begin="01:25.439" end="01:26.385">sunset </span><span begin="01:26.385" end="01:26.944">with </span><span begin="01:26.944" end="01:27.890">you</span></p><p ttm:agent="v1" begin="01:29.714" end="01:37.644"><span begin="01:29.714" end="01:30.146">Hey </span><span begin="01:30.146" end="01:31.563">boy </span><span begin="01:33.655" end="01:33.794">wanna </span><span begin="01:33.794" end="01:34.114">stick </span><span begin="01:34.114" end="01:34.650">around </span><span begin="01:34.650" end="01:34.810">with </span><span begin="01:34.810" end="01:35.171">you </span><span begin="01:35.171" end="01:35.707">all </span><span begin="01:35.707" end="01:36.276">night </span><span begin="01:36.276" end="01:37.644">long</span></p><p ttm:agent="v1" begin="01:39.260" end="01:43.387"><span begin="01:39.260" end="01:39.636">Until </span><span begin="01:39.636" end="01:39.909">we </span><span begin="01:39.909" end="01:40.219">get </span><span begin="01:40.219" end="01:40.884">tired </span><span begin="01:40.884" end="01:41.149">and </span><span begin="01:41.149" end="01:41.603">finish </span><span begin="01:41.603" end="01:41.919">all </span><span begin="01:41.919" end="01:42.436">the </span><span begin="01:42.436" end="01:43.387">songs</span></p><p ttm:agent="v1" begin="01:45.595" end="01:48.562"><span begin="01:45.595" end="01:45.731">I </span><span begin="01:45.731" end="01:46.011">liked </span><span begin="01:46.011" end="01:46.579">it </span><span begin="01:46.579" end="01:46.940">when </span><span begin="01:46.940" end="01:47.208">you </span><span begin="01:47.208" end="01:47.645">danced </span><span begin="01:47.645" end="01:47.794">with </span><span begin="01:47.794" end="01:48.562">me</span></p><p ttm:agent="v1" begin="01:48.562" end="01:54.542"><span begin="01:48.562" end="01:49.107">Every </span><span begin="01:49.107" end="01:50.146">single </span><span begin="01:50.146" end="01:50.732">step </span><span begin="01:50.732" end="01:51.165">I </span><span begin="01:51.165" end="01:51.715">feel </span><span begin="01:51.715" end="01:52.202">so </span><span begin="01:52.202" end="01:53.107">alive </span><span begin="01:53.107" end="01:53.351">and </span><span begin="01:53.351" end="01:54.542">thrilled</span></p><p ttm:agent="v1" begin="01:54.726" end="01:57.550"><span begin="01:54.726" end="01:54.918">Oh </span><span begin="01:54.918" end="01:55.150">be </span><span begin="01:55.150" end="01:55.463">my </span><span begin="01:55.463" end="01:55.751">ride </span><span begin="01:55.751" end="01:55.982">or </span><span begin="01:55.982" end="01:56.414">die </span><span begin="01:56.414" end="01:57.550">baby</span></p><p ttm:agent="v1" begin="01:57.878" end="01:59.863"><span begin="01:57.878" end="01:58.102">I'll </span><span begin="01:58.102" end="01:58.566">never </span><span begin="01:58.566" end="01:58.887">let </span><span begin="01:58.887" end="01:59.070">you </span><span begin="01:59.070" end="01:59.863">go</span></p><p ttm:agent="v1" begin="02:00.503" end="02:05.654"><span begin="02:00.503" end="02:00.695">Oh </span><span begin="02:00.695" end="02:01.097">boy </span><span begin="02:01.097" end="02:01.471">it's </span><span begin="02:01.471" end="02:02.215">you </span><span begin="02:02.462" end="02:02.766">and </span><span begin="02:02.766" end="02:03.652">me </span><span begin="02:03.652" end="02:04.100">against </span><span begin="02:04.100" end="02:04.852">the </span><span begin="02:04.852" end="02:05.654">world</span></p><p ttm:agent="v1" begin="02:05.654" end="02:08.349"><span begin="02:05.654" end="02:05.865">Oh </span><span begin="02:05.865" end="02:06.312">baby </span><span begin="02:06.312" end="02:06.765">take </span><span begin="02:06.765" end="02:07.277">my </span><span begin="02:07.277" end="02:08.349">hand</span></p><p ttm:agent="v1" begin="02:08.686" end="02:11.473"><span begin="02:08.686" end="02:09.005">We'll </span><span begin="02:09.005" end="02:09.197">walk </span><span begin="02:09.197" end="02:09.813">towards </span><span begin="02:09.813" end="02:10.429">the </span><span begin="02:10.429" end="02:11.473">sand</span></p><p ttm:agent="v1" begin="02:11.765" end="02:14.463"><span begin="02:11.765" end="02:12.069">I </span><span begin="02:12.069" end="02:12.461">wanna </span><span begin="02:12.461" end="02:12.958">go </span><span begin="02:12.958" end="02:13.517">with </span><span begin="02:13.517" end="02:14.463">you</span></p><p ttm:agent="v1" begin="02:14.783" end="02:17.607"><span begin="02:14.783" end="02:15.064">And </span><span begin="02:15.064" end="02:15.513">only </span><span begin="02:15.513" end="02:16.015">you </span><span begin="02:16.015" end="02:16.559">my </span><span begin="02:16.559" end="02:17.607">boo</span></p><p ttm:agent="v1" begin="02:17.943" end="02:20.598"><span begin="02:17.943" end="02:18.153">I </span><span begin="02:18.153" end="02:18.598">wanna </span><span begin="02:18.598" end="02:19.144">be </span><span begin="02:19.144" end="02:19.759">your </span><span begin="02:19.759" end="02:20.598">girl</span></p><p ttm:agent="v1" begin="02:21.136" end="02:23.789"><span begin="02:21.136" end="02:21.367">And </span><span begin="02:21.367" end="02:21.551">you </span><span begin="02:21.551" end="02:22.214">become </span><span begin="02:22.214" end="02:22.767">my </span><span begin="02:22.767" end="02:23.789">world</span></p><p ttm:agent="v1" begin="02:24.085" end="02:26.424"><span begin="02:24.085" end="02:24.382">The </span><span begin="02:24.382" end="02:24.520">things </span><span begin="02:24.520" end="02:24.817">we </span><span begin="02:24.817" end="02:25.791">wanna </span><span begin="02:25.791" end="02:26.424">do</span></p><p ttm:agent="v1" begin="02:26.687" end="02:29.983"><span begin="02:26.687" end="02:26.935">Like </span><span begin="02:26.935" end="02:27.176">watch </span><span begin="02:27.176" end="02:27.432">the </span><span begin="02:27.432" end="02:28.439">sunset </span><span begin="02:28.439" end="02:28.967">with </span><span begin="02:28.967" end="02:29.983">you</span></p><p ttm:agent="v1" begin="02:55.327" end="02:58.007"><span begin="02:55.327" end="02:55.617">Oh </span><span begin="02:55.617" end="02:55.982">baby </span><span begin="02:55.982" end="02:56.470">take </span><span begin="02:56.470" end="02:57.038">my </span><span begin="02:57.038" end="02:58.007">hand</span></p><p ttm:agent="v1" begin="02:58.374" end="03:00.999"><span begin="02:58.374" end="02:58.568">We'll </span><span begin="02:58.568" end="02:58.927">walk </span><span begin="02:58.927" end="02:59.584">toward </span><span begin="02:59.584" end="03:00.047">the </span><span begin="03:00.047" end="03:00.999">sand</span></p><p ttm:agent="v1" begin="03:01.374" end="03:04.126"><span begin="03:01.374" end="03:01.633">I </span><span begin="03:01.633" end="03:02.071">wanna </span><span begin="03:02.071" end="03:02.562">go </span><span begin="03:02.562" end="03:03.064">with </span><span begin="03:03.064" end="03:04.126">you</span></p><p ttm:agent="v1" begin="03:04.439" end="03:07.174"><span begin="03:04.439" end="03:04.710">And </span><span begin="03:04.710" end="03:05.326">only </span><span begin="03:05.326" end="03:05.838">you </span><span begin="03:05.838" end="03:06.351">my </span><span begin="03:06.351" end="03:07.174">boo</span></p><p ttm:agent="v1" begin="03:07.598" end="03:10.311"><span begin="03:07.598" end="03:07.823">I </span><span begin="03:07.823" end="03:08.239">wanna </span><span begin="03:08.239" end="03:08.759">be </span><span begin="03:08.759" end="03:09.430">your </span><span begin="03:09.430" end="03:10.311">man</span></p><p ttm:agent="v1" begin="03:10.686" end="03:13.609"><span begin="03:10.686" end="03:10.934">The </span><span begin="03:10.934" end="03:11.439">future </span><span begin="03:11.439" end="03:11.934">we </span><span begin="03:11.934" end="03:12.494">will </span><span begin="03:12.494" end="03:13.609">plan</span></p><p ttm:agent="v1" begin="03:13.870" end="03:16.332"><span begin="03:13.870" end="03:14.111">The </span><span begin="03:14.111" end="03:14.273">things </span><span begin="03:14.273" end="03:14.544">we </span><span begin="03:14.544" end="03:15.506">wanna </span><span begin="03:15.506" end="03:16.332">do</span></p><p ttm:agent="v1" begin="03:16.548" end="03:19.642"><span begin="03:16.548" end="03:16.733">Like </span><span begin="03:16.733" end="03:16.954">watch </span><span begin="03:16.954" end="03:17.181">the </span><span begin="03:17.181" end="03:18.134">sunset </span><span begin="03:18.134" end="03:18.668">with </span><span begin="03:18.668" end="03:19.642">you</span></p><p ttm:agent="v1" begin="03:21.913" end="03:33.329"><span begin="03:21.913" end="03:23.265">Boy </span><span begin="03:24.793" end="03:25.042">I </span><span begin="03:25.042" end="03:25.673">wanna </span><span begin="03:25.673" end="03:26.373">spend </span><span begin="03:26.373" end="03:26.657">the </span><span begin="03:26.657" end="03:26.973">rest </span><span begin="03:26.973" end="03:27.410">of </span><span begin="03:27.410" end="03:28.018">my </span><span begin="03:28.018" end="03:29.650">whole </span><span begin="03:29.650" end="03:30.265">life </span><span begin="03:30.770" end="03:31.025">with </span><span begin="03:31.025" end="03:33.329">you</span></p><p ttm:agent="v1" begin="03:33.722" end="03:42.811"><span begin="03:33.722" end="03:34.817">Oh </span><span begin="03:34.817" end="03:36.274">girl </span><span begin="03:37.154" end="03:37.363">I </span><span begin="03:37.363" end="03:37.761">wanna </span><span begin="03:37.761" end="03:38.249">take </span><span begin="03:38.249" end="03:38.873">this </span><span begin="03:38.873" end="03:40.265">chance </span><span begin="03:40.265" end="03:40.530">so </span><span begin="03:40.530" end="03:40.858">I </span><span begin="03:40.858" end="03:41.026">can </span><span begin="03:41.026" end="03:41.473">be </span><span begin="03:41.473" end="03:41.867">your </span><span begin="03:41.867" end="03:42.811">man</span></p><p ttm:agent="v1" begin="03:43.217" end="03:49.660"><span begin="03:43.217" end="03:43.441">Girl </span><span begin="03:43.441" end="03:43.961">I </span><span begin="03:43.961" end="03:44.316">just </span><span begin="03:44.316" end="03:45.125">wanna </span><span begin="03:45.125" end="03:45.676">sing </span><span begin="03:45.676" end="03:46.077">with </span><span begin="03:46.077" end="03:49.660">you</span></p></div></body></tt>