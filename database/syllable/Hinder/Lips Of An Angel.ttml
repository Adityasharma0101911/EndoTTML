<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Lips Of An Angel</ttm:title><ttm:agent type="person" xml:id="v1">Hinder</ttm:agent><ttm:item type="album">Extreme Behavior</ttm:item><ttm:item type="spotify_id">40LQiUUUKXVGyNs09lHVjW</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:08.580" end="00:14.490"><span begin="00:08.580" end="00:09.210">Honey </span><span begin="00:09.210" end="00:09.450">why </span><span begin="00:09.450" end="00:09.480">are </span><span begin="00:09.480" end="00:09.660">you </span><span begin="00:09.660" end="00:10.620">calling </span><span begin="00:10.620" end="00:11.850">me </span><span begin="00:11.850" end="00:12.900">so </span><span begin="00:12.900" end="00:14.490">late</span></p><p ttm:agent="v1" begin="00:15.960" end="00:20.220"><span begin="00:15.960" end="00:16.200">It's </span><span begin="00:16.200" end="00:16.680">kinda </span><span begin="00:16.680" end="00:16.950">hard </span><span begin="00:16.950" end="00:17.070">to </span><span begin="00:17.070" end="00:17.640">talk </span><span begin="00:17.640" end="00:18.510">right </span><span begin="00:18.510" end="00:20.220">now</span></p><p ttm:agent="v1" begin="00:23.580" end="00:29.280"><span begin="00:23.580" end="00:24.090">Honey </span><span begin="00:24.090" end="00:24.330">why </span><span begin="00:24.330" end="00:24.360">are </span><span begin="00:24.360" end="00:24.540">you </span><span begin="00:24.540" end="00:25.350">crying </span><span begin="00:25.350" end="00:25.620">is </span><span begin="00:25.620" end="00:27.480">everything </span><span begin="00:27.480" end="00:29.280">okay</span></p><p ttm:agent="v1" begin="00:30.390" end="00:34.980"><span begin="00:30.390" end="00:30.540">I </span><span begin="00:30.540" end="00:31.050">gotta </span><span begin="00:31.050" end="00:31.500">whisper </span><span begin="00:31.500" end="00:31.860">cause </span><span begin="00:31.860" end="00:31.950">I </span><span begin="00:31.950" end="00:32.460">can't </span><span begin="00:32.460" end="00:32.850">be </span><span begin="00:32.850" end="00:33.390">too </span><span begin="00:33.390" end="00:34.980">loud</span></p><p ttm:agent="v1" begin="00:36.900" end="00:41.550"><span begin="00:36.900" end="00:37.860">Well</span><span begin="00:37.860" end="00:37.920">, </span><span begin="00:37.920" end="00:38.520">my </span><span begin="00:38.520" end="00:39.120">girls </span><span begin="00:39.120" end="00:39.780">in </span><span begin="00:39.780" end="00:40.350">the </span><span begin="00:40.350" end="00:40.920">next </span><span begin="00:40.920" end="00:41.550">room</span></p><p ttm:agent="v1" begin="00:41.580" end="00:45.270"><span begin="00:41.580" end="00:42.810">Sometimes </span><span begin="00:42.810" end="00:43.140">I </span><span begin="00:43.140" end="00:43.560">wish </span><span begin="00:43.560" end="00:44.070">she </span><span begin="00:44.070" end="00:44.610">was </span><span begin="00:44.610" end="00:45.270">you</span></p><p ttm:agent="v1" begin="00:45.450" end="00:50.910"><span begin="00:45.450" end="00:45.930">I </span><span begin="00:45.930" end="00:46.470">guess </span><span begin="00:46.470" end="00:46.890">we </span><span begin="00:46.890" end="00:47.400">never </span><span begin="00:47.400" end="00:47.820">really </span><span begin="00:47.820" end="00:48.660">moved </span><span begin="00:48.660" end="00:50.910">on</span></p><p ttm:agent="v1" begin="00:51.300" end="00:55.860"><span begin="00:51.300" end="00:51.600">It's </span><span begin="00:51.600" end="00:51.990">really </span><span begin="00:51.990" end="00:52.290">good </span><span begin="00:52.290" end="00:52.440">to </span><span begin="00:52.440" end="00:52.920">hear </span><span begin="00:52.920" end="00:53.340">your </span><span begin="00:53.340" end="00:54.210">voice </span><span begin="00:54.210" end="00:54.810">saying </span><span begin="00:54.810" end="00:55.230">my </span><span begin="00:55.230" end="00:55.860">name</span></p><p ttm:agent="v1" begin="00:55.860" end="00:58.740"><span begin="00:55.860" end="00:56.070">It </span><span begin="00:56.070" end="00:56.790">sounds </span><span begin="00:56.790" end="00:57.330">so </span><span begin="00:57.330" end="00:58.740">sweet</span></p><p ttm:agent="v1" begin="00:58.890" end="01:01.560"><span begin="00:58.890" end="00:59.430">Coming </span><span begin="00:59.430" end="00:59.730">from </span><span begin="00:59.730" end="00:59.850">the </span><span begin="00:59.850" end="01:00.450">lips </span><span begin="01:00.450" end="01:00.720">of </span><span begin="01:00.720" end="01:00.930">an </span><span begin="01:00.930" end="01:01.560">angel</span></p><p ttm:agent="v1" begin="01:01.710" end="01:06.090"><span begin="01:01.710" end="01:02.310">Hearing </span><span begin="01:02.310" end="01:02.760">those </span><span begin="01:02.760" end="01:03.270">words </span><span begin="01:03.270" end="01:03.570">it </span><span begin="01:03.570" end="01:04.350">makes </span><span begin="01:04.350" end="01:04.830">me </span><span begin="01:04.830" end="01:06.090">weak</span></p><p ttm:agent="v1" begin="01:07.260" end="01:12.270"><span begin="01:07.260" end="01:07.530">And </span><span begin="01:07.530" end="01:08.640">I </span><span begin="01:08.640" end="01:09.210">never </span><span begin="01:09.210" end="01:09.840">wanna </span><span begin="01:09.840" end="01:10.380">say </s