pan begin="00:39.669" end="00:39.964">on </span><span begin="00:39.964" end="00:40.245">ya</span></p><p ttm:agent="v1" begin="00:40.250" end="00:42.222"><span begin="00:40.250" end="00:40.512">Let's </span><span begin="00:40.512" end="00:40.751">get </span><span begin="00:40.751" end="00:40.969">it </span><span begin="00:40.969" end="00:42.222">blazing</span></p><p ttm:agent="v1" begin="00:42.451" end="00:44.249"><span begin="00:42.451" end="00:42.637">We </span><span begin="00:42.637" end="00:42.804">can </span><span begin="00:42.804" end="00:42.961">turn </span><span begin="00:42.961" end="00:43.088">the </span><span begin="00:43.088" end="00:43.312">heat </span><span begin="00:43.312" end="00:43.575">up </span><span begin="00:43.575" end="00:43.712">if </span><span begin="00:43.712" end="00:43.855">ya </span><span begin="00:43.855" end="00:44.249">wanna</span></p><p ttm:agent="v1" begin="00:44.466" end="00:46.349"><span begin="00:44.466" end="00:44.657">Turn </span><span begin="00:44.657" end="00:44.831">the </span><span begin="00:44.831" end="00:45.070">lights </span><span begin="00:45.070" end="00:45.291">down </span><span begin="00:45.291" end="00:45.562">low </span><span begin="00:45.562" end="00:45.727">if </span><span begin="00:45.727" end="00:45.854">ya </span><span begin="00:45.854" end="00:46.349">wanna</span></p><p ttm:agent="v1" begin="00:46.573" end="00:48.190"><span begin="00:46.573" end="00:46.863">Just </span><span begin="00:46.863" end="00:47.190">wanna </span><span begin="00:47.190" end="00:47.384">move </span><span begin="00:47.384" end="00:47.583">ya </span><span begin="00:47.583" end="00:47.743">but </span><span begin="00:47.743" end="00:47.910">you're </span><span begin="00:47.910" end="00:48.190">frozen</span></p><p ttm:agent="v1" begin="00:48.413" end="00:49.435"><span begin="00:48.413" end="00:48.616">That's </span><span begin="00:48.616" end="00:48.871">what </span><span begin="00:48.871" end="00:49.140">I'm </span><span begin="00:49.140" end="00:49.435">saying</span></p><p ttm:agent="v1" begin="00:49.439" end="00:50.854"><span begin="00:49.439" end="00:49.678">Let </span><span begin="00:49.678" end="00:49.861">me </span><span begin="00:49.861" end="00:50.128">break </span><span begin="00:50.128" end="00:50.391">the </span><span begin="00:50.391" end="00:50.854">ice</span></p><p ttm:agent="v1" begin="00:51.155" end="00:52.871"><span begin="00:51.155" end="00:51.447">Allow </span><span begin="00:51.447" end="00:51.707">me </span><span begin="00:51.707" end="00:51.954">to </span><span begin="00:51.954" end="00:52.201">get </span><span begin="00:52.201" end="00:52.464">you </span><span begin="00:52.464" end="00:52.871">right</span></p><p ttm:agent="v1" begin="00:53.150" end="00:54.528"><span begin="00:53.150" end="00:53.327">Once </span><span begin="00:53.327" end="00:53.518">ya </span><span begin="00:53.518" end="00:53.697">warm </span><span begin="00:53.697" end="00:53.936">up </span><span begin="00:53.936" end="00:54.183">to </span><span begin="00:54.183" end="00:54.528">me</span></p><p ttm:agent="v1" begin="00:54.534" end="00:56.529"><span begin="00:54.534" end="00:55.024">Baby </span><span begin="00:55.024" end="00:55.303">I </span><span begin="00:55.303" end="00:55.558">can </span><span begin="00:55.558" end="00:55.812">make </span><span begin="00:55.812" end="00:56.027">you </span><span begin="00:56.027" end="00:56.529">feel</span></p><p ttm:agent="v1" begin="00:56.535" end="00:57.208"><span begin="00:56.535" end="00:56.977">Hot </span><span begin="00:56.977" end="00:57.208">hot</span></p><p ttm:agent="v1" begin="00:57.369" end="00:59.045"><span begin="00:57.369" end="00:57.791">Let </span><span begin="00:57.791" end="00:58.078">me </span><span begin="00:58.078" end="00:58.343">break </span><span begin="00:58.343" end="00:58.574">the </span><span begin="00:58.574" end="00:59.045">ice</span></p><p ttm:agent="v1" begin="00:59.298" end="01:01.084"><span begin="00:59.298" end="00:59.677">Allow </spa