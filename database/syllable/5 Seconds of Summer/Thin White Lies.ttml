<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Thin White Lies</ttm:title><ttm:agent type="person" xml:id="v1">5 Seconds of Summer</ttm:agent><ttm:item type="album">CALM</ttm:item><ttm:item type="spotify_id">4t4OlapTFToGpFKOldh5S2</ttm:item><itunes:duration>03:02.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:12.879" end="00:16.009"><span begin="00:12.879" end="00:13.103">I </span><span begin="00:13.103" end="00:13.358">don't </span><span begin="00:13.358" end="00:13.566">feel </span><span begin="00:13.566" end="00:13.822">your </span><span begin="00:13.822" end="00:14.463">love</span></p><p ttm:agent="v1" begin="00:16.010" end="00:19.170"><span begin="00:16.010" end="00:16.218">And </span><span begin="00:16.218" end="00:16.409">I </span><span begin="00:16.409" end="00:16.697">don't </span><span begin="00:16.697" end="00:17.081">ask </span><span begin="00:17.081" end="00:17.402">too </span><span begin="00:17.402" end="00:18.329">many </span><span begin="00:18.329" end="00:19.171">questions</span></p><p ttm:agent="v1" begin="00:19.171" end="00:22.538"><span begin="00:19.171" end="00:19.411">The </span><span begin="00:19.411" end="00:19.603">words </span><span begin="00:19.603" end="00:19.795">they </span><span begin="00:19.795" end="00:20.019">are </span><span begin="00:20.019" end="00:20.227">too </span><span begin="00:20.227" end="00:20.995">much</span></p><p ttm:agent="v1" begin="00:22.539" end="00:25.415"><span begin="00:22.539" end="00:22.831">When </span><span begin="00:22.831" end="00:23.148">you </span><span begin="00:23.148" end="00:23.548">show </span><span begin="00:23.548" end="00:23.980">me </span><span begin="00:23.980" end="00:24.364">my </span><span begin="00:24.364" end="00:25.416">reflection</span></p><p ttm:agent="v1" begin="00:25.416" end="00:28.946"><span begin="00:25.416" end="00:25.575">When </span><span begin="00:25.575" end="00:25.799">the </span><span begin="00:25.799" end="00:26.168">sun </span><span begin="00:26.168" end="00:26.535">goes </span><span begin="00:26.535" end="00:26.935">down </span><span begin="00:26.935" end="00:27.128">we </span><span begin="00:27.128" end="00:27.606">all </span><span begin="00:27.606" end="00:28.004">get </span><span begin="00:28.004" end="00:28.755">lonely</span></p><p ttm:agent="v1" begin="00:28.947" end="00:32.066"><span begin="00:28.947" end="00:29.315">Watch </span><span begin="00:29.315" end="00:29.459">me </span><span begin="00:29.459" end="00:29.635">as </span><span begin="00:29.635" end="00:29.859">I </span><span begin="00:29.859" end="00:31.139">disappear</span></p><p ttm:agent="v1" begin="00:32.067" end="00:35.236"><span begin="00:32.067" end="00:32.244">These </span><span begin="00:32.244" end="00:33.011">empty </span><span begin="00:33.011" end="00:33.396">sounds </span><span begin="00:33.396" end="00:33.635">and </span><span begin="00:33.635" end="00:34.355">endless </span><span begin="00:34.355" end="00:35.235">stories</span></p><p ttm:agent="v1" begin="00:35.237" end="00:37.589"><span begin="00:35.237" end="00:35.445">So </span><span begin="00:35.445" end="00:35.605">tell </span><span begin="00:35.605" end="00:35.797">me </span><span begin="00:35.797" end="00:35.973">what </span><span begin="00:35.973" end="00:36.213">I </span><span begin="00:36.213" end="00:36.614">wanna </span><span begin="00:36.614" end="00:37.381">hear</span></p><p ttm:agent="v1" begin="00:37.590" end="00:38.512"><span begin="00:37.590" end="00:37.942">Thin </span><span begin="00:37.942" end="00:38.390">white </span><span begin="00:38.390" end="00:38.513">lies</span></p><p ttm:agent="v1" begin="00:38.513" end="00:41.573"><span begin="00:38.513" end="00:38.929">Killin' </span><span begin="00:38.929" end="00:39.307">me </span><span begin="00:39.307" end="00:39.752">slowly </span><span begin="00:39.752" end="00:39.928">with </span><span begin="00:39.928" end="00:40.136">the </span><span begin="00:40.136" end="00:40.344">words </span><span begin="00:40.344" end="00:40.600">you </span><span begin="00:40.600" end="00:41.112">wrote</span></p><p ttm:agent="v1" begin="00:41.574" end="00:45.021"><span begin="00:41.574" end="00:41.766">The </span><span begin="00:41.766" end="00:41.958">heart </span><span begin="00:41.958" end="00:42.182">you </span><span begin="00:42.182" end="00:42.645">broke </span><span begin="00:43.205" end="00:43.471">that </span><span begin="00:43.471" end="00:43.791">you </span><span begin="00:43.791" end="00:44.208">broke </span><span begin="00:44.208" end="00:44.703">yeah</span></p><p ttm:agent="v1" begin="00:45.022" end="00:47.844"><span begin="00:45.022" end="00:45.374">Callin' </span><span begin="00:45.374" end="00:45.770">my </span><span begin="00:45.770" end="00:46.186">name </span><span begin="00:46.186" end="00:46.378">I </span><span begin="00:46.378" end="00:46.581">don't </span><span begin="00:46.581" end="00:46.917">wanna </span><span begin="00:46.917" end="00:47.557">stay</span></p><p ttm:agent="v1" begin="00:47.845" end="00:50.528"><span begin="00:47.845" end="00:48.037">But </span><span begin="00:48.037" end="00:48.261">I'm </span><span begin="00:48.261" end="00:48.533">wide </span><span begin="00:48.533" end="00:49.159">awake </span><span begin="00:49.655" end="00:49.879">I'm </span><span begin="00:49.879" end="00:50.087">wide </span><span begin="00:50.087" end="00:50.529">awake</span></p><p ttm:agent="v1" begin="00:50.529" end="00:51.544"><span begin="00:50.529" end="00:50.801">Thin </span><span begin="00:50.801" end="00:51.137">white </span><span begin="00:51.137" end="00:51.545">lies</span></p><p ttm:agent="v1" begin="00:51.545" end="00:57.013"><span begin="00:51.545" end="00:51.961">Just </span><span begin="00:51.961" end="00:52.313">one </span><span begin="00:52.313" end="00:52.746">more </span><span begin="00:52.746" end="00:53.162">taste </span><span begin="00:53.162" end="00:53.514">of </span><span begin="00:53.514" end="00:53.914">you </span><span begin="00:53.914" end="00:54.346">my </span><span begin="00:54.346" end="00:56.437">love</span></p><p ttm:agent="v1" begin="00:57.014" end="00:57.784"><span begin="00:57.014" end="00:57.254">Thin </span><span begin="00:57.254" end="00:57.622">white </span><span begin="00:57.622" end="00:57.785">lies</span></p><p ttm:agent="v1" begin="00:57.785" end="01:00.759"><span begin="00:57.785" end="00:58.202">Killin' </span><span begin="00:58.202" end="00:58.521">me </span><span begin="00:58.521" end="00:58.968">slowly </span><span begin="00:58.968" end="00:59.160">with </span><span begin="00:59.160" end="00:59.384">the </span><span begin="00:59.384" end="00:59.576">words </span><span begin="00:59.576" end="00:59.800">you </span><span begin="00:59.800" end="01:00.248">wrote</span></p><p ttm:agent="v1" begin="01:00.760" end="01:04.018"><span begin="01:00.760" end="01:00.983">The </span><span begin="01:00.983" end="01:01.207">heart </span><span begin="01:01.207" end="01:01.415">you </span><span begin="01:01.415" end="01:01.943">broke </span><span begin="01:02.455" end="01:02.720">that </span><span begin="01:02.720" end="01:03.008">you </span><span begin="01:03.008" end="01:03.392">broke </span><span begin="01:03.392" end="01:04.019">yeah</span></p><p ttm:agent="v1" begin="01:04.019" end="01:07.218"><span begin="01:04.019" end="01:04.243">You </span><span begin="01:04.243" end="01:04.611">never </span><span begin="01:04.611" end="01:04.819">call </span><span begin="01:04.819" end="01:05.043">me </span><span begin="01:05.043" end="01:05.699">out</span></p><p ttm:agent="v1" begin="01:07.219" end="01:10.400"><span begin="01:07.219" end="01:07.379">You </span><span begin="01:07.379" end="01:07.590">know </span><span begin="01:07.590" end="01:08.804">exactly </span><span begin="01:08.804" end="01:09.156">where </span><span begin="01:09.156" end="01:09.620">I'm </span><span begin="01:09.620" end="01:10.401">goin'</span></p><p ttm:agent="v1" begin="01:10.401" end="01:13.659"><span begin="01:10.401" end="01:10.561">You </span><span begin="01:10.561" end="01:10.769">got </span><span begin="01:10.769" end="01:10.961">me </span><span begin="01:10.961" end="01:11.169">by </span><span begin="01:11.169" end="01:11.377">the </span><span begin="01:11.377" end="01:12.290">mouth</span></p><p ttm:agent="v1" begin="01:13.660" end="01:16.572"><span begin="01:13.660" end="01:13.820">She </span><span begin="01:13.820" end="01:14.060">says </span><span begin="01:14.060" end="01:14.364">she </span><span begin="01:14.364" end="01:14.796">love </span><span begin="01:14.796" end="01:15.164">me </span><span begin="01:15.164" end="01:15.532">she </span><span begin="01:15.532" end="01:15.948">don't </span><span begin="01:15.948" end="01:16.364">show </span><span begin="01:16.364" end="01:16.573">it</span></p><p ttm:agent="v1" begin="01:16.573" end="01:20.118"><span begin="01:16.573" end="01:16.760">When </span><span begin="01:16.760" end="01:16.983">the </span><span begin="01:16.983" end="01:17.367">sun </span><span begin="01:17.367" end="01:17.783">goes </span><span begin="01:17.783" end="01:18.199">down </span><span begin="01:18.199" end="01:18.407">we </span><span begin="01:18.407" end="01:18.711">all </span><span begin="01:18.711" end="01:18.967">get </span><span begin="01:18.967" end="01:19.943">lonely</span></p><p ttm:agent="v1" begin="01:20.119" end="01:23.159"><span begin="01:20.119" end="01:20.439">Watch </span><span begin="01:20.439" end="01:20.679">me </span><span begin="01:20.679" end="01:20.871">as </span><span begin="01:20.871" end="01:21.082">I </span><span begin="01:21.082" end="01:22.231">disappear</span></p><p ttm:agent="v1" begin="01:23.160" end="01:26.377"><span begin="01:23.160" end="01:23.399">These </span><span begin="01:23.399" end="01:24.263">empty </span><span begin="01:24.263" end="01:24.567">sounds </span><span begin="01:24.567" end="01:24.839">and </span><span begin="01:24.839" end="01:25.543">endless </span><span begin="01:25.543" end="01:26.378">stories</span></p><p ttm:agent="v1" begin="01:26.378" end="01:29.001"><span begin="01:26.378" end="01:26.586">So </span><span begin="01:26.586" end="01:26.810">tell </span><span begin="01:26.810" end="01:27.018">me </span><span begin="01:27.018" end="01:27.226">what </span><span begin="01:27.226" end="01:27.451">I </span><span begin="01:27.451" end="01:27.802">wanna </span><span begin="01:27.802" end="01:28.618">hear</span></p><p ttm:agent="v1" begin="01:29.002" end="01:29.784"><span begin="01:29.002" end="01:29.274">Thin </span><span begin="01:29.274" end="01:29.594">white </span><span begin="01:29.594" end="01:29.785">lies</span></p><p ttm:agent="v1" begin="01:29.785" end="01:32.862"><span begin="01:29.785" end="01:30.135">Killin' </span><span begin="01:30.135" end="01:30.599">me </span><span begin="01:30.599" end="01:30.980">slowly </span><span begin="01:30.980" end="01:31.172">with </span><span begin="01:31.172" end="01:31.364">the </span><span begin="01:31.364" end="01:31.556">words </span><span begin="01:31.556" end="01:31.764">you </span><span begin="01:31.764" end="01:32.276">wrote</span></p><p ttm:agent="v1" begin="01:32.863" end="01:36.237"><span begin="01:32.863" end="01:33.007">The </span><span begin="01:33.007" end="01:33.183">heart </span><span begin="01:33.183" end="01:33.407">you </span><span begin="01:33.407" end="01:33.964">broke </span><span begin="01:34.300" end="01:34.766">that </span><span begin="01:34.766" end="01:35.022">you </span><span begin="01:35.022" end="01:35.390">broke </span><span begin="01:35.390" end="01:35.966">yeah</span></p><p ttm:agent="v1" begin="01:36.238" end="01:39.053"><span begin="01:36.238" end="01:36.574">Callin' </span><span begin="01:36.574" end="01:36.926">my </span><span begin="01:36.926" end="01:37.374">name </span><span begin="01:37.374" end="01:37.566">I </span><span begin="01:37.566" end="01:37.838">don't </span><span begin="01:37.838" end="01:38.238">wanna </span><span begin="01:38.238" end="01:38.814">stay</span></p><p ttm:agent="v1" begin="01:39.054" end="01:41.610"><span begin="01:39.054" end="01:39.246">But </span><span begin="01:39.246" end="01:39.454">I'm </span><span begin="01:39.454" end="01:39.774">wide </span><span begin="01:39.774" end="01:40.270">awake </span><span begin="01:40.846" end="01:41.037">I'm </span><span begin="01:41.037" end="01:41.326">wide </span><span begin="01:41.326" end="01:41.611">awake</span></p><p ttm:agent="v1" begin="01:41.611" end="01:42.947"><span begin="01:41.611" end="01:41.995">Thin </span><span begin="01:41.995" end="01:42.331">white </span><span begin="01:42.331" end="01:42.948">lies</span></p><p ttm:agent="v1" begin="01:42.948" end="01:48.179"><span begin="01:42.948" end="01:43.204">Just </span><span begin="01:43.204" end="01:43.588">one </span><span begin="01:43.588" end="01:43.956">more </span><span begin="01:43.956" end="01:44.340">taste </span><span begin="01:44.340" end="01:44.724">of </span><span begin="01:44.724" end="01:45.108">you </span><span begin="01:45.108" end="01:45.540">my </span><span begin="01:45.540" end="01:47.652">love</span></p><p ttm:agent="v1" begin="01:48.180" end="01:49.033"><span begin="01:48.180" end="01:48.420">Thin </span><span begin="01:48.420" end="01:48.772">white </span><span begin="01:48.772" end="01:49.034">lies</span></p><p ttm:agent="v1" begin="01:49.034" end="01:51.982"><span begin="01:49.034" end="0