<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Bodysnatchers</ttm:title><ttm:agent type="person" xml:id="v1">Radiohead</ttm:agent><ttm:item type="album">In Rainbows</ttm:item><ttm:item type="spotify_id">4pWIwnnqx8k01fuF95UMIg</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:11.540" end="00:16.280"><span begin="00:11.540" end="00:11.840">I </span><span begin="00:11.840" end="00:12.170">do </span><span begin="00:12.170" end="00:14.360">not </span><span begin="00:14.360" end="00:16.280">understand</span></p><p ttm:agent="v1" begin="00:17.330" end="00:21.830"><span begin="00:17.330" end="00:17.720">What </span><span begin="00:17.720" end="00:17.990">it </span><span begin="00:17.990" end="00:20.030">is </span><span begin="00:20.030" end="00:20.420">I've </span><span begin="00:20.420" end="00:20.780">done </span><span begin="00:20.780" end="00:21.830">wrong</span></p><p ttm:agent="v1" begin="00:23.030" end="00:27.560"><span begin="00:23.030" end="00:23.420">Full </span><span begin="00:23.420" end="00:23.660">of </span><span begin="00:23.660" end="00:25.130">holes</span><span begin="00:25.130" end="00:25.880">, </span><span begin="00:25.880" end="00:26.330">check </span><span begin="00:26.330" end="00:26.510">for </span><span begin="00:26.510" end="00:27.560">pulse</span></p><p ttm:agent="v1" begin="00:28.760" end="00:30.020"><span begin="00:28.760" end="00:29.240">Blink </span><span begin="00:29.240" end="00:29.420">your </span><span begin="00:29.420" end="00:30.020">eyes</span></p><p ttm:agent="v1" begin="00:31.640" end="00:36.560"><span begin="00:31.640" end="00:32.030">One </span><span begin="00:32.030" end="00:32.210">for </span><span begin="00:32.210" end="00:33.890">yes</span><span begin="00:33.890" end="00:34.520">, </span><span begin="00:34.520" end="00:34.910">two </span><span begin="00:34.910" end="00:35.120">for </span><span begin="00:35.120" end="00:36.560">no</span></p><p ttm:agent="v1" begin="00:41.330" end="00:48.980"><span begin="00:41.330" end="00:41.930">I </span><span begin="00:41.930" end="00:42.140">have </span><span begin="00:42.140" end="00:42.980">no </span><span begin="00:42.980" end="00:44.210">idea </span><span begin="00:44.210" end="00:45.050">what </span><span begin="00:45.050" end="00:45.860">I </span><span begin="00:45.860" end="00:46.400">am </span><span begin="00:46.400" end="00:47.960">talking </span><span begin="00:47.960" end="00:48.980">about</span></p><p ttm:agent="v1" begin="00:52.850" end="00:59.720"><span begin="00:52.850" end="00:53.390">I'm </span><span begin="00:53.390" end="00:54.380">trapped </span><span begin="00:54.380" end="00:54.710">in </span><span begin="00:54.710" end="00:54.980">this </span><span begin="00:54.980" end="00:56.180">body </span><span begin="00:56.180" end="00:56.390">and </span><span begin="00:56.390" end="00:57.800">can't </span><span begin="00:57.800" end="00:58.250">get </span><span begin="00:58.250" end="00:59.720">out</span></p><p ttm:agent="v1" begin="00:59.720" end="01:10.160"><span begin="00:59.720" end="01:01.808">Ooh </span><span begin="01:01.808" end="01:03.896">ooh </span><span begin="01:03.896" end="01:05.984">ooh </span><span begin="01:05.984" end="01:08.072">ooooh </span><span begin="01:08.072" end="01:10.160">ooooooh</span></p><p ttm:agent="v1" begin="01:10.160" end="01:20.360"><span begin="01:10.160" end="01:12.200">Ooh </span><span begin="01:12.200" end="01:14.240">ooh </span><span begin="01:14.240" end="01:16.280">ooh </span><span begin="01:16.280" end="01:18.320">ooooh </span><span begin="01:18.320" end="01:20.360">ooooooh</span></p><p ttm:agent="v1" begin="01:20.360" end="01:25.280"><span begin="01:20.360" end="01:20.450">You </span><span begin="01:20.450" end="01:20.840">killed </span><span begin="01:20.840" end="01:20.900">the </span><span begin="01:20.900" end="01:22.040">sound</span><span begin="01:22.040" end="01:22.880">, </span><span begin="01:22.880" end="01:23.420">removed </span><span begin="01:23.420" end="01:25.280">backbone</span></p><p ttm:agent="v1" begin="01:25.730" end="01:31.670"><span begin="01:25.730" end="01:26.240">Pale </span><span begin="01:26.240" end="01:29.120">imitation </span><span begin="01:29.120" end="01:29.450">with </span><span begin="01:29.450" end="01:29.660">the </span><span begin="01:29.660" end="01:31.130">edges </span><span begin="01:31.130" end="01:31.670">all</span></p><p ttm:agent="v1" begin="01:35.660" end="01:36.080"><span begin="01:35.660" end="01:35.870">Sawn </span><span begin="01:35.870" end="01:36.080">off</span></p><p ttm:agent="v1" begin="01:38.720" end="01:46.520"><span begin="01:38.720" end="01:39.170">I </span><span begin="01:39.170" end="01:39.440">have </span><span begin="01:39.440" end="01:40.190">no </span><span begin="01:40.190" end="01:41.570">idea </span><span begin="01:41.570" end="01:42.380">what </span><span begin="01:42.380" end="01:43.100">you </span><span begin="01:43.100" end="01:43.730">are </span><span begin="01:43.730" end="01:45.290">talking </span><span begin="01:45.290" end="01:46.520">about</span></p><p ttm:agent="v1" begin="01:50.030" end="01:56.720"><span begin="01:50.030" end="01:50.300">Your </span><span begin="01:50.300" end="01:50.960">mouth </span><span begin="01:50.960" end="01:51.620">moves </span><span begin="01:51.620" end="01:52.100">only </span><span begin="01:52.100" end="01:52.910">with </span><span begin="01:52.910" end="01:53.870">someone's </span><span begin="01:53.870" end="01:55.100">hand </span><span begin="01:55.100" end="01:55.340">up </span><span begin="01:55.340" end="01:55.520">your </span><span begin="01:55.520" end="01:56.720">arse</span></p><p ttm:agent="v1" begin="01:56.720" end="02:18.140"><span begin="01:56.720" end="02:01.004">Ooh </span><span begin="02:01.004" end="02:05.288">ooh </span><span begin="02:05.288" end="02:09.572">ooh </span><span begin="02:09.572" end="02:13.856">ooooh </span><span begin="02:13.856" end="02:18.140">ooooooh</span></p><p ttm:agent="v1" begin="02:18.140" end="02:20.960"><span begin="02:18.140" end="02:18.320">Has </span><span begin="02:18.320" end="02:18.410">the </span><span begin="02:18.410" end="02:18.920">light </span><span begin="02:18.920" end="02:19.250">gone </span><span begin="02:19.250" end="02:19.640">out </span><span begin="02:19.640" end="02:19.820">for </span><span begin="02:19.820" end="02:20.780">you</span><span begin="02:20.780" end="02:20.960">?</span></p><p ttm:agent="v1" begin="02:20.960" end="02:23.540"><span begin="02:20.960" end="02:21.380">Because </span><span begin="02:21.380" end="02:21.470">the </span><span begin="02:21.470" end="02:21.860">light's </span><span begin="02:21.860" end="02:22.100">gone </span><span begin="02:22.100" end="02:22.520">out </span><span begin="02:22.520" end="02:22.730">for </span><span begin="02:22.730" end="02:23.540">me</span></p><p ttm:agent="v1" begin="02:23.840" end="02:26.600"><span begin="02:23.840" end="02:24.110">It </span><span begin="02:24.110" end="02:24.260">is </span><span begin="02:24.260" end="02:24.320">the </span><span begin="02:24.320" end="02:24.710">twenty</span><span begin="02:24.710" end="02:24.740">-</span><span begin="02:24.740" end="02:25.040">first </span><span begin="02:25.040" end="02:26.600">century</span></p><p ttm:agent="v1" begin="02:26.780" end="02:29.450"><span begin="02:26.780" end="02:27.020">It </span><span begin="02:27.020" end="02:27.170">is </span><span begin="02:27.170" end="02:27.260">the </span><span begin="02:27.260" end="02:27.620">twenty</span><span begin="02:27.620" end="02:27.650">-</span><span begin="02:27.650" end="02:27.950">first </span><span begin="02:27.950" end="02:29.450">century</span></p><p ttm:agent="v1" begin="02:29.630" end="02:32.420"><span begin="02:29.630" end="02:29.840">It </span><span begin="02:29.840" end="02:29.960">can </span><span begin="02:29.960" end="02:30.470">follow </span><span begin="02:30.470" end="02:30.710">you </span><span begin="02:30.710" end="02:31.310">like </span><span begin="02:31.310" end="02:31.400">a </span><span begin="02:31.400" end="02:32.420">dog</span></p><p ttm:agent="v1" begin="02:32.630" end="02:35.210"><span begin="02:32.630" end="02:32.840">It </span><span begin="02:32.840" end="02:33.230">brought </span><span begin="02:33.230" end="02:33.500">me </span><span begin="02:33.500" end="02:33.950">to </span><span begin="02:33.950" end="02:34.250">my </span><span begin="02:34.250" end="02:35.210">knees</span></p><p ttm:agent="v1" begin="02:35.330" end="02:37.820"><span begin="02:35.330" end="02:35.540">They </span><span begin="02:35.540" end="02:35.750">got </span><span begin="02:35.750" end="02:35.780">a </span><span begin="02:35.780" end="02:36.320">skin </span><span begin="02:36.320" end="02:36.470">and </span><span begin="02:36.470" end="02:36.590">they </span><span begin="02:36.590" end="02:36.860">put </span><span begin="02:36.860" end="02:37.580">me </span><span begin="02:37.580" end="02:37.820">in</span></p><p ttm:agent="v1" begin="02:38.240" end="02:41.060"><span begin="02:38.240" end="02:38.420">They </span><span begin="02:38.420" end="02:38.660">got </span><span begin="02:38.660" end="02:38.690">a </span><span begin="02:38.690" end="02:39.200">skin </span><span begin="02:39.200" end="02:39.350">and </span><span begin="02:39.350" end="02:39.470">they </span><span begin="02:39.470" end="02:39.800">put </span><span begin="02:39.800" end="02:40.100">me </span><span begin="02:40.100" end="02:41.060">in</span></p><p ttm:agent="v1" begin="02:41.150" end="02:43.790"><span begin="02:41.150" end="02:41.330">All </span><span begin="02:41.330" end="02:41.390">the </span><span begin="02:41.390" end="02:42.050">lines </span><span begin="02:42.050" end="02:42.290">wrapped </span><span begin="02:42.290" end="02:42.740">'round </span><span begin="02:42.740" end="02:42.860">my </span><span begin="02:42.860" end="02:43.790">face</span></p><p ttm:agent="v1" begin="02:43.970" end="02:46.640"><span begin="02:43.970" end="02:44.351">All </span><span begin="02:44.351" end="02:44.732">the </span><span begin="02:44.732" end="02:45.113">lines </span><span begin="02:45.113" end="02:45.494">wrapped </span><span begin="02:45.494" end="02:45.875">'round </span><span begin="02:45.875" end="02:46.256">my </span><span begin="02:46.256" end="02:46.640">face</span></p><p ttm:agent="v1" begin="02:46.880" end="02:49.610"><span begin="02:46.880" end="02:47.000">And </span><span begin="02:47.000" end="02:47.330">for </span><span begin="02:47.330" end="02:48.050">anyone </span><span begin="02:48.050" end="02:48.500">else </span><span begin="02:48.500" end="02:48.590">to </span><span begin="02:48.590" end="02:49.610">see</span></p><p ttm:agent="v1" begin="02:49.850" end="02:52.550"><span begin="02:49.850" end="02:49.970">And </span><span begin="02:49.970" end="02:50.180">for </span><span begin="02:50.180" end="02:51.140">anyone </span><span begin="02:51.140" end="02:51.470">else </span><span begin="02:51.470" end="02:51.530">to </span><span begin="02:51.530" end="02:52.550">see</span></p><p ttm:agent="v1" begin="03:15.050" end="03:38.570"><span begin="03:15.050" end="03:16.280">I'm </span><span begin="03:16.280" end="03:38.240">a </span><span begin="03:38.240" end="03:38.570">lie</span></p><p ttm:agent="v1" begin="03:38.570" end="03:43.730"><span begin="03:38.570" end="03:40.070">Nonono </span><span begin="03:40.070" end="03:41.510">nononono </span><span begin="03:41.510" end="03:42.440">nononono </span><span begin="03:42.440" end="03:43.490">nononono </span><span begin="03:43.490" end="03:43.730">no</span></p><p ttm:agent="v1" begin="03:52.790" end="03:54.140"><span begin="03:52.790" end="03:52.910">I've </span><span begin="03:52.910" end="03:53.180">seen </span><span begin="03:53.180" end="03:53.300">it </span><span begin="03:53.300" end="03:54.140">coming</span></p></div></body></tt>