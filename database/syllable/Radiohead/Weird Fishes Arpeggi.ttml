an begin="01:23.820" end="01:24.090">I </span><span begin="01:24.090" end="01:24.900">stay </span><span begin="01:24.900" end="01:26.880">here</span><span begin="01:26.880" end="01:29.280">?</span></p><p ttm:agent="v1" begin="01:29.280" end="01:47.400"><span begin="01:29.280" end="01:29.670">Why </span><span begin="01:29.670" end="01:30.120">should </span><span begin="01:30.120" end="01:32.460">I </span><span begin="01:32.460" end="01:33.780">stay</span><span begin="01:33.780" end="01:47.400">?</span></p><p ttm:agent="v1" begin="01:47.400" end="01:51.210"><span begin="01:47.400" end="01:47.850">I'd </span><span begin="01:47.850" end="01:47.970">be </span><span begin="01:47.970" end="01:48.810">crazy </span><span begin="01:48.810" end="01:49.170">not </span><span begin="01:49.170" end="01:49.500">to </span><span begin="01:49.500" end="01:51.210">follow</span></p><p ttm:agent="v1" begin="01:54.330" end="01:58.650"><span begin="01:54.330" end="01:55.680">Follow </span><span begin="01:55.680" end="01:56.490">where </span><span begin="01:56.490" end="01:57.210">you </span><span begin="01:57.210" end="01:58.650">lead</span></p><p ttm:agent="v1" begin="01:59.940" end="02:02.940"><span begin="01:59.940" end="02:01.440">Your </span><span begin="02:01.440" end="02:02.940">eyes</span></p><p ttm:agent="v1" begin="02:06.150" end="02:09.060"><span begin="02:06.150" end="02:06.540">They </span><span begin="02:06.540" end="02:07.650">turn </span><span begin="02:07.650" end="02:09.060">me</span></p><p ttm:agent="v1" begin="02:13.200" end="02:15.750"><span begin="02:13.200" end="02:13.800">Turn </span><span begin="02:13.800" end="02:14.010">me </span><span begin="02:14.010" end="02:14.280">on </span><span begin="02:14.280" end="02:14.370">to </span><span begin="02:14.370" end="02:15.750">phantoms</span></p><p ttm:agent="v1" begin="02:18.720" end="02:25.860"><span begin="02:18.720" end="02:19.530">I </span><span begin="02:19.530" end="02:20.730">follow </span><span begin="02:20.730" e