<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Lucky</ttm:title><ttm:agent type="person" xml:id="v1">Radiohead</ttm:agent><ttm:item type="album">OK Computer</ttm:item><ttm:item type="spotify_id">14xj58ZexBaEaHARb11Cqs</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:21.820" end="00:25.450"><span begin="00:21.820" end="00:22.330">I'm </span><span begin="00:22.330" end="00:22.840">on </span><span begin="00:22.840" end="00:23.110">a </span><span begin="00:23.110" end="00:25.000">roll</span><span begin="00:25.000" end="00:25.450">,</span></p><p ttm:agent="v1" begin="00:25.450" end="00:32.440"><span begin="00:25.450" end="00:26.050">I'm </span><span begin="00:26.050" end="00:26.530">on </span><span begin="00:26.530" end="00:26.800">a </span><span begin="00:26.800" end="00:29.500">roll </span><span begin="00:29.500" end="00:30.010">this </span><span begin="00:30.010" end="00:32.440">time</span></p><p ttm:agent="v1" begin="00:34.540" end="00:47.200"><span begin="00:34.540" end="00:35.230">I </span><span begin="00:35.230" end="00:36.400">feel </span><span begin="00:36.400" end="00:37.300">my </span><span begin="00:37.300" end="00:37.870">luck </span><span begin="00:37.870" end="00:38.920">could </span><span begin="00:38.920" end="00:40.660">change</span><span begin="00:40.660" end="00:47.200">.</span></p><p ttm:agent="v1" begin="00:47.200" end="00:50.590"><span begin="00:47.200" end="00:47.740">Kill </span><span begin="00:47.740" end="00:48.040">me </span><span begin="00:48.040" end="00:50.560">Sarah</span><span begin="00:50.560" end="00:50.590">,</span></p><p ttm:agent="v1" begin="00:50.590" end="00:59.860"><span begin="00:50.590" end="00:51.460">kill </span><span begin="00:51.460" end="00:52.030">me </span><span begin="00:52.030" end="00:55.150">again </span><span begin="00:55.150" end="00:55.540">with </span><span begin="00:55.540" end="00:58.990">love</span><span begin="00:58.990" end="00:59.860">,</span></p><p ttm:agent="v1" begin="00:59.860" end="01:10.540"><span begin="00:59.860" end="01:00.100">it's </span><span begin="01:00.100" end="01:00.940">gonna </span><span begin="01:00.940" end="01:02.020">be </span><span begin="01:02.020" end="01:02.710">a </span><span begin="01:02.710" end="01:04.690">glorious </span><span begin="01:04.690" end="01:06.220">day</span><span begin="01:06.220" end="01:10.540">.</span></p><p ttm:agent="v1" begin="01:10.540" end="01:17.800"><span begin="01:10.540" end="01:11.140">Pull </span><span begin="01:11.140" end="01:13.720">me </span><span begin="01:13.720" end="01:15.250">out </span><span begin="01:15.250" end="01:15.400">of </span><span begin="01:15.400" end="01:15.700">the </span><span begin="01:15.700" end="01:17.800">aircrash</span><span begin="01:17.800" end="01:17.800">,</span></p><p ttm:agent="v1" begin="01:17.800" end="01:25.180"><span begin="01:17.800" end="01:18.370">Pull </span><span begin="01:18.370" end="01:21.820">me </span><span begin="01:21.820" end="01:22.450">out </span><span begin="01:22.450" end="01:22.600">of </span><span begin="01:22.600" end="01:22.810">the </span><span begin="01:22.810" end="01:24.370">lake</span><span begin="01:24.370" end="01:25.180">,</span></p><p ttm:agent="v1" begin="01:25.180" end="01:33.190"><span begin="01:25.180" end="01:25.540">I'm </span><span begin="01:25.540" end="01:26.200">your </span><span begin="01:26.200" end="01:27.010">superhero</span><span begin="01:27.010" end="01:33.190">,</span></p><p ttm:agent="v1" begin="01:33.190" end="01:54.640"><span begin="01:33.190" end="01:33.820">we </span><span begin="01:33.820" end="01:33.910">are </span><span begin="01:33.910" end="01:35.170">standing </span><span begin="01:35.170" end="01:35.620">on </span><span begin="01:35.620" end="01:35.980">the </span><span begin="01:35.980" end="01:37.780">edge</span><span begin="01:37.780" end="01:54.640">.</span></p><p ttm:agent="v1" begin="01:54.640" end="02:05.860"><span begin="01:54.640" end="01:55.210">The </span><span begin="01:55.210" end="01:55.780">head </span><span begin="01:55.780" end="01:55.870">of </span><span begin="01:55.870" end="01:58.000">state </span><span begin="01:58.000" end="01:58.780">has </span><span begin="01:58.780" end="01:59.320">called </span><span begin="01:59.320" end="01:59.650">for </span><span begin="01:59.650" end="02:02.410">me </span><span begin="02:02.410" end="02:02.890">by </span><span begin="02:02.890" end="02:05.860">name</span></p><p ttm:agent="v1" begin="02:07.270" end="02:20.230"><span begin="02:07.270" end="02:07.630">but </span><span begin="02:07.630" end="02:08.380">I </span><span begin="02:08.380" end="02:09.400">don't </span><span begin="02:09.400" end="02:10.150">have </span><span begin="02:10.150" end="02:11.110">time </span><span begin="02:11.110" end="02:12.100">for </span><span begin="02:12.100" end="02:14.080">him</span><span begin="02:14.080" end="02:20.230">.</span></p><p ttm:agent="v1" begin="02:20.230" end="02:32.860"><span begin="02:20.230" end="02:20.710">It's </span><span begin="02:20.710" end="02:21.550">gonna </span><span begin="02:21.550" end="02:24.370">be </span><span begin="02:24.370" end="02:24.670">a </span><span begin="02:24.670" end="02:28.420">glorious </span><span begin="02:28.420" end="02:29.830">day</span><span begin="02:29.830" end="02:32.860">!</span></p><p ttm:agent="v1" begin="02:32.860" end="02:43.120"><span begin="02:32.860" end="02:33.610">I </span><span begin="02:33.610" end="02:34.690">feel </span><span begin="02:34.690" end="02:35.590">my </span><span begin="02:35.590" end="02:36.400">luck </span><span begin="02:36.400" end="02:37.210">could </span><span begin="02:37.210" end="02:39.640">change</span><span begin="02:39.640" end="02:43.120">.</span></p><p ttm:agent="v1" begin="02:43.120" end="02:50.350"><span begin="02:43.120" end="02:43.690">Pull </span><span begin="02:43.690" end="02:44.620">me </span><span begin="02:44.620" end="02:47.770">out </span><span begin="02:47.770" end="02:47.920">of </span><span begin="02:47.920" end="02:47.980">the </span><span begin="02:47.980" end="02:50.350">aircrash</span><span begin="02:50.350" end="02:50.350">,</span></p><p ttm:agent="v1" begin="02:50.350" end="02:57.700"><span begin="02:50.350" end="02:50.860">Pull </span><span begin="02:50.860" end="02:51.850">me </span><span begin="02:51.850" end="02:54.970">out </span><span begin="02:54.970" end="02:55.150">of </span><span begin="02:55.150" end="02:55.420">the </span><span begin="02:55.420" end="02:57.160">lake</span><span begin="02:57.160" end="02:57.700">,</span></p><p ttm:agent="v1" begin="02:57.700" end="03:05.770"><span begin="02:57.700" end="02:58.030">I'm </span><span begin="02:58.030" end="02:58.600">your </span><span begin="02:58.600" end="02:59.470">superhero</span><span begin="02:59.470" end="03:05.770">,</span></p><p ttm:agent="v1" begin="03:05.770" end="04:07.810"><span begin="03:05.770" end="03:06.250">we </span><span begin="03:06.250" end="03:06.370">are </span><span begin="03:06.370" end="03:07.690">standing </span><span begin="03:07.690" end="03:08.140">on </span><span begin="03:08.140" end="03:08.350">the </span><span begin="03:08.350" end="03:08.470">edge</span><span begin="03:08.470" end="04:07.810">.</span></p><p ttm:agent="v1" begin="04:07.810" end="04:18.810"><span begin="04:07.810" end="04:08.320">We </span><span begin="04:08.320" end="04:08.380">are </span><span begin="04:08.380" end="04:09.730">standing </span><span begin="04:09.730" end="04:10.150">on </span><span begin="04:10.150" end="04:10.510">the </span><span begin="04:10.510" end="04:13.150">edge</span><span begin="04:13.150" end="04:18.810">.</span></p></div></body></tt>