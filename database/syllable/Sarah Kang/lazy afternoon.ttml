<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>lazy afternoon</ttm:title><ttm:agent type="person" xml:id="v1">Sarah Kang</ttm:agent><ttm:item type="album">lazy afternoon</ttm:item><ttm:item type="spotify_id">5yO75EkEQkxS9f0MizQbdD</ttm:item><itunes:duration>02:55.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:10.880" end="00:13.592"><span begin="00:10.880" end="00:11.064">I </span><span begin="00:11.064" end="00:11.312">could </span><span begin="00:11.312" end="00:12.112">travel </span><span begin="00:12.112" end="00:12.456">to </span><span begin="00:12.456" end="00:13.592">Paris</span></p><p ttm:agent="v1" begin="00:13.800" end="00:15.792"><span begin="00:13.800" end="00:14.056">And </span><span begin="00:14.056" end="00:14.520">see </span><span begin="00:14.520" end="00:14.736">the </span><span begin="00:14.736" end="00:15.280">city </span><span begin="00:15.280" end="00:15.792">lights</span></p><p ttm:agent="v1" begin="00:16.170" end="00:18.930"><span begin="00:16.170" end="00:16.394">Ride </span><span begin="00:16.394" end="00:16.714">a </span><span begin="00:16.714" end="00:17.442">boat </span><span begin="00:17.442" end="00:17.786">in </span><span begin="00:17.786" end="00:18.930">Venice</span></p><p ttm:agent="v1" begin="00:19.130" end="00:21.346"><span begin="00:19.130" end="00:19.330">What </span><span begin="00:19.330" end="00:19.498">a </span><span begin="00:19.498" end="00:20.618">beautiful </span><span begin="00:20.618" end="00:21.346">sight</span></p><p ttm:agent="v1" begin="00:21.706" end="00:24.075"><span begin="00:21.706" end="00:21.907">I </span><span begin="00:21.907" end="00:22.190">could </span><span begin="00:22.190" end="00:23.386">journey </span><span begin="00:23.386" end="00:24.075">afar</span></p><p ttm:agent="v1" begin="00:24.290" end="00:27.074"><span begin="00:24.290" end="00:24.538">To </span><span begin="00:24.538" end="00:24.866">an </span><span begin="00:24.866" end="00:25.547">ocean </span><span begin="00:25.547" end="00:26.050">so </span><span begin="00:26.050" end="00:27.074">blue</span></p><p ttm:agent="v1" begin="00:27.410" end="00:31.610"><span begin="00:27.410" end="00:27.658">But </span><span begin="00:27.658" end="00:28.234">nothing </span><span begin="00:28.234" end="00:28.442">is </span><span begin="00:28.442" end="00:28.962">as </span><span begin="00:28.962" end="00:30.370">beautiful </span><span begin="00:30.370" end="00:30.530">as </span><span begin="00:30.530" end="00:31.610">you</span></p><p ttm:agent="v1" begin="00:32.666" end="00:35.074"><span begin="00:32.666" end="00:32.978">I </span><span begin="00:32.978" end="00:33.186">could </span><span begin="00:33.186" end="00:33.834">climb </span><span begin="00:33.834" end="00:34.066">up </span><span begin="00:34.066" end="00:34.498">a </span><span begin="00:34.498" end="00:35.074">hill</span></p><p ttm:agent="v1" begin="00:35.410" end="00:37.826"><span begin="00:35.410" end="00:35.826">And </span><span begin="00:35.826" end="00:36.258">watch </span><span begin="00:36.258" end="00:36.570">the </span><span begin="00:36.570" end="00:37.826">sunrise</span></p><p ttm:agent="v1" begin="00:38.506" end="00:40.499"><span begin="00:38.506" end="00:39.890">Wander </span><span begin="00:39.890" end="00:40.499">until</span></p><p ttm:agent="v1" begin="00:40.699" end="00:43.354"><span begin="00:40.699" end="00:40.866">The </span><span begin="00:40.866" end="00:41.258">stars </span><span begin="00:41.258" end="00:41.722">fill </span><span begin="00:41.722" end="00:42.226">up </span><span begin="00:42.226" end="00:42.427">the </span><span begin="00:42.427" end="00:43.354">skies</span></p><p ttm:agent="v1" begin="00:43.778" end="00:46.275"><span begin="00:43.778" end="00:43.994">But </span><span begin="00:43.994" end="00:44.466">none </span><span begin="00:44.466" end="00:44.786">of </span><span begin="00:44.786" end="00:45.186">that </span><span begin="00:45.186" end="00:46.275">matters</span></p><p ttm:agent="v1" begin="00:46.543" end="00:48.767"><span begin="00:46.543" end="00:46.751">If </span><span begin="00:46.751" end="00:47.262">you </span><span begin="00:47.262" end="00:47.646">aren't </span><span begin="00:47.646" end="00:48.094">there, </span><span begin="00:48.094" end="00:48.767">too</span></p><p ttm:agent="v1" begin="00:49.222" end="00:53.126"><span begin="00:49.222" end="00:49.495">I </span><span begin="00:49.495" end="00:49.966">want </span><span begin="00:49.966" end="00:50.294">to </span><span begin="00:50.294" end="00:50.622">be </span><span begin="00:50.622" end="00:51.686">next </span><span begin="00:51.686" end="00:52.158">to </span><span begin="00:52.158" end="00:53.126">you</span></p><p ttm:agent="v1" begin="00:54.990" end="00:57.078"><span begin="00:54.990" end="00:55.174">If </span><span begin="00:55.174" end="00:55.950">you </span><span begin="00:55.950" end="00:56.184">would </span><span begin="00:56.184" end="00:57.078">like</span></p><p ttm:agent="v1" begin="00:57.598" end="00:59.935"><span begin="00:57.598" end="00:58.054">To </span><span begin="00:58.054" end="00:58.494">spend </span><span begin="00:58.494" end="00:59.023">some </span><span begin="00:59.023" end="00:59.935">time</span></p><p ttm:agent="v1" begin="01:00.357" end="01:04.485"><span begin="01:00.357" end="01:00.801">I'd </span><span begin="01:00.801" end="01:01.429">like </span><span begin="01:01.429" end="01:01.733">to </span><span begin="01:01.733" end="01:02.181">spend </span><span begin="01:02.181" end="01:02.653">it </span><span begin="01:02.653" end="01:03.005">with </span><span begin="01:03.005" end="01:04.485">you</span></p><p ttm:agent="v1" begin="01:05.573" end="01:08.013"><span begin="01:05.573" end="01:05.797">A </span><span begin="01:05.797" end="01:06.269">glass </span><span begin="01:06.269" end="01:06.629">of </span><span begin="01:06.629" end="01:07.077">red </span><span begin="01:07.077" end="01:08.013">wine</span></p><p ttm:agent="v1" begin="01:08.501" end="01:10.461"><span begin="01:08.501" end="01:08.885">Just </span><span begin="01:08.885" end="01:09.413">you </span><span begin="01:09.413" end="01:09.709">and </span><span begin="01:09.709" end="01:10.461">I</span></p><p ttm:agent="v1" begin="01:10.853" end="01:14.917"><span begin="01:10.853" end="01:11.070">On </span><span begin="01:11.070" end="01:11.286">a </span><span begin="01:11.286" end="01:12.548">lazy </span><span begin="01:12.548" end="01:14.917">afternoon</span></p><p ttm:agent="v1" begin="01:16.581" end="01:18.989"><span begin="01:16.581" end="01:16.789">They </span><span begin="01:16.789" end="01:17.277">say </span><span begin="01:17.277" end="01:17.533">that </span><span begin="01:17.533" end="01:18.989">someday</span></p><p ttm:agent="v1" begin="01:19.221" end="01:21.533"><span begin="01:19.221" end="01:19.509">The </span><span begin="01:19.509" end="01:20.485">romance </span><span begin="01:20.485" end="01:20.877">will </span><span begin="01:20.877" end="01:21.533">fade</span></p><p ttm:agent="v1" begin="01:21.957" end="01:24.021"><span begin="01:21.957" end="01:22.149">And </span><span begin="01:22.149" end="01:22.989">tomorrow </span><span begin="01:22.989" end="01:23.470">will </span><span begin="01:23.470" end="01:24.021">be</span></p><p ttm:agent="v1" begin="01:24.245" end="01:27.013"><span begin="01:24.245" end="01:24.509">Just </span><span begin="01:24.509" end="01:25.821">another </span><span begin="01:25.821" end="01:27.013">day</span></p><p ttm:agent="v1" begin="01:27.389" end="01:30.069"><span begin="01:27.389" end="01:27.653">But </span><span begin="01:27.653" end="01:28.117">even </span><span begin="01:28.117" end="01:28.389">if </span><span begin="01:28.389" end="01:28.821">we </span><span begin="01:28.821" end="01:29.861">don't </span><span begin="01:29.861" end="01:30.069">do</span></p><p ttm:agent="v1" begin="01:30.421" end="01:32.293"><span begin="01:30.421" end="01:31.357">Anything </span><span begin="01:31.357" end="01:31.685">at </span><span begin="01:31.685" end="01:32.293">all</span></p><p ttm:agent="v1" begin="01:32.605" end="01:36.749"><span begin="01:32.605" end="01:32.997">I </span><span begin="01:32.997" end="01:33.828">wanna </span><span begin="01:33.828" end="01:34.349">be </span><span begin="01:34.349" end="01:35.453">where </span><span begin="01:35.453" end="01:35.789">you </span><span begin="01:35.789" end="01:36.749">are</span></p><p ttm:agent="v1" begin="01:38.573" end="01:40.645"><span begin="01:38.573" end="01:38.861">If </span><span begin="01:38.861" end="01:39.510">you </span><span begin="01:39.510" end="01:39.845">would </span><span begin="01:39.845" end="01:40.645">like</span></p><p ttm:agent="v1" begin="01:41.173" end="01:43.549"><span begin="01:41.173" end="01:41.589">To </span><span begin="01:41.589" end="01:42.117">spend </span><span begin="01:42.117" end="01:42.669">some </span><span begin="01:42.669" end="01:43.549">time</span></p><p ttm:agent="v1" begin="01:44.029" end="01:48.357"><span begin="01:44.029" end="01:44.437">I'd </span><span begin="01:44.437" end="01:44.877">like </span><span begin="01:44.877" end="01:45.341">to </span><span begin="01:45.341" end="01:45.765">spend </span><span begin="01:45.765" end="01:46.301">it </span><span begin="01:46.301" end="01:46.573">with </span><span begin="01:46.573" end="01:48.357">you</span></p><p ttm:agent="v1" begin="01:49.237" end="01:51.557"><span begin="01:49.237" end="01:49.429">A </span><span begin="01:49.429" end="01:49.837">glass </span><span begin="01:49.837" end="01:50.205">of </span><span begin="01:50.205" end="01:50.693">red </span><span begin="01:50.693" end="01:51.557">wine</span></p><p ttm:agent="v1" begin="01:51.925" end="01:54.078"><span begin="01:51.925" end="01:52.477">Just </span><span begin="01:52.477" end="01:53.013">you </span><span begin="01:53.013" end="01:53.333">and </span><span begin="01:53.333" end="01:54.078">I</span></p><p ttm:agent="v1" begin="01:54.421" end="01:58.917"><span begin="01:54.421" end="01:54.693">On </span><span begin="01:54.693" end="01:54.885">a </span><span begin="01:54.885" end="01:56.253">lazy </span><span begin="01:56.253" end="01:58.917">afternoon</span></p><p ttm:agent="v1" begin="02:19.549" end="02:21.637"><span begin="02:19.549" end="02:19.773">If </span><span begin="02:19.773" end="02:20.421">you </span><span begin="02:20.421" end="02:20.685">would </span><span begin="02:20.685" end="02:21.637">like</span></p><p ttm:agent="v1" begin="02:22.261" end="02:24.589"><span begin="02:22.261" end="02:22.621">To </span><span begin="02:22.621" end="02:23.317">spend </span><span begin="02:23.317" end="02:23.597">some </span><span begin="02:23.597" end="02:24.589">time</span></p><p ttm:agent="v1" begin="02:24.834" end="02:29.618"><span begin="02:24.834" end="02:25.322">I'd </span><span begin="02:25.322" end="02:26.058">like </span><span begin="02:26.058" end="02:26.274">to </span><span begin="02:26.274" end="02:26.754">spend </span><span begin="02:26.754" end="02:27.345">it </span><span begin="02:27.345" end="02:27.538">with </span><span begin="02:27.538" end="02:29.618">you</span></p><p ttm:agent="v1" begin="02:30.114" end="02:32.514"><span begin="02:30.114" end="02:30.378">A </span><span begin="02:30.378" end="02:30.739">glass </span><span begin="02:30.739" end="02:31.146">of </span><span begin="02:31.146" end="02:31.682">red </span><span begin="02:31.682" end="02:32.514">wine</span></p><p ttm:agent="v1" begin="02:32.986" end="02:35.211"><span begin="02:32.986" end="02:33.506">Just </span><span begin="02:33.506" end="02:34.002">you </span><span begin="02:34.002" end="02:34.290">and </span><span begin="02:34.290" end="02:35.211">I</span></p><p ttm:agent="v1" begin="02:35.458" end="02:40.546"><span begin="02:35.458" end="02:35.674">On </span><span begin="02:35.674" end="02:35.866">a </span><span begin="02:35.866" end="02:37.162">lazy </span><span begin="02:37.162" end="02:40.546">afternoon</span></p><p ttm:agent="v1" begin="02:40.898" end="02:48.946"><span begin="02:40.898" end="02:41.114">On </span><span begin="02:41.114" end="02:41.322">a </span><span begin="02:41.322" end="02:43.082">lazy </span><span begin="02:43.082" end="02:48.946">afternoon</span></p></div></body></tt>