<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>bittersweet</ttm:title><ttm:agent type="group" xml:id="v1">Sarah Kang, Luke Chiang</ttm:agent><ttm:item type="album">bittersweet</ttm:item><ttm:item type="spotify_id">0wEqNUKF9MH4pk5va6HNCt</ttm:item><itunes:duration>02:47.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:18.502" end="00:20.310"><span begin="00:18.502" end="00:18.805">Your </span><span begin="00:18.805" end="00:19.237">smile </span><span begin="00:19.237" end="00:19.507">makes </span><span begin="00:19.507" end="00:19.654">me </span><span begin="00:19.654" end="00:19.913">wanna </span><span begin="00:19.913" end="00:20.310">cry</span></p><p ttm:agent="v1" begin="00:22.906" end="00:24.752"><span begin="00:22.906" end="00:23.239">Feels </span><span begin="00:23.239" end="00:23.518">like </span><span begin="00:23.518" end="00:23.656">we're </span><span begin="00:23.656" end="00:23.974">running </span><span begin="00:23.974" end="00:24.209">out </span><span begin="00:24.209" end="00:24.343">of </span><span begin="00:24.343" end="00:24.752">time</span></p><p ttm:agent="v1" begin="00:27.271" end="00:29.996"><span begin="00:27.271" end="00:27.430">The </span><span begin="00:27.430" end="00:27.726">more </span><span begin="00:27.726" end="00:27.975">and </span><span begin="00:27.975" end="00:28.311">more </span><span begin="00:28.311" end="00:28.489">of </span><span begin="00:28.489" end="00:28.799">you </span><span begin="00:28.799" end="00:29.127">that </span><span begin="00:29.127" end="00:29.542">I </span><span begin="00:29.542" end="00:29.996">like</span></p><p ttm:agent="v1" begin="00:31.044" end="00:33.571"><span begin="00:31.044" end="00:31.382">Makes </span><span begin="00:31.382" end="00:31.791">it </span><span begin="00:31.791" end="00:32.611">harder </span><span begin="00:32.611" end="00:32.819">to </span><span begin="00:32.819" end="00:33.139">say </span><span begin="00:33.139" end="00:33.571">goodbye</span></p><p ttm:agent="v1" begin="00:35.219" end="00:39.414"><span begin="00:35.219" end="00:35.460">You're </span><span begin="00:35.460" end="00:35.771">like </span><span begin="00:35.771" end="00:36.194">the </span><span begin="00:36.194" end="00:37.315">perfect </span><span begin="00:37.315" end="00:37.878">cup </span><span begin="00:37.878" end="00:38.429">of </span><span begin="00:38.429" end="00:39.414">coffee</span></p><p ttm:agent="v1" begin="00:39.924" end="00:43.883"><span begin="00:39.924" end="00:40.240">Or </span><span begin="00:40.240" end="00:40.666">a </span><span begin="00:40.666" end="00:42.333">symphony </span><span begin="00:42.333" end="00:43.883">finale</span></p><p ttm:agent="v1" begin="00:44.411" end="00:48.375"><span begin="00:44.411" end="00:44.643">Just </span><span begin="00:44.643" end="00:45.019">like </span><span begin="00:45.019" end="00:46.221">moving </span><span begin="00:46.221" end="00:46.477">to </span><span begin="00:46.477" end="00:46.741">a </span><span begin="00:46.741" end="00:47.349">new </span><span begin="00:47.349" end="00:48.375">city</span></p><p ttm:agent="v1" begin="00:48.796" end="00:52.876"><span begin="00:48.796" end="00:49.140">Or </span><span begin="00:49.140" end="00:49.533">the </span><span begin="00:49.533" end="00:50.709">ending </span><span begin="00:50.709" end="00:51.197">of </span><span begin="00:51.197" end="00:51.788">a </span><span begin="00:51.788" end="00:52.876">movie</span></p><p ttm:agent="v1" begin="00:54.075" end="00:56.297"><span begin="00:54.075" end="00:54.350">Loving </span><span begin="00:54.350" end="00:54.651">you </span><span begin="00:54.651" end="00:55.067">is </span><span begin="00:55.067" end="00:56.297">bittersweet</span></p><p ttm:agent="v1" begin="00:56.297" end="00:57.266"><span begin="00:56.297" end="00:57.266">Bittersweet</span></p><p ttm:agent="v1" begin="00:58.465" end="01:00.662"><span begin="00:58.465" end="00:58.793">Even </span><span begin="00:58.793" end="00:59.142">when </span><span begin="00:59.142" end="00:59.510">you're </span><span begin="00:59.510" end="00:59.745">next </span><span begin="00:59.745" end="01:00.041">to </span><span begin="01:00.041" end="01:00.662">me</span></p><p ttm:agent="v1" begin="01:00.662" end="01:01.807"><span begin="01:00.662" end="01:00.918">Next </span><span begin="01:00.918" end="01:01.192">to </span><span begin="01:01.192" end="01:01.807">me</span></p><p ttm:agent="v1" begin="01:02.815" end="01:05.321"><span begin="01:02.815" end="01:03.182">Loving </span><span begin="01:03.182" end="01:03.930">you </span><span begin="01:03.930" end="01:04.315">makes </span><span begin="01:04.315" end="01:04.674">me </span><span begin="01:04.674" end="01:05.321">weak</span></p><p ttm:agent="v1" begin="01:05.857" end="01:08.470"><span begin="01:05.857" end="01:06.177">But </span><span begin="01:06.177" end="01:06.955">stay </span><span begin="01:06.955" end="01:07.346">with </span><span begin="01:07.346" end="01:08.470">me</span></p><p ttm:agent="v1" begin="01:11.842" end="01:15.113"><span begin="01:11.842" end="01:12.105">I'd </span><span begin="01:12.105" end="01:12.786">better </span><span begin="01:12.786" end="01:13.169">lock </span><span begin="01:13.169" end="01:13.521">up </span><span begin="01:13.521" end="01:13.900">my </span><span begin="01:13.900" end="01:15.113">heart</span></p><p ttm:agent="v1" begin="01:16.281" end="01:20.318"><span begin="01:16.281" end="01:16.553">There's </span><span begin="01:16.553" end="01:16.893">not </span><span begin="01:16.893" end="01:17.224">an </span><span begin="01:17.224" end="01:17.993">ending </span><span begin="01:17.993" end="01:18.368">if </span><span begin="01:18.368" end="01:18.704">it </span><span begin="01:18.704" end="01:19.434">never </span><span begin="01:19.434" end="01:20.318">starts</span></p><p ttm:agent="v1" begin="01:20.609" end="01:23.783"><span begin="01:20.609" end="01:20.754">But </span><span begin="01:20.754" end="01:21.008">I'm </span><span begin="01:21.008" end="01:21.360">thinking </span><span begin="01:21.360" end="01:21.683">that </span><span begin="01:21.683" end="01:22.037">you </span><span begin="01:22.037" end="01:22.638">might </span><span begin="01:22.638" end="01:22.864">be </span><span begin="01:22.864" end="01:23.194">worth </span><span begin="01:23.194" end="01:23.783">it</span></p><p ttm:agent="v1" begin="01:25.015" end="01:28.459"><span begin="01:25.015" end="01:25.199">If </span><span begin="01:25.199" end="01:25.472">you're </span><span begin="01:25.472" end="01:25.846">mine </span><span begin="01:25.846" end="01:26.207">maybe </span><span begin="01:26.207" end="01:26.622">I'll </span><span begin="01:26.622" end="01:27.161">risk </span><span begin="01:27.161" end="01:27.389">the </span><span begin="01:27.389" end="01:28.459">hurting</span></p><p ttm:agent="v1" begin="01:28.459" end="01:32.556"><span begin="01:28.459" end="01:28.797">You're </span><span begin="01:28.797" end="01:29.115">like </span><span begin="01:29.115" end="01:29.514">the </span><span begin="01:29.514" end="01:30.622">perfect </span><span begin="01:30.622" end="01:31.244">cup </span><span begin="01:31.244" end="01:31.733">of </span><span begin="01:31.733" end="01:32.556">coffee</span></p><p ttm:agent="v1" begin="01:33.412" end="01:37.204"><span begin="01:33.412" end="01:33.613">Or </span><span begin="01:33.613" end="01:33.99