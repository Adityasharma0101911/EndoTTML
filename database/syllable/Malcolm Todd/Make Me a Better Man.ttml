<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Make Me a Better Man</ttm:title><ttm:agent type="person" xml:id="v1">Malcolm Todd</ttm:agent><ttm:item type="album">Malcolm Todd</ttm:item><ttm:item type="spotify_id">7uwALmo7FmErDKhNj3Yw7X</ttm:item><itunes:duration>03:30.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:16.986" end="00:19.464"><span begin="00:16.986" end="00:17.217">There's </span><span begin="00:17.217" end="00:17.460">something </span><span begin="00:17.460" end="00:17.814">'bout </span><span begin="00:17.814" end="00:18.057">the </span><span begin="00:18.057" end="00:18.343">way </span><span begin="00:18.343" end="00:18.530">you're </span><span begin="00:18.530" end="00:19.025">looking </span><span begin="00:19.025" end="00:19.464">around</span></p><p ttm:agent="v1" begin="00:19.654" end="00:20.321"><span begin="00:19.654" end="00:19.883">You're </span><span begin="00:19.883" end="00:20.120">looking </span><span begin="00:20.120" end="00:20.321">bored</span></p><p ttm:agent="v1" begin="00:20.495" end="00:23.061"><span begin="00:20.495" end="00:20.660">You're </span><span begin="00:20.660" end="00:20.833">looking </span><span begin="00:20.833" end="00:21.031">at </span><span begin="00:21.031" end="00:21.204">me </span><span begin="00:21.204" end="00:21.457">like </span><span begin="00:21.457" end="00:21.661">you </span><span begin="00:21.661" end="00:21.858">look </span><span begin="00:21.858" end="00:22.064">at </span><span begin="00:22.064" end="00:22.527">the </span><span begin="00:22.527" end="00:23.061">ground</span></p><p ttm:agent="v1" begin="00:23.818" end="00:26.909"><span begin="00:23.818" end="00:24.101">But </span><span begin="00:24.101" end="00:24.322">I'm </span><span begin="00:24.322" end="00:25.349">thinking </span><span begin="00:25.349" end="00:25.570">I </span><span begin="00:25.570" end="00:25.948">should </span><span begin="00:25.948" end="00:26.909">question</span></p><p ttm:agent="v1" begin="00:27.161" end="00:30.162"><span begin="00:27.161" end="00:27.351">Are </span><span begin="00:27.351" end="00:27.767">we </span><span begin="00:27.767" end="00:28.271">living </span><span begin="00:28.271" end="00:28.460">with </span><span begin="00:28.460" end="00:28.634">the </span><span begin="00:28.634" end="00:29.163">same </span><span begin="00:29.163" end="00:30.162">intentions?</span></p><p ttm:agent="v1" begin="00:31.593" end="00:34.586"><span begin="00:31.593" end="00:31.766">The </span><span begin="00:31.766" end="00:31.972">way </span><span begin="00:31.972" end="00:32.162">you </span><span begin="00:32.162" end="00:32.484">talk </span><span begin="00:32.484" end="00:32.697">to </span><span begin="00:32.697" end="00:33.310">her </span><span begin="00:33.310" end="00:33.584">I </span><span begin="00:33.584" end="00:34.586">swear</span></p><p ttm:agent="v1" begin="00:34.981" end="00:38.500"><span begin="00:34.981" end="00:35.170">It's </span><span begin="00:35.170" end="00:35.351">like </span><span begin="00:35.351" end="00:35.595">you </span><span begin="00:35.595" end="00:35.870">wish </span><span begin="00:35.870" end="00:36.161">I </span><span begin="00:36.161" end="00:37.197">wasn't </span><span begin="00:37.197" end="00:38.500">there</span></p><p ttm:agent="v1" begin="00:39.266" end="00:45.274"><span begin="00:39.266" end="00:39.470">Well </span><span begin="00:39.470" end="00:39.667">is </span><span begin="00:39.667" end="00:39.912">there </span><span begin="00:39.912" end="00:40.306">something </span><span begin="00:40.306" end="00:40.524">that </span><span begin="00:40.524" end="00:40.703">you'd </span><span begin="00:40.703" end="00:41.164">like </span><span begin="00:41.164" end="00:41.362">to </span><span begin="00:41.362" end="00:45.274">share?</span></p><p ttm:agent="v1" begin="00:45.984" end="00:49.258"><span begin="00:45.984" end="00:46.298">I </span><span begin="00:46.298" end="00:46.629">need </span><span begin="00:46.629" end="00:47.141">to </span><span begin="00:47.141" end="00:49.258">know</span></p><p ttm:agent="v1" begin="00:49.850" end="00:52.489"><span begin="00:49.850" end="00:50.039">Why </span><span begin="00:50.039" end="00:50.512">don't </span><span begin="00:50.512" end="00:50.929">you </span><span begin="00:50.929" end="00:51.339">kiss </span><span begin="00:51.339" end="00:52.489">me?</span></p><p ttm:agent="v1" begin="00:53.267" end="00:55.780"><span begin="00:53.267" end="00:53.504">Why </span><span begin="00:53.504" end="00:53.937">won't </span><span begin="00:53.937" end="00:54.389">you </span><span begin="00:54.389" end="00:55.780">care?</span></p><p ttm:agent="v1" begin="00:56.237" end="00:59.026"><span begin="00:56.237" end="00:56.575">Take </span><span begin="00:56.575" end="00:57.040">me </span><span begin="00:57.040" end="00:59.026">away</span></p><p ttm:agent="v1" begin="00:59.671" end="01:02.879"><span begin="00:59.671" end="00:59.913">I'm </span><span begin="00:59.913" end="01:00.749">heading </span><span begin="01:00.749" end="01:02.879">home</span></p><p ttm:agent="v1" begin="01:03.604" end="01:05.876"><span begin="01:03.604" end="01:03.790">But </span><span begin="01:03.790" end="01:04.222">you </span><span begin="01:04.222" end="01:04.647">won't </span><span begin="01:04.647" end="01:05.071">miss </span><span begin="01:05.071" end="01:05.876">me</span></p><p ttm:agent="v1" begin="01:07.043" end="01:09.364"><span begin="01:07.043" end="01:07.224">You </span><span begin="01:07.224" end="01:08.056">wouldn't </span><span begin="01:08.056" end="01:09.364">dare</span></p><p ttm:agent="v1" begin="01:12.814" end="01:16.312"><span begin="01:12.814" end="01:13.053">Why </span><span begin="01:13.053" end="01:13.239">does </span><span begin="01:13.239" end="01:13.419">it </span><span begin="01:13.419" end="01:13.625">take </span><span begin="01:13.625" end="01:14.153">so </span><span begin="01:14.153" end="01:14.674">long </span><span begin="01:14.674" end="01:14.870">for </span><span begin="01:14.870" end="01:15.271">you </span><span begin="01:15.271" end="01:15.476">to </span><span begin="01:15.476" end="01:15.664">hear </span><span begin="01:15.664" end="01:15.870">the </span><span begin="01:15.870" end="01:16.312">message</span></p><p ttm:agent="v1" begin="01:16.392" end="01:18.100"><span begin="01:16.392" end="01:16.566">In </span><span begin="01:16.566" end="01:16.755">my </span><span begin="01:16.755" end="01:17.076">new </span><span begin="01:17.076" end="01:17.565">sad </span><span begin="01:17.565" end="01:18.100">song?</span></p><p ttm:agent="v1" begin="01:18.173" end="01:21.594"><span begin="01:18.173" end="01:18.344">It's </span><span begin="01:18.344" end="01:18.908">you </span><span begin="01:19.577" end="01:19.790">and </span><span begin="01:19.790" end="01:19.989">how </span><span begin="01:19.989" end="01:20.208">we </span><span begin="01:20.208" end="01:20.421">got </span><span begin="01:20.421" end="01:20.633">the </span><span begin="01:20.633" end="01:20.972">same </span><span begin="01:20.972" end="01:21.594">taste</span></p><p ttm:agent="v1" begin="01:21.745" end="01:25.277"><span begin="01:21.745" end="01:21.948">I'm </span><span begin="01:21.948" end="01:22.153">looking </span><span begin="01:22.153" end="01:22.373">in </span><span begin="01:22.373" end="01:22.586">her </span><span begin="01:22.586" end="01:23.146">eyes </span><span begin="01:23.146" end="01:23.368">while </span><span begin="01:23.368" end="01:23.566">you're </span><span begin="01:23.566" end="01:23.879">looking </span><span begin="01:23.879" end="01:24.130">at </span><span begin="01:24.130" end="01:24.625">her </span><span begin="01:24.625" end="01:25.277">waist</span></p><p ttm:agent="v1" begin="01:25.670" end="01:28.552"><span begin="01:25.670" end="01:26.151">There's </span><span begin="01:26.151" end="01:27.056">something </span><span begin="01:27.056" end="01:27.565">wrong </span><span begin="01:27.565" end="01:28.064">about </span><span begin="01:28.064" end="01:28.552">it</span></p><p ttm:agent="v1" begin="01:28.654" end="01:32.804"><span begin="01:28.654" end="01:29.120">All </span><span begin="01:29.120" end="01:29.339">the </span><span begin="01:29.339" end="01:29.811">things </span><span begin="01:29.811" end="01:30.373">I </span><span begin="01:30.373" end="01:30.909">do </span><span begin="01:30.909" end="01:31.304">to </span><span begin="01:31.304" end="01:31.529">be </span><span begin="01:31.529" end="01:31.695">the </span><span begin="01:31.695" end="01:32.804">man</span></p><p ttm:agent="v1" begin="01:34.137" end="01:39.270"><span begin="01:34.137" end="01:34.356">You'll </span><span begin="01:34.356" end="01:34.660">never </span><span begin="01:34.660" end="01:39.270">understand</span></p><p ttm:agent="v1" begin="01:40.845" end="01:43.887"><span begin="01:40.845" end="01:41.090">I </span><span begin="01:41.090" end="01:41.463">need </span><span begin="01:41.463" end="01:41.901">to </span><span begin="01:41.901" end="01:43.887">know</span></p><p ttm:agent="v1" begin="01:44.697" end="01:47.283"><span begin="01:44.697" end="01:44.950">Why </span><span begin="01:44.950" end="01:45.334">don't </span><span begin="01:45.334" end="01:45.713">you </span><span begin="01:45.713" end="01:46.177">kiss </span><span begin="01:46.177" end="01:47.283">me?</span></p><p ttm:agent="v1" begin="01:48.099" end="01:50.433"><span begin="01:48.099" end="01:48.359">Why </span><span begin="01:48.359" end="01:48.785">won't </span><span begin="01:48.785" end="01:49.225">you </span><span begin="01:49.225" end="01:50.433">care?</span></p><p ttm:agent="v1" begin="01:51.052" end="01:53.747"><span begin="01:51.052" end="01:51.399">Take </span><span begin="01:51.399" end="01:51.887">me </span><span begin="01:51.887" end="01:53.747">away</span></p><p ttm:agent="v1" begin="01:54.478" end="01:57.392"><span begin="01:54.478" end="01:54.801">I'm </span><span begin="01:54.801" end="01:55.588">heading </span><span begin="01:55.588" end="01:57.392">home</span></p><p ttm:agent="v1" begin="01:58.447" end="02:00.722"><span begin="01:58.447" end="01:58.668">But </span><span begin="01:58.668" end="01:59.039">you </span><span begin="01:59.039" end="01:59.471">won't </span><span begin="01:59.471" end="01:59.889">miss </span><span begin="01:59.889" end="02:00.722">me</span></p><p ttm:agent="v1" begin="02:01.837" end="02:04.306"><span begin="02:01.837" end="02:02.085">You </span><span begin="02:02.085" end="02:02.867">wouldn't </span><span begin="02:02.867" end="02:04.306">dare</span></p><p ttm:agent="v1" begin="02:20.362" end="02:25.876"><span begin="02:20.362" end="02:20.660">I </span><span begin="02:20.660" end="02:21.023">ain't </span><span begin="02:21.023" end="02:21.559">never </span><span begin="02:21.559" end="02:22.354">cried </span><span begin="02:22.354" end="02:22.575">but </span><span begin="02:22.575" end="02:22.764">I'm </span><span begin="02:22.764" end="02:23.340">getting </span><span begin="02:23.340" end="02:24.324">closer </span><span begin="02:24.324" end="02:24.560">then </span><span begin="02:24.560" end="02:25.079">I'd </span><span begin="02:25.079" end="02:25.876">like</span></p><p ttm:agent="v1" begin="02:26.047" end="02:31.538"><span begin="02:26.047" end="02:26.253">You </span><span begin="02:26.253" end="02:26.474">had </span><span begin="02:26.474" end="02:26.781">my </span><span begin="02:26.781" end="02:27.437">heart </span><span begin="02:27.437" end="02:27.655">in </span><span begin="02:27.655" end="02:27.948">your </span><span begin="02:27.948" end="02:28.418">two </span><span begin="02:28.418" end="02:29.230">hands </span><span begin="02:29.277" end="02:29.466">and </span><span begin="02:29.466" end="02:29.656">you </span><span begin="02:29.656" end="02:29.893">let </span><span begin="02:29.893" end="02:30.074">it </span><span begin="02:30.074" end="02:31.538">go</span></p><p ttm:agent="v1" begin="02:32.112" end="02:36.209"><span begin="02:32.112" end="02:32.705">Now </span><span begin="02:32.705" end="02:32.949">I'm </span><span begin="02:32.949" end="02:33.358">in </span><span begin="02:33.358" end="02:33.618">a </span><span begin="02:33.618" end="02:34.256">place </span><span begin="02:34.256" end="02:34.555">that </span><span begin="02:34.555" end="02:34.777">I've </span><span begin="02:34.777" end="02:35.185">never </span><span begin="02:35.185" end="02:36.209">seen</span></p><p ttm:agent="v1" begin="02:36.390" end="02:39.674"><span begin="02:36.390" end="02:36.697">With </span><span begin="02:36.697" end="02:37.753">someone </span><span begin="02:37.753" end="02:37.973">I </span><span begin="02:37.973" end="02:38.209">have </span><span begin="02:38.209" end="02:38.516">never </span><span begin="02:38.516" end="02:39.674">been</span></p><p ttm:agent="v1" begin="02:39.832" end="02:42.952"><span begin="02:39.832" end="02:40.076">It </span><span begin="02:40.076" end="02:40.493">might </span><span begin="02:40.493" end="02:41.092">make </span><span begin="02:41.092" end="02:41.343">me </span><span begin="02:41.343" end="02:41.549">a </span><span begin="02:41.549" end="02:41.983">better </span><span begin="02:41.983" end="02:42.952">man</span></p><p ttm:agent="v1" begin="02:43.000" end="02:45.328"><span begin="02:43.000" end="02:43.202">But </span><span begin="02:43.202" end="02:43.376">you'll </span><span begin="02:43.376" end="02:43.746">never </span><span begin="02:43.746" end="02:45.328">know</span></p><p ttm:agent="v1" begin="03:01.514" end="03:06.971"><span begin="03:01.514" end="03:01.735">I </span><span begin="03:01.735" end="03:02.112">ain't </span><span begin="03:02.112" end="03:02.770">never </span><span begin="03:02.770" end="03:03.515">cried </span><span begin="03:03.610" end="03:03.767">but </span><span begin="03:03.767" end="03:03.917">I'm </span><span begin="03:03.917" end="03:04.489">getting </span><span begin="03:04.489" end="03:05.071">closer </span><span begin="03:05.071" end="03:05.442">then </span><span begin="03:05.442" end="03:06.143">I'd </span><span begin="03:06.143" end="03:06.971">like</span></p><p ttm:agent="v1" begin="03:07.213" end="03:12.825"><span begin="03:07.213" end="03:07.412">You </span><span begin="03:07.412" end="03:07.718">had </span><span begin="03:07.718" end="03:07.955">my </span><span begin="03:07.955" end="03:08.632">heart </span><span begin="03:08.632" end="03:08.862">in </span><span begin="03:08.862" end="03:09.152">your </span><span begin="03:09.152" end="03:09.665">two </span><span begin="03:09.665" end="03:10.436">hands </span><span begin="03:10.475" end="03:10.649">and </span><span begin="03:10.649" end="03:10.823">you </span><span begin="03:10.823" end="03:11.153">let </span><span begin="03:11.153" end="03:11.381">it </span><span begin="03:11.381" end="03:12.825">go</span></p></div></body></tt>