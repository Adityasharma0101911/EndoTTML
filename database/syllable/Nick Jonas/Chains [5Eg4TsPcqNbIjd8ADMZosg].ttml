<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Chains</ttm:title><ttm:agent type="person" xml:id="v1">Nick Jonas</ttm:agent><ttm:item type="album">Nick Jonas X2</ttm:item><ttm:item type="spotify_id">5Eg4TsPcqNbIjd8ADMZosg</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:12.730" end="00:17.320"><span begin="00:12.730" end="00:13.030">With </span><span begin="00:13.030" end="00:13.150">her </span><span begin="00:13.150" end="00:13.480">wine</span><span begin="00:13.480" end="00:13.510">-</span><span begin="00:13.510" end="00:13.930">stained </span><span begin="00:13.930" end="00:14.350">lips</span><span begin="00:14.350" end="00:14.350">, </span><span begin="00:14.350" end="00:14.530">yeah </span><span begin="00:14.530" end="00:14.650">she</span><span begin="00:14.650" end="00:14.680">’</span><span begin="00:14.680" end="00:14.740">s </span><span begin="00:14.740" end="00:15.340">nothing </span><span begin="00:15.340" end="00:15.490">but </span><span begin="00:15.490" end="00:17.320">trouble</span></p><p ttm:agent="v1" begin="00:19.360" end="00:23.470"><span begin="00:19.360" end="00:19.900">Cold </span><span begin="00:19.900" end="00:20.080">to </span><span begin="00:20.080" end="00:20.230">the </span><span begin="00:20.230" end="00:20.650">touch </span><span begin="00:20.650" end="00:20.890">but </span><span begin="00:20.890" end="00:20.980">she</span><span begin="00:20.980" end="00:21.010">’</span><span begin="00:21.010" end="00:21.100">s </span><span begin="00:21.100" end="00:21.550">warm </span><span begin="00:21.550" end="00:21.730">as </span><span begin="00:21.730" end="00:21.790">a </span><span begin="00:21.790" end="00:23.470">devil</span></p><p ttm:agent="v1" begin="00:25.540" end="00:29.770"><span begin="00:25.540" end="00:25.660">I </span><span begin="00:25.660" end="00:26.260">gave </span><span begin="00:26.260" end="00:26.380">all </span><span begin="00:26.380" end="00:26.590">my </span><span begin="00:26.590" end="00:26.980">heart </span><span begin="00:26.980" end="00:27.190">but </span><span begin="00:27.190" end="00:27.370">she </span><span begin="00:27.370" end="00:27.880">won't </span><span begin="00:27.880" end="00:28.060">heal </span><span begin="00:28.060" end="00:28.180">my </span><span begin="00:28.180" end="00:29.770">soul</span></p><p ttm:agent="v1" begin="00:31.810" end="00:37.120"><span begin="00:31.810" end="00:32.020">She </span><span begin="00:32.020" end="00:32.770">tasted </span><span begin="00:32.770" end="00:32.860">a </span><span begin="00:32.860" end="00:33.370">break </span><span begin="00:33.370" end="00:33.550">and </span><span begin="00:33.550" end="00:33.640">I </span><span begin="00:33.640" end="00:34.030">can</span><span begin="00:34.030" end="00:34.060">’</span><span begin="00:34.060" end="00:34.120">t </span><span begin="00:34.120" end="00:34.330">get </span><span begin="00:34.330" end="00:37.120">more</span></p><p ttm:agent="v1" begin="00:37.390" end="00:43.570"><span begin="00:37.390" end="00:37.600">You </span><span begin="00:37.600" end="00:37.900">got </span><span begin="00:37.900" end="00:38.110">me </span><span begin="00:38.110" end="00:38.320">in </span><span begin="00:38.320" end="00:39.580">chains</span><span begin="00:39.580" end="00:40.510">, </span><span begin="00:40.510" end="00:40.780">you </span><span begin="00:40.780" end="00:41.020">got </span><span begin="00:41.020" end="00:41.260">me </span><span begin="00:41.260" end="00:41.500">in </span><span begin="00:41.500" end="00:42.310">chains </span><span begin="00:42.310" end="00:42.610">for </span><span begin="00:42.610" end="00:42.790">your </span><span begin="00:42.790" end="00:43.570">love</span></p><p ttm:agent="v1" begin="00:43.660" end="00:50.050"><span begin="00:43.660" end="00:44.020">But </span><span begin="00:44.020" end="00:44.140">I </span><span begin="00:44.140" end="00:44.500">wouldn</span><span begin="00:44.500" end="00:44.530">’</span><span begin="00:44.530" end="00:44.590">t </span><span begin="00:44.590" end="00:45.730">change</span><span begin="00:45.730" end="00:46.840">, </span><span begin="00:46.840" end="00:47.110">no </span><span begin="00:47.110" end="00:47.320">I </span><span begin="00:47.320" end="00:47.620">wouldn</span><span begin="00:47.620" end="00:47.650">’</span><span begin="00:47.650" end="00:47.710">t </span><span begin="00:47.710" end="00:48.700">change </span><span begin="00:48.700" end="00:49.270">this </span><span begin="00:49.270" end="00:50.050">love</span></p><p ttm:agent="v1" begin="00:50.080" end="00:56.290"><span begin="00:50.080" end="00:50.200">You </span><span begin="00:50.200" end="00:50.530">got </span><span begin="00:50.530" end="00:50.830">me </span><span begin="00:50.830" end="00:50.980">in </span><span begin="00:50.980" end="00:51.880">chains</span><span begin="00:51.880" end="00:53.140">, </span><span begin="00:53.140" end="00:53.380">you </span><span begin="00:53.380" end="00:53.650">got </span><span begin="00:53.650" end="00:53.890">me </span><span begin="00:53.890" end="00:54.130">in </span><span begin="00:54.130" end="00:54.940">chains </span><span begin="00:54.940" end="00:55.240">for </span><span begin="00:55.240" end="00:55.420">your </span><span begin="00:55.420" end="00:56.290">love</span></p><p ttm:agent="v1" begin="00:56.320" end="01:03.370"><span begin="00:56.320" end="00:56.650">But </span><span begin="00:56.650" end="00:56.770">I </span><span begin="00:56.770" end="00:57.130">wouldn</span><span begin="00:57.130" end="00:57.160">’</span><span begin="00:57.160" end="00:57.220">t </span><span begin="00:57.220" end="00:57.970">change</span><span begin="00:57.970" end="00:59.470">, </span><span begin="00:59.470" end="00:59.710">no </span><span begin="00:59.710" end="00:59.950">I </span><span begin="00:59.950" end="01:00.370">wouldn</span><span begin="01:00.370" end="01:00.400">’</span><span begin="01:00.400" end="01:00.460">t </span><span begin="01:00.460" end="01:01.330">change </span><span begin="01:01.330" end="01:01.900">this </span><span begin="01:01.900" end="01:03.370">love</span></p><p ttm:agent="v1" begin="01:03.550" end="01:06.880"><span begin="01:03.550" end="01:04.060">Tryna </span><span begin="01:04.060" end="01:04.300">break </span><span begin="01:04.300" end="01:04.390">the </span><span begin="01:04.390" end="01:04.900">chains </span><span begin="01:04.900" end="01:05.050">but </span><span begin="01:05.050" end="01:05.170">the </span><span begin="01:05.170" end="01:05.710">chains </span><span begin="01:05.710" end="01:06.040">only </span><span begin="01:06.040" end="01:06.400">break </span><span begin="01:06.400" end="01:06.880">me</span></p><p ttm:agent="v1" begin="01:06.880" end="01:16.330"><span begin="01:06.880" end="01:07.166">（</span><span begin="01:07.166" end="01:07.452">Hey</span><span begin="01:07.452" end="01:07.738">-</span><span begin="01:07.738" end="01:08.024">ey</span><span begin="01:08.024" end="01:08.310">-</span><span begin="01:08.310" end="01:08.596">ey</span><span begin="01:08.596" end="01:08.882">-</span><span begin="01:08.882" end="01:09.168">ey</span><span begin="01:09.168" end="01:09.454">, </span><span begin="01:09.454" end="01:09.740">hey</span><span begin="01:09.740" end="01:10.026">-</span><span begin="01:10.026" end="01:10.312">ey</span><span begin="01:10.312" end="01:10.598">-</span><span begin="01:10.598" end="01:10.884">ey</span><span begin="01:10.884" end="01:11.170">-</span><span begin="01:11.170" end="01:11.456">ey</span><span begin="01:11.456" end="01:11.742">, </span><span begin="01:11.742" end="01:12.028">hey</span><span begin="01:12.028" end="01:12.314">-</span><span begin="01:12.314" end="01:12.600">ey</span><span begin="01:12.600" end="01:12.886">-</span><span begin="01:12.886" end="01:13.172">ey</span><span begin="01:13.172" end="01:13.458">-</span><span begin="01:13.458" end="01:13.744">ey</span><span begin="01:13.744" end="01:14.030">, </span><span begin="01:14.030" end="01:14.316">hey</span><span begin="01:14.316" end="01:14.602">-</span><span begin="01:14.602" end="01:14.888">ey</span><span begin="01:14.888" end="01:15.174">-</span><span begin="01:15.174" end="01:15.460">ey</span><span begin="01:15.460" end="01:15.746">-</span><span begin="01:15.746" end="01:16.032">ey</span><span begin="01:16.032" end="01:16.330">）</span></p><p ttm:agent="v1" begin="01:16.330" end="01:19.450"><span begin="01:16.330" end="01:16.720">Tryna </span><span begin="01:16.720" end="01:16.960">break </span><span begin="01:16.960" end="01:17.020">the </span><span begin="01:17.020" end="01:17.560">chains </span><span begin="01:17.560" end="01:17.710">but </span><span begin="01:17.710" end="01:17.830">the </span><span begin="01:17.830" end="01:18.340">chains </span><span begin="01:18.340" end="01:18.670">only </span><span begin="01:18.670" end="01:19.030">break </span><span begin="01:19.030" end="01:19.450">me</span></p><p ttm:agent="v1" begin="01:19.450" end="01:23.440"><span begin="01:19.450" end="01:19.930">Alone </span><span begin="01:19.930" end="01:20.110">in </span><span begin="01:20.110" end="01:20.170">the </span><span begin="01:20.170" end="01:20.560">night </span><span begin="01:20.560" end="01:20.590">‘</span><span begin="01:20.590" end="01:20.800">til </span><span begin="01:20.800" end="01:20.980">she </span><span begin="01:20.980" end="01:21.520">knocks </span><span begin="01:21.520" end="01:21.700">on </span><span begin="01:21.700" end="01:21.790">my </span><span begin="01:21.790" end="01:23.440">door</span></p><p ttm:agent="v1" begin="01:23.860" end="01:32.020"><span begin="01:23.860" end="01:24.160">Oh </span><span begin="01:24.160" end="01:25.210">no</span><span begin="01:25.210" end="01:25.630">, </span><span begin="01:25.630" end="01:26.470">wasted </span><span begin="01:26.470" end="01:26.980">again </span><span begin="01:26.980" end="01:27.250">but </span><span begin="01:27.250" end="01:27.340">I </span><span begin="01:27.340" end="01:27.700">can</span><span begin="01:27.700" end="01:27.790">’</span><span begin="01:27.790" end="01:27.850">t </span><span begin="01:27.850" end="01:28.000">say </span><span begin="01:28.000" end="01:29.590">no </span><span begin="01:29.590" end="01:29.860">（</span><span begin="01:29.860" end="01:31.540">no</span><span begin="01:31.540" end="01:32.020">）</span></p><p ttm:agent="v1" begin="01:32.020" end="01:35.200"><span begin="01:32.020" end="01:32.470">Baby </span><span begin="01:32.470" end="01:32.740">tell </span><span begin="01:32.740" end="01:32.830">me </span><span begin="01:32.830" end="01:33.220">why</span><span begin="01:33.220" end="01:33.220">, </span><span begin="01:33.220" end="01:33.550">why </span><span begin="01:33.550" end="01:33.670">you </span><span begin="01:33.670" end="01:34.030">do</span><span begin="01:34.030" end="01:34.030">, </span><span begin="01:34.030" end="01:34.300">do </span><span begin="01:34.300" end="01:34.450">me </span><span begin="01:34.450" end="01:35.200">wrong</span></p><p ttm:agent="v1" begin="01:35.230" end="01:38.350"><span begin="01:35.230" end="01:35.620">Baby </span><span begin="01:35.620" end="01:35.890">tell </span><span begin="01:35.890" end="01:36.010">me </span><span begin="01:36.010" end="01:36.370">why</span><span begin="01:36.370" end="01:36.370">, </span><span begin="01:36.370" end="01:36.700">why </span><span begin="01:36.700" end="01:36.820">you </span><span begin="01:36.820" end="01:37.210">do</span><span begin="01:37.210" end="01:37.210">, </span><span begin="01:37.210" end="01:37.450">do </span><span begin="01:37.450" end="01:37.570">me </span><span begin="01:37.570" end="01:38.350">wrong</span></p><p ttm:agent="v1" begin="01:38.380" end="01:43.960"><span begin="01:38.380" end="01:38.860">Gave </span><span begin="01:38.860" end="01:39.010">you </span><span begin="01:39.010" end="01:39.220">my </span><span begin="01:39.220" end="01:39.580">heart </span><span begin="01:39.580" end="01:39.820">but </span><span begin="01:39.820" end="01:39.940">you </span><span begin="01:39.940" end="01:40.330">took </span><span begin="01:40.330" end="01:40.630">my </span><span begin="01:40.630" end="01:43.960">soul</span></p><p ttm:agent="v1" begin="01:43.960" end="01:49.990"><span begin="01:43.960" end="01:44.140">You </span><span begin="01:44.140" end="01:44.230">got </span><span begin="01:44.230" end="01:44.440">me </span><span begin="01:44.440" end="01:44.650">in </span><span begin="01:44.650" end="01:45.730">chains</span><span begin="01:45.730" end="01:46.900">, </span><span begin="01:46.900" end="01:47.080">you </span><span begin="01:47.080" end="01:47.350">got </span><span begin="01:47.350" end="01:47.620">me </span><span begin="01:47.620" end="01:47.800">in </span><span begin="01:47.800" end="01:48.640">chains </span><span begin="01:48.640" end="01:48.910">for </span><span begin="01:48.910" end="01:49.090">your </span><span begin="01:49.090" end="01:49.990">love</span></p><p ttm:agent="v1" begin="01:50.020" end="01:56.470"><span begin="01:50.020" end="01:50.350">But </span><span begin="01:50.350" end="01:50.440">I </span><span begin="01:50.440" end="01:50.830">wouldn</span><span begin="01:50.830" end="01:50.860">’</span><span begin="01:50.860" end="01:50.920">t </span><span begin="01:50.920" end="01:51.550">change</span><span begin="01:51.550" end="01:53.200">, </span><span begin="01:53.200" end="01