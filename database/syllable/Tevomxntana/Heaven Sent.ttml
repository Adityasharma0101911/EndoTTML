9.170"> </span><span begin="00:19.170" end="00:19.500">for</span><span begin="00:19.500" end="00:19.530"> </span><span begin="00:19.530" end="00:20.040">her</span><span begin="00:20.040" end="00:20.070">, </span><span begin="00:20.070" end="00:20.400">but </span><span begin="00:20.400" end="00:20.640">that's</span><span begin="00:20.640" end="00:20.670"> </span><span begin="00:20.670" end="00:20.820">not </span><span begin="00:20.820" end="00:21.120">what </span><span begin="00:21.120" end="00:21.210">it </span><span begin="00:21.210" end="00:21.780">seems </span><span begin="00:21.780" end="00:21.870">（</span><span begin="00:21.870" end="00:21.960">Yuh</span><span begin="00:21.960" end="00:22.050">）</span></p><p ttm:agent="v1" begin="00:22.050" end="00:25.650"><span begin="00:22.050" end="00:22.620">Shawty </span><span begin="00:22.620" end="00:23.040">heaven</span><span begin="00:23.040" end="00:23.160"> </span><span begin="00:23.160" end="00:23.340">sent</span><span begin="00:23.340" end="00:23.340">, </span><span begin="00:23.340" end="00:23.520">she </span><span begin="00:23.520" end="00:23.790">came </span><span begin="00:23.790" end="00:24.000">from </span><span begin="00:24.000" end="00:24.450">place </span><span begin="00:24.450" end="00:24.480"> </span><span begin="00:24.480" end="00:24.840">far </span><span begin="00:24.840" end="00:25.620">away</span></p><p ttm:agent="v1" begin="00:25.650" end="00:27.300"><span begin="00:25.650" end="00:25.885">It's </span><span begin="00:25.885" end="00:26.120">something </span><span begin="00:26.120" end="00:26.355">I </span><span begin="00:26.355" end="00:26.590">can't</span><span begin="00:26.590" end="00:26.825"> </span><span begin="00:26.825" end="00:27.060">explain</span></p><p ttm:agent="v1" begin="00:27.300" end="00:28.980"><span begin="00:27.300" end="00:27.480">Hope</span><span begin="00:27.480" end="00:27.510"> </span><span begin="00:27.510" end="00:27.750">these</span><span begin="00:27.750" end="00:27.780"> </span><span begin="00:27.780" end="00:28.200">feelings </span><span begin="00:28.200" end="00:28.470">don't </span><span begin="00:28.470" end="00:28.950">decay</span></p><p ttm:agent="v1" begin="00:28.980" end="00:32.760"><span begin="00:28.980" end="00:29.280">She</span><span begin="00:29.280" end="00:29.310"> </span><span begin="00:29.310" end="00:29.580">said </span><span begin="00:29.580" end="00:29.580">"</span><span begin="00:29.580" end="00:29.790">Don't </span><span begin="00:29.790" end="00:29.970">get</span><span begin="00:29.970" end="00:30.000"> </span><span begin="00:30.000" end="00:30.270">too </span><span begin="00:30.270" end="00:30.780">attached</span><span begin="00:30.780" end="00:30.780">"</span><span begin="00:30.780" end="00:30.780">, </span><span begin="00:30.780" end="00:30.870">but </span><span begin="00:30.870" end="00:31.230">she </span><span begin="00:31.230" end="00:32.130">attached </span><span begin="00:32.130" end="00:32.370">to </span><span begin="00:32.370" end="00:32.730">me</span></p><p ttm:agent="v1" begin="00:32.760" end="00:36.810"><span begin="00:32.760" end="00:32.970">You </span><span begin="00:32.970" end="00:33.270">said </span><span begin="00:33.270" end="00:33.450">you </span><span begin="00:33.450" end="00:33.690">would </span><span begin="00:33.690" end="00:33.930">die </span><span begin="00:33.930" end="00:34.230">for </span><span begin="00:34.230" end="00:34.770">her</span><span begin="00:34.770" end="00:34.800">, </span><span begin="00:34.800" end="00:35.160">but </span><span begin="00:35.160" end="00:35.400">that's </span><span begin="00:35.400" end="00:35.580">not </span><span begin="00:35.580" end="00:35.880">what </span><span begin="00:35.880" end="00:36.000">it </span><span begin="00:36.000" end="00:36.570">seems </span><span begin="00:36.570" end="00:36.650">（</span><span begin="00:36.650" end="00:36.730">Yuh</span><span begin="00:36.730" end="00:36.810">）</span></p><p ttm:agent="v1" begin="00:36.810" end="00:40.470"><span begin="00:36.810" end="00:37.380">Shawty </span><span begin="00:37.380" end="00:37.800">heaven </span><span begin="00:37.800" end="00:38.100">sent</span><span begin="00:38.100" end="00:38.100">, </span><span begin="00:38.100" end="00:38.280">she </span><span begin="00:38.280" end="00:38.550">came </span><span begin="00:38.550" end="00:38.760">from </span><span begin="00:38.760" end="00:39.210">place </span><span begin="00:39.210" end="00:39.240"> </span><span begin="00:39.240" end="00:39.600">far </span><span begin="00:39.600" end="00:40.200">away</span></p><p ttm:agent="v1" begin="00:40.470" end="00:42.060"><span begin="00:40.470" end="00:40.735">It's </span><span begin="00:40.735" end="00:41.000">something </span><span begin="00:41.000" end="00:41.265">I </span><span begin="00:41.265" end="00:41.530">can't </span><span begin="00:41.530" end="00:41.795">explain</span></p><p ttm:agent="v1" begin="00:42.060" end="00:44.100"><span begin="00:42.060" end="00:42.300">Hope </span><span begin="00:42.300" end="00:42.480">these </span><span begin="00:42.480" end="00:42.990">feelings </span><span begin="00:42.990" end="00:43.230">don't </span><span begin="00:43.230" end="00:44.070">decay</span></p><p ttm:agent="v1" begin="00:44.100" end="00:45.510"><span begin="00:44.100" end="00:44.910">Stacked </span><span begin="00:44.910" end="00:45.450">up</span></p><p ttm:agent="v1" begin="00:45.510" end="00:47.340"><span begin="00:45.510" end="00:45.690">Oh </span><span begin="00:45.690" end="00:45.990">yeah</span><span begin="00:45.990" end="00:45.990">, </span><span begin="00:45.990" end="00:46.260">I'm </span><span begin="00:46.260" end="00:46.410">in </span><span begin="00:46.410" end="00:46.590">my </span><span begin="00:46.590" end="00:47.310">bag</span></p><p ttm:agent="v1" begin="00:47.340" end="00:51.180"><span begin="00:47.340" end="00:47.580">Will </span><span begin="00:47.580" end="00:47.730">you </span><span begin="00:47.730" end="00:47.970">stay </span><span begin="00:47.970" end="00:48.450">ten </span><span begin="00:48.450" end="00:49.080">toes </span><span begin="00:49.080" end="00:49.140"> </span><span begin="00:49.140" end="00:49.410">if </span><span begin="00:49.410" end="00:49.590">they </span><span begin="00:49.590" end="00:49.950">pull </span><span begin="00:49.950" end="00:50.130">up </span><span begin="00:50.130" end="00:50.310">with </span><span begin="00:50.310" end="00:51.000">gats</span><span begin="00:51.000" end="00:51.180">?</span></p><p ttm:agent="v1" begin="00:51.180" end="00:54.990"><span begin="00:51.180" end="00:51.690">so </span><span begin="00:51.690" end="00:53.280">gone</span><span begin="00:53.280" end="00:53.310">, </span><span begin="00:53.310" end="00:53.550">I </span><span begin="00:53.550" end="00:54.030">wonder </span><span begin="00:54.030" end="00:54.330">where </span><span begin="00:54.330" end="00:54.600">I'm </span><span begin="00:54.600" end="00:54.990">at</span></p><p ttm:agent="v1" begin="00:54.990" end="00:57.060"><span begin="00:54.990" end="00:55.290">Oh</span><span begin="00:55.290" end="00:55.290">, </span><span begin="00:55.290" end="00:55.590">she </span><span begin="00:55.590" end="00:55.950">ten </span><span begin="00:55.950" end="00:56.160">out </span><span begin="00:56.160" end="00:56.280">of </span><span begin="00:56.280" end="00:57.000">ten </span><span begin="00:57.000" end="00:57.020">（</span><span begin="00:57.020" end="00:57.040">Oh</span><span begin="00:57.040" end="00:57.060">）</span></p><p ttm:agent="v1" begin="00:57.060" end="00:58.680"><span begin="00:57.060" end="00:57.270">Look </span><span begin="00:57.270" end="00:57.480">good </span><span begin="00:57.480" end="00:57.690">from </span><span begin="00:57.690" end="00:57.990">front </span><span begin="00:57.990" end="00:58.200">and </span><span begin="00:58.200" end="00:58.650">back</span></p><p ttm:agent="v1" begin="00:58.680" end="00:59.910"><span begin="00:58.680" end="00:58.860">I </span><span begin="00:58.860" end="00:59.100">don't </span><span begin="00:59.100" end="00:59.880">know</span></p><p ttm:agent="v1" begin="00:59.910" end="01:03.660"><span begin="00:59.910" end="01:00.450">Shawty </span><span begin="01:00.450" end="01:00.660">do </span><span begin="01:00.660" end="01:00.900">you </span><span begin="01:00.900" end="01:01.200">love </span><span begin="01:01.200" end="01:01.350">me </span><span begin="01:01.350" end="01:01.650">like </span><span begin="01:01.650" end="01:01.770">you </span><span begin="01:01.770" end="01:02.160">say</span><span begin="01:02.160" end="01:02.410">? </span><span begin="01:02.410" end="01:02.660">（</span><span begin="01:02.660" end="01:02.910">Like </span><span begin="01:02.910" end="01:03.160">you </span><span begin="01:03.160" end="01:03.410">say</span><span begin="01:03.410" end="01:03.660">）</span></p><p ttm:agent="v1" begin="01:03.660" end="01:07.140"><span begin="01:03.660" end="01:03.960">Tell </span><span begin="01:03.960" end="01:04.140">me</span><span begin="01:04.140" end="01:04.140">, </span><span begin="01:04.140" end="01:04.350">do </span><span begin="01:04.350" end="01:04.590">you </span><span begin="01:04.590" end="01:04.890">love </span><span begin="01:04.890" end="01:05.070">me </span><span begin="01:05.070" end="01:05.370">like </span><span begin="01:05.370" end="01:05.490">you </span><span begin="01:05.490" end="01:07.110">claim</span><span begin="01:07.110" end="01:07.110">? </span><span begin="01:07.110" end="01:07.110">（</span><span begin="01:07.110" end="01:07.110">Claim</span><span begin="01:07.110" end="01:07.140">）</span></p><p ttm:agent="v1" begin="01:07.140" end="01:10.860"><span begin="01:07.140" end="01:07.320">'Cause </span><span begin="01:07.320" end="01:07.410">it's </span><span begin="01:07.410" end="01:07.950">sunny </span><span begin="01:07.950" end="01:08.130">out </span><span begin="01:08.130" end="01:08.370">but </span><span begin="01:08.370" end="01:08.520">I </span><span begin="01:08.520" end="01:08.730">still </span><span begin="01:08.730" end="01:09.030">feel </span><span begin="01:09.030" end="01:09.210">the </span><span begin="01:09.210" end="01:10.860">rain </span><span begin="01:10.860" end="01:10.860">（</span><span begin="01:10.860" end="01:10.860">Rain</span><span begin="01:10.860" end="01:10.860">）</span></p><p ttm:agent="v1" begin="01:10.860" end="01:13.680"><span begin="01:10.860" end="01:11.070">Got </span><span begin="01:11.070" end="01:11.100">a </span><span begin="01:11.100" end="01:11.400">watch </span><span begin="01:11.400" end="01:11.550"> </span><span begin="01:11.550" end="01:11.820">but </span><span begin="01:11.820" end="01:11.850">I </span><span begin="01:11.850" end="01:12.000">don't </span><span begin="01:12.000" end="01:12.270">care </span><span begin="01:12.270" end="01:12.420">bout </span><span begin="01:12.420" end="01:12.480">a </span><span begin="01:12.480" end="01:12.900">Milli </span><span begin="01:12.900" end="01:13.350">plain</span><span begin="01:13.350" end="01:13.380">, </span><span begin="01:13.380" end="01:13.680">No</span></p><p ttm:agent="v1" begin="01:13.680" end="01:15.300"><span begin="01:13.680" end="01:13.860">Let's </span><span begin="01:13.860" end="01:14.220">go </span><span begin="01:14.220" end="01:15.240">away</span></p><p ttm:agent="v1" begin="01:15.300" end="01:17.100"><span begin="01:15.300" end="01:15.600">I'm </span><span begin="01:15.600" end="01:15.900">just </span><span begin="01:15.900" end="01:16.200">a </span><span begin="01:16.200" end="01:16.500">fourth </span><span begin="01:16.500" end="01:16.800">away</span></p><p ttm:agent="v1" begin="01:17.100" end="01:18.900"><span begin="01:17.100" end="01:17.250">Is </span><span begin="01:17.250" end="01:17.400">she </span><span begin="01:17.400" end="01:17.580">for </span><span begin="01:17.580" end="01:17.730">me </span><span begin="01:17.730" end="01:17.880">or </span><span begin="01:17.880" end="01:18.000">the </span><span begin