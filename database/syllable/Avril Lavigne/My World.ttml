<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>My World</ttm:title><ttm:agent type="person" xml:id="v1">Avril Lavigne</ttm:agent><ttm:item type="album">Let Go</ttm:item><ttm:item type="spotify_id">2eQMZp4HLfQAX5S7wRuso3</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:09.090" end="00:11.490"><span begin="00:09.090" end="00:09.540">Please </span><span begin="00:09.540" end="00:09.840">tell </span><span begin="00:09.840" end="00:10.050">me </span><span begin="00:10.050" end="00:10.470">what </span><span begin="00:10.470" end="00:10.620">is </span><span begin="00:10.620" end="00:11.100">takin' </span><span begin="00:11.100" end="00:11.490">place</span></p><p ttm:agent="v1" begin="00:11.490" end="00:13.980"><span begin="00:11.490" end="00:11.820">Cuz </span><span begin="00:11.820" end="00:12.120">I </span><span begin="00:12.120" end="00:12.450">can't </span><span begin="00:12.450" end="00:12.780">seem </span><span begin="00:12.780" end="00:12.870">to </span><span begin="00:12.870" end="00:13.290">find </span><span begin="00:13.290" end="00:13.380">a </span><span begin="00:13.380" end="00:13.980">trace</span></p><p ttm:agent="v1" begin="00:14.010" end="00:17.190"><span begin="00:14.010" end="00:14.580">Guess </span><span begin="00:14.580" end="00:14.730">it </span><span begin="00:14.730" end="00:15.120">must </span><span begin="00:15.120" end="00:15.210">have </span><span begin="00:15.210" end="00:15.630">got </span><span begin="00:15.630" end="00:16.110">erased </span><span begin="00:16.110" end="00:17.190">somehow</span></p><p ttm:agent="v1" begin="00:18.630" end="00:21.090"><span begin="00:18.630" end="00:19.260">Probably </span><span begin="00:19.260" end="00:19.800">cuz </span><span begin="00:19.800" end="00:19.980">I </span><span begin="00:19.980" end="00:20.460">always </span><span begin="00:20.460" end="00:21.090">forget</span></p><p ttm:agent="v1" begin="00:21.090" end="00:23.820"><span begin="00:21.090" end="00:21.750">Everytime </span><span begin="00:21.750" end="00:22.230">someone </span><span begin="00:22.230" end="00:22.560">tells </span><span begin="00:22.560" end="00:22.770">me </span><span begin="00:22.770" end="00:22.950">their </span><span begin="00:22.950" end="00:23.820">name</span></p><p ttm:agent="v1" begin="00:24.240" end="00:28.170"><span begin="00:24.240" end="00:24.480">It's </span><span begin="00:24.480" end="00:24.750">always </span><span begin="00:24.750" end="00:25.080">gotta </span><span begin="00:25.080" end="00:25.410">be </span><span begin="00:25.410" end="00:25.500">the </span><span begin="00:25.500" end="00:26.550">same </span><span begin="00:26.550" end="00:27.060">（</span><span begin="00:27.060" end="00:27.300">In </span><span begin="00:27.300" end="00:27.570">my </span><span begin="00:27.570" end="00:28.170">World</span><span begin="00:28.170" end="00:28.170">）</span></p><p ttm:agent="v1" begin="00:28.170" end="00:30.450"><span begin="00:28.170" end="00:28.740">Never </span><span begin="00:28.740" end="00:29.190">wore </span><span begin="00:29.190" end="00:29.910">cover</span><span begin="00:29.910" end="00:30.060">-</span><span begin="00:30.060" end="00:30.450">up</span></p><p ttm:agent="v1" begin="00:30.450" end="00:32.700"><span begin="00:30.450" end="00:31.110">Always </span><span begin="00:31.110" end="00:31.560">beat </span><span begin="00:31.560" end="00:31.800">the </span><span begin="00:31.800" end="00:32.250">boys </span><span begin="00:32.250" end="00:32.700">up</span></p><p ttm:agent="v1" begin="00:32.700" end="00:36.210"><span begin="00:32.700" end="00:33.060">Grew </span><span begin="00:33.060" end="00:33.210">up </span><span begin="00:33.210" end="00:33.330">in </span><span begin="00:33.330" end="00:33.390">a </span><span begin="00:33.390" end="00:33.750">five </span><span begin="00:33.750" end="00:34.050">thousand </span><span begin="00:34.050" end="00:35.070">population </span><span begin="00:35.070" end="00:36.210">town</span></p><p ttm:agent="v1" begin="00:37.290" end="00:39.480"><span begin="00:37.290" end="00:37.710">Made </span><span begin="00:37.710" end="00:37.950">my </span><span begin="00:37.950" end="00:38.370">money </span><span begin="00:38.370" end="00:38.610">by </span><span begin="00:38.610" end="00:39.150">cutting </span><span begin="00:39.150" end="00:39.480">grass</span></p><p ttm:agent="v1" begin="00:39.480" end="00:41.940"><span begin="00:39.480" end="00:39.720">Got </span><span begin="00:39.720" end="00:40.200">fired </span><span begin="00:40.200" end="00:40.410">by </span><span begin="00:40.410" end="00:40.860">fried </span><span begin="00:40.860" end="00:41.550">chicken </span><span begin="00:41.550" end="00:41.940">ass</span></p><p ttm:agent="v1" begin="00:42.000" end="00:45.150"><span begin="00:42.000" end="00:42.570">All </span><span begin="00:42.570" end="00:42.690">in </span><span begin="00:42.690" end="00:42.720">a </span><span begin="00:42.720" end="00:43.080">small </span><span begin="00:43.080" end="00:44.010">town</span><span begin="00:44.010" end="00:44.010">, </span><span begin="00:44.010" end="00:45.150">Napanee</span></p><p ttm:agent="v1" begin="00:45.150" end="00:51.150"><span begin="00:45.150" end="00:46.230">You </span><span begin="00:46.230" end="00:46.650">know </span><span begin="00:46.650" end="00:47.430">I </span><span begin="00:47.430" end="00:47.700">always </span><span begin="00:47.700" end="00:48.870">stay </span><span begin="00:48.870" end="00:49.740">up </span><span begin="00:49.740" end="00:50.190">without </span><span begin="00:50.190" end="00:51.150">sleepin'</span></p><p ttm:agent="v1" begin="00:51.210" end="00:54.990"><span begin="00:51.210" end="00:51.510">And </span><span begin="00:51.510" end="00:52.350">think </span><span begin="00:52.350" end="00:53.280">to </span><span begin="00:53.280" end="00:54.990">myself</span></p><p ttm:agent="v1" begin="00:56.070" end="01:00.450"><span begin="00:56.070" end="00:56.820">Where </span><span begin="00:56.820" end="00:57.090">do </span><span begin="00:57.090" end="00:58.170">I </span><span begin="00:58.170" end="00:59.340">belong </span><span begin="00:59.340" end="01:00.450">forever</span></p><p ttm:agent="v1" begin="01:00.780" end="01:05.310"><span begin="01:00.780" end="01:01.470">In </span><span begin="01:01.470" end="01:01.800">whose </span><span begin="01:01.800" end="01:02.580">arms</span><span begin="01:02.580" end="01:02.580">, </span><span begin="01:02.580" end="01:02.730">the </span><span begin="01:02.730" end="01:03.300">time </span><span begin="01:03.300" end="01:03.420">and </span><span begin="01:03.420" end="01:04.980">place</span><span begin="01:04.980" end="01:05.310">?</span></p><p ttm:agent="v1" begin="01:05.310" end="01:07.710"><span begin="01:05.310" end="01:05.580">Can't </span><span begin="01:05.580" end="01:05.820">help </span><span begin="01:05.820" end="01:06.120">it </span><span begin="01:06.120" end="01:06.330">if </span><span begin="01:06.330" end="01:06.480">I </span><span begin="01:06.480" end="01:06.960">space </span><span begin="01:06.960" end="01:07.170">in </span><span begin="01:07.170" end="01:07.260">a </span><span begin="01:07.260" end="01:07.710">daze</span></p><p ttm:agent="v1" begin="01:07.710" end="01:09.870"><span begin="01:07.710" end="01:07.890">My </span><span begin="01:07.890" end="01:08.190">eyes </span><span begin="01:08.190" end="01:08.520">tune </span><span begin="01:08.520" end="01:08.730">out </span><span begin="01:08.730" end="01:08.940">the </span><span begin="01:08.940" end="01:09.420">other </span><span begin="01:09.420" end="01:09.870">way</span></p><p ttm:agent="v1" begin="01:10.020" end="01:13.650"><span begin="01:10.020" end="01:10.170">I </span><span begin="01:10.170" end="01:10.350">may </span><span begin="01:10.350" end="01:10.770">switch </span><span begin="01:10.770" end="01:11.040">off </span><span begin="01:11.040" end="01:11.250">and </span><span begin="01:11.250" end="01:11.580">go </span><span begin="01:11.580" end="01:11.880">in </span><span begin="01:11.880" end="01:12.060">a </span><span begin="01:12.060" end="01:13.650">daydream</span></p><p ttm:agent="v1" begin="01:14.790" end="01:16.890"><span begin="01:14.790" end="01:15.060">In </span><span begin="01:15.060" end="01:15.360">this </span><span begin="01:15.360" end="01:15.630">head </span><span begin="01:15.630" end="01:15.840">my </span><span begin="01:15.840" end="01:16.260">thoughts </span><span begin="01:16.260" end="01:16.470">are </span><span begin="01:16.470" end="01:16.890">deep</span></p><p ttm:agent="v1" begin="01:16.890" end="01:19.290"><span begin="01:16.890" end="01:17.010">But </span><span begin="01:17.010" end="01:17.580">sometimes </span><span begin="01:17.580" end="01:17.730">I </span><span begin="01:17.730" end="01:18.210">can't </span><span begin="01:18.210" end="01:18.690">even </span><span begin="01:18.690" end="01:19.290">speak</span></p><p ttm:agent="v1" begin="01:19.320" end="01:21.660"><span begin="01:19.320" end="01:19.500">Will </span><span begin="01:19.500" end="01:20.100">someone </span><span begin="01:20.100" end="01:20.490">be </span><span begin="01:20.490" end="01:20.610">and </span><span begin="01:20.610" end="01:20.970">not </span><span begin="01:20.970" end="01:21.660">pretend</span></p><p ttm:agent="v1" begin="01:21.660" end="01:24.840"><span begin="01:21.660" end="01:21.930">I'm </span><span begin="01:21.930" end="01:22.200">off </span><span begin="01:22.200" end="01:23.130">again </span><span begin="01:23.130" end="01:23.280">in </span><span begin="01:23.280" end="01:23.580">my </span><span begin="01:23.580" end="01:24.840">World</span></p><p ttm:agent="v1" begin="01:28.440" end="01:30.990"><span begin="01:28.440" end="01:28.800">I </span><span begin="01:28.800" end="01:29.250">never </span><span begin="01:29.250" end="01:29.640">spend </span><span begin="01:29.640" end="01:29.940">less </span><span begin="01:29.940" end="01:30.300">than </span><span begin="01:30.300" end="01:30.570">an </span><span begin="01:30.570" end="01:30.990">hour</span></p><p ttm:agent="v1" begin="01:30.990" end="01:33.270"><span begin="01:30.990" end="01:31.620">Washin' </span><span begin="01:31.620" end="01:31.950">my </span><span begin="01:31.950" end="01:32.310">hair </span><span begin="01:32.310" end="01:32.520">in </span><span begin="01:32.520" end="01:32.670">the </span><span begin="01:32.670" end="01:33.270">shower</span></p><p ttm:agent="v1" begin="01:33.270" end="01:36.540"><span begin="01:33.270" end="01:33.510">It </span><span begin="01:33.510" end="01:34.110">always </span><span begin="01:34.110" end="01:34.410">takes </span><span begin="01:34.410" end="01:34.680">five </span><span begin="01:34.680" end="01:35.040">hours </span><span begin="01:35.040" end="01:35.130">to </span><span begin="01:35.130" end="01:35.520">make </span><span begin="01:35.520" end="01:35.670">it </span><span begin="01:35.670" end="01:36.540">straight</span></p><p ttm:agent="v1" begin="01:37.650" end="01:40.170"><span begin="01:37.650" end="01:37.920">So </span><span begin="01:37.920" end="01:38.070">I'll </span><span begin="01:38.070" end="01:38.490">braid </span><span begin="01:38.490" end="01:38.760">it </span><span begin="01:38.760" end="01:39.030">in </span><span begin="01:39.030" end="01:39.180">a </span><span begin="01:39.180" end="01:39.780">zillion </span><span begin="01:39.780" end="01:40.170">braids</span></p><p ttm:agent="v1" begin="01:40.170" end="01:42.450"><span begin="01:40.170" end="01:40.470">Though </span><span begin="01:40.470" end="01:40.680">it </span><span begin="01:40.680" end="01:41.040">may </span><span begin="01:41.040" end="01:41.400">take </span><span begin="01:41.400" end="01:41.580">a </span><span begin="01:41.580" end="01:42.150">friggin' </span><span begin="01:42.150" end="01:42.450">day</span></p><p ttm:agent="v1" begin="01:42.450" end="01:45.720"><span begin="01:42.450" end="01:42.750">There's </span><span begin="01:42.750" end="01:43.230">nothin' </span><span begin="01:43.230" end="01:43.470">else </span><span begin="01:43.470" end="01:43.740">better </span><span begin="01:43.740" end="01:43.860">to </span><span begin="01:43.860" end="01:44.550">do </span><span begin="01:44.550" end="01:45.720">anyway</span></p><p ttm:agent="v1" begin="01:46.950" end="01:51.660"><span begin="01:46.950" end="01:47.220">When </span><span begin="01:47.220" end="01:47.550">you're </span><span begin="01:47.550" end="01:48.210">all </span><span begin="01:48.210" end="01:49.200">alone </span><span begin="01:49.200" end="01:49.560">in </span><span begin="01:49.560" end="01:49.710">the </span><span begin="01:49.710" end="01:50.550">lands </span><span begin="01:50.550" end="01:50.700">of </span><span begin="01:50.700" end="01:51.660">forever</span></p><p ttm:agent="v1" begin="01:51.870" end="01:55.680"><span begin="01:51.870" end="01:52.260">Lay </span><span begin="01:52.260" end="01:52.830">under </span><span begin="01:52.830" end="01:52.980">the </span><span begin="01:52.980" end="01:54.240">milky </span><span begin="01:54.240" end="01:55.680">way</span></p><p ttm:agent="v1" begin="01:56.790" end="02:01.320"><span begin="01:56.790" end="01:57.540">On </span><span begin="01:57.540" end="01:57.810">and </span><span begin="01:57.810" end="01:58.830">on </span><span begin="01:58.830" end="01:59.070">it's </span><span begin="0