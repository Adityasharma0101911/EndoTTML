<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Don't Tell Me</ttm:title><ttm:agent type="person" xml:id="v1">Avril Lavigne</ttm:agent><ttm:item type="album">Under My Skin</ttm:item><ttm:item type="spotify_id">0dEQaNYfp5G7Sflek2Qnde</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:13.880" end="00:19.400"><span begin="00:13.880" end="00:14.180">You </span><span begin="00:14.180" end="00:14.750">held </span><span begin="00:14.750" end="00:14.990">my </span><span begin="00:14.990" end="00:15.680">hand </span><span begin="00:15.680" end="00:15.800">and </span><span begin="00:15.800" end="00:16.250">walked </span><span begin="00:16.250" end="00:16.580">me </span><span begin="00:16.580" end="00:17.780">home</span><span begin="00:17.780" end="00:17.870">, </span><span begin="00:17.870" end="00:18.260">I </span><span begin="00:18.260" end="00:19.400">know</span></p><p ttm:agent="v1" begin="00:20.300" end="00:26.090"><span begin="00:20.300" end="00:20.630">While </span><span begin="00:20.630" end="00:20.750">you </span><span begin="00:20.750" end="00:21.260">gave </span><span begin="00:21.260" end="00:21.440">me </span><span begin="00:21.440" end="00:21.620">that </span><span begin="00:21.620" end="00:22.130">kiss</span><span begin="00:22.130" end="00:22.130">, </span><span begin="00:22.130" end="00:22.280">it </span><span begin="00:22.280" end="00:22.400">was </span><span begin="00:22.400" end="00:23.090">something </span><span begin="00:23.090" end="00:23.360">like </span><span begin="00:23.360" end="00:23.780">this</span><span begin="00:23.780" end="00:23.780">, </span><span begin="00:23.780" end="00:23.900">it </span><span begin="00:23.900" end="00:24.170">made </span><span begin="00:24.170" end="00:24.290">me </span><span begin="00:24.290" end="00:24.680">go </span><span begin="00:24.680" end="00:25.010">oh </span><span begin="00:25.010" end="00:26.090">oh</span></p><p ttm:agent="v1" begin="00:27.200" end="00:33.650"><span begin="00:27.200" end="00:27.470">You </span><span begin="00:27.470" end="00:28.070">wiped </span><span begin="00:28.070" end="00:28.280">my </span><span begin="00:28.280" end="00:28.730">tears</span><span begin="00:28.730" end="00:28.730">, </span><span begin="00:28.730" end="00:28.940">got </span><span begin="00:28.940" end="00:29.240">rid </span><span begin="00:29.240" end="00:29.420">of </span><span begin="00:29.420" end="00:29.600">all </span><span begin="00:29.600" end="00:29.840">my </span><span begin="00:29.840" end="00:30.410">fears</span><span begin="00:30.410" end="00:30.410">, </span><span begin="00:30.410" end="00:30.650">why </span><span begin="00:30.650" end="00:30.860">did </span><span begin="00:30.860" end="00:31.010">you </span><span begin="00:31.010" end="00:31.400">have </span><span begin="00:31.400" end="00:31.580">to </span><span begin="00:31.580" end="00:32.750">go</span><span begin="00:32.750" end="00:33.650">?</span></p><p ttm:agent="v1" begin="00:33.650" end="00:39.050"><span begin="00:33.650" end="00:34.010">Guess </span><span begin="00:34.010" end="00:34.130">it </span><span begin="00:34.130" end="00:34.850">wasn't </span><span begin="00:34.850" end="00:35.360">enough </span><span begin="00:35.360" end="00:35.540">to </span><span begin="00:35.540" end="00:35.840">take </span><span begin="00:35.840" end="00:35.930">up </span><span begin="00:35.930" end="00:36.260">some </span><span begin="00:36.260" end="00:36.380">of </span><span begin="00:36.380" end="00:36.620">my </span><span begin="00:36.620" end="00:37.070">love</span><span begin="00:37.070" end="00:37.070">, </span><span begin="00:37.070" end="00:37.520">guys </span><span begin="00:37.520" end="00:37.610">are </span><span begin="00:37.610" end="00:37.910">so </span><span begin="00:37.910" end="00:38.150">hard </span><span begin="00:38.150" end="00:38.240">to </span><span begin="00:38.240" end="00:39.050">trust</span></p><p ttm:agent="v1" begin="00:39.290" end="00:45.470"><span begin="00:39.290" end="00:39.830">Did </span><span begin="00:39.830" end="00:40.490">I </span><span begin="00:40.490" end="00:41.360">not </span><span begin="00:41.360" end="00:42.170">tell </span><span begin="00:42.170" end="00:42.650">you </span><span begin="00:42.650" end="00:43.160">that </span><span begin="00:43.160" end="00:43.820">I'm </span><span begin="00:43.820" end="00:44.300">not </span><span begin="00:44.300" end="00:44.720">like </span><span begin="00:44.720" end="00:45.470">that</span></p><p ttm:agent="v1" begin="00:45.500" end="00:52.520"><span begin="00:45.500" end="00:46.040">Girls </span><span begin="00:46.040" end="00:46.370">the </span><span begin="00:46.370" end="00:47.150">one </span><span begin="00:47.150" end="00:48.440">who </span><span begin="00:48.440" end="00:48.800">gives </span><span begin="00:48.800" end="00:49.010">it </span><span begin="00:49.010" end="00:49.820">all </span><span begin="00:49.820" end="00:52.520">away</span></p><p ttm:agent="v1" begin="00:53.870" end="01:00.500"><span begin="00:53.870" end="00:54.170">Did </span><span begin="00:54.170" end="00:54.290">you </span><span begin="00:54.290" end="00:54.560">think </span><span begin="00:54.560" end="00:54.830">that </span><span begin="00:54.830" end="00:54.950">I </span><span begin="00:54.950" end="00:55.160">was </span><span begin="00:55.160" end="00:55.580">gonna </span><span begin="00:55.580" end="00:55.850">give </span><span begin="00:55.850" end="00:56.060">it </span><span begin="00:56.060" end="00:56.210">up </span><span begin="00:56.210" end="00:56.330">to </span><span begin="00:56.330" end="00:57.740">you</span><span begin="00:57.740" end="00:58.070">, </span><span begin="00:58.070" end="00:58.490">this </span><span begin="00:58.490" end="01:00.500">time</span></p><p ttm:agent="v1" begin="01:00.530" end="01:07.190"><span begin="01:00.530" end="01:00.830">Did </span><span begin="01:00.830" end="01:00.950">you </span><span begin="01:00.950" end="01:01.220">think </span><span begin="01:01.220" end="01:01.490">that </span><span begin="01:01.490" end="01:01.580">it </span><span begin="01:01.580" end="01:01.760">was </span><span begin="01:01.760" end="01:02.330">somethin' </span><span begin="01:02.330" end="01:02.480">I </span><span begin="01:02.480" end="01:02.660">was </span><span begin="01:02.660" end="01:03.050">gonna </span><span begin="01:03.050" end="01:04.730">do</span><span begin="01:04.730" end="01:04.880">, </span><span begin="01:04.880" end="01:05.120">and </span><span begin="01:05.120" end="01:07.190">cry</span></p><p ttm:agent="v1" begin="01:07.220" end="01:14.870"><span begin="01:07.220" end="01:07.550">Don't </span><span begin="01:07.550" end="01:08.120">try </span><span begin="01:08.120" end="01:08.210">to </span><span begin="01:08.210" end="01:08.900">tell </span><span begin="01:08.900" end="01:09.080">me </span><span begin="01:09.080" end="01:09.770">what </span><span begin="01:09.770" end="01:09.920">to </span><span begin="01:09.920" end="01:10.460">do</span><span begin="01:10.460" end="01:10.520">, </span><span begin="01:10.520" end="01:10.910">don't </span><span begin="01:10.910" end="01:11.480">try </span><span begin="01:11.480" end="01:11.570">to </span><span begin="01:11.570" end="01:12.230">tell </span><span begin="01:12.230" end="01:12.410">me </span><span begin="01:12.410" end="01:13.100">what </span><span begin="01:13.100" end="01:13.190">to </span><span begin="01:13.190" end="01:14.870">say</span></p><p ttm:agent="v1" begin="01:14.900" end="01:18.350"><span begin="01:14.900" end="01:15.110">You're </span><span begin="01:15.110" end="01:15.680">better </span><span begin="01:15.680" end="01:16.160">off </span><span begin="01:16.160" end="01:16.610">that </span><span begin="01:16.610" end="01:18.350">way</span></p><p ttm:agent="v1" begin="01:20.480" end="01:25.640"><span begin="01:20.480" end="01:20.780">Don't </span><span begin="01:20.780" end="01:21.140">think </span><span begin="01:21.140" end="01:21.320">that </span><span begin="01:21.320" end="01:21.500">your </span><span begin="01:21.500" end="01:22.040">charm </span><span begin="01:22.040" end="01:22.250">and </span><span begin="01:22.250" end="01:22.370">the </span><span begin="01:22.370" end="01:22.820">fact </span><span begin="01:22.820" end="01:23.000">that </span><span begin="01:23.000" end="01:23.270">your </span><span begin="01:23.270" end="01:23.750">arm </span><span begin="01:23.750" end="01:23.900">is </span><span begin="01:23.900" end="01:24.200">now </span><span begin="01:24.200" end="01:24.560">around </span><span begin="01:24.560" end="01:24.800">my </span><span begin="01:24.800" end="01:25.640">neck</span></p><p ttm:agent="v1" begin="01:26.990" end="01:32.330"><span begin="01:26.990" end="01:27.140">Will </span><span begin="01:27.140" end="01:27.470">get </span><span begin="01:27.470" end="01:27.650">you </span><span begin="01:27.650" end="01:27.830">in </span><span begin="01:27.830" end="01:28.160">my </span><span begin="01:28.160" end="01:28.730">pants</span><span begin="01:28.730" end="01:28.730">, </span><span begin="01:28.730" end="01:29.000">I'll </span><span begin="01:29.000" end="01:29.090">have </span><span begin="01:29.090" end="01:29.210">to </span><span begin="01:29.210" end="01:29.570">kick </span><span begin="01:29.570" end="01:29.900">your </span><span begin="01:29.900" end="01:30.410">ass </span><span begin="01:30.410" end="01:30.500">and </span><span begin="01:30.500" end="01:30.800">make </span><span begin="01:30.800" end="01:30.920">you </span><span begin="01:30.920" end="01:31.340">never </span><span begin="01:31.340" end="01:32.330">forget</span></p><p ttm:agent="v1" begin="01:33.620" end="01:40.490"><span begin="01:33.620" end="01:33.830">I'm </span><span begin="01:33.830" end="01:34.280">gonna </span><span begin="01:34.280" end="01:34.580">ask </span><span begin="01:34.580" end="01:34.730">you </span><span begin="01:34.730" end="01:34.790">to </span><span begin="01:34.790" end="01:35.480">stop</span><span begin="01:35.480" end="01:35.480">, </span><span begin="01:35.480" end="01:35.810">thought </span><span begin="01:35.810" end="01:35.930">I </span><span begin="01:35.930" end="01:36.230">liked </span><span begin="01:36.230" end="01:36.440">you </span><span begin="01:36.440" end="01:36.560">a </span><span begin="01:36.560" end="01:36.980">lot</span><span begin="01:36.980" end="01:36.980">, </span><span begin="01:36.980" end="01:37.400">but </span><span begin="01:37.400" end="01:37.610">i'm </span><span begin="01:37.610" end="01:37.910">really </span><span begin="01:37.910" end="01:38.810">upset</span><span begin="01:38.810" end="01:38.810">,</span><span begin="01:38.810" end="01:39.590">really </span><span begin="01:39.590" end="01:40.280">upset</span><span begin="01:40.280" end="01:40.490">.</span></p><p ttm:agent="v1" begin="01:40.490" end="01:45.680"><span begin="01:40.490" end="01:40.820">Get </span><span begin="01:40.820" end="01:41.270">outta </span><span begin="01:41.270" end="01:41.570">my </span><span begin="01:41.570" end="01:42.110">head</span><span begin="01:42.110" end="01:42.140">, </span><span begin="01:42.140" end="01:42.470">get </span><span begin="01:42.470" end="01:42.890">off </span><span begin="01:42.890" end="01:42.980">of </span><span begin="01:42.980" end="01:43.250">my </span><span begin="01:43.250" end="01:43.640">bed</span><span begin="01:43.640" end="01:43.640">, </span><span begin="01:43.640" end="01:44.030">yeah </span><span begin="01:44.030" end="01:44.270">that's </span><span begin="01:44.270" end="01:44.540">what </span><span begin="01:44.540" end="01:44.720">I </span><span begin="01:44.720" end="01:45.680">said</span></p><p ttm:agent="v1" begin="01:45.890" end="01:52.070"><span begin="01:45.890" end="01:46.490">Did </span><span begin="01:46.490" end="01:47.090">I </span><span begin="01:47.090" end="01:47.990">not </span><span begin="01:47.990" end="01:48.770">tell </span><span begin="01:48.770" end="01:49.250">you </span><span begin="01:49.250" end="01:49.790">that </span><span begin="01:49.790" end="01:50.420">I'm </span><span begin="01:50.420" end="01:50.930">not </span><span begin="01:50.930" end="01:51.350">like </span><span begin="01:51.350" end="01:52.070">that</span></p><p ttm:agent="v1" begin="01:52.100" end="01:58.700"><span begin="01:52.100" end="01:52.580">Girl </span><span begin="01:52.580" end="01:53.000">the </span><span begin="01:53.000" end="01:53.750">one </span><span begin="01:53.750" end="01:54.620">who </span><span begin="01:54.620" end="01:55.400">throws </span><span begin="01:55.400" end="01:55.580">it </span><span begin="01:55.580" end="01:56.240">all </span><span begin="01:56.240" end="01:58.700">away</span></p><p ttm:agent="v1" begin="02:00.440" end="02:07.160"><span begin="02:00.440" end="02:00.770">Did </span><span begin="02:00.770" end="02:00.920">you </span><span begin="02:00.920" end="02:01.190">think </span><span begin="02:01.190" end="02:01.430">that </span><span begin="02:01.430" end="02:01.580">I </span><span begin="02:01.580" end="02:01.790">was </span><span begin="02:01.790" end="02:02.180">gonna </span><span begin="02:02.180" end="02:02.480">give </span><span begin="02:02.480" end="02:02.690">it </span><span begin="02:02.690" end="02:02.810">up </span><span begin="02:02.810" end="02:02.960">to </span><span begin="02:02.960" end="02:04.340">you</spa