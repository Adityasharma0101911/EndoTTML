<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>lust to love</ttm:title><ttm:agent type="person" xml:id="v1">renforshort</ttm:agent><ttm:item type="album">off saint dominique EP</ttm:item><ttm:item type="spotify_id">6cOELYSuqe3OjJ1qjjIlqz</ttm:item><itunes:duration>03:09.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:08.217" end="00:11.601"><span begin="00:08.217" end="00:08.649">I </span><span begin="00:08.649" end="00:09.113">can't </span><span begin="00:09.113" end="00:09.601">get </span><span begin="00:09.601" end="00:10.505">over </span><span begin="00:10.505" end="00:11.601">something</span></p><p ttm:agent="v1" begin="00:11.993" end="00:15.009"><span begin="00:11.993" end="00:12.865">Something </span><span begin="00:12.865" end="00:13.273">I </span><span begin="00:13.273" end="00:13.785">can't </span><span begin="00:13.785" end="00:15.009">explain</span></p><p ttm:agent="v1" begin="00:15.673" end="00:19.105"><span begin="00:15.673" end="00:16.113">My </span><span begin="00:16.113" end="00:16.649">heart </span><span begin="00:16.649" end="00:17.105">is </span><span begin="00:17.105" end="00:19.105">overflowing</span></p><p ttm:agent="v1" begin="00:19.457" end="00:22.417"><span begin="00:19.457" end="00:19.857">Don't </span><span begin="00:19.857" end="00:20.337">let </span><span begin="00:20.337" end="00:20.833">it </span><span begin="00:20.833" end="00:21.337">wash </span><span begin="00:21.337" end="00:22.417">away</span></p><p ttm:agent="v1" begin="00:22.839" end="00:26.079"><span begin="00:22.839" end="00:23.071">Please </span><span begin="00:23.071" end="00:23.295">just </span><span begin="00:23.295" end="00:23.527">let </span><span begin="00:23.527" end="00:23.759">me </span><span begin="00:23.759" end="00:23.983">sweep </span><span begin="00:23.983" end="00:24.215">you </span><span begin="00:24.215" end="00:24.415">off </span><span begin="00:24.415" end="00:24.711">your </span><span begin="00:24.711" end="00:26.079">feet</span></p><p ttm:agent="v1" begin="00:26.911" end="00:28.903"><span begin="00:26.911" end="00:27.183">Don't </span><span begin="00:27.183" end="00:27.479">you </span><span begin="00:27.479" end="00:27.719">leave </span><span begin="00:27.719" end="00:28.031">me </span><span begin="00:28.031" end="00:28.903">alone</span></p><p ttm:agent="v1" begin="00:30.447" end="00:33.687"><span begin="00:30.447" end="00:30.695">Tell </span><span begin="00:30.695" end="00:30.927">me </span><span begin="00:30.927" end="00:31.143">I'm </span><span begin="00:31.143" end="00:31.391">the </span><span begin="00:31.391" end="00:31.671">only </span><span begin="00:31.671" end="00:31.927">one </span><span begin="00:31.927" end="00:32.207">you </span><span begin="00:32.207" end="00:33.687">need</span></p><p ttm:agent="v1" begin="00:34.255" end="00:36.407"><span begin="00:34.255" end="00:34.575">And </span><span begin="00:34.575" end="00:34.871">I'll </span><span begin="00:34.871" end="00:35.296">never </span><span begin="00:35.296" end="00:35.655">let </span><span begin="00:35.655" end="00:36.407">go</span></p><p ttm:agent="v1" begin="00:37.839" end="00:42.119"><span begin="00:37.839" end="00:38.831">Falling </span><span begin="00:38.831" end="00:39.215">out </span><span begin="00:39.215" end="00:39.503">of </span><span begin="00:39.503" end="00:40.327">lust </span><span begin="00:40.327" end="00:40.663">and </span><span begin="00:40.663" end="00:41.023">into </span><span begin="00:41.023" end="00:42.119">love</span></p><p ttm:agent="v1" begin="00:42.359" end="00:45.223"><span begin="00:42.359" end="00:42.671">With </span><span begin="00:42.671" end="00:43.151">every </span><span begin="00:43.151" end="00:43.567">inch </span><span begin="00:43.567" end="00:43.999">of </span><span begin="00:43.999" end="00:44.327">your </span><span begin="00:44.327" end="00:45.223">body</span></p><p ttm:agent="v1" begin="00:45.223" end="00:49.703"><span begin="00:45.223" end="00:46.375">Started </span><span begin="00:46.375" end="00:46.695">as </span><span begin="00:46.695" end="00:47.087">a </span><span begin="00:47.087" end="00:47.727">crush </span><span begin="00:47.727" end="00:48.071">but </span><span begin="00:48.071" end="00:48.391">now </span><span begin="00:48.391" end="00:48.807">I'm </span><span begin="00:48.807" end="00:49.703">stuck</span></p><p ttm:agent="v1" begin="00:49.927" end="00:52.999"><span begin="00:49.927" end="00:50.271">And </span><span begin="00:50.271" end="00:50.631">I </span><span begin="00:50.631" end="00:51.023">want </span><span begin="00:51.023" end="00:51.487">you </span><span begin="00:51.487" end="00:51.791">to </span><span begin="00:51.791" end="00:52.191">want </span><span begin="00:52.191" end="00:52.999">me</span></p><p ttm:agent="v1" begin="00:52.999" end="00:56.295"><span begin="00:52.999" end="00:53.455">Every </span><span begin="00:53.455" end="00:53.887">time </span><span begin="00:53.887" end="00:54.191">I </span><span begin="00:54.191" end="00:54.471">get </span><span begin="00:54.471" end="00:54.759">to </span><span begin="00:54.759" end="00:55.327">touch </span><span begin="00:55.327" end="00:56.295">you</span></p><p ttm:agent="v1" begin="00:56.295" end="01:00.136"><span begin="00:56.295" end="00:56.767">I </span><span begin="00:56.767" end="00:57.135">just </span><span begin="00:57.135" end="00:57.463">want </span><span begin="00:57.463" end="00:57.815">so </span><span begin="00:57.815" end="00:58.159">much </span><span begin="00:58.159" end="00:58.479">more </span><span begin="00:58.479" end="00:59.191">of </span><span begin="00:59.191" end="01:00.136">you</span></p><p ttm:agent="v1" begin="01:00.136" end="01:04.872"><span begin="01:00.136" end="01:01.624">I </span><span begin="01:01.624" end="01:02.072">can't </span><span begin="01:02.072" end="01:03.024">stop </span><span begin="01:03.024" end="01:03.688">falling </span><span begin="01:03.688" end="01:03.960">out </span><span begin="01:03.960" end="01:04.360">of </span><span begin="01:04.360" end="01:04.872">lust</span></p><p ttm:agent="v1" begin="01:05.144" end="01:07.800"><span begin="01:05.144" end="01:05.456">Falling </span><span begin="01:05.456" end="01:05.688">into </span><span begin="01:05.688" end="01:06.328">love </span><span begin="01:06.328" end="01:06.736">love </span><span begin="01:06.736" end="01:07.200">love </span><span begin="01:07.200" end="01:07.800">love</span></p><p ttm:agent="v1" begin="01:23.128" end="01:26.576"><span begin="01:23.128" end="01:23.584">I </span><span begin="01:23.584" end="01:24.168">want </span><span begin="01:24.168" end="01:24.592">to </span><span begin="01:24.592" end="01:25.032">breathe </span><span begin="01:25.032" end="01:25.416">you </span><span begin="01:25.416" end="01:25.792">in </span><span begin="01:25.792" end="01:26.576">and</span></p><p ttm:agent="v1" begin="01:26.920" end="01:29.496"><span begin="01:26.920" end="01:27.408">Fill </span><span begin="01:27.408" end="01:27.912">up </span><span begin="01:27.912" end="01:28.392">my </span><span begin="01:28.392" end="01:29.496">lungs</span></p><p ttm:agent="v1" begin="01:30.632" end="01:33.976"><span begin="01:30.632" end="01:31.112">With </span><span begin="01:31.112" end="01:31.576">you </span><span begin="01:31.576" end="01:32.040">it's </span><span begin="01:32.040" end="01:32.616">all </span><span begin="01:32.616" end="01:33.064">or </span><span begin="01:33.064" end="01:33.976">nothing</span></p><p ttm:agent="v1" begin="01:34.424" end="01:36.608"><span begin="01:34.424" end="01:34.824">How </span><span begin="01:34.824" end="01:35.336">far </span><span begin="01:35.336" end="01:35.880">we've </span><span begin="01:35.880" end="01:36.608">come</span></p><p ttm:agent="v1" begin="01:37.714" end="01:41.026"><span begin="01:37.714" end="01:37.962">Please </span><span begin="01:37.962" end="01:38.202">just </span><span begin="01:38.202" end="01:38.450">let </span><span begin="01:38.450" end="01:38.682">me </span><span begin="01:38.682" end="01:38.930">sweep </span><span begin="01:38.930" end="01:39.186">you </span><span begin="01:39.186" end="01:39.498">off </span><span begin="01:39.498" end="01:39.754">your </span><span begin="01:39.754" end="01:41.026">feet</span></p><p ttm:agent="v1" begin="01:41.921" end="01:44.017"><span begin="01:41.921" end="01:42.193">Don't </span><span begin="01:42.193" end="01:42.497">you </span><span begin="01:42.497" end="01:42.817">leave </span><span begin="01:42.817" end="01:43.161">me </span><span begin="01:43.161" end="01:44.017">alone</span></p><p ttm:agent="v1" begin="01:45.241" end="01:48.649"><span begin="01:45.241" end="01:45.529">Tell </span><span begin="01:45.529" end="01:45.809">me </span><span begin="01:45.809" end="01:46.041">I'm </span><span begin="01:46.041" end="01:46.337">the </span><span begin="01:46.337" end="01:46.713">only </span><span begin="01:46.713" end="01:46.969">one </span><span begin="01:46.969" end="01:47.289">you </span><span begin="01:47.289" end="01:48.649">need</span></p><p ttm:agent="v1" begin="01:49.265" end="01:51.385"><span begin="01:49.265" end="01:49.569">And </span><span begin="01:49.569" end="01:49.961">I'll </span><span begin="01:49.961" end="01:50.337">never </span><span begin="01:50.337" end="01:50.713">let </span><span begin="01:50.713" end="01:51.385">go</span></p><p ttm:agent="v1" begin="01:52.857" en