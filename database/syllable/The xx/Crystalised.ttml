46.880" end="00:49.400">paradise</span></p><p ttm:agent="v1" begin="00:49.820" end="00:52.820"><span begin="00:49.820" end="00:50.120">I'll </span><span begin="00:50.120" end="00:51.170">forgive </span><span begin="00:51.170" end="00:51.410">and </span><span begin="00:51.410" end="00:52.820">forget</span></p><p ttm:agent="v1" begin="00:53.420" end="00:57.200"><span begin="00:53.420" end="00:54.020">Before </span><span begin="00:54.020" end="00:54.440">I'm </span><span begin="00:54.440" end="00:57.200">paralyzed</span></p><p ttm:agent="v1" begin="00:57.560" end="01:01.160"><span begin="00:57.560" end="00:58.160">Do </span><span begin="00:58.160" end="00:58.520">I </span><span begin="00:58.520" end="00:58.940">have </span><span begin="00:58.940" end="00:59.270">to </span><span begin="00:59.270" end="00:59.630">keep </span><span begin="00:59.630" end="00:59.870">up </span><span begin="00:59.870" end="01:00.260">the </span><span begin="01:00.260" end="01:01.160">pace</span></p><p ttm:agent="v1" begin="01:02.150" end="01:05.000"><span begin="01:02.150" end="01:02.480">To </span><span begin="01:02.480" end="01:02.990">keep </span><span begin="01:02.990" end="01:03.320">you </span><span begin="01:03.320" end="01:05.000">satisfied</span></p><p ttm:agent="v1" begin="01:06.380" end="01:09.200"><span begin="01:06.380" end="01:06.800">Things </span><span begin="01:06.800" end="01:06.920">have </span><span begin="01:06.920" end="01:07.430">gotten </span><span begin="01:07.430" end="01:07.880">closer </span><span begin="01:07.880" end="01:08.180">to </span><span begin="01:08.180" end="01:08.510">the </span><span begin="01:08.510" end="01:09.200">sun</span></p><p ttm:agent="v1" begin="01:09.620" end="01:13.340"><span begin="01:09.620" end="01:09.920">And </span><span begin="01:09.920" end="01:10.370">I've </span><span begin="01:10.370" end="01:10.790">done </span><span begin="01:10.790" end="01:11.390">things </span><span begin="01:11.390" end="01:11.540">in </span><span begin="01:11.540" end="01:12.050">small </span><span begin="01:12.050" end="01:13.340">doses</span></p><p ttm:agent="v1" begin="01:13.460" end="01:17.000"><span begin="01:13.460" end="01:13.820">So </span><span begin="01:13.820" end="01:14.210">don't </span><span begin="01:14.210" end="01:14.750">think </span><span begin="01:14.750" end="01:15.080">that </span><span begin="01:15.080" end="01:15.260">I'm </span><span begin="01:15.260" end="01:15.770">pushing </span><span begin="01:15.770" end="01:16.160">you </span><span begin="01:16.160" end="01:17.000">away</span></p><p ttm:agent="v1" begin="01:17.390" end="01:20.750"><span begin="01:17.390" end="01:17.690">When </span><span begin="01:17.690" end="01:17.900">you're </span><span begin="01:17.900" end="01:18.140">the </span><span begin="01:18.140" end="01:18.650">one </span><span begin="01:18.650" end="01:19.190">that </span><span begin="01:19.190" end="01:19.430">I've </span><span begin="01:19.430" end="01:19.820">kept </span><span begin="01:19.820" end="01:20.750">closest</span></p><p ttm:agent="v1" begin="01:36.860" end="01:39.290"><span begin="01:36.860" end="01:37.130">You </span><span begin="01:37.130" end="01:37.700">don't </span><span begin="01:37.700" end="01:38.240">move </span><span begin="01:38.240" end="01:39.290">slow</span></p><p ttm:agent="v1" begin="01:41.030" end="01:44.360"><span begin="01:41.030" end="01:41.480">Taking </span><span begin="01:41.480" end="01:42.140">steps </span><span begin="01:42.140" end="01:42.470">in </span><span begin="01:42.470" end="01:42.770">my </span><span begin="01:42.770" end="01:44.360">directions</span></p><p ttm:agent="v1" begin="01:44.690" end="01:48.440"><span begin="01:44.690" end="01:44.870">The </span><span begin="01:44.870" end="01:45.260">sound </span><span begin="01:45.260" end="01:46.520">resounds</span><span begin="01:46.520" end="01:46.520">, </span><span begin="01:46.520" end="01:48.440">echo</span></p><p ttm:agent="v1" begin="01:48.800" end="01:51.920"><span begi