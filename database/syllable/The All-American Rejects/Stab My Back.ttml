<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Stab My Back</ttm:title><ttm:agent type="person" xml:id="v1">The All-American Rejects</ttm:agent><ttm:item type="album">Move Along</ttm:item><ttm:item type="spotify_id">2J3Xg9ZFv76G0aIqeio51R</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:11.480" end="00:15.080"><span begin="00:11.480" end="00:11.990">Now </span><span begin="00:11.990" end="00:12.290">we're </span><span begin="00:12.290" end="00:13.340">broken </span><span begin="00:13.340" end="00:13.700">on </span><span begin="00:13.700" end="00:14.000">the </span><span begin="00:14.000" end="00:15.080">floor</span></p><p ttm:agent="v1" begin="00:15.110" end="00:18.650"><span begin="00:15.110" end="00:15.620">She </span><span begin="00:15.620" end="00:16.160">just </span><span begin="00:16.160" end="00:16.580">wants </span><span begin="00:16.580" end="00:16.910">me </span><span begin="00:16.910" end="00:17.330">to </span><span begin="00:17.330" end="00:17.930">share </span><span begin="00:17.930" end="00:18.650">her</span></p><p ttm:agent="v1" begin="00:18.650" end="00:22.100"><span begin="00:18.650" end="00:18.830">It </span><span begin="00:18.830" end="00:19.430">hasn't </span><span begin="00:19.430" end="00:19.910">been </span><span begin="00:19.910" end="00:20.330">this </span><span begin="00:20.330" end="00:20.750">way </span><span begin="00:20.750" end="00:22.100">before</span></p><p ttm:agent="v1" begin="00:22.130" end="00:26.060"><span begin="00:22.130" end="00:22.670">She </span><span begin="00:22.670" end="00:23.210">just </span><span begin="00:23.210" end="00:23.660">wants </span><span begin="00:23.660" end="00:23.990">me </span><span begin="00:23.990" end="00:24.440">to </span><span begin="00:24.440" end="00:25.760">dare </span><span begin="00:25.760" end="00:26.060">her</span></p><p ttm:agent="v1" begin="00:26.150" end="00:28.760"><span begin="00:26.150" end="00:26.600">The </span><span begin="00:26.600" end="00:27.410">phone </span><span begin="00:27.410" end="00:28.760">rings</span></p><p ttm:agent="v1" begin="00:29.810" end="00:31.820"><span begin="00:29.810" end="00:30.170">And </span><span begin="00:30.170" end="00:30.800">she </span><span begin="00:30.800" end="00:31.820">screams</span></p><p ttm:agent="v1" begin="00:31.850" end="00:34.790"><span begin="00:31.850" end="00:32.870">Stab </span><span begin="00:32.870" end="00:33.740">my </span><span begin="00:33.740" end="00:34.790">back</span></p><p ttm:agent="v1" begin="00:34.790" end="00:38.270"><span begin="00:34.790" end="00:35.600">It's </span><span begin="00:35.600" end="00:35.990">better </span><span begin="00:35.990" end="00:36.320">when </span><span begin="00:36.320" end="00:36.440">I </span><span begin="00:36.440" end="00:36.830">bleed </span><span begin="00:36.830" end="00:37.040">for </span><span begin="00:37.040" end="00:38.270">you</span></p><p ttm:agent="v1" begin="00:38.870" end="00:41.840"><span begin="00:38.870" end="00:39.050">You </span><span begin="00:39.050" end="00:40.100">walk </span><span begin="00:40.100" end="00:40.820">on </span><span begin="00:40.820" end="00:41.840">me</span></p><p ttm:agent="v1" begin="00:41.840" end="00:45.830"><span begin="00:41.840" end="00:42.560">It </span><span begin="00:42.560" end="00:43.040">never </span><span begin="00:43.040" end="00:43.400">was </span><span begin="00:43.400" end="00:43.970">enough </span><span begin="00:43.970" end="00:44.150">to </span><span begin="00:44.150" end="00:45.830">do</span></p><p ttm:agent="v1" begin="00:45.920" end="00:49.610"><span begin="00:45.920" end="00:46.070">I </span><span begin="00:46.070" end="00:47.030">can't </span><span begin="00:47.030" end="00:47.960">get </span><span begin="00:47.960" end="00:48.890">past </span><span begin="00:48.890" end="00:49.610">her</span></p><p ttm:agent="v1" begin="00:49.610" end="00:52.430"><span begin="00:49.610" end="00:51.440">Falling </span><span begin="00:51.440" end="00:52.430">fast</span></p><p ttm:agent="v1" begin="00:52.910" end="00:54.380"><span begin="00:52.910" end="00:53.645">It's </span><span begin="00:53.645" end="00:54.380">true</span></p><p ttm:agent="v1" begin="00:54.770" end="00:58.160"><span begin="00:54.770" end="00:55.040">It </span><span begin="00:55.040" end="00:55.430">hasn't </span><span begin="00:55.430" end="00:55.790">done </span><span begin="00:55.790" end="00:55.850">a </span><span begin="00:55.850" end="00:56.240">lot </span><span begin="00:56.240" end="00:56.480">for </span><span begin="00:56.480" end="00:58.160">you</span></p><p ttm:agent="v1" begin="01:01.010" end="01:04.670"><span begin="01:01.010" end="01:01.250">And </span><span begin="01:01.250" end="01:01.760">every </span><span begin="01:01.760" end="01:02.360">time </span><span begin="01:02.360" end="01:02.690">he </span><span begin="01:02.690" end="01:03.170">held </span><span begin="01:03.170" end="01:03.500">you </span><span begin="01:03.500" end="01:04.670">close</span></p><p ttm:agent="v1" begin="01:04.700" end="01:08.120"><span begin="01:04.700" end="01:05.120">Yeah</span><span begin="01:05.120" end="01:05.120">, </span><span begin="01:05.120" end="01:05.570">were </span><span begin="01:05.570" end="01:05.960">you </span><span begin="01:05.960" end="01:06.890">thinking </span><span begin="01:06.890" end="01:07.400">of </span><span begin="01:07.400" end="01:08.120">me</span></p><p ttm:agent="v1" begin="01:08.120" end="01:11.750"><span begin="01:08.120" end="01:08.600">When </span><span begin="01:08.600" end="01:08.810">I </span><span begin="01:08.810" end="01:09.740">needed </span><span begin="01:09.740" end="01:10.250">you </span><span begin="01:10.250" end="01:10.580">the </span><span begin="01:10.580" end="01:11.750">most</span></p><p ttm:agent="v1" begin="01:11.780" end="01:15.500"><span begin="01:11.780" end="01:12.260">Well </span><span begin="01:12.260" end="01:12.620">I </span><span begin="01:12.620" end="01:13.100">hope </span><span begin="01:13.100" end="01:13.520">that </span><span begin="01:13.520" end="01:13.970">you're </span><span begin="01:13.970" end="01:15.500">happy</span></p><p ttm:agent="v1" begin="01:15.530" end="01:18.530"><span begin="01:15.530" end="01:16.100">The </span><span begin="01:16.100" end="01:16.880">phone </span><span begin="01:16.880" end="01:18.530">rings</span></p><p ttm:agent="v1" begin="01:19.430" end="01:21.410"><span begin="01:19.430" end="01:19.640">And </span><span begin="01:19.640" end="01:20.270">she </span><span begin="01:20.270" end="01:21.410">screams</span></p><p ttm:agent="v1" begin="01:21.410" end="01:24.140"><span begin="01:21.410" end="01:22.370">Stab </span><span begin="01:22.370" end="01:23.210">my </span><span begin="01:23.210" end="01:24.140">back</span></p><p ttm:agent="v1" begin="01:24.960" end="01:28.070"><span begin="01:24.960" end="01:25.110">It's </span><span begin="01:25.110" end="01:25.640">better </span><span begin="01:25.640" end="01:25.820">when </span><span begin="01:25.820" end="01:25.910">I </span><span begin="01:25.910" end="01:26.300">bleed </span><span begin="01:26.300" end="01:26.540">for </span><span begin="01:26.540" end="01:28.070">you</span></p><p ttm:agent="v1" begin="01:28.340" end="01:31.310"><span begin="01:28.340" end="01:28.520">You </span><span begin="01:28.520" end="01:29.570">walk </span><span begin="01:29.570" end="01:30.290">on </span><span begin="01:30.290" end="01:31.310">me</span></p><p ttm:agent="v1" begin="01:31.310" end="01:34.640"><span begin="01:31.310" end="01:32.060">It </span><span begin="01:32.060" end="01:32.510">never </span><span begin="01:32.510" end="01:32.900">was </span><span begin="01:32.900" end="01:33.440">enough </span><span begin="01:33.440" end="01:33.620">to </span><span begin="01:33.620" end="01:34.640">do</span></p><p ttm:agent="v1" begin="01:35.420" end="01:39.080"><span begin="01:35.420" end="01:35.570">I </span><span begin="01:35.570" end="01:36.500">can't </span><span begin="01:36.500" end="01:37.460">get </span><span begin="01:37.460" end="01:38.390">past </span><span begin="01:38.390" end="01:39.080">her</span></p><p ttm:agent="v1" begin="01:39.080" end="01:41.900"><span begin="01:39.080" end="01:40.940">Falling </span><span begin="01:40.940" end="01:41.900">fast</span></p><p ttm:agent="v1" begin="01:42.380" end="01:43.850"><span begin="01:42.380" end="01:42.530">It's </span><span begin="01:42.530" end="01:43.850">true</span></p><p ttm:agent="v1" begin="01:44.240" end="01:46.580"><span begin="01:44.240" end="01:44.510">It's </span><span begin="01:44.510" end="01:44.900">better </span><span begin="01:44.900" end="01:45.230">when </span><span begin="01:45.230" end="01:45.320">I </span><span begin="01:45.320" end="01:45.740">bleed </span><span begin="01:45.740" end="01:45.950">for </span><span begin="01:45.950" end="01:46.580">you</span></p><p ttm:agent="v1" begin="02:11.620" end="02:14.900"><span begin="02:11.620" end="02:11.840">I </span><span begin="02:11.840" end="02:12.320">hope </span><span begin="02:12.320" end="02:12.710">that </span><span begin="02:12.710" end="02:13.280">love </span><span begin="02:13.280" end="02:13.580">he </span><span begin="02:13.580" end="02:14.180">gave </span><span begin="02:14.180" end="02:14.900">you</span></p><p ttm:agent="v1" begin="02:14.900" end="02:17.840"><span begin="02:14.900" end="02:15.410">Was </span><span begin="02:15.410" end="02:15.980">just </span><span begin="02:15.980" end="02:16.760">enough </span><span begin="02:16.760" end="02:17.030">to </span><span begin="02:17.030" end="02:17.690">save </span><span begin="02:17.690" end="02:17.840">you</span></p><p ttm:agent="v1" begin="02:17.840" end="02:21.140"><span begin="02:17.840" end="02:18.920">You </span><span begin="02:18.920" end="02:19.760">nearly </span><span begin="02:19.760" end="02:20.240">broke </span><span begin="02:20.240" end="02:20.720">my </span><span begin="02:20.720" end="02:21.140">heart</span></p><p ttm:agent="v1" begin="02:21.140" end="02:25.820"><span begin="02:21.140" end="02:21.650">Just </span><span begin="02:21.650" end="02:22.130">look </span><span begin="02:22.130" end="02:22.430">at </span><span begin="02:22.430" end="02:22.880">what </span><span begin="02:22.880" end="02:23.330">you're </span><span begin="02:23.330" end="02:24.350">tearing </span><span begin="02:24.350" end="02:25.820">apart</span></p><p ttm:agent="v1" begin="02:28.370" end="02:31.430"><span begin="02:28.370" end="02:29.510">Stab </span><span begin="02:29.510" end="02:30.380">my </span><span begin="02:30.380" end="02:31.430">back</span></p><p ttm:agent="v1" begin="02:31.430" end="02:34.910"><span begin="02:31.430" end="02:32.240">It's </span><span begin="02:32.240" end="02:32.630">better </span><span begin="02:32.630" end="02:32.960">when </span><span begin="02:32.960" end="02:33.080">I </span><span begin="02:33.080" end="02:33.440">bleed </span><span begin="02:33.440" end="02:33.680">for </span><span begin="02:33.680" end="02:34.910">you</span></p><p ttm:agent="v1" begin="02:35.510" end="02:38.480"><span begin="02:35.510" end="02:35.660">You </span><span begin="02:35.660" end="02:36.710">walk </span><span begin="02:36.710" end="02:37.430">on </span><span begin="02:37.430" end="02:38.480">me</span></p><p ttm:agent="v1" begin="02:38.480" end="02:41.990"><span begin="02:38.480" end="02:39.200">It </span><span begin="02:39.200" end="02:39.650">never </span><span begin="02:39.650" end="02:40.040">was </span><span begin="02:40.040" end="02:40.610">enough </span><span begin="02:40.610" end="02:40.790">to </span><span begin="02:40.790" end="02:41.990">do</span></p><p ttm:agent="v1" begin="02:42.530" end="02:46.250"><span begin="02:42.530" end="02:42.710">I </span><span begin="02:42.710" end="02:43.640">can't </span><span begin="02:43.640" end="02:44.600">get </span><span begin="02:44.600" end="02:45.530">past </span><span begin="02:45.530" end="02:46.250">her</span></p><p ttm:agent="v1" begin="02:46.250" end="02:49.100"><span begin="02:46.250" end="02:48.080">Falling </span><span begin="02:48.080" end="02:49.100">fast</span></p><p ttm:agent="v1" begin="02:49.100" end="02:51.020"><span begin="02:49.100" end="02:49.670">It's </span><span begin="02:49.670" end="02:51.020">true</span></p><p ttm:agent="v1" begin="02:51.410" end="02:53.780"><span begin="02:51.410" end="02:51.740">It </span><span begin="02:51.740" end="02:52.130">hasn't </span><span begin="02:52.130" end="02:52.400">done </span><span begin="02:52.400" end="02:52.460">a </span><span begin="02:52.460" end="02:52.880">lot </span><span begin="02:52.880" end="02:53.330">for </span><span begin="02:53.330" end="02:53.780">you</span></p><p ttm:agent="v1" begin="02:53.780" end="02:57.530"><span begin="02:53.780" end="02:53.870">It's </span><span begin="02:53.870" end="02:55.640">better </span><span begin="02:55.640" end="02:55.790">when </span><span begin="02:55.790" end="02:56.090">I </span><span begin="02:56.090" end="02:56.420">bleed </span><span begin="02:56.420" end="02:56.660">for </span><span begin="02:56.660" end="02:57.530">you</span></p><p ttm:agent="v1" begin="02:58.520" end="03:01.850"><span begin="02:58.520" end="02:58.670">It </span><span begin="02:58.670" end="02:59.150">never </span><span begin="02:59.150" end="02:59.480">was </span><span begin="02:59.480" end="03:00.020">enough </span><span begin="03:00.020" end="03:00.200">to </span><span begin="03:00.200" end="03:01.850">do</span></p><p ttm:agent="v1" begin="03:02.030" end="03:04.520"><span begin="03:02.030" end="03:02.180">It </span><span begin="03:02.180" end="03:02.690">hasn't </span><span begin="03:02.690" end="03:02.990">done </span><span begin="03:02.990" end="03:03.080">a </span><span begin="03:03.080" end="03:03.500">lot </span><span begin="03:03.500" end="03:03.770">for </span><span begin="03:03.770" end="03:04.520">you</span></p></div></body></tt>