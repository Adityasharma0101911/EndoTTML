<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>My Blood</ttm:title><ttm:agent type="person" xml:id="v1">Ellie Goulding</ttm:agent><ttm:item type="album">Halcyon</ttm:item><ttm:item type="spotify_id">2XcEaVhx9EDMcEB33D92o8</ttm:item><itunes:duration>03:54.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:11.921" end="00:17.131"><span begin="00:11.921" end="00:12.141">That </span><span begin="00:12.141" end="00:13.051">feeling  </span><span begin="00:13.871" end="00:14.121">that </span><span begin="00:14.121" end="00:14.611">doesn't </span><span begin="00:14.611" end="00:15.091">go </span><span begin="00:15.091" end="00:16.081">away </span><span begin="00:16.081" end="00:16.341">just </span><span begin="00:16.341" end="00:17.131">did</span></p><p ttm:agent="v1" begin="00:17.491" end="00:22.721"><span begin="00:17.491" end="00:17.711">And </span><span begin="00:17.711" end="00:18.021">I </span><span begin="00:18.021" end="00:19.301">walked </span><span begin="00:19.301" end="00:19.561">a </span><span begin="00:19.561" end="00:20.101">thousand </span><span begin="00:20.101" end="00:21.601">miles </span><span begin="00:21.601" end="00:21.991">to </span><span begin="00:21.991" end="00:22.381">prove </span><span begin="00:22.381" end="00:22.721">it</span></p><p ttm:agent="v1" begin="00:22.951" end="00:28.220"><span begin="00:22.951" end="00:23.221">And </span><span begin="00:23.221" end="00:23.841">I'm </span><span begin="00:23.841" end="00:24.700">caught </span><span begin="00:24.700" end="00:24.910">in </span><span begin="00:24.910" end="00:25.290">the </span><span begin="00:25.290" end="00:25.670">crossfire </span><span begin="00:25.670" end="00:26.420">of </span><span begin="00:26.420" end="00:27.050">my </span><span begin="00:27.050" end="00:27.610">own </span><span begin="00:27.610" end="00:28.220">thoughts</span></p><p ttm:agent="v1" begin="00:28.490" end="00:33.300"><span begin="00:28.490" end="00:28.780">The </span><span begin="00:28.780" end="00:29.220">color </span><span begin="00:29.220" end="00:30.180">of </span><span begin="00:30.180" end="00:30.430">my </span><span begin="00:30.430" end="00:31.160">blood </span><span begin="00:31.160" end="00:31.380">is </span><span begin="00:31.380" end="00:31.640">all </span><span begin="00:31.640" end="00:31.930">I </span><span begin="00:31.930" end="00:32.490">see </span><span begin="00:32.490" end="00:32.710">on </span><span begin="00:32.710" end="00:33.000">the </span><span begin="00:33.000" end="00:33.300">rocks</span></p><p ttm:agent="v1" begin="00:33.640" end="00:36.149"><span begin="00:33.640" end="00:33.850">As </span><span begin="00:33.850" end="00:34.609">you </span><span begin="00:34.609" end="00:35.459">sail </span><span begin="00:35.459" end="00:35.699">from </span><span begin="00:35.699" end="00:36.149">me</span></p><p ttm:agent="v1" begin="00:38.559" end="00:43.328"><span begin="00:38.559" end="00:39.938">Alarms </span><span begin="00:39.938" end="00:40.308">will </span><span begin="00:40.308" end="00:41.208">ring </span><span begin="00:41.208" end="00:41.528">for </span><span begin="00:41.528" end="00:43.328">eternity</span></p><p ttm:agent="v1" begin="00:43.858" end="00:49.048"><span begin="00:43.858" end="00:44.198">The </span><span begin="00:44.198" end="00:45.278">waves </span><span begin="00:45.278" end="00:45.558">will </span><span begin="00:45.558" end="00:46.378">break </span><span begin="00:46.378" end="00:47.008">every </span><span begin="00:47.008" end="00:48.048">chain </span><span begin="00:48.048" end="00:48.278">on </span><span begin="00:48.278" end="00:49.048">me</span></p><p ttm:agent="v1" begin="00:49.358" end="00:51.848"><span begin="00:49.358" end="00:49.728">My </span><span begin="00:49.728" end="00:50.898">bones </span><span begin="00:50.898" end="00:51.128">will </span><span begin="00:51.128" end="00:51.848">bleach</span></p><p ttm:agent="v1" begin="00:52.198" end="00:54.718"><span begin="00:52.198" end="00:52.448">My </span><span begin="00:52.448" end="00:53.408">flesh </span><span begin="00:53.408" end="00:53.698">will </span><span begin="00:53.698" end="00:54.718">flee</span></p><p ttm:agent="v1" begin="00:54.998" end="01:02.017"><span begin="00:54.998" end="00:55.278">So </span><span begin="00:55.278" end="00:56.368">help </span><span begin="00:56.368" end="00:56.618">my </span><span begin="00:56.618" end="00:57.788">lifeless </span><span begin="00:57.788" end="00:59.247">frame </span><span begin="00:59.247" end="00:59.457">to </span><span begin="00:59.457" end="01:02.017">breathe</span></p><p ttm:agent="v1" begin="01:02.257" end="01:05.897"><span begin="01:02.257" end="01:02.467">And </span><span begin="01:02.467" end="01:02.767">God </span><span begin="01:02.767" end="01:03.297">knows  </span><span begin="01:03.297" end="01:03.497">I'm </span><span begin="01:03.497" end="01:03.757">not </span><span begin="01:03.757" end="01:04.187">dying </span><span begin="01:04.187" end="01:04.827">but </span><span begin="01:04.827" end="01:05.047">I </span><span begin="01:05.047" end="01:05.577">breathe </span><span begin="01:05.577" end="01:05.897">now</span></p><p ttm:agent="v1" begin="01:06.697" end="01:11.637"><span begin="01:06.697" end="01:06.947">And </span><span begin="01:06.947" end="01:07.357">God </span><span begin="01:07.357" end="01:08.297">knows  </span><span begin="01:08.297" end="01:08.897">it's </span><span begin="01:08.897" end="01:09.257">the </span><span begin="01:09.257" end="01:09.717">only </span><span begin="01:09.717" end="01:10.167">way </span><span begin="01:10.167" end="01:10.407">to </span><span begin="01:10.407" end="01:11.107">heal </span><span begin="01:11.107" end="01:11.637">now</span></p><p ttm:agent="v1" begin="01:12.607" end="01:15.307"><span begin="01:12.607" end="01:12.837">With </span><span begin="01:12.837" end="01:13.097">all </span><span begin="01:13.097" end="01:13.367">the </span><span begin="01:13.367" end="01:13.727">blood </span><span begin="01:13.727" end="01:13.987">I </span><span begin="01:13.987" end="01:14.337">lost </span><span begin="01:14.337" end="01:14.797">for </span><span begin="01:14.797" end="01:15.307">you</span></p><p ttm:agent="v1" begin="01:17.767" end="01:20.737"><span begin="01:17.767" end="01:17.997">It </span><span begin="01:17.997" end="01:18.497">drowns </span><span begin="01:18.497" end="01:18.707">the </span><span begin="01:18.707" end="01:19.217">love </span><span begin="01:19.217" end="01:19.407">I </span><span begin="01:19.407" end="01:19.627">thought </span><span begin="01:19.627" end="01:20.037">I </span><span begin="01:20.037" end="01:20.737">knew</span></p><p ttm:agent="v1" begin="01:23.397" end="01:28.446"><span begin="01:23.397" end="01:23.627">The </span><span begin="01:23.627" end="01:24.337">lost </span><span begin="01:24.337" end="01:25.516">dreams </span><span begin="01:25.516" end="01:25.726">are </span><span begin="01:25.726" end="01:26.226">buried </span><span begin="01:26.226" end="01:26.736">in </span><span begin="01:26.736" end="01:26.976">my </span><span begin="01:26.976" end="01:27.506">sleep </span><span begin="01:27.506" end="01:27.826">for </span><span begin="01:27.826" end="01:28.446">him</span></p><p ttm:agent="v1" begin="01:28.816" end="01:33.646"><span begin="01:28.816" end="01:29.056">And </span><span begin="01:29.056" end="01:29.506">this </span><span begin="01:29.506" end="01:30.976">was </span><span begin="01:30.976" end="01:31.216">the </span><span begin="01:31.216" end="01:31.736">ecstasy </span><span begin="01:31.736" end="01:32.056">of </span><span begin="01:32.056" end="01:32.396">a </span><span begin="01:32.396" end="01:33.046">love </span><span begin="01:33.046" end="01:33.646">forgotten</span></p><p ttm:agent="v1" begin="01:34.296" end="01:39.686"><span begin="01:34.296" end="01:34.556">And </span><span begin="01:34.556" end="01:35.136">I'm </span><span begin="01:35.136" end="01:35.906">thrown </span><span begin="01:35.906" end="01:36.576">in </span><span begin="01:36.576" end="01:36.846">the </span><span begin="01:36.846" end="01:37.756">gunfire </span><span begin="01:37.756" end="01:38.016">of </span><span begin="01:38.016" end="01:38.346">empty </span><span begin="01:38.346" end="01:39.686">bullets</span></p><p ttm:agent="v1" begin="01:40.136" end="01:43.666"><span begin="01:40.136" end="01:40.366">And </span><span begin="01:40.366" end="01:40.646">my </span><span begin="01:40.646" end="01:41.766">blood </span><span begin="01:41.766" end="01:42.176">is </span><span begin="01:42.176" end="01:42.706">all </span><span begin="01:42.706" end="01:43.096">I </span><span begin="01:43.096" end="01:43.666">see</span></p><p ttm:agent="v1" begin="01:43.986" end="01:47.835"><span begin="01:43.986" end="01:44.226">As </span><span begin="01:44.226" end="01:44.656">you </span><span begin="01:44.656" end="01:45.485">steal </span><span begin="01:45.485" end="01:45.935">my </span><span begin="01:45.935" end="01:47.035">soul </span><span begin="01:47.035" end="01:47.435">from </span><span begin="01:47.435" end="01:47.835">me</span></p><p ttm:agent="v1" begin="01:50.325" end="01:55.145"><span begin="01:50.325" end="01:51.705">Alarms </span><span begin="01:51.705" end="01:52.915">will </span><span begin="01:52.915" end="01:53.125">ring </span><span begin="01:53.125" end="01:53.365">for </span><span begin="01:53.365" end="01:55.145">eternity</span></p><p ttm:agent="v1" begin="01:55.815" end="02:01.895"><span begin="01:55.815" end="01:56.035">The </span><span begin="01:56.035" end="01:57.085">waves </span><span begin="01:57.085" end="01:57.315">will </span><span begin="01:57.315" end="01:58.335">break </span><span begin="01:58.335" end="01:58.875">every </span><span begin="01:58.875" end="01:59.835">chain </span><span begin="01:59.835" end="02:00.125">on </span><span begin="02:00.125" end="02:01.895">me</span></p><p ttm:agent="v1" begin="02:02.255" end="02:06.745"><span begin="02:02.255" end="02:02.475">And </span><span begin="02:02.475" end="02:03.135">God </span><span begin="02:03.135" end="02:03.775">knows  </span><span begin="02:03.775" end="02:04.035">I'm </span><span begin="02:04.035" end="02:04.335">not </span><span begin="02:04.335" end="02:04.865">dying </span><span begin="02:04.865" end="02:05.245">but </span><span begin="02:05.245" end="02:05.745">I </span><span begin="02:05.745" end="02:06.425">breathe </span><span begin="02:06.425" end="02:06.745">now</span></p><p ttm:agent="v1" begin="02:07.435" end="02:12.785"><span begin="02:07.435" end="02:07.695">And </span><span begin="02:07.695" end="02:08.335">God </span><span begin="02:08.335" end="02:09.015">knows  </span><span begin="02:09.015" end="02:09.275">it's </span><span begin="02:09.275" end="02:09.705">the </span><span begin="02:09.705" end="02:10.025">only </span><span begin="02:10.025" end="02:10.665">way </span><span begin="02:10.665" end="02:11.105">to </span><span begin="02:11.105" end="02:11.775">heal </span><span begin="02:11.775" end="02:12.785">now</span></p><p ttm:agent="v1" begin="02:13.615" end="02:16.045"><span begin="02:13.615" end="02:13.845">With </span><span begin="02:13.845" end="02:14.075">all </span><span begin="02:14.075" end="02:14.345">the </span><span begin="02:14.345" end="02:14.605">blood </span><span begin="02:14.605" end="02:14.855">I </span><span begin="02:14.855" end="02:15.185">lost </span><span begin="02:15.185" end="02:15.445">for </span><span begin="02:15.445" end="02:16.045">you</span></p><p ttm:agent="v1" begin="02:18.455" end="02:21.864"><span begin="02:18.455" end="02:18.715">It </span><span begin="02:18.715" end="02:19.145">drowns </span><span begin="02:19.145" end="02:19.395">the </span><span begin="02:19.395" end="02:19.705">love </span><span begin="02:19.705" end="02:20.095">I </span><span begin="02:20.095" end="02:20.415">thought </span><span begin="02:20.415" end="02:20.775">I </span><span begin="02:20.775" end="02:21.864">knew</span></p><p ttm:agent="v1" begin="02:26.034" end="02:57.380"><span begin="02:26.034" end="02:57.380">Oooh  </span></p><p ttm:agent="v1" begin="02:57.630" end="03:01.890"><span begin="02:57.630" end="02:57.890">And </span><span begin="02:57.890" end="02:58.210">God </span><span begin="02:58.210" end="02:58.880">knows  </span><span begin="02:58.880" end="02:59.100">I'm </span><span begin="02:59.100" end="02:59.420">not </span><span begin="02:59.420" end="03:00.100">dying </span><span begin="03:00.100" end="03:00.370">but </span><span begin="03:00.370" end="03:00.730">I </span><span begin="03:00.730" end="03:01.400">breathe </span><span begin="03:01.400" end="03:01.890">now</span></p><p ttm:agent="v1" begin="03:02.520" end="03:07.570"><span begin="03:02.520" end="03:02.830">And </span><span begin="03:02.830" end="03:03.470">God </span><span begin="03:03.470" end="03:04.170">knows  </span><span begin="03:04.170" end="03:04.620">it's </span><span begin="03:04.620" end="03:04.950">the </span><span begin="03:04.950" end="03:05.490">only </span><span begin="03:05.490" end="03:05.850">way </span><span begin="03:05.850" end="03:06.230">to </span><span begin="03:06.230" end="03:06.940">heal </span><span begin="03:06.940" end="03:07.570">now</span></p><p ttm:agent="v1" begin="03:08.180" end="03:10.880"><span begin="03:08.180" end="03:08.420">With </span><span begin="03:08.420" end="03:08.740">all </span><span begin="03:08.740" end="03:09.030">the </span><span begin="03:09.030" end="03:09.590">blood </span><span begin="03:09.590" end="03:09.830">I </span><span begin="03:09.830" end="03:10.040">lost </span><span begin="03:10.040" end="03:10.350">for </span><span begin="03:10.350" end="03:10.880">you</span></p><p ttm:agent="v1" begin="03:13.590" end="03:16.840"><span begin="03:13.590" end="03:13.860">It </span><span begin="03:13.860" end="03:14.280">drowns </span><span begin="03:14.280" end="03:14.580">the </span><span begin="03:14.580" end="03:15.080">love </span><span begin="03:15.080" end="03:15.350">I </span><span begin="03:15.350" end="03:15.630">thought </span><span begin="03:15.630" end="03:15.930">I </span><span begin="03:15.930" end="03:16.840">knew</span></p><p ttm:agent="v1" begin="03:19.200" end="03:24.180"><span begin="03:19.200" end="03:19.420">And </span><span begin="03:19.420" end="03:19.860">God </span><span begin="03:19.860" end="03:20.910">knows  </span><span begin="03:20.910" end="03:21.310">I'm </span><span begin="03:21.310" end="03:21.560">not </span><span begin="03:21.560" end="03:22.140">dying </span><span begin="03:22.140" end="03:22.430">but </span><span begin="03:22.430" end="03:22.750">I </span><span begin="03:22.750" end="03:23.460">breathe </span><span begin="03:23.460" end="03:24.180">now</span></p><p ttm:agent="v1" begin="03:24.630" end="03:29.690"><span begin="03:24.630" end="03:24.910">And </span><span begin="03:24.910" end="03:25.580">God </span><span begin="03:25.580" end="03:26.240">knows  </span><span begin="03:26.240" end="03:26.560">it's </span><span begin="03:26.560" end="03:26.920">the </span><span begin="03:26.920" end="03:27.690">only </span><span begin="03:27.690" end="03:27.990">way </span><span begin="03:27.990" end="03:28.350">to </span><span begin="03:28.350" end="03:29.000">heal </span><span begin="03:29.000" end="03:29.690">now</span></p><p ttm:agent="v1" begin="03:30.390" end="03:35.880"><span begin="03:30.390" end="03:30.650">With </span><span begin="03:30.650" end="03:30.890">all </span><span begin="03:30.890" end="03:31.150">the </span><span begin="03:31.150" end="03:31.460">blood </span><span begin="03:31.460" end="03:31.770">I </span><span begin="03:31.770" end="03:32.100">lost </span><span begin="03:32.100" end="03:32.440">for </span><span begin="03:32.440" end="03:35.880">you</span></p><p ttm:agent="v1" begin="03:36.140" end="03:38.700"><span begin="03:36.140" end="03:36.360">It </span><span begin="03:36.360" end="03:36.700">drowns </span><span begin="03:36.700" end="03:36.960">the </span><span begin="03:36.960" end="03:37.190">love </span><span begin="03:37.190" end="03:37.440">I </span><span begin="03:37.440" end="03:37.670">thought </span><span begin="03:37.670" end="03:38.010">I </span><span begin="03:38.010" end="03:38.700">knew</span></p></div></body></tt>