3.210">But </span><span begin="00:33.210" end="00:33.419">just </span><span begin="00:33.419" end="00:33.658">in </span><span begin="00:33.658" end="00:33.915">case </span><span begin="00:33.915" end="00:34.187">you </span><span begin="00:34.187" end="00:35.002">miss </span><span begin="00:35.002" end="00:35.179">the </span><span begin="00:35.179" end="00:35.403">way </span><span begin="00:35.403" end="00:35.675">I </span><span begin="00:35.675" end="00:36.140">smell</span></p><p ttm:agent="v1" begin="00:36.173" end="00:37.021"><span begin="00:36.173" end="00:36.620">Smell</span></p><p ttm:agent="v1" begin="00:37.021" end="00:39.888"><span begin="00:37.021" end="00:37.165">It'll </span><span begin="00:37.165" end="00:37.357">just </span><span begin="00:37.357" end="00:37.597">be </span><span begin="00:37.597" end="00:38.333">there</span></p><p ttm:agent="v1" begin="00:39.888" end="00:47.811"><span begin="00:39.888" end="00:40.029">'Cause </span><span begin="00:40.029" end="00:41.053">I </span><span begin="00:41.437" end="00:41.645">can't </span><span begin="00:41.645" end="00:41.885">make </span><span begin="00:41.885" end="00:42.157">you </span><span begin="00:42.157" end="00:42.795">stay </span><span begin="00:42.795" end="00:42.987">if </span><span begin="00:42.987" end="00:43.178">you </span><span begin="00:43.178" end="00:43.626">wanna </span><span begin="00:43.626" end="00:44.171">go</span></p><p ttm:agent="v1" begin="00:47.811" end="00:55.827"><span begin="00:47.811" end="00:47.971">But </span><span begin="00:47.971" end="00:48.834">I </span><span begin="00:49.634" end="00:49.795">will </span><span begin="00:49.795" end="00:49.971">wait </span><span begin="00:49.971" end="00:50.179">for </span><span begin="00:50.179" end="00:50.819">you </span><span begin="00:50.979" end="00:51.140">to </span><span begin="00:51.140" end="00:51.331">say </span><span begin="00:51.331" end="00:51.619">come </span><span begin="00:51.619" end="00:52.229">home</span></p><p ttm:agen