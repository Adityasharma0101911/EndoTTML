230">Hmm</span><span begin="00:20.230" end="00:20.440">）</span></p><p ttm:agent="v1" begin="00:20.440" end="00:23.440"><span begin="00:20.440" end="00:20.620">Now </span><span begin="00:20.620" end="00:20.860">I </span><span begin="00:20.860" end="00:21.310">wanna </span><span begin="00:21.310" end="00:21.580">know </span><span begin="00:21.580" end="00:21.820">how </span><span begin="00:21.820" end="00:22.030">you </span><span begin="00:22.030" end="00:22.510">taste </span><span begin="00:22.510" end="00:22.510">（</span><span begin="00:22.510" end="00:22.780">Mmm</span><span begin="00:22.780" end="00:22.840">-</span><span begin="00:22.840" end="00:23.170">mmm</span><span begin="00:23.170" end="00:23.440">）</span></p><p ttm:agent="v1" begin="00:23.440" end="00:26.590"><span begin="00:23.440" end="00:23.920">Usually </span><span begin="00:23.920" end="00:24.190">don't </span><span begin="00:24.190" end="00:24.550">give </span><span begin="00:24.550" end="00:24.790">it </span><span begin="00:24.790" end="00:25.180">away </span><span begin="00:25.180" end="00:25.210">（</span><span begin="00:25.210" end="00:25.570">Yeah</span><span begin="00:25.570" end="00:25.570">, </span><span begin="00:25.570" end="00:26.350">yeah</span><span begin="00:26.350" end="00:26.590">）</span></p><p ttm:agent="v1" begin="00:26.590" end="00:28.810"><span begin="00:26.590" end="00:26.860">But </span><span begin="00:26.860" end="00:26.980">you </span><span begin="00:26.980" end="00:27.100">know </span><span begin="00:27.100" end="00:27.430">I'm </span><span begin="00:27.430" end="00:27.580">out </span><span begin="00:27.580" end="00:27.730">here </span><span begin="00:27.730" end="00:28.120">thinkin' </span><span begin="00:28.120" end="00:28.360">'bout </span><span begin="00:28.360" end="00:28.810">it</span></p><p ttm:agent="v1" begin="00:29.740" end="00:34.750"><span begin="00:29.740" end="00:30.280">Then </span><span begin="00:30.280" end="00:30.520">I </span><span begin="00:30.520" end="00:32.020">realized </span><span begin="00:32.020" end="00:32.650">she's </span><span begin="00:32.650" end="00:33.370">right </span><span begin="00:33.370" end="00:34.750">there</span></p><p ttm:agent="v1" begin="00:35.140" end="00:40.480"><span begin="00:35.140" end="00:35.560">And </span><span begin="00:35.560" end="00:35.950">I'm </span><span begin="00:35.950" end="00:36.220">at </span><span begin="00:36.220" end="00:36.580">home </span><span begin="00:36.580" end="00:36.880">like</span><span begin="00:36.880" end="00:36.880">, </span><span begin="00:36.880" end="00:36.910">"</span><span begin="00:36.910" end="00:37.600">Damn</span><span begin="00:37.600" end="00:37.600">, </span><span begin="00:37.600" end="00:38.350">this </span><span begin="00:38.350" end="00:38.950">ain't </span><span begin="00:38.950" end="00:40.120">fair</span><span begin="00:40.120" end="00:40.480">"</span></p><p ttm:agent="v1" begin="00:40.750" end="00:43.540"><span begin="00:40.750" end="00:41.230">Break </span><span begin="00:41.230" end="00:41.500">up </span><span begin="00:41.500" end="00:41.680">with </span><span begin="00:41.680" end="00:41.800">your </span><span begin="00:41.800" end="00:43.540">girlfriend</span></p><p ttm:agent="v1" begin="00:43.570" end="00:46.390"><span begin="00:43.570" end="00:43.900">Yeah</span><span begin="00:43.900" end="00:43.900">, </span><span begin="00:43.900" end="00:44.200">yeah</span><span begin="00:44.200" end="00:44.230">, </span><span begin="00:44.230" end="00:44.560">'cause </span><span begin="00:44.560" end="00:44.680">I'm </span><span begin="00:44.680" end="00:46.390">bored</span></p><p ttm:agent="v1" begin="00:46.420" end="00:49.180"><span begin="00:46.420" end="00:46.570">You </span><span begin="00:46.570" end="00:46.780">can </span><span begin="00:46.780" end="00:47.050">hit </span><span begin="00:47.050" end="00:47.200">it </span><span begin="00:47.200" end="00:47.320">in </span><span begin="00:47.320" end="00:47.410">the </span><span begin="0