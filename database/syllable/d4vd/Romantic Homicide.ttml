<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Romantic Homicide</ttm:title><ttm:agent type="person" xml:id="v1">d4vd</ttm:agent><ttm:item type="album">Romantic Homicide</ttm:item><ttm:item type="spotify_id">1xK59OXxi2TAAAbmZK0kBL</ttm:item><itunes:duration>02:12.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:16.201" end="00:25.377"><span begin="00:16.201" end="00:16.472">I'm </span><span begin="00:16.472" end="00:18.209">scared </span><span begin="00:21.928" end="00:22.112">it </span><span begin="00:22.112" end="00:22.512">feels </span><span begin="00:22.512" end="00:22.849">like </span><span begin="00:22.849" end="00:23.401">you </span><span begin="00:23.401" end="00:23.912">don't </span><span begin="00:23.912" end="00:25.377">care</span></p><p ttm:agent="v1" begin="00:29.240" end="00:32.736"><span begin="00:29.240" end="00:29.899">Enlighten </span><span begin="00:29.899" end="00:30.482">me </span><span begin="00:30.482" end="00:31.128">my </span><span begin="00:31.128" end="00:32.736">dear</span></p><p ttm:agent="v1" begin="00:36.609" end="00:41.473"><span begin="00:36.609" end="00:36.873">Why </span><span begin="00:36.873" end="00:37.145">am </span><span begin="00:37.145" end="00:37.656">I </span><span begin="00:37.656" end="00:38.337">still </span><span begin="00:38.337" end="00:39.520">here </span><span begin="00:40.513" end="00:41.473">oh</span></p><p ttm:agent="v1" begin="00:43.624" end="00:47.260"><span begin="00:43.624" end="00:43.801">I </span><span begin="00:43.801" end="00:44.200">don't </span><span begin="00:44.200" end="00:44.641">mean </span><span begin="00:44.641" end="00:45.000">to </span><span begin="00:45.000" end="00:45.601">be </span><span begin="00:45.601" end="00:47.260">complacent</span></p><p ttm:agent="v1" begin="00:47.260" end="00:54.959"><span begin="00:47.260" end="00:47.762">With </span><span begin="00:47.762" end="00:48.372">the </span><span begin="00:48.372" end="00:50.308">decision </span><span begin="00:50.308" end="00:50.964">you </span><span begin="00:50.964" end="00:51.391">made </span><span begin="00:52.062" end="00:52.856">but </span><span begin="00:52.856" end="00:54.959">why</span></p><p ttm:agent="v1" begin="00:58.893" end="01:01.301"><span begin="00:58.893" end="00:59.092">In </span><span begin="00:59.092" end="00:59.268">the </span><span begin="00:59.268" end="00:59.597">back </span><span begin="00:59.597" end="00:59.796">of </span><span begin="00:59.796" end="01:00.181">my </span><span begin="01:00.181" end="01:01.301">mind</span></p><p ttm:agent="v1" begin="01:02.541" end="01:04.469"><span begin="01:02.541" end="01:03.356">You </span><span begin="01:03.356" end="01:04.469">died</span></p><p ttm:agent="v1" begin="01:05.509" end="01:08.157"><span begin="01:05.509" end="01:05.668">And </span><span begin="01:05.668" end="01:05.980">I </span><span begin="01:05.980" end="01:06.469">didn't </span><span begin="01:06.469" end="01:07.140">even </span><span begin="01:07.140" end="01:08.157">cry</span></p><p ttm:agent="v1" begin="01:08.916" end="01:11.799"><span begin="01:08.916" end="01:09.712">No </span><span begin="01:09.712" end="01:09.988">not </span><span begin="01:09.988" end="01:10.132">a </span><span begin="01:10.132" end="01:10.772">single </span><span begin="01:10.772" end="01:11.799">tear</span></p><p ttm:agent="v1" begin="01:12.734" end="01:17.574"><span begin="01:12.734" end="01:12.935">And </span><span begin="01:12.935" end="01:13.270">I'm </span><span begin="01:13.270" end="01:13.918">sick </span><span begin="01:13.918" end="01:14.614">of </span><span begin="01:14.614" end="01:15.742">waiting </span><span begin="01:15.742" end="01:17.574">patiently</span></p><p ttm:agent="v1" begin="01:17.574" end="01:23.782"><span begin="01:17.574" end="01:18.207">For </span><span begin="01:18.207" end="01:19.157">someone </span><span begin="01:19.439" end="01:20.030">that </span><span begin="01:20.030" end="01:20.615">won't </span><span begin="01:20.615" end="01:21.813">even </span><span begin="01:21.813" end="01:23.782">arrive</span></p><p ttm:agent="v1" begin="01:42.328" end="01:44.656"><span begin="01:42.328" end="01:42.527">In </span><span begin="01:42.527" end="01:42.783">the </span><span begin="01:42.783" end="01:43.176">back </span><span begin="01:43.176" end="01:43.423">of </span><span begin="01:43.423" end="01:43.767">my </span><span begin="01:43.767" end="01:44.656">mind</span></p><p ttm:agent="v1" begin="01:46.183" end="01:48.535"><span begin="01:46.183" end="01:46.455">I </span><span begin="01:46.455" end="01:47.143">killed </span><span begin="01:47.143" end="01:48.535">you</span></p><p ttm:agent="v1" begin="01:49.128" end="01:51.918"><span begin="01:49.128" end="01:49.280">And </span><span begin="01:49.280" end="01:49.591">I </span><span begin="01:49.591" end="01:50.199">didn't </span><span begin="01:50.199" end="01:50.647">even </span><span begin="01:50.647" end="01:51.005">regret </span><span begin="01:51.005" end="01:51.918">it</span></p><p ttm:agent="v1" begin="01:53.133" end="01:55.910"><span begin="01:53.133" end="01:53.294">I </span><span begin="01:53.294" end="01:53.605">can't </span><span begin="01:53.605" end="01:54.085">believe </span><span begin="01:54.085" end="01:54.494">I </span><span begin="01:54.494" end="01:54.886">said </span><span begin="01:54.886" end="01:55.910">it</span></p><p ttm:agent="v1" begin="01:56.848" end="02:00.032"><span begin="01:56.848" end="01:57.054">But </span><span begin="01:57.054" end="01:57.584">it's </span><span begin="01:57.584" end="02:00.032">true</span></p><p ttm:agent="v1" begin="02:04.298" end="02:07.857"><span begin="02:04.298" end="02:04.858">I </span><span begin="02:04.858" end="02:05.760">hate </span><span begin="02:05.760" end="02:07.857">you</span></p></div></body></tt>