<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Romantic Homicide</ttm:title><ttm:agent type="person" xml:id="v1">d4vd</ttm:agent><ttm:item type="album">Romantic Homicide</ttm:item><ttm:item type="spotify_id">1xK59OXxi2TAAAbmZK0kBL</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:15.790" end="00:18.040"><span begin="00:15.790" end="00:15.820">I</span><span begin="00:15.820" end="00:16.090">’</span><span begin="00:16.090" end="00:16.210">m </span><span begin="00:16.210" end="00:18.040">scared</span></p><p ttm:agent="v1" begin="00:21.550" end="00:25.060"><span begin="00:21.550" end="00:21.790">It </span><span begin="00:21.790" end="00:22.360">feels </span><span begin="00:22.360" end="00:22.900">like </span><span begin="00:22.900" end="00:23.140">you </span><span begin="00:23.140" end="00:23.620">don</span><span begin="00:23.620" end="00:23.650">’</span><span begin="00:23.650" end="00:23.770">t </span><span begin="00:23.770" end="00:25.060">care</span></p><p ttm:agent="v1" begin="00:28.780" end="00:32.740"><span begin="00:28.780" end="00:29.590">Enlighten </span><span begin="00:29.590" end="00:30.130">me</span><span begin="00:30.130" end="00:30.130">, </span><span begin="00:30.130" end="00:30.850">my </span><span begin="00:30.850" end="00:32.740">dear</span></p><p ttm:agent="v1" begin="00:36.280" end="00:43.240"><span begin="00:36.280" end="00:36.700">Why </span><span begin="00:36.700" end="00:37.090">am </span><span begin="00:37.090" end="00:37.390">I </span><span begin="00:37.390" end="00:38.110">still </span><span begin="00:38.110" end="00:39.640">here</span><span begin="00:39.640" end="00:39.970">, </span><span begin="00:39.970" end="00:43.240">oh</span></p><p ttm:agent="v1" begin="00:43.270" end="00:47.290"><span begin="00:43.270" end="00:43.510">I </span><span begin="00:43.510" end="00:44.050">don</span><span begin="00:44.050" end="00:44.080">’</span><span begin="00:44.080" end="00:44.140">t </span><span begin="00:44.140" end="00:44.470">mean </span><span begin="00:44.470" end="00:44.710">to </span><span begin="00:44.710" end="00:45.340">be </span><span begin="00:45.340" end="00:47.290">complacent</span></p><p ttm:agent="v1" begin="00:47.290" end="00:58.540"><span begin="00:47.290" end="00:47.800">With </span><span begin="00:47.800" end="00:48.340">the </span><span begin="00:48.340" end="00:50.230">decision </span><span begin="00:50.230" end="00:50.740">you </span><span begin="00:50.740" end="00:51.730">made</span><span begin="00:51.730" end="00:51.760">, </span><span begin="00:51.760" end="00:52.630">but </span><span begin="00:52.630" end="00:54.670">why</span><span begin="00:54.670" end="00:58.540">?</span></p><p ttm:agent="v1" begin="00:58.540" end="01:01.030"><span begin="00:58.540" end="00:58.840">In </span><span begin="00:58.840" end="00:59.020">the </span><span begin="00:59.020" end="00:59.470">back </span><span begin="00:59.470" end="00:59.650">of </span><span begin="00:59.650" end="00:59.920">my </span><span begin="00:59.920" end="01:01.030">mind</span></p><p ttm:agent="v1" begin="01:02.200" end="01:05.110"><span begin="01:02.200" end="01:03.070">You </span><span begin="01:03.070" end="01:05.110">died</span></p><p ttm:agent="v1" begin="01:05.200" end="01:09.370"><span begin="01:05.200" end="01:05.530">And </span><span begin="01:05.530" end="01:05.890">I </span><span begin="01:05.890" end="01:06.400">didn't </span><span begin="01:06.400" end="01:06.940">even </span><span begin="01:06.940" end="01:08.560">cry</span><span begin="01:08.560" end="01:08.590">, </span><span begin="01:08.590" end="01:09.370">no</span></p><p ttm:agent="v1" begin="01:09.370" end="01:11.680"><span begin="01:09.370" end="01:09.790">Not </span><span begin="01:09.790" end="01:09.880">a </span><span begin="01:09.880" end="01:10.600">single </span><span begin="01:10.600" end="01:11.680">tear</span></p><p ttm:agent="v1" begin="01:12.460" end="01:17.350"><span begin="01:12.460" end="01:12.790">And </span><span begin="01:12.790" end="01:13.120">I'm </span><span begin="01:13.120" end="01:13.930">sick </span><span begin="01:13.930" end="01:14.440">of </span><span begin="01:14.440" end="01:15.580">waiting </span><span begin="01:15.580" end="01:17.350">patiently</span></p><p ttm:agent="v1" begin="01:17.350" end="01:24.580"><span begin="01:17.350" end="01:18.040">For </span><span begin="01:18.040" end="01:19.270">someone </span><span begin="01:19.270" end="01:19.960">that </span><span begin="01:19.960" end="01:20.500">won't </span><span begin="01:20.500" end="01:21.610">even </span><span begin="01:21.610" end="01:24.580">arrive</span></p><p ttm:agent="v1" begin="01:42.250" end="01:45.220"><span begin="01:42.250" end="01:42.490">In </span><span begin="01:42.490" end="01:42.610">the </span><span begin="01:42.610" end="01:43.090">back </span><span begin="01:43.090" end="01:43.330">of </span><span begin="01:43.330" end="01:43.570">my </span><span begin="01:43.570" end="01:45.220">mind</span></p><p ttm:agent="v1" begin="01:45.790" end="01:48.610"><span begin="01:45.790" end="01:46.180">I </span><span begin="01:46.180" end="01:46.990">killed </span><span begin="01:46.990" end="01:48.610">you</span></p><p ttm:agent="v1" begin="01:48.790" end="01:52.510"><span begin="01:48.790" end="01:49.180">And </span><span begin="01:49.180" end="01:49.510">I </span><span begin="01:49.510" end="01:50.020">didn</span><span begin="01:50.020" end="01:50.050">’</span><span begin="01:50.050" end="01:50.200">t </span><span begin="01:50.200" end="01:50.500">even </span><span begin="01:50.500" end="01:51.010">regret </span><span begin="01:51.010" end="01:52.510">it</span></p><p ttm:agent="v1" begin="01:52.870" end="01:56.260"><span begin="01:52.870" end="01:53.080">I </span><span begin="01:53.080" end="01:53.410">can</span><span begin="01:53.410" end="01:53.440">’</span><span begin="01:53.440" end="01:53.500">t </span><span begin="01:53.500" end="01:53.980">believe </span><span begin="01:53.980" end="01:54.250">I </span><span begin="01:54.250" end="01:54.700">said </span><span begin="01:54.700" end="01:56.260">it</span></p><p ttm:agent="v1" begin="01:56.410" end="01:58.150"><span begin="01:56.410" end="01:56.890">But </span><span begin="01:56.890" end="01:57.220">it</span><span begin="01:57.220" end="01:57.250">’</span><span begin="01:57.250" end="01:57.550">s </span><span begin="01:57.550" end="01:58.150">true</span></p><p ttm:agent="v1" begin="02:03.970" end="02:07.750"><span begin="02:03.970" end="02:04.690">I </span><span begin="02:04.690" end="02:05.500">hate </span><span begin="02:05.500" end="02:07.750">you</span></p></div></body></tt>