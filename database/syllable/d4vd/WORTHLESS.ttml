56.958" end="01:59.271">up</span></p><p ttm:agent="v1" begin="01:59.271" end="02:02.246"><span begin="01:59.271" end="01:59.487">I </span><span begin="01:59.487" end="01:59.902">start </span><span begin="01:59.902" end="02:00.656">feeling </span><span begin="02:00.656" end="02:02.246">worthless</span></p><p ttm:agent="v1" begin="02:02.519" end="02:06.977"><span begin="02:02.519" end="02:02.767">It's </span><span begin="02:02.767" end="02:03.791">easier </span><span begin="02:03.791" end="02:04.239">said </span><span begin="02:04.239" end="02:04.688">than </span><span begin="02:04.688" end="02:06.977">done</span></p><p ttm:agent="v1" begin="02:07.185" end="02:09.921"><span begin="02:07.185" end="02:07.417">I'm </span><span begin="02:07.417" end="02:07.481">trying </span><span begin="02:07.481" end="02:07.658">to </span><span begin="02:07.658" end="02:07.881">find </span><span begin="02:07.881" end="02:08.377">my </span><span begin="02:08.377" end="02:09.921">purpose</span></p><p ttm:agent="v1" begin="02:10.396" end="02:17.626"><span begin="02:10.396" end="02:10.627">I </span><span begin="02:10.627" end="02:11.001">should've </span><span begin="02:11.001" end="02:11.473">ran </span><span begin="02:11.473" end="02:12.010">away </span><span begin="02:12.010" end="02:12.410">by </span><span begin="02:12.410" end="02:17.626">now</span></p><p ttm:agent="v1" begin="02:18.011" end="02:26.027"><span begin="02:18.011" end="02:18.235">But </span><span begin="02:18.235" end="02:18.683">I </span><span begin="02:18.683" end="02:19.131">can't </span><span begin="02:19.131" end="02:19.587">escape </span><span begin="02:19.587" end="02:20.148">this </span><span begin="02:20.148" end="02:26.027">town</span></p></div></body></tt>