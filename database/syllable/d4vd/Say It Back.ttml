<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Say It Back</ttm:title><ttm:agent type="person" xml:id="v1">d4vd</ttm:agent><ttm:item type="album">WITHERED</ttm:item><ttm:item type="spotify_id">2BqYGVjpoXeOIIZS209cWD</ttm:item><itunes:duration>03:04.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:04.170" end="00:07.808"><span begin="00:04.170" end="00:04.638">What </span><span begin="00:04.638" end="00:04.956">makes </span><span begin="00:04.956" end="00:05.325">you </span><span begin="00:05.325" end="00:07.808">stay?</span></p><p ttm:agent="v1" begin="00:09.166" end="00:12.847"><span begin="00:09.166" end="00:09.430">What </span><span begin="00:09.430" end="00:09.898">makes </span><span begin="00:09.898" end="00:10.499">you </span><span begin="00:10.499" end="00:12.847">go?</span></p><p ttm:agent="v1" begin="00:14.091" end="00:17.464"><span begin="00:14.091" end="00:14.496">What </span><span begin="00:14.496" end="00:14.862">makes </span><span begin="00:14.862" end="00:15.548">you </span><span begin="00:15.548" end="00:17.464">wait?</span></p><p ttm:agent="v1" begin="00:19.153" end="00:23.138"><span begin="00:19.153" end="00:19.569">I'll </span><span begin="00:19.569" end="00:20.610">never </span><span begin="00:20.610" end="00:23.138">know</span></p><p ttm:agent="v1" begin="00:24.181" end="00:28.012"><span begin="00:24.181" end="00:24.580">When </span><span begin="00:24.580" end="00:25.399">seasons </span><span begin="00:25.399" end="00:26.445">change </span><span begin="00:26.445" end="00:28.012">again</span></p><p ttm:agent="v1" begin="00:28.975" end="00:32.856"><span begin="00:28.975" end="00:29.160">And </span><span begin="00:29.160" end="00:29.448">you </span><span begin="00:29.448" end="00:29.958">get </span><span begin="00:29.958" end="00:31.178">bored </span><span begin="00:31.178" end="00:31.756">of </span><span begin="00:31.756" end="00:32.856">me</span></p><p ttm:agent="v1" begin="00:33.926" end="00:38.097"><span begin="00:33.926" end="00:34.188">I </span><span begin="00:34.188" end="00:34.524">want </span><span begin="00:34.524" end="00:34.909">you </span><span begin="00:34.909" end="00:35.581">to </span><span begin="00:35.581" end="00:36.143">let </span><span begin="00:36.143" end="00:36.646">me </span><span begin="00:36.646" end="00:38.097">know</span></p><p ttm:agent="v1" begin="00:38.706" end="00:44.178"><span begin="00:38.706" end="00:39.035">But </span><span begin="00:39.035" end="00:39.381">I </span><span begin="00:39.381" end="00:40.022">can't </span><span begin="00:40.022" end="00:41.412">let </span><span begin="00:41.412" end="00:42.625">you </span><span begin="00:42.625" end="00:44.178">go</span></p><p ttm:agent="v1" begin="00:44.178" end="00:48.346"><span begin="00:44.178" end="00:44.460">'Cause </span><span begin="00:44.460" end="00:44.965">I </span><span begin="00:44.965" end="00:45.618">love </span><span begin="00:45.618" end="00:48.346">you</span></p><p ttm:agent="v1" begin="00:48.990" end="00:53.514"><span begin="00:48.990" end="00:49.155">Like </span><span begin="00:49.155" end="00:49.573">I'm </span><span begin="00:49.573" end="00:51.038">supposed </span><span begin="00:51.038" end="00:53.514">to</span></p><p ttm:agent="v1" begin="00:54.003" end="00:58.315"><span begin="00:54.003" end="00:54.199">But </span><span begin="00:54.199" end="00:54.426">you </span><span begin="00:54.426" end="00:54.967">don't </span><span begin="00:54.967" end="00:56.168">say </span><span begin="00:56.168" end="00:56.473">it </span><span begin="00:56.473" end="00:58.315">back</span></p><p ttm:agent="v1" begin="00:59.047" end="01:03.386"><span begin="00:59.047" end="00:59.238">You </span><span begin="00:59.238" end="01:00.179">never </span><span begin="01:00.179" end="01:00.912">say </span><span begin="01:00.912" end="01:01.441">it </span><span begin="01:01.441" end="01:03.386">back</span></p><p ttm:agent="v1" begin="01:04.005" end="01:08.274"><span begin="01:04.005" end="01:04.207">So </span><span begin="01:04.207" end="01:04.696">now </span><span begin="01:04.696" end="01:05.262">I </span><span begin="01:05.262" end="01:05.929">hate </span><span begin="01:05.929" end="01:08.274">you</span></p><p ttm:agent="v1" begin="01:08.848" end="01:13.400"><span begin="01:08.848" end="01:09.027">And </span><span begin="01:09.027" end="01:09.451">I </span><span begin="01:09.451" end="01:09.767">hope </span><span begin="01:09.767" end="01:10.225">it </span><span begin="01:10.225" end="01:10.862">breaks </span><span begin="01:10.862" end="01:13.400">you</span></p><p ttm:agent="v1" begin="01:14.424" end="01:18.567"><span begin="01:14.424" end="01:14.858">I </span><span begin="01:14.858" end="01:15.266">won't </span><span begin="01:15.266" end="01:16.045">take </span><span begin="01:16.045" end="01:16.346">it </span><span begin="01:16.346" end="01:18.567">back</span></p><p ttm:agent="v1" begin="01:19.471" end="01:23.907"><span begin="01:19.471" end="01:19.705">I </span><span begin="01:19.705" end="01:20.246">won't </span><span begin="01:20.246" end="01:20.964">take </span><span begin="01:20.964" end="01:21.542">it </span><span begin="01:21.542" end="01:23.907">back</span></p><p ttm:agent="v1" begin="01:25.784" end="01:30.705"><span begin="01:25.784" end="01:26.043">Call </span><span begin="01:26.043" end="01:26.351">it </span><span begin="01:26.351" end="01:26.612">what </span><span begin="01:26.612" end="01:26.972">you </span><span begin="01:26.972" end="01:27.346">want </span><span begin="01:27.346" end="01:27.599">but </span><span begin="01:27.599" end="01:27.900">know </span><span begin="01:27.900" end="01:28.173">I'm </span><span begin="01:28.173" end="01:28.724">petty </span><span begin="01:28.724" end="01:29.025">when </span><span begin="01:29.025" end="01:29.362">it </span><span begin="01:29.362" end="01:29.910">comes </span><span begin="01:29.910" end="01:30.304">to </span><span begin="01:30.304" end="01:30.705">you</span></p><p ttm:agent="v1" begin="01:30.705" end="01:35.700"><span begin="01:30.705" end="01:31.150">I </span><span begin="01:31.150" end="01:31.331">don't </span><span begin="01:31.331" end="01:31.675">have </span><span begin="01:31.675" end="01:31.866">an </span><span begin="01:31.866" end="01:32.599">issue </span><span begin="01:32.599" end="01:32.852">if </span><span begin="01:32.852" end="01:33.048">I </span><span begin="01:33.048" end="01:33.457">miss </span><span begin="01:33.457" end="01:33.780">you </span><span begin="01:33.780" end="01:34.038">then </span><span begin="01:34.038" end="01:34.231">I'm </span><span begin="01:34.231" end="01:34.992">coming </span><span begin="01:34.992" end="01:35.700">through</span></p><p ttm:agent="v1" begin="01:35.700" end="01:41.881"><span begin="01:35.700" end="01:36.109">Every </span><span begin="01:36.109" end="01:36.573">time </span><span begin="01:36.573" end="01:36.821">you </span><span begin="01:36.821" end="01:37.115">cross </span><span begin="01:37.115" end="01:37.377">my </span><span begin="01:37.377" end="01:37.763">mind </span><span begin="01:37.763" end="01:37.995">I'm </span><span begin="01:37.995" end="01:39.227">terrified </span><span begin="01:39.227" end="01:39.562">of </span><span begin="01:39.562" end="01:40.255">calling </span><span begin="01:40.255" end="01:40.608">oh </span><span begin="01:40.608" end="01:41.881">God</span></p><p ttm:agent="v1" begin="01:42.649" end="01:45.794"><span begin="01:42.649" end="01:43.096">So </span><span begin="01:43.096" end="01:43.749">please </span><span begin="01:43.749" end="01:44.159">don't </span><span begin="01:44.159" end="01:44.907">cross </span><span begin="01:44.907" end="01:45.794">it</span></p><p ttm:agent="v1" begin="01:45.794" end="01:50.771"><span begin="01:45.794" end="01:46.174">I've </span><span begin="01:46.174" end="01:46.409">been </span><span begin="01:46.409" end="01:46.717">losing </span><span begin="01:46.717" end="01:47.162">sleep </span><span begin="01:47.162" end="01:47.386">and </span><span begin="01:47.386" end="01:47.951">losing </span><span begin="01:47.951" end="01:49.032">pieces </span><span begin="01:49.032" end="01:49.283">of </span><span begin="01:49.283" end="01:49.881">myself </span><span begin="01:49.881" end="01:50.771">again</span></p><p ttm:agent="v1" begin="01:50.771" end="01:55.858"><span begin="01:50.771" end="01:51.739">Everybody </span><span begin="01:51.739" end="01:52.199">says </span><span begin="01:52.199" end="01:52.525">I </span><span begin="01:52.525" end="01:52.787">need </span><span begin="01:52.787" end="01:53.060">a </span><span begin="01:53.060" end="01:53.700">lover </span><span begin="01:53.700" end="01:54.139">but </span><span begin="01:54.139" end="01:54.438">I </span><span begin="01:54.438" end="01:54.858">need </span><span begin="01:54.858" end="01:55.208">a </span><span begin="01:55.208" end="01:55.858">friend</span></p><p ttm:agent="v1" begin="01:55.858" end="02:00.775"><span begin="01:55.858" end="01:56.271">Talking </span><span begin="01:56.271" end="01:56.546">to </span><span begin="01:56.546" end="01:56.759">the </span><span begin="01:56.759" end="01:57.418">walls </span><span begin="01:57.418" end="01:57.810">inside </span><span begin="01:57.810" end="01:58.056">my </span><span begin="01:58.056" end="01:58.551">room </span><span begin="01:58.551" end="01:58.771">and </span><span begin="01:58.771" end="01:59.374">voices </span><span begin="01:59.374" end="01:59.867">in </span><span begin="01:59.867" end="02:00.294">my </span><span begin="02:00.294" end="02:00.775">head</span></p><p ttm:agent="v1" begin="02:00.775" end="02:04.371"><span begin="02:00.775" end="02:01.807">About </span><span begin="02:02.813" end="02:04.371">about</span></p><p ttm:agent="v1" begin="02:04.371" end="02:08.664"><span begin="02:04.371" end="02:04.673">How </span><span begin="02:04.673" end="02:05.237">much </span><span begin="02:05.237" end="02:05.587">I </span><span begin="02:05.587" end="02:06.215">love </span><span begin="02:06.215" end="02:08.664">you</span></p><p ttm:agent="v1" begin="02:09.320" end="02:13.747"><span begin="02:09.320" end="02:09.806">Like </span><span begin="02:09.806" end="02:10.253">I'm </span><span begin="02:10.253" end="02:11.437">supposed </span><span begin="02:11.437" end="02:13.747">to</span></p><p ttm:agent="v1" begin="02:14.520" end="02:18.795"><span begin="02:14.520" end="02:14.715">But </span><span begin="02:14.715" end="02:15.300">you </span><span begin="02:15.300" end="02:15.669">don't </span><span begin="02:15.669" end="02:16.413">say </span><span begin="02:16.413" end="02:16.787">it </span><span begin="02:16.787" end="02:18.795">back</span></p><p ttm:agent="v1" begin="02:19.548" end="02:23.796"><span begin="02:19.548" end="02:19.772">You </span><span begin="02:19.772" end="02:20.579">never </span><span begin="02:20.579" end="02:21.324">say </span><span begin="02:21.324" end="02:21.759">it </span><span begin="02:21.759" end="02:23.796">back</span></p><p ttm:agent="v1" begin="02:24.470" end="02:28.698"><span begin="02:24.470" end="02:24.694">So </span><span begin="02:24.694" end="02:25.270">now </span><span begin="02:25.270" end="02:25.700">I </span><span begin="02:25.700" end="02:26.299">hate </span><span begin="02:26.299" end="02:28.698">you</span></p><p ttm:agent="v1" begin="02:29.294" end="02:33.986"><span begin="02:29.294" end="02:29.470">And </span><span begin="02:29.470" end="02:29.976">I </span><span begin="02:29.976" end="02:30.332">hope </span><span begin="02:30.332" end="02:30.677">it </span><span begin="02:30.677" end="02:31.368">breaks </span><span begin="02:31.368" end="02:33.986">you</span></p><p ttm:agent="v1" begin="02:35.122" end="02:39.197"><span begin="02:35.122" end="02:35.305">I </span><span begin="02:35.305" end="02:35.614">won't </span><span begin="02:35.614" end="02:36.508">take </span><span begin="02:36.508" end="02:36.840">it </span><span begin="02:36.840" end="02:39.197">back</span></p><p ttm:agent="v1" begin="02:40.038" end="02:44.371"><span begin="02:40.038" end="02:40.232">I </span><span begin="02:40.232" end="02:40.597">won't </span><span begin="02:40.597" end="02:41.409">take </span><span begin="02:41.409" end="02:41.748">it </span><span begin="02:41.748" end="02:44.371">back</span></p><p ttm:agent="v1" begin="02:44.980" end="02:49.063"><span begin="02:44.980" end="02:45.423">'Cause </span><span begin="02:45.423" end="02:45.800">I </span><span begin="02:45.800" end="02:46.427">love </span><span begin="02:46.427" end="02:49.063">you</span></p><p ttm:agent="v1" begin="02:54.833" end="02:58.790"><span begin="02:54.833" end="02:55.058">How </span><span begin="02:55.058" end="02:55.511">much </span><span begin="02:55.511" end="02:55.831">I </span><span begin="02:55.831" end="02:56.483">love </span><span begin="02:56.483" end="02:58.790">you</span></p></div></body></tt>