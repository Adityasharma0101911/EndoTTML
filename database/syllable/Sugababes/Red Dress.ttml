430">lady</span></p><p ttm:agent="v1" begin="01:32.460" end="01:35.790"><span begin="01:32.460" end="01:33.030">Jumped </span><span begin="01:33.030" end="01:33.300">through </span><span begin="01:33.300" end="01:33.840">all </span><span begin="01:33.840" end="01:34.020">of </span><span begin="01:34.020" end="01:34.200">the </span><span begin="01:34.200" end="01:34.770">hoops </span><span begin="01:34.770" end="01:35.790">boy</span></p><p ttm:agent="v1" begin="01:37.620" end="01:39.900"><span begin="01:37.620" end="01:38.160">Instead </span><span begin="01:38.160" end="01:38.280">of </span><span begin="01:38.280" end="01:39.030">constant </span><span begin="01:39.030" end="01:39.900">craving</span></p><p ttm:agent="v1" begin="01:39.990" end="01:44.100"><span begin="01:39.990" end="01:40.140">I </span><span begin="01:40.140" end="01:40.740">leave </span><span begin="01:40.740" end="01:40.860">the </span><span begin="01:40.860" end="01:41.640">chasing </span><span begin="01:41.640" end="01:41.820">to </span><span begin="01:41.820" end="01:44.100">you</span></p><p ttm:agent="v1" begin="01:45.150" end="01:47.610"><span begin="01:45.150" end="01:45.630">And </span><span begin="01:45.630" end="01:45.810">if </span><span begin="01:45.810" end="01:45.960">you </span><span begin="01:45.960" end="01:46.470">don't </span><span begin="01:46.470" end="01:47.250">respect </span><span begin="01:47.250" end="01:47.610">it</span></p><p ttm:agent="v1" begin="01:47.670" end="01:51.660"><span begin="01:47.670" end="01:47.850">Ill </span><span begin="01:47.850" end="01:48.450">pick </span><span begin="01:48.450" end="01:48.570">up </span><span begin="01:48.570" end="01:49.050">my </span><span begin="01:49.050" end="01:49.500">Jimmy </span><span begin="01:49.500" end="01:51.660">Choos</span></p><p ttm:agent="v1" begin="01:52.890" end="01:55.320"><span begin="01:52.890" end="01:53.190">Cos </span><span begin="01:53.190" end="01:53.490">boy </span><span begin="01:53.490" end="01:53.700">if