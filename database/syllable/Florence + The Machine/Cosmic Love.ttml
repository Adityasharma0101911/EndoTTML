40">in </span><span begin="00:12.540" end="00:13.230">my </span><span begin="00:13.230" end="00:15.240">eyes</span></p><p ttm:agent="v1" begin="00:17.160" end="00:20.790"><span begin="00:17.160" end="00:17.460">i </span><span begin="00:17.460" end="00:19.080">screamed </span><span begin="00:19.080" end="00:20.790">aloud</span></p><p ttm:agent="v1" begin="00:21.450" end="00:23.820"><span begin="00:21.450" end="00:21.960">as </span><span begin="00:21.960" end="00:22.140">it </span><span begin="00:22.140" end="00:22.620">tore </span><span begin="00:22.620" end="00:23.070">through </span><span begin="00:23.070" end="00:23.820">them</span></p><p ttm:agent="v1" begin="00:23.820" end="00:29.910"><span begin="00:23.820" end="00:24.210">and </span><span begin="00:24.210" end="00:25.770">now </span><span begin="00:25.770" end="00:26.100">it's </span><span begin="00:26.100" end="00:26.520">left </span><span begin="00:26.520" end="00:27.120">me </span><span begin="00:27.120" end="00:29.910">blind</span></p><p ttm:agent="v1" begin="00:30.870" end="00:34.620"><span begin="00:30.870" end="00:31.170">the </span><span begin="00:31.170" end="00:32.760">stars</span><span begin="00:32.760" end="00:32.760">, </span><span begin="00:32.760" end="00:32.880">the </span><span begin="00:32.880" end="00:34.620">moon</span><span begin="00:34.620" end="00:34.620">,</span></p><p ttm:agent="v1" begin="00:34.620" end="00:37.530"><span begin="00:34.620" end="00:35.070">they </span><span begin="00:35.070" end="00:35.550">have </span><span begin="00:35.550" end="00:35.940">all </span><span begin="00:35.940" end="00:36.300">been </span><span begin="00:36.300" end="00:36.870">blown </span><span begin="00:36.870" end="00:37.530">out</span></p><p ttm:agent="v1" begin="00:37.530" end="00:43.290"><span begin="00:37.530" end="00:37.860">you </span><span begin="00:37.860" end="00:39.570">left </span><span begin="00:39.570" end="00:39.840">me </span><span begin="00:39.840" end="00:40.440">in </span><span begin="00:40.440" end="00:40.620">the </span><span begin="00:40.620" end="00:43.290">dark</span></p><p ttm:agent="v1" begin="00:44.580" end="00:48.030"><span begin="00:44.580" end="00:45.060">no </span><span begin="00:45.060" end="00:46.380">dawn</span><span begin="00:46.380" end="00:46.380">, </span><span begin="00:46.380" end="00:46.740">no </span><span begin="00:46.740" end="00:48.030">day</span></p><p ttm:agent="v1" begin="00:48.060" end="00:51.450"><span begin="00:48.060" end="00:48.390">i'm </span><span begin="00:48.390" end="00:49.290">always </span><span begin="00:49.290" end="00:49.650">in </span><span begin="00:49.650" end="00:50.010">this </span><span begin="00:50.010" end="00:51.450">twilight</span></p><p ttm:agent="v1" begin="00:51.450" end="00:57.030"><span begin="00:51.450" end="00:51.600">in </span><span begin="00:51.600" end="00:51.720">the </span><span begin="00:51.720" end="00:53.460">shadow </span><span begin="00:53.460" end="00:53.790">of </span><span begin="00:53.790" end="00:54.750">your </span><span begin="00:54.750" end="00:57.030">heart</span></p><p ttm:agent="v1" begin="00:58.380" end="01:01.740"><span begin="00:58.380" end="00:58.800">and </span><span begin="00:58.800" end="01:00.180">in </span><span begin="01:00.180" end="01:00.330">the </span><span begin="01:00.330" end="01:01.740">dark</span></p><p ttm:agent="v1" begin="01:02.040" end="01:04.920"><span begin="01:02.040" end="01:02.490">i </span><span begin="01:02.490" end="01:02.940">can </span><span begin="01:02.940" end="01:03.360">hear </span><span begin="01:03.360" end="01:03.810">your </span><span begin="01:03.810" end="01:04.920">heartbeat</span></p><p ttm:agent="v1" begin="01:04.920" end="01:09.930"><span begin="01:04.920" end="01:05.430">i </span><span begin="01:05.430" end="01:07.050">tried </span><span begin="01:07.050" end="01:07.110">to </span><span begin="01:07.110" end="01:07.890">find </span><span begin="01:07.890" end="01:07.950">the </span><span begin="01:07.950" end="01:09.930">sound</span></p><p ttm:agent="v1" begin="01:12.030" end="01:15.660"><span begin="01:12.030" end="01:12.360">but </span><span begin="01:12.360" end="01:13.680">then </span><span begin="01:13.680" end="01:13.950">it </span><span begin="01:13.950" end="01:15.660">stopped</span></p><p ttm:agent="v1" begin="01:15.660" end="01:18.480"><span begin="01:15.660" end="01:15.900">and </span><span begin="01:15.900" end="01:16.200">i </span><span begin="01:16.200" end="01:16.740">was </span><span begin="01:16.740" end="01:17.100">in </span><span begin="01:17.100" end="01:17.460">the </span><span begin="01:17.460" end="01:18.480">darkness</span></p><p ttm:agent="v1" begin="01:18.480" end="01:25.710"><span begin="01:18.480" end="01:19.110">so </span><span begin="01:19.110" end="01:21.000">darkness </span><span begin="01:21.000" end="01:21.540">i </span><span begin="01:21.540" end="01:25.710">became</span></p><p ttm:agent="v1" begin="01:26.220" end="01:29.220"><span begin="01:26.220" end="01:26.310">the </span><span begin="01:26.310" end="01:27.570">stars</span><span begin="01:27.570" end="01:27.570">, </span><span begin="01:27.570" end="01:27.720">the </span><span begin="01:27.720" end="01:29.220">moon</span></p><p ttm:agent="v1" begin="01:29.460" end="01:32.370"><span begin="01:29.460" end="01:29.550">they </span><span begin="01:29.550" end="01:30.420">have </span><span begin="01:30.420" end="01:30.780">all </span><span begin="01:30.780" end="01:31.050">been </span><span begin="01:31.050" end="01:31.740">blown </span><span begin="01:31.740" end="01:32.370">out</span></p><p ttm:agent="v1" begin="01:32.370" end="01:37.800"><span begin="01:32.370" end="01:32.670">you </span><span begin="01:32.670" end="01:34.380">left </span><span begin="01:34.380" end="01:34.680">me </span><span begin="01:34.680" end="01:35.070">in </span><span begin="01:35.070" end="01:35.910">the </span><span begin="01:35.910" end="01:37.800">dark</span></p><p ttm:agent="v1" begin="01:39.360" end="01:42.930"