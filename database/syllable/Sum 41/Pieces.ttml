<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Pieces</ttm:title><ttm:agent type="person" xml:id="v1">Sum 41</ttm:agent><ttm:item type="album">Chuck</ttm:item><ttm:item type="spotify_id">1ibeKVCiXORhvUpMmtsQWq</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:10.550" end="00:12.950"><span begin="00:10.550" end="00:10.790">I </span><span begin="00:10.790" end="00:11.210">tried </span><span begin="00:11.210" end="00:11.450">to </span><span begin="00:11.450" end="00:11.780">be </span><span begin="00:11.780" end="00:12.950">perfect</span></p><p ttm:agent="v1" begin="00:12.980" end="00:15.470"><span begin="00:12.980" end="00:13.250">But </span><span begin="00:13.250" end="00:13.880">nothing </span><span begin="00:13.880" end="00:14.210">was </span><span begin="00:14.210" end="00:14.870">worth </span><span begin="00:14.870" end="00:15.470">it</span></p><p ttm:agent="v1" begin="00:15.650" end="00:19.970"><span begin="00:15.650" end="00:16.040">I </span><span begin="00:16.040" end="00:16.280">don't </span><span begin="00:16.280" end="00:17.300">believe </span><span begin="00:17.300" end="00:17.750">it </span><span begin="00:17.750" end="00:18.410">makes </span><span begin="00:18.410" end="00:19.190">me </span><span begin="00:19.190" end="00:19.970">real</span></p><p ttm:agent="v1" begin="00:20.150" end="00:22.520"><span begin="00:20.150" end="00:20.420">I'd </span><span begin="00:20.420" end="00:20.930">thought </span><span begin="00:20.930" end="00:21.110">it'd </span><span begin="00:21.110" end="00:21.620">be </span><span begin="00:21.620" end="00:22.520">easy</span></p><p ttm:agent="v1" begin="00:22.520" end="00:25.220"><span begin="00:22.520" end="00:22.880">But </span><span begin="00:22.880" end="00:23.210">no </span><span begin="00:23.210" end="00:23.510">one </span><span begin="00:23.510" end="00:24.410">believes </span><span begin="00:24.410" end="00:25.220">me</span></p><p ttm:agent="v1" begin="00:25.580" end="00:29.750"><span begin="00:25.580" end="00:25.850">I </span><span begin="00:25.850" end="00:26.300">meant </span><span begin="00:26.300" end="00:27.080">all </span><span begin="00:27.080" end="00:27.290">the </span><span begin="00:27.290" end="00:28.040">things </span><span begin="00:28.040" end="00:28.130">that </span><span begin="00:28.130" end="00:28.730">I </span><span begin="00:28.730" end="00:29.750">said</span></p><p ttm:agent="v1" begin="00:29.780" end="00:34.940"><span begin="00:29.780" end="00:30.110">If </span><span begin="00:30.110" end="00:30.440">you </span><span begin="00:30.440" end="00:32.000">believe </span><span begin="00:32.000" end="00:32.600">it's </span><span begin="00:32.600" end="00:32.780">in </span><span begin="00:32.780" end="00:33.350">my </span><span begin="00:33.350" end="00:34.940">soul</span></p><p ttm:agent="v1" begin="00:35.210" end="00:39.560"><span begin="00:35.210" end="00:35.480">I'd </span><span begin="00:35.480" end="00:35.960">say </span><span begin="00:35.960" end="00:36.740">all </span><span begin="00:36.740" end="00:36.980">the </span><span begin="00:36.980" end="00:37.700">words </span><span begin="00:37.700" end="00:38.030">that </span><span begin="00:38.030" end="00:38.210">I </span><span begin="00:38.210" end="00:39.560">know</span></p><p ttm:agent="v1" begin="00:39.590" end="00:44.420"><span begin="00:39.590" end="00:40.070">Just </span><span begin="00:40.070" end="00:40.490">to </span><span begin="00:40.490" end="00:41.660">see </span><span begin="00:41.660" end="00:42.170">if </span><span begin="00:42.170" end="00:42.410">it </span><span begin="00:42.410" end="00:42.980">would </span><span begin="00:42.980" end="00:44.420">show</span></p><p ttm:agent="v1" begin="00:44.750" end="00:49.220"><span begin="00:44.750" end="00:45.200">that </span><span begin="00:45.200" end="00:45.350">I'm </span><span begin="00:45.350" end="00:46.550">trying </span><span begin="00:46.550" end="00:47.210">to </span><span begin="00:47.210" end="00:47.570">let </span><span begin="00:47.570" end="00:47.840">you </span><span begin="00:47.840" end="00:49.220">know</span></p><p ttm:agent="v1" begin="00:49.580" end="00:54.080"><span begin="00:49.580" end="00:50.030">That </span><span begin="00:50.030" end="00:50.210">I'm </span><span begin="00:50.210" end="00:51.560">better </span><span begin="00:51.560" end="00:52.100">off </span><span begin="00:52.100" end="00:52.250">on </span><span begin="00:52.250" end="00:53.420">my </span><span begin="00:53.420" end="00:54.080">own</span></p><p ttm:agent="v1" begin="01:03.350" end="01:05.750"><span begin="01:03.350" end="01:03.680">This </span><span begin="01:03.680" end="01:04.160">place </span><span begin="01:04.160" end="01:04.310">is </span><span begin="01:04.310" end="01:04.700">so </span><span begin="01:04.700" end="01:05.750">empty</span></p><p ttm:agent="v1" begin="01:05.750" end="01:08.330"><span begin="01:05.750" end="01:06.050">My </span><span begin="01:06.050" end="01:06.530">thoughts </span><span begin="01:06.530" end="01:06.680">are </span><span begin="01:06.680" end="01:07.010">so </span><span begin="01:07.010" end="01:08.330">tempting</span></p><p ttm:agent="v1" begin="01:08.570" end="01:12.800"><span begin="01:08.570" end="01:08.900">I </span><span begin="01:08.900" end="01:09.140">don't </span><span begin="01:09.140" end="01:09.470">know </span><span begin="01:09.470" end="01:10.040">how </span><span begin="01:10.040" end="01:10.610">we </span><span begin="01:10.610" end="01:11.180">got </span><span begin="01:11.180" end="01:12.050">so </span><span begin="01:12.050" end="01:12.800">bad</span></p><p ttm:agent="v1" begin="01:12.950" end="01:18.050"><span begin="01:12.950" end="01:13.760">Sometimes </span><span begin="01:13.760" end="01:13.940">it's </span><span begin="01:13.940" end="01:14.210">so </span><span begin="01:14.210" end="01:15.410">crazy </span><span begin="01:15.410" end="01:15.740">that </span><span begin="01:15.740" end="01:16.340">nothing </span><span begin="01:16.340" end="01:16.580">could </span><span begin="01:16.580" end="01:17.240">save </span><span begin="01:17.240" end="01:18.050">me</span></p><p ttm:agent="v1" begin="01:18.350" end="01:22.550"><span begin="01:18.350" end="01:18.800">But </span><span begin="01:18.800" end="01:19.070">it's </span><span begin="01:19.070" end="01:19.340">the </span><span begin="01:19.340" end="01:20.180">only </span><span begin="01:20.180" end="01:20.840">thing </span><span begin="01:20.840" end="01:21.230">that </span><span begin="01:21.230" end="01:21.470">I </span><span begin="01:21.470" end="01:22.550">have</span></p><p ttm:agent="v1" begin="01:22.580" end="01:27.830"><span begin="01:22.580" end="01:22.910">If </span><span begin="01:22.910" end="01:23.270">you </span><span begin="01:23.270" end="01:24.860">believe </span><span begin="01:24.860" end="01:25.460">it's </span><span begin="01:25.460" end="01:25.670">in </span><span begin="01:25.670" end="01:26.210">my </span><span begin="01:26.210" end="01:27.830">soul</span></p><p ttm:agent="v1" begin="01:28.040" end="01:32.270"><span begin="01:28.040" end="01:28.310">I'd </span><span begin="01:28.310" end="01:28.760">say </span><span begin="01:28.760" end="01:29.570">all </span><span begin="01:29.570" end="01:29.870">the </span><span begin="01:29.870" end="01:30.560">words </span><span begin="01:30.560" end="01:30.890">that </span><span begin="01:30.890" end="01:31.040">I </span><span begin="01:31.040" end="01:32.270">know</span></p><p ttm:agent="v1" begin="01:32.450" end="01:37.370"><span begin="01:32.450" end="01:32.960">Just </span><span begin="01:32.960" end="01:33.320">to </span><span begin="01:33.320" end="01:34.460">see </span><span begin="01:34.460" end="01:35.030">if </span><span begin="01:35.030" end="01:35.240">it </span><span begin="01:35.240" end="01:35.810">would </span><span begin="01:35.810" end="01:37.370">show</span></p><p ttm:agent="v1" begin="01:37.580" end="01:42.080"><span begin="01:37.580" end="01:38.060">that </span><span begin="01:38.060" end="01:38.180">I'm </span><span begin="01:38.180" end="01:39.410">trying </span><span begin="01:39.410" end="01:40.040">to </span><span begin="01:40.040" end="01:40.400">let </span><span begin="01:40.400" end="01:40.700">you </span><span begin="01:40.700" end="01:42.080">know</span></p><p ttm:agent="v1" begin="01:42.320" end="01:46.910"><span begin="01:42.320" end="01:42.830">That </span><span begin="01:42.830" end="01:43.010">I'm </span><span begin="01:43.010" end="01:44.360">better </span><span begin="01:44.360" end="01:44.930">off </span><span begin="01:44.930" end="01:45.140">on </span><span begin="01:45.140" end="01:45.860">my </span><span begin="01:45.860" end="01:46.910">own</span></p><p ttm:agent="v1" begin="01:46.910" end="02:10.640"><span begin="01:46.910" end="01:54.380">（</span><span begin="01:54.380" end="01:54.740">On </span><span begin="01:54.740" end="01:55.160">my </span><span begin="01:55.160" end="01:56.030">own</span><span begin="01:56.030" end="02:03.330">!</span><span begin="02:03.330" end="02:10.640">）</span></p><p ttm:agent="v1" begin="02:10.640" end="02:13.190"><span begin="02:10.640" end="02:10.910">I </span><span begin="02:10.910" end="02:11.330">tried </span><span begin="02:11.330" end="02:11.600">to </span><span begin="02:11.600" end="02:11.870">be </span><span begin="02:11.870" end="02:13.190">perfect</span></p><p ttm:agent="v1" begin="02:13.190" end="02:15.560"><span begin="02:13.190" end="02:13.340">It </span><span begin="02:13.340" end="02:13.760">just </span><span begin="02:13.760" end="02:14.300">wasn't </span><span begin="02:14.300" end="02:14.960">worth </span><span begin="02:14.960" end="02:15.560">it</span></p><p ttm:agent="v1" begin="02:15.740" end="02:20.090"><span begin="02:15.740" end="02:16.370">Nothing </span><span begin="02:16.370" end="02:16.820">could </span><span begin="02:16.820" end="02:17.900">ever </span><span begin="02:17.900" end="02:18.410">be </span><span begin="02:18.410" end="02:19.340">so </span><span begin="02:19.340" end="02:20.090">wrong</span></p><p ttm:agent="v1" begin="02:20.300" end="02:22.820"><span begin="02:20.300" end="02:20.630">It's </span><span begin="02:20.630" end="02:20.930">hard </span><span begin="02:20.930" end="02:21.200">to </span><span begin="02:21.200" end="02:22.130">believe </span><span begin="02:22.130" end="02:22.820">me</span></p><p ttm:agent="v1" begin="02:22.820" end="02:25.370"><span begin="02:22.820" end="02:23.030">It </span><span begin="02:23.030" end="02:23.600">never </span><span begin="02:23.600" end="02:24.020">gets </span><span begin="02:24.020" end="02:25.370">easy</span></p><p ttm:agent="v1" begin="02:25.700" end="02:29.810"><span begin="02:25.700" end="02:25.970">I </span><span begin="02:25.970" end="02:26.360">guess </span><span begin="02:26.360" end="02:26.570">I </span><span begin="02:26.570" end="02:27.170">knew </span><span begin="02:27.170" end="02:27.650">that </span><span begin="02:27.650" end="02:28.250">all </span><span begin="02:28.250" end="02:29.810">along</span></p><p ttm:agent="v1" begin="02:29.870" end="02:35.210"><span begin="02:29.870" end="02:30.140">If </span><span begin="02:30.140" end="02:30.470">you </span><span begin="02:30.470" end="02:32.090">believe </span><span begin="02:32.090" end="02:32.720">it's </span><span begin="02:32.720" end="02:32.930">in </span><span begin="02:32.930" end="02:33.440">my </span><span begin="02:33.440" end="02:35.210">soul</span></p><p ttm:agent="v1" begin="02:35.270" end="02:39.590"><span begin="02:35.270" end="02:35.600">I'd </span><span begin="02:35.600" end="02:36.050">say </span><span begin="02:36.050" end="02:36.830">all </span><span begin="02:36.830" end="02:37.100">the </span><span begin="02:37.100" end="02:37.790">words </span><span begin="02:37.790" end="02:38.120">that </span><span begin="02:38.120" end="02:38.330">I </span><span begin="02:38.330" end="02:39.590">know</span></p><p ttm:agent="v1" begin="02:39.680" end="02:44.630"><span begin="02:39.680" end="02:40.190">Just </span><span begin="02:40.190" end="02:40.610">to </span><span begin="02:40.610" end="02:41.750">see </span><span begin="02:41.750" end="02:42.320">if </span><span begin="02:42.320" end="02:42.530">it </span><span begin="02:42.530" end="02:43.070">would </span><span begin="02:43.070" end="02:44.630">show</span></p><p ttm:agent="v1" begin="02:44.840" end="02:49.310"><span begin="02:44.840" end="02:45.320">that </span><span begin="02:45.320" end="02:45.470">I'm </span><span begin="02:45.470" end="02:46.670">trying </span><span begin="02:46.670" end="02:47.300">to </span><span begin="02:47.300" end="02:47.660">let </span><span begin="02:47.660" end="02:47.960">you </span><span begin="02:47.960" end="02:49.310">know</span></p><p ttm:agent="v1" begin="02:49.670" end="02:54.410"><span begin="02:49.670" end="02:50.150">That </span><span begin="02:50.150" end="02:50.330">I'm </span><span begin="02:50.330" end="02:51.650">better </span><span begin="02:51.650" end="02:52.190">off </span><span begin="02:52.190" end="02:52.430">on </span><span begin="02:52.430" end="02:53.150">my </span><span begin="02:53.150" end="02:54.410">own</span></p></div></body></tt>