<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Summer</ttm:title><ttm:agent type="person" xml:id="v1">Calvin Harris</ttm:agent><ttm:item type="album">Motion</ttm:item><ttm:item type="spotify_id">6YUTL4dYpB9xZO5qExPf05</ttm:item><itunes:duration>03:42.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:02.840" end="00:04.690"><span begin="00:02.840" end="00:03.020">When </span><span begin="00:03.020" end="00:03.210">I </span><span begin="00:03.210" end="00:03.450">met </span><span begin="00:03.450" end="00:03.650">you </span><span begin="00:03.650" end="00:03.890">in </span><span begin="00:03.890" end="00:04.100">the </span><span begin="00:04.100" end="00:04.690">summer</span></p><p ttm:agent="v1" begin="00:06.500" end="00:08.520"><span begin="00:06.500" end="00:06.700">To </span><span begin="00:06.700" end="00:06.900">my </span><span begin="00:06.900" end="00:07.740">heartbeat's </span><span begin="00:07.740" end="00:08.520">sound</span></p><p ttm:agent="v1" begin="00:10.600" end="00:11.990"><span begin="00:10.600" end="00:10.800">We </span><span begin="00:10.800" end="00:11.040">fell </span><span begin="00:11.040" end="00:11.450">in </span><span begin="00:11.450" end="00:11.990">love</span></p><p ttm:agent="v1" begin="00:14.010" end="00:15.860"><span begin="00:14.010" end="00:14.200">As </span><span begin="00:14.200" end="00:14.400">the </span><span begin="00:14.400" end="00:14.760">leaves </span><span begin="00:14.760" end="00:15.220">turned </span><span begin="00:15.220" end="00:15.860">brown</span></p><p ttm:agent="v1" begin="00:17.970" end="00:20.280"><span begin="00:17.970" end="00:18.150">And </span><span begin="00:18.150" end="00:18.370">we </span><span begin="00:18.370" end="00:18.620">could </span><span begin="00:18.620" end="00:18.870">be </span><span begin="00:18.870" end="00:19.510">together </span><span begin="00:19.510" end="00:20.280">baby</span></p><p ttm:agent="v1" begin="00:21.470" end="00:23.390"><span begin="00:21.470" end="00:21.670">As </span><span begin="00:21.670" end="00:21.860">long </span><span begin="00:21.860" end="00:22.070">as </span><span begin="00:22.070" end="00:22.380">skies </span><span begin="00:22.380" end="00:22.790">are </span><span begin="00:22.790" end="00:23.390">blue</span></p><p ttm:agent="v1" begin="00:25.470" end="00:28.030"><span begin="00:25.470" end="00:25.680">You </span><span begin="00:25.680" end="00:25.930">act </span><span begin="00:25.930" end="00:26.490">so </span><span begin="00:26.490" end="00:27.380">innocent </span><span begin="00:27.380" end="00:28.030">now</span></p><p ttm:agent="v1" begin="00:29.040" end="00:30.790"><span begin="00:29.040" end="00:29.240">But </span><span begin="00:29.240" end="00:29.440">you </span><span begin="00:29.440" end="00:29.680">lied </span><span begin="00:29.680" end="00:30.140">so </span><span begin="00:30.140" end="00:30.790">soon</span></p><p ttm:agent="v1" begin="00:32.840" end="00:34.510"><span begin="00:32.840" end="00:33.030">When </span><span begin="00:33.030" end="00:33.230">I </span><span begin="00:33.230" end="00:33.440">met </span><span begin="00:33.440" end="00:33.640">you </span><span begin="00:33.640" end="00:33.850">in </span><span begin="00:33.850" end="00:34.080">the </span><span begin="00:34.080" end="00:34.510">summer</span></p><p ttm:agent="v1" begin="01:17.725" end="01:19.445"><span begin="01:17.725" end="01:17.885">When </span><span begin="01:17.885" end="01:18.085">I </span><span begin="01:18.085" end="01:18.275">met </span><span begin="01:18.275" end="01:18.465">you </span><span begin="01:18.465" end="01:18.685">in </span><span begin="01:18.685" end="01:18.895">the </span><span begin="01:18.895" end="01:19.445">summer</span></p><p ttm:agent="v1" begin="01:21.425" end="01:23.215"><span begin="01:21.425" end="01:21.625">To </span><span begin="01:21.625" end="01:21.875">my </span><span begin="01:21.875" end="01:22.505">heartbeat's </span><span begin="01:22.505" end="01:23.215">sound</span></p><p ttm:agent="v1" begin="01:25.555" end="01:26.955"><span begin="01:25.555" end="01:25.755">We </span><span begin="01:25.755" end="01:25.975">fell </span><span begin="01:25.975" end="01:26.455">in </span><span begin="01:26.455" end="01:26.955">love</span></p><p ttm:agent="v1" begin="01:28.985" end="01:30.725"><span begin="01:28.985" end="01:29.155">As </span><span begin="01:29.155" end="01:29.355">the </span><span begin="01:29.355" end="01:29.705">leaves </span><span begin="01:29.705" end="01:30.175">turned </span><span begin="01:30.175" end="01:30.725">brown</span></p><p ttm:agent="v1" begin="01:32.915" end="01:35.235"><span begin="01:32.915" end="01:33.115">And </span><span begin="01:33.115" end="01:33.325">we </span><span begin="01:33.325" end="01:33.545">could </span><span begin="01:33.545" end="01:33.775">be </span><span begin="01:33.775" end="01:34.385">together </span><span begin="01:34.385" end="01:35.235">baby</span></p><p ttm:agent="v1" begin="01:36.335" end="01:38.225"><span begin="01:36.335" end="01:36.535">As </span><span begin="01:36.535" end="01:36.745">long </span><span begin="01:36.745" end="01:36.945">as </span><span begin="01:36.945" end="01:37.255">skies </span><span begin="01:37.255" end="01:37.625">are </span><span begin="01:37.625" end="01:38.225">blue</span></p><p ttm:agent="v1" begin="01:40.385" end="01:43.075"><span begin="01:40.385" end="01:40.565">You </span><span begin="01:40.565" end="01:40.955">act </span><span begin="01:40.955" end="01:41.395">so </span><span begin="01:41.395" end="01:42.285">innocent </span><span begin="01:42.285" end="01:43.075">now</span></p><p ttm:agent="v1" begin="01:44.025" end="01:45.715"><span begin="01:44.025" end="01:44.205">But </span><span begin="01:44.205" end="01:44.405">you </span><span begin="01:44.405" end="01:44.725">lied </span><span begin="01:44.725" end="01:45.105">so </span><span begin="01:45.105" end="01:45.715">soon</span></p><p ttm:agent="v1" begin="01:47.765" end="01:49.605"><span begin="01:47.765" end="01:47.965">When </span><span begin="01:47.965" end="01:48.165">I </span><span begin="01:48.165" end="01:48.395">met </span><span begin="01:48.395" end="01:48.605">you </span><span begin="01:48.605" end="01:48.845">in </span><span begin="01:48.845" end="01:49.105">the </span><span begin="01:49.105" end="01:56.580">summer</span></p><p ttm:agent="v1" begin="01:56.580" end="01:57.100"><span begin="01:56.580" end="01:57.100">Summer</span></p><p ttm:agent="v1" begin="02:32.822" end="02:34.522"><span begin="02:32.822" end="02:33.002">When </span><span begin="02:33.002" end="02:33.202">I </span><span begin="02:33.202" end="02:33.412">met </span><span begin="02:33.412" end="02:33.632">you </span><span begin="02:33.632" end="02:33.842">in </span><span begin="02:33.842" end="02:34.042">the </span><span begin="02:34.042" end="02:35.582">summer</span></p><p ttm:agent="v1" begin="02:35.582" end="02:36.222"><span begin="02:35.582" end="02:36.222">Summer</span></p><p ttm:agent="v1" begin="02:49.187" end="02:49.776"><span begin="02:49.187" end="02:49.776">Summer</span></p><p ttm:agent="v1" begin="02:50.706" end="02:51.415"><span begin="02:50.706" end="02:51.415">Summer</span></p></div></body></tt>