<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>apart of me</ttm:title><ttm:agent type="person" xml:id="v1">Takayoshi</ttm:agent><ttm:item type="album">apart of me</ttm:item><ttm:item type="spotify_id">2D79qw6Zobv0O7MMD74V6C</ttm:item><itunes:duration>01:16.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.000" end="00:00.182"><span begin="00:00.000" end="00:00.045">apart </span><span begin="00:00.046" end="00:00.091">of </span><span begin="00:00.092" end="00:00.137">me - </span><span begin="00:00.137" end="00:00.182">Takayoshi</span></p><p ttm:agent="v1" begin="00:00.183" end="00:00.365"><span begin="00:00.183" end="00:00.228">Lyrics </span><span begin="00:00.229" end="00:00.274">by：</span><span begin="00:00.275" end="00:00.320">Andrew </span><span begin="00:00.320" end="00:00.365">Takayoshi</span></p><p ttm:agent="v1" begin="00:00.366" end="00:00.548"><span begin="00:00.366" end="00:00.411">Composed </span><span begin="00:00.412" end="00:00.457">by：</span><span begin="00:00.458" end="00:00.503">Andrew </span><span begin="00:00.503" end="00:00.548">Takayoshi</span></p><p ttm:agent="v1" begin="00:00.549" end="00:00.731"><span begin="00:00.549" end="00:00.594">Produced </span><span begin="00:00.595" end="00:00.640">by：</span><span begin="00:00.641" end="00:00.686">Andrew </span><span begin="00:00.686" end="00:00.731">Takayoshi</span></p><p ttm:agent="v1" begin="00:00.733" end="00:00.990"><span begin="00:00.733" end="00:00.990">Wake</span></p><p ttm:agent="v1" begin="00:14.965" end="00:16.837"><span begin="00:14.965" end="00:15.149">You </span><span begin="00:15.149" end="00:15.597">say </span><span begin="00:15.597" end="00:15.749">I </span><span begin="00:15.749" end="00:16.117">don't </span><span begin="00:16.117" end="00:16.277">want </span><span begin="00:16.277" end="00:16.501">to </span><span begin="00:16.501" end="00:16.837">go</span></p><p ttm:agent="v1" begin="00:17.533" end="00:18.597"><span begin="00:17.533" end="00:17.709">Baby </span><span begin="00:17.709" end="00:18.142">don't </span><span begin="00:18.142" end="00:18.597">cry</span></p><p ttm:agent="v1" begin="00:19.064" end="00:21.280"><span begin="00:19.064" end="00:19.200">Hope </span><span begin="00:19.200" end="00:19.296">you </span><span begin="00:19.296" end="00:19.784">don't </span><span begin="00:19.784" end="00:21.280">cry</span></p><p ttm:agent="v1" begin="00:21.538" end="00:23.898"><span begin="00:21.538" end="00:21.922">You </span><span begin="00:21.922" end="00:22.058">say </span><span begin="00:22.058" end="00:22.354">you're </span><span begin="00:22.354" end="00:22.794">going </span><span begin="00:22.794" end="00:22.946">to </span><span begin="00:22.946" end="00:23.298">be </span><span begin="00:23.298" end="00:23.898">alone</span></p><p ttm:agent="v1" begin="00:24.178" end="00:26.274"><span begin="00:24.178" end="00:24.370">I'll </span><span begin="00:24.370" end="00:24.554">see </span><span begin="00:24.554" end="00:24.698">you </span><span begin="00:24.698" end="00:24.994">next </span><span begin="00:24.994" end="00:26.274">time</span></p><p ttm:agent="v1" begin="00:27.481" end="00:30.585"><span begin="00:27.481" end="00:27.649">And </span><span begin="00:27.649" end="00:27.825">I </span><span begin="00:27.825" end="00:28.362">don't </span><span begin="00:28.362" end="00:30.585">care</span></p><p ttm:agent="v1" begin="00:30.905" end="00:33.954"><span begin="00:30.905" end="00:31.097">Just </span><span begin="00:31.097" end="00:31.217">talk </span><span begin="00:31.217" end="00:31.818">to </span><span begin="00:31.818" end="00:33.954">me</span></p><p ttm:agent="v1" begin="00:34.417" end="00:37.385"><span begin="00:34.417" end="00:34.794">Forever </span><span begin="00:34.953" end="00:35.306">in </span><span begin="00:35.306" end="00:37.385">love</span></p><p ttm:agent="v1" begin="00:37.681" end="00:39.434"><span begin="00:37.681" end="00:37.913">You're </span><span begin="00:37.913" end="00:38.442">apart </span><span begin="00:38.442" end="00:38.625">of </span><span begin="00:38.625" end="00:39.434">me</span></p><p ttm:agent="v1" begin="00:42.773" end="00:44.438"><span begin="00:42.773" end="00:42.958">All </span><span begin="00:42.958" end="00:43.469">alone </span><span begin="00:43.469" end="00:43.605">in </span><span begin="00:43.605" end="00:43.886">your </span><span begin="00:43.886" end="00:44.438">bed</span></p><p ttm:agent="v1" begin="00:44.470" end="00:45.966"><span begin="00:44.470" end="00:44.647">You </span><span begin="00:44.647" end="00:44.782">should </span><span begin="00:44.782" end="00:44.902">let </span><span begin="00:44.902" end="00:45.158">me </span><span begin="00:45.158" end="00:45.502">come </span><span begin="00:45.502" end="00:45.966">through</span></p><p ttm:agent="v1" begin="00:46.105" end="00:49.201"><span begin="00:46.105" end="00:46.274">Missing </span><span begin="00:46.274" end="00:46.721">you </span><span begin="00:46.721" end="00:46.873">write </span><span begin="00:46.873" end="00:47.097">a </span><span begin="00:47.097" end="00:47.305">song </span><span begin="00:47.562" end="00:47.713">and </span><span begin="00:47.713" end="00:48.081">now </span><span begin="00:48.081" end="00:48.257">i'm </span><span begin="00:48.257" end="00:48.595">singing </span><span begin="00:48.595" end="00:48.921">for </span><span begin="00:48.921" end="00:49.201">you</span></p><p ttm:agent="v1" begin="00:49.851" end="00:52.644"><span begin="00:49.851" end="00:50.043">Because </span><span begin="00:50.043" end="00:50.483">I </span><span begin="00:50.483" end="00:50.859">can't </span><span begin="00:51.371" end="00:51.539">get </span><span begin="00:51.539" end="00:51.987">enough </span><span begin="00:51.987" end="00:52.228">of </span><span begin="00:52.228" end="00:52.644">you</span></p><p ttm:agent="v1" begin="00:55.008" end="00:58.128"><span begin="00:55.008" end="00:55.168">And </span><span begin="00:55.168" end="00:55.416">I </span><span begin="00:55.416" end="00:55.841">don't </span><span begin="00:55.841" end="00:58.128">care</span></p><p ttm:agent="v1" begin="00:58.352" end="01:01.376"><span begin="00:58.352" end="00:58.512">Just </span><span begin="00:58.512" end="00:58.816">talk </span><span begin="00:58.816" end="00:59.273">to </span><span begin="00:59.273" end="01:01.376">me</span></p><p ttm:agent="v1" begin="01:01.880" end="01:04.720"><span begin="01:01.880" end="01:02.344">Forever </span><span begin="01:02.344" end="01:02.784">in </span><span begin="01:02.784" end="01:04.720">love</span></p><p ttm:agent="v1" begin="01:05.080" end="01:06.232"><span begin="01:05.080" end="01:05.216">You're </span><span begin="01:05.216" end="01:05.648">apart </span><span begin="01:05.648" end="01:05.928">of </span><span begin="01:05.928" end="01:06.232">me</span></p></div></body></tt>