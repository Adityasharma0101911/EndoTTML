<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Leader of Men</ttm:title><ttm:agent type="person" xml:id="v1">Nickelback</ttm:agent><ttm:item type="album">The State</ttm:item><ttm:item type="spotify_id">4Vf9v7ohVz5i8PeZBliwb5</ttm:item><itunes:duration>03:30.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:15.252" end="00:19.748"><span begin="00:15.252" end="00:15.500">Tell </span><span begin="00:15.500" end="00:15.876">your </span><span begin="00:15.876" end="00:16.250">friends </span><span begin="00:16.250" end="00:16.564">not </span><span begin="00:16.564" end="00:16.812">to </span><span begin="00:16.812" end="00:17.064">think </span><span begin="00:17.064" end="00:19.748">aloud</span></p><p ttm:agent="v1" begin="00:19.748" end="00:24.436"><span begin="00:19.748" end="00:20.128">Until </span><span begin="00:20.128" end="00:21.252">they </span><span begin="00:21.252" end="00:24.436">swallow</span></p><p ttm:agent="v1" begin="00:24.436" end="00:29.001"><span begin="00:24.436" end="00:24.752">Whisper </span><span begin="00:24.752" end="00:25.434">things </span><span begin="00:25.434" end="00:26.128">into </span><span begin="00:26.128" end="00:26.751">my </span><span begin="00:26.751" end="00:29.001">brain</span></p><p ttm:agent="v1" begin="00:29.001" end="00:33.751"><span begin="00:29.001" end="00:29.379">Your </span><span begin="00:29.379" end="00:29.875">voice </span><span begin="00:29.875" end="00:30.127">sounds </span><span begin="00:30.127" end="00:30.499">so </span><span begin="00:30.499" end="00:33.751">hollow</span></p><p ttm:agent="v1" begin="00:33.751" end="00:38.063"><span begin="00:33.751" end="00:34.131">I </span><span begin="00:34.131" end="00:34.379">am </span><span begin="00:34.379" end="00:34.689">not </span><span begin="00:34.689" end="00:35.251">a </span><span begin="00:35.251" end="00:35.751">leader </span><span begin="00:35.751" end="00:36.126">of </span><span begin="00:36.126" end="00:38.063">men</span></p><p ttm:agent="v1" begin="00:38.063" end="00:43.063"><span begin="00:38.063" end="00:38.375">Since </span><span begin="00:38.375" end="00:38.687">I </span><span begin="00:38.687" end="00:39.001">prefer </span><span begin="00:39.001" end="00:39.565">to </span><span begin="00:39.565" end="00:43.063">follow</span></p><p ttm:agent="v1" begin="00:43.063" end="00:47.316"><span begin="00:43.063" end="00:43.438">Do </span><span begin="00:43.438" end="00:43.687">you </span><span begin="00:43.687" end="00:44.003">think </span><span begin="00:44.003" end="00:44.499">I </span><span begin="00:44.499" end="00:44.815">could </span><span begin="00:44.815" end="00:45.123">have </span><span begin="00:45.123" end="00:45.563">a </span><span begin="00:45.563" end="00:47.316">drink</span></p><p ttm:agent="v1" begin="00:47.316" end="00:54.629"><span begin="00:47.316" end="00:47.629">Since </span><span begin="00:47.629" end="00:47.939">it's </span><span begin="00:47.939" end="00:48.255">so </span><span begin="00:48.255" end="00:48.628">hard </span><span begin="00:48.628" end="00:49.006">to </span><span begin="00:49.006" end="00:51.687">swallow  </span><span begin="00:51.687" end="00:54.629">yeah</span></p><p ttm:agent="v1" begin="00:54.629" end="01:01.561"><span begin="00:54.629" end="00:54.936">So </span><span begin="00:54.936" end="00:55.315">hard </span><span begin="00:55.315" end="00:55.939">to </span><span begin="00:55.939" end="01:01.561">swallow</span></p><p ttm:agent="v1" begin="01:01.561" end="01:05.687"><span begin="01:01.561" end="01:02.003">Turn </span><span begin="01:02.003" end="01:02.751">the </span><span begin="01:02.751" end="01:04.063">television </span><span begin="01:04.063" end="01:05.687">off</span></p><p ttm:agent="v1" begin="01:05.687" end="01:10.503"><span begin="01:05.687" end="01:06.377">And </span><span begin="01:06.377" end="01:06.691">I </span><span begin="01:06.691" end="01:07.067">will </span><span begin="01:07.067" end="01:07.379">sing </span><span begin="01:07.379" end="01:07.813">a </span><span begin="01:07.813" end="01:10.503">song</span></p><p ttm:agent="v1" begin="01:10.503" end="01:15.815"><span begin="01:10.503" end="01:10.879">And </span><span begin="01:10.879" end="01:11.255">if </span><span begin="01:11.255" end="01:11.504">you </span><span begin="01:11.504" end="01:12.189">suddenly </span><span begin="01:12.189" end="01:12.755">have </span><span begin="01:12.755" end="01:13.437">the </span><span begin="01:13.437" end="01:15.815">urge</span></p><p ttm:agent="v1" begin="01:15.815" end="01:20.002"><span begin="01:15.815" end="01:16.128">You </span><span begin="01:16.128" end="01:16.567">can </span><span begin="01:16.567" end="01:16.938">sing </span><span begin="01:16.938" end="01:20.002">along</span></p><p ttm:agent="v1" begin="01:20.002" end="01:24.626"><span begin="01:20.002" end="01:20.379">I </span><span begin="01:20.379" end="01:20.686">touch </span><span begin="01:20.686" end="01:21.064">your </span><span begin="01:21.064" end="01:21.880">hand  </span><span begin="01:21.880" end="01:22.188">I </span><span begin="01:22.188" end="01:22.625">touch </span><span begin="01:22.625" end="01:22.938">your </span><span begin="01:22.938" end="01:24.626">face</span></p><p ttm:agent="v1" begin="01:24.626" end="01:29.438"><span begin="01:24.626" end="01:25.130">I </span><span begin="01:25.130" end="01:25.442">think </span><span begin="01:25.442" end="01:25.813">the </span><span begin="01:25.813" end="01:26.255">fruit </span><span begin="01:26.255" end="01:26.562">is </span><span begin="01:26.562" end="01:29.438">rotten</span></p><p ttm:agent="v1" begin="01:29.438" end="01:33.880"><span begin="01:29.438" end="01:29.814">Give </span><span begin="01:29.814" end="01:30.188">me </span><span begin="01:30.188" end="01:31.002">lessons </span><span begin="01:31.002" end="01:31.438">on </span><span begin="01:31.438" end="01:31.815">how </span><span begin="01:31.815" end="01:32.126">to </span><span begin="01:32.126" end="01:33.880">breath</span></p><p ttm:agent="v1" begin="01:33.880" end="01:41.130"><span begin="01:33.880" end="01:34.190">'Cause </span><span begin="01:34.190" end="01:34.506">I </span><span begin="01:34.506" end="01:35.066">think </span><span begin="01:35.066" end="01:35.442">I've </span><span begin="01:35.442" end="01:36.002">forgotten </span><span begin="01:36.002" end="01:41.130">yeah</span></p><p ttm:agent="v1" begin="01:41.130" end="01:52.814"><span begin="01:41.130" end="01:41.439">I </span><span begin="01:41.439" end="01:41.812">think </span><span begin="01:41.812" end="01:42.190">I've </span><span begin="01:42.190" end="01:52.814">forgotten</span></p><p ttm:agent="v1" begin="01:52.814" end="01:57.254"><span begin="01:52.814" end="01:53.190">One </span><span begin="01:53.190" end="01:54.382">day  </span><span begin="01:54.382" end="01:54.690">up </span><span begin="01:54.690" end="01:55.002">to </span><span begin="01:55.002" end="01:55.314">a </span><span begin="01:55.314" end="01:57.254">cliff</span></p><p ttm:agent="v1" begin="01:57.254" end="02:02.126"><span begin="01:57.254" end="01:57.566">That </span><span begin="01:57.566" end="01:57.938">overlooked </span><span begin="01:57.938" end="01:58.382">the </span><span begin="01:58.382" end="02:02.126">water</span></p><p ttm:agent="v1" begin="02:02.126" end="02:06.504"><span begin="02:02.126" end="02:02.438">I </span><span begin="02:02.438" end="02:03.002">jumped </span><span begin="02:03.002" end="02:03.566">in </span><span begin="02:03.566" end="02:03.938">to </span><span begin="02:03.938" end="02:04.192">save </span><span begin="02:04.192" end="02:04.566">a </span><span begin="02:04.566" end="02:06.504">girl</span></p><p ttm:agent="v1" begin="02:06.504" end="02:11.441"><span begin="02:06.504" end="02:06.814">It </span><span begin="02:06.814" end="02:07.189">was </span><span begin="02:07.189" end="02:07.690">somebody's </span><span begin="02:07.690" end="02:11.441">daughter</span></p><p ttm:agent="v1" begin="02:11.441" end="02:15.881"><span begin="02:11.441" end="02:11.813">And </span><span begin="02:11.813" end="02:12.129">now </span><span begin="02:12.129" end="02:12.441">the </span><span begin="02:12.441" end="02:12.753">ring </span><span begin="02:12.753" end="02:13.127">is </span><span begin="02:13.127" end="02:13.440">on </span><span begin="02:13.440" end="02:13.813">my </span><span begin="02:13.813" end="02:15.881">hand</span></p><p ttm:agent="v1" begin="02:15.881" end="02:20.565"><span begin="02:15.881" end="02:16.131">It </span><span begin="02:16.131" end="02:16.437">was </span><span begin="02:16.437" end="02:16.689">given </span><span begin="02:16.689" end="02:16.941">to </span><span begin="02:16.941" end="02:17.379">me </span><span begin="02:17.379" end="02:17.881">by </span><span begin="02:17.881" end="02:20.565">her</span></p><p ttm:agent="v1" begin="02:20.565" end="02:25.125"><span begin="02:20.565" end="02:20.877">To </span><span begin="02:20.877" end="02:21.129">this </span><span begin="02:21.129" end="02:21.629">day </span><span begin="02:21.629" end="02:22.189">we </span><span begin="02:22.189" end="02:22.565">all </span><span begin="02:22.565" end="02:22.879">sit </span><span begin="02:22.879" end="02:25.125">around</span></p><p ttm:agent="v1" begin="02:25.125" end="02:32.629"><span begin="02:25.125" end="02:25.378">And </span><span begin="02:25.378" end="02:25.937">dream </span><span begin="02:25.937" end="02:26.255">of </span><span begin="02:26.255" end="02:26.502">ways </span><span begin="02:26.502" end="02:26.817">to </span><span begin="02:26.817" end="02:27.125">get </span><span begin="02:27.125" end="02:29.377">higher  </span><span begin="02:29.377" end="02:32.629">yeah</span></p><p ttm:agent="v1" begin="02:32.629" end="02:43.565"><span begin="02:32.629" end="02:32.939">To </span><span begin="02:32.939" end="02:33.249">get </span><span begin="02:33.249" end="02:33.568">much </span><span begin="02:33.568" end="02:43.565">higher</span></p><p ttm:agent="v1" begin="02:43.565" end="02:48.065"><span begin="02:43.565" end="02:43.875">Tell </span><span begin="02:43.875" end="02:44.189">your </span><span begin="02:44.189" end="02:44.503">friends </span><span begin="02:44.503" end="02:44.941">not </span><span begin="02:44.941" end="02:45.127">to </span><span begin="02:45.127" end="02:45.566">think </span><span begin="02:45.566" end="02:48.065">aloud</span></p><p ttm:agent="v1" begin="02:48.065" end="02:52.689"><span begin="02:48.065" end="02:48.377">Until </span><span begin="02:48.377" end="02:48.879">they </span><span begin="02:48.879" end="02:52.582">swallow</span></p><p ttm:agent="v1" begin="02:52.582" end="02:57.141"><span begin="02:52.582" end="02:53.516">Whisper </span><span begin="02:53.516" end="02:53.889">things </span><span begin="02:53.889" end="02:54.456">into </span><span begin="02:54.456" end="02:54.894">my </span><span begin="02:54.894" end="02:57.141">brain</span></p><p ttm:agent="v1" begin="02:57.141" end="03:01.766"><span begin="02:57.141" end="02:57.455">To </span><span begin="02:57.455" end="02:57.770">get </span><span begin="02:57.770" end="02:58.141">much </span><span begin="02:58.141" end="03:00.333">higher  </span><span begin="03:00.333" end="03:01.766">yeah</span></p><p ttm:agent="v1" begin="03:01.766" end="03:05.956"><span begin="03:01.766" end="03:02.021">I </span><span begin="03:02.021" end="03:02.329">am </span><span begin="03:02.329" end="03:02.833">not </span><span begin="03:02.833" end="03:03.393">a </span><span begin="03:03.393" end="03:03.707">leader </span><span begin="03:03.707" end="03:04.080">of </span><span begin="03:04.080" end="03:05.956">men</span></p><p ttm:agent="v1" begin="03:05.956" end="03:10.893"><span begin="03:05.956" end="03:06.205">Since </span><span begin="03:06.205" end="03:06.580">I </span><span begin="03:06.580" end="03:06.893">prefer </span><span begin="03:06.893" end="03:07.393">to </span><span begin="03:07.393" end="03:10.893">follow</span></p><p ttm:agent="v1" begin="03:10.893" end="03:15.140"><span begin="03:10.893" end="03:11.147">Do </span><span begin="03:11.147" end="03:11.519">you </span><span begin="03:11.519" end="03:11.833">think </span><span begin="03:11.833" end="03:12.207">I </span><span begin="03:12.207" end="03:12.520">could </span><span begin="03:12.520" end="03:12.894">have </span><span begin="03:12.894" end="03:13.205">a </span><span begin="03:13.205" end="03:15.140">drink</span></p><p ttm:agent="v1" begin="03:15.140" end="03:22.205"><span begin="03:15.140" end="03:15.460">Since </span><span begin="03:15.460" end="03:15.765">it's </span><span begin="03:15.765" end="03:16.205">so </span><span begin="03:16.205" end="03:16.453">hard </span><span begin="03:16.453" end="03:16.769">to </span><span begin="03:16.769" end="03:22.205">swallow</span></p><p ttm:agent="v1" begin="03:22.205" end="03:26.080"><span begin="03:22.205" end="03:22.640">So </span><span begin="03:22.640" end="03:23.458">hard </span><span begin="03:23.458" end="03:23.833">to </span><span begin="03:23.833" end="03:26.080">swallow</span></p></div></body></tt>