<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Hakuna Matata</ttm:title><ttm:agent type="person" xml:id="v1">Nathan Lane</ttm:agent><ttm:agent type="person" xml:id="v2">Ernie Sabella</ttm:agent><ttm:agent type="person" xml:id="v3">Jason Weaver</ttm:agent><ttm:agent type="person" xml:id="v4">Joseph Williams</ttm:agent><ttm:item type="album">The Lion King</ttm:item><ttm:item type="spotify_id">5k3U0OGYBccHdKJJu3HrUN</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.000" end="00:06.390"><span begin="00:00.000" end="00:01.290">Hakuna </span><span begin="00:01.290" end="00:02.130">Matata  </span><span begin="00:02.130" end="00:03.570">what </span><span begin="00:03.570" end="00:03.630">a </span><span begin="00:03.630" end="00:04.410">wonderful </span><span begin="00:04.410" end="00:06.390">phrase</span></p><p ttm:agent="v1" begin="00:06.390" end="00:11.460"><span begin="00:06.390" end="00:07.170">Hakuna </span><span begin="00:07.170" end="00:07.860">Matata  </span><span begin="00:07.860" end="00:09.090">ain't </span><span begin="00:09.090" end="00:09.360">no </span><span begin="00:09.360" end="00:10.020">passing </span><span begin="00:10.020" end="00:11.460">craze</span></p><p ttm:agent="v1" begin="00:12.240" end="00:17.940"><span begin="00:12.240" end="00:12.420">It </span><span begin="00:12.420" end="00:12.810">means </span><span begin="00:12.810" end="00:13.110">no </span><span begin="00:13.110" end="00:14.340">worries </span><span begin="00:14.340" end="00:14.940">for </span><span begin="00:14.940" end="00:15.120">the </span><span begin="00:15.120" end="00:15.600">rest </span><span begin="00:15.600" end="00:15.690">of </span><span begin="00:15.690" end="00:15.990">your </span><span begin="00:15.990" end="00:17.940">days</span></p><p ttm:agent="v1" begin="00:18.090" end="00:40.590"><span begin="00:18.090" end="00:18.540">It's </span><span begin="00:18.540" end="00:18.840">our </span><span begin="00:18.840" end="00:19.380">problem </span><span begin="00:19.380" end="00:21.600">free </span><span begin="00:21.600" end="00:23.640">philosophy  </span><span begin="00:23.640" end="00:24.480">Hakuna </span><span begin="00:24.480" end="00:40.590">Matata</span></p><p ttm:agent="v1" begin="00:40.590" end="00:44.070"><span begin="00:40.590" end="00:41.580">Why  </span><span begin="00:41.580" end="00:41.940">when </span><span begin="00:41.940" end="00:42.240">he </span><span begin="00:42.240" end="00:42.510">was </span><span begin="00:42.510" end="00:42.570">a </span><span begin="00:42.570" end="00:42.990">young </span><span begin="00:42.990" end="00:44.070">warthog</span></p><p ttm:agent="v1" begin="00:44.490" end="00:46.650"><span begin="00:44.490" end="00:44.910">When </span><span begin="00:44.910" end="00:45.270">I </span><span begin="00:45.270" end="00:45.510">was </span><span begin="00:45.510" end="00:45.660">a </span><span begin="00:45.660" end="00:46.200">young </span><span begin="00:46.200" end="00:46.650">warthog</span></p><p ttm:agent="v1" begin="00:48.450" end="00:49.950"><span begin="00:48.450" end="00:48.750">Very </span><span begin="00:48.750" end="00:49.200">nice  </span><span begin="00:49.200" end="00:49.950">thanks</span></p><p ttm:agent="v1" begin="00:50.310" end="00:52.830"><span begin="00:50.310" end="00:50.550">He </span><span begin="00:50.550" end="00:50.970">found </span><span begin="00:50.970" end="00:51.120">his </span><span begin="00:51.120" end="00:51.540">aroma </span><span begin="00:51.540" end="00:51.810">lacked </span><span begin="00:51.810" end="00:51.870">a </span><span begin="00:51.870" end="00:52.260">certain </span><span begin="00:52.260" end="00:52.830">appeal</span></p><p ttm:agent="v1" begin="00:52.860" end="00:55.530"><span begin="00:52.860" end="00:52.980">He </span><span begin="00:52.980" end="00:53.160">could </span><span begin="00:53.160" end="00:53.490">clear </span><span begin="00:53.490" end="00:53.580">the </span><span begin="00:53.580" end="00:54.240">Savannah </span><span begin="00:54.240" end="00:54.660">after </span><span begin="00:54.660" end="00:55.200">every </span><span begin="00:55.200" end="00:55.530">meal</span></p><p ttm:agent="v1" begin="00:55.560" end="01:00.570"><span begin="00:55.560" end="00:55.740">I'm </span><span begin="00:55.740" end="00:55.860">a </span><span begin="00:55.860" end="00:56.490">sensitive </span><span begin="00:56.490" end="00:57.630">soul  </span><span begin="00:57.630" end="00:57.900">though </span><span begin="00:57.900" end="00:58.020">I </span><span begin="00:58.020" end="00:58.470">seem </span><span begin="00:58.470" end="00:58.800">thick</span><span begin="00:58.800" end="00:58.830">-</span><span begin="00:58.830" end="01:00.570">skinned</span></p><p ttm:agent="v1" begin="01:01.650" end="01:06.480"><span begin="01:01.650" end="01:01.830">And </span><span begin="01:01.830" end="01:01.980">it </span><span begin="01:01.980" end="01:02.910">hurt </span><span begin="01:02.910" end="01:03.060">that </span><span begin="01:03.060" end="01:03.210">my </span><span begin="01:03.210" end="01:03.690">friends </span><span begin="01:03.690" end="01:03.930">never </span><span begin="01:03.930" end="01:04.440">stood </span><span begin="01:04.440" end="01:06.480">downwind</span></p><p ttm:agent="v1" begin="01:06.840" end="01:10.080"><span begin="01:06.840" end="01:07.140">And </span><span begin="01:07.140" end="01:07.770">oh  </span><span begin="01:07.770" end="01:07.950">the </span><span begin="01:07.950" end="01:09.030">shame  </span><span begin="01:09.030" end="01:09.180">he </span><span begin="01:09.180" end="01:09.570">was </span><span begin="01:09.570" end="01:10.080">ashamed</span></p><p ttm:agent="v1" begin="01:10.080" end="01:12.750"><span begin="01:10.080" end="01:10.290">Thoughta </span><span begin="01:10.290" end="01:10.740">changin' </span><span begin="01:10.740" end="01:10.950">my </span><span begin="01:10.950" end="01:11.820">name  </span><span begin="01:11.820" end="01:11.850">oh  </span><span begin="01:11.850" end="01:12.210">what's </span><span begin="01:12.210" end="01:12.330">in </span><span begin="01:12.330" end="01:12.390">a </span><span begin="01:12.390" end="01:12.750">name</span></p><p ttm:agent="v1" begin="01:12.780" end="01:16.620"><span begin="01:12.780" end="01:12.930">And </span><span begin="01:12.930" end="01:13.050">I </span><span begin="01:13.050" end="01:13.350">got </span><span begin="01:13.350" end="01:14.430">downhearted  </span><span begin="01:14.430" end="01:14.640">how </span><span begin="01:14.640" end="01:14.790">did </span><span begin="01:14.790" end="01:14.910">you </span><span begin="01:14.910" end="01:15.540">feel  </span><span begin="01:15.540" end="01:15.810">Every </span><span begin="01:15.810" end="01:16.170">time </span><span begin="01:16.170" end="01:16.290">that </span><span begin="01:16.290" end="01:16.620">I</span></p><p ttm:agent="v1" begin="01:16.620" end="01:19.980"><span begin="01:16.620" end="01:16.993">Pumbaa  </span><span begin="01:16.993" end="01:17.366">not </span><span begin="01:17.366" end="01:17.739">in </span><span begin="01:17.739" end="01:18.112">front </span><span begin="01:18.112" end="01:18.485">of </span><span begin="01:18.485" end="01:18.858">the </span><span begin="01:18.858" end="01:19.231">kids  </span><span begin="01:19.231" end="01:19.604">oh </span><span begin="01:19.604" end="01:19.980">sorry</span></p><p ttm:agent="v1" begin="01:19.980" end="01:25.500"><span begin="01:19.980" end="01:20.640">Hakuna </span><span begin="01:20.640" end="01:22.380">Matata  </span><span begin="01:22.380" end="01:22.740">what </span><span begin="01:22.740" end="01:22.830">a </span><span begin="01:22.830" end="01:23.700">wonderful </span><span begin="01:23.700" end="01:25.500">phrase</span></p><p ttm:agent="v1" begin="01:25.500" end="01:30.570"><span begin="01:25.500" end="01:26.190">Hakuna </span><span begin="01:26.190" end="01:26.970">Matata  </span><span begin="01:26.970" end="01:28.080">ain't </span><span begin="01:28.080" end="01:28.410">no </span><span begin="01:28.410" end="01:29.130">passing </span><span begin="01:29.130" end="01:30.570">craze</span></p><p ttm:agent="v1" begin="01:31.140" end="01:36.630"><span begin="01:31.140" end="01:31.290">It </span><span begin="01:31.290" end="01:31.710">means </span><span begin="01:31.710" end="01:32.010">no </span><span begin="01:32.010" end="01:33.330">worries </span><span begin="01:33.330" end="01:33.810">for </span><span begin="01:33.810" end="01:34.050">the </span><span begin="01:34.050" end="01:34.470">rest </span><span begin="01:34.470" end="01:34.530">of </span><span begin="01:34.530" end="01:34.710">your </span><span begin="01:34.710" end="01:35.280">days  </span><span begin="01:35.280" end="01:35.610">yeah  </span><span begin="01:35.610" end="01:35.970">sing </span><span begin="01:35.970" end="01:36.150">it  </span><span begin="01:36.150" end="01:36.630">kid</span></p><p ttm:agent="v1" begin="01:36.960" end="02:29.130"><span begin="01:36.960" end="01:43.481">It's </span><span begin="01:43.481" end="01:50.002">our </span><span begin="01:50.002" end="01:56.523">problem</span><span begin="01:56.523" end="02:03.044">-</span><span begin="02:03.044" end="02:09.565">free </span><span begin="02:09.565" end="02:16.086">philosophy  </span><span begin="02:16.086" end="02:22.607">Hakuna </span><span begin="02:22.607" en