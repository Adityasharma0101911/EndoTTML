:08.460">）</span></p><p ttm:agent="v1" begin="00:08.460" end="00:08.550"><span begin="00:08.460" end="00:08.550">Oh</span></p><p ttm:agent="v1" begin="00:12.150" end="00:14.280"><span begin="00:12.150" end="00:12.600">Come </span><span begin="00:12.600" end="00:12.870">on</span><span begin="00:12.870" end="00:12.960">, </span><span begin="00:12.960" end="00:13.320">shake </span><span begin="00:13.320" end="00:13.590">that  </span><span begin="00:13.590" end="00:13.820">（</span><span begin="00:13.820" end="00:14.050">Uh</span><span begin="00:14.050" end="00:14.280">）</span></p><p ttm:agent="v1" begin="00:14.280" end="00:16.680"><span begin="00:14.280" end="00:14.730">Put </span><span begin="00:14.730" end="00:14.810">*</span><span begin="00:14.810" end="00:14.890">*</span><span begin="00:14.890" end="00:14.970">*</span><span begin="00:14.970" end="00:15.060">* </span><span begin="00:15.060" end="00:15.210">in </span><span begin="00:15.210" end="00:15.270">ya </span><span begin="00:15.300" end="00:15.630">life </span><span begin="00:15.630" end="00:15.780">if </span><span begin="00:15.780" end="00:15.900">you're </span><span begin="00:15.900" end="00:16.500">lonely </span><span begin="00:16.500" end="00:16.560">（</span><span begin="00:16.560" end="00:16.620">MhM</span><span begin="00:16.620" end="00:16.680">）</span></p><p ttm:agent="v1" begin="00:16.680" end="00:19.050"><span begin="00:16.680" end="00:16.950">Bring </span><span begin="00:16.950" end="00:17.010">a </span><span begin="00:17.010" end="00:17.280">fan </span><span begin="00:17.310" end="00:17.490">'cause </span><span begin="00:17.490" end="00:17.580">I </span><span begin="00:17.580" end="00:17.850">know </span><span begin="00:17.850" end="00:18.060">that </span><span begin="00:18.060" end="00:18.180">you </span><span begin="00:18.180" end="00:18.420">want </span><span begin="00:18.420" end="00:18.960">me </span><span begin="00:18.960" end="00:18.990">（</span><span begin="00:18.990" end="00:19.020">Uh</span><span begin="00:19.020" end="00:19.050">）</span></p><p ttm:agent="v1" begin="00:19.050" end="00:21.210"><span begin="00:19.050" end="00:19.500">Uh</span><span begin="00:19.500" end="00:19.530">, </span><span begin="00:19.530" end="00:19.770">give </span><span begin="00:19.770" end="00:20.070">into </span><span begin="00:20.070" end="00:20.190">it </span><span begin="00:20.190" end="00:20.310">'til </span><span begin="00:20.310" end="00:20.400">the </span><span begin="00:20.400" end="00:21.210">mornin'</span></p><p ttm:agent="v1" begin="00:21.240" end="00:22.800"><span begin="00:21.240" end="00:21.570">I </span><span begin="00:21.570" end="00:21.840">love </span><span begin="00:21.840" end="00:21.990">when </span><span begin="00:21.990" end="00:22.110">you </span><span begin="00:22.110" end="00:22.290">do </span><span begin="00:22.290" end="00:22.530">that </span><span begin="00:22.530" end="00:22.800">there</span></p><p ttm:agent="v1" begin="00:22.920" end="00:25.170"><span begin="00:22.920" end="00:23.220">Pretty </span><span begin="00:23.220" end="00:23.490">face</span><span begin="00:23.490" end="00:23.490">, </span><span begin="00:23.490" end="00:23.820">small </span><span begin="00:23.820" end="00:24.090">waist </span><span begin="00:24.090" end="00:24.240">with </span><span begin="00:24.240" end="00:24.360">your </span><span begin="00:24.360" end="00:24.600">feet </span><span begin="00:24.600" end="00:24.720">in </span><span begin="00:24.720" end="00:24.840">the </span><span begin="00:24.840" end="00:25.170">air</span></p><p ttm:agent="v1" begin="00:25.230" end="00:29.730"><span begin="00:25.230" end="00:25.500">Like</span><span begin="00:25.500" end="00:25.560">, </span><span begin="00:25.560" end="00:26.010">uh</span><span begin="00:26.010" end="00:26.040">, </span><span begin="00:26.040" end="00:26.340">love </span><span begin="00:26.370" end="00:26.490">when </span><span begin="00:26.490" end="00:26.580">they </span><span begin="00:26.580" end="00:26.880">stop </span><span begin="00:26.880" end="00:27.030">and </span><span begin="00:27.030" end="00:27.330">stare</span><span begin="00:27.330" end="00:27.480">, </span><span begin="00:27.480" end="00:27.660">all </span><span begin="00:27.660" end="00:27.780">the </span><span begin="00:27.780" end="00:28.050">ugly </span><span begin="00:28.050" end="00:28.090">*</span><span begin="00:28.090" end="00:28.130">*</span><span begin="00:28.130" end="00:28.170">*</span><span begin="00:28.170" end="00:28.210">*</span><span begin="00:28.210" end="00:28.250">*</span><span begin="00:28.250" end="00:28.290">*</span><span begin="00:28.290" end="00:28.350">* </span><span begin="00:28.350" end="00:28.620">lookin'</span><span begin="00:28.620" end="00:28.620">, </span><span begin="00:28.620" end="00:28.890">like</span><span begin="00:28.890" end="00:28.890">, </span><span begin="00:28.890" end="00:28.890">"</span><span begin="00:28.890" end="00:29.130">That </span><span begin="00:29.130" end="00:29.310">ain't </span><span begin="00:29.310" end="00:29.670">fair</span><span begin="00:29.670" end="00:29.730">"</span></p><p ttm:agent="v1" begin="00:29.730" end="00:34.230"><span begin="00:29.730" end="00:30.030">Like</span><span begin="00:30.030" end="00:30.090">, </span><span begin="00:30.090" end="00:30.540">uh</span><span begin="00:30.540" end="00:30.570">, </span><span begin="00:30.570" end="00:30.900">hood </span><span begin="00:30.900" end="00:30.930">*</span><span begin="00:30.930" end="00:30.960">*</span><span begin="00:30.960" end="00:30.990">*</span><span begin="00:30.990" end="00:31.020">*</span><span begin="00:31.020" end="00:31.050">*</span><span begin="00:31.050" end="00:31.080">*</span><span begin="00:31.080" end="00:31.110">* </span><span begin="00:31.110" end="00:31.410">swing </span><span begin="00:31.410" end="00:31.560">they </span><span begin="00:31.560" end="00:31.920">hair</span><span begin="00:31.920" end="00:31.950">, </span><span begin="00:31.950" end="00:32.190">grip </span><span begin="00:32.190" end="00:32.280">the </span><span begin="00:32.280" end="00:32.580">sheets </span><span begin="00:32.580" end="00:32.730">with </span><span begin="00:32.730" end="00:32.910">them </span><span begin="00:32.910" end="00:33.240">long</span><span begin="00:33.240" end="00:33.240">-</span><span begin="00:33.240" end="00:33.450">ass </span><span begin="00:33.450" end="00:34.230">fingernails</span></p><p ttm:agent="v1" begin="00:34.290" end="00:36.930"><span begin="00:34.290" end="00:34.560">Like</span><span begin="00:34.560" end="00:34.620">, </span><span begin="00:34.620" end="00:35.040">uh</span><span begin="00:35.040" end="00:35.070">, </span><span begin="00:35.070" end="00:35.400">hold </span><span begin="00:35.400" end="00:35.640">up</span><span begin="00:35.640" end="00:35.730">, </span><span begin="00:35.730" end="00:36.210">uh</span><span begin="00:36.210" end="00:36.270">, </span><span begin="00:36.270" end="00:36.450">give </span><span begin="00:36.450" end="00:36.570">it </span><span begin="00:36.570" end="00:36.750">to </span><span begin="00:36.750" end="00:36.930">'em</span></p><p ttm:agent="v1" begin="00:36.930" end="00:37.530"><span begin="00:36.930" end="00:36.990">Uh</span><span begin="00:36.990" end="00:37.050">, </span><span begin="00:37.050" end="00:37.110">uh</span><span begin="00:37.110" end="00:37.170">, </span><span begin="00:37.170" end="00:37.230">uh</span><span begin="00:37.230" end="00:37.290">, </span><span begin="00:37.290" end="00:37.350">uh </span><span begin="00:37.350" end="00:37.410">（</span><span begin="00:37.410" end="00:37.470">Oh</span><span begin="00:37.470" end="00:37.530">）</span></p><p ttm:agent="v1" begin="00:39.390" end="00:41.610"><span begin="00:39.390" end="00:39.660">It's </span><span begin="00:39.660" end="00:40.260">getting </span><span begin="00:40.260" end="00:40.620">hot </span><span begin="00:40.620" end="00:40.860">in </span><span begin="00:40.860" end="00:41.430">here </span><span begin="00:41.430" end="00:41.470">（</span><span begin="00:41.470" end="00:41.510">So </span><span begin="00:41.510" end="00:41.560">hot</span><span begin="00:41.560" end="00:41.610">）</span></p><p ttm:agent="v1" begin="00:41.610" end="00:43.650"><span begin="00:41.610" end="00:41.910">So </span><span begin="00:41.910" end="00:42.300">take </span><span begin="00:42.300" end="00:42.540">off </span><span begin="00:42.540" end="00:42.780">all </span><span begin="00:42.780" end="00:43.020">your </span><span begin="00:43.020" end="00:43.650">clothes</span></p><p ttm:agent="v1" begin="00:43.650" end="00:48.390"><span begin="00:43.650" end="00:43.940">（</span><span begin="00:43.940" end="00:44.230">I </span><span begin="00:44.230" end="00:44.520">am </span><span begin="00:44.520" end="00:44.810">getting </span><span begin="00:44.810" end="00:45.100">so </span><span begin="00:45.100" end="00:45.390">hot</span><span begin="00:45.390" end="00:45.680">, </span><span begin="00:45.680" end="00:45.970">I </span><span begin="00:45.970" end="00:46.260">wanna </span><span begin="00:46.260" end="00:46.550">take </span><span begin="00:46.550" end="00:46.840">my </span><span begin="00:46.840" end="00:47.130">cloth</span><span begin="00:47.130" end="00:47.420">е</span><span begin="00:47.420" end="00:47.710">s </span><span begin="00:47.710" end="00:48.080">off</span><span begin="00:48.080" end="00:48.390">）</span></p><p ttm:agent="v1" begin="00:48.390" end="00:50.640"><span begin="00:48.390" end="00:48.720">Get </span><span begin="00:48.720" end="00:49.470">naked</span><span begin="00:49.470" end="00:49.500">, </span><span begin="00:49.500" end="00:49.800">big </span><span begin="00:49.800" end="00:50.610">shaker </span><span begin="00:50.610" end="00:50.620">（</span><span begin="00:50.620" end="00:50.630">Ayy</span><span begin="00:50.630" end="00:50.640">）</span></p><p ttm:agent="v1" begin="00:50.640" end="00:52.680"><span begin="00:50.640" end="00:50.970">Bring </span><span begin="00:50.970" end="00:51.150">big </span><span begin="00:51.180" end="00:51.570">mama </span><span begin="00:51.570" end="00:51.750">if </span><span begin="00:51.750" end="00:51.780">sh</span><span begin="00:51.780" end="00:51.960">е </span><span begin="00:51.960" end="00:52.110">can </span><span begin="00:52.110" end="00:52.470">take </span><span begin="00:52.470" end="00:52.680">it</span></p><p ttm:agent="v1" begin="00:52.680" end="00:53.190"><span begin="00:52.680" end="00:52.710">（</span><span begin="00:52.710" end="00:52.740">I </span><span begin="00:52.740" end="00:52.770">am </span><span begin="00:52.770" end="00:52.800">getting </span><span begin="00:52.800" end="00:52.830">so </span><span begin="00:52.830" end="00:52.860">hot</span><span begin="00:52.860" end="00:52.890">, </span><span begin="00:52.890" end="00:52.920">I </span><span begin="00:52.920" end="00:52.950">wanna </span><span begin="00:52.950" end="00:52.980">take </span><span begin="00:52.980" end="00:53.010">my </span><span begin="00:53.010" end="00:53.040">clothes </span><span begin="00:53.040" end="00:53.160">off</span><span begin="00:53.160" end="00:53.190">）</span></p><p ttm:agent="v1" begin="00:57.180" end="01:01.590"><span begin="00:57.180" end="00:57.570">Ring </span><span begin="00:57.570" end="00:58.140">around </span><span begin="00:58.140" end="00:58.260">the </span><span begin="00:58.320" end="00:58.860">Rosie</span><span begin="00:58.860" end="00:58.890">, </span><span begin="00:58.890" end="00:59.250">cut </span><span begin="00:59.250" end="00:59.430">the </span><span begin="00:59.430" end="00:59.850">toes</span><span begin="00:59.850" end="00:59.850">, </span><span begin="00:59.850" end="01:00.000">and </span><span begin="01:00.000" end="01:00.420">put </span><span begin="01:00.420" end="01:00.570">it </span><span begin="01:00.630" end="01:01.200">on </span><span begin="01:01.200" end="01:01.590">me</span></p><p ttm:agent="v1" begin="01:01.650" end="01:06.240"><span begin="01:01.650" end="