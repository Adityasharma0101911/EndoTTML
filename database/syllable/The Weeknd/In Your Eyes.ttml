80" end="00:33.780">I'd </span><span begin="00:33.780" end="00:34.380">rather </span><span begin="00:34.380" end="00:35.430">be</span><span begin="00:35.430" end="00:36.000">so </span><span begin="00:36.000" end="00:38.010">oblivious</span></p><p ttm:agent="v1" begin="00:38.040" end="00:42.900"><span begin="00:38.040" end="00:38.610">I'd </span><span begin="00:38.610" end="00:39.210">rather </span><span begin="00:39.210" end="00:40.200">be </span><span begin="00:40.200" end="00:40.920">with </span><span begin="00:40.920" end="00:42.900">you</span></p><p ttm:agent="v1" begin="00:43.650" end="00:45.780"><span begin="00:43.650" end="00:43.860">When</span><span begin="00:43.860" end="00:43.980">it's </span><span begin="00:43.980" end="00:44.520">said</span><span begin="00:44.520" end="00:44.550">, </span><span begin="00:44.550" end="00:44.760">when </span><span begin="00:44.760" end="00:44.910">it's </span><span begin="00:44.910" end="00:45.510">done</span><span begin="00:45.510" end="00:45.510">, </span><span begin="00:45.510" end="00:45.780">yeah</span></p><p ttm:agent="v1" begin="00:46.050" end="00:48.210"><span begin="00:46.050" end="00:46.290">I </span><span begin="00:46.290" end="00:46.470">don't </span><span begin="00:46.470" end="00:46.920">ever </span><span begin="00:46.920" end="00:47.490">wanna </span><span begin="00:47.490" end="00:48.210">know</span></p><p ttm:agent="v1" begin="00:48.480" end="00:50.580"><span begin="00:48.480" end="00:48.600">I </span><span begin="00:48.600" end="00:48.750">can </span><span begin="00:48.750" end="00:49.350">tell </span><span begin="00:49.350" end="00:49.560">what </span><span begin="00:49.560" end="00:49.650">you </span><span begin="00:49.650" end="00:50.280">done</span><span begin="00:50.280" end="00:50.280">, </span><span begin="00:50.280" end="00:50.580">yeah</span></p><p ttm:agent="v1" begin="00:50.610" end="00:52.140"><span begin="00:50.610" end="00:51.090">When </span><span begin="00:51.090" end="00:51.180">I </span><span begin="00:51.180" end="00:51.600">look </span><span begin="00:51.600" end="00:51.840">at </span><span begin="00:51.840" end="00:52.140">you</span></p><p ttm:agent="v1" begin="00:52.140" end="00:54.480"><span begin="00:52.140" end="00:52.410">In </span><span begin="00:52.410" end="00:52.770">your </span><span begin="00:52.770" end="00:54.480">eyes</span></p><p ttm:agent="v1" begin="00:55.080" end="00:58.800"><span begin="00:55.080" end="00:55.230">I </span><span begin="00:55.230" end="00:55.710">see </span><span begin="00:55.710" end="00:55.920">there's </span><span begin="00:55.920" end="00:56.550">something </span><span begin="00:56.550" end="00:57.270">burning </span><span begin="00:57.270" end="00:58.440">inside </span><span begin="00:58.440" end="00:58.800">you</span></p><p ttm:agent="v1" begin="00:59.310" end="01:01.440"><span begin="00:59.310" end="00:59.640">Oh</span><span begin="00:59.640" end="00:59.640">, </span><span begin="00:59.640" end="01:00.840">inside </span><span begin="01:00.840" end="01:01.440">you</span></p><p ttm:agent="v1" begin="01:01.680" end="01:08.520"><span begin="01:01.680" end="01:01.980">In </span><span begin="01:01.980" end="01:02.370">your </span><span begin="01:02.370" end="01:04.530">eyes</span><span begin="01:04.530" end="01:04.650">, </span><span begin="01:04.650" end="01:04.920">I </span><span begin="01:04.920" end="01:05.370">know </span><span begin="01:05.370" end="01:05.580">it </span><span begin="01:05.580" end="01:05.910">hurts </span><span begin="01:05.910" end="01:06.030">to </span><span begin="01:06.030" end="01:06.510">smile </span><span begin="01:06.510" end="01:06.810">but </span><span begin="01:06.810" end="01:06.960">you </span><span begin="01:06.960" end="01:07.920">try </span><span begin="01:07.920" end="01:08.520">to</span></p><p ttm:agent="v1" begin="01:08.880" end="01:11.070"><span begin="01:08.880" end="01:09.150">Oh</span><span begin="01:09.150" end="01:09.150">, </span><span begin="01:09.150" end="01:0