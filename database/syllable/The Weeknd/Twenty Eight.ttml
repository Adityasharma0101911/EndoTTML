6.590" end="01:36.920">wanna </span><span begin="01:36.920" end="01:36.980">f</span><span begin="01:36.980" end="01:37.400">*</span><span begin="01:37.400" end="01:37.790">ck</span></p><p ttm:agent="v1" begin="01:37.790" end="01:39.260"><span begin="01:37.790" end="01:37.880">Girl </span><span begin="01:37.880" end="01:37.970">you </span><span begin="01:37.970" end="01:38.420">could've </span><span begin="01:38.420" end="01:38.660">been </span><span begin="01:38.660" end="01:38.930">the </span><span begin="01:38.930" end="01:39.260">one</span></p><p ttm:agent="v1" begin="01:39.260" end="01:41.450"><span begin="01:39.260" end="01:39.500">Now </span><span begin="01:39.500" end="01:39.770">gotta </span><span begin="01:39.770" end="01:40.100">change </span><span begin="01:40.100" end="01:40.250">my </span><span begin="01:40.250" end="01:40.760">number </span><span begin="01:40.760" end="01:41.060">twice </span><span begin="01:41.060" end="01:41.150">a </span><span begin="01:41.150" end="01:41.450">month</span></p><p ttm:agent="v1" begin="01:41.450" end="01:43.910"><span begin="01:41.450" end="01:41.570">When </span><span begin="01:41.570" end="01:41.660">you </span><span begin="01:41.660" end="01:41.930">could </span><span begin="01:41.930" end="01:42.020">have </span><span begin="01:42.020" end="01:42.560">simply </span><span begin="01:42.560" end="01:42.800">kept </span><span begin="01:42.800" end="01:43.070">me </span><span begin="01:43.070" end="01:43.280">on </span><span begin="01:43.280" end="01:43.460">the </span><span begin="01:43.460" end="01:43.820">down </span><span begin="01:43.820" end="01:43.910">low</span></p><p ttm:agent="v1" begin="01:43.940" end="01:47.900"><span begin="01:43.940" end="01:44.270">I'm </span><span begin="01:44.270" end="01:44.870">so </span><span begin="01:44.870" end="01:45.770">wrong</span><span begin="01:45.770" end="01:45.800">, </span><span begin="01:45.800" end="01:46.040">I'm </span><span begin="01:46.040" end="01:46.700">so </sp