<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>I Was Never There</ttm:title><ttm:agent type="group" xml:id="v1">The Weeknd, Gesaffelstein</ttm:agent><ttm:item type="album">My Dear Melancholy,</ttm:item><ttm:item type="spotify_id">5rgnyXr2PXFWsAnPFew077</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:34.670" end="00:43.280"><span begin="00:34.670" end="00:35.270">What </span><span begin="00:35.270" end="00:35.630">makes </span><span begin="00:35.630" end="00:35.990">a </span><span begin="00:35.990" end="00:36.860">grown </span><span begin="00:36.860" end="00:37.160">man </span><span begin="00:37.160" end="00:38.090">wanna </span><span begin="00:38.090" end="00:40.250">cry</span><span begin="00:40.250" end="00:40.260">? </span><span begin="00:40.260" end="00:40.280">（</span><span begin="00:40.280" end="00:41.420">Cry</span><span begin="00:41.420" end="00:41.420">, </span><span begin="00:41.420" end="00:41.720">cry</span><span begin="00:41.720" end="00:41.720">, </span><span begin="00:41.720" end="00:42.500">cry</span><span begin="00:42.500" end="00:42.500">, </span><span begin="00:42.500" end="00:43.250">cry</span><span begin="00:43.250" end="00:43.280">）</span></p><p ttm:agent="v1" begin="00:43.280" end="00:51.770"><span begin="00:43.280" end="00:43.790">What </span><span begin="00:43.790" end="00:44.210">makes </span><span begin="00:44.210" end="00:44.600">him </span><span begin="00:44.600" end="00:45.620">wanna </span><span begin="00:45.620" end="00:46.580">take </span><span begin="00:46.580" end="00:46.820">his </span><span begin="00:46.820" end="00:48.290">life</span><span begin="00:48.290" end="00:48.750">? </span><span begin="00:48.750" end="00:49.220">（</span><span begin="00:49.220" end="00:51.740">Yeah</span><span begin="00:51.740" end="00:51.770">）</span></p><p ttm:agent="v1" begin="00:51.770" end="01:00.440"><span begin="00:51.770" end="00:52.310">His </span><span begin="00:52.310" end="00:53.960">happiness </span><span begin="00:53.960" end="00:54.290">is </span><span begin="00:54.290" end="00:55.310">never </span><span begin="00:55.310" end="00:56.450">real </span><span begin="00:56.450" end="00:56.450">（</span><span begin="00:56.450" end="00:57.380">real</span><span begin="00:57.380" end="00:57.410">, </span><span begin="00:57.410" end="00:58.460">real</span><span begin="00:58.460" end="00:58.520">, </span><span begin="00:58.520" end="00:59.750">real</span><span begin="00:59.750" end="00:59.750">, </span><span begin="00:59.750" end="01:00.380">real</span><span begin="01:00.380" end="01:00.440">）</span></p><p ttm:agent="v1" begin="01:00.440" end="01:07.820"><span begin="01:00.440" end="01:00.950">And </span><span begin="01:00.950" end="01:02.510">mindless </span><span begin="01:02.510" end="01:02.520">*</span><span begin="01:02.520" end="01:02.530">*</span><span begin="01:02.530" end="01:02.540">* </span><span begin="01:02.540" end="01:02.840">is </span><span begin="01:02.840" end="01:03.590">how </span><span begin="01:03.590" end="01:03.860">he </span><span begin="01:03.860" end="01:04.850">feels</span><span begin="01:04.850" end="01:04.850">, </span><span begin="01:04.850" end="01:04.880">ooh</span><span begin="01:04.880" end="01:04.910">, </span><span begin="01:04.910" end="01:07.520">he </span><span begin="01:07.520" end="01:07.820">feels</span></p><p ttm:agent="v1" begin="01:07.850" end="01:11.870"><span begin="01:07.850" end="01:08.215">When </span><span begin="01:08.215" end="01:08.580">it's </span><span begin="01:08.580" end="01:08.945">time</span><span begin="01:08.945" end="01:09.310">, </span><span begin="01:09.310" end="01:09.675">when </span><span begin="01:09.675" end="01:10.040">it's </span><span begin="01:10.040" end="01:10.405">time</span><span begin="01:10.405" end="01:10.770">, </span><span begin="01:10.770" end="01:11.135">when </span><span begin="01:11.135" end="01:11.500">it's </span><span begin="01:11.500" end="01:11.870">time</span></p><p ttm:agent="v1" begin="01:11.900" end="01:14.120"><span begin="01:11.900" end="01:12.230">It </span><span begin="01:12.230" end="01:12.380">won't </span><span begin="01:12.380" end="01:13.220">matter </span><span begin="01:13.220" end="01:13.220">（</span><span begin="01:13.220" end="01:13.280">it </span><span begin="01:13.280" end="01:13.430">don't </span><span begin="01:13.430" end="01:14.120">matter</span><span begin="01:14.120" end="01:14.120">）</span></p><p ttm:agent="v1" begin="01:14.120" end="01:16.520"><span begin="01:14.120" end="01:14.360">It </span><span begin="01:14.360" end="01:14.570">won't </span><span begin="01:14.570" end="01:15.650">matter </span><span begin="01:15.650" end="01:15.650">（</span><span begin="01:15.650" end="01:16.520">matter</span><span begin="01:16.520" end="01:16.520">）</span></p><p ttm:agent="v1" begin="01:16.520" end="01:20.510"><span begin="01:16.520" end="01:16.754">When </span><span begin="01:16.754" end="01:16.988">it's </span><span begin="01:16.988" end="01:17.222">time</span><span begin="01:17.222" end="01:17.456">, </span><span begin="01:17.456" end="01:17.690">when </span><span begin="01:17.690" end="01:17.924">it's </span><span begin="01:17.924" end="01:18.158">time</span><span begin="01:18.158" end="01:18.392">, </span><span begin="01:18.392" end="01:18.626">when </span><span begin="01:18.626" end="01:18.860">it's </span><span begin="01:18.860" end="01:19.094">time </span><span begin="01:19.094" end="01:19.328">（</span><span begin="01:19.328" end="01:19.562">time</span><span begin="01:19.562" end="01:19.796">, </span><span begin="01:19.796" end="01:20.030">it's </span><span begin="01:20.030" end="01:20.264">time</span><span begin="01:20.264" end="01:20.510">）</span></p><p ttm:agent="v1" begin="01:20.510" end="01:22.640"><span begin="01:20.510" end="01:20.776">It </span><span begin="01:20.776" end="01:21.042">won't </span><span begin="01:21.042" end="01:21.308">matter </span><span begin="01:21.308" end="01:21.574">（</span><span begin="01:21.574" end="01:21.840">it </span><span begin="01:21.840" end="01:22.106">won't </span><span begin="01:22.106" end="01:22.372">matter</span><span begin="01:22.372" end="01:22.640">）</span></p><p ttm:agent="v1" begin="01:22.640" end="01:25.070"><span begin="01:22.640" end="01:22.940">It </span><span begin="01:22.940" end="01:23.150">won't </span><span begin="01:23.150" end="01:24.230">matter </span><span begin="01:24.230" end="01:24.230">（</span><span begin="01:24.230" end="01:24.980">ya</span><span begin="01:24.980" end="01:25.070">）</span></p><p ttm:agent="v1" begin="01:25.070" end="01:27.200"><span begin="01:25.070" end="01:25.374">It </span><span begin="01:25.374" end="01:25.678">was </span><span begin="01:25.678" end="01:25.982">like </span><span begin="01:25.982" end="01:26.286">I </span><span begin="01:26.286" end="01:26.590">was </span><span begin="01:26.590" end="01:26.894">never </span><span begin="01:26.894" end="01:27.200">there</span></p><p ttm:agent="v1" begin="01:27.200" end="01:29.330"><span begin="01:27.200" end="01:27.436">（</span><span begin="01:27.436" end="01:27.672">It </span><span begin="01:27.672" end="01:27.908">was </span><span begin="01:27.908" end="01:28.144">like </span><span begin="01:28.144" end="01:28.380">I </span><span begin="01:28.380" end="01:28.616">was </span><span begin="01:28.616" end="01:28.852">never </span><span begin="01:28.852" end="01:29.088">there</span><span begin="01:29.088" end="01:29.330">）</span></p><p ttm:agent="v1" begin="01:29.330" end="01:32.900"><span begin="01:29.330" end="01:29.450">It </span><span begin="01:29.450" end="01:29.630">was </span><span begin="01:29.630" end="01:30.440">like </span><span begin="01:30.440" end="01:30.500">it </span><span begin="01:30.500" end="01:30.680">was </span><span begin="01:30.680" end="01:31.250">more </span><span begin="01:31.250" end="01:31.430">than </span><span begin="01:31.430" end="01:31.820">thin </span><span begin="01:31.820" end="01:32.510">air</span><span begin="01:32.510" end="01:32.600">, </span><span begin="01:32.600" end="01:32.900">oh</span></p><p ttm:agent="v1" begin="01:33.560" end="01:37.700"><span begin="01:33.560" end="01:33.855">When </span><span begin="01:33.855" end="01:34.150">it's </span><span begin="01:34.150" end="01:34.445">time</span><span begin="01:34.445" end="01:34.740">, </span><span begin="01:34.740" end="01:35.035">when </span><span begin="01:35.035" end="01:35.330">it's </span><span begin="01:35.330" end="01:35.625">time</span><span begin="01:35.625" end="01:35.920">, </span><span begin="01:35.920" end="01:36.215">when </span><span begin="01:36.215" end="01:36.510">it's </span><span begin="01:36.510" end="01:36.805">time</span><span begin="01:36.805" end="01:37.100">, </span><span begin="01:37.100" end="01:37.395">oh </span><span begin="01:37.395" end="01:37.700">baby</span></p><p ttm:agent="v1" begin="01:37.700" end="01:40.040"><span begin="01:37.700" end="01:37.940">It </span><span begin="01:37.940" end="01:38.060">won't </span><span begin="01:38.060" end="01:38.900">matter</span><span begin="01:38.900" end="01:38.900">, </span><span begin="01:38.900" end="01:39.050">it </span><span begin="01:39.050" end="01:39.170">won't </span><span begin="01:39.170" end="01:39.590">matter</span><span begin="01:39.590" end="01:39.590">, </span><span begin="01:39.590" end="01:40.040">baby</span></p><p ttm:agent="v1" begin="01:40.040" end="01:46.280"><span begin="01:40.040" end="01:40.790">When </span><span begin="01:40.790" end="01:40.880">it's </span><span begin="01:40.880" end="01:41.510">time</span><span begin="01:41.510" end="01:41.510">, </span><span begin="01:41.510" end="01:42.290">when </span><span begin="01:42.290" end="01:42.530">it's </span><span begin="01:42.530" end="01:44.270">time</span><span begin="01:44.270" end="01:44.270">, </span><span begin="01:44.270" end="01:44.420">when </span><span begin="01:44.420" end="01:44.780">it's </span><span begin="01:44.780" end="01:46.280">time</span></p><p ttm:agent="v1" begin="01:46.280" end="01:50.540"><span begin="01:46.280" end="01:46.640">It </span><span begin="01:46.640" end="01:46.760">won't </span><span begin="01:46.760" end="01:48.380">matter</span><span begin="01:48.380" end="01:48.380">, </span><span begin="01:48.380" end="01:48.740">it </span><span begin="01:48.740" end="01:48.860">won't </span><span begin="01:48.860" end="01:50.540">matter</span></p><p ttm:agent="v1" begin="01:50.540" end="01:54.890"><span begin="01:50.540" end="01:50.935">When </span><span begin="01:50.935" end="01:51.330">it's </span><span begin="01:51.330" end="01:51.725">time</span><span begin="01:51.725" end="01:52.120">, </span><span begin="01:52.120" end="01:52.515">when </span><span begin="01:52.515" end="01:52.910">it's </span><span begin="01:52.910" end="01:53.305">time</span><span begin="01:53.305" end="01:53.700">, </span><span begin="01:53.700" end="01:54.095">when </span><span begin="01:54.095" end="01:54.490">it's </span><span begin="01:54.490" end="01:54.890">time</span></p><p ttm:agent="v1" begin="01:54.890" end="01:59.420"><span begin="01:54.890" end="01:55.537">It </span><span begin="01:55.537" end="01:56.184">won't </span><span begin="01:56.184" end="01:56.831">matter</span><span begin="01:56.831" end="01:57.478">, </span><span begin="01:57.478" end="01:58.125">it </span><span begin="01:58.125" end="01:58.772">won't </span><span begin="01:58.772" end="01:59.420">matter</span></p><p ttm:agent="v1" begin="01:59.420" end="02:03.470"><span begin="01:59.420" end="01:59.998">It </span><span begin="01:59.998" end="02:00.576">was </span><span begin="02:00.576" end="02:01.154">like </span><span begin="02:01.154" end="02:01.732">I </span><span begin="02:01.732" end="02:02.310">was </span><span begin="02:02.310" end="02:02.888">never </span><span begin="02:02.888" end="02:03.470">there</span></p><p ttm:agent="v1" begin="02:03.470" end="02:07.910"><span begin="02:03.470" end="02:03.680">It </span><span begin="02:03.680" end="02:03.950">was </span><span begin="02:03.950" end="02:04.610">like </span><span begin="02:04.610" end="02:04.790">it </span><span begin="02:04.790" end="02:05.000">was </span><span begin="02:05.000" end="02:05.810">more </span><span begin="02:05.810" end="02:05.930">than </span><span begin="02:05.930" end="02:06.110">thin </span><span begin="02:06.110" end="02:07.910">air</span></p><p ttm:agent="v1" begin="02:07.910" end="02:11.990"><span begin="02:07.910" end="02:08.280">When </span><span begin="02:08.280" end="02:08.650">it's </span><span begin="02:08.650" end="02:09.020">time</span><span begin="02:09.020" end="02:09.390">, </span><span begin="02:09.390" end="02:09.760">when </span><span begin="02:09.760" end="02:10.130">it's </span><span begin="02:10.130" end="02:10.500">time</span><span begin="02:10.500" end="02:10.870">, </span><span begin="02:10.870" end="02:11.240">when </span><span begin="02:11.240" end="02:11.610">it's </span><span begin="02:11.610" end="02:11.990">time</span></p><p ttm:agent="v1" begin="02:11.990" end="02:13.940"><span begin="02:11.990" end="02:12.268">It </span><span begin="02:12.268" end="02:12.546">won't </span><span begin="02:12.546" end="02:12.824">matter</span><span begin="02:12.824" end="02:13.102">, </span><span begin="02:13.102" end="02:13.380">it </span><span begin="02:13.380" end="02:13.658">won't </span><span begin="02:13.658" end="02:13.940">ma