an><span begin="00:57.280" end="00:57.940">me</span></p><p ttm:agent="v1" begin="00:57.970" end="01:01.180"><span begin="00:57.970" end="00:58.840">'Cause </span><span begin="00:58.840" end="00:59.080">I </span><span begin="00:59.080" end="00:59.620">think </span><span begin="00:59.620" end="00:59.860">it's </span><span begin="00:59.860" end="01:00.310">safe </span><span begin="01:00.310" end="01:00.430">to </span><span begin="01:00.430" end="01:01.150">say</span><span begin="01:01.150" end="01:01.150">.</span><span begin="01:01.150" end="01:01.150">.</span><span begin="01:01.150" end="01:01.150">.</span><span begin="01:01.150" end="01:01.180">"</span></p><p ttm:agent="v1" begin="01:01.480" end="01:04.510"><span begin="01:01.480" end="01:01.810">This </span><span begin="01:01.810" end="01:02.440">ain't </span><span begin="01:02.440" end="01:03.700">ordinary </span><span begin="01:03.700" end="01:04.510">life</span></p><p ttm:agent="v1" begin="01:04.720" end="01:07.720"><span begin="01:04.720" end="01:05.020">This </span><span begin="01:05.020" end="01:05.620">ain't </span><span begin="01:05.620" end="01:06.910">ordinary </span><span begin="01:06.910" end="01:07.720">life</span></p><p ttm:agent="v1" begin="01:07.930" end="01:10.870"><span begin="01:07.930" end="01:08.200">This </span><span begin="01:08.200" end="01:08.800">ain't </span><span begin="01:08.800" end="01:10.120">ordinary </span><span begin="01:10.120" end="01:10.870">life</span></p><p ttm:agent="v1" begin="01:11.110" end="01:14.470"><span begin="01:11.110" end="01:11.410">This </span><span begin="01:11.410" end="01:12.010">ain't </span><span begin="01:12.010" end="01:13.300">ordinary </span><span begin="01:13.300" end="01:14.470">life</span></p><p ttm:agent="v1" begin="01:14.890" end="01:17.380"><span begin="01:14.890" end="01:15.250">No </span><span begin="01:15.250" end="01:16.510">ordinary </span><span begin="01:16.510" end="01:17.380">life</span></p><p ttm:agent="v1" begin="01:17.530" end="01:20.500"