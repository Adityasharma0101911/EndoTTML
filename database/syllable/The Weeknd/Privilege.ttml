<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Privilege</ttm:title><ttm:agent type="person" xml:id="v1">The Weeknd</ttm:agent><ttm:item type="album">My Dear Melancholy,</ttm:item><ttm:item type="spotify_id">0Nwar8rweBUyfyuoyjjUvk</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:21.280" end="00:25.270"><span begin="00:21.280" end="00:21.850">Enjoy </span><span begin="00:21.850" end="00:22.060">your </span><span begin="00:22.060" end="00:22.990">privileged </span><span begin="00:22.990" end="00:25.270">life</span></p><p ttm:agent="v1" begin="00:26.320" end="00:31.210"><span begin="00:26.320" end="00:26.620">'Cause </span><span begin="00:26.620" end="00:26.950">I'm </span><span begin="00:26.950" end="00:27.220">not </span><span begin="00:27.220" end="00:28.000">gonna </span><span begin="00:28.000" end="00:28.720">hold </span><span begin="00:28.720" end="00:29.260">you </span><span begin="00:29.260" end="00:29.920">through </span><span begin="00:29.920" end="00:30.130">the </span><span begin="00:30.130" end="00:31.210">night</span></p><p ttm:agent="v1" begin="00:31.510" end="00:35.710"><span begin="00:31.510" end="00:31.660">We </span><span begin="00:31.660" end="00:32.140">said </span><span begin="00:32.140" end="00:32.350">our </span><span begin="00:32.350" end="00:32.680">last </span><span begin="00:32.680" end="00:35.710">goodbyes</span></p><p ttm:agent="v1" begin="00:36.520" end="00:42.790"><span begin="00:36.520" end="00:36.790">So </span><span begin="00:36.790" end="00:37.180">let's </span><span begin="00:37.180" end="00:37.480">just </span><span begin="00:37.480" end="00:37.840">try </span><span begin="00:37.840" end="00:38.320">to </span><span begin="00:38.320" end="00:39.010">end </span><span begin="00:39.010" end="00:39.550">it </span><span begin="00:39.550" end="00:40.240">with </span><span begin="00:40.240" end="00:40.450">a </span><span begin="00:40.450" end="00:42.790">smile</span></p><p ttm:agent="v1" begin="00:43.210" end="00:47.740"><span begin="00:43.210" end="00:43.480">And </span><span begin="00:43.480" end="00:43.600">I </span><span begin="00:43.600" end="00:43.870">don't </span><span begin="00:43.870" end="00:44.470">wanna </span><span begin="00:44.470" end="00:44.770">hear </span><span begin="00:44.770" end="00:45.340">that </span><span begin="00:45.340" end="00:45.550">you </span><span begin="00:45.550" end="00:45.670">are </span><span begin="00:45.670" end="00:47.740">suffering</span></p><p ttm:agent="v1" begin="00:47.770" end="00:52.960"><span begin="00:47.770" end="00:48.070">You </span><span begin="00:48.070" end="00:48.160">are </span><span begin="00:48.160" end="00:50.500">suffering </span><span begin="00:50.500" end="00:51.010">no </span><span begin="00:51.010" end="00:52.960">more</span></p><p ttm:agent="v1" begin="00:53.500" end="00:57.430"><span begin="00:53.500" end="00:53.860">'Cause </span><span begin="00:53.860" end="00:54.040">I </span><span begin="00:54.040" end="00:54.460">held </span><span begin="00:54.460" end="00:54.730">you </span><span begin="00:54.730" end="00:55.030">down </span><span begin="00:55.030" end="00:55.540">when </span><span begin="00:55.540" end="00:55.690">you </span><span begin="00:55.690" end="00:55.840">were </span><span begin="00:55.840" end="00:57.430">suffering</span></p><p ttm:agent="v1" begin="00:58.000" end="01:01.180"><span begin="00:58.000" end="00:58.240">You </span><span begin="00:58.240" end="00:58.420">were </span><span begin="00:58.420" end="01:01.180">suffering</span></p><p ttm:agent="v1" begin="01:01.240" end="01:05.260"><span begin="01:01.240" end="01:01.600">Lose </span><span begin="01:01.600" end="01:01.720">your </span><span begin="01:01.720" end="01:02.530">way</span><span begin="01:02.530" end="01:03.790">, </span><span begin="01:03.790" end="01:04.390">way</span><span begin="01:04.390" end="01:04.390">, </span><span begin="01:04.390" end="01:05.260">way</span></p><p ttm:agent="v1" begin="01:05.950" end="01:10.180"><span begin="01:05.950" end="01:06.040">I </span><span begin="01:06.040" end="01:06.310">got </span><span begin="01:06.310" end="01:07.000">two </span><span begin="01:07.000" end="01:07.600">red </span><span begin="01:07.600" end="01:08.410">pills </span><span begin="01:08.410" end="01:08.590">to </span><span begin="01:08.590" end="01:08.830">take </span><span begin="01:08.830" end="01:08.920">the </span><span begin="01:08.920" end="01:09.340">blues </span><span begin="01:09.340" end="01:10.180">away</span></p><p ttm:agent="v1" begin="01:11.380" end="01:16.090"><span begin="01:11.380" end="01:11.830">Blues </span><span begin="01:11.830" end="01:13.720">away</span><span begin="01:13.720" end="01:13.960">, </span><span begin="01:13.960" end="01:14.620">way</span><span begin="01:14.620" end="01:14.620">, </span><span begin="01:14.620" end="01:16.090">way</span></p><p ttm:agent="v1" begin="01:16.180" end="01:21.190"><span begin="01:16.180" end="01:16.270">I </span><span begin="01:16.270" end="01:16.510">got </span><span begin="01:16.510" end="01:17.830">two </span><span begin="01:17.830" end="01:18.640">red </span><span begin="01:18.640" end="01:18.760">pills </span><span begin="01:18.760" end="01:18.820">to </span><span begin="01:18.820" end="01:19.060">take </span><span begin="01:19.060" end="01:19.150">the </span><span begin="01:19.150" end="01:19.540">blues </span><span begin="01:19.540" end="01:21.190">away</span></p><p ttm:agent="v1" begin="01:21.250" end="01:24.670"><span begin="01:21.250" end="01:21.430">And </span><span begin="01:21.430" end="01:21.910">I'ma </span><span begin="01:21.910" end="01:21.910">*</span><span begin="01:21.910" end="01:21.910">*</span><span begin="01:21.910" end="01:21.910">*</span><span begin="01:21.910" end="01:21.910">* </span><span begin="01:21.910" end="01:22.060">the </span><span begin="01:22.060" end="01:22.330">pain </span><span begin="01:22.330" end="01:22.750">away</span><span begin="01:22.750" end="01:22.750">, </span><span begin="01:22.750" end="01:22.900">and </span><span begin="01:22.900" end="01:22.990">I </span><span begin="01:22.990" end="01:23.350">know </span><span begin="01:23.350" end="01:23.470">I'll </span><span begin="01:23.470" end="01:23.680">be </span><span begin="01:23.680" end="01:24.670">okay</span></p><p ttm:agent="v1" begin="01:26.290" end="01:29.740"><span begin="01:26.290" end="01:26.470">They </span><span begin="01:26.470" end="01:26.740">said </span><span begin="01:26.740" end="01:26.800">our </span><span begin="01:26.800" end="01:27.040">love </span><span begin="01:27.040" end="01:27.130">is </span><span begin="01:27.130" end="01:27.340">just </span><span begin="01:27.340" end="01:27.400">a </span><span begin="01:27.400" end="01:27.880">game</span><span begin="01:27.880" end="01:27.880">, </span><span begin="01:27.880" end="01:27.940">I </span><span begin="01:27.940" end="01:28.090">don't </span><span begin="01:28.090" end="01:28.450">care </span><span begin="01:28.450" end="01:28.690">what </span><span begin="01:28.690" end="01:28.990">they </span><span begin="01:28.990" end="01:29.740">say</span></p><p ttm:agent="v1" begin="01:31.390" end="01:35.470"><span begin="01:31.390" end="01:31.630">But </span><span begin="01:31.630" end="01:31.870">I'ma </span><span begin="01:31.870" end="01:32.140">drink </span><span begin="01:32.140" end="01:32.230">the </span><span begin="01:32.230" end="01:32.500">pain </span><span begin="01:32.500" end="01:32.860">away</span><span begin="01:32.860" end="01:32.950">, </span><span begin="01:32.950" end="01:33.040">I'll </span><span begin="01:33.040" end="01:33.190">be </span><span begin="01:33.190" end="01:33.550">back </span><span begin="01:33.550" end="01:33.700">to </span><span begin="01:33.700" end="01:33.880">my </span><span begin="01:33.880" end="01:34.180">old </span><span begin="01:34.180" end="01:35.470">ways</span></p><p ttm:agent="v1" begin="01:36.490" end="01:49.030"><span begin="01:36.490" end="01:36.730">And </span><span begin="01:36.730" end="01:36.820">I </span><span begin="01:36.820" end="01:37.060">got </span><span begin="01:37.060" end="01:37.600">two </span><span begin="01:37.600" end="01:38.230">red </span><span begin="01:38.230" end="01:39.070">pills </span><span begin="01:39.070" end="01:39.250">to </span><span begin="01:39.250" end="01:39.460">take </span><span begin="01:39.460" end="01:39.580">the </span><span begin="01:39.580" end="01:40.000">blues </span><span begin="01:40.000" end="01:40.450">away</span><span begin="01:40.450" end="01:41.740">, </span><span begin="01:41.740" end="01:49.030">oh</span></p><p ttm:agent="v1" begin="01:49.090" end="01:56.980"><span begin="01:49.090" end="01:49.966">And </span><span begin="01:49.966" end="01:50.842">I </span><span begin="01:50.842" end="01:51.718">don't </span><span begin="01:51.718" end="01:52.594">wanna </span><span begin="01:52.594" end="01:53.470">hear </span><span begin="01:53.470" end="01:54.346">that </span><span begin="01:54.346" end="01:55.222">you </span><span begin="01:55.222" end="01:56.098">are </span><span begin="01:56.098" end="01:56.980">suffering</span></p><p ttm:agent="v1" begin="01:56.980" end="01:59.290"><span begin="01:56.980" end="01:57.442">You </span><span begin="01:57.442" end="01:57.904">are </span><span begin="01:57.904" end="01:58.366">suffering </span><span begin="01:58.366" end="01:58.828">no </span><span begin="01:58.828" end="01:59.290">more</span></p><p ttm:agent="v1" begin="01:59.290" end="02:08.050"><span begin="01:59.290" end="02:00.263">And </span><span begin="02:00.263" end="02:01.236">I </span><span begin="02:01.236" end="02:02.209">don't </span><span begin="02:02.209" end="02:03.182">wanna </span><span begin="02:03.182" end="02:04.155">hear </span><span begin="02:04.155" end="02:05.128">that </span><span begin="02:05.128" end="02:06.101">you </span><span begin="02:06.101" end="02:07.074">are </span><span begin="02:07.074" end="02:08.050">suffering</span></p><p ttm:agent="v1" begin="02:08.110" end="02:12.790"><span begin="02:08.110" end="02:08.290">I </span><span begin="02:08.290" end="02:08.500">don't </span><span begin="02:08.500" end="02:09.190">wanna </span><span begin="02:09.190" end="02:11.260">hear </span><span begin="02:11.260" end="02:11.350">that </span><span begin="02:11.350" end="02:11.590">no </span><span begin="02:11.590" end="02:12.790">more</span></p><p ttm:agent="v1" begin="02:12.790" end="02:14.590"><span begin="02:12.790" end="02:13.150">You </span><span begin="02:13.150" end="02:13.510">are </span><span begin="02:13.510" end="02:13.870">suffering </span><span begin="02:13.870" end="02:14.230">no </span><span begin="02:14.230" end="02:14.590">more</span></p><p ttm:agent="v1" begin="02:14.590" end="02:17.440"><span begin="02:14.590" end="02:14.680">And </span><span begin="02:14.680" end="02:14.710">I </span><span begin="02:14.710" end="02:15.400">don't </span><span begin="02:15.400" end="02:15.580">wanna </span><span begin="02:15.580" end="02:15.760">hear </span><span begin="02:15.760" end="02:16.120">that </span><span begin="02:16.120" end="02:16.240">you </span><span begin="02:16.240" end="02:16.930">are </span><span begin="02:16.930" end="02:17.440">suffering</span></p><p ttm:agent="v1" begin="02:17.440" end="02:19.360"><span begin="02:17.440" end="02:17.824">You </span><span begin="02:17.824" end="02:18.208">are </span><spa