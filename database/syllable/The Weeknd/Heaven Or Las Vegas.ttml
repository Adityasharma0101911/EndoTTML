<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Heaven Or Las Vegas</ttm:title><ttm:agent type="person" xml:id="v1">The Weeknd</ttm:agent><ttm:item type="album">Trilogy</ttm:item><ttm:item type="spotify_id">4WZZeEjRqC4tV8rFljQzEo</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:46.040" end="00:52.130"><span begin="00:46.040" end="00:46.250">I'm </span><span begin="00:46.250" end="00:46.970">paying </span><span begin="00:46.970" end="00:48.560">for </span><span begin="00:48.560" end="00:48.650">all </span><span begin="00:48.650" end="00:48.890">my </span><span begin="00:48.890" end="00:49.850">father's </span><span begin="00:49.850" end="00:52.130">sins</span></p><p ttm:agent="v1" begin="00:52.160" end="00:56.390"><span begin="00:52.160" end="00:52.610">So </span><span begin="00:52.610" end="00:52.760">I </span><span begin="00:52.760" end="00:52.940">will </span><span begin="00:52.940" end="00:53.420">thank </span><span begin="00:53.420" end="00:53.630">him </span><span begin="00:53.630" end="00:54.020">for </span><span begin="00:54.020" end="00:56.390">you</span></p><p ttm:agent="v1" begin="00:56.390" end="01:00.620"><span begin="00:56.390" end="00:56.810">I'ma </span><span begin="00:56.810" end="00:57.260">thank </span><span begin="00:57.260" end="00:57.530">him </span><span begin="00:57.530" end="00:58.100">for </span><span begin="00:58.100" end="01:00.620">you</span></p><p ttm:agent="v1" begin="01:01.400" end="01:07.850"><span begin="01:01.400" end="01:01.610">My </span><span begin="01:01.610" end="01:03.350">serotonin's </span><span begin="01:03.350" end="01:04.160">gone </span><span begin="01:04.160" end="01:04.250">a </span><span begin="01:04.250" end="01:05.120">while </span><span begin="01:05.120" end="01:07.820">ago</span><span begin="01:07.820" end="01:07.850">,</span></p><p ttm:agent="v1" begin="01:07.850" end="01:11.630"><span begin="01:07.850" end="01:08.210">Girl</span><span begin="01:08.210" end="01:08.210">, </span><span begin="01:08.210" end="01:08.390">it's </span><span begin="01:08.390" end="01:08.690">gone </span><span begin="01:08.690" end="01:09.170">cause </span><span begin="01:09.170" end="01:09.650">of </span><span begin="01:09.650" end="01:11.210">you</span><span begin="01:11.210" end="01:11.630">,</span></p><p ttm:agent="v1" begin="01:11.630" end="01:16.340"><span begin="01:11.630" end="01:12.230">It's </span><span begin="01:12.230" end="01:12.590">gone </span><span begin="01:12.590" end="01:13.010">cause </span><span begin="01:13.010" end="01:13.460">of </span><span begin="01:13.460" end="01:15.650">you</span><span begin="01:15.650" end="01:16.340">,</span></p><p ttm:agent="v1" begin="01:16.340" end="01:25.700"><span begin="01:16.340" end="01:16.970">They </span><span begin="01:16.970" end="01:20.390">say</span><span begin="01:20.390" end="01:20.390">, </span><span begin="01:20.390" end="01:20.660">they </span><span begin="01:20.660" end="01:20.960">want </span><span begin="01:20.960" end="01:25.700">heaven</span></p><p ttm:agent="v1" begin="01:25.850" end="01:31.430"><span begin="01:25.850" end="01:26.360">They </span><span begin="01:26.360" end="01:27.920">say</span><span begin="01:27.920" end="01:27.950">, </span><span begin="01:27.950" end="01:28.280">they </span><span begin="01:28.280" end="01:28.580">want </span><span begin="01:28.580" end="01:31.430">God</span></p><p ttm:agent="v1" begin="01:33.650" end="01:40.610"><span begin="01:33.650" end="01:34.070">I </span><span begin="01:34.070" end="01:35.420">say</span><span begin="01:35.420" end="01:35.630">, </span><span begin="01:35.630" end="01:36.050">I </span><span begin="01:36.050" end="01:36.290">have </span><span begin="01:36.290" end="01:40.610">heaven</span></p><p ttm:agent="v1" begin="01:41.570" end="01:44.540"><span begin="01:41.570" end="01:41.660">I </span><span begin="01:41.660" end="01:42.980">say</span><span begin="01:42.980" end="01:43.130">, </span><span begin="01:43.130" end="01:43.460">I </span><span begin="01:43.460" end="01:44.390">am </span><span begin="01:44.390" end="01:44.540">God</span><span begin="01:44.540" end="01:44.540">.</span></p><p ttm:agent="v1" begin="01:44.540" end="02:24.140"><span begin="01:44.540" end="01:44.600">I </span><span begin="01:44.600" end="01:45.620">never </span><span begin="01:45.620" end="01:46.640">prayed </span><span begin="01:46.640" end="02:20.180">a </span><span begin="02:20.180" end="02:21.260">moment </span><span begin="02:21.260" end="02:21.860">in </span><span begin="02:21.860" end="02:22.040">my </span><span begin="02:22.040" end="02:24.140">life</span></p><p ttm:agent="v1" begin="02:24.440" end="02:27.920"><span begin="02:24.440" end="02:24.800">Girl </span><span begin="02:24.800" end="02:24.980">I'm </span><span begin="02:24.980" end="02:25.760">rewarded </span><span begin="02:25.760" end="02:26.150">with </span><span begin="02:26.150" end="02:27.920">you</span></p><p ttm:agent="v1" begin="02:28.220" end="02:32.450"><span begin="02:28.220" end="02:28.550">I've </span><span begin="02:28.550" end="02:28.790">been </span><span begin="02:28.790" end="02:29.630">rewarded </span><span begin="02:29.630" end="02:30.380">with </span><span begin="02:30.380" end="02:32.450">you</span></p><p ttm:agent="v1" begin="02:33.470" end="02:37.520"><span begin="02:33.470" end="02:33.830">So </span><span begin="02:33.830" end="02:34.550">baby </span><span begin="02:34.550" end="02:35.270">let </span><span begin="02:35.270" end="02:35.480">me </span><span begin="02:35.480" end="02:36.530">kiss </span><span begin="02:36.530" end="02:36.740">your </span><span begin="02:36.740" end="02:37.280">inner </span><span begin="02:37.280" end="02:37.520">thigh</span></p><p ttm:agent="v1" begin="02:39.920" end="02:43.670"><span begin="02:39.920" end="02:40.280">Let </span><span begin="02:40.280" end="02:40.490">me </span><span begin="02:40.490" end="02:40.910">kiss </span><span begin="02:40.910" end="02:41.120">it </span><span begin="02:41.120" end="02:41.720">for </span><span begin="02:41.720" end="02:43.670">you</span></p><p ttm:agent="v1" begin="02:43.700" end="02:47.780"><span begin="02:43.700" end="02:44.120">I </span><span begin="02:44.120" end="02:44.360">can </span><span begin="02:44.360" end="02:44.780">kiss </span><span begin="02:44.780" end="02:44.960">it </span><span begin="02:44.960" end="02:45.350">for </span><span begin="02:45.350" end="02:47.780">you</span></p><p ttm:agent="v1" begin="02:48.680" end="02:54.800"><span begin="02:48.680" end="02:49.160">They </span><span begin="02:49.160" end="02:52.550">say</span><span begin="02:52.550" end="02:52.550">, </span><span begin="02:52.550" end="02:52.790">they </span><span begin="02:52.790" end="02:53.060">want </span><span begin="02:53.060" end="02:54.800">heaven</span></p><p ttm:agent="v1" begin="02:58.040" end="03:00.890"><span begin="02:58.040" end="02:58.490">They </span><span begin="02:58.490" end="02:59.810">say</span><span begin="02:59.810" end="03:00.050">, </span><span begin="03:00.050" end="03:00.440">they </span><span begin="03:00.440" end="03:00.740">want </span><span begin="03:00.740" end="03:00.890">God</span></p><p ttm:agent="v1" begin="03:05.690" end="03:10.580"><span begin="03:05.690" end="03:06.110">I </span><span begin="03:06.110" end="03:07.070">say</span><span begin="03:07.070" end="03:07.820">, </span><span begin="03:07.820" end="