<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>ICELAND</ttm:title><ttm:agent type="person" xml:id="v1">Subway Surfers</ttm:agent><ttm:item type="album">Greatest Hits 2020</ttm:item><ttm:item type="spotify_id">5T6Sxgvyk25jSaHF4vFqGc</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1">10 Contributors</p><p ttm:agent="v1">Translations</p><p ttm:agent="v1">English</p><p ttm:agent="v1">Ég Veit Þú Kemur (Live at The Symphony) Lyrics</p><p ttm:agent="v1">[Textar fyrir "Ég Veit Þú Kemur"]</p><p ttm:agent="v1">[Viðlag]</p><p ttm:agent="v1">Ég veit þú kemur í kvöld til mín</p><p ttm:agent="v1">Þótt kveðjan væri stutt í gær</p><p ttm:agent="v1">Ég trúi ekki á orðin þín</p><p ttm:agent="v1">Ef annað segja stjörnur tvær</p><p ttm:agent="v1">[Vísa 1]</p><p ttm:agent="v1">Og þá mun allt verða eins og var</p><p ttm:agent="v1">Sko áður en þú veist, þú veist</p><p ttm:agent="v1">Og þetta eina sem útaf bar</p><p ttm:agent="v1">Okkar á milli í friði leyst</p><p ttm:agent="v1">Og seinna, þegar tunglið hefur tölt um langan veg</p><p ttm:agent="v1">Þá tölum við um drauminn sem við elskum, þú og ég</p><p ttm:agent="v1">[Viðlag]</p><p ttm:agent="v1">Ég veit þú kemur í kvöld til mín</p><p ttm:agent="v1">Þótt kveðjan væri stutt í gær</p><p ttm:agent="v1">Ég trúi ekki á orðin þín</p><p ttm:agent="v1">Ef annað segja stjörnur tvær</p><p ttm:agent="v1">[Hljóðfæraviðlag]</p><p ttm:agent="v1">[Viðlag]</p><p ttm:agent="v1">Ég veit þú kemur í kvöld til mín</p><p ttm:agent="v1">Þótt kveðjan væri stutt í gær</p><p ttm:agent="v1">Ég trúi ekki á orðin þín</p><p ttm:agent="v1">Ef annað segja stjörnur tvær</p></div></body></tt>