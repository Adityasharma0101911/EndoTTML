<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Roshni</ttm:title><ttm:agent type="group" xml:id="v1">Bharg, Chaar Diwaari</ttm:agent><ttm:item type="album">NIKAMMA</ttm:item><ttm:item type="spotify_id">2HG7HYy6d5aVAPoBNdWjs6</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1">{"c":[{"tx":"作词: "},{"tx":"Bharg Kale"},{"tx":"/"},{"tx":"Garv Taneja"}]}</p><p ttm:agent="v1">{"c":[{"tx":"作曲: "},{"tx":"Bharg Kale"},{"tx":"/"},{"tx":"Garv Taneja"}]}</p><p ttm:agent="v1">Hmmm</p><p ttm:agent="v1">One,Two,Three</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">कभी तू मुझे मिलती क्यूँ नहीं</p><p ttm:agent="v1">तभी तो मेरे दिल की दिल लगी</p><p ttm:agent="v1">ख़फ़ा वो मुझसे रहने लगी</p><p ttm:agent="v1">Ya,aah</p><p ttm:agent="v1">टूटी शाम मेरी बाहों में</p><p ttm:agent="v1">खो गया हूँ मैं ग़ुम काली राहों में</p><p ttm:agent="v1">आ तू मुझको ढूंढ़ले कहा हूँ मैं</p><p ttm:agent="v1">सुन सा पड़ा हूँ मैं</p><p ttm:agent="v1">नापता जहां हूँ मैं</p><p ttm:agent="v1">मेरी आँखें मुड़ी सारी दिशाओं में</p><p ttm:agent="v1">खोजा तुझको सारी खलाओं में</p><p ttm:agent="v1">दिन रात तू कहा पे छिपा है</p><p ttm:agent="v1">रोशनी कहा है</p><p ttm:agent="v1">रोशनी कहा है</p><p ttm:agent="v1">रोशनी दिखती नहीं</p><p ttm:agent="v1">मुझको क्यूँ मिलती नहीं</p><p ttm:agent="v1">आवारा मैं बैठा हूँ</p><p ttm:agent="v1">कोई है संग नहीं</p><p ttm:agent="v1">Life में रंग नहीं</p><p ttm:agent="v1">करना तू तंग नहीं</p><p ttm:agent="v1">अभी तो आजा darling</p><p ttm:agent="v1">मुझमें है क्या ही कमी</p><p ttm:agent="v1">तू ही तो guide है</p><p ttm:agent="v1">Side by side रेहले तू</p><p ttm:agent="v1">Baby मेरी light जो</p><p ttm:agent="v1">करदे मेरे मन को white white</p><p ttm:agent="v1">Wash, और देदे मुझको एक सुकून की</p><p ttm:agent="v1">Night, I don't want to cry all the time</p><p ttm:agent="v1">हो</p><p ttm:agent="v1">दिन से जहां रातें मिले</p><p ttm:agent="v1">वहाँ पे हूँ खड़ा</p><p ttm:agent="v1">हो</p><p ttm:agent="v1">मुझसे मिल जा</p><p ttm:agent="v1">हो</p><p ttm:agent="v1">तुमसे करूँ बातें</p><p ttm:agent="v1">तू कहा पे है बता</p><p ttm:agent="v1">हो</p><p ttm:agent="v1">मुझसे मिल जा</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">कभी तू मुझे मिलती क्यूँ नहीं (नहीं,नहीं,नहीं,नहीं,नहीं)</p><p ttm:agent="v1">तभी तो मेरे दिल की दिल लगी</p><p ttm:agent="v1">ख़फ़ा वो मुझसे रहने लगी (लगी,लगी,लगी,लगी,लगी,लगी)</p><p ttm:agent="v1">भारी शाम का पल्ला</p><p ttm:agent="v1">दिवारी फिर रह गया कल्ला woah</p><p ttm:agent="v1">वापिस आया खाया हर गली धक्का माया नगरी का बच्चा आके लफड़ों में फ़सा ऐसा</p><p ttm:agent="v1">क्या बे साला तू कहा पे है छुपा</p><p ttm:agent="v1">वो कौन थी बला जो तू यहाँ से दफ़ा ऐसा</p><p ttm:agent="v1">क्या गिला तूने मुझसे लगाया बस कला है बचा जो तू घर भी ना आया आजा</p><p ttm:agent="v1">आजा आजा</p><p ttm:agent="v1">बन जा मेरा ख़्वाजा</p><p ttm:agent="v1">ओ चमकती रानी</p><p ttm:agent="v1">कुछ रस्ता दिखा जा</p><p ttm:agent="v1">मुझे दिक़्क़तें बड़ी है</p><p ttm:agent="v1">जीने का हल ही नहीं है</p><p ttm:agent="v1">सर पीट पीट के हुई</p><p ttm:agent="v1">Injury बड़ी है</p><p ttm:agent="v1">मुझे पट्टी करादे</p><p ttm:agent="v1">अरे मलहम् तो लगा दे</p><p ttm:agent="v1">जानेजा ओ सनम अनदेखा ना तू कर</p><p ttm:agent="v1">मेरी भोली सी शकल</p><p ttm:agent="v1">है तू थोड़ा मान जा</p><p ttm:agent="v1">अरे रोशनी तू अब ऐसे ना सता</p><p ttm:agent="v1">हो</p><p ttm:agent="v1">दिन से जहां रातें मिलें</p><p ttm:agent="v1">वहाँ पे हूँ खड़ा</p><p ttm:agent="v1">हो</p><p ttm:agent="v1">मुझसे मिल जा</p><p ttm:agent="v1">हो</p><p ttm:agent="v1">तुमसे करूँ बातें</p><p ttm:agent="v1">तू कहा पे</p><p ttm:agent="v1">है बता</p><p ttm:agent="v1">हो</p><p ttm:agent="v1">मुझसे मिल जा</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">मुझे दिख जा तू अभी अभी</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">मुझे दिख जा तू अभी अभी</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">रोशनी मुझे दिखती क्यूँ नहीं</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">रोशनी मुझे दिखती क्यूँ नहीं</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">रोशनी मुझे दिखती क्यूँ नहीं</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">रोशनी</p><p ttm:agent="v1">रोशनी</p></div></body></tt>