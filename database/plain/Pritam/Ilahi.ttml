<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Ilahi</ttm:title><ttm:agent type="group" xml:id="v1">Pritam, Arijit Singh, Amitabh Bhattacharya</ttm:agent><ttm:item type="album">Yeh Jawaani Hai Deewani</ttm:item><ttm:item type="spotify_id">5cgKosPPj5Cs9a2JQufUc1</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1">6 Contributors</p><p ttm:agent="v1">Translations</p><p ttm:agent="v1">Romanization</p><p ttm:agent="v1">Ilahi Lyrics</p><p ttm:agent="v1">[Intro]</p><p ttm:agent="v1">Ooh-aah, ooh-aah</p><p ttm:agent="v1">Ooh-aah, ooh-aah</p><p ttm:agent="v1">[Pre-Chorus]</p><p ttm:agent="v1">शामें मलंग सी, रातें सुरंग सी</p><p ttm:agent="v1">बाग़ी उड़ान पे ही ना जाने क्यूँ</p><p ttm:agent="v1">[Chorus]</p><p ttm:agent="v1">इलाही, मेरा जी आए-आए</p><p ttm:agent="v1">इलाही, मेरा जी आए-आए</p><p ttm:agent="v1">[Verse]</p><p ttm:agent="v1">कल पे सवाल है, जीना फ़िलहाल है</p><p ttm:agent="v1">ख़ाना-बदोशियों पे ही जाने क्यूँ</p><p ttm:agent="v1">[Chorus]</p><p ttm:agent="v1">इलाही, मेरा जी आए-आए</p><p ttm:agent="v1">इलाही, मेरा जी आए-आए</p><p ttm:agent="v1">[Instrumental-break]</p><p ttm:agent="v1">[Verse]</p><p ttm:agent="v1">मेरा फ़लसफ़ा, कंधे पे मेरा बस्ता</p><p ttm:agent="v1">चला मैं जहाँ ले चला मुझे रस्ता</p><p ttm:agent="v1">बूँदों पे नहीं, गहरे समुंदर पे</p><p ttm:agent="v1">Whoa-ooh, whoa-oh[Chorus]</p><p ttm:agent="v1">इलाही, मेरा जी आए-आए</p><p ttm:agent="v1">इलाही, मेरा जी आए-आए</p><p ttm:agent="v1">इलाही, मेरा जी आए-आए</p><p ttm:agent="v1">इलाही, मेरा जी आए-आए</p><p ttm:agent="v1">[Pre-Chorus]</p><p ttm:agent="v1">शामें मलंग सी, रातें सुरंग सी</p><p ttm:agent="v1">बाग़ी उड़ान पे ही ना जाने क्यूँ</p><p ttm:agent="v1">[Chorus]</p><p ttm:agent="v1">इलाही, मेरा जी आए-आए</p><p ttm:agent="v1">इलाही, मेरा जी आए-आए</p><p ttm:agent="v1">[Outro]</p><p ttm:agent="v1">Ooh-aah, ooh-aah</p><p ttm:agent="v1">Ooh-aah, ooh-aah, yeah</p><p ttm:agent="v1">Ooh, aah</p></div></body></tt>