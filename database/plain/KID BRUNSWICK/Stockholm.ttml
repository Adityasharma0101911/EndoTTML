<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Stockholm</ttm:title><ttm:agent type="person" xml:id="v1">KID BRUNSWICK</ttm:agent><ttm:item type="album">Dead Forever</ttm:item><ttm:item type="spotify_id">13VXK1nqx17VvtieDirwXi</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1">{"c":[{"tx":"作词: "},{"tx":"Harry James"},{"tx":"/"},{"tx":"Cody Colacino"},{"tx":"/"},{"tx":"Kill Vein"}]}</p><p ttm:agent="v1">{"c":[{"tx":"作曲: "},{"tx":"Harry James"},{"tx":"/"},{"tx":"Cody Colacino"},{"tx":"/"},{"tx":"Kill Vein"}]}</p><p ttm:agent="v1">I’m burning down</p><p ttm:agent="v1">And I cannot stop this falling</p><p ttm:agent="v1">Are you coming over? Tell me x2</p><p ttm:agent="v1">I’ve been dealing with a lot</p><p ttm:agent="v1">And it’s making me sick girl</p><p ttm:agent="v1">Yeah you know I got problems</p><p ttm:agent="v1">I’ve been on the other side of the world</p><p ttm:agent="v1">For a year now</p><p ttm:agent="v1">I’ve been living in Stockholm</p><p ttm:agent="v1">I’m losing all my friends</p><p ttm:agent="v1">Sleeping through the daylight</p><p ttm:agent="v1">I spent a fortune on a therapist</p><p ttm:agent="v1">So everything will be fine</p><p ttm:agent="v1">I’m burning down</p><p ttm:agent="v1">And I cannot stop this falling</p><p ttm:agent="v1">Are you coming over? Tell me</p><p ttm:agent="v1">I’ve been dealing with a lot</p><p ttm:agent="v1">And it’s making me sick girl</p><p ttm:agent="v1">Yeah you know I got problems</p><p ttm:agent="v1">I’ve been on the other side of the world</p><p ttm:agent="v1">For a year now</p><p ttm:agent="v1">I’ve been living in Stockholm</p><p ttm:agent="v1">I wish I could go back into the past baby</p><p ttm:agent="v1">I know that somethings are too late to change</p><p ttm:agent="v1">And we’ve only got one cigarette</p><p ttm:agent="v1">So make it last baby</p><p ttm:agent="v1">Cos it’s better to burn than to fade away</p><p ttm:agent="v1">I’m burning down</p><p ttm:agent="v1">And I cannot stop this falling</p><p ttm:agent="v1">Are you coming over? Tell me X2</p><p ttm:agent="v1">I’ve been living in Stockholm</p><p ttm:agent="v1">I’ve been living in Stockholm</p><p ttm:agent="v1">I’ve been living in Stockholm</p><p ttm:agent="v1">I’ve been living in Stockholm</p><p ttm:agent="v1">I’m losing all my friends</p><p ttm:agent="v1">Sleeping through the daylight</p><p ttm:agent="v1">I spent a fortune on a therapist</p><p ttm:agent="v1">So everything will be fine</p><p ttm:agent="v1">I’ve been living in Stockholm</p></div></body></tt>