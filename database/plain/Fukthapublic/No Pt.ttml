<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>No Pt</ttm:title><ttm:agent type="person" xml:id="v1">Fukthapublic</ttm:agent><ttm:agent type="person" xml:id="v2">Nomorefent_zach</ttm:agent><ttm:item type="album">No Pt</ttm:item><ttm:item type="spotify_id">40IbqRvsrxSWsBiCvpjLmO</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1">7 Contributors</p><p ttm:agent="v1">Regina nopții Lyrics</p><p ttm:agent="v1">[Versuri „Regina nopții”]</p><p ttm:agent="v1">[Intro]</p><p ttm:agent="v1">Ooh, ea e regina nopții, ea tot mă instigă</p><p ttm:agent="v1">Se uită în ochii mei, e cu crucea pe limbă</p><p ttm:agent="v1">Ca pe animale, mă demonizează</p><p ttm:agent="v1">Îmi șoptește ușor că ne vedem diseară, ooh</p><p ttm:agent="v1">[Refren]</p><p ttm:agent="v1">Face figuri, e bagaboantă</p><p ttm:agent="v1">Mă lasă cu semne pe față</p><p ttm:agent="v1" itunes:key="role" itunes:value="background">Mă ține până dimineață (Ooh)</p><p ttm:agent="v1" itunes:key="role" itunes:value="background">Și îmi face sufletu' gheață (Ooh)</p><p ttm:agent="v1">[Post-refren]</p><p ttm:agent="v1">Ye, ye, e regina nopții</p><p ttm:agent="v1">Ye, ye, e regina nopții</p><p ttm:agent="v1">Ye, ye, e regina nopții</p><p ttm:agent="v1">Îi bag pula-n pizdă, se futе cu morții</p><p ttm:agent="v1">[Strofa 1]</p><p ttm:agent="v1">În city, Bucharest</p><p ttm:agent="v1">Vezi ce faci să n-o vеzi</p><p ttm:agent="v1">Dacă o vezi, te pierzi</p><p ttm:agent="v1">Cur mare pus în dres</p><p ttm:agent="v1">Pizdă moartă cu Rolex</p><p ttm:agent="v1">Linii mari după Coldrex</p><p ttm:agent="v1" itunes:key="role" itunes:value="background">După papă Prazolex (Ooh)</p><p ttm:agent="v1">Bagaboante, pastile, banii pe mine, nu mai dau bile</p><p ttm:agent="v1">Clica fute regine, în multe vile, cară și kile</p><p ttm:agent="v1">Seara suntem torpile, pline de sine, nu face bine, yeah[Refren]</p><p ttm:agent="v1">Face figuri, e bagaboantă</p><p ttm:agent="v1">Mă lasă cu semne pe față</p><p ttm:agent="v1" itunes:key="role" itunes:value="background">Mă ține până dimineață (Ooh)</p><p ttm:agent="v1" itunes:key="role" itunes:value="background">Și îmi face sufletu' gheață (Ooh)</p><p ttm:agent="v1">[Pre-refren]</p><p ttm:agent="v1">Se mișcă bruneta</p><p ttm:agent="v1">Îi place fenta</p><p ttm:agent="v1" itunes:key="role" itunes:value="background">Stă după mine că vrea (Vrea)</p><p ttm:agent="v1">Vrea verigheta</p><p ttm:agent="v1">[Refren]</p><p ttm:agent="v1">Face figuri, e bagaboantă</p><p ttm:agent="v1">Mă lasă cu semne pe față</p><p ttm:agent="v1" itunes:key="role" itunes:value="background">Mă ține până dimineață (Ooh)</p><p ttm:agent="v1" itunes:key="role" itunes:value="background">Și îmi face sufletu' gheață (Ooh)</p><p ttm:agent="v1">Face figuri, e bagaboantă</p><p ttm:agent="v1">Mă lasă cu semne pe față</p><p ttm:agent="v1" itunes:key="role" itunes:value="background">Mă ține până dimineață (Ooh)</p><p ttm:agent="v1" itunes:key="role" itunes:value="background">Și îmi face sufletu' gheață (Ooh)</p><p ttm:agent="v1">[Post-refren]</p><p ttm:agent="v1">Ye, ye, e regina nopții</p><p ttm:agent="v1">Ye, ye, e regina nopții</p><p ttm:agent="v1">Ye, ye, e regina nopții</p><p ttm:agent="v1">Îi bag pula-n pizdă, se fute cu morții[Strofa 2]</p><p ttm:agent="v1">Se mișcă prea bine când o fac</p><p ttm:agent="v1">Tot ce fac eu, știi că fac cu cap</p><p ttm:agent="v1">Ojă, unghii, asta-mi face cap</p><p ttm:agent="v1">Îi place, mă vede detașat</p><p ttm:agent="v1">Fac linii cu ea în ghetou</p><p ttm:agent="v1">Nu pot, tre' s-o văd din nou</p><p ttm:agent="v1">Regina nopții, stau cu ea în studio</p><p ttm:agent="v1">Mă face pe la spate, crede, d-am făcut-o eu, brrr</p><p ttm:agent="v1">[Pre-refren]</p><p ttm:agent="v1">Se mișcă bruneta</p><p ttm:agent="v1">Îi place fenta</p><p ttm:agent="v1" itunes:key="role" itunes:value="background">Stă după mine că vrea (Vrea)</p><p ttm:agent="v1">Vrea verigheta</p><p ttm:agent="v1">[Refren]</p><p ttm:agent="v1">Face figuri, e bagaboantă</p><p ttm:agent="v1">Mă lasă cu semne pe față</p><p ttm:agent="v1" itunes:key="role" itunes:value="background">Mă ține până dimineață (Ooh)</p><p ttm:agent="v1" itunes:key="role" itunes:value="background">Și îmi face sufletu' gheață (Ooh)</p><p ttm:agent="v1">Face figuri, e bagaboantă</p><p ttm:agent="v1">Mă lasă cu semne pe față</p><p ttm:agent="v1" itunes:key="role" itunes:value="background">Mă ține până dimineață (Ooh)</p><p ttm:agent="v1" itunes:key="role" itunes:value="background">Și îmi face sufletu' gheață (Ooh)[Post-refren]</p><p ttm:agent="v1">Ye, ye, e regina nopții</p><p ttm:agent="v1">Ye, ye, e regina nopții</p><p ttm:agent="v1">Ye, ye, e regina nopții</p><p ttm:agent="v1">Îi bag pula-n pizdă, se fute cu morții</p><p ttm:agent="v1">Ye, ye, e regina nopții</p><p ttm:agent="v1">Ye, ye, e regina nopții</p><p ttm:agent="v1">Ye, ye, e regina nopții</p><p ttm:agent="v1">Îi bag pula-n pizdă, se fute cu morții</p></div></body></tt>