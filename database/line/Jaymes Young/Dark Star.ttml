<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Dark Star</ttm:title><ttm:agent type="person" xml:id="v1">Jaymes Young</ttm:agent><ttm:item type="album">Dark Star</ttm:item><ttm:item type="spotify_id">1VTxq4gRIoTSgmbO5ttMoI</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:08.880" end="00:16.880">I’ve looked a long time to find you</p><p ttm:agent="v1" begin="00:17.080" end="00:20.330">I drifted through the universe</p><p ttm:agent="v1" begin="00:20.330" end="00:22.560">Just to lay</p><p ttm:agent="v1" begin="00:22.560" end="00:25.760">Beside you</p><p ttm:agent="v1" begin="00:25.760" end="00:29.200">Anywhere you want me to take you</p><p ttm:agent="v1" begin="00:29.200" end="00:33.840">I’ll go, yeah</p><p ttm:agent="v1" begin="00:33.840" end="00:36.600">But there’s things about me</p><p ttm:agent="v1" begin="00:36.600" end="00:42.040">that you just don’t know</p><p ttm:agent="v1" begin="00:42.040" end="00:45.760">If I told you where I’ve been</p><p ttm:agent="v1" begin="00:45.760" end="00:50.200">Would you still call me baby</p><p ttm:agent="v1" begin="00:50.200" end="00:54.480">And if I told you everything</p><p ttm:agent="v1" begin="00:54.480" end="00:57.600">Would you call me crazy</p><p ttm:agent="v1" begin="00:57.600" end="01:00.440">Cause baby I’m a dark star</p><p ttm:agent="v1" begin="01:00.440" end="01:05.960">dark star ohh</p><p ttm:agent="v1" begin="01:05.960" end="01:08.880">Cause baby I’m a dark star</p><p ttm:agent="v1" begin="01:08.880" end="01:16.880">dark star ohh</p><p ttm:agent="v1" begin="01:24.920" end="01:32.000">My heart was borne out of the fire</p><p ttm:agent="v1" begin="01:32.000" end="01:36.240">I lost love a thousand years ago</p><p ttm:agent="v1" begin="01:36.240" end="01:41.520">And still, I can’t find her</p><p ttm:agent="v1" begin="01:41.520" end="01:49.520">Now I don’t love like I used to ohh</p><p ttm:agent="v1" begin="01:50.240" end="01:52.440">But I’ve got stories</p><p ttm:agent="v1" begin="01:52.440" end="01:57.800">I could tell you if I want to</p><p ttm:agent="v1" begin="01:57.800" end="02:01.560">If I told you where I’ve been</p><p ttm:agent="v1" begin="02:01.560" end="02:06.040">Would you still call me baby</p><p ttm:agent="v1" begin="02:06.040" end="02:10.280">And if I told you everything</p><p ttm:agent="v1" begin="02:10.280" end="02:13.400">Would you call me crazy</p><p ttm:agent="v1" begin="02:13.400" end="02:16.240">Cause baby I’m a dark star</p><p ttm:agent="v1" begin="02:16.240" end="02:21.760">dark star ohh</p><p ttm:agent="v1" begin="02:21.760" end="02:24.680">Cause baby I’m a dark star</p><p ttm:agent="v1" begin="02:24.680" end="02:32.680">dark star ohh</p><p ttm:agent="v1" begin="02:56.760" end="03:00.480">If I told you where I’ve been</p><p ttm:agent="v1" begin="03:00.480" end="03:05.080">Would you still call me baby</p><p ttm:agent="v1" begin="03:05.080" end="03:09.240">And if I told you everything</p><p ttm:agent="v1" begin="03:09.240" end="03:12.320">Would you call me crazy</p><p ttm:agent="v1" begin="03:12.320" end="03:15.200">Cause baby I’m a dark star</p><p ttm:agent="v1" begin="03:15.200" end="03:20.680">dark star ohh</p><p ttm:agent="v1" begin="03:20.680" end="03:23.600">Cause baby I’m a dark star</p><p ttm:agent="v1" begin="03:23.600" end="03:29.040">dark star ohh</p><p ttm:agent="v1" begin="03:29.040" end="03:32.000">Cause baby I’m a dark star</p><p ttm:agent="v1" begin="03:32.000" end="03:37.480">dark star ohh</p><p ttm:agent="v1" begin="03:37.480" end="03:40.400">Cause baby I’m a dark star</p><p ttm:agent="v1" begin="03:40.400" end="03:44.400">dark star ohh</p></div></body></tt>