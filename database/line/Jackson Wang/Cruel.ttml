<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Cruel</ttm:title><ttm:agent type="person" xml:id="v1">Jackson Wang</ttm:agent><ttm:item type="album">MAGIC MAN</ttm:item><ttm:item type="spotify_id">1FQbRZmWwAbZqSBp2nO5Iq</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:12.010" end="00:17.830">I'm coming back to you</p><p ttm:agent="v1" begin="00:17.830" end="00:20.820">And I hope you don't mind</p><p ttm:agent="v1" begin="00:20.820" end="00:24.370">That I'm wasting your time</p><p ttm:agent="v1" begin="00:24.370" end="00:29.890">I know you want me too</p><p ttm:agent="v1" begin="00:29.890" end="00:32.800">Even though you're not mine</p><p ttm:agent="v1" begin="00:32.800" end="00:35.190">You got that look in your eyes</p><p ttm:agent="v1" begin="00:35.190" end="00:37.420">Come on, tell me where you at</p><p ttm:agent="v1" begin="00:37.420" end="00:38.920">When you're back</p><p ttm:agent="v1" begin="00:38.530" end="00:41.580">I won't keep you up, take a nap</p><p ttm:agent="v1" begin="00:41.580" end="00:45.550">A little gasoline and a match</p><p ttm:agent="v1" begin="00:45.550" end="00:52.820">You just like it better when it's cold</p><p ttm:agent="v1" begin="00:52.820" end="01:00.820" /><p ttm:agent="v1" begin="01:26.440" end="01:29.750">This ain't what you want</p><p ttm:agent="v1" begin="01:29.750" end="01:32.500" /><p ttm:agent="v1" begin="01:32.500" end="01:38.790">This is what you need</p><p ttm:agent="v1" begin="01:38.790" end="01:44.620">Wake up in the morning</p><p ttm:agent="v1" begin="01:44.620" end="01:49.280">Know just what ya need, need, need, need</p><p ttm:agent="v1" begin="01:49.280" end="01:53.550">I'm coming back to you</p><p ttm:agent="v1" begin="01:53.550" end="01:57.610">So I really hope that you don't mind</p><p ttm:agent="v1" begin="01:57.610" end="02:01.420" /><p ttm:agent="v1" begin="02:01.420" end="02:06.910">I know you want me too</p><p ttm:agent="v1" begin="02:06.910" end="02:09.920">Even though you're not mine</p><p ttm:agent="v1" begin="02:09.920" end="02:12.290">You got that look in your eyes</p><p ttm:agent="v1" begin="02:12.290" end="02:14.770">Can you remember when I crossed it?</p><p ttm:agent="v1" begin="02:14.770" end="02:16.350">Put the sweat up in this</p><p ttm:agent="v1" begin="02:16.350" end="02:17.850">Like a mosh pit</p><p ttm:agent="v1" begin="02:17.740" end="02:19.240">Think I'm done up in this</p><p ttm:agent="v1" begin="02:19.210" end="02:20.710">Don't you stop me</p><p ttm:agent="v1" begin="02:20.660" end="02:22.600">Don't wanna see you throw a fit</p><p ttm:agent="v1" begin="02:22.600" end="02:26.300">You just like it better when it's cold</p><p ttm:agent="v1" begin="02:26.300" end="02:30.300" /></div></body></tt>