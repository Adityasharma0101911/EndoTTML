<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Know My Name</ttm:title>
      <ttm:agent type="person" xml:id="v1">Joe Dreamz</ttm:agent>
      <ttm:item type="album">Know My Name</ttm:item>
      <ttm:item type="spotify_id">5oB48ObaYix9YiAJOzanZL</ttm:item>
      <itunes:duration>03:08.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:11.340" end="00:13.810" ttm:agent="v1">I be posting everyday</p>
      <p begin="00:13.810" end="00:16.550" ttm:agent="v1">I be performing on the streets</p>
      <p begin="00:16.550" end="00:18.810" ttm:agent="v1">I be living on the road</p>
      <p begin="00:18.810" end="00:21.380" ttm:agent="v1">Everywhere I go I make a scene</p>
      <p begin="00:21.380" end="00:23.860" ttm:agent="v1">I love to be the center of attention</p>
      <p begin="00:23.860" end="00:26.580" ttm:agent="v1">I'm kinda narcissistic I admit it</p>
      <p begin="00:26.580" end="00:28.940" ttm:agent="v1">I'm never giving up I stay persistent</p>
      <p begin="00:28.940" end="00:32.180" ttm:agent="v1">Their opinion of me doesn't make a difference</p>
      <p begin="00:32.180" end="00:33.720" ttm:agent="v1">I ain't letting nothin stop me</p>
      <p begin="00:33.720" end="00:36.460" ttm:agent="v1">Hundred thousand followers gettin lil cocky</p>
      <p begin="00:36.460" end="00:39.360" ttm:agent="v1">All around the world every planet every galaxy</p>
      <p begin="00:39.360" end="00:42.410" ttm:agent="v1">Make sure they know my name</p>
      <p begin="00:42.410" end="00:44.550" ttm:agent="v1">They was sleepin now they awake</p>
      <p begin="00:44.550" end="00:47.750" ttm:agent="v1">Make sure they know my name</p>
      <p begin="00:47.750" end="00:49.730" ttm:agent="v1">Game will never be the same</p>
      <p begin="00:49.730" end="00:53.080" ttm:agent="v1">Make sure they know my name</p>
      <p begin="00:53.080" end="00:55.040" ttm:agent="v1">Not just here to entertain</p>
      <p begin="00:55.040" end="00:58.290" ttm:agent="v1">Make sure they know my name</p>
      <p begin="00:58.290" end="01:00.220" ttm:agent="v1">Look at what I overcame</p>
      <p begin="01:00.220" end="01:02.240" ttm:agent="v1">Make sure they know</p>
      <p begin="01:02.240" end="01:05.180" ttm:agent="v1">My Professor had a dream about me said I was on stage</p>
      <p begin="01:05.180" end="01:08.050" ttm:agent="v1">Lots of people in the crowd everything going great</p>
      <p begin="01:08.050" end="01:09.550" ttm:agent="v1">That's a Sign from God</p>
      <p begin="01:09.230" end="01:10.730" ttm:agent="v1">I know Ima make it</p>
      <p begin="01:10.630" end="01:13.280" ttm:agent="v1">Any barrier they put in front of me I'll break it</p>
      <p begin="01:13.280" end="01:15.850" ttm:agent="v1">I be knocking on the door don't wait for invitation</p>
      <p begin="01:15.850" end="01:18.350" ttm:agent="v1">Realist rapper in the game for your information</p>
      <p begin="01:18.350" end="01:21.070" ttm:agent="v1">I know they waiting on my downfall anticipatin</p>
      <p begin="01:21.070" end="01:22.570" ttm:agent="v1">But like jesus said</p>
      <p begin="01:22.320" end="01:23.820" ttm:agent="v1">Get behind me satan</p>
      <p begin="01:23.710" end="01:26.210" ttm:agent="v1">There's a seed in me that wants to turn into a tree</p>
      <p begin="01:26.210" end="01:28.840" ttm:agent="v1">That gon bear fruit that the whole world can eat</p>
      <p begin="01:28.840" end="01:31.260" ttm:agent="v1">Affirmations every day no limiting beliefs</p>
      <p begin="01:31.260" end="01:33.120" ttm:agent="v1">I am Joe Dreamz</p>
      <p begin="01:33.120" end="01:38.120" ttm:agent="v1">I want them to remember me for centuries</p>
      <p begin="01:38.120" end="01:41.930" ttm:agent="v1">I want them to remember me for centuries</p>
      <p begin="01:41.930" end="01:45.110" ttm:agent="v1">Make sure they know my name</p>
      <p begin="01:45.110" end="01:47.270" ttm:agent="v1">They was sleepin now they awake</p>
      <p begin="01:47.270" end="01:50.320" ttm:agent="v1">Make sure they know my name</p>
      <p begin="01:50.320" end="01:52.430" ttm:agent="v1">Game will never be the same</p>
      <p begin="01:52.430" end="01:55.530" ttm:agent="v1">Make sure they know my name</p>
      <p begin="01:55.530" end="01:57.680" ttm:agent="v1">Not just here to entertain</p>
      <p begin="01:57.680" end="02:00.750" ttm:agent="v1">Make sure they know my name</p>
      <p begin="02:00.750" end="02:02.890" ttm:agent="v1">Look at what I overcame</p>
      <p begin="02:02.890" end="02:04.640" ttm:agent="v1">Make sure they know</p>
      <p begin="02:04.640" end="02:07.890" ttm:agent="v1">Why don't you rap about ass guns and cash</p>
      <p begin="02:07.890" end="02:09.390" ttm:agent="v1">You know why</p>
      <p begin="02:08.770" end="02:10.270" ttm:agent="v1">That's bubblegum rap</p>
      <p begin="02:09.990" end="02:11.780" ttm:agent="v1">Because you chew it up and spit it out</p>
      <p begin="02:11.780" end="02:14.400" ttm:agent="v1">But they'll be eaten these bars a hundid years from now</p>
      <p begin="02:14.400" end="02:18.030" ttm:agent="v1">At my funeral don't tell him how much money I made</p>
      <p begin="02:18.030" end="02:20.670" ttm:agent="v1">Only tell em bout how many lives I changed</p>
      <p begin="02:20.670" end="02:23.360" ttm:agent="v1">I'm just bein the change that I want to see</p>
      <p begin="02:23.360" end="02:25.960" ttm:agent="v1">Life is too short gotta LiveJoeDreamz</p>
      <p begin="02:25.960" end="02:28.420" ttm:agent="v1">My greatest fear is dying 'for I reach my full potential</p>
      <p begin="02:28.420" end="02:31.040" ttm:agent="v1">That's why I got to stay sharp number two pencil</p>
      <p begin="02:31.040" end="02:33.630" ttm:agent="v1">Ima leave this place better than I found it</p>
      <p begin="02:33.630" end="02:35.680" ttm:agent="v1">I made it to the top of the mountain</p>
      <p begin="02:35.680" end="02:40.810" ttm:agent="v1">I want them to remember me for centuries</p>
      <p begin="02:40.810" end="02:44.650" ttm:agent="v1">I want them to remember me for centuries</p>
      <p begin="02:44.650" end="02:47.780" ttm:agent="v1">Make sure they know my name</p>
      <p begin="02:47.780" end="02:49.830" ttm:agent="v1">They was sleepin now they awake</p>
      <p begin="02:49.830" end="02:53.090" ttm:agent="v1">Make sure they know my name</p>
      <p begin="02:53.090" end="02:55.050" ttm:agent="v1">Game will never be the same</p>
      <p begin="02:55.050" end="02:58.260" ttm:agent="v1">Make sure they know my name</p>
      <p begin="02:58.260" end="03:00.210" ttm:agent="v1">Not just here to entertain</p>
      <p begin="03:00.210" end="03:03.380" ttm:agent="v1">Make sure they know my name</p>
      <p begin="03:03.380" end="03:05.470" ttm:agent="v1">And I'm going out with a bang</p>
      <p begin="03:05.470" end="03:07.790" ttm:agent="v1">Make sure they know my</p>
      <p begin="03:07.790" end="03:11.790" ttm:agent="v1"/>
    </div>
