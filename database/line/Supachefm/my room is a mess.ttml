<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>my room is a mess</ttm:title>
      <ttm:agent type="person" xml:id="v1">Supachefm</ttm:agent>
      <ttm:agent type="person" xml:id="v2">1nonly</ttm:agent>
      <ttm:item type="album">imaginary friends</ttm:item>
      <ttm:item type="spotify_id">1sUkWCFoAYmWKtkgHlAIBV</ttm:item>
      <itunes:duration>02:54.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:00.370" end="00:01.950" ttm:agent="v1">Sorry, I've been a mess</p>
      <p begin="00:01.950" end="00:04.020" ttm:agent="v1">It's been hard to get outta bed</p>
      <p begin="00:04.020" end="00:06.320" ttm:agent="v1">You're the only one that sees through my flaws</p>
      <p begin="00:06.320" end="00:07.980" ttm:agent="v1">I won't miss your call</p>
      <p begin="00:07.980" end="00:11.390" ttm:agent="v1">Woke up wondering, &quot;Why does it feel like suffering?&quot;</p>
      <p begin="00:11.390" end="00:13.600" ttm:agent="v1">Every day my room is a mess</p>
      <p begin="00:13.600" end="00:18.340" ttm:agent="v1">Get out my bed just for you, for you</p>
      <p begin="00:18.340" end="00:20.360" ttm:agent="v1">Swear there's a girl that I see</p>
      <p begin="00:20.360" end="00:26.260" ttm:agent="v1">Every night in my dreams and it's you, it's you</p>
      <p begin="00:26.260" end="00:31.290" ttm:agent="v1">And it's hard to deny that I don't feel so blind without you</p>
      <p begin="00:31.290" end="00:32.820" ttm:agent="v1">Girl, you're royalty</p>
      <p begin="00:32.820" end="00:34.780" ttm:agent="v1">You don't do much but you spoil me</p>
      <p begin="00:34.780" end="00:37.580" ttm:agent="v1">Rosy cheeks and twinkly eyes</p>
      <p begin="00:37.580" end="00:41.360" ttm:agent="v1">It's hard to discuss and that's fine</p>
      <p begin="00:41.360" end="00:43.430" ttm:agent="v1">You can't do wrong in my eyes</p>
      <p begin="00:43.430" end="00:45.530" ttm:agent="v1">Can't do wrong in my eyes</p>
      <p begin="00:45.530" end="00:47.030" ttm:agent="v1">It's all you</p>
      <p begin="00:46.740" end="00:49.770" ttm:agent="v1">I wish you would see me the same</p>
      <p begin="00:49.770" end="00:54.850" ttm:agent="v1">Without the shiny rings and the Cartier frames I would buy</p>
      <p begin="00:54.850" end="00:57.090" ttm:agent="v1">For you just to hide behind</p>
      <p begin="00:57.090" end="00:58.590" ttm:agent="v1">All that you want from me</p>
      <p begin="00:58.580" end="01:00.830" ttm:agent="v1">You wan' run me dry</p>
      <p begin="01:00.830" end="01:04.460" ttm:agent="v1">You'd rather take me out than keep me alive</p>
      <p begin="01:04.460" end="01:08.400" ttm:agent="v1">You'd rather burn it down in front of my eyes</p>
      <p begin="01:08.400" end="01:12.370" ttm:agent="v1">Watch how it all comes around over time</p>
      <p begin="01:12.370" end="01:16.080" ttm:agent="v1">We could be stronger now, just hold on tight</p>
      <p begin="01:16.080" end="01:17.580" ttm:agent="v1">Now let's make this right</p>
      <p begin="01:17.510" end="01:19.010" ttm:agent="v1">Sorry, I been a mess</p>
      <p begin="01:18.980" end="01:20.900" ttm:agent="v1">It's been hard to get outta bed</p>
      <p begin="01:20.900" end="01:23.850" ttm:agent="v1">You're the only one that sees through my flaws</p>
      <p begin="01:23.850" end="01:25.350" ttm:agent="v1">I won't miss your call</p>
      <p begin="01:25.340" end="01:28.650" ttm:agent="v1">Woke up wondering, &quot;Why does it feel like suffering?&quot;</p>
      <p begin="01:28.650" end="01:30.970" ttm:agent="v1">Every day my room is a mess</p>
      <p begin="01:30.970" end="01:35.470" ttm:agent="v1">Get out my bed just for you, for you</p>
      <p begin="01:35.470" end="01:37.840" ttm:agent="v1">Swear there's a girl that I see</p>
      <p begin="01:37.840" end="01:43.670" ttm:agent="v1">Every night in my dreams and it's you, it's you</p>
      <p begin="01:43.670" end="01:48.770" ttm:agent="v1">And it's hard to deny that I don't feel so blind without you</p>
      <p begin="01:48.770" end="01:50.280" ttm:agent="v1">Girl, you're royalty</p>
      <p begin="01:50.280" end="01:51.930" ttm:agent="v1">You don't do much but you spoil me</p>
      <p begin="01:51.930" end="01:54.830" ttm:agent="v1">Rosy cheeks and twinkly eyes</p>
      <p begin="01:54.830" end="01:59.080" ttm:agent="v1">It's hard to discuss and that's fine</p>
      <p begin="01:59.080" end="02:01.160" ttm:agent="v1">You can't do wrong in my eyes</p>
      <p begin="02:01.160" end="02:02.820" ttm:agent="v1">Can't do wrong in my eyes</p>
      <p begin="02:02.820" end="02:04.320" ttm:agent="v1">It's all you</p>
      <p begin="02:03.970" end="02:06.720" ttm:agent="v1">Girl, you run through my head every day</p>
      <p begin="02:06.720" end="02:08.760" ttm:agent="v1">Got me lost from my words</p>
      <p begin="02:08.760" end="02:12.800" ttm:agent="v1" itunes:key="role" itunes:value="background">Words that I can't explain, it's all you (it's all you)</p>
      <p begin="02:12.800" end="02:14.570" ttm:agent="v1" itunes:key="role" itunes:value="background">It's all you (it's all you)</p>
      <p begin="02:14.570" end="02:16.440" ttm:agent="v1" itunes:key="role" itunes:value="background">It's all you (it's all you)</p>
      <p begin="02:16.440" end="02:18.760" ttm:agent="v1" itunes:key="role" itunes:value="background">It's all you (it's all you)</p>
      <p begin="02:18.760" end="02:20.970" ttm:agent="v1">'Cause you bring me up out my depression</p>
      <p begin="02:20.970" end="02:22.810" ttm:agent="v1">I loved the times when we were texting</p>
      <p begin="02:22.810" end="02:25.190" ttm:agent="v1">Now I'm stuck and outta breath and</p>
      <p begin="02:25.190" end="02:26.730" ttm:agent="v1">When I'm with you, I feel the tension</p>
      <p begin="02:26.730" end="02:29.920" ttm:agent="v1">Slow, oh-whoa</p>
      <p begin="02:29.920" end="02:34.680" ttm:agent="v1">Don't go, don't go, don't go</p>
      <p begin="02:34.680" end="02:38.320" ttm:agent="v1" itunes:key="role" itunes:value="background">(Slow, oh-whoa)</p>
      <p begin="02:38.320" end="02:40.530" ttm:agent="v1" itunes:key="role" itunes:value="background">(Don't go, don't go, don't go)</p>
      <p begin="02:40.530" end="02:42.240" ttm:agent="v1" itunes:key="role" itunes:value="background">(Get out my bed just for you)</p>
      <p begin="02:42.240" end="02:45.730" ttm:agent="v1" itunes:key="role" itunes:value="background">(Slow, oh-whoa)</p>
      <p begin="02:45.730" end="02:48.290" ttm:agent="v1" itunes:key="role" itunes:value="background">(Don't go, don't go, don't go) (everyday my room is a mess)</p>
      <p begin="02:48.290" end="02:50.720" ttm:agent="v1" itunes:key="role" itunes:value="background">(Get out my bed just for you)</p>
      <p begin="02:50.720" end="02:54.720" ttm:agent="v1"/>
    </div>
  </body>
