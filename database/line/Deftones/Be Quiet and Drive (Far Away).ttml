<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Be Quiet and Drive (Far Away)</ttm:title><ttm:agent type="person" xml:id="v1">Deftones</ttm:agent><ttm:item type="album">Around the Fur</ttm:item><ttm:item type="spotify_id">4Uiw0Sl9yskBaC6P4DcdVD</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:46.687" end="00:54.687">This town don't feel mine</p><p ttm:agent="v1" begin="00:56.783" end="01:04.783">I'm fast to get away, far</p><p ttm:agent="v1" begin="01:07.938" end="01:15.938" /><p ttm:agent="v1" begin="01:17.238" end="01:25.238">I dressed you in her clothes</p><p ttm:agent="v1" begin="01:27.613" end="01:35.613">So drive me, far</p><p ttm:agent="v1" begin="01:37.445" end="01:40.926" /><p ttm:agent="v1" begin="01:40.926" end="01:46.240">Away</p><p ttm:agent="v1" begin="01:46.240" end="01:51.550">Away</p><p ttm:agent="v1" begin="01:51.550" end="01:56.074">Away</p><p ttm:agent="v1" begin="01:56.074" end="02:04.074" /><p ttm:agent="v1" begin="02:08.795" end="02:14.378">It feels good</p><p ttm:agent="v1" begin="02:14.378" end="02:18.909">To know you're mine</p><p ttm:agent="v1" begin="02:18.909" end="02:26.909">Now drive me, far</p><p ttm:agent="v1" begin="02:27.959" end="02:32.199" /><p ttm:agent="v1" begin="02:32.199" end="02:37.535">Away</p><p ttm:agent="v1" begin="02:37.535" end="02:42.586">Away</p><p ttm:agent="v1" begin="02:42.586" end="02:47.672">Away</p><p ttm:agent="v1" begin="02:47.672" end="02:49.172" /><p ttm:agent="v1" begin="02:48.995" end="02:52.458">Far (Away)</p><p ttm:agent="v1" begin="02:52.458" end="02:54.853">I don't care where, just far</p><p ttm:agent="v1" begin="02:54.853" end="02:56.728" itunes:key="role" itunes:value="background">(Away)</p><p ttm:agent="v1" begin="02:56.728" end="02:59.913">I don't care where, just far</p><p ttm:agent="v1" begin="02:59.913" end="03:01.785" itunes:key="role" itunes:value="background">(Away)</p><p ttm:agent="v1" begin="03:01.785" end="03:04.976">I don't care where, just far</p><p ttm:agent="v1" begin="03:04.976" end="03:06.573" itunes:key="role" itunes:value="background">(Away)</p><p ttm:agent="v1" begin="03:06.573" end="03:09.215">I don't care</p><p ttm:agent="v1" begin="03:09.215" end="03:17.215" /><p ttm:agent="v1" begin="03:41.387" end="03:44.703">Far (Away)</p><p ttm:agent="v1" begin="03:44.703" end="03:47.613">I don't care where, just far</p><p ttm:agent="v1" begin="03:47.613" end="03:49.213" itunes:key="role" itunes:value="background">(Away)</p><p ttm:agent="v1" begin="03:49.213" end="03:52.658">I don't care where, just far</p><p ttm:agent="v1" begin="03:52.658" end="03:54.261" itunes:key="role" itunes:value="background">(Away)</p><p ttm:agent="v1" begin="03:54.261" end="03:57.454">I don't care where, just far</p><p ttm:agent="v1" begin="03:57.454" end="03:59.047" itunes:key="role" itunes:value="background">(Away)</p><p ttm:agent="v1" begin="03:59.047" end="04:01.173">I don't care</p><p ttm:agent="v1" begin="04:01.173" end="04:03.834">Far (Away)</p><p ttm:agent="v1" begin="04:03.834" end="04:07.040">I don't care where, just far</p><p ttm:agent="v1" begin="04:07.040" end="04:08.896" itunes:key="role" itunes:value="background">(Away)</p><p ttm:agent="v1" begin="04:08.896" end="04:12.084">I don't care where, just far</p><p ttm:agent="v1" begin="04:12.084" end="04:13.946" itunes:key="role" itunes:value="background">(Away)</p><p ttm:agent="v1" begin="04:13.946" end="04:17.411">I don't care where, just far</p><p ttm:agent="v1" begin="04:17.411" end="04:20.049" itunes:key="role" itunes:value="background">(Away)</p><p ttm:agent="v1" begin="04:20.049" end="04:21.656">Away</p><p ttm:agent="v1" begin="04:21.656" end="04:23.774">Far (Away)</p><p ttm:agent="v1" begin="04:23.774" end="04:26.707">I don't care where, just far</p><p ttm:agent="v1" begin="04:26.707" end="04:28.563" itunes:key="role" itunes:value="background">(Away)</p><p ttm:agent="v1" begin="04:28.563" end="04:31.501">I don't care where, just far</p><p ttm:agent="v1" begin="04:31.501" end="04:33.357" itunes:key="role" itunes:value="background">(Away)</p><p ttm:agent="v1" begin="04:33.357" end="04:36.267">I don't care where, just far</p><p ttm:agent="v1" begin="04:36.267" end="04:38.135" itunes:key="role" itunes:value="background">(Away)</p><p ttm:agent="v1" begin="04:38.135" end="04:39.929">Away</p><p ttm:agent="v1" begin="04:39.929" end="04:43.387">So far (Away)</p><p ttm:agent="v1" begin="04:43.387" end="04:46.064">I don't care where, far</p><p ttm:agent="v1" begin="04:46.064" end="04:48.192" itunes:key="role" itunes:value="background">(Away)</p><p ttm:agent="v1" begin="04:48.192" end="04:51.120">I don't care just where, far</p><p ttm:agent="v1" begin="04:51.120" end="04:53.234" itunes:key="role" itunes:value="background">(Away)</p><p ttm:agent="v1" begin="04:53.234" end="04:57.234">I don't care somewhere far</p></div></body></tt>