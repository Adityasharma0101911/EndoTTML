<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Mexican Standoff</ttm:title>
      <ttm:agent type="person" xml:id="v1">Thomas Foyer</ttm:agent>
      <ttm:item type="album">Cowboys &amp; the Movies: A Western Soundtrack and Film Trailer Collection</ttm:item>
      <ttm:item type="spotify_id">0Gv19a4nTOUlUjMBoAexhK</ttm:item>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:31.570" end="00:39.570" ttm:agent="v1">Paseando mi cuerpo de un pie al otro</p>
      <p begin="00:39.590" end="00:47.580" ttm:agent="v1">Que vio ella a ese hombre</p>
      <p begin="00:47.580" end="00:51.520" ttm:agent="v1">No soy supersticioso</p>
      <p begin="00:51.520" end="00:55.220" ttm:agent="v1">Pero si encesto</p>
      <p begin="00:55.220" end="00:59.280" ttm:agent="v1">Esta pelota en este tiro</p>
      <p begin="00:59.280" end="01:03.480" ttm:agent="v1">Amanecerá muerto</p>
      <p begin="01:03.480" end="01:11.480" ttm:agent="v1">Tus dulces alabanzas no cambian el hecho</p>
      <p begin="01:11.800" end="01:18.700" ttm:agent="v1">De que eres el más guapo que vi yo</p>
      <p begin="01:18.700" end="01:26.700" ttm:agent="v1">Aunque luciría radiante bajo del auto</p>
      <p begin="01:27.560" end="01:35.430" ttm:agent="v1">Hay empate mexicano si yo fuera duro</p>
      <p begin="01:35.430" end="01:37.870" ttm:agent="v1">Sí</p>
      <p begin="01:37.870" end="01:45.870" ttm:agent="v1"/>
      <p begin="02:23.560" end="02:31.430" ttm:agent="v1">Paseando mi cuerpo de un pie al otro</p>
      <p begin="02:31.430" end="02:38.150" ttm:agent="v1">Que vio ella a ese hombre</p>
      <p begin="02:38.150" end="02:43.550" ttm:agent="v1">No soy supersticioso</p>
      <p begin="02:43.550" end="02:47.280" ttm:agent="v1">Pero si encesto</p>
      <p begin="02:47.280" end="02:51.270" ttm:agent="v1">Esta pelota en este tiro</p>
      <p begin="02:51.270" end="02:58.560" ttm:agent="v1">Amanecerá muerto</p>
      <p begin="02:58.560" end="03:06.560" ttm:agent="v1">Sí</p>
      <p begin="03:50.820" end="03:54.820" ttm:agent="v1"/>
    </div>
  </body>
