<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Level</ttm:title><ttm:agent type="person" xml:id="v1">The Raconteurs</ttm:agent><ttm:item type="album">Broken Boy Soldiers</ttm:item><ttm:item type="spotify_id">5HkLVhdVOifwVzQhuh51dL</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:16.440" end="00:19.860">My baby's on the level</p><p ttm:agent="v1" begin="00:19.860" end="00:23.010">I try to read her mind</p><p ttm:agent="v1" begin="00:23.010" end="00:26.370">She's on the straight and narrow</p><p ttm:agent="v1" begin="00:26.370" end="00:29.790">I'm guessin' all the time</p><p ttm:agent="v1" begin="00:29.790" end="00:33.060">But I can't see the road</p><p ttm:agent="v1" begin="00:33.060" end="00:36.510">If I'm lookin' at the signs</p><p ttm:agent="v1" begin="00:36.510" end="00:39.750">I'm carryin' a load</p><p ttm:agent="v1" begin="00:39.750" end="00:47.750">And steppin' out of line</p><p ttm:agent="v1" begin="01:35.580" end="01:39.000">My baby's on the level(My baby's on the level)</p><p ttm:agent="v1" begin="01:39.000" end="01:42.180">I try to read her mind(I try to read her mind)</p><p ttm:agent="v1" begin="01:42.180" end="01:45.510">She's on the straight and narrow(She's on the straight and narrow)</p><p ttm:agent="v1" begin="01:45.510" end="01:48.480">I'm guessin' all the time(And I'm guessin' all the time)</p><p ttm:agent="v1" begin="01:48.480" end="01:49.980">Oh, well, how can</p><p ttm:agent="v1" begin="01:49.230" end="01:51.840">I see the road?(How can I see the road?)</p><p ttm:agent="v1" begin="01:51.840" end="01:55.320">If I'm lookin' at the signs(If I'm lookin' at the signs)</p><p ttm:agent="v1" begin="01:55.320" end="01:58.530">I'm carryin' a load(I'm carryin' a load)</p><p ttm:agent="v1" begin="01:58.530" end="02:02.530">And steppin' out of line</p></div></body></tt>