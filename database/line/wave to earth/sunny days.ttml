<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>sunny days</ttm:title>
      <ttm:agent type="person" xml:id="v1">wave to earth</ttm:agent>
      <ttm:item type="album">0.1 flaws and all.</ttm:item>
      <ttm:item type="spotify_id">4U9teFThcaHZz386DQM6FY</ttm:item>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:24.700" end="00:32.700" ttm:agent="v1">Yeah I've been waiting for this day</p>
      <p begin="00:34.700" end="00:41.000" ttm:agent="v1">The way I'm walking hand in hand with you</p>
      <p begin="00:41.000" end="00:47.700" ttm:agent="v1">Just like all the sunlight is watch over me</p>
      <p begin="00:47.700" end="00:55.700" ttm:agent="v1">Yes it's full of your smile</p>
      <p begin="00:59.400" end="01:02.200" ttm:agent="v1">I'll give it to you</p>
      <p begin="01:02.200" end="01:10.200" ttm:agent="v1">when I collect even the love in the air</p>
      <p begin="01:11.700" end="01:17.400" ttm:agent="v1">The beautiful scenery of the streets</p>
      <p begin="01:17.400" end="01:23.700" ttm:agent="v1">the chirping of birds is nothing without you</p>
      <p begin="01:23.700" end="01:29.500" ttm:agent="v1">I'm nothing without you</p>
      <p begin="01:29.500" end="01:37.300" ttm:agent="v1">Yeah I'm nothing without you</p>
      <p begin="01:37.300" end="01:42.100" ttm:agent="v1">We melt this love and recreate it</p>
      <p begin="01:42.100" end="01:45.100" ttm:agent="v1">as we imagine it</p>
      <p begin="01:45.100" end="01:53.100" ttm:agent="v1">That's how we make sunny days</p>
      <p begin="01:53.900" end="02:01.900" ttm:agent="v1">cause you're always mysterious to me</p>
      <p begin="02:06.600" end="02:12.600" ttm:agent="v1">You are my golden age</p>
      <p begin="02:12.600" end="02:16.100" ttm:agent="v1">Everything shines so bright</p>
      <p begin="02:16.100" end="02:19.500" ttm:agent="v1">that my eyes go blind</p>
      <p begin="02:19.500" end="02:27.500" ttm:agent="v1">Our youth never ages here</p>
      <p begin="02:53.400" end="02:58.200" ttm:agent="v1">We melt this love and recreate it</p>
      <p begin="02:58.200" end="03:01.100" ttm:agent="v1">as we imagine it</p>
      <p begin="03:01.100" end="03:09.100" ttm:agent="v1">That's how we make sunny days</p>
      <p begin="03:09.800" end="03:17.600" ttm:agent="v1">cause you're always mysterious to me</p>
      <p begin="03:17.600" end="03:22.500" ttm:agent="v1">We melt this love and recreate it</p>
      <p begin="03:22.500" end="03:25.400" ttm:agent="v1">as we imagine it</p>
      <p begin="03:25.400" end="03:33.400" ttm:agent="v1">That's how we make sunny days</p>
      <p begin="03:34.100" end="03:38.100" ttm:agent="v1">cause you're always mysterious to me</p>
    </div>
  </body>
</tt>
