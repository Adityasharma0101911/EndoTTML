<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>moment</ttm:title>
      <ttm:agent type="person" xml:id="v1">Vierre Cloud</ttm:agent>
      <ttm:item type="album">moment</ttm:item>
      <ttm:item type="spotify_id">5K9tfeoiztw94dyWzF39jq</ttm:item>
      <itunes:duration>07:30.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:01.280" end="00:09.280" ttm:agent="v1" itunes:key="role" itunes:value="background">(Pierre Cloud)</p>
      <p begin="00:10.260" end="00:12.980" ttm:agent="v1">A new kind of love</p>
      <p begin="00:12.980" end="00:15.940" ttm:agent="v1">Genetically altered</p>
      <p begin="00:15.940" end="00:18.690" ttm:agent="v1">Enough of love life</p>
      <p begin="00:18.690" end="00:21.120" ttm:agent="v1">And I can't believe it's not love</p>
      <p begin="00:21.120" end="00:23.950" ttm:agent="v1">I can't help myself</p>
      <p begin="00:23.950" end="00:26.960" ttm:agent="v1">And you don't have to say that</p>
      <p begin="00:26.960" end="00:29.710" ttm:agent="v1">It sparks across flesh</p>
      <p begin="00:29.710" end="00:33.050" ttm:agent="v1">You'll feel it kicking in soon</p>
      <p begin="00:33.050" end="00:35.750" ttm:agent="v1">Are you falling in love?</p>
      <p begin="00:35.750" end="00:38.330" ttm:agent="v1">I've the feeling you are</p>
      <p begin="00:38.330" end="00:41.580" ttm:agent="v1">Are you falling in love</p>
      <p begin="00:41.580" end="00:44.190" ttm:agent="v1">With a feeling?</p>
      <p begin="00:44.190" end="00:52.190" ttm:agent="v1"/>
      <p begin="00:54.840" end="00:58.090" ttm:agent="v1">So you're running late</p>
      <p begin="00:58.090" end="01:00.420" ttm:agent="v1">And it's not even like you</p>
      <p begin="01:00.420" end="01:03.140" ttm:agent="v1">You were doing so well</p>
      <p begin="01:03.140" end="01:06.380" ttm:agent="v1">Did the dog eat your homework again?</p>
      <p begin="01:06.380" end="01:08.950" ttm:agent="v1">I can't help myself</p>
      <p begin="01:08.950" end="01:11.630" ttm:agent="v1">'Cause my friends says in real life</p>
      <p begin="01:11.630" end="01:14.530" ttm:agent="v1">It's only the police</p>
      <p begin="01:14.530" end="01:17.590" ttm:agent="v1">That ever come looking for you</p>
      <p begin="01:17.590" end="01:20.750" ttm:agent="v1">Are you falling in love?</p>
      <p begin="01:20.750" end="01:23.350" ttm:agent="v1">I've the feeling you are</p>
      <p begin="01:23.350" end="01:26.570" ttm:agent="v1">Are you falling in love</p>
      <p begin="01:26.570" end="01:28.620" ttm:agent="v1">With a feeling?</p>
      <p begin="01:28.620" end="01:31.810" ttm:agent="v1">Are you falling in love?</p>
      <p begin="01:31.810" end="01:34.310" ttm:agent="v1">Or only feeling you are?</p>
      <p begin="01:34.310" end="01:37.540" ttm:agent="v1">'Cause if you're falling in love</p>
      <p begin="01:37.540" end="01:41.360" ttm:agent="v1">Let me feel it</p>
      <p begin="01:41.360" end="01:44.820" ttm:agent="v1">&quot;I've been busy you know that&quot;</p>
      <p begin="01:44.820" end="01:48.520" ttm:agent="v1">You know you're just saying that</p>
      <p begin="01:48.520" end="01:51.730" ttm:agent="v1">&quot;Are you going to get that?&quot;</p>
      <p begin="01:51.730" end="01:55.910" ttm:agent="v1">What's that supposed to mean?</p>
      <p begin="01:55.910" end="01:59.370" ttm:agent="v1">&quot;I've been busy you know that&quot;</p>
      <p begin="01:59.370" end="02:02.520" ttm:agent="v1">You know your just saying that</p>
      <p begin="02:02.520" end="02:06.520" ttm:agent="v1"/>
    </div>
  </body>
</tt>
