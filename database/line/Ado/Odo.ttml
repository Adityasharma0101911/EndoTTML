    <div>
      <p begin="00:00.000" end="00:02.600" ttm:agent="v1">Hanpanara K.O</p>
      <p begin="00:02.600" end="00:06.350" ttm:agent="v1">fuwafuwa Shitainara dōzo</p>
      <p begin="00:06.350" end="00:08.360" ttm:agent="v1">Kaien junbi shi chaou ka</p>
      <p begin="00:08.360" end="00:11.540" ttm:agent="v1">Naitemowarattemo aishite ne</p>
      <p begin="00:11.540" end="00:14.050" ttm:agent="v1">Hora Say &quot;no&quot;</p>
      <p begin="00:14.050" end="00:19.440" ttm:agent="v1">teion hibikasero</p>
      <p begin="00:19.440" end="00:23.240" ttm:agent="v1">Nandaka natte tsuman'nai koto mo arudeshou</p>
      <p begin="00:23.240" end="00:25.340" ttm:agent="v1">Ronrī ronri no nōto</p>
      <p begin="00:25.340" end="00:26.940" ttm:agent="v1">handī honki dassō</p>
      <p begin="00:26.940" end="00:29.120" ttm:agent="v1">Yan natchatte doro ni</p>
      <p begin="00:29.120" end="00:33.590" ttm:agent="v1">bad Gohattodarouga oborete ochite</p>
      <p begin="00:33.590" end="00:35.090" ttm:agent="v1">sorosoro ikka</p>
      <p begin="00:34.640" end="00:36.150" ttm:agent="v1">Motto ganbatte</p>
      <p begin="00:36.150" end="00:37.710" ttm:agent="v1">agaru made motto ganbatte</p>
      <p begin="00:37.710" end="00:40.300" ttm:agent="v1">Tsunagarou hitori yori futari</p>
      <p begin="00:40.300" end="00:42.270" ttm:agent="v1">Fuetara anshin shinpai nai ya</p>
      <p begin="00:42.270" end="00:43.770" ttm:agent="v1">Alright</p>
      <p begin="00:42.700" end="00:44.200" ttm:agent="v1">makasete</p>
      <p begin="00:43.200" end="00:44.700" ttm:agent="v1">don't mind</p>
      <p begin="00:43.700" end="00:45.200" ttm:agent="v1">Nami ari nandai</p>
      <p begin="00:44.650" end="00:46.450" ttm:agent="v1">min'na de nokkatchaeba</p>
      <p begin="00:46.450" end="00:47.950" ttm:agent="v1">ha</p>
      <p begin="00:46.760" end="00:48.540" ttm:agent="v1">Angai sakutto itchai-sō</p>
