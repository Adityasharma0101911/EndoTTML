<?xml version="1.0" encoding="utf-8"?>

<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">

  <head>

    <metadata>

      <ttm:title>Round and Around</ttm:title>

      <ttm:agent type="person" xml:id="v1">JO YURI</ttm:agent>

      <ttm:item type="album">Op.22 Y-Waltz : in Major</ttm:item>

      <ttm:item type="spotify_id">1h7S5xFqtKsh4Lqy2UInH9</ttm:item>

      <itunes:duration>01:20.000</itunes:duration>

    </metadata>

    <styling>

      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>

      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>

    </styling>

    <layout>

      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>

    </layout>

  </head>

  <body>

    <div>

      <p begin="00:02.390" end="00:06.400" ttm:agent="v1">La-la-la-la-la, la</p>

      <p begin="00:06.400" end="00:10.740" ttm:agent="v1">La, la-la, la-la-ah-ah-ah</p>

      <p begin="00:10.740" end="00:17.060" ttm:agent="v1">La-la, la, la-la</p>

      <p begin="00:17.060" end="00:20.260" ttm:agent="v1">한껏 피어오른 내 맘을</p>

      <p begin="00:20.260" end="00:24.390" ttm:agent="v1">한 입 베어 물고선 싱그럽게 짓는 미소</p>

      <p begin="00:24.390" end="00:27.120" ttm:agent="v1">분주한 chatter, but never</p>

      <p begin="00:27.120" end="00:33.180" ttm:agent="v1">읽히지 않는 너의 맘, replay, replay (ooh-ooh-ooh-ooh)</p>

      <p begin="00:33.180" end="00:34.990" ttm:agent="v1">설렘이지 뭐야</p>

      <p begin="00:34.990" end="00:40.270" ttm:agent="v1">어쩜 그리 모른 척 웃어넘겨 (ooh-ooh-ooh-ooh)</p>

      <p begin="00:40.270" end="00:42.130" ttm:agent="v1">흔들리는 사이</p>

      <p begin="00:42.130" end="00:45.930" ttm:agent="v1">보일 듯 말 듯 잔뜩 애태워</p>

      <p begin="00:45.930" end="00:49.740" ttm:agent="v1">Oh, I'm so dizzy (dizzy, dizzy)</p>

      <p begin="00:49.740" end="00:52.070" ttm:agent="v1">넌 좀처럼 좁혀지지 않아</p>

      <p begin="00:52.070" end="00:53.750" ttm:agent="v1">금세 또 멀리 달아나</p>

      <p begin="00:53.750" end="00:56.690" ttm:agent="v1">Keep on runnin' (runnin', runnin')</p>

      <p begin="00:56.690" end="01:00.180" ttm:agent="v1">끊임없이 'round and around and around</p>

      <p begin="01:00.180" end="01:02.930" ttm:agent="v1">참 애매한 너만의 tempo</p>

      <p begin="01:02.930" end="01:07.260" ttm:agent="v1">I'll follow 세 박자에 또 발이 꼬여</p>

      <p begin="01:07.260" end="01:11.300" ttm:agent="v1">But you won't matter (won't matter, won't matter)</p>

      <p begin="01:11.300" end="01:13.770" ttm:agent="v1">Oh, 하나, 둘, 셋, 숨을 들이켜</p>

      <p begin="01:13.770" end="01:15.880" ttm:agent="v1">여전히 너를 맴돌아, uh</p>

      <p begin="01:15.880" end="01:19.880" ttm:agent="v1"/>

    </div>

  </body>

</tt>

