<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Romance</ttm:title><ttm:agent type="person" xml:id="v1">Fontaines D.C.</ttm:agent><ttm:item type="album">Romance</ttm:item><ttm:item type="spotify_id">4DE8iIHNUYpAmilzPdAGoT</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:31.336" end="00:38.226">Into the darkness again</p><p ttm:agent="v1" begin="00:38.226" end="00:45.219">In with the pigs in the pen</p><p ttm:agent="v1" begin="00:45.219" end="00:48.484">God knows I love ye</p><p ttm:agent="v1" begin="00:48.484" end="00:51.651">Screws in my head</p><p ttm:agent="v1" begin="00:51.651" end="00:57.267">I will be beside you</p><p ttm:agent="v1" begin="00:57.267" end="01:05.267">Till you're dead</p><p ttm:agent="v1" begin="01:06.071" end="01:12.717">Deep in the night I confide</p><p ttm:agent="v1" begin="01:12.717" end="01:19.636">That maybe my goodness has died</p><p ttm:agent="v1" begin="01:19.636" end="01:23.391">I pray for your kindness</p><p ttm:agent="v1" begin="01:23.391" end="01:26.532">Heart on a spit</p><p ttm:agent="v1" begin="01:26.532" end="01:32.023">And maybe romance is a place</p><p ttm:agent="v1" begin="01:32.023" end="01:33.802">Yeah</p><p ttm:agent="v1" begin="01:33.802" end="01:39.085">Maybe romance is a place</p><p ttm:agent="v1" begin="01:39.085" end="01:40.813">Yeah</p><p ttm:agent="v1" begin="01:40.813" end="01:45.991">Maybe romance is a place</p><p ttm:agent="v1" begin="01:45.991" end="01:49.522">For me</p><p ttm:agent="v1" begin="01:49.522" end="01:52.962">And you</p><p ttm:agent="v1" begin="01:52.962" end="01:56.362">And you</p><p ttm:agent="v1" begin="01:56.362" end="02:00.362">And</p></div></body></tt>