<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>So In Love</ttm:title>
      <ttm:agent type="person" xml:id="v1">Breezee</ttm:agent>
      <ttm:item type="album">So In Love</ttm:item>
      <ttm:item type="spotify_id">45otrYoVWC5qGdSR0eK1zP</ttm:item>
      <itunes:duration>03:27.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:22.820" end="00:25.740" ttm:agent="v1">I tend to fantasize</p>
      <p begin="00:25.740" end="00:28.360" ttm:agent="v1">About you and I</p>
      <p begin="00:28.360" end="00:31.070" ttm:agent="v1">Feels like I'm on a ride</p>
      <p begin="00:31.070" end="00:34.490" ttm:agent="v1">Like Aladdin, Jasmine, soaring through the night</p>
      <p begin="00:34.490" end="00:37.280" ttm:agent="v1">It's hard to describe</p>
      <p begin="00:37.280" end="00:40.220" ttm:agent="v1">When you're stuck on my mind</p>
      <p begin="00:40.220" end="00:44.620" ttm:agent="v1">But when the stars align</p>
      <p begin="00:44.620" end="00:52.620" ttm:agent="v1">Baby, I am just so, so in love</p>
      <p begin="00:54.480" end="01:00.580" ttm:agent="v1" itunes:key="role" itunes:value="background">When it's just us (when it's just us two)</p>
      <p begin="01:00.580" end="01:06.600" ttm:agent="v1" itunes:key="role" itunes:value="background">It must be the stars up above (above)</p>
      <p begin="01:06.600" end="01:14.600" ttm:agent="v1">Making sure we are in love, we are in love</p>
      <p begin="01:18.310" end="01:25.360" ttm:agent="v1">I said, no, we're so in love</p>
      <p begin="01:25.360" end="01:32.730" ttm:agent="v1">We're in love</p>
      <p begin="01:32.730" end="01:34.260" ttm:agent="v1">My love's on the table</p>
      <p begin="01:34.260" end="01:35.760" ttm:agent="v1">So let's put a label</p>
      <p begin="01:35.520" end="01:38.450" ttm:agent="v1">I want the world to know that we are taken</p>
      <p begin="01:38.450" end="01:39.950" ttm:agent="v1">Our story's a fable</p>
      <p begin="01:39.850" end="01:41.480" ttm:agent="v1">And I'm very grateful</p>
      <p begin="01:41.480" end="01:44.170" ttm:agent="v1">'Cause we're a fairy tale that's in the making</p>
      <p begin="01:44.170" end="01:46.960" ttm:agent="v1">And our story might go up, down, out, or in</p>
      <p begin="01:46.960" end="01:50.070" ttm:agent="v1">But the day you're out, we'll fall in love again</p>
      <p begin="01:50.070" end="01:52.760" ttm:agent="v1">It'll never come to, &quot;what we could've been&quot;</p>
      <p begin="01:52.760" end="01:54.520" ttm:agent="v1">'Cause we're forever 'til the end</p>
      <p begin="01:54.520" end="02:01.110" ttm:agent="v1" itunes:key="role" itunes:value="background">And I'm so stuck on how we were always destined to be (to be)</p>
      <p begin="02:01.110" end="02:03.850" ttm:agent="v1" itunes:key="role" itunes:value="background">The two kids sittin' in the tree (the tree)</p>
      <p begin="02:03.850" end="02:06.040" ttm:agent="v1">The lovers in the movies</p>
      <p begin="02:06.040" end="02:09.380" ttm:agent="v1">And when I sit next to you</p>
      <p begin="02:09.380" end="02:12.550" ttm:agent="v1" itunes:key="role" itunes:value="background">It's something straight out of a scene (a scene)</p>
      <p begin="02:12.550" end="02:14.790" ttm:agent="v1">Like when I look into your eyes</p>
      <p begin="02:14.790" end="02:16.820" ttm:agent="v1">I see the moon's reflection when it gleams</p>
      <p begin="02:16.820" end="02:24.820" ttm:agent="v1">Baby, I am just so, so in love</p>
      <p begin="02:26.780" end="02:32.630" ttm:agent="v1" itunes:key="role" itunes:value="background">When it's just us (when it's just us two)</p>
      <p begin="02:32.630" end="02:38.780" ttm:agent="v1" itunes:key="role" itunes:value="background">It must be the stars up above (above)</p>
      <p begin="02:38.780" end="02:45.950" ttm:agent="v1" itunes:key="role" itunes:value="background">Making sure we are in love (we're so in love)</p>
      <p begin="02:45.950" end="02:50.530" ttm:agent="v1">We are in love</p>
      <p begin="02:50.530" end="02:58.470" ttm:agent="v1" itunes:key="role" itunes:value="background">I said, no, we're so in love (baby)</p>
      <p begin="02:58.470" end="03:00.670" ttm:agent="v1">We're in love</p>
      <p begin="03:00.670" end="03:04.670" ttm:agent="v1"/>
    </div>
  </body>
</tt>
