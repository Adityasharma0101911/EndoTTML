<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Holiday</ttm:title><ttm:agent type="person" xml:id="v1">Emi Choi</ttm:agent><ttm:item type="album">Holiday</ttm:item><ttm:item type="spotify_id">3ztA2CLH6wdJxWhr3x4leq</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:10.742" end="00:13.339">I never liked the cold</p><p ttm:agent="v1" begin="00:13.339" end="00:16.675">Frozen from head to toe</p><p ttm:agent="v1" begin="00:16.675" end="00:20.331">Looking for a great escape</p><p ttm:agent="v1" begin="00:20.331" end="00:22.602">Looking for another way</p><p ttm:agent="v1" begin="00:22.602" end="00:25.069">But I know someone</p><p ttm:agent="v1" begin="00:25.069" end="00:27.938">Who feels like golden sun</p><p ttm:agent="v1" begin="00:27.938" end="00:33.064">You make me want to believe</p><p ttm:agent="v1" begin="00:33.064" end="00:35.878">Every day's a holiday</p><p ttm:agent="v1" begin="00:35.878" end="00:38.404">Tropic island getaway</p><p ttm:agent="v1" begin="00:38.404" end="00:44.246">From the equator to your arms</p><p ttm:agent="v1" begin="00:44.246" end="00:47.126">Every day's a holiday</p><p ttm:agent="v1" begin="00:47.126" end="00:50.002">Never wanna waste this</p><p ttm:agent="v1" begin="00:50.002" end="00:56.773">I found the everlasting oasis</p><p ttm:agent="v1" begin="00:56.773" end="01:04.773">In you</p><p ttm:agent="v1" begin="01:07.712" end="01:09.641">And when I'm all alone</p><p ttm:agent="v1" begin="01:09.641" end="01:12.868">Nowhere to call my own</p><p ttm:agent="v1" begin="01:12.868" end="01:16.565">Looking for a place to stay</p><p ttm:agent="v1" begin="01:16.565" end="01:18.969">Looking for a warm embrace</p><p ttm:agent="v1" begin="01:18.969" end="01:21.259">Oh I know someone</p><p ttm:agent="v1" begin="01:21.259" end="01:24.892">Who feels like home on Sundays</p><p ttm:agent="v1" begin="01:24.892" end="01:29.215">You make me want to believe</p><p ttm:agent="v1" begin="01:29.215" end="01:32.105">Every day's a holiday</p><p ttm:agent="v1" begin="01:32.105" end="01:34.869">Tropic island getaway</p><p ttm:agent="v1" begin="01:34.869" end="01:40.457">From the equator to your arms</p><p ttm:agent="v1" begin="01:40.457" end="01:43.315">Every day's a holiday</p><p ttm:agent="v1" begin="01:43.315" end="01:46.186">Never wanna waste this</p><p ttm:agent="v1" begin="01:46.186" end="01:52.911">I found the everlasting oasis</p><p ttm:agent="v1" begin="01:52.911" end="01:55.211">Do you feel my heartbeat</p><p ttm:agent="v1" begin="01:55.211" end="01:58.336">Through the warmth of our hands?</p><p ttm:agent="v1" begin="01:58.336" end="02:01.142">Do you see my cheeks rosy</p><p ttm:agent="v1" begin="02:01.142" end="02:04.147">Under this scarf?</p><p ttm:agent="v1" begin="02:04.147" end="02:05.938">Doesn't matter when</p><p ttm:agent="v1" begin="02:05.938" end="02:07.438">Doesn't matter where</p><p ttm:agent="v1" begin="02:07.267" end="02:10.037">As long you're here</p><p ttm:agent="v1" begin="02:10.037" end="02:14.260">You make me want to believe</p><p ttm:agent="v1" begin="02:14.260" end="02:17.102">Every day's a holiday</p><p ttm:agent="v1" begin="02:17.102" end="02:19.892">Tropic island getaway</p><p ttm:agent="v1" begin="02:19.892" end="02:25.372">From the equator to your arms</p><p ttm:agent="v1" begin="02:25.372" end="02:28.335">Every day's a holiday</p><p ttm:agent="v1" begin="02:28.335" end="02:31.237">Never wanna waste this</p><p ttm:agent="v1" begin="02:31.237" end="02:37.303">I found the everlasting oasis</p><p ttm:agent="v1" begin="02:37.303" end="02:41.303">In you</p></div></body></tt>