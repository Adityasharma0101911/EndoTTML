<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Holiday</ttm:title>
      <ttm:agent type="person" xml:id="v1">Emi Choi</ttm:agent>
      <ttm:item type="album">Holiday</ttm:item>
      <ttm:item type="spotify_id">3ztA2CLH6wdJxWhr3x4leq</ttm:item>
      <itunes:duration>02:55.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:10.690" end="00:13.460" ttm:agent="v1">I never liked the cold</p>
      <p begin="00:13.460" end="00:16.720" ttm:agent="v1">Frozen from head to toe</p>
      <p begin="00:16.720" end="00:19.830" ttm:agent="v1">Looking for a great escape</p>
      <p begin="00:19.830" end="00:21.660" ttm:agent="v1">Looking for another way</p>
      <p begin="00:21.660" end="00:24.500" ttm:agent="v1">But I know someone</p>
      <p begin="00:24.500" end="00:28.010" ttm:agent="v1">Who feels like golden sun</p>
      <p begin="00:28.010" end="00:32.140" ttm:agent="v1">You make me want to believe</p>
      <p begin="00:32.140" end="00:35.110" ttm:agent="v1">Every day's a holiday</p>
      <p begin="00:35.110" end="00:38.040" ttm:agent="v1">Tropic island getaway</p>
      <p begin="00:38.040" end="00:43.530" ttm:agent="v1">From the equator to your arms</p>
      <p begin="00:43.530" end="00:46.270" ttm:agent="v1">Every day's a holiday</p>
      <p begin="00:46.270" end="00:49.120" ttm:agent="v1">Never wanna waste this</p>
      <p begin="00:49.120" end="00:56.230" ttm:agent="v1">I found the everlasting oasis</p>
      <p begin="00:56.230" end="01:04.230" ttm:agent="v1">In you</p>
      <p begin="01:06.820" end="01:09.730" ttm:agent="v1">And when I'm all alone</p>
      <p begin="01:09.730" end="01:13.120" ttm:agent="v1">Nowhere to call my own</p>
      <p begin="01:13.120" end="01:15.840" ttm:agent="v1">Looking for a place to stay</p>
      <p begin="01:15.840" end="01:17.980" ttm:agent="v1">Looking for a warm embrace</p>
      <p begin="01:17.980" end="01:20.800" ttm:agent="v1">Oh I know someone</p>
      <p begin="01:20.800" end="01:24.280" ttm:agent="v1">Who feels like home on Sundays</p>
      <p begin="01:24.280" end="01:28.480" ttm:agent="v1">You make me want to believe</p>
      <p begin="01:28.480" end="01:31.360" ttm:agent="v1">Every day's a holiday</p>
      <p begin="01:31.360" end="01:34.240" ttm:agent="v1">Tropic island getaway</p>
      <p begin="01:34.240" end="01:40.190" ttm:agent="v1">From the equator to your arms</p>
      <p begin="01:40.190" end="01:42.550" ttm:agent="v1">Every day's a holiday</p>
      <p begin="01:42.550" end="01:45.410" ttm:agent="v1">Never wanna waste this</p>
      <p begin="01:45.410" end="01:52.400" ttm:agent="v1">I found the everlasting oasis</p>
      <p begin="01:52.400" end="01:54.450" ttm:agent="v1">Do you feel my heartbeat</p>
      <p begin="01:54.450" end="01:57.620" ttm:agent="v1">Through the warmth of our hands?</p>
      <p begin="01:57.620" end="02:00.820" ttm:agent="v1">Do you see my cheeks rosy</p>
      <p begin="02:00.820" end="02:03.740" ttm:agent="v1">Under this scarf?</p>
      <p begin="02:03.740" end="02:05.240" ttm:agent="v1">Doesn't matter when</p>
      <p begin="02:05.090" end="02:06.650" ttm:agent="v1">Doesn't matter where</p>
      <p begin="02:06.650" end="02:09.280" ttm:agent="v1">As long you're here</p>
      <p begin="02:09.280" end="02:13.540" ttm:agent="v1">You make me want to believe</p>
      <p begin="02:13.540" end="02:16.440" ttm:agent="v1">Every day's a holiday</p>
      <p begin="02:16.440" end="02:19.090" ttm:agent="v1">Tropic island getaway</p>
      <p begin="02:19.090" end="02:24.990" ttm:agent="v1">From the equator to your arms</p>
      <p begin="02:24.990" end="02:27.850" ttm:agent="v1">Every day's a holiday</p>
      <p begin="02:27.850" end="02:30.440" ttm:agent="v1">Never wanna waste this</p>
      <p begin="02:30.440" end="02:37.510" ttm:agent="v1">I found the everlasting oasis</p>
      <p begin="02:37.510" end="02:45.510" ttm:agent="v1">In you</p>
      <p begin="02:53.930" end="02:57.930" ttm:agent="v1"/>
    </div>
  </body>
</tt>
