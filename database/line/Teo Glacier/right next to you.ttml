<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>right next to you</ttm:title><ttm:agent type="person" xml:id="v1">Teo Glacier</ttm:agent><ttm:item type="album">right next to you</ttm:item><ttm:item type="spotify_id">17yFtQlpQ02eNVVqB2wnPG</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:08.970" end="00:14.970">Let's make it up as we go</p><p ttm:agent="v1" begin="00:14.970" end="00:20.180">Ain't gotta rush, let's take it slow</p><p ttm:agent="v1" begin="00:20.180" end="00:25.040">I'll love you til' we're grey and old</p><p ttm:agent="v1" begin="00:25.040" end="00:29.260">And every day I fall in love with you a little more</p><p ttm:agent="v1" begin="00:29.260" end="00:31.750">Put your hand right in mine</p><p ttm:agent="v1" begin="00:31.750" end="00:34.090">Tell me what's on your mind</p><p ttm:agent="v1" begin="00:34.090" end="00:37.320">And I'll tell you a thousand times</p><p ttm:agent="v1" begin="00:37.320" end="00:41.130">That there's nothing</p><p ttm:agent="v1" begin="00:41.130" end="00:43.720">That could come between us</p><p ttm:agent="v1" begin="00:43.720" end="00:45.830">No, nothing</p><p ttm:agent="v1" begin="00:45.830" end="00:48.410">'Cause you're all I've needed</p><p ttm:agent="v1" begin="00:48.410" end="00:50.900">There's nothing</p><p ttm:agent="v1" begin="00:50.900" end="00:53.160">That I'd rather do</p><p ttm:agent="v1" begin="00:53.160" end="00:55.680">If we win or lose</p><p ttm:agent="v1" begin="00:55.680" end="00:59.230">I'll be here right next to you</p><p ttm:agent="v1" begin="00:59.230" end="01:01.340">Lay your head</p><p ttm:agent="v1" begin="01:01.340" end="01:04.020">On my shoulder</p><p ttm:agent="v1" begin="01:04.020" end="01:06.350">I'll pull you close</p><p ttm:agent="v1" begin="01:06.350" end="01:08.900">And even closer</p><p ttm:agent="v1" begin="01:08.900" end="01:12.810">I promise I won't let you go</p><p ttm:agent="v1" begin="01:12.810" end="01:17.750">I'll be by your side when the night turns to morn'</p><p ttm:agent="v1" begin="01:17.750" end="01:20.660">So just put your hand right in mine</p><p ttm:agent="v1" begin="01:20.660" end="01:22.990">Tell me what's on your mind</p><p ttm:agent="v1" begin="01:22.990" end="01:26.090">And I'll tell you a thousand times</p><p ttm:agent="v1" begin="01:26.090" end="01:29.940">That there ain't nothing</p><p ttm:agent="v1" begin="01:29.940" end="01:32.640">That could come between us</p><p ttm:agent="v1" begin="01:32.640" end="01:34.800">No, nothing</p><p ttm:agent="v1" begin="01:34.800" end="01:37.340">'Cause you're all I've needed</p><p ttm:agent="v1" begin="01:37.340" end="01:39.770">There's nothing</p><p ttm:agent="v1" begin="01:39.770" end="01:41.960">That I'd rather do</p><p ttm:agent="v1" begin="01:41.960" end="01:44.810">If we win or lose</p><p ttm:agent="v1" begin="01:44.810" end="01:49.690">I'll be here right next to you (ooh, ooh, ooh)</p><p ttm:agent="v1" begin="01:49.690" end="01:52.360">You (ooh, ooh, ooh)</p><p ttm:agent="v1" begin="01:52.360" end="01:59.480">I'll be here right next to you (ooh, ooh, ooh)</p><p ttm:agent="v1" begin="01:59.480" end="02:02.160">You (ooh, ooh, ooh)</p><p ttm:agent="v1" begin="02:02.160" end="02:08.100">I'll be here right next to you</p><p ttm:agent="v1" begin="02:08.100" end="02:12.100" /></div></body></tt>