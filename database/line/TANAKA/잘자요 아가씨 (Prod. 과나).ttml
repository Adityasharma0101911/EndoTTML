<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>잘자요 아가씨 (Prod. 과나)</ttm:title>
      <ttm:agent type="person" xml:id="v1">TANAKA</ttm:agent>
      <ttm:agent type="person" xml:id="v2">닛몰캐쉬</ttm:agent>
      <ttm:item type="album">잘자요 아가씨</ttm:item>
      <ttm:item type="spotify_id">2JxXcCgVx61AI0MOUoXC68</ttm:item>
      <itunes:duration>01:53.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:00.480" end="00:04.470" ttm:agent="v1">お嬢様 it's time to go to bed</p>
      <p begin="00:04.470" end="00:06.320" ttm:agent="v1">또 핸드폰 하는 거예요?</p>
      <p begin="00:06.320" end="00:10.330" ttm:agent="v1">늦게 자면, 고운 피부가 다 무너진다구요</p>
      <p begin="00:10.330" end="00:12.320" ttm:agent="v1">最後の警告です</p>
      <p begin="00:12.320" end="00:14.210" ttm:agent="v1">지금 잠에 들지 않으면</p>
      <p begin="00:14.210" end="00:17.890" ttm:agent="v1">우린 춤을 출 거예요</p>
      <p begin="00:17.890" end="00:22.810" ttm:agent="v1">やれやれ 못 말리는 아가씨</p>
      <p begin="00:22.810" end="00:26.930" ttm:agent="v1">やれやれ</p>
      <p begin="00:26.930" end="00:30.770" ttm:agent="v1">못 말리는 아가씨</p>
      <p begin="00:30.770" end="00:34.960" ttm:agent="v1">やれやれ</p>
      <p begin="00:34.960" end="00:36.460" ttm:agent="v1">못 말리는 아가씨</p>
      <p begin="00:35.920" end="00:39.720" ttm:agent="v1">또, 또, 또, 또, 또, 또, 또 핸드폰 하는 거예요?</p>
      <p begin="00:39.720" end="00:43.880" ttm:agent="v1">Ti-ti-ti-ti-ti-ti-time to go to bed</p>
      <p begin="00:43.880" end="00:47.890" ttm:agent="v1">고-고-고-고-고-고-고운 피부가 다 무너진다구요</p>
      <p begin="00:47.890" end="00:52.300" ttm:agent="v1">や や や や や や やれやれ 못 말리는 아가씨</p>
      <p begin="00:52.300" end="00:56.430" ttm:agent="v1">お嬢様 it's time to go to bed</p>
      <p begin="00:56.430" end="00:58.960" ttm:agent="v1">처음부터 잘 생각이 없었군요?</p>
      <p begin="00:58.960" end="01:02.660" ttm:agent="v1">오늘 밤은 우리와 함께 춤을 춰요</p>
      <p begin="01:02.660" end="01:04.490" ttm:agent="v1">でも明日は</p>
      <p begin="01:04.490" end="01:06.430" ttm:agent="v1">일찍 잠에 드는 거예요</p>
      <p begin="01:06.430" end="01:09.880" ttm:agent="v1">오늘은 비밀로 해줄게요</p>
      <p begin="01:09.880" end="01:14.980" ttm:agent="v1">やれやれ 못 말리는 아가씨</p>
      <p begin="01:14.980" end="01:18.960" ttm:agent="v1">やれやれ</p>
      <p begin="01:18.960" end="01:22.830" ttm:agent="v1">못 말리는 아가씨</p>
      <p begin="01:22.830" end="01:26.830" ttm:agent="v1">やれやれ</p>
      <p begin="01:26.830" end="01:28.330" ttm:agent="v1">못 말리는 아가씨</p>
      <p begin="01:27.940" end="01:31.970" ttm:agent="v1">또, 또, 또, 또, 또, 또, 또 핸드폰 하는 거예요?</p>
      <p begin="01:31.970" end="01:35.950" ttm:agent="v1">Ti-ti-ti-ti-ti-ti-time to go to bed</p>
      <p begin="01:35.950" end="01:39.990" ttm:agent="v1">고-고-고-고-고-고-고운 피부가 다 무너진다구요</p>
      <p begin="01:39.990" end="01:44.180" ttm:agent="v1">や や や や や や やれやれ 못 말리는 아가씨</p>
      <p begin="01:44.180" end="01:45.680" ttm:agent="v1">最後の警告です</p>
      <p begin="01:45.630" end="01:47.130" ttm:agent="v1">지금 잠에 들지 않으면, 우린</p>
      <p begin="01:47.030" end="01:51.030" ttm:agent="v1"/>
    </div>
  </body>
</tt>
