  <head>
    <metadata>
      <ttm:title>因果(Karma Code)</ttm:title>
      <ttm:agent type="person" xml:id="v1">攬佬SKAI ISYOURGOD</ttm:agent>
      <ttm:item type="album">八方來財(Stacks from All Sides)</ttm:item>
      <ttm:item type="spotify_id">2cUJ6wbyqH8hDZN8VWQ5oC</ttm:item>
      <itunes:duration>02:31.111</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
