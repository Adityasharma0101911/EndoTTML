<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Follow Me Home</ttm:title><ttm:agent type="person" xml:id="v1">Sugababes</ttm:agent><ttm:item type="album">Taller In More Ways</ttm:item><ttm:item type="spotify_id">1rqTbUkf7XjQdi22Shus8n</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:03.980" end="00:11.980">ooh ooh ooh ooh ooh ooh ooh ooh</p><p ttm:agent="v1" begin="00:28.290" end="00:33.760">like a light into my life</p><p ttm:agent="v1" begin="00:33.760" end="00:39.980">i never thought that it would feel so right yeah</p><p ttm:agent="v1" begin="00:39.980" end="00:45.710">all i wanna do is hold you tight</p><p ttm:agent="v1" begin="00:45.710" end="00:50.490">and i'll be with you through troubled nights</p><p ttm:agent="v1" begin="00:50.490" end="00:56.150">sometimes life it drags you down and plays you like a fool</p><p ttm:agent="v1" begin="00:56.150" end="01:02.000">makes you feel so empty sometimes it can be so cruel</p><p ttm:agent="v1" begin="01:02.000" end="01:03.500">ooh yeah</p><p ttm:agent="v1" begin="01:03.390" end="01:06.000">so follow me home</p><p ttm:agent="v1" begin="01:06.000" end="01:08.830">you'll never be lost</p><p ttm:agent="v1" begin="01:08.830" end="01:12.020">wherever the storm</p><p ttm:agent="v1" begin="01:12.020" end="01:14.700">whatever the cost</p><p ttm:agent="v1" begin="01:14.700" end="01:17.660">i wont walk away</p><p ttm:agent="v1" begin="01:17.660" end="01:20.890">i'll stand by your side</p><p ttm:agent="v1" begin="01:20.890" end="01:23.710">im here for you</p><p ttm:agent="v1" begin="01:23.710" end="01:31.710">the rest of our lives</p><p ttm:agent="v1" begin="01:32.610" end="01:38.180">when your feeling all alone</p><p ttm:agent="v1" begin="01:38.180" end="01:44.170">hear the words that im singing to you oh</p><p ttm:agent="v1" begin="01:44.170" end="01:49.890">like a seed that has been sown</p><p ttm:agent="v1" begin="01:49.890" end="01:54.900">as you grow i will protect you yeah</p><p ttm:agent="v1" begin="01:54.900" end="02:00.340">sometimes life it drags you down and plays you like a fool</p><p ttm:agent="v1" begin="02:00.340" end="02:06.350">makes you feel so empty sometimes it can be so cruel</p><p ttm:agent="v1" begin="02:06.350" end="02:07.850">ooh yeah</p><p ttm:agent="v1" begin="02:07.750" end="02:10.430">so follow me home</p><p ttm:agent="v1" begin="02:10.430" end="02:13.240">you'll never be lost</p><p ttm:agent="v1" begin="02:13.240" end="02:16.390">wherever the storm</p><p ttm:agent="v1" begin="02:16.390" end="02:19.600">whatever the cost</p><p ttm:agent="v1" begin="02:19.600" end="02:22.010">i wont walk away</p><p ttm:agent="v1" begin="02:22.010" end="02:25.130">i'll stand by your side</p><p ttm:agent="v1" begin="02:25.130" end="02:28.170">im here for you</p><p ttm:agent="v1" begin="02:28.170" end="02:36.170">the rest of our lives</p><p ttm:agent="v1" begin="02:36.890" end="02:39.580">baby all im tryin to say</p><p ttm:agent="v1" begin="02:39.580" end="02:42.860">is that my heart is here to hold you</p><p ttm:agent="v1" begin="02:42.860" end="02:45.450">im never far away</p><p ttm:agent="v1" begin="02:45.450" end="02:48.720">take my hand so i can feel you</p><p ttm:agent="v1" begin="02:48.720" end="02:51.670">i've searched and i have found</p><p ttm:agent="v1" begin="02:51.670" end="02:56.000">i'll never let you down</p><p ttm:agent="v1" begin="02:56.000" end="02:59.390">we'll always stand on solid ground</p><p ttm:agent="v1" begin="02:59.390" end="03:03.400">and i will always be around</p><p ttm:agent="v1" begin="03:03.400" end="03:06.190">so follow me home</p><p ttm:agent="v1" begin="03:06.190" end="03:09.010">you'll never be lost</p><p ttm:agent="v1" begin="03:09.010" end="03:12.050">wherever the storm</p><p ttm:agent="v1" begin="03:12.050" end="03:14.650">whatever the cost</p><p ttm:agent="v1" begin="03:14.650" end="03:17.710">i wont walk away</p><p ttm:agent="v1" begin="03:17.710" end="03:20.690">i'll stand by your side</p><p ttm:agent="v1" begin="03:20.690" end="03:23.850">im here for you</p><p ttm:agent="v1" begin="03:23.850" end="03:31.850">the rest of our lives x2</p><p ttm:agent="v1" begin="03:51.110" end="03:55.110" /></div></body></tt>