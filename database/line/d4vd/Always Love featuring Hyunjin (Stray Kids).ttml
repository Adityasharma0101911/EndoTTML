<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Always Love featuring Hyunjin (Stray Kids)</ttm:title>
      <ttm:agent type="person" xml:id="v1">d4vd</ttm:agent>
      <ttm:agent type="person" xml:id="v2">Hyunjin</ttm:agent>
      <ttm:item type="album">Always Love featuring Hyunjin (Stray Kids)</ttm:item>
      <ttm:item type="spotify_id">1WKafez8TM4dVYlSsxi6dS</ttm:item>
      <itunes:duration>03:18.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:20.440" end="00:26.220" ttm:agent="v1">Suddenly, I've become</p>
      <p begin="00:26.220" end="00:33.130" ttm:agent="v1">Just a memory of someone</p>
      <p begin="00:33.130" end="00:39.390" ttm:agent="v1">Hear the melodies from my voice</p>
      <p begin="00:39.390" end="00:42.870" ttm:agent="v1">They'll call you back to me</p>
      <p begin="00:42.870" end="00:47.240" ttm:agent="v1">But it's your choice, oh</p>
      <p begin="00:47.240" end="00:50.760" ttm:agent="v1">You don't have to make me cry</p>
      <p begin="00:50.760" end="00:54.150" ttm:agent="v1">You don't have to say goodbye</p>
      <p begin="00:54.150" end="00:59.140" ttm:agent="v1">I know we were meant to be</p>
      <p begin="00:59.140" end="01:03.300" ttm:agent="v1">Do you, do you feel what I feel?</p>
      <p begin="01:03.300" end="01:06.660" ttm:agent="v1">Do you love like I love?</p>
      <p begin="01:06.660" end="01:09.910" ttm:agent="v1">Would you hold my hand?</p>
      <p begin="01:09.910" end="01:13.370" ttm:agent="v1">Would you let me go?</p>
      <p begin="01:13.370" end="01:16.830" ttm:agent="v1">Would you stand by my side?</p>
      <p begin="01:16.830" end="01:20.380" ttm:agent="v1">Are you down for the ride?</p>
      <p begin="01:20.380" end="01:26.710" ttm:agent="v1">I don't need nobody else but you</p>
      <p begin="01:26.710" end="01:29.340" ttm:agent="v1">But you</p>
      <p begin="01:29.340" end="01:36.020" ttm:agent="v1">All my life, I tried to find</p>
      <p begin="01:36.020" end="01:40.510" ttm:agent="v1">Someone that won't make me lose my mind</p>
      <p begin="01:40.510" end="01:44.760" ttm:agent="v1">So tell me if it's now or never</p>
      <p begin="01:44.760" end="01:48.060" ttm:agent="v1">'Cause with you, I see forever</p>
      <p begin="01:48.060" end="01:54.750" ttm:agent="v1">I think you could make me better, better</p>
      <p begin="01:54.750" end="01:58.010" ttm:agent="v1">You don't have to make me cry</p>
      <p begin="01:58.010" end="02:01.470" ttm:agent="v1">You don't have to say goodbye</p>
      <p begin="02:01.470" end="02:06.320" ttm:agent="v1">I know we were meant to be</p>
      <p begin="02:06.320" end="02:10.700" ttm:agent="v1">Do you, do you feel what I feel?</p>
      <p begin="02:10.700" end="02:13.930" ttm:agent="v1">Do you love like I love?</p>
      <p begin="02:13.930" end="02:17.320" ttm:agent="v1">Would you hold my hand?</p>
      <p begin="02:17.320" end="02:20.670" ttm:agent="v1">Would you let me go?</p>
      <p begin="02:20.670" end="02:24.090" ttm:agent="v1">Would you stand by my side?</p>
      <p begin="02:24.090" end="02:27.400" ttm:agent="v1">Are you down for the ride?</p>
      <p begin="02:27.400" end="02:34.210" ttm:agent="v1">I don't need nobody else but you</p>
      <p begin="02:34.210" end="02:38.520" ttm:agent="v1">But you</p>
      <p begin="02:38.520" end="02:40.930" ttm:agent="v1"/>
      <p begin="02:40.930" end="02:46.820" ttm:agent="v1">But you</p>
      <p begin="02:46.820" end="02:51.100" ttm:agent="v1">Do you, do you feel what I feel?</p>
      <p begin="02:51.100" end="02:54.290" ttm:agent="v1">Do you love like I love?</p>
      <p begin="02:54.290" end="02:57.560" ttm:agent="v1">Would you hold my hand?</p>
      <p begin="02:57.560" end="03:00.960" ttm:agent="v1">Would you let me go?</p>
      <p begin="03:00.960" end="03:04.640" ttm:agent="v1">Would you stand by my side?</p>
      <p begin="03:04.640" end="03:08.110" ttm:agent="v1">Are you down for the ride?</p>
      <p begin="03:08.110" end="03:14.570" ttm:agent="v1">I don't need nobody else but you</p>
      <p begin="03:14.570" end="03:16.070" ttm:agent="v1">But you</p>
      <p begin="03:15.410" end="03:19.410" ttm:agent="v1"/>
    </div>
  </body>
