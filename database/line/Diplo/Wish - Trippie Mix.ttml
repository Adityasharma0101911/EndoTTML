<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Wish - Trippie Mix</ttm:title>
      <ttm:agent type="person" xml:id="v1">Diplo</ttm:agent>
      <ttm:agent type="person" xml:id="v2">Trippie Redd</ttm:agent>
      <ttm:item type="album">LIFE'S A TRIP</ttm:item>
      <ttm:item type="spotify_id">6IpvkngH89cA3hhPC84Leg</ttm:item>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:00.686" end="00:08.686" ttm:agent="v1">[Refrain]</p>
      <p begin="00:12.968" end="00:15.713" ttm:agent="v1">Ohh, Baby, was wünschst du dir?</p>
      <p begin="00:15.713" end="00:18.185" ttm:agent="v1">Vielleicht solltest du es dir mehr wünschen</p>
      <p begin="00:18.185" end="00:20.669" ttm:agent="v1">Vielleicht gehört die Welt dir</p>
      <p begin="00:20.669" end="00:23.328" ttm:agent="v1" itunes:key="role" itunes:value="background">Vielleicht quellt es hervor, wenn es regnet (Wünsche weiter)</p>
      <p begin="00:23.328" end="00:25.967" ttm:agent="v1" itunes:key="role" itunes:value="background">Ich weiß nicht mehr, wie man etwas wünscht (Wünsche weiter)</p>
      <p begin="00:25.967" end="00:28.357" ttm:agent="v1">Ich weiß nicht mehr, wie man etwas wünscht</p>
      <p begin="00:28.357" end="00:29.857" ttm:agent="v1">Oder tue ich?</p>
      <p begin="00:29.180" end="00:30.680" ttm:agent="v1">[Post-Refrain]</p>
      <p begin="00:30.171" end="00:34.857" ttm:agent="v1">Ich wünschte, du würdest mir aus den Augen gehen, vielleicht verschollen werden</p>
      <p begin="00:34.857" end="00:39.976" ttm:agent="v1">Könnte mein Gehirn einfach wegpusten, ich wäre Kurt Cobain</p>
      <p begin="00:39.976" end="00:45.062" ttm:agent="v1">Ich kann mein Gesicht nicht fühlen, ich kann mein Gesicht nicht fühlen</p>
      <p begin="00:45.062" end="00:46.562" ttm:agent="v1">Ich kann mein Gesicht nicht fühlen, ich kann mein Gesicht nicht fühlen</p>
      <p begin="00:46.156" end="00:47.656" ttm:agent="v1"/>
      <p begin="00:46.883" end="00:51.638" ttm:agent="v1">[Strophe]</p>
      <p begin="00:51.638" end="00:54.018" ttm:agent="v1">Ich wünschte, du würdest deine Ruhe finden</p>
      <p begin="00:54.018" end="00:56.376" ttm:agent="v1">Weil Gott weiß, dass dieser Scheiß echt wird</p>
      <p begin="00:56.376" end="00:58.878" ttm:agent="v1">Und du weißte, dass du für dien Preis töten würdest</p>
      <p begin="00:58.878" end="01:01.401" ttm:agent="v1">Mann, dieser große Stapel, du kennst den Deal</p>
      <p begin="01:01.401" end="01:03.916" ttm:agent="v1">Mann, dieser große Schlag, du kennst den Deal</p>
      <p begin="01:03.916" end="01:06.501" ttm:agent="v1">Draco ein großer Drache, Feuer und Hölle</p>
      <p begin="01:06.501" end="01:08.993" ttm:agent="v1">Kannst mich nicht retten, rette dich selbst</p>
      <p begin="01:08.993" end="01:10.542" ttm:agent="v1">Weil ich keine Hilfe brauche</p>
      <p begin="01:10.542" end="01:12.042" ttm:agent="v1"/>
      <p begin="01:11.088" end="01:12.882" ttm:agent="v1">[Bridge]</p>
      <p begin="01:12.882" end="01:15.727" ttm:agent="v1">Wünsche weiter</p>
      <p begin="01:15.727" end="01:18.136" ttm:agent="v1">Wünsche weiter</p>
      <p begin="01:18.136" end="01:22.562" ttm:agent="v1">Wünsche weiter</p>
      <p begin="01:22.562" end="01:24.062" ttm:agent="v1">Ohh, ohh, ahh</p>
      <p begin="01:23.409" end="01:24.909" ttm:agent="v1"/>
      <p begin="01:23.695" end="01:31.695" ttm:agent="v1">[Refrain]</p>
      <p begin="01:34.383" end="01:37.333" ttm:agent="v1">Ohh, Baby, was wünschst du dir?</p>
      <p begin="01:37.333" end="01:39.782" ttm:agent="v1">Vielleicht solltest du es dir mehr wünschen</p>
      <p begin="01:39.782" end="01:42.311" ttm:agent="v1">Vielleicht gehört die Welt dir</p>
      <p begin="01:42.311" end="01:44.741" ttm:agent="v1" itunes:key="role" itunes:value="background">Vielleicht quellt es hervor, wenn es regnet (Wünsche weiter)</p>
      <p begin="01:44.741" end="01:47.411" ttm:agent="v1" itunes:key="role" itunes:value="background">Ich weiß nicht mehr, wie man etwas wünscht (Wünsche weiter)</p>
      <p begin="01:47.411" end="01:50.114" ttm:agent="v1">Ich weiß nicht mehr, wie man etwas wünscht</p>
      <p begin="01:50.114" end="01:51.614" ttm:agent="v1">Oder tue ich?</p>
      <p begin="01:50.751" end="01:52.251" ttm:agent="v1">[Post-Refrain]</p>
      <p begin="01:51.896" end="01:56.417" ttm:agent="v1">Ich wünschte, du würdest mir aus den Augen gehen, vielleicht verschollen werden</p>
      <p begin="01:56.417" end="02:01.587" ttm:agent="v1">Könnte mein Gehirn einfach wegpusten, ich wäre Kurt Cobain</p>
      <p begin="02:01.587" end="02:06.667" ttm:agent="v1">Ich kann mein Gesicht nicht fühlen, ich kann mein Gesicht nicht fühlen</p>
      <p begin="02:06.667" end="02:08.167" ttm:agent="v1">Ich kann mein Gesicht nicht fühlen, ich kann mein Gesicht nicht fühlen</p>
      <p begin="02:07.695" end="02:09.195" ttm:agent="v1"/>
      <p begin="02:08.452" end="02:15.218" ttm:agent="v1">[Refrain]</p>
      <p begin="02:15.218" end="02:18.287" ttm:agent="v1">Ooh, Baby, was wünschst du dir?</p>
      <p begin="02:18.287" end="02:20.589" ttm:agent="v1">Vielleicht solltest du es dir mehr wünschen</p>
      <p begin="02:20.589" end="02:23.132" ttm:agent="v1">Vielleicht gehört die Welt dir</p>
      <p begin="02:23.132" end="02:25.737" ttm:agent="v1" itunes:key="role" itunes:value="background">Vielleicht quellt es hervor, wenn es regnet (Wünsche weiter)</p>
      <p begin="02:25.737" end="02:28.415" ttm:agent="v1" itunes:key="role" itunes:value="background">Ich weiß nicht mehr, wie man etwas wünscht (Wünsche weiter)</p>
      <p begin="02:28.415" end="02:31.239" ttm:agent="v1">Ich weiß nicht mehr, wie man etwas wünscht</p>
      <p begin="02:31.239" end="02:32.739" ttm:agent="v1">Oder tue ich?</p>
      <p begin="02:32.600" end="02:34.100" ttm:agent="v1"/>
      <p begin="02:32.879" end="02:34.866" ttm:agent="v1">[Outro]</p>
      <p begin="02:34.866" end="02:38.866" ttm:agent="v1">Ohh, ohh, ahh</p>
    </div>
  </body>
</tt>
