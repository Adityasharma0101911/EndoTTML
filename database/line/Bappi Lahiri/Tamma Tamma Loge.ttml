<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Tamma Tamma Loge</ttm:title><ttm:agent type="group" xml:id="v1">Bappi Lahiri, Anuradha Paudwal</ttm:agent><ttm:item type="album">Thanedaar</ttm:item><ttm:item type="spotify_id">5HF9NzwuIWJqTVBjZ2Sgdg</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.720" end="00:02.490">Namaste behno aur bhaiyo</p><p ttm:agent="v1" begin="00:02.490" end="00:03.990">Bade hi kam shabdo mein</p><p ttm:agent="v1" begin="00:03.630" end="00:05.130">Aapko sunana chahata hoon</p><p ttm:agent="v1" begin="00:04.850" end="00:06.350">Uss saal ka lokpriye geet</p><p ttm:agent="v1" begin="00:05.940" end="00:08.190">Yeh</p><p ttm:agent="v1" begin="00:08.190" end="00:09.730">Tu premi (yeah)</p><p ttm:agent="v1" begin="00:09.730" end="00:11.620">Main premi (control)</p><p ttm:agent="v1" begin="00:11.620" end="00:13.540">Tu raazi (wait a minute)</p><p ttm:agent="v1" begin="00:13.540" end="00:15.500">Main raazi (uh ho!)</p><p ttm:agent="v1" begin="00:15.500" end="00:17.480">Tu (aaha)</p><p ttm:agent="v1" begin="00:17.480" end="00:19.070">Main (aaha)</p><p ttm:agent="v1" begin="00:19.070" end="00:21.420">Salaam le jata hua, udan khatola</p><p ttm:agent="v1" begin="00:21.420" end="00:29.420">Aur been bajati hui naagin</p><p ttm:agent="v1" begin="00:29.930" end="00:31.520">She about to go</p><p ttm:agent="v1" begin="00:31.520" end="00:33.110">Tu premi (aaha)</p><p ttm:agent="v1" begin="00:33.110" end="00:35.190">Main premi (aaha)</p><p ttm:agent="v1" begin="00:35.190" end="00:37.010">Tu raazi (aaha)</p><p ttm:agent="v1" begin="00:37.010" end="00:39.030">Main raazi</p><p ttm:agent="v1" begin="00:39.030" end="00:42.970">Phir kya daddy kya amma</p><p ttm:agent="v1" begin="00:42.970" end="00:46.850">Ik bas tuhi pyar ke kaabil</p><p ttm:agent="v1" begin="00:46.850" end="00:51.620">Saara jahan hai nikamma</p><p ttm:agent="v1" begin="00:51.620" end="00:55.320">Tamma tamma loge</p><p ttm:agent="v1" begin="00:55.320" end="00:59.380">Tamma tamma loge tamma</p><p ttm:agent="v1" begin="00:59.380" end="01:03.490">Tamma tamma loge</p><p ttm:agent="v1" begin="01:03.490" end="01:07.000">Tamma tamma loge tamma</p><p ttm:agent="v1" begin="01:07.000" end="01:08.530">Biin bajati hui naagin</p><p ttm:agent="v1" begin="01:08.530" end="01:16.530">Yo...</p><p ttm:agent="v1" begin="01:22.760" end="01:24.360">Woh badal gya</p><p ttm:agent="v1" begin="01:24.360" end="01:25.990">Rakhu na baby koi bhi shanka</p><p ttm:agent="v1" begin="01:25.990" end="01:27.820">Apne pyar ka baja du danka</p><p ttm:agent="v1" begin="01:27.820" end="01:29.680">Tere mere beech mein jo koi bhi aaya</p><p ttm:agent="v1" begin="01:29.680" end="01:32.180">Uski laga du lanka</p><p ttm:agent="v1" begin="01:32.180" end="01:33.760">Chhod chadke duniyadari</p><p ttm:agent="v1" begin="01:33.760" end="01:35.630">Bas tere pichhe pad gaya main</p><p ttm:agent="v1" begin="01:35.630" end="01:37.430">Sapno mein toh already</p><p ttm:agent="v1" begin="01:37.430" end="01:39.740">Ghodi-wodi chad gaya main</p><p ttm:agent="v1" begin="01:39.740" end="01:41.370">Mujhko baby lucky kar</p><p ttm:agent="v1" begin="01:41.370" end="01:43.250">Baat hamari pakki kar</p><p ttm:agent="v1" begin="01:43.250" end="01:46.290">Itna kya soche mujhe haan bol ke</p><p ttm:agent="v1" begin="01:46.290" end="01:49.380">Kam tu nakki kar</p><p ttm:agent="v1" begin="01:49.380" end="01:53.230">Tujhe zarurat mere jaise yaar ki</p><p ttm:agent="v1" begin="01:53.230" end="02:01.160">Mujhe zarurat tere jaise yaar ki</p><p ttm:agent="v1" begin="02:01.160" end="02:09.160">(Tujhe zarurat mere jaise yaar ki</p><p ttm:agent="v1" begin="02:11.700" end="02:13.200">Mujhe zarurat tere jaise yaar ki)</p><p ttm:agent="v1" begin="02:12.770" end="02:15.180">Jale jo usko aur jalao</p><p ttm:agent="v1" begin="02:15.180" end="02:21.510">Naacho chamma cham chamma</p><p ttm:agent="v1" begin="02:21.510" end="02:25.370">Tamma tamma</p><p ttm:agent="v1" begin="02:25.370" end="02:28.900">Tamma tamma</p><p ttm:agent="v1" begin="02:28.900" end="02:30.460">Upar chadhe ya neeche utrein</p><p ttm:agent="v1" begin="02:30.460" end="02:32.340">Three two one kill it</p><p ttm:agent="v1" begin="02:32.340" end="02:34.850">Loge</p><p ttm:agent="v1" begin="02:34.850" end="02:39.070">Tamma tamma loge tamma</p><p ttm:agent="v1" begin="02:39.070" end="02:42.770">Tamma tamma loge</p><p ttm:agent="v1" begin="02:42.770" end="02:46.740">Tamma tamma loge tamma</p><p ttm:agent="v1" begin="02:46.740" end="02:50.570">Tamma tamma loge</p><p ttm:agent="v1" begin="02:50.570" end="02:55.170">Tamma tamma loge tamma</p><p ttm:agent="v1" begin="02:55.170" end="02:58.480">Tamma tamma loge</p><p ttm:agent="v1" begin="02:58.480" end="03:02.430">Tamma tamma loge tamma</p><p ttm:agent="v1" begin="03:02.430" end="03:06.430" /></div></body></tt>