<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>losing interest</ttm:title>
      <ttm:agent type="person" xml:id="v1">Paycheck</ttm:agent>
      <ttm:agent type="person" xml:id="v2">Shiloh Dynasty</ttm:agent>
      <ttm:item type="album">identity crisis</ttm:item>
      <ttm:item type="spotify_id">4033bOwovL5l4CLXYM6kZL</ttm:item>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:00.050" end="00:05.020" ttm:agent="v1">Losing Interest, you won't find no better than this</p>
      <p begin="00:05.020" end="00:07.600" ttm:agent="v1">I swear, girl, if you leave</p>
      <p begin="00:07.600" end="00:11.550" ttm:agent="v1">Just let me know so it won't hurt bad</p>
      <p begin="00:11.550" end="00:16.320" ttm:agent="v1">When you move on</p>
      <p begin="00:16.320" end="00:20.920" ttm:agent="v1">Losing Interest, you won't find no better than this</p>
      <p begin="00:20.920" end="00:24.750" ttm:agent="v1">I swear, girl, if you leave, just let me-</p>
      <p begin="00:24.750" end="00:29.390" ttm:agent="v1">Losing Interest, you won't find no better than this</p>
      <p begin="00:29.390" end="00:31.650" ttm:agent="v1">I swear, girl, if you leave, just let me-</p>
      <p begin="00:31.650" end="00:34.590" ttm:agent="v1">Yeah, what did I tell you guys?</p>
      <p begin="00:34.590" end="00:36.340" ttm:agent="v1">I said, what did I tell you?</p>
      <p begin="00:36.340" end="00:38.340" ttm:agent="v1">These people are sayin' my dream isn't real</p>
      <p begin="00:38.340" end="00:40.500" ttm:agent="v1">They say that about every thing I feel</p>
      <p begin="00:40.500" end="00:42.000" ttm:agent="v1">What happened to being supportive?</p>
      <p begin="00:41.990" end="00:44.260" ttm:agent="v1">Some people heard my touchy songs and abhorred it</p>
      <p begin="00:44.260" end="00:45.940" ttm:agent="v1">I got a passion, you know I'll uphold it</p>
      <p begin="00:45.940" end="00:48.910" ttm:agent="v1">And I'm buildin' traction, yeah, you know that I rolled it</p>
      <p begin="00:48.910" end="00:51.230" ttm:agent="v1">What you expect though?</p>
      <p begin="00:51.230" end="00:52.730" ttm:agent="v1">What you expect?</p>
      <p begin="00:52.160" end="00:53.950" ttm:agent="v1">Me at 13, didn't do what to do</p>
      <p begin="00:53.950" end="00:56.560" ttm:agent="v1">Last October's when it all fell through</p>
      <p begin="00:56.560" end="00:58.500" ttm:agent="v1">I was close to being gone</p>
      <p begin="00:58.500" end="01:00.560" ttm:agent="v1">And none of y'all even noticed</p>
      <p begin="01:00.560" end="01:02.410" ttm:agent="v1">Except for the few that cared</p>
      <p begin="01:02.410" end="01:04.600" ttm:agent="v1">It's for that reason that I wrote this</p>
      <p begin="01:04.600" end="01:08.560" ttm:agent="v1">I'm tired of being judged</p>
      <p begin="01:08.560" end="01:12.980" ttm:agent="v1">I'm tired of being nudged</p>
      <p begin="01:12.980" end="01:14.880" ttm:agent="v1">I know that I've fallen into this before, it</p>
      <p begin="01:14.880" end="01:16.620" ttm:agent="v1">Kills me inside, it's a chore</p>
      <p begin="01:16.620" end="01:18.520" ttm:agent="v1">I really don't know why that I ever tried to hide</p>
      <p begin="01:18.520" end="01:20.980" ttm:agent="v1">From my fear creeping inside, makin' me feel like I wanna cry</p>
      <p begin="01:20.980" end="01:25.760" ttm:agent="v1">Losing Interest, you won't find no better than this</p>
      <p begin="01:25.760" end="01:28.050" ttm:agent="v1">I swear, girl, if you leave</p>
      <p begin="01:28.050" end="01:31.660" ttm:agent="v1">Just let me know so it won't hurt bad</p>
      <p begin="01:31.660" end="01:37.220" ttm:agent="v1">When you move on, whoa, whoa, whoa, whoa</p>
      <p begin="01:37.220" end="01:42.060" ttm:agent="v1">Losing Interest, you won't find no better than this</p>
      <p begin="01:42.060" end="01:45.980" ttm:agent="v1">I swear, girl, if you leave, just let me...</p>
      <p begin="01:45.980" end="01:49.980" ttm:agent="v1"/>
    </div>
  </body>
</tt>
