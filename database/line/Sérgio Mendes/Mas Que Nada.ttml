<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Mas Que Nada</ttm:title><ttm:agent type="group" xml:id="v1">Sérgio Mendes, Black Eyed Peas</ttm:agent><ttm:item type="album">Timeless</ttm:item><ttm:item type="spotify_id">6U7GUjtamt2P0LcFod1dBT</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:11.480" end="00:19.480">Oaria raio, obá, obá, obá</p><p ttm:agent="v1" begin="00:22.640" end="00:30.640">O o-o-o-o arya ayo, obá, obá, obá</p><p ttm:agent="v1" begin="00:32.680" end="00:34.440">Mas que nada</p><p ttm:agent="v1" begin="00:34.440" end="00:35.940">Sai da minha frente</p><p ttm:agent="v1" begin="00:35.740" end="00:37.290">Que eu quero passar</p><p ttm:agent="v1" begin="00:37.290" end="00:39.890">Pois o samba está animado</p><p ttm:agent="v1" begin="00:39.890" end="00:43.850">O que eu quero é sambar</p><p ttm:agent="v1" begin="00:43.850" end="00:45.540">Este samba</p><p ttm:agent="v1" begin="00:45.540" end="00:48.110">Que é misto de maracatú</p><p ttm:agent="v1" begin="00:48.110" end="00:50.630">É samba de preto velho</p><p ttm:agent="v1" begin="00:50.630" end="00:54.460">Samba de preto tu</p><p ttm:agent="v1" begin="00:54.460" end="00:56.150">Mas que nada</p><p ttm:agent="v1" begin="00:56.150" end="00:58.550">Um samba como esse tão legal</p><p ttm:agent="v1" begin="00:58.550" end="01:01.000">Você não vai querer</p><p ttm:agent="v1" begin="01:01.000" end="01:05.960">Que eu chegue no final</p><p ttm:agent="v1" begin="01:05.960" end="01:13.960">Oaria raio, obá, obá, obá</p><p ttm:agent="v1" begin="01:16.500" end="01:24.500">O o-o-o-o arya ayo, obá, obá, obá</p><p ttm:agent="v1" begin="01:26.590" end="01:28.560">Mas que nada</p><p ttm:agent="v1" begin="01:28.560" end="01:30.060">Sai da minha frente</p><p ttm:agent="v1" begin="01:29.780" end="01:31.280">Que eu quero passar</p><p ttm:agent="v1" begin="01:31.070" end="01:33.720">Pois o samba está animado</p><p ttm:agent="v1" begin="01:33.720" end="01:37.520">O que eu quero é sambar</p><p ttm:agent="v1" begin="01:37.520" end="01:39.270">Este samba</p><p ttm:agent="v1" begin="01:39.270" end="01:40.860">Que é misto de maracatú</p><p ttm:agent="v1" begin="01:40.860" end="01:44.840">É samba de preto velho</p><p ttm:agent="v1" begin="01:44.840" end="01:48.160">Samba de preto tu</p><p ttm:agent="v1" begin="01:48.160" end="01:50.010">Mas que nada</p><p ttm:agent="v1" begin="01:50.010" end="01:52.660">Um samba como esse tão legal</p><p ttm:agent="v1" begin="01:52.660" end="01:55.480">Você não vai querer</p><p ttm:agent="v1" begin="01:55.480" end="01:59.560">Que eu chegue no final</p><p ttm:agent="v1" begin="01:59.560" end="02:07.560">Oaria raio, obá, obá, obá</p><p ttm:agent="v1" begin="02:09.450" end="02:17.450">O o-o-o-o arya ayo, obá, obá, obá</p><p ttm:agent="v1" begin="02:21.030" end="02:24.140">obá, obá, obá</p><p ttm:agent="v1" begin="02:24.140" end="02:29.000">obá, obá, obá...</p><p ttm:agent="v1" begin="02:29.000" end="02:33.000" /></div></body></tt>