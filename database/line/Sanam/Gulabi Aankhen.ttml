<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Gulabi Aankhen</ttm:title><ttm:agent type="person" xml:id="v1">Sanam</ttm:agent><ttm:item type="album">Universally SANAM</ttm:item><ttm:item type="spotify_id">1ccZZf0IQi5y0bHMl2aGDF</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:18.850" end="00:23.370">gulabi ankhen jo teri dekhin</p><p ttm:agent="v1" begin="00:23.370" end="00:27.790">sharaabi ye dil ho gaya</p><p ttm:agent="v1" begin="00:27.790" end="00:32.370">sambhaalo mujko o mere yaaron</p><p ttm:agent="v1" begin="00:32.370" end="00:36.820">sambhalana mushkil ho gaya</p><p ttm:agent="v1" begin="00:36.820" end="00:41.430">gulabi ankhen jo teri dekhin</p><p ttm:agent="v1" begin="00:41.430" end="00:46.020">sharaabi ye dil ho gaya</p><p ttm:agent="v1" begin="00:46.020" end="00:54.020" /><p ttm:agent="v1" begin="00:55.030" end="00:59.260">dil mein mere khwaab tere</p><p ttm:agent="v1" begin="00:59.260" end="01:04.000">tasviir jaise hon diwaar pe</p><p ttm:agent="v1" begin="01:04.000" end="01:08.320">tujhpe fidaa main kyun hua</p><p ttm:agent="v1" begin="01:08.320" end="01:12.550">aathaa hai gussa mujhe pyaar pe</p><p ttm:agent="v1" begin="01:12.550" end="01:17.570">main lut gaya maan ke dil kaa kaha</p><p ttm:agent="v1" begin="01:17.570" end="01:19.840">main kaheen kaa naa raha</p><p ttm:agent="v1" begin="01:19.840" end="01:22.240">kya kahoon main dilruba</p><p ttm:agent="v1" begin="01:22.240" end="01:26.720">bura ye jaadoo teri aankhon kaa</p><p ttm:agent="v1" begin="01:26.720" end="01:31.240">ye mera qaatil ho gaya</p><p ttm:agent="v1" begin="01:31.240" end="01:35.750">gulabi ankhen jo teri dekhi</p><p ttm:agent="v1" begin="01:35.750" end="01:40.410">sharaabi ye dil ho gaya</p><p ttm:agent="v1" begin="01:40.410" end="01:48.410" /><p ttm:agent="v1" begin="01:49.280" end="01:53.860">maine sada chaha yahi</p><p ttm:agent="v1" begin="01:53.860" end="01:58.430">daaman bachaa lun haseenon se main</p><p ttm:agent="v1" begin="01:58.430" end="02:02.840">teri gasam khwaabon mein bhee</p><p ttm:agent="v1" begin="02:02.840" end="02:07.290">bachataa phiraa naazaneenon se main</p><p ttm:agent="v1" begin="02:07.290" end="02:11.820">tauba magar mil gayi tujhse nazar</p><p ttm:agent="v1" begin="02:11.820" end="02:14.000">mil gaya dard-e-jigar</p><p ttm:agent="v1" begin="02:14.000" end="02:16.220">sun zaraa o bekabar</p><p ttm:agent="v1" begin="02:16.220" end="02:17.720" /><p ttm:agent="v1" begin="02:16.420" end="02:20.990">zaraa sa hans ke io dekha toone</p><p ttm:agent="v1" begin="02:20.990" end="02:25.430">main tera bismil ho gaya</p><p ttm:agent="v1" begin="02:25.430" end="02:29.990">gulabi ankhen jo teri dekhi</p><p ttm:agent="v1" begin="02:29.990" end="02:34.460">sharaabi ye dil ho gaya</p><p ttm:agent="v1" begin="02:34.460" end="02:39.080">sambhaalo mujko o mere yaaron</p><p ttm:agent="v1" begin="02:39.080" end="02:43.080">sambhalana mushkil ho gaya</p></div></body></tt>