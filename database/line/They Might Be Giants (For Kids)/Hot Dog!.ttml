<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Hot Dog!</ttm:title>
      <ttm:agent type="person" xml:id="v1">They Might Be Giants (For Kids)</ttm:agent>
      <ttm:agent type="person" xml:id="v2">Disney Junior</ttm:agent>
      <ttm:item type="album">Mickey Mouse Clubhouse</ttm:item>
      <ttm:item type="spotify_id">3vjOGPGu3tgYi3oBkQ2Gjz</ttm:item>
      <itunes:duration>02:28.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:06.600" end="00:09.920" ttm:agent="v1">Hot dog!</p>
      <p begin="00:09.920" end="00:12.260" ttm:agent="v1"/>
      <p begin="00:12.260" end="00:15.290" ttm:agent="v1">Hot dog!</p>
      <p begin="00:15.290" end="00:17.310" ttm:agent="v1"/>
      <p begin="00:17.310" end="00:19.890" ttm:agent="v1">Hot dog, hot dog, hot diggety dog</p>
      <p begin="00:19.890" end="00:22.360" ttm:agent="v1">Now we've got ears, it's time for cheers</p>
      <p begin="00:22.360" end="00:26.980" ttm:agent="v1">Hot dog, hot dog, the problem's solved</p>
      <p begin="00:26.980" end="00:31.100" ttm:agent="v1">Hot dog, hot dog, hot diggety dog</p>
      <p begin="00:31.100" end="00:39.100" ttm:agent="v1"/>
      <p begin="00:41.770" end="00:44.520" ttm:agent="v1">Grab my boots and a sandwich</p>
      <p begin="00:44.520" end="00:46.920" ttm:agent="v1">Let's start a parade</p>
      <p begin="00:46.920" end="00:49.770" ttm:agent="v1">Get the coconut drum kit</p>
      <p begin="00:49.770" end="00:54.740" ttm:agent="v1">For Daisy to play</p>
      <p begin="00:54.740" end="01:02.740" ttm:agent="v1"/>
      <p begin="01:04.660" end="01:07.140" ttm:agent="v1">Hot dog, hot dog, hot diggety dog</p>
      <p begin="01:07.140" end="01:09.770" ttm:agent="v1">We're taking off, we're dancing now</p>
      <p begin="01:09.770" end="01:14.410" ttm:agent="v1">Hot dog, leapfrog, and holy cow</p>
      <p begin="01:14.410" end="01:18.500" ttm:agent="v1">Hot dog, hot dog, hot diggety dog</p>
      <p begin="01:18.500" end="01:26.500" ttm:agent="v1"/>
      <p begin="01:51.960" end="01:54.680" ttm:agent="v1">Hot dog, hot dog, hot diggety dog</p>
      <p begin="01:54.680" end="01:56.180" ttm:agent="v1">It's a brand new day</p>
      <p begin="01:55.860" end="01:57.360" ttm:agent="v1">What you waiting for?</p>
      <p begin="01:57.050" end="02:01.630" ttm:agent="v1">Get up, stretch out, stomp on the floor</p>
      <p begin="02:01.630" end="02:04.240" ttm:agent="v1">Hot dog, hot dog, hot diggety dog</p>
      <p begin="02:04.240" end="02:06.800" ttm:agent="v1">Hot dog, hot dog, hot diggety dog</p>
      <p begin="02:06.800" end="02:08.480" ttm:agent="v1">We're splitting the scene</p>
      <p begin="02:08.480" end="02:09.980" ttm:agent="v1">We're full of beans</p>
      <p begin="02:09.440" end="02:14.190" ttm:agent="v1" itunes:key="role" itunes:value="background">So long for now from Mickey Mouse (that's me!)</p>
      <p begin="02:14.190" end="02:15.690" ttm:agent="v1">And the Mickey Mouse Clubhouse</p>
      <p begin="02:14.230" end="02:18.230" ttm:agent="v1"/>
    </div>
  </body>
</tt>
