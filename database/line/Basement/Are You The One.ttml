<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Are You The One</ttm:title><ttm:agent type="person" xml:id="v1">Basement</ttm:agent><ttm:item type="album">Be Here Now / Are You The One</ttm:item><ttm:item type="spotify_id">78rksSenQxeXyOtTJeXEjA</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.000" end="00:08.000">[Verse 1]</p><p ttm:agent="v1" begin="00:12.771" end="00:15.019">I'm in need of help</p><p ttm:agent="v1" begin="00:15.019" end="00:19.002">Are you the one?</p><p ttm:agent="v1" begin="00:19.002" end="00:21.346">To show me to myself</p><p ttm:agent="v1" begin="00:21.346" end="00:26.136">Are you the one?</p><p ttm:agent="v1" begin="00:26.136" end="00:28.343">Is it hesitance</p><p ttm:agent="v1" begin="00:28.343" end="00:31.546">Or is this feeling heaven sent?</p><p ttm:agent="v1" begin="00:31.546" end="00:33.874">Staring at the sun</p><p ttm:agent="v1" begin="00:33.874" end="00:36.215">Are you the one?</p><p ttm:agent="v1" begin="00:36.215" end="00:37.715" /><p ttm:agent="v1" begin="00:36.768" end="00:38.268">[Pre Chorus]</p><p ttm:agent="v1" begin="00:37.744" end="00:40.889">'cause I've been waiting</p><p ttm:agent="v1" begin="00:40.889" end="00:45.734">Waiting for the end</p><p ttm:agent="v1" begin="00:45.734" end="00:47.234" /><p ttm:agent="v1" begin="00:46.332" end="00:47.832">[Chorus]</p><p ttm:agent="v1" begin="00:46.408" end="00:51.128">Maybe we could be</p><p ttm:agent="v1" begin="00:51.128" end="00:55.808">Sweet eternity</p><p ttm:agent="v1" begin="00:55.808" end="01:02.096">Are you the one?</p><p ttm:agent="v1" begin="01:02.096" end="01:04.258">Are you the one?</p><p ttm:agent="v1" begin="01:04.258" end="01:05.758" /><p ttm:agent="v1" begin="01:05.554" end="01:07.054">[Verse 2]</p><p ttm:agent="v1" begin="01:06.042" end="01:08.373">Dreaming I'm sleep</p><p ttm:agent="v1" begin="01:08.373" end="01:12.365">Are you the one?</p><p ttm:agent="v1" begin="01:12.365" end="01:19.397">Pray my soul to keep</p><p ttm:agent="v1" begin="01:19.397" end="01:21.379">Comfort seems unreal</p><p ttm:agent="v1" begin="01:21.379" end="01:24.763">The opposite of how I feel</p><p ttm:agent="v1" begin="01:24.763" end="01:27.275">Before I come undone</p><p ttm:agent="v1" begin="01:27.275" end="01:29.592">Are you the one?</p><p ttm:agent="v1" begin="01:29.592" end="01:31.092">Primis Player Placeholder</p><p ttm:agent="v1" begin="01:30.383" end="01:31.883">[Pre Chorus]</p><p ttm:agent="v1" begin="01:31.255" end="01:34.312">'cause I've been waiting</p><p ttm:agent="v1" begin="01:34.312" end="01:37.605">Waiting for the end</p><p ttm:agent="v1" begin="01:37.605" end="01:39.440" /><p ttm:agent="v1" begin="01:39.440" end="01:40.940">[Chorus]</p><p ttm:agent="v1" begin="01:39.734" end="01:44.374">Maybe we could be</p><p ttm:agent="v1" begin="01:44.374" end="01:49.166">Sweet eternity</p><p ttm:agent="v1" begin="01:49.166" end="01:53.797">Maybe we could be</p><p ttm:agent="v1" begin="01:53.797" end="02:00.086">Are you the one?</p><p ttm:agent="v1" begin="02:00.086" end="02:02.462">Are you the one?</p><p ttm:agent="v1" begin="02:02.462" end="02:03.962" /><p ttm:agent="v1" begin="02:03.326" end="02:06.422">[Bridge]</p><p ttm:agent="v1" begin="02:06.422" end="02:14.422">Are you the one?</p><p ttm:agent="v1" begin="02:19.051" end="02:22.407">Are you the one?</p><p ttm:agent="v1" begin="02:22.407" end="02:23.907" /><p ttm:agent="v1" begin="02:22.657" end="02:24.157">[Pre Chorus]</p><p ttm:agent="v1" begin="02:22.788" end="02:26.012">'cause I've been waiting</p><p ttm:agent="v1" begin="02:26.012" end="02:31.028">Waiting for the end</p><p ttm:agent="v1" begin="02:31.028" end="02:32.528" /><p ttm:agent="v1" begin="02:31.440" end="02:32.940">[Chorus]</p><p ttm:agent="v1" begin="02:31.517" end="02:36.213">Maybe we could be</p><p ttm:agent="v1" begin="02:36.213" end="02:40.942">Sweet eternity</p><p ttm:agent="v1" begin="02:40.942" end="02:45.734">Maybe we could be</p><p ttm:agent="v1" begin="02:45.734" end="02:49.734">Sweet eternity</p></div></body></tt>