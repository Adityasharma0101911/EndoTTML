      <ttm:item type="spotify_id">6xfsvHFXr8GgRzaFAkmjAY</ttm:item>
      <itunes:duration>04:28.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:09.180" end="00:11.940" ttm:agent="v1">Minsan ay nahuhuli</p>
      <p begin="00:11.940" end="00:16.900" ttm:agent="v1">Ang sarili na nag-aalala, ah</p>
      <p begin="00:16.900" end="00:22.020" ttm:agent="v1">Mga bagay na 'di kontrolado, pinoproblema</p>
      <p begin="00:22.020" end="00:25.840" ttm:agent="v1">Pero teka lang</p>
      <p begin="00:25.840" end="00:29.780" ttm:agent="v1">Mayro'n bang humahabol sa 'yo?</p>
      <p begin="00:29.780" end="00:33.950" ttm:agent="v1" itunes:key="role" itunes:value="background">(Oh-oh, ooh-whoa, oh-oh, ooh-whoa)</p>
      <p begin="00:33.950" end="00:37.930" ttm:agent="v1">'Di naman dapat matulin ang pagtakbo</p>
      <p begin="00:37.930" end="00:40.430" ttm:agent="v1">Ooh-whoa, ooh-whoa, oh</p>
      <p begin="00:40.430" end="00:44.880" ttm:agent="v1">Sino bang nagsabi na kailangan kong mauna?</p>
      <p begin="00:44.880" end="00:49.650" ttm:agent="v1">Hindi naman ito karera, puwedeng magdahan-dahan</p>
      <p begin="00:49.650" end="00:53.350" ttm:agent="v1">Sa bawat panibagong umaga</p>
      <p begin="00:53.350" end="00:58.070" ttm:agent="v1">Ang pagsimula muli ay isang tagumpay na</p>
      <p begin="00:58.070" end="01:01.120" ttm:agent="v1">Oh, oh-oh-oh</p>
      <p begin="01:01.120" end="01:05.010" ttm:agent="v1">Huwag mag-alala, buhay ay 'di karera</p>
      <p begin="01:05.010" end="01:09.310" ttm:agent="v1">Oh, oh-oh-oh</p>
      <p begin="01:09.310" end="01:16.340" ttm:agent="v1">Dahan-dahan lang, buhay ay 'di karera</p>
      <p begin="01:16.340" end="01:22.360" ttm:agent="v1">Buhay ay, oh</p>
      <p begin="01:22.360" end="01:27.020" ttm:agent="v1">Minsan ay nalilimutang huminga sandali</p>
      <p begin="01:27.020" end="01:30.220" ttm:agent="v1" itunes:key="role" itunes:value="background">Magpahinga lang saglit (oh-oh, oh-oh)</p>
      <p begin="01:30.220" end="01:35.130" ttm:agent="v1">At 'di kailangang magmadali para magwagi</p>
      <p begin="01:35.130" end="01:38.920" ttm:agent="v1">Puwedeng unti-unti</p>
      <p begin="01:38.920" end="01:42.870" ttm:agent="v1">Wala namang humahabol sa 'yo, ooh-whoa</p>
      <p begin="01:42.870" end="01:47.120" ttm:agent="v1" itunes:key="role" itunes:value="background">(Oh-oh, ooh-whoa, oh-oh, ooh-whoa)</p>
      <p begin="01:47.120" end="01:51.330" ttm:agent="v1">'Di naman dapat matulin ang pagtakbo</p>
      <p begin="01:51.330" end="01:53.740" ttm:agent="v1">Ooh-whoa, ooh-whoa, oh</p>
      <p begin="01:53.740" end="01:58.280" ttm:agent="v1">Sino bang nagsabi na kailangan kong mauna?</p>
      <p begin="01:58.280" end="02:02.950" ttm:agent="v1">Hindi naman ito karera, puwedeng magdahan-dahan</p>
      <p begin="02:02.950" end="02:06.700" ttm:agent="v1">Sa bawat panibagong umaga</p>
      <p begin="02:06.700" end="02:11.140" ttm:agent="v1">Ang pagsimula muli ay isang tagumpay na</p>
      <p begin="02:11.140" end="02:14.500" ttm:agent="v1">Oh, oh-oh-oh</p>
      <p begin="02:14.500" end="02:18.370" ttm:agent="v1">Huwag mag-alala, buhay ay 'di karera</p>
      <p begin="02:18.370" end="02:22.680" ttm:agent="v1">Whoa, oh-oh, oh, oh-oh</p>
      <p begin="02:22.680" end="02:29.580" ttm:agent="v1">Dahan-dahan lang, buhay ay 'di karera</p>
      <p begin="02:29.580" end="02:37.580" ttm:agent="v1">Oh-whoa, oh, whoa, oh</p>
      <p begin="02:37.610" end="02:43.430" ttm:agent="v1">Ooh-ooh-ooh, ooh-ooh, ah, ah-ah</p>
      <p begin="02:43.430" end="02:51.430" ttm:agent="v1">Yeah, buhay ay 'di, oh-oh, 'di karera</p>
      <p begin="02:53.170" end="02:58.160" ttm:agent="v1">Buhay ay 'di karera, oh-oh</p>
      <p begin="02:58.160" end="03:00.060" ttm:agent="v1">Hey, hey, BINI</p>
      <p begin="03:00.060" end="03:02.210" ttm:agent="v1">Maraming beses nangamba, nadapa, tumaya</p>
      <p begin="03:02.210" end="03:04.150" ttm:agent="v1">Naniwala sa mundong madaya, uh</p>
      <p begin="03:04.150" end="03:06.220" ttm:agent="v1">Ano nga ba? Sino nga ba? Ikaw ba? O ako ba?</p>
      <p begin="03:06.220" end="03:08.270" ttm:agent="v1">Hinay lang, huwag bahala, 'hala</p>
      <p begin="03:08.270" end="03:10.710" ttm:agent="v1">Yah, huwag ka nang maniniwala sa paniniwala</p>
      <p begin="03:10.710" end="03:12.950" ttm:agent="v1">Na dapat makipag-unahan sa karera</p>
      <p begin="03:12.950" end="03:14.880" ttm:agent="v1">Kung wala namang karera, dahan-dahan, tahan lang</p>
      <p begin="03:14.880" end="03:16.380" ttm:agent="v1">Kakayanin, umpisa pa lang</p>
      <p begin="03:15.130" end="03:19.390" ttm:agent="v1">Sino bang nagsabi na kailangan kong mauna?</p>
      <p begin="03:19.390" end="03:24.350" ttm:agent="v1">Hindi naman ito karera, puwedeng magdahan-dahan</p>
      <p begin="03:24.350" end="03:27.960" ttm:agent="v1">Sa bawat panibagong umaga</p>
      <p begin="03:27.960" end="03:32.610" ttm:agent="v1">Ang pagsimula muli ay isang tagumpay na</p>
      <p begin="03:32.610" end="03:35.780" ttm:agent="v1">Oh, oh-oh-oh</p>
      <p begin="03:35.780" end="03:39.570" ttm:agent="v1">Huwag mag-alala, buhay ay 'di karera</p>
      <p begin="03:39.570" end="03:43.990" ttm:agent="v1">Whoa, oh-oh, oh, oh-oh</p>
      <p begin="03:43.990" end="03:48.310" ttm:agent="v1">Dahan-dahan lang, buhay ay 'di karera</p>
      <p begin="03:48.310" end="03:50.300" ttm:agent="v1">Walang masyadong mabagal, walang mabilis</p>
      <p begin="03:50.300" end="03:52.420" ttm:agent="v1">Sa pagtakbo ng buhay, hindi ka mimintis</p>
      <p begin="03:52.420" end="03:54.490" ttm:agent="v1">Hingang malalim lang at tandaan</p>
      <p begin="03:54.490" end="03:56.460" ttm:agent="v1">Ika'y may hawak ng iyong hakbang</p>
      <p begin="03:56.460" end="03:58.420" ttm:agent="v1">Walang masyadong mabagal, walang mabilis</p>
      <p begin="03:58.420" end="04:00.530" ttm:agent="v1" itunes:key="role" itunes:value="background">Sa pagtakbo ng buhay, hindi ka mimintis (oh)</p>
      <p begin="04:00.530" end="04:02.550" ttm:agent="v1" itunes:key="role" itunes:value="background">Hingang malalim lang at tandaan (oh-oh)</p>
      <p begin="04:02.550" end="04:04.500" ttm:agent="v1" itunes:key="role" itunes:value="background">Ika'y may hawak ng iyong hakbang (buhay ay 'di karera)</p>
      <p begin="04:04.500" end="04:06.510" ttm:agent="v1" itunes:key="role" itunes:value="background">Walang masyadong mabagal, walang mabilis (oh-oh)</p>
      <p begin="04:06.510" end="04:08.740" ttm:agent="v1">Sa pagtakbo ng buhay, hindi ka mimintis</p>
      <p begin="04:08.740" end="04:10.700" ttm:agent="v1" itunes:key="role" itunes:value="background">Hingang malalim lang at tandaan (huwag mag-alala)</p>
      <p begin="04:10.700" end="04:12.850" ttm:agent="v1" itunes:key="role" itunes:value="background">Ika'y may hawak ng iyong hakbang (yeah, yeah)</p>
      <p begin="04:12.850" end="04:14.630" ttm:agent="v1">Walang masyadong mabagal, walang mabilis</p>
      <p begin="04:14.630" end="04:16.570" ttm:agent="v1">Sa pagtakbo ng buhay, hindi ka mimintis</p>
      <p begin="04:16.570" end="04:21.210" ttm:agent="v1">Dahan-dahan lang, buhay ay 'di karera</p>
      <p begin="04:21.210" end="04:25.210" ttm:agent="v1"/>
    </div>
  </body>
