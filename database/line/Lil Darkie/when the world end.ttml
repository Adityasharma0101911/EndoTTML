<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>when the world end</ttm:title>
      <ttm:agent type="person" xml:id="v1">Lil Darkie</ttm:agent>
      <ttm:item type="album">LIL DARKIE CLASSICS 2</ttm:item>
      <ttm:item type="spotify_id">181ez25DOmzsYfFtyHNK1x</ttm:item>
      <itunes:duration>01:33.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:00.580" end="00:08.580" ttm:agent="v1">Jimmy, would you please put on that one beat?</p>
      <p begin="00:13.130" end="00:16.580" ttm:agent="v1">Damn Timmy, this some serious gourmet shit!</p>
      <p begin="00:16.580" end="00:20.110" ttm:agent="v1">Huh, when the world end I'ma be with you</p>
      <p begin="00:20.110" end="00:23.050" ttm:agent="v1">It doesn't matter if you hot or if you cool, nah</p>
      <p begin="00:23.050" end="00:26.130" ttm:agent="v1">Niggas want you dead it's all connected, I'm a fool</p>
      <p begin="00:26.130" end="00:28.910" ttm:agent="v1">Bitch you made of water you related to the pool</p>
      <p begin="00:28.910" end="00:31.060" ttm:agent="v1">That I'm swimmin' in and gettin' tan</p>
      <p begin="00:31.060" end="00:33.370" ttm:agent="v1">I'ma grin when I'm in the pan</p>
      <p begin="00:33.370" end="00:36.250" ttm:agent="v1">And grilling damn my, skin like some cinnamon</p>
      <p begin="00:36.250" end="00:37.750" ttm:agent="v1">Does that offend you?</p>
      <p begin="00:37.410" end="00:40.670" ttm:agent="v1">Friends is some winners man, and I'm the man too</p>
      <p begin="00:40.670" end="00:43.620" ttm:agent="v1">&quot;Can I be a spider too?&quot; I don't know can you?</p>
      <p begin="00:43.620" end="00:46.790" ttm:agent="v1">This is just my clan, we gon' run it until we can't dude</p>
      <p begin="00:46.790" end="00:48.290" ttm:agent="v1">Then the world it end</p>
      <p begin="00:47.540" end="00:49.830" ttm:agent="v1">Be forgotten that's all you can do</p>
      <p begin="00:49.830" end="00:51.670" ttm:agent="v1">Plan to, run up them bands</p>
      <p begin="00:51.670" end="00:53.170" ttm:agent="v1">And buy some canned food</p>
      <p begin="00:52.790" end="00:54.500" ttm:agent="v1">What you doing wit' yo' time?</p>
      <p begin="00:54.500" end="00:57.610" ttm:agent="v1">Ain't doing shit you could you asking how to spit a rhyme</p>
      <p begin="00:57.610" end="00:59.130" ttm:agent="v1">Get off yo' ass there ain't a class</p>
      <p begin="00:59.130" end="01:02.220" ttm:agent="v1">I bet you wish you find a million dollars on the street</p>
      <p begin="01:02.220" end="01:04.310" ttm:agent="v1">I bet the picture prime inside yo' head</p>
      <p begin="01:04.310" end="01:06.990" ttm:agent="v1">I go to bed and stress at shit online</p>
      <p begin="01:06.990" end="01:08.770" ttm:agent="v1">Ain't read the book my momma gave me</p>
      <p begin="01:08.770" end="01:12.060" ttm:agent="v1">And I owe it to that lady, kill this shit and fix my mind</p>
      <p begin="01:12.060" end="01:15.140" ttm:agent="v1">I'ma crack the cover, keep a grip up on the spine</p>
      <p begin="01:15.140" end="01:18.420" ttm:agent="v1">I ain't read a book in like a year, maybe it's fine</p>
      <p begin="01:18.420" end="01:24.480" ttm:agent="v1">When the world end I'ma be with you</p>
      <p begin="01:24.480" end="01:26.920" ttm:agent="v1">When the world end 'least I read it through</p>
      <p begin="01:26.920" end="01:30.920" ttm:agent="v1"/>
    </div>
  </body>
</tt>
