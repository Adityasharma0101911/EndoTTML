<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>all i need</ttm:title>
      <ttm:agent type="person" xml:id="v1">jondre</ttm:agent>
      <ttm:item type="album">all i need</ttm:item>
      <ttm:item type="spotify_id">4vGADmRWPvTljmArsNmwGS</ttm:item>
      <itunes:duration>02:28.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:14.160" end="00:15.850" ttm:agent="v1">Sitting there with your head</p>
      <p begin="00:15.850" end="00:18.030" ttm:agent="v1">On my shoulder and chest</p>
      <p begin="00:18.030" end="00:20.550" ttm:agent="v1">Finding some rest</p>
      <p begin="00:20.550" end="00:22.440" ttm:agent="v1">Didn't think that my life</p>
      <p begin="00:22.440" end="00:24.700" ttm:agent="v1">Could be whole with just less</p>
      <p begin="00:24.700" end="00:26.660" ttm:agent="v1">Than your best</p>
      <p begin="00:26.660" end="00:31.170" ttm:agent="v1">Our hearts could beat in time</p>
      <p begin="00:31.170" end="00:32.810" ttm:agent="v1">If you're mine</p>
      <p begin="00:32.810" end="00:37.580" ttm:agent="v1">But you held a space between lovers and friends</p>
      <p begin="00:37.580" end="00:39.850" ttm:agent="v1">And I hope this ends</p>
      <p begin="00:39.850" end="00:42.710" ttm:agent="v1">One day you'll see</p>
      <p begin="00:42.710" end="00:45.930" ttm:agent="v1">I love you endlessly</p>
      <p begin="00:45.930" end="00:49.210" ttm:agent="v1">Till life's complete</p>
      <p begin="00:49.210" end="00:52.570" ttm:agent="v1">I'll wait here patiently</p>
      <p begin="00:52.570" end="00:54.090" ttm:agent="v1">I wish that</p>
      <p begin="00:54.090" end="00:55.890" ttm:agent="v1">You would notice</p>
      <p begin="00:55.890" end="00:57.390" ttm:agent="v1">That your eyes</p>
      <p begin="00:57.090" end="00:59.120" ttm:agent="v1">They take my focus</p>
      <p begin="00:59.120" end="01:02.330" ttm:agent="v1">Oh when you're with me</p>
      <p begin="01:02.330" end="01:10.330" ttm:agent="v1">Your loving heart is all I need</p>
      <p begin="01:19.380" end="01:21.350" ttm:agent="v1">I would give up the world</p>
      <p begin="01:21.350" end="01:23.340" ttm:agent="v1">Just to lay in your arms</p>
      <p begin="01:23.340" end="01:25.800" ttm:agent="v1">Right where we are</p>
      <p begin="01:25.800" end="01:27.890" ttm:agent="v1">Let the time slip away</p>
      <p begin="01:27.890" end="01:29.820" ttm:agent="v1">While we talk through the night</p>
      <p begin="01:29.820" end="01:32.180" ttm:agent="v1">It all just feels right</p>
      <p begin="01:32.180" end="01:36.550" ttm:agent="v1">Our hearts could beat in time</p>
      <p begin="01:36.550" end="01:38.320" ttm:agent="v1">If you're mine</p>
      <p begin="01:38.320" end="01:42.910" ttm:agent="v1">But you held a space between lovers and friends</p>
      <p begin="01:42.910" end="01:45.120" ttm:agent="v1">And I hope this ends</p>
      <p begin="01:45.120" end="01:48.290" ttm:agent="v1">One day you'll see</p>
      <p begin="01:48.290" end="01:51.570" ttm:agent="v1">I love you endlessly</p>
      <p begin="01:51.570" end="01:54.850" ttm:agent="v1">Till life's complete</p>
      <p begin="01:54.850" end="01:58.040" ttm:agent="v1">I'll wait here patiently</p>
      <p begin="01:58.040" end="01:59.540" ttm:agent="v1">I wish that</p>
      <p begin="01:59.410" end="02:01.350" ttm:agent="v1">You would notice</p>
      <p begin="02:01.350" end="02:02.850" ttm:agent="v1">That your eyes</p>
      <p begin="02:02.400" end="02:04.680" ttm:agent="v1">They take my focus</p>
      <p begin="02:04.680" end="02:07.860" ttm:agent="v1">Oh when you're with me</p>
      <p begin="02:07.860" end="02:14.490" ttm:agent="v1">Your loving heart is all I need</p>
      <p begin="02:14.490" end="02:20.840" ttm:agent="v1">Your loving heart is all I need</p>
      <p begin="02:20.840" end="02:26.080" ttm:agent="v1">Your loving heart is all I need</p>
      <p begin="02:26.080" end="02:30.080" ttm:agent="v1"/>
    </div>
  </body>
</tt>
