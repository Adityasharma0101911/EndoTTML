<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Talk Shows on Mute</ttm:title><ttm:agent type="person" xml:id="v1">Incubus</ttm:agent><ttm:item type="album">A Crow Left Of The Murder...</ttm:item><ttm:item type="spotify_id">36UaSfZbXdiYra3nBeXMZK</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:20.640" end="00:22.140">Take a bow</p><p ttm:agent="v1" begin="00:21.200" end="00:22.700" /><p ttm:agent="v1" begin="00:22.700" end="00:24.200">Pack on powder</p><p ttm:agent="v1" begin="00:23.450" end="00:24.950" /><p ttm:agent="v1" begin="00:24.700" end="00:27.140">Wash 'em out with buzzing lights</p><p ttm:agent="v1" begin="00:27.140" end="00:28.640" /><p ttm:agent="v1" begin="00:28.640" end="00:31.450">Pay an audience to care</p><p ttm:agent="v1" begin="00:31.450" end="00:32.950" /><p ttm:agent="v1" begin="00:32.770" end="00:34.270">Impress me personality</p><p ttm:agent="v1" begin="00:33.950" end="00:37.520" /><p ttm:agent="v1" begin="00:37.520" end="00:39.020">Still and transfixed</p><p ttm:agent="v1" begin="00:38.200" end="00:39.700" /><p ttm:agent="v1" begin="00:39.330" end="00:41.130">The electric sheep,</p><p ttm:agent="v1" begin="00:41.130" end="00:42.630" /><p ttm:agent="v1" begin="00:42.330" end="00:44.010">Are dreaming of your face</p><p ttm:agent="v1" begin="00:44.010" end="00:45.510" /><p ttm:agent="v1" begin="00:45.260" end="00:47.830">Enjoy you from the chemical</p><p ttm:agent="v1" begin="00:47.830" end="00:49.700" /><p ttm:agent="v1" begin="00:49.700" end="00:51.260">Comfort of America</p><p ttm:agent="v1" begin="00:51.260" end="00:54.330" /><p ttm:agent="v1" begin="00:54.330" end="00:55.830">Come one</p><p ttm:agent="v1" begin="00:54.830" end="00:56.330" /><p ttm:agent="v1" begin="00:56.200" end="00:57.700">Come all</p><p ttm:agent="v1" begin="00:56.830" end="00:58.580" /><p ttm:agent="v1" begin="00:58.580" end="01:00.080">Into 1984</p><p ttm:agent="v1" begin="00:59.200" end="01:02.640" /><p ttm:agent="v1" begin="01:02.640" end="01:05.140">Yeah, three, two, one</p><p ttm:agent="v1" begin="01:05.140" end="01:06.830" /><p ttm:agent="v1" begin="01:06.830" end="01:08.330">Lights, camera, transaction</p><p ttm:agent="v1" begin="01:08.200" end="01:16.200" /><p ttm:agent="v1" begin="01:19.080" end="01:21.830">Quick, your time is almost up</p><p ttm:agent="v1" begin="01:21.830" end="01:23.330" /><p ttm:agent="v1" begin="01:23.270" end="01:26.080">Make all forget that they're the moth</p><p ttm:agent="v1" begin="01:26.080" end="01:27.580" /><p ttm:agent="v1" begin="01:27.580" end="01:30.330">Edging in, towards the flame</p><p ttm:agent="v1" begin="01:30.330" end="01:31.830" /><p ttm:agent="v1" begin="01:31.770" end="01:33.330">Burn into obscurity</p><p ttm:agent="v1" begin="01:33.330" end="01:36.140" /><p ttm:agent="v1" begin="01:36.140" end="01:37.640">Still and transfixed</p><p ttm:agent="v1" begin="01:37.020" end="01:38.520" /><p ttm:agent="v1" begin="01:37.580" end="01:39.140">the electric sheep</p><p ttm:agent="v1" begin="01:39.140" end="01:41.640" /><p ttm:agent="v1" begin="01:41.640" end="01:43.200">are dreaming up your fate</p><p ttm:agent="v1" begin="01:43.200" end="01:44.700" /><p ttm:agent="v1" begin="01:44.200" end="01:45.700">We judge you from</p><p ttm:agent="v1" begin="01:45.390" end="01:46.890" /><p ttm:agent="v1" begin="01:46.260" end="01:47.760">the card castle</p><p ttm:agent="v1" begin="01:47.140" end="01:48.830" /><p ttm:agent="v1" begin="01:48.830" end="01:50.330">comfort of America</p><p ttm:agent="v1" begin="01:50.330" end="01:53.200" /><p ttm:agent="v1" begin="01:53.200" end="01:54.700">Come one</p><p ttm:agent="v1" begin="01:53.640" end="01:55.140" /><p ttm:agent="v1" begin="01:55.020" end="01:56.520">Come all</p><p ttm:agent="v1" begin="01:55.580" end="01:57.390" /><p ttm:agent="v1" begin="01:57.390" end="01:58.890">Into 1984</p><p ttm:agent="v1" begin="01:58.080" end="02:01.580" /><p ttm:agent="v1" begin="02:01.580" end="02:04.270">Yeah, three, two, one</p><p ttm:agent="v1" begin="02:04.270" end="02:05.770" /><p ttm:agent="v1" begin="02:05.700" end="02:07.200">Lights, camera...</p><p ttm:agent="v1" begin="02:07.080" end="02:10.330" /><p ttm:agent="v1" begin="02:10.330" end="02:11.830">Come one</p><p ttm:agent="v1" begin="02:10.890" end="02:12.390" /><p ttm:agent="v1" begin="02:11.770" end="02:13.270">Come all</p><p ttm:agent="v1" begin="02:12.640" end="02:14.200" /><p ttm:agent="v1" begin="02:14.200" end="02:15.700">To 1984</p><p ttm:agent="v1" begin="02:14.760" end="02:18.390" /><p ttm:agent="v1" begin="02:18.390" end="02:21.140">Yeah, three, two, one</p><p ttm:agent="v1" begin="02:21.140" end="02:22.640" /><p ttm:agent="v1" begin="02:22.640" end="02:24.280">Lights, camera, transaction</p><p ttm:agent="v1" begin="02:24.280" end="02:32.280" /><p ttm:agent="v1" begin="03:00.960" end="03:02.460">Come one</p><p ttm:agent="v1" begin="03:01.710" end="03:03.400" /><p ttm:agent="v1" begin="03:03.400" end="03:04.900">Come all</p><p ttm:agent="v1" begin="03:04.340" end="03:05.840" /><p ttm:agent="v1" begin="03:05.030" end="03:06.530">To 1984</p><p ttm:agent="v1" begin="03:05.770" end="03:09.210" /><p ttm:agent="v1" begin="03:09.210" end="03:11.400">Yeah, three, two, one</p><p ttm:agent="v1" begin="03:11.400" end="03:13.090" /><p ttm:agent="v1" begin="03:13.090" end="03:15.340">Lights, camera, transaction</p><p ttm:agent="v1" begin="03:15.340" end="03:23.340" /><p ttm:agent="v1" begin="03:25.340" end="03:27.840">The foundation is canyoning</p><p ttm:agent="v1" begin="03:27.840" end="03:29.710" /><p ttm:agent="v1" begin="03:29.710" end="03:32.270">Fault lines should be worn with pride</p><p ttm:agent="v1" begin="03:32.270" end="03:33.770" /><p ttm:agent="v1" begin="03:33.770" end="03:35.270">I hate to say it</p><p ttm:agent="v1" begin="03:34.960" end="03:36.460" /><p ttm:agent="v1" begin="03:35.780" end="03:37.280">You're so much more</p><p ttm:agent="v1" begin="03:36.780" end="03:38.280" /><p ttm:agent="v1" begin="03:38.150" end="03:39.650">You're so much more</p><p ttm:agent="v1" begin="03:39.020" end="03:41.210" /><p ttm:agent="v1" begin="03:41.210" end="03:45.210">Endearing with the sound turned off.</p></div></body></tt>