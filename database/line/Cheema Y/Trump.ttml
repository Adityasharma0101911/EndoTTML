<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Trump</ttm:title><ttm:agent type="group" xml:id="v1">Cheema Y, Gur Sidhu</ttm:agent><ttm:item type="album">Trump</ttm:item><ttm:item type="spotify_id">2c4s49qRTgEs2bDuEGPlzd</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:09.630" end="00:12.330">Raati chal gaiyan goliyan ni sacramento</p><p ttm:agent="v1" begin="00:12.330" end="00:14.680">Asi jaan lain aaye kehnde chhad do rehen do</p><p ttm:agent="v1" begin="00:14.680" end="00:17.160">Yaari tanviya layi bani sadi bahutiyan layi nahin</p><p ttm:agent="v1" begin="00:17.160" end="00:19.520">Gharon pair putti da aa samjhauteyan layi nahin</p><p ttm:agent="v1" begin="00:19.520" end="00:22.070">Asi chato pair babeyan da nam laida</p><p ttm:agent="v1" begin="00:22.070" end="00:24.720">Mere yaar ne shaitana di jo pooja karde</p><p ttm:agent="v1" begin="00:24.720" end="00:26.960">Jattan de puttan nu rok sake na trump</p><p ttm:agent="v1" begin="00:26.960" end="00:29.800">Billo dukki tikki shikki di taan gall chadd de</p><p ttm:agent="v1" begin="00:29.800" end="00:32.080">Jattan de puttan nu rok sake na trump</p><p ttm:agent="v1" begin="00:32.080" end="00:36.110">Billo dukki tikki shikki di taan gall chadd de</p><p ttm:agent="v1" begin="00:36.110" end="00:38.830">♪</p><p ttm:agent="v1" begin="00:38.830" end="00:41.860">Goli mauke te chalavan exactly</p><p ttm:agent="v1" begin="00:41.860" end="00:44.360">Vair puttan vangu pala perfectly</p><p ttm:agent="v1" begin="00:44.360" end="00:46.810">Thalon kadd dawan banda utton vadd dawan banda</p><p ttm:agent="v1" begin="00:46.810" end="00:49.690">Saari pind jandi nehar sutt avaan lash nu</p><p ttm:agent="v1" begin="00:49.690" end="00:51.730">Soul sool vich na taan gallan chhotiyan</p><p ttm:agent="v1" begin="00:51.730" end="00:54.620">Asi sir dedange ni guru maharaj nu</p><p ttm:agent="v1" begin="00:54.620" end="00:56.970">Waheguru jap jit jaiye manjlan</p><p ttm:agent="v1" begin="00:56.970" end="00:59.520">Billo asi nahiyo dereyan ch chonki bharde</p><p ttm:agent="v1" begin="00:59.520" end="01:01.830">Jattan de puttan nu rok sake na trump</p><p ttm:agent="v1" begin="01:01.830" end="01:04.140">Billo dukki tikki shikki di taan gall chadd de</p><p ttm:agent="v1" begin="01:04.140" end="01:06.540">Jattan de puttan nu rok sake na trump</p><p ttm:agent="v1" begin="01:06.540" end="01:10.070">Billo dukki tikki shikki di taan gall chadd de</p><p ttm:agent="v1" begin="01:10.070" end="01:12.990">♪</p><p ttm:agent="v1" begin="01:12.990" end="01:14.490" itunes:key="role" itunes:value="background">(Gur sidhu music!)</p><p ttm:agent="v1" begin="01:14.090" end="01:16.900">Oh hathi karke crime karan no guilty</p><p ttm:agent="v1" begin="01:16.900" end="01:19.060">24hr vair di availability</p><p ttm:agent="v1" begin="01:19.060" end="01:21.470">Vadu ban de aa khund sidhi karan deal ni</p><p ttm:agent="v1" begin="01:21.470" end="01:24.130">Munda diet vech da aa cheat meal di</p><p ttm:agent="v1" begin="01:24.130" end="01:26.240">Ho jadon vi bane a ni bridge baneya</p><p ttm:agent="v1" begin="01:26.240" end="01:29.040">Kandh banke main kamm koi band ni kitta</p><p ttm:agent="v1" begin="01:29.040" end="01:31.520">Jinna ghar kari di aa saudeyan di gall</p><p ttm:agent="v1" begin="01:31.520" end="01:34.070">Sauda karida zaroor par paani ni pita</p><p ttm:agent="v1" begin="01:34.070" end="01:36.180">Aithe nitt navi billo sarkar badle</p><p ttm:agent="v1" begin="01:36.180" end="01:38.800">Taan hi yaar hathyar rahiye jama karde</p><p ttm:agent="v1" begin="01:38.800" end="01:41.140">Jattan de puttan nu rok sake na trump</p><p ttm:agent="v1" begin="01:41.140" end="01:43.600">Billo dukki tikki shikki di taan gall chadd de</p><p ttm:agent="v1" begin="01:43.600" end="01:46.070">Jattan de puttan nu rok sake na trump</p><p ttm:agent="v1" begin="01:46.070" end="01:50.070">Billo dukki tikki shikki di taan gall chadd de</p><p ttm:agent="v1" begin="01:50.070" end="01:53.760">♪</p><p ttm:agent="v1" begin="01:53.760" end="01:56.270">Oh kudi de didar aa drag warge</p><p ttm:agent="v1" begin="01:56.270" end="01:58.670">Mitran de lashan smug warge</p><p ttm:agent="v1" begin="01:58.670" end="02:00.930">Tera lagge jadon ferra ohi mitra da dera</p><p ttm:agent="v1" begin="02:00.930" end="02:03.500">Bade aukhe mere mel aa swabb warge</p><p ttm:agent="v1" begin="02:03.500" end="02:05.830">Sidha vajaya daran ch aake subedar tu</p><p ttm:agent="v1" begin="02:05.830" end="02:08.200">Kenda kiven aaya jatta bina saat band ton</p><p ttm:agent="v1" begin="02:08.200" end="02:10.820">Main keha asi nahi embassyan ch visa mangeya</p><p ttm:agent="v1" begin="02:10.820" end="02:13.430">Jithon lang aaye aa sukha nahiyo janda langheya</p><p ttm:agent="v1" begin="02:13.430" end="02:15.740">Leke aaya nahiyo nave nave kapde bagan ch</p><p ttm:agent="v1" begin="02:15.740" end="02:18.440">Sher udde aunde 35 futti kandh tup ke</p><p ttm:agent="v1" begin="02:18.440" end="02:20.710">Jattan de puttan nu rok sake na trump</p><p ttm:agent="v1" begin="02:20.710" end="02:23.060">Billo dukki tikki shikki di taan gall chadd de</p><p ttm:agent="v1" begin="02:23.060" end="02:25.690">Jattan de puttan nu rok sake na trump</p><p ttm:agent="v1" begin="02:25.690" end="02:28.140">Billo dukki tikki shikki di taan gall chadd de</p><p ttm:agent="v1" begin="02:28.140" end="02:32.140" /></div></body></tt>