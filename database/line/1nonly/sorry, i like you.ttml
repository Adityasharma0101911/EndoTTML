<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>sorry, i like you</ttm:title>
      <ttm:agent type="person" xml:id="v1">1nonly</ttm:agent>
      <ttm:item type="album">sorry, i like you</ttm:item>
      <ttm:item type="spotify_id">4Us7Hw8jDC4t1KLfenilv8</ttm:item>
      <itunes:duration>01:38.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:11.560" end="00:13.060" ttm:agent="v1">I'm sorry that I like you</p>
      <p begin="00:12.960" end="00:14.460" ttm:agent="v1">And if it's not too much to ask</p>
      <p begin="00:14.350" end="00:15.850" ttm:agent="v1">Can we talk about our feelings and</p>
      <p begin="00:15.810" end="00:17.310" ttm:agent="v1">Reminisce the past or</p>
      <p begin="00:17.170" end="00:18.670" ttm:agent="v1">We can watch a movie and</p>
      <p begin="00:18.520" end="00:20.190" ttm:agent="v1">We can have a laugh or</p>
      <p begin="00:20.190" end="00:22.730" ttm:agent="v1">We can go on walks and race to see who's last like</p>
      <p begin="00:22.730" end="00:24.230" ttm:agent="v1">Sorry that I stare</p>
      <p begin="00:24.120" end="00:25.620" ttm:agent="v1">I dream about your face and</p>
      <p begin="00:25.470" end="00:27.090" ttm:agent="v1">I know I'm not that cute but</p>
      <p begin="00:27.090" end="00:28.590" ttm:agent="v1">We should plan a date</p>
      <p begin="00:28.400" end="00:29.900" ttm:agent="v1">And there's something about you that</p>
      <p begin="00:29.710" end="00:31.210" ttm:agent="v1">Makes me feel so safe</p>
      <p begin="00:31.020" end="00:32.620" ttm:agent="v1">And I know this might seem weird but</p>
      <p begin="00:32.620" end="00:34.120" ttm:agent="v1">I'm always pretty late like</p>
      <p begin="00:34.000" end="00:36.790" ttm:agent="v1">Baking, singing, and everything you love</p>
      <p begin="00:36.790" end="00:38.660" ttm:agent="v1">And like Sherlock Holmes and every tune</p>
      <p begin="00:38.660" end="00:40.760" ttm:agent="v1">That you've sung and like car rides, giggles</p>
      <p begin="00:40.760" end="00:42.340" ttm:agent="v1">And staying up late and like</p>
      <p begin="00:42.340" end="00:45.010" ttm:agent="v1">Seeing you in class and perfections on your face</p>
      <p begin="00:45.010" end="00:47.670" ttm:agent="v1">Like stories, sunsets, and beautiful smiles</p>
      <p begin="00:47.670" end="00:49.510" ttm:agent="v1">And like counting all your freckles</p>
      <p begin="00:49.510" end="00:51.010" ttm:agent="v1">And wanting a child and like</p>
      <p begin="00:50.620" end="00:53.240" ttm:agent="v1">Kissing and teasing and loving one another</p>
      <p begin="00:53.240" end="00:56.270" ttm:agent="v1" itunes:key="role" itunes:value="background">And all of the times that we cared for each other (yuh)</p>
      <p begin="00:56.270" end="01:00.270" ttm:agent="v1"/>
    </div>
