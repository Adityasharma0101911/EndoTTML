<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Love at First Sight</ttm:title>
      <ttm:agent type="person" xml:id="v1">1nonly</ttm:agent>
      <ttm:agent type="person" xml:id="v2">MKAY</ttm:agent>
      <ttm:item type="album">Homesick</ttm:item>
      <ttm:item type="spotify_id">6J6mZ4S2cYK1WsGdjJ3786</ttm:item>
      <itunes:duration>02:20.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:10.190" end="00:15.110" ttm:agent="v1">'Cause I don't hate you</p>
      <p begin="00:15.110" end="00:17.060" ttm:agent="v1">I just hate myself</p>
      <p begin="00:17.060" end="00:18.960" ttm:agent="v1">I swear it was love at first sight</p>
      <p begin="00:18.960" end="00:20.960" ttm:agent="v1">W-when you tell me you love me</p>
      <p begin="00:20.960" end="00:22.620" ttm:agent="v1">And I know I got problems, you hate when I speak</p>
      <p begin="00:22.620" end="00:24.120" ttm:agent="v1">But I hope that you never gon' dump me</p>
      <p begin="00:24.050" end="00:26.230" ttm:agent="v1">'Cause I been off it when I walk in</p>
      <p begin="00:26.230" end="00:27.920" ttm:agent="v1">When I see you with him when I walked in</p>
      <p begin="00:27.920" end="00:29.840" ttm:agent="v1">'Cause, girl, you knew all the pain that you caused</p>
      <p begin="00:29.840" end="00:31.340" ttm:agent="v1">And you said it was me when you lost it</p>
      <p begin="00:31.200" end="00:33.210" ttm:agent="v1">But now, it's too late, you never call me when you say</p>
      <p begin="00:33.210" end="00:34.720" ttm:agent="v1">You never been there when I'm waitin'</p>
      <p begin="00:34.720" end="00:36.820" ttm:agent="v1">Never been stabbed in the back, in the back with a mag</p>
      <p begin="00:36.820" end="00:38.540" ttm:agent="v1">'Cause now I'm makin' money, with the cash in the stack</p>
      <p begin="00:38.540" end="00:41.990" ttm:agent="v1">Don't call me when you off it 'cause it ain't stoppin' our problems</p>
      <p begin="00:41.990" end="00:43.880" ttm:agent="v1">Can you tell me when you're honest?</p>
      <p begin="00:43.880" end="00:45.670" ttm:agent="v1">Do-don't lie to my face when you're talkin'</p>
      <p begin="00:45.670" end="00:50.950" ttm:agent="v1">'Cause I don't hate you</p>
      <p begin="00:50.950" end="00:52.900" ttm:agent="v1">I just hate myself</p>
      <p begin="00:52.900" end="00:57.330" ttm:agent="v1">'Cause I don't hate you</p>
      <p begin="00:57.330" end="01:00.240" ttm:agent="v1">I just hate myself</p>
      <p begin="01:00.240" end="01:01.740" ttm:agent="v1">Don't feel like myself no more</p>
      <p begin="01:01.560" end="01:03.990" ttm:agent="v1">Blurry spaced out, can you give me a moment</p>
      <p begin="01:03.990" end="01:07.480" ttm:agent="v1">I need to find myself to feel like I'm lost in a world with no one</p>
      <p begin="01:07.480" end="01:08.980" ttm:agent="v1">I wanna be on my own</p>
      <p begin="01:08.600" end="01:10.990" ttm:agent="v1">Plugged in headphones zone out, click airplane mode</p>
      <p begin="01:10.990" end="01:12.570" ttm:agent="v1">I wanna feel love just one more time</p>
      <p begin="01:12.570" end="01:14.450" ttm:agent="v1">But I don't like the trusting process</p>
      <p begin="01:14.450" end="01:16.190" ttm:agent="v1">She broke my heart, left me in the past</p>
      <p begin="01:16.190" end="01:18.090" ttm:agent="v1">And maybe that's why I'm in love with smoking</p>
      <p begin="01:18.090" end="01:19.590" ttm:agent="v1">Cigarette smoke, I'm coping</p>
      <p begin="01:19.330" end="01:21.500" ttm:agent="v1">Champagne bottles help most of my problems</p>
      <p begin="01:21.500" end="01:23.760" ttm:agent="v1">So how can I shoot my shot like Derozan</p>
      <p begin="01:23.760" end="01:25.260" ttm:agent="v1">When all these girls are frozen?</p>
      <p begin="01:25.090" end="01:26.590" ttm:agent="v1">I swear that I can't trust no one</p>
      <p begin="01:26.470" end="01:28.590" ttm:agent="v1">No turn the back when I need them most</p>
      <p begin="01:28.590" end="01:30.090" ttm:agent="v1">I swear it was love at first sight</p>
      <p begin="01:29.540" end="01:31.500" ttm:agent="v1">W-when you tell me you love me</p>
      <p begin="01:31.500" end="01:33.210" ttm:agent="v1">And I know I got problems, you hate when I speak</p>
      <p begin="01:33.210" end="01:34.710" ttm:agent="v1">But I hope that you never gon' dump me</p>
      <p begin="01:34.690" end="01:36.810" ttm:agent="v1">'Cause I been off it when I walk in</p>
      <p begin="01:36.810" end="01:38.520" ttm:agent="v1">When I see you with him when I walked in</p>
      <p begin="01:38.520" end="01:40.400" ttm:agent="v1">'Cause, girl, you knew all the pain that you caused</p>
      <p begin="01:40.400" end="01:42.330" ttm:agent="v1">And you said it was me when you lost it</p>
      <p begin="01:42.330" end="01:44.350" ttm:agent="v1">Lost it, when you lost, when you lost, when you lost, when you lost</p>
      <p begin="01:44.350" end="01:46.620" ttm:agent="v1">I don't hate you</p>
      <p begin="01:46.620" end="01:50.800" ttm:agent="v1"/>
      <p begin="01:50.800" end="01:52.520" ttm:agent="v1">I just hate myself</p>
      <p begin="01:52.520" end="01:57.920" ttm:agent="v1">'Cause I don't hate you</p>
      <p begin="01:57.920" end="01:59.750" ttm:agent="v1">I just hate myself</p>
      <p begin="01:59.750" end="02:05.020" ttm:agent="v1">'Cause I don't hate you</p>
      <p begin="02:05.020" end="02:06.960" ttm:agent="v1">I just hate myself</p>
      <p begin="02:06.960" end="02:12.300" ttm:agent="v1">'Cause I don't hate you</p>
      <p begin="02:12.300" end="02:20.300" ttm:agent="v1">I just hate myself</p>
      <p begin="02:20.400" end="02:24.400" ttm:agent="v1"/>
    </div>
  </body>
