<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>VICODIN</ttm:title>
      <ttm:agent type="person" xml:id="v1">1nonly</ttm:agent>
      <ttm:item type="album">VICODIN</ttm:item>
      <ttm:item type="spotify_id">1k6NRe4Vh0vjcEJiVARB4Q</ttm:item>
      <itunes:duration>02:19.764</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:11.470" end="00:15.790" ttm:agent="v1">Uh, uh, uh, uh, uh, uh</p>
      <p begin="00:15.790" end="00:17.290" ttm:agent="v1">Yeah, okay</p>
      <p begin="00:17.120" end="00:19.780" ttm:agent="v1">Uh, uh, uh, uh</p>
      <p begin="00:19.780" end="00:22.100" ttm:agent="v1">Yeah, yeah, yeah</p>
      <p begin="00:22.100" end="00:24.950" ttm:agent="v1">Faded— Faded as a bitch, I think I might just take a trip</p>
      <p begin="00:24.950" end="00:28.040" ttm:agent="v1">Take a flight up to Japan, before I land I take a sip</p>
      <p begin="00:28.040" end="00:30.960" ttm:agent="v1">Perky in my fuckin' system, what the fuck a Vicodin?</p>
      <p begin="00:30.960" end="00:33.680" ttm:agent="v1">This that money talk, that paper walk, that camera flashin' shit</p>
      <p begin="00:33.680" end="00:36.680" ttm:agent="v1">I'm on the run, yeah, I'm on the run, boy, I'm one and done</p>
      <p begin="00:36.680" end="00:39.350" ttm:agent="v1">I got guns, kickin' like a drum, do this shit for fun</p>
      <p begin="00:39.350" end="00:42.070" ttm:agent="v1">Up and stuck, he need medicine, light this fuckin' blunt</p>
      <p begin="00:42.070" end="00:44.970" ttm:agent="v1">N' keep it shut, pressure to the lungs, I can't get enough</p>
      <p begin="00:44.970" end="00:46.470" ttm:agent="v1">Boy, I'll blow your ass away</p>
      <p begin="00:46.380" end="00:47.880" ttm:agent="v1">Keep the police out the case</p>
      <p begin="00:47.730" end="00:50.640" ttm:agent="v1">Sippin 40's, O.G told me smoke an O.Z to the face</p>
      <p begin="00:50.640" end="00:53.490" ttm:agent="v1">In the sun, I see the rain, in the front, I see thеm rings</p>
      <p begin="00:53.490" end="00:57.370" ttm:agent="v1">And the choppa do em' dirty, need to wash them fuckin' stains</p>
      <p begin="00:57.370" end="01:02.230" ttm:agent="v1">&quot;No onе, you're all alone, huh? Like me, blondie&quot;</p>
      <p begin="01:02.230" end="01:03.730" ttm:agent="v1">Proud of all my decisions, uh</p>
      <p begin="01:03.670" end="01:05.170" ttm:agent="v1">Word to the mind, I'm in it, uh</p>
      <p begin="01:04.830" end="01:06.370" ttm:agent="v1">Get buck and the fye, Put him in the sky</p>
      <p begin="01:06.370" end="01:07.870" ttm:agent="v1">Just like I'm a flight attendant</p>
      <p begin="01:07.500" end="01:10.270" ttm:agent="v1">Everything I want, I got it, had to step into the finer things</p>
      <p begin="01:10.270" end="01:11.770" ttm:agent="v1">Had to get from the rougher times</p>
      <p begin="01:11.730" end="01:13.230" ttm:agent="v1">To breakin' the bread with all my kin</p>
      <p begin="01:13.170" end="01:14.670" ttm:agent="v1">B-B-Bitch I'm steppin' with this ruger</p>
      <p begin="01:14.570" end="01:16.110" ttm:agent="v1">Take a step and I might shoot ya</p>
      <p begin="01:16.110" end="01:17.610" ttm:agent="v1">Windows tinted, can't see in it</p>
      <p begin="01:17.490" end="01:18.990" ttm:agent="v1">Swimmin' up in a pile of jewels</p>
      <p begin="01:18.830" end="01:20.330" ttm:agent="v1">Independent how I live</p>
      <p begin="01:20.120" end="01:21.670" ttm:agent="v1">That's the life I went to choose</p>
      <p begin="01:21.670" end="01:23.170" ttm:agent="v1">I'm a star like golden goose</p>
      <p begin="01:22.820" end="01:26.330" ttm:agent="v1">Yo' music ass won't look into it</p>
      <p begin="01:26.330" end="01:28.440" ttm:agent="v1" itunes:key="role" itunes:value="background">(Won't look into it)</p>
      <p begin="01:28.440" end="01:31.730" ttm:agent="v1" itunes:key="role" itunes:value="background">(Loo-loo-loo-look into it)</p>
      <p begin="01:31.730" end="01:34.100" ttm:agent="v1" itunes:key="role" itunes:value="background">(Won't look into it)</p>
      <p begin="01:34.100" end="01:35.600" ttm:agent="v1" itunes:key="role" itunes:value="background">(Loo-loo-loo-look into it)</p>
      <p begin="01:35.500" end="01:38.490" ttm:agent="v1">Faded— Faded as a bitch, I think I might just take a trip</p>
      <p begin="01:38.490" end="01:41.370" ttm:agent="v1">Take a flight up to Japan, before I land I take a sip</p>
      <p begin="01:41.370" end="01:44.260" ttm:agent="v1">Perky in my fuckin' system, what the fuck a Vicodin?</p>
      <p begin="01:44.260" end="01:46.930" ttm:agent="v1">This that money talk, that paper walk, that camera flashin' shit</p>
      <p begin="01:46.930" end="01:49.940" ttm:agent="v1">I'm on the run, yeah, I'm on the run, boy, I'm one and done</p>
      <p begin="01:49.940" end="01:52.650" ttm:agent="v1">I got guns, kickin' like a drum, do this shit for fun</p>
      <p begin="01:52.650" end="01:55.320" ttm:agent="v1">Up and stuck, he need medicine, light this fuckin' blunt</p>
      <p begin="01:55.320" end="01:58.770" ttm:agent="v1">N' keep it shut, pressure to the lungs, I can't get enough</p>
      <p begin="01:58.770" end="02:02.770" ttm:agent="v1"/>
    </div>
