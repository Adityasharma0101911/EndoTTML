<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Dance With Me</ttm:title><ttm:agent type="person" xml:id="v1">1nonly</ttm:agent><ttm:item type="album">Dance With Me</ttm:item><ttm:item type="spotify_id">6P0x9LWvtjRgAaJUYpN75m</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.888" end="00:06.348">Dance with me, and I'll sing to you</p><p ttm:agent="v1" begin="00:06.348" end="00:10.618">A symphony, won't you kiss me?</p><p ttm:agent="v1" begin="00:10.618" end="00:14.172">Shut me up, please</p><p ttm:agent="v1" begin="00:14.172" end="00:18.390">She's a goddess, a wish from stars</p><p ttm:agent="v1" begin="00:18.390" end="00:22.701">In my heart, oh, oh</p><p ttm:agent="v1" begin="00:22.701" end="00:25.228">Oh, yeah</p><p ttm:agent="v1" begin="00:25.228" end="00:31.215">Ayy, dance with me, and I'll sing to you</p><p ttm:agent="v1" begin="00:31.215" end="00:35.595">A symphony, won't you kiss me? (Yeah)</p><p ttm:agent="v1" begin="00:35.595" end="00:37.666">Shut me up, please</p><p ttm:agent="v1" begin="00:37.666" end="00:43.433">Dance with me, and I'll sing to you</p><p ttm:agent="v1" begin="00:43.433" end="00:47.933">In my heart, oh, oh</p><p ttm:agent="v1" begin="00:47.933" end="00:49.433">Oh, yeah</p><p ttm:agent="v1" begin="00:49.292" end="00:50.792">Yeah, ayy</p><p ttm:agent="v1" begin="00:50.181" end="00:52.489">Everything was bad, everything was wrong</p><p ttm:agent="v1" begin="00:52.489" end="00:54.386">She just wanna see me roll on the floor</p><p ttm:agent="v1" begin="00:54.386" end="00:56.664">She just wanna see me [?] in the fall</p><p ttm:agent="v1" begin="00:56.664" end="00:58.473">She just wanna see me lose it all</p><p ttm:agent="v1" begin="00:58.473" end="01:00.442">Like, my heart's been hurt, and you still d-do this</p><p ttm:agent="v1" begin="01:00.442" end="01:02.764">Like, like I'm so clueless</p><p ttm:agent="v1" begin="01:02.764" end="01:04.672">Everything was bad, everything was wrong</p><p ttm:agent="v1" begin="01:04.672" end="01:06.893">She just wanna see me roll on the floor</p><p ttm:agent="v1" begin="01:06.893" end="01:09.065">She just wanna see me [?] in the fall</p><p ttm:agent="v1" begin="01:09.065" end="01:10.963">She just wanna see me lose it all</p><p ttm:agent="v1" begin="01:10.963" end="01:13.828">Like, my heart's been hurt, and you still d-do this</p><p ttm:agent="v1" begin="01:13.828" end="01:15.328">Like, like I'm so clueless</p><p ttm:agent="v1" begin="01:15.213" end="01:17.210">Everything was bad, everything was wrong</p><p ttm:agent="v1" begin="01:17.210" end="01:19.307">She just wanna see me roll on the floor</p><p ttm:agent="v1" begin="01:19.307" end="01:21.376">She just wanna see me [?] in the fall</p><p ttm:agent="v1" begin="01:21.376" end="01:23.363">She just wanna see me lose it all</p><p ttm:agent="v1" begin="01:23.363" end="01:26.394">Like, my heart's been hurt, and you still d-do this</p><p ttm:agent="v1" begin="01:26.394" end="01:27.894">Like, like I'm so clueless</p><p ttm:agent="v1" begin="01:27.797" end="01:33.708">Dance with me, and I'll sing to you</p><p ttm:agent="v1" begin="01:33.708" end="01:37.974">A symphony, won't you kiss me? (Yeah)</p><p ttm:agent="v1" begin="01:37.974" end="01:40.277">Shut me up, please</p><p ttm:agent="v1" begin="01:40.277" end="01:46.237">Dance with me, and I'll sing to you</p><p ttm:agent="v1" begin="01:46.237" end="01:50.237">In my heart, oh, oh</p></div></body></tt>