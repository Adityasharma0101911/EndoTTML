<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>WHAT YOU WANT</ttm:title>
      <ttm:agent type="person" xml:id="v1">1nonly</ttm:agent>
      <ttm:item type="album">WHAT YOU WANT</ttm:item>
      <ttm:item type="spotify_id">1uPdPYQV4S2kl1IXjosbe8</ttm:item>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:06.880" end="00:13.235" ttm:agent="v1" itunes:key="role" itunes:value="background">(I hate you, bigchase)</p>
      <p begin="00:13.235" end="00:14.735" ttm:agent="v1">Like what you want?</p>
      <p begin="00:14.637" end="00:16.137" ttm:agent="v1">I got what you need</p>
      <p begin="00:16.044" end="00:17.929" ttm:agent="v1">I felt it in my veins</p>
      <p begin="00:17.929" end="00:19.429" ttm:agent="v1">Sun came up and I can't sleep</p>
      <p begin="00:19.329" end="00:22.757" ttm:agent="v1">Bitch, I back to back the blunt, I can’t ever leave</p>
      <p begin="00:22.757" end="00:26.077" ttm:agent="v1">If I wasn't up on that stage, I'd take my life and count up sheep</p>
      <p begin="00:26.077" end="00:29.668" ttm:agent="v1">What you— What- What you want? I got what you need</p>
      <p begin="00:29.668" end="00:31.282" ttm:agent="v1">I felt it in my veins</p>
      <p begin="00:31.282" end="00:32.880" ttm:agent="v1">Sun came up and I can’t sleep</p>
      <p begin="00:32.880" end="00:36.370" ttm:agent="v1">Bitch, I back to back the blunt, I can't ever leave</p>
      <p begin="00:36.370" end="00:39.636" ttm:agent="v1">If I wasn't up on that stage, I'd take my life and count up sheep</p>
      <p begin="00:39.636" end="00:41.521" ttm:agent="v1">What you— What- What you want</p>
      <p begin="00:41.521" end="00:43.021" ttm:agent="v1">I know it's not the same</p>
      <p begin="00:42.914" end="00:44.463" ttm:agent="v1">Said &quot;Girl, its been too long&quot;</p>
      <p begin="00:44.463" end="00:46.272" ttm:agent="v1">The drugs it take too long</p>
      <p begin="00:46.272" end="00:47.941" ttm:agent="v1">To hit, I know its wrong</p>
      <p begin="00:47.941" end="00:49.734" ttm:agent="v1">I smoke to heal the pain</p>
      <p begin="00:49.734" end="00:51.420" ttm:agent="v1">I try to ease the fog</p>
      <p begin="00:51.420" end="00:53.034" ttm:agent="v1">In the abyss I mourn</p>
      <p begin="00:53.034" end="00:54.864" ttm:agent="v1">I wish you didn't call</p>
      <p begin="00:54.864" end="01:01.135" ttm:agent="v1">Aye, numb, drugs, take some, filling up my nose with that dangerous</p>
      <p begin="01:01.135" end="01:04.797" ttm:agent="v1">Leave me cold, stuck n' sending shots n' slugs</p>
      <p begin="01:04.797" end="01:08.795" ttm:agent="v1">If I died today then bury me with my chains on like let it go</p>
      <p begin="01:08.795" end="01:11.875" ttm:agent="v1">Hard to change when broken down but I done changed the bank</p>
      <p begin="01:11.875" end="01:15.619" ttm:agent="v1">I turned that penny to a mil within a night n’ day</p>
      <p begin="01:15.619" end="01:18.382" ttm:agent="v1">I cut off bitches that ain’t wit me with a knife n' blade</p>
      <p begin="01:18.382" end="01:21.681" ttm:agent="v1">Easy to say, the only ones close to me ain’t never asked me for change</p>
      <p begin="01:21.681" end="01:23.181" ttm:agent="v1">Like what you want?</p>
      <p begin="01:23.078" end="01:24.578" ttm:agent="v1">I got what you need</p>
      <p begin="01:24.287" end="01:25.850" ttm:agent="v1">I felt it in my veins</p>
      <p begin="01:25.850" end="01:27.485" ttm:agent="v1">Sun came up and I can't sleep</p>
      <p begin="01:27.485" end="01:30.915" ttm:agent="v1">Bitch, I back to back the blunt, I can’t ever leave</p>
      <p begin="01:30.915" end="01:34.087" ttm:agent="v1">If I wasn't up on that stage, I'd take my life and count up sheep</p>
      <p begin="01:34.087" end="01:37.714" ttm:agent="v1">What you— What- What you want? I got what you need</p>
      <p begin="01:37.714" end="01:39.491" ttm:agent="v1">I felt it in my veins</p>
      <p begin="01:39.491" end="01:41.103" ttm:agent="v1">Sun came up and I can’t sleep</p>
      <p begin="01:41.103" end="01:44.526" ttm:agent="v1">Bitch, I back to back the blunt, I can't ever leave</p>
      <p begin="01:44.526" end="01:47.741" ttm:agent="v1">If I wasn't up on that stage, I'd take my life and count up sheep</p>
      <p begin="01:47.741" end="01:51.741" ttm:agent="v1">What you— What- What you want</p>
    </div>
  </body>
