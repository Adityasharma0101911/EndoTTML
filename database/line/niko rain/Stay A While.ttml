<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Stay A While</ttm:title>
      <ttm:agent type="person" xml:id="v1">niko rain</ttm:agent>
      <ttm:agent type="person" xml:id="v2">EJEAN</ttm:agent>
      <ttm:item type="album">Stay A While</ttm:item>
      <ttm:item type="spotify_id">36JmHWMB21YyrUMzTAF0xv</ttm:item>
      <itunes:duration>02:49.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:12.790" end="00:15.890" ttm:agent="v1" itunes:key="role" itunes:value="background">(Niko rain, this a hit, yeah)</p>
      <p begin="00:15.890" end="00:19.690" ttm:agent="v1">I saw you on the way to my favorite place</p>
      <p begin="00:19.690" end="00:22.320" ttm:agent="v1">Just something about the way</p>
      <p begin="00:22.320" end="00:24.230" ttm:agent="v1">You walked into the shop</p>
      <p begin="00:24.230" end="00:25.980" ttm:agent="v1">How you said your name</p>
      <p begin="00:25.980" end="00:27.480" ttm:agent="v1">Could this be</p>
      <p begin="00:27.250" end="00:29.740" ttm:agent="v1">Could you be someone</p>
      <p begin="00:29.740" end="00:33.700" ttm:agent="v1">I'm not usually the type to be having these thoughts</p>
      <p begin="00:33.700" end="00:37.300" ttm:agent="v1">How could you give me the butterflies</p>
      <p begin="00:37.300" end="00:41.620" ttm:agent="v1">When I met your eyes you flashed a smile</p>
      <p begin="00:41.620" end="00:45.180" ttm:agent="v1">I'm hoping that you'll stay a while</p>
      <p begin="00:45.180" end="00:48.450" ttm:agent="v1">Oh, tell me what you came for</p>
      <p begin="00:48.450" end="00:52.520" ttm:agent="v1">Honestly I don't know if you'll stay or not</p>
      <p begin="00:52.520" end="00:56.810" ttm:agent="v1">But for now I'm betting on us cause I</p>
      <p begin="00:56.810" end="00:59.820" ttm:agent="v1">I'm hoping that you'll stay a while</p>
      <p begin="00:59.820" end="01:02.590" ttm:agent="v1">Tell me won't you stay a while</p>
      <p begin="01:02.590" end="01:04.270" ttm:agent="v1">Stay for a while</p>
      <p begin="01:04.270" end="01:06.350" ttm:agent="v1">Can you stay a while</p>
      <p begin="01:06.350" end="01:07.950" ttm:agent="v1">Oh, you got mе hoping</p>
      <p begin="01:07.950" end="01:10.020" ttm:agent="v1">That you'll stay a while</p>
      <p begin="01:10.020" end="01:11.650" ttm:agent="v1">Stay for a while</p>
      <p begin="01:11.650" end="01:13.500" ttm:agent="v1">Can you stay</p>
      <p begin="01:13.500" end="01:15.880" ttm:agent="v1">Oh oh</p>
      <p begin="01:15.880" end="01:17.380" ttm:agent="v1">I had some plans</p>
      <p begin="01:17.360" end="01:19.480" ttm:agent="v1">But I'm having sеcond thoughts</p>
      <p begin="01:19.480" end="01:23.340" ttm:agent="v1">You kept taking glances across the coffee shop</p>
      <p begin="01:23.340" end="01:27.180" ttm:agent="v1">Maybe we could sit and just do nothing</p>
      <p begin="01:27.180" end="01:29.020" ttm:agent="v1">But it's not like I mind</p>
      <p begin="01:29.020" end="01:32.050" ttm:agent="v1">That's my favorite time</p>
      <p begin="01:32.050" end="01:36.160" ttm:agent="v1">You said you liked my smile but I don't get it</p>
      <p begin="01:36.160" end="01:39.410" ttm:agent="v1">Still not really sure if you meant it</p>
      <p begin="01:39.410" end="01:42.250" ttm:agent="v1">But my face still turning redder than your sweatshirt</p>
      <p begin="01:42.250" end="01:46.050" ttm:agent="v1">You know that Imma stay a while</p>
      <p begin="01:46.050" end="01:49.330" ttm:agent="v1">So tell me what you came for</p>
      <p begin="01:49.330" end="01:53.580" ttm:agent="v1">Honestly I don't know if you'll stay or not</p>
      <p begin="01:53.580" end="01:57.740" ttm:agent="v1">But for now I'm betting on us cause I</p>
      <p begin="01:57.740" end="02:00.690" ttm:agent="v1">I'm hoping that you'll stay a while</p>
      <p begin="02:00.690" end="02:03.420" ttm:agent="v1">So tell me won't you stay a while</p>
      <p begin="02:03.420" end="02:05.240" ttm:agent="v1">Stay for a while</p>
      <p begin="02:05.240" end="02:07.380" ttm:agent="v1">Can you stay a while</p>
      <p begin="02:07.380" end="02:08.950" ttm:agent="v1">Oh, you got me hoping</p>
      <p begin="02:08.950" end="02:11.030" ttm:agent="v1">That you'll stay a while</p>
      <p begin="02:11.030" end="02:12.530" ttm:agent="v1">Stay for a while</p>
      <p begin="02:12.530" end="02:14.680" ttm:agent="v1">Can you stay</p>
      <p begin="02:14.680" end="02:16.180" ttm:agent="v1">Oh</p>
      <p begin="02:16.150" end="02:18.750" ttm:agent="v1">Tell me won't you stay a while</p>
      <p begin="02:18.750" end="02:20.470" ttm:agent="v1">Stay for a while</p>
      <p begin="02:20.470" end="02:22.520" ttm:agent="v1">Can you stay a while</p>
      <p begin="02:22.520" end="02:24.310" ttm:agent="v1">Oh, you got me hoping</p>
      <p begin="02:24.310" end="02:26.210" ttm:agent="v1">That you'll stay a while</p>
      <p begin="02:26.210" end="02:27.740" ttm:agent="v1">Stay for a while</p>
      <p begin="02:27.740" end="02:29.970" ttm:agent="v1">Can you stay</p>
      <p begin="02:29.970" end="02:34.430" ttm:agent="v1">Oh</p>
      <p begin="02:34.430" end="02:37.720" ttm:agent="v1" itunes:key="role" itunes:value="background">(You have to go?)</p>
      <p begin="02:37.720" end="02:44.030" ttm:agent="v1" itunes:key="role" itunes:value="background">(I don't want to)</p>
      <p begin="02:44.030" end="02:46.110" ttm:agent="v1" itunes:key="role" itunes:value="background">(Are you ready?)</p>
      <p begin="02:46.110" end="02:47.610" ttm:agent="v1" itunes:key="role" itunes:value="background">(Yeah)</p>
      <p begin="02:47.270" end="02:51.270" ttm:agent="v1"/>
    </div>
  </body>
</tt>
