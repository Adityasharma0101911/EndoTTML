<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>satellite</ttm:title>
      <ttm:agent type="person" xml:id="v1">grentperez</ttm:agent>
      <ttm:item type="album">satellite</ttm:item>
      <ttm:item type="spotify_id">3aGgVGFttTUFYEYwAXZae3</ttm:item>
      <itunes:duration>03:14.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:01.050" end="00:04.850" ttm:agent="v1">Living on a fading light</p>
      <p begin="00:04.850" end="00:07.320" ttm:agent="v1">Gone, but never losing sight</p>
      <p begin="00:07.320" end="00:11.540" ttm:agent="v1">I've got my head up in the clouds</p>
      <p begin="00:11.540" end="00:17.370" ttm:agent="v1">Right where the silence makes a sound</p>
      <p begin="00:17.370" end="00:21.050" ttm:agent="v1">When heaven feels too far away</p>
      <p begin="00:21.050" end="00:23.960" ttm:agent="v1">You make me feel like that's okay</p>
      <p begin="00:23.960" end="00:27.800" ttm:agent="v1">You bring that heaven to my home</p>
      <p begin="00:27.800" end="00:32.170" ttm:agent="v1">The only place I wanna go</p>
      <p begin="00:32.170" end="00:37.300" ttm:agent="v1">Baby, I got what I need</p>
      <p begin="00:37.300" end="00:41.390" ttm:agent="v1">This feeling never sleeps</p>
      <p begin="00:41.390" end="00:45.570" ttm:agent="v1">No more chasing time</p>
      <p begin="00:45.570" end="00:49.680" ttm:agent="v1">When it was always mine</p>
      <p begin="00:49.680" end="00:57.680" ttm:agent="v1">We're in paradise, I'm lost with you</p>
      <p begin="00:57.680" end="01:05.680" ttm:agent="v1">Like two satellites, take in the view, mm-mm</p>
      <p begin="01:06.020" end="01:14.020" ttm:agent="v1">We're in paradise, I'm lost with you</p>
      <p begin="01:14.030" end="01:19.170" ttm:agent="v1">Like two satеllites, take in the viеw</p>
      <p begin="01:19.170" end="01:27.170" ttm:agent="v1">Na-na-na-na, na-na-na</p>
      <p begin="01:30.360" end="01:34.340" ttm:agent="v1">Coffee stains and cloudy days</p>
      <p begin="01:34.340" end="01:36.870" ttm:agent="v1">Folded paper aeroplanes</p>
      <p begin="01:36.870" end="01:40.920" ttm:agent="v1">Bend up, they fly off from the path</p>
      <p begin="01:40.920" end="01:46.560" ttm:agent="v1">Something tells me I should turn back</p>
      <p begin="01:46.560" end="01:48.580" ttm:agent="v1">'Cause signs can be all types of things</p>
      <p begin="01:48.580" end="01:50.570" ttm:agent="v1" itunes:key="role" itunes:value="background">(Signs can be all types of things)</p>
      <p begin="01:50.570" end="01:53.150" ttm:agent="v1">So I pray for better days, I'd sing</p>
      <p begin="01:53.150" end="01:57.340" ttm:agent="v1">Those days came in the form of you</p>
      <p begin="01:57.340" end="02:02.750" ttm:agent="v1">Deserve it, Lord, what did I do?</p>
      <p begin="02:02.750" end="02:05.800" ttm:agent="v1">And though we're getting older</p>
      <p begin="02:05.800" end="02:11.080" ttm:agent="v1">Know that my love won't weather away</p>
      <p begin="02:11.080" end="02:13.250" ttm:agent="v1">Baby, I got what I need</p>
      <p begin="02:13.250" end="02:15.100" ttm:agent="v1" itunes:key="role" itunes:value="background">(Baby, I really got what I need)</p>
      <p begin="02:15.100" end="02:21.130" ttm:agent="v1">Darling, can't you see?</p>
      <p begin="02:21.130" end="02:25.380" ttm:agent="v1">We're in paradise, I'm lost with you</p>
      <p begin="02:25.380" end="02:29.210" ttm:agent="v1">We're in paradise, I'm lost with you</p>
      <p begin="02:29.210" end="02:33.260" ttm:agent="v1">Like two satellites, take in the view</p>
      <p begin="02:33.260" end="02:37.460" ttm:agent="v1">Like two satellites</p>
      <p begin="02:37.460" end="02:43.170" ttm:agent="v1">We're in paradise, I'm lost with you</p>
      <p begin="02:43.170" end="02:45.620" ttm:agent="v1">Oh-oh, oh-oh</p>
      <p begin="02:45.620" end="02:51.160" ttm:agent="v1">Like two satellites, take in the view</p>
      <p begin="02:51.160" end="02:57.630" ttm:agent="v1">Na-na-na-na, na-na-na-na</p>
      <p begin="02:57.630" end="02:59.920" ttm:agent="v1">Mm-mm</p>
      <p begin="02:59.920" end="03:03.920" ttm:agent="v1"/>
    </div>
