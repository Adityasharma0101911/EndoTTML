<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>In My Heart - Demo</ttm:title><ttm:agent type="person" xml:id="v1">grentperez</ttm:agent><ttm:item type="album">Demo(s) About Love</ttm:item><ttm:item type="spotify_id">6R40Gd50bz5ZTB6JTSHVtr</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:12.180" end="00:14.940">I wanna be where you are</p><p ttm:agent="v1" begin="00:14.940" end="00:16.440">Feel so close though</p><p ttm:agent="v1" begin="00:16.130" end="00:17.630">You're so far</p><p ttm:agent="v1" begin="00:17.190" end="00:23.860">You're my world</p><p ttm:agent="v1" begin="00:23.860" end="00:27.020">Roam the city streets at night</p><p ttm:agent="v1" begin="00:27.020" end="00:29.270">Pull you close and hold you tight</p><p ttm:agent="v1" begin="00:29.270" end="00:35.930">You're my girl</p><p ttm:agent="v1" begin="00:35.930" end="00:40.370">Woah oh</p><p ttm:agent="v1" begin="00:40.370" end="00:42.800">No matter where you are</p><p ttm:agent="v1" begin="00:42.800" end="00:48.080">My dear</p><p ttm:agent="v1" begin="00:48.080" end="00:52.040">Oh</p><p ttm:agent="v1" begin="00:52.040" end="00:54.860">You're never really far</p><p ttm:agent="v1" begin="00:54.860" end="00:58.370">You're here</p><p ttm:agent="v1" begin="00:58.370" end="01:06.370">In my-</p><p ttm:agent="v1" begin="01:24.010" end="01:26.600">I never wanna see you leave</p><p ttm:agent="v1" begin="01:26.600" end="01:29.430">We'll grow and raise a family</p><p ttm:agent="v1" begin="01:29.430" end="01:35.020">In our town</p><p ttm:agent="v1" begin="01:35.020" end="01:36.520">Though at night</p><p ttm:agent="v1" begin="01:35.970" end="01:39.420">It seems as we're alone</p><p ttm:agent="v1" begin="01:39.420" end="01:41.340">We're still connected through the phone</p><p ttm:agent="v1" begin="01:41.340" end="01:47.640">Say "hi" now</p><p ttm:agent="v1" begin="01:47.640" end="01:52.030">Woah oh</p><p ttm:agent="v1" begin="01:52.030" end="01:54.990">No matter where you are</p><p ttm:agent="v1" begin="01:54.990" end="02:00.390">My dear</p><p ttm:agent="v1" begin="02:00.390" end="02:04.200">Oh</p><p ttm:agent="v1" begin="02:04.200" end="02:08.270">You're never really far</p><p ttm:agent="v1" begin="02:08.270" end="02:10.460">You're here</p><p ttm:agent="v1" begin="02:10.460" end="02:13.340">In my heart</p><p ttm:agent="v1" begin="02:13.340" end="02:16.450">Doo-do-do-doo-doo</p><p ttm:agent="v1" begin="02:16.450" end="02:22.150">In my heart</p><p ttm:agent="v1" begin="02:22.150" end="02:30.150">In my hear-</p><p ttm:agent="v1" begin="02:34.530" end="02:38.680">It's every time i see you</p><p ttm:agent="v1" begin="02:38.680" end="02:41.880">You make me skip a beat</p><p ttm:agent="v1" begin="02:41.880" end="02:43.910">And by the time you hear this</p><p ttm:agent="v1" begin="02:43.910" end="02:47.440">I hope it sweeps you off your feet</p><p ttm:agent="v1" begin="02:47.440" end="02:50.300">And if you were to ever leave me</p><p ttm:agent="v1" begin="02:50.300" end="02:54.370">I hope that you remember me</p><p ttm:agent="v1" begin="02:54.370" end="02:58.260">I just hope that i'll always be</p><p ttm:agent="v1" begin="02:58.260" end="03:06.260">In your heart</p><p ttm:agent="v1" begin="03:25.070" end="03:29.070" /></div></body></tt>