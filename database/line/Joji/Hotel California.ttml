<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Hotel California</ttm:title>
      <ttm:agent type="person" xml:id="v1">Joji</ttm:agent>
      <ttm:item type="album">Piss In The Wind</ttm:item>
      <ttm:item type="spotify_id">0haXcqxsgfbGTq6OYjLyIs</ttm:item>
      <itunes:duration>02:09.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:11.420" end="00:14.020" ttm:agent="v1">Thought of you make my heart beat fast</p>
      <p begin="00:14.020" end="00:16.630" ttm:agent="v1">Too soon and I’m way too attached</p>
      <p begin="00:16.630" end="00:19.210" ttm:agent="v1">You the best that I ever had</p>
      <p begin="00:19.210" end="00:21.940" ttm:agent="v1">This the first time I hope it lasts</p>
      <p begin="00:21.940" end="00:24.500" ttm:agent="v1">Kind of face that you can’t unsee</p>
      <p begin="00:24.500" end="00:27.020" ttm:agent="v1">Kind of love that you can’t just leave</p>
      <p begin="00:27.020" end="00:29.690" ttm:agent="v1">Fuck me up, got me up past three</p>
      <p begin="00:29.690" end="00:34.260" ttm:agent="v1">But I love when it’s just for me</p>
      <p begin="00:34.260" end="00:38.940" ttm:agent="v1">She said, “Nice to meet ya, nice to know ya”</p>
      <p begin="00:38.940" end="00:44.260" ttm:agent="v1">And left me at the Hotel California</p>
      <p begin="00:44.260" end="00:49.490" ttm:agent="v1">Don’t know what it means, guess I’m a goner</p>
      <p begin="00:49.490" end="00:57.490" ttm:agent="v1">Lost you in the waves, I’m under water</p>
      <p begin="01:00.220" end="01:03.570" ttm:agent="v1">Lost you in the waves, I’m under water</p>
      <p begin="01:03.570" end="01:06.430" ttm:agent="v1">Thought of you make my heart beat fast</p>
      <p begin="01:06.430" end="01:08.870" ttm:agent="v1">Too soon and I’m way too attached</p>
      <p begin="01:08.870" end="01:11.350" ttm:agent="v1">You the best that I ever had</p>
      <p begin="01:11.350" end="01:13.310" ttm:agent="v1">This the first time I hope that it lasts</p>
      <p begin="01:13.310" end="01:18.710" ttm:agent="v1">Just when I think she’s right where I want her</p>
      <p begin="01:18.710" end="01:23.030" ttm:agent="v1">Then she goes like a wave to the water</p>
      <p begin="01:23.030" end="01:26.200" ttm:agent="v1">Then ooh</p>
      <p begin="01:26.200" end="01:31.010" ttm:agent="v1">She said, “Nice to meet ya, nice to know ya”</p>
      <p begin="01:31.010" end="01:36.650" ttm:agent="v1">And left me at the Hotel California</p>
      <p begin="01:36.650" end="01:41.840" ttm:agent="v1">Don’t know what it means, guess I’m a goner</p>
      <p begin="01:41.840" end="01:49.840" ttm:agent="v1">Lost you in the waves, I’m under water</p>
      <p begin="01:52.330" end="02:00.330" ttm:agent="v1">Lost you in the waves, I’m under water</p>
      <p begin="02:02.770" end="02:08.990" ttm:agent="v1">Lost you in the waves, I’m under water</p>
      <p begin="02:08.990" end="02:12.990" ttm:agent="v1"/>
    </div>
