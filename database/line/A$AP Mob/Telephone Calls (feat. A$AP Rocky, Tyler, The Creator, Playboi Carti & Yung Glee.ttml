<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Telephone Calls (feat. A$AP Rocky, Tyler, The Creator, Playboi Carti &amp; Yung Gleesh)</ttm:title>
      <ttm:agent type="person" xml:id="v1">A$AP Mob</ttm:agent>
      <ttm:agent type="person" xml:id="v2">A$AP Rocky</ttm:agent>
      <ttm:agent type="person" xml:id="v3">Tyler</ttm:agent>
      <ttm:agent type="person" xml:id="v4">The Creator</ttm:agent>
      <ttm:agent type="person" xml:id="v5">Playboi Carti</ttm:agent>
      <ttm:agent type="person" xml:id="v6">Yung Gleesh</ttm:agent>
      <ttm:item type="album">Cozy Tapes: Vol. 1 Friends -</ttm:item>
      <ttm:item type="spotify_id">5VnpYqIzm02X9gOhVElQo3</ttm:item>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:00.422" end="00:03.686" ttm:agent="v1">A$AP Rocky:</p>
      <p begin="00:03.686" end="00:06.426" ttm:agent="v1">Brr, brr, brr, brr</p>
      <p begin="00:06.426" end="00:12.175" ttm:agent="v1">Ring, ring, ring, postman</p>
      <p begin="00:12.175" end="00:13.675" ttm:agent="v1">Who this?</p>
      <p begin="00:12.429" end="00:13.929" ttm:agent="v1" itunes:key="role" itunes:value="background">(Nash effect)</p>
      <p begin="00:12.945" end="00:14.445" ttm:agent="v1">A$AP Rocky:</p>
      <p begin="00:13.672" end="00:17.183" ttm:agent="v1">Telephone call from Yung Carti, said it's lit</p>
      <p begin="00:17.183" end="00:20.928" ttm:agent="v1" itunes:key="role" itunes:value="background">Call the young lord A$AP Bari, he legit (Moneybag)</p>
      <p begin="00:20.928" end="00:25.183" ttm:agent="v1" itunes:key="role" itunes:value="background">And the young boy Ian Connor off the shxt (Young Lord)</p>
      <p begin="00:25.183" end="00:28.938" ttm:agent="v1">Fxxkin' with them boys out of Harlem or the 6</p>
      <p begin="00:28.938" end="00:30.438" ttm:agent="v1">This is Gosha</p>
      <p begin="00:30.435" end="00:32.682" ttm:agent="v1">Man, I pay for pxssy? No sir</p>
      <p begin="00:32.682" end="00:34.429" ttm:agent="v1">Ridin' coaster</p>
      <p begin="00:34.429" end="00:36.183" ttm:agent="v1">Roller coaster, chauffeur</p>
      <p begin="00:36.183" end="00:37.683" ttm:agent="v1">Playboi Carti:</p>
      <p begin="00:36.440" end="00:38.190" ttm:agent="v1">I got money bags</p>
      <p begin="00:38.190" end="00:42.068" ttm:agent="v1" itunes:key="role" itunes:value="background">I'ma bag your bxtch, I'ma buy your bxtch(I got money bags, turn up, turn up)</p>
      <p begin="00:42.068" end="00:46.513" ttm:agent="v1" itunes:key="role" itunes:value="background">I'ma cash this shxt, I'ma cash this shxt(I got money bags, turn up, turn up)</p>
      <p begin="00:46.513" end="00:50.530" ttm:agent="v1" itunes:key="role" itunes:value="background">Cash Carti, bxtch, Cash Carti, bxtch(Carti, Carti)</p>
      <p begin="00:50.530" end="00:54.213" ttm:agent="v1" itunes:key="role" itunes:value="background">You can have this shxt, you can have this shxt(What you want, yo?)</p>
      <p begin="00:54.213" end="00:55.713" ttm:agent="v1">A$AP Rocky:</p>
      <p begin="00:54.468" end="00:56.714" ttm:agent="v1">Godfather rap, nappy plaits to the back</p>
      <p begin="00:56.714" end="00:59.715" ttm:agent="v1">James Brown swag, Papa's got a brand-new bag</p>
      <p begin="00:59.715" end="01:01.215" ttm:agent="v1">And I don't know how to act</p>
      <p begin="01:00.971" end="01:02.471" ttm:agent="v1">On or off the record, might go axe</p>
      <p begin="01:02.466" end="01:04.468" ttm:agent="v1">Harlem back up on the map</p>
      <p begin="01:04.468" end="01:05.970" ttm:agent="v1">True New York will knock the Apple out you Jacks</p>
      <p begin="01:05.970" end="01:07.958" ttm:agent="v1">Pop your Snapple cap, pop facts</p>
      <p begin="01:07.958" end="01:10.464" ttm:agent="v1">Gucci and Dior biddin' wars</p>
      <p begin="01:10.464" end="01:12.217" ttm:agent="v1">Who wore the piece before they hit the floor?</p>
      <p begin="01:12.217" end="01:14.462" ttm:agent="v1">Not even shxt you see overseas in stores</p>
      <p begin="01:14.462" end="01:16.471" ttm:agent="v1">Who else but me? I know you seen the Forbes</p>
      <p begin="01:16.471" end="01:18.220" ttm:agent="v1">Commend your boy, I been the Lord</p>
      <p begin="01:18.220" end="01:21.158" ttm:agent="v1">Holy tabernacle, Mister Smack-Your-Favorite-Rapper</p>
      <p begin="01:21.158" end="01:23.351" ttm:agent="v1">Greedy for the fat guy's platter</p>
      <p begin="01:23.351" end="01:26.361" ttm:agent="v1">Killin' nixxas even though black lives matter</p>
      <p begin="01:26.361" end="01:28.364" ttm:agent="v1">Weak stomach, flow make 'em throw up</p>
      <p begin="01:28.364" end="01:30.106" ttm:agent="v1">Steppin' stones, I'm your stepfather</p>
      <p begin="01:30.106" end="01:32.362" ttm:agent="v1">Tell Tyler, better step his flow up</p>
      <p begin="01:32.362" end="01:34.116" ttm:agent="v1">Mix the pour up with the Pepsi Cola</p>
      <p begin="01:34.116" end="01:36.107" ttm:agent="v1">Nextel or the Motorola</p>
      <p begin="01:36.107" end="01:38.107" ttm:agent="v1">Young nixxa prolly never grow up</p>
      <p begin="01:38.107" end="01:39.607" ttm:agent="v1">Postman with the telephone, uh</p>
      <p begin="01:39.349" end="01:42.855" ttm:agent="v1">A$AP Rocky:</p>
      <p begin="01:42.855" end="01:47.607" ttm:agent="v1">Ring, ring, ring, postman</p>
      <p begin="01:47.607" end="01:49.107" ttm:agent="v1">Who this?</p>
      <p begin="01:48.293" end="01:49.793" ttm:agent="v1">Tyler, the Creator:</p>
      <p begin="01:49.556" end="01:51.056" ttm:agent="v1">Fxxk with Taco, fxxk with Jasper</p>
      <p begin="01:50.807" end="01:53.450" ttm:agent="v1">Fxxk with Lionel, man that shit is gon' get sketchy</p>
      <p begin="01:53.450" end="01:54.950" ttm:agent="v1">Shirt is striped, my shorts are short</p>
      <p begin="01:54.394" end="01:57.148" ttm:agent="v1">My Vans are Vans 'cause Tyler does not fxxk with Giuseppe</p>
      <p begin="01:57.148" end="01:58.910" ttm:agent="v1">Fxxk the Gucci, fxxk the Raf</p>
      <p begin="01:58.910" end="02:00.902" ttm:agent="v1">And fxxk the swag and all that other shxt they wearin'</p>
      <p begin="02:00.902" end="02:02.411" ttm:agent="v1">Fxxk the Rolls and fxxk the 'Rari</p>
      <p begin="02:02.411" end="02:04.417" ttm:agent="v1">Fxxk the Lambo', Tyler only ride McLaren</p>
      <p begin="02:04.417" end="02:07.163" ttm:agent="v1">Nixxas think they really on because they trappin'</p>
      <p begin="02:07.163" end="02:08.663" ttm:agent="v1">Made about like 30 thousand</p>
      <p begin="02:08.659" end="02:10.653" ttm:agent="v1">Fxxk the party, threw the carnival</p>
      <p begin="02:10.653" end="02:12.837" ttm:agent="v1">Attendance this year was like 30 thousand</p>
      <p begin="02:12.837" end="02:15.352" ttm:agent="v1">Shoppin', ballin', opal fire diamonds shinin'</p>
      <p begin="02:15.352" end="02:17.098" ttm:agent="v1">Make sure my sapphire's glistenin'</p>
      <p begin="02:17.098" end="02:18.599" ttm:agent="v1">Make the shxt, I wear the shxt</p>
      <p begin="02:18.599" end="02:20.352" ttm:agent="v1">They cop the shxt, it's Golf, you bxtch, you nixxas trippin'</p>
      <p begin="02:20.352" end="02:22.789" ttm:agent="v1">I'm a businessman, you ain't never been the man</p>
      <p begin="02:22.789" end="02:25.803" ttm:agent="v1">Nixxa tax bracket changed, like have you seen my home?</p>
      <p begin="02:25.803" end="02:27.303" ttm:agent="v1">Crib got a tennis court</p>
      <p begin="02:27.043" end="02:28.543" ttm:agent="v1">Get my Venus and Serena on</p>
      <p begin="02:28.054" end="02:29.796" ttm:agent="v1">Golf in this bxtch, better ring the doctor</p>
      <p begin="02:29.796" end="02:32.059" ttm:agent="v1">Ambulance come when I hit the scene</p>
      <p begin="02:32.059" end="02:34.040" ttm:agent="v1">That boy flier than a bag of bees</p>
      <p begin="02:34.040" end="02:36.049" ttm:agent="v1">I got my flowers, life's a jeweler</p>
      <p begin="02:36.049" end="02:38.051" ttm:agent="v1">Diamond, fingers size of a tumor</p>
      <p begin="02:38.051" end="02:39.791" ttm:agent="v1">He's a genius, have you heard the rumors?</p>
      <p begin="02:39.791" end="02:41.805" ttm:agent="v1">He's a winner, no not a loser</p>
      <p begin="02:41.805" end="02:43.791" ttm:agent="v1">Fxxk passin' blunts, pass my nixxas' opportunities</p>
      <p begin="02:43.791" end="02:47.045" ttm:agent="v1">Goddamn, I'm hot, man, I'm not scared to freeze</p>
      <p begin="02:47.045" end="02:49.294" ttm:agent="v1">January, Hawaiian shirts</p>
      <p begin="02:49.294" end="02:51.291" ttm:agent="v1">Boy this weather ain't got a thing on me</p>
      <p begin="02:51.291" end="02:53.302" ttm:agent="v1">Where's the mirror? I'm that nixxa</p>
      <p begin="02:53.302" end="02:54.802" ttm:agent="v1">Kunta ain't got much shxt on me</p>
      <p begin="02:54.798" end="02:57.492" ttm:agent="v1">'Cause I'm a master, I hit my own back</p>
      <p begin="02:57.492" end="02:58.992" ttm:agent="v1">To be like, &quot;Y'all boys, my nixxa&quot;</p>
      <p begin="02:58.732" end="03:00.480" ttm:agent="v1">Fxxk that, it's Golf, bxtch</p>
      <p begin="03:00.480" end="03:01.980" ttm:agent="v1">Yung Gleesh&amp;A$AP Rocky:</p>
      <p begin="03:01.976" end="03:05.110" ttm:agent="v1">Doin' it for Yams, ayy, ayy</p>
      <p begin="03:05.110" end="03:08.607" ttm:agent="v1">I used to do it for the grams, ayy, ayy</p>
      <p begin="03:08.607" end="03:12.356" ttm:agent="v1">That's been way before Instagram, ayy, ayy</p>
      <p begin="03:12.356" end="03:15.614" ttm:agent="v1">I used to serve it to your mans, ayy</p>
      <p begin="03:15.614" end="03:17.114" ttm:agent="v1">Postman, who this?</p>
      <p begin="03:17.103" end="03:19.617" ttm:agent="v1">Walk, Gleesh, walk, walk, walk</p>
      <p begin="03:19.617" end="03:21.117" ttm:agent="v1">Walk, Gleesh, walk, walk, walk</p>
      <p begin="03:20.864" end="03:22.364" ttm:agent="v1">Walk, Gleesh, walk, walk, walk</p>
      <p begin="03:22.359" end="03:24.112" ttm:agent="v1">Walk, Gleesh, walk, walk, walk</p>
      <p begin="03:24.112" end="03:26.118" ttm:agent="v1">Walk, Gleesh, walk, walk, walk</p>
      <p begin="03:26.118" end="03:28.121" ttm:agent="v1">Walk, walk, walk, walk</p>
      <p begin="03:28.121" end="03:30.372" ttm:agent="v1">Walk, walk, walk, walk</p>
      <p begin="03:30.372" end="03:32.362" ttm:agent="v1">Walk, walk, walk, walk</p>
      <p begin="03:32.362" end="03:34.351" ttm:agent="v1">Walk, walk, walk, walk</p>
      <p begin="03:34.351" end="03:36.107" ttm:agent="v1">Walk, walk, walk, walk</p>
      <p begin="03:36.107" end="03:38.371" ttm:agent="v1">Walk, walk, walk, walk</p>
      <p begin="03:38.371" end="03:44.107" ttm:agent="v1">Walk, walk, walk, walk</p>
      <p begin="03:44.107" end="03:48.107" ttm:agent="v1">Walk, walk, walk, walk</p>
    </div>
  </body>
</tt>
