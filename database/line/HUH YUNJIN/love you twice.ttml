<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>love you twice</ttm:title>
      <ttm:agent type="person" xml:id="v1">HUH YUNJIN</ttm:agent>
      <ttm:item type="album">love you twice</ttm:item>
      <ttm:item type="spotify_id">0GLXQAdrh4tdvz0JLw8DX8</ttm:item>
      <itunes:duration>02:52.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:10.250" end="00:13.340" ttm:agent="v1">A spotless bedroom</p>
      <p begin="00:13.340" end="00:15.350" ttm:agent="v1">Spends quiet nights</p>
      <p begin="00:15.350" end="00:18.470" ttm:agent="v1">Pilates mornings</p>
      <p begin="00:18.470" end="00:20.370" ttm:agent="v1">And she's good with wine</p>
      <p begin="00:20.370" end="00:22.440" ttm:agent="v1">She wakes at the right time</p>
      <p begin="00:22.440" end="00:23.940" ttm:agent="v1">Sets the right vibes</p>
      <p begin="00:23.570" end="00:26.170" ttm:agent="v1">She's funny but never too much</p>
      <p begin="00:26.170" end="00:29.880" ttm:agent="v1">Mysterious but always in touch</p>
      <p begin="00:29.880" end="00:32.230" ttm:agent="v1">I wonder what you see</p>
      <p begin="00:32.230" end="00:34.630" ttm:agent="v1">When you see someone like me</p>
      <p begin="00:34.630" end="00:36.130" ttm:agent="v1">Do you see her?</p>
      <p begin="00:35.980" end="00:39.960" ttm:agent="v1">Won't you rather touch marble instead of limestone</p>
      <p begin="00:39.960" end="00:44.620" ttm:agent="v1">All I wish to be is someone deserving</p>
      <p begin="00:44.620" end="00:50.270" ttm:agent="v1">Of the comfort that you bring</p>
      <p begin="00:50.270" end="00:55.220" ttm:agent="v1">Cause deep inside I wanna be her</p>
      <p begin="00:55.220" end="00:58.660" ttm:agent="v1">She takes the hit but never shows you</p>
      <p begin="00:58.660" end="01:00.600" ttm:agent="v1">Where it hurts?</p>
      <p begin="01:00.600" end="01:04.370" ttm:agent="v1">Bathes you in spring sunshine</p>
      <p begin="01:04.370" end="01:07.030" ttm:agent="v1">Wipes tears dry</p>
      <p begin="01:07.030" end="01:11.560" ttm:agent="v1">And says I love you twice</p>
      <p begin="01:11.560" end="01:13.160" ttm:agent="v1">Seasons change</p>
      <p begin="01:13.160" end="01:16.520" ttm:agent="v1">Say you'll stay the same</p>
      <p begin="01:16.520" end="01:19.390" ttm:agent="v1">봄 가을 겨울도</p>
      <p begin="01:19.390" end="01:21.630" ttm:agent="v1">Look my way, look your way</p>
      <p begin="01:21.630" end="01:24.320" ttm:agent="v1">Say okay, I'm okay</p>
      <p begin="01:24.320" end="01:30.070" ttm:agent="v1">눈꽃이 녹아도 넌 피어나도록</p>
      <p begin="01:30.070" end="01:31.570" ttm:agent="v1">In seven years time</p>
      <p begin="01:31.120" end="01:33.430" ttm:agent="v1">Will I look back and wonder</p>
      <p begin="01:33.430" end="01:36.140" ttm:agent="v1">Why was I such a mess</p>
      <p begin="01:36.140" end="01:40.030" ttm:agent="v1">Unable to relax</p>
      <p begin="01:40.030" end="01:42.490" ttm:agent="v1">날마다 불안불안해 내 마음이</p>
      <p begin="01:42.490" end="01:44.990" ttm:agent="v1">무대 위에선 chill 내려와선 녹지</p>
      <p begin="01:44.990" end="01:50.090" ttm:agent="v1">남몰래 애써 장착해 내 red carpet의 착장</p>
      <p begin="01:50.090" end="01:52.460" ttm:agent="v1">장난 같지만 나름 진지해진 대화</p>
      <p begin="01:52.460" end="01:54.860" ttm:agent="v1">거울 속에 넌 명작의 초상화</p>
      <p begin="01:54.860" end="01:57.530" ttm:agent="v1">매번 말해서 진부해지겠지만</p>
      <p begin="01:57.530" end="02:00.840" ttm:agent="v1">널 잃을까 봐 두려운 건 똑같아</p>
      <p begin="02:00.840" end="02:03.240" ttm:agent="v1">No matter what you see</p>
      <p begin="02:03.240" end="02:05.920" ttm:agent="v1">Can your eyes please stay on me?</p>
      <p begin="02:05.920" end="02:10.180" ttm:agent="v1">빛바래도 제일 빛난다고 해줘</p>
      <p begin="02:10.180" end="02:15.190" ttm:agent="v1">Cause deep inside I wanna be her</p>
      <p begin="02:15.190" end="02:16.690" ttm:agent="v1">She takes the hit</p>
      <p begin="02:16.500" end="02:20.540" ttm:agent="v1">But swings back stronger than before</p>
      <p begin="02:20.540" end="02:24.500" ttm:agent="v1">Bathes you in spring sunshine</p>
      <p begin="02:24.500" end="02:27.270" ttm:agent="v1">Wipes tears dry</p>
      <p begin="02:27.270" end="02:31.260" ttm:agent="v1">And says I love you twice</p>
      <p begin="02:31.260" end="02:33.170" ttm:agent="v1">Seasons change</p>
      <p begin="02:33.170" end="02:36.970" ttm:agent="v1">Say you'll stay the same</p>
      <p begin="02:36.970" end="02:39.230" ttm:agent="v1">Cause I love you</p>
      <p begin="02:39.230" end="02:41.500" ttm:agent="v1">Look my way, look your way</p>
      <p begin="02:41.500" end="02:44.430" ttm:agent="v1">Say okay, I'm okay</p>
      <p begin="02:44.430" end="02:46.800" ttm:agent="v1">피어나도록</p>
      <p begin="02:46.800" end="02:48.470" ttm:agent="v1">I'll say I love you twice</p>
      <p begin="02:48.470" end="02:52.470" ttm:agent="v1"/>
    </div>
  </body>
</tt>
