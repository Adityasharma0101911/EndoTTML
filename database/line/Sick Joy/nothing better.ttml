<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>nothing better</ttm:title><ttm:agent type="person" xml:id="v1">Sick Joy</ttm:agent><ttm:item type="album">WE'RE ALL GONNA F***ING DIE.</ttm:item><ttm:item type="spotify_id">3oeZYZZBJpXVRAQXFy965s</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.330" end="00:03.040">I'll admit it, I don't wanna try</p><p ttm:agent="v1" begin="00:03.040" end="00:06.510">Son of Sam on his sweet side</p><p ttm:agent="v1" begin="00:06.510" end="00:09.790">No fightin' when you wanted to</p><p ttm:agent="v1" begin="00:09.790" end="00:12.650">Didn't cry when you needed to</p><p ttm:agent="v1" begin="00:12.650" end="00:15.690">I'd be a daddy but I'm deadbeat</p><p ttm:agent="v1" begin="00:15.690" end="00:19.030">I'm on the calls with your cold feet</p><p ttm:agent="v1" begin="00:19.030" end="00:22.180">And I'll admit it, I don't wanna try</p><p ttm:agent="v1" begin="00:22.180" end="00:25.220">I let ya live if you let it die, yeah</p><p ttm:agent="v1" begin="00:25.220" end="00:28.470">Armageddon</p><p ttm:agent="v1" begin="00:28.470" end="00:31.660">In our shelter</p><p ttm:agent="v1" begin="00:31.660" end="00:34.760">Nothing better</p><p ttm:agent="v1" begin="00:34.760" end="00:37.980">Live forever</p><p ttm:agent="v1" begin="00:37.980" end="00:45.980" /><p ttm:agent="v1" begin="00:50.530" end="00:53.850">Well methamphetamines</p><p ttm:agent="v1" begin="00:53.850" end="00:56.940">We're bleeding and scratching</p><p ttm:agent="v1" begin="00:56.940" end="01:00.130">I think we've had enough</p><p ttm:agent="v1" begin="01:00.130" end="01:03.140">You think I talk too much</p><p ttm:agent="v1" begin="01:03.140" end="01:06.300">Armageddon</p><p ttm:agent="v1" begin="01:06.300" end="01:09.400">In our shelter</p><p ttm:agent="v1" begin="01:09.400" end="01:12.610">Nothing better</p><p ttm:agent="v1" begin="01:12.610" end="01:15.930">Live forever</p><p ttm:agent="v1" begin="01:15.930" end="01:19.130">Armageddon</p><p ttm:agent="v1" begin="01:19.130" end="01:22.100">In our shelter</p><p ttm:agent="v1" begin="01:22.100" end="01:25.480">Nothing better</p><p ttm:agent="v1" begin="01:25.480" end="01:29.020">Live forever</p><p ttm:agent="v1" begin="01:29.020" end="01:37.020" /><p ttm:agent="v1" begin="01:53.680" end="01:56.760">I'll admit it, I don't wanna try</p><p ttm:agent="v1" begin="01:56.760" end="02:00.100">Son of Sam on his sweet side</p><p ttm:agent="v1" begin="02:00.100" end="02:03.340">No fightin' when you wanted to</p><p ttm:agent="v1" begin="02:03.340" end="02:06.350">Didn't cry when you needed to</p><p ttm:agent="v1" begin="02:06.350" end="02:09.460">I'd be a daddy but I'm deadbeat</p><p ttm:agent="v1" begin="02:09.460" end="02:12.690">I'm on the call with your cold feet</p><p ttm:agent="v1" begin="02:12.690" end="02:15.580">And I'll admit it, I don't wanna try</p><p ttm:agent="v1" begin="02:15.580" end="02:18.700">I let ya live if you let it die, yeah</p><p ttm:agent="v1" begin="02:18.700" end="02:24.640" itunes:key="role" itunes:value="background">(Yeah)</p><p ttm:agent="v1" begin="02:24.640" end="02:31.390" /><p ttm:agent="v1" begin="02:31.390" end="02:35.070">Armageddon</p><p ttm:agent="v1" begin="02:35.070" end="02:38.040">In our shelter</p><p ttm:agent="v1" begin="02:38.040" end="02:41.090">Nothing better</p><p ttm:agent="v1" begin="02:41.090" end="02:44.590">Live forever</p><p ttm:agent="v1" begin="02:44.590" end="02:47.440">Armageddon</p><p ttm:agent="v1" begin="02:47.440" end="02:50.600">In our shelter</p><p ttm:agent="v1" begin="02:50.600" end="02:53.660">Nothing better</p><p ttm:agent="v1" begin="02:53.660" end="02:57.200">Live forever</p><p ttm:agent="v1" begin="02:57.200" end="03:01.200" /></div></body></tt>