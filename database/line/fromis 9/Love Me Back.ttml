<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Love Me Back</ttm:title>
      <ttm:agent type="person" xml:id="v1">fromis_9</ttm:agent>
      <ttm:item type="album">Love Me Back (From &quot;Operation: True Love&quot;)</ttm:item>
      <ttm:item type="spotify_id">2IMPPA9UZpqTnnVIy9lDHU</ttm:item>
      <itunes:duration>03:06.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:02.820" end="00:07.020" ttm:agent="v1">Hey, it's me</p>
      <p begin="00:07.020" end="00:09.370" ttm:agent="v1">Things have been weird</p>
      <p begin="00:09.370" end="00:13.460" ttm:agent="v1" itunes:key="role" itunes:value="background">Nuni ga jakku wae irae? (Whoa)</p>
      <p begin="00:13.460" end="00:21.460" ttm:agent="v1" itunes:key="role" itunes:value="background">Jojeori andwae ije (no), wae honjaseoman irae? Bokjaphaejyeo</p>
      <p begin="00:22.040" end="00:25.360" ttm:agent="v1">Then let me just make it simple</p>
      <p begin="00:25.360" end="00:27.510" ttm:agent="v1">Oh, you're all I think about, yeah</p>
      <p begin="00:27.510" end="00:29.660" ttm:agent="v1">I love to get your attention, babe</p>
      <p begin="00:29.660" end="00:31.780" ttm:agent="v1">Yeah, yeah, what I need is only you, bebe</p>
      <p begin="00:31.780" end="00:33.870" ttm:agent="v1">Neodoneodo geureotago malhaejwo</p>
      <p begin="00:33.870" end="00:36.060" ttm:agent="v1">Aesseoaesseo sumgijineun marajwo</p>
      <p begin="00:36.060" end="00:38.140" ttm:agent="v1">I love to feel the attraction, babe</p>
      <p begin="00:38.140" end="00:40.150" ttm:agent="v1">Yeah, yeah, what I need is only you, bebe</p>
      <p begin="00:40.150" end="00:42.600" ttm:agent="v1">Jakku aesseo sumgiryogo haji ma</p>
      <p begin="00:42.600" end="00:44.100" ttm:agent="v1">Just say what's right now</p>
      <p begin="00:44.080" end="00:48.140" ttm:agent="v1">I know you love me back, malhaji anado</p>
      <p begin="00:48.140" end="00:52.390" ttm:agent="v1">Oh, I know you love me back, tinaeji anado</p>
      <p begin="00:52.390" end="00:54.630" ttm:agent="v1">Maybe you don't love me back</p>
      <p begin="00:54.630" end="01:02.080" ttm:agent="v1" itunes:key="role" itunes:value="background">Tteollineun i neukkim feel so high (so high, so high), just let me tell you</p>
      <p begin="01:02.080" end="01:06.310" ttm:agent="v1">Naegeman only, dalkomhage holy</p>
      <p begin="01:06.310" end="01:10.560" ttm:agent="v1">Daraoreun du bori show it to you</p>
      <p begin="01:10.560" end="01:14.850" ttm:agent="v1">Gidaryeojyeo call me, hwaksilhi nan fallin'</p>
      <p begin="01:14.850" end="01:19.270" ttm:agent="v1">Chaoreuneun useumi beonjyeogajanha, yeah</p>
      <p begin="01:19.270" end="01:20.920" ttm:agent="v1">Taeyeonhage garyeojun haetbit</p>
      <p begin="01:20.920" end="01:23.350" ttm:agent="v1">Hanahana waenji mutgo sipeo</p>
      <p begin="01:23.350" end="01:25.330" ttm:agent="v1">Gunggumhan ge eopneun geot gata</p>
      <p begin="01:25.330" end="01:27.920" ttm:agent="v1">Do you want, want, want me too?</p>
      <p begin="01:27.920" end="01:35.140" ttm:agent="v1">Maeil gireul ireo, what if you go away, away, away?</p>
      <p begin="01:35.140" end="01:36.640" ttm:agent="v1">Ooh-ooh, ooh, ooh</p>
      <p begin="01:36.100" end="01:38.100" ttm:agent="v1">I love to get your attention, babe</p>
      <p begin="01:38.100" end="01:40.410" ttm:agent="v1">Yeah, yeah, what I need is only you, bebe</p>
      <p begin="01:40.410" end="01:42.320" ttm:agent="v1">Neodoneodo geureotago malhaejwo</p>
      <p begin="01:42.320" end="01:44.630" ttm:agent="v1">Aesseoaesseo sumgijineun marajwo</p>
      <p begin="01:44.630" end="01:46.790" ttm:agent="v1">I love to feel the attraction, babe</p>
      <p begin="01:46.790" end="01:48.880" ttm:agent="v1">Yeah, yeah, what I need is only you, bebe</p>
      <p begin="01:48.880" end="01:51.170" ttm:agent="v1">Jakku aesseo sumgiryogo haji ma</p>
      <p begin="01:51.170" end="01:52.670" ttm:agent="v1">Just say what's right now</p>
      <p begin="01:52.650" end="01:56.600" ttm:agent="v1">I know you love me back, malhaji anado</p>
      <p begin="01:56.600" end="02:01.130" ttm:agent="v1">Oh, I know you love me back, tinaeji anado</p>
      <p begin="02:01.130" end="02:03.240" ttm:agent="v1" itunes:key="role" itunes:value="background">Maybe you don't love me back (love me back)</p>
      <p begin="02:03.240" end="02:10.660" ttm:agent="v1" itunes:key="role" itunes:value="background">Tteollineun i neukkim feel so high (so high, so high), just let me tell you</p>
      <p begin="02:10.660" end="02:12.690" ttm:agent="v1" itunes:key="role" itunes:value="background">Waiting for your call (your call)</p>
      <p begin="02:12.690" end="02:14.780" ttm:agent="v1" itunes:key="role" itunes:value="background">Maeil bam saenggakna (saenggakna)</p>
      <p begin="02:14.780" end="02:19.310" ttm:agent="v1" itunes:key="role" itunes:value="background">I just wanna fall (fall in) in love, oh</p>
      <p begin="02:19.310" end="02:27.090" ttm:agent="v1">Uyeon-in cheok tto nuneul majuchyeo, geureom mwo eottae? Hi, you, hi, you</p>
      <p begin="02:27.090" end="02:30.970" ttm:agent="v1" itunes:key="role" itunes:value="background">I know you love me back (ah), malhaji anado (anado)</p>
      <p begin="02:30.970" end="02:35.240" ttm:agent="v1" itunes:key="role" itunes:value="background">Oh, I know you love me back, tinaeji anado (anado)</p>
      <p begin="02:35.240" end="02:37.790" ttm:agent="v1" itunes:key="role" itunes:value="background">Maybe you don't love me back (love me back)</p>
      <p begin="02:37.790" end="02:45.090" ttm:agent="v1" itunes:key="role" itunes:value="background">Tteollineun i neukkim feel so high (so high, so high), just let me tell you</p>
      <p begin="02:45.090" end="02:49.130" ttm:agent="v1" itunes:key="role" itunes:value="background">Naegeman only (only), dalkomhage holy</p>
      <p begin="02:49.130" end="02:53.500" ttm:agent="v1">Daraoreun du bori show it to you</p>
      <p begin="02:53.500" end="02:57.460" ttm:agent="v1" itunes:key="role" itunes:value="background">Gidaryeojyeo call me (call me), hwaksilhi nan fallin' (fallin')</p>
      <p begin="02:57.460" end="03:02.690" ttm:agent="v1" itunes:key="role" itunes:value="background">Chaoreuneun useumi (useumi), beonjyeogajanha, yeah</p>
      <p begin="03:02.690" end="03:06.690" ttm:agent="v1"/>
    </div>
