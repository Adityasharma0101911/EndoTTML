  <body>
    <div>
      <p begin="00:04.470" end="00:06.560" ttm:agent="v1">Isii Naftaan arkooday</p>
      <p begin="00:06.560" end="00:08.750" ttm:agent="v1">Arko oo damacaa eryaaya</p>
      <p begin="00:08.750" end="00:10.860" ttm:agent="v1">Uur-ba jaceel aan huraynee</p>
      <p begin="00:10.860" end="00:12.910" ttm:agent="v1">Ha aadin dheh meel kaleeto</p>
      <p begin="00:12.910" end="00:14.560" ttm:agent="v1">Isii Naftaan arkooday</p>
      <p begin="00:14.560" end="00:16.980" ttm:agent="v1">Arko oo damacaa eryaaya</p>
      <p begin="00:16.980" end="00:19.070" ttm:agent="v1">Uur-ba jaceel aan huraynee</p>
      <p begin="00:19.070" end="00:21.170" ttm:agent="v1">Ha aadin dheh meel kaleeto</p>
      <p begin="00:21.170" end="00:25.450" ttm:agent="v1"/>
      <p begin="00:25.450" end="00:27.330" ttm:agent="v1">Jaceylka ku aamin laabta</p>
      <p begin="00:27.330" end="00:29.640" ttm:agent="v1">Qalbiga ku abuur dareenka</p>
      <p begin="00:29.640" end="00:31.700" ttm:agent="v1">Ubaxa aan beeray maanta</p>
      <p begin="00:31.700" end="00:33.780" ttm:agent="v1">Ha aasine adigu muuji</p>
      <p begin="00:33.780" end="00:35.840" ttm:agent="v1">Jaceylka ku aamin laabta</p>
      <p begin="00:35.840" end="00:37.990" ttm:agent="v1">Qalbiga ku abuur dareenka</p>
      <p begin="00:37.990" end="00:39.840" ttm:agent="v1">Ubaxa aan beeray maanta</p>
      <p begin="00:39.840" end="00:42.260" ttm:agent="v1">Ha aasine adigu muuji</p>
      <p begin="00:42.260" end="00:46.080" ttm:agent="v1"/>
      <p begin="00:46.080" end="00:48.310" ttm:agent="v1">Ogsoonoo inaan ku kujeclahay</p>
      <p begin="00:48.310" end="00:50.160" ttm:agent="v1">Ana love you more than my life</p>
      <p begin="00:50.160" end="00:52.350" ttm:agent="v1">Ana xibak yaa xabiibi</p>
      <p begin="00:52.350" end="00:54.460" ttm:agent="v1">Nakupenda mimi saba</p>
      <p begin="00:54.460" end="00:56.620" ttm:agent="v1">Waa u jeedada caashaqayga</p>
      <p begin="00:56.620" end="00:58.550" ttm:agent="v1">Ogsoonoo inaan ku kujeclahay</p>
      <p begin="00:58.550" end="01:00.730" ttm:agent="v1">Ana love you more than my life</p>
      <p begin="01:00.730" end="01:02.820" ttm:agent="v1">Ana xibak yaa xabiibi</p>
      <p begin="01:02.820" end="01:04.840" ttm:agent="v1">Nakupenda mimi saba</p>
      <p begin="01:04.840" end="01:06.840" ttm:agent="v1">Waa u jeedada caashaqayga</p>
      <p begin="01:06.840" end="01:14.840" ttm:agent="v1"/>
      <p begin="01:15.300" end="01:17.300" ttm:agent="v1">Adkeey balamaha dhaxdeena</p>
