<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Main Agar Kahoon</ttm:title><ttm:agent type="group" xml:id="v1">Sonu Nigam, Shreya Ghoshal, Vishal-Shekhar, Javed Akhtar</ttm:agent><ttm:item type="album">Om Shanti Om</ttm:item><ttm:item type="spotify_id">0iXLwnLmLwn9y54JtBTNxY</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.000" end="00:08.000" /><p ttm:agent="v1" begin="00:44.170" end="00:49.190">Tumko paya hai toh jaise khoya hoon</p><p ttm:agent="v1" begin="00:49.190" end="00:54.100">Kehna chahoon bhi toh tumse, kya kahoon?</p><p ttm:agent="v1" begin="00:54.100" end="00:58.820">Tumko paya hai toh jaise khoya hoon</p><p ttm:agent="v1" begin="00:58.820" end="01:03.540">Kehna chahoon bhi toh tumse, kya kahoon?</p><p ttm:agent="v1" begin="01:03.540" end="01:08.530">Kisi zabaan mein bhi woh lafz hi nahi</p><p ttm:agent="v1" begin="01:08.530" end="01:13.570">ki jinamein tum ho kya, tumhein bataa sakun</p><p ttm:agent="v1" begin="01:13.570" end="01:18.480">main agar kahoon tum sa haseen</p><p ttm:agent="v1" begin="01:18.480" end="01:23.300">kaaynaat main nahin hai kahin</p><p ttm:agent="v1" begin="01:23.300" end="01:28.330">Taarif ye bhi toh sach hai kuch bhi nahi</p><p ttm:agent="v1" begin="01:28.330" end="01:33.140">Tumko paya hai toh jaise khoya hoon</p><p ttm:agent="v1" begin="01:33.140" end="01:41.140" /><p ttm:agent="v1" begin="01:57.550" end="02:05.550">shokiyon mein dubi ye adayen chehare se jhalki huee hain</p><p ttm:agent="v1" begin="02:07.350" end="02:15.350">zulf kee ghani-ghani ghataen shaan se dhalki huee hain</p><p ttm:agent="v1" begin="02:17.110" end="02:22.190">Lehraata aanchal hai jaise, baadal</p><p ttm:agent="v1" begin="02:22.190" end="02:30.190">banhon mein bhari hai jaise chaandanee, rup kee chaandanee</p><p ttm:agent="v1" begin="02:31.920" end="02:36.780">main agar kahoon ye dilkashi</p><p ttm:agent="v1" begin="02:36.780" end="02:41.400">hai nahin kahin naa hogi kabhi</p><p ttm:agent="v1" begin="02:41.400" end="02:46.700">Taarif ye bhi toh sach hai kuch bhi nahi</p><p ttm:agent="v1" begin="02:46.700" end="02:51.750">Tumko paya hai toh jaise khoya hoon</p><p ttm:agent="v1" begin="02:51.750" end="02:59.750" /><p ttm:agent="v1" begin="03:10.630" end="03:18.630">Tum huye meherbaan, toh hai ye daastan</p><p ttm:agent="v1" begin="03:24.420" end="03:32.420">o, tum hue meherbaan to hai ye daastaan</p><p ttm:agent="v1" begin="03:35.110" end="03:39.920">Ab tumhara-mera ek hai kaarwan</p><p ttm:agent="v1" begin="03:39.920" end="03:45.410">Tum jahaan, main wahaan</p><p ttm:agent="v1" begin="03:45.410" end="03:50.270">main agar kahoon hamasafar meri</p><p ttm:agent="v1" begin="03:50.270" end="03:54.760">apsara ho tum yaa koi pari</p><p ttm:agent="v1" begin="03:54.760" end="04:00.100">Taarif ye bhi toh sach hai kuch bhi nahi</p><p ttm:agent="v1" begin="04:00.100" end="04:04.890">Tumko paya hai toh jaise khoya hoon</p><p ttm:agent="v1" begin="04:04.890" end="04:09.730">Kehna chahoon bhi toh tumse, kya kahoon?</p><p ttm:agent="v1" begin="04:09.730" end="04:14.500">Kisi zabaan mein bhi woh lafz hi nahi</p><p ttm:agent="v1" begin="04:14.500" end="04:19.740">ki jinamein tum ho kya, tumhein bataa sakun</p><p ttm:agent="v1" begin="04:19.740" end="04:24.580">main agar kahoon tum sa haseen</p><p ttm:agent="v1" begin="04:24.580" end="04:29.140">kaaynaat main nahin hai kahin</p><p ttm:agent="v1" begin="04:29.140" end="04:34.680">Taarif ye bhi toh sach hai kuch bhi nahi</p><p ttm:agent="v1" begin="04:34.680" end="04:38.680" /></div></body></tt>