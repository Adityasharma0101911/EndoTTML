<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Egg Beater</ttm:title><ttm:agent type="person" xml:id="v1">Royel Otis</ttm:agent><ttm:item type="album">Bar &amp; Grill</ttm:item><ttm:item type="spotify_id">3Blg6ZTHUJwPxP5CgUPvD8</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:11.587" end="00:15.666">It's real late</p><p ttm:agent="v1" begin="00:15.666" end="00:19.718">So what</p><p ttm:agent="v1" begin="00:19.718" end="00:23.871">I'm dumb</p><p ttm:agent="v1" begin="00:23.871" end="00:27.917">And so young</p><p ttm:agent="v1" begin="00:27.917" end="00:31.919">So go away</p><p ttm:agent="v1" begin="00:31.919" end="00:36.145">You're no fun</p><p ttm:agent="v1" begin="00:36.145" end="00:40.159">So long</p><p ttm:agent="v1" begin="00:40.159" end="00:44.354">I messed up</p><p ttm:agent="v1" begin="00:44.354" end="00:52.354">Can't take me anywhere when l'm with you Sugar Lumps</p><p ttm:agent="v1" begin="00:52.692" end="01:00.692">I hate the air you breathe but still want you Sugar Lumps</p><p ttm:agent="v1" begin="01:01.004" end="01:09.004">I made a world for you to be young and dumb</p><p ttm:agent="v1" begin="01:21.438" end="01:25.399">Stay up</p><p ttm:agent="v1" begin="01:25.399" end="01:29.274">For once</p><p ttm:agent="v1" begin="01:29.274" end="01:33.414">We'll walk home</p><p ttm:agent="v1" begin="01:33.414" end="01:37.516">Look at the sun</p><p ttm:agent="v1" begin="01:37.516" end="01:45.516">Can't take me anywhere when l'm with you Sugar Lumps</p><p ttm:agent="v1" begin="01:45.916" end="01:53.866">I hate the air you breathe but still want you Sugar Lumps</p><p ttm:agent="v1" begin="01:53.866" end="02:01.866">Can't take me anywhere when l'm with you Sugar Lumps</p><p ttm:agent="v1" begin="02:02.130" end="02:10.130">I hate the air you breathe but still want you Sugar Lumps</p><p ttm:agent="v1" begin="02:10.767" end="02:18.767">I made a world for you to be young and dumb</p><p ttm:agent="v1" begin="02:48.013" end="02:56.013">I made a world for you to be young and dumb</p><p ttm:agent="v1" begin="02:56.218" end="03:04.218">I made you stay so we could be young and dumb</p><p ttm:agent="v1" begin="03:04.344" end="03:12.344">I made a world for you to be young and dumb</p><p ttm:agent="v1" begin="03:12.529" end="03:16.529">I made you stay so we could be young and dumb</p></div></body></tt>