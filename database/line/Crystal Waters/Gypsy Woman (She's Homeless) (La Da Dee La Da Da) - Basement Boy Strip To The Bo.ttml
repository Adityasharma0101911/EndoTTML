      <p begin="03:19.070" end="03:20.570" ttm:agent="v1">La-da-dee, la-di-da</p>
      <p begin="03:20.460" end="03:23.820" ttm:agent="v1">La-da-dee, la-di-da&quot;</p>
      <p begin="03:23.820" end="03:25.630" ttm:agent="v1">&quot;La-da-dee, la-di-da</p>
      <p begin="03:25.630" end="03:27.130" ttm:agent="v1">La-da-dee, la-di-da</p>
      <p begin="03:27.090" end="03:28.590" ttm:agent="v1">La-da-dee, la-di-da</p>
      <p begin="03:28.190" end="03:36.190" ttm:agent="v1">La-da-dee, la-di-da&quot;</p>
      <p begin="03:36.810" end="03:44.810" ttm:agent="v1">&quot;La-da-dee, la-di-da</p>
