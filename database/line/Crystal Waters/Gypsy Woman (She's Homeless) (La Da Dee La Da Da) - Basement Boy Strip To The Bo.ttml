      <p begin="04:25.680" end="04:33.680" ttm:agent="v1">La-da-dee, la-di-da&quot;</p>
      <p begin="05:36.360" end="05:38.040" ttm:agent="v1">&quot;La-da-dee, la-di-da</p>
      <p begin="05:38.040" end="05:40.340" ttm:agent="v1">La-da-dee, la-di-da</p>
      <p begin="05:40.340" end="05:43.650" ttm:agent="v1">La-da-dee, la-di-da</p>
