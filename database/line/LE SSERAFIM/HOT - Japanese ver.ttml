  <head>
    <metadata>
      <ttm:title>HOT - Japanese ver.</ttm:title>
      <ttm:agent type="person" xml:id="v1">LE SSERAFIM</ttm:agent>
      <ttm:item type="album">DIFFERENT</ttm:item>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
