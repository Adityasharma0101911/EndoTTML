<?xml version="1.0" encoding="utf-8"?>

<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">

  <head>

    <metadata>

      <ttm:title>Tauba Tauba (From &quot;Bad Newz&quot;)</ttm:title>

      <ttm:agent type="person" xml:id="v1">Karan Aujla</ttm:agent>

      <ttm:item type="album">Tauba Tauba (From &quot;Bad Newz&quot;)</ttm:item>

      <ttm:item type="spotify_id">1WaqQIJ0iENGWZ1QmYvYNK</ttm:item>

      <itunes:duration>03:28.000</itunes:duration>

    </metadata>

    <styling>

      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>

      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>

    </styling>

    <layout>

      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>

    </layout>

  </head>

  <body>

    <div>

      <p begin="00:01.760" end="00:06.760" ttm:agent="v1">Haye oye oye yeah haan</p>

      <p begin="00:06.760" end="00:08.260" ttm:agent="v1" itunes:key="role" itunes:value="background">(Haan tauba tauba)</p>

      <p begin="00:08.060" end="00:09.560" ttm:agent="v1">Yeah Proof!</p>

      <p begin="00:09.250" end="00:10.750" ttm:agent="v1"/>

      <p begin="00:09.290" end="00:14.350" ttm:agent="v1">Husn tera tauba tauba tauba tauba</p>

      <p begin="00:14.350" end="00:19.440" ttm:agent="v1">Husn tera tauba tauba tauba tauba</p>

      <p begin="00:19.440" end="00:24.340" ttm:agent="v1">Husn tera tauba tauba tauba tauba</p>

      <p begin="00:24.340" end="00:27.850" ttm:agent="v1">Husn tera tauba tauba tauba tauba</p>

      <p begin="00:27.850" end="00:29.940" ttm:agent="v1"/>

      <p begin="00:29.940" end="00:32.240" ttm:agent="v1">Oh le liya kudi ne dil sada</p>

      <p begin="00:32.240" end="00:34.810" ttm:agent="v1">Hale thodha saaf jiha nahin lagda irada</p>

      <p begin="00:34.810" end="00:37.040" ttm:agent="v1">Gutt bahali lambi ni rakhi hai mutiyar ne</p>

      <p begin="00:37.040" end="00:40.460" ttm:agent="v1">Hai dikhda paranda nahion dikhda Prada (Stop)</p>

      <p begin="00:40.460" end="00:42.290" ttm:agent="v1">Figure ton lagdi Latino</p>

      <p begin="00:42.290" end="00:44.820" ttm:agent="v1">Ik vaari dass do ji anni kyun shakeeno</p>

      <p begin="00:44.820" end="00:47.230" ttm:agent="v1">Kal hi tu Italy ton aayi marjaniye</p>

      <p begin="00:47.230" end="00:49.870" ttm:agent="v1">Te purse tu Paris ton mangaya Valentino</p>

      <p begin="00:49.870" end="00:51.370" ttm:agent="v1"/>

      <p begin="00:50.440" end="00:54.660" ttm:agent="v1">Haan tainu kyun na dikhan</p>

      <p begin="00:54.660" end="00:59.680" ttm:agent="v1">Tere ton ki sikhan tere 'te ki likhan</p>

      <p begin="00:59.680" end="01:01.180" ttm:agent="v1"/>

      <p begin="00:59.920" end="01:04.850" ttm:agent="v1">Husn tera tauba tauba tauba tauba</p>

      <p begin="01:04.850" end="01:09.920" ttm:agent="v1">Husn tera tauba tauba tauba tauba</p>

      <p begin="01:09.920" end="01:14.920" ttm:agent="v1">Husn tera tauba tauba tauba tauba</p>

      <p begin="01:14.920" end="01:18.280" ttm:agent="v1">Husn tera tauba tauba tauba tauba</p>

      <p begin="01:18.280" end="01:20.720" ttm:agent="v1"/>

      <p begin="01:20.720" end="01:22.800" ttm:agent="v1">Sohniye ni akh teri thief ae</p>

      <p begin="01:22.800" end="01:25.920" ttm:agent="v1">Aira gaira dekhdi nahin aidan tan shareef aa</p>

      <p begin="01:25.920" end="01:27.500" ttm:agent="v1">Aithe kehndi too much desi</p>

      <p begin="01:27.500" end="01:30.950" ttm:agent="v1">Tanhi chill kare London te party Ibiza</p>

      <p begin="01:30.950" end="01:32.960" ttm:agent="v1">Saade lai free nahin bhora lagdi</p>

      <p begin="01:32.960" end="01:35.400" ttm:agent="v1">IG story ton tan Bora Bora lagdi</p>

      <p begin="01:35.400" end="01:37.860" ttm:agent="v1">'Vaj teri sohniye surili Noori vargi</p>

      <p begin="01:37.860" end="01:40.690" ttm:agent="v1">Jadon lakk hilda odon tan Nora lagdi</p>

      <p begin="01:40.690" end="01:42.190" ttm:agent="v1"/>

      <p begin="01:40.970" end="01:45.200" ttm:agent="v1">Haan milna dasde</p>

      <p begin="01:45.200" end="01:50.000" ttm:agent="v1">Koi than dasde meri jaan dasde</p>

      <p begin="01:50.000" end="01:51.500" ttm:agent="v1"/>

      <p begin="01:50.250" end="01:55.350" ttm:agent="v1">Husn tera tauba tauba tauba tauba</p>

      <p begin="01:55.350" end="02:00.450" ttm:agent="v1">Husn tera tauba tauba tauba tauba</p>

      <p begin="02:00.450" end="02:05.450" ttm:agent="v1">Husn tera tauba tauba tauba tauba</p>

      <p begin="02:05.450" end="02:08.850" ttm:agent="v1">Husn tera tauba tauba tauba tauba</p>

      <p begin="02:08.850" end="02:16.850" ttm:agent="v1"/>

      <p begin="02:21.150" end="02:24.000" ttm:agent="v1">Haye mitran ton akh teri mange kangna</p>

      <p begin="02:24.000" end="02:26.460" ttm:agent="v1">Hune main bana dan mainu dass tan sahi</p>

      <p begin="02:26.460" end="02:29.010" ttm:agent="v1">Jaan mang la main taithon jaan vaar dan</p>

      <p begin="02:29.010" end="02:31.310" ttm:agent="v1">Aape nikalugi ni tu hass tan sahi</p>

      <p begin="02:31.310" end="02:34.040" ttm:agent="v1">Haye tere vich nasha pehle tod da kude</p>

      <p begin="02:34.040" end="02:36.640" ttm:agent="v1">Sohniye sharaab da tan naam lagda</p>

      <p begin="02:36.640" end="02:39.160" ttm:agent="v1">Saade ton chadhai teri vadh ho gayi</p>

      <p begin="02:39.160" end="02:41.490" ttm:agent="v1">Nikle tan sadkan 'te jam lagda</p>

      <p begin="02:41.490" end="02:42.990" ttm:agent="v1"/>

      <p begin="02:41.620" end="02:45.720" ttm:agent="v1">Haan gall maan meri</p>

      <p begin="02:45.720" end="02:50.840" ttm:agent="v1">Mehmaan meri tu ae jaan meri</p>

      <p begin="02:50.840" end="02:52.340" ttm:agent="v1"/>

      <p begin="02:51.000" end="02:56.000" ttm:agent="v1">Husn tera tauba tauba tauba tauba</p>

      <p begin="02:56.000" end="03:01.100" ttm:agent="v1">Husn tera tauba tauba tauba tauba</p>

      <p begin="03:01.100" end="03:06.170" ttm:agent="v1">Husn tera tauba tauba tauba tauba</p>

      <p begin="03:06.170" end="03:11.200" ttm:agent="v1">Husn tera tauba tauba tauba tauba</p>

      <p begin="03:11.200" end="03:16.150" ttm:agent="v1">Husn tera tauba tauba tauba tauba</p>

      <p begin="03:16.150" end="03:19.550" ttm:agent="v1">Husn tera tauba tauba tauba tauba</p>

      <p begin="03:19.550" end="03:23.550" ttm:agent="v1"/>

    </div>

