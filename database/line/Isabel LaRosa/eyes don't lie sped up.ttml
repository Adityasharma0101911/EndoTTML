<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>eyes don't lie sped up</ttm:title><ttm:agent type="person" xml:id="v1">Isabel LaRosa</ttm:agent><ttm:item type="album">eyes don't lie</ttm:item><ttm:item type="spotify_id">6s0mCmiQV9HzfTfKvG14a1</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:02.512" end="00:05.793">Eyes don't lie</p><p ttm:agent="v1" begin="00:05.793" end="00:09.059">Eyes don't lie</p><p ttm:agent="v1" begin="00:09.059" end="00:12.366">Say you're mine</p><p ttm:agent="v1" begin="00:12.366" end="00:14.990">Eyes don't lie</p><p ttm:agent="v1" begin="00:14.990" end="00:16.490" /><p ttm:agent="v1" begin="00:15.907" end="00:17.664">Can't lie to you, baby</p><p ttm:agent="v1" begin="00:17.664" end="00:22.551">Wanna feel your body close</p><p ttm:agent="v1" begin="00:22.551" end="00:24.372">You say that you hate me</p><p ttm:agent="v1" begin="00:24.372" end="00:27.375">But tell me shit nobody knows</p><p ttm:agent="v1" begin="00:27.375" end="00:29.136" /><p ttm:agent="v1" begin="00:29.136" end="00:32.434">Yeah, you're beautiful, don't have to try</p><p ttm:agent="v1" begin="00:32.434" end="00:35.306">Darling, you look divine</p><p ttm:agent="v1" begin="00:35.306" end="00:36.806" /><p ttm:agent="v1" begin="00:35.505" end="00:38.860">Eyes don't lie</p><p ttm:agent="v1" begin="00:38.860" end="00:42.037">Eyes don't lie</p><p ttm:agent="v1" begin="00:42.037" end="00:45.536">Say you're mine</p><p ttm:agent="v1" begin="00:45.536" end="00:47.916">Eyes don't lie</p><p ttm:agent="v1" begin="00:47.916" end="00:49.416" /><p ttm:agent="v1" begin="00:49.107" end="00:50.780">You tell me your secrets</p><p ttm:agent="v1" begin="00:50.780" end="00:55.564">You keep your life between your lips</p><p ttm:agent="v1" begin="00:55.564" end="00:57.310">You know you're my weakness</p><p ttm:agent="v1" begin="00:57.310" end="01:00.623">Tell stories with your fingertips</p><p ttm:agent="v1" begin="01:00.623" end="01:02.220" /><p ttm:agent="v1" begin="01:02.220" end="01:05.513">Yeah, you're beautiful, don't have to try</p><p ttm:agent="v1" begin="01:05.513" end="01:08.481">Darling, you look divine</p><p ttm:agent="v1" begin="01:08.481" end="01:09.981" /><p ttm:agent="v1" begin="01:08.606" end="01:11.891">Eyes don't lie</p><p ttm:agent="v1" begin="01:11.891" end="01:15.144">Eyes don't lie</p><p ttm:agent="v1" begin="01:15.144" end="01:18.424">Say you're mine</p><p ttm:agent="v1" begin="01:18.424" end="01:21.043">Eyes don't lie</p><p ttm:agent="v1" begin="01:21.043" end="01:22.543" /><p ttm:agent="v1" begin="01:22.350" end="01:25.911">I swear friends don't get this close</p><p ttm:agent="v1" begin="01:25.911" end="01:29.123">Pull you on exchanging souls</p><p ttm:agent="v1" begin="01:29.123" end="01:33.005">Trace my skin losing control</p><p ttm:agent="v1" begin="01:33.005" end="01:35.130" /><p ttm:agent="v1" begin="01:35.130" end="01:38.500" itunes:key="role" itunes:value="background">(Eyes don't lie)</p><p ttm:agent="v1" begin="01:38.500" end="01:41.790" itunes:key="role" itunes:value="background">(Eyes don't lie)</p><p ttm:agent="v1" begin="01:41.790" end="01:45.165" itunes:key="role" itunes:value="background">(Say you're mine)</p><p ttm:agent="v1" begin="01:45.165" end="01:47.526" itunes:key="role" itunes:value="background">(Eyes don't lie)</p><p ttm:agent="v1" begin="01:47.526" end="01:49.026" /><p ttm:agent="v1" begin="01:48.399" end="01:51.685">Eyes don't lie</p><p ttm:agent="v1" begin="01:51.685" end="01:54.905">Eyes don't lie</p><p ttm:agent="v1" begin="01:54.905" end="01:58.239">Say you're mine</p><p ttm:agent="v1" begin="01:58.239" end="02:02.239">Eyes don't lie</p></div></body></tt>