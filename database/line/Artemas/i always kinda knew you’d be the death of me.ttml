<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>i always kinda knew you’d be the death of me</ttm:title><ttm:agent type="person" xml:id="v1">Artemas</ttm:agent><ttm:item type="album">yustyna</ttm:item><ttm:item type="spotify_id">3iUDHA6FGAKfHX2jmgF0vO</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:01.640" end="00:04.530" itunes:key="role" itunes:value="background">(Yeah, yeah)</p><p ttm:agent="v1" begin="00:04.530" end="00:08.710">I always kinda knew you'd be the death of me</p><p ttm:agent="v1" begin="00:08.710" end="00:11.360">Oh, honey, I know (yeah)</p><p ttm:agent="v1" begin="00:11.360" end="00:14.160">Oh, honey, I know (yeah)</p><p ttm:agent="v1" begin="00:14.160" end="00:18.650">I always kinda knew you'd see the light of the day</p><p ttm:agent="v1" begin="00:18.650" end="00:21.210">You say you've outgrown (yeah)</p><p ttm:agent="v1" begin="00:21.210" end="00:24.370">Oh, honey, I know (yeah, here it goes again)</p><p ttm:agent="v1" begin="00:24.370" end="00:28.620">I always kinda knew that, girl, eventually</p><p ttm:agent="v1" begin="00:28.620" end="00:31.190">You'd come for my throat (yeah)</p><p ttm:agent="v1" begin="00:31.190" end="00:33.940">Knife at my throat (yeah, it's true)</p><p ttm:agent="v1" begin="00:33.940" end="00:38.520">I always kinda knew you'd be the death of me</p><p ttm:agent="v1" begin="00:38.520" end="00:41.070">Oh, honey, I know (yeah)</p><p ttm:agent="v1" begin="00:41.070" end="00:43.090">Oh, honey, I know (yeah)</p><p ttm:agent="v1" begin="00:43.090" end="00:47.200">Here it goes again, again</p><p ttm:agent="v1" begin="00:47.200" end="00:52.810">The misery extends again</p><p ttm:agent="v1" begin="00:52.810" end="00:57.620">Here it goes again, again</p><p ttm:agent="v1" begin="00:57.620" end="01:03.620">The misery extends again</p><p ttm:agent="v1" begin="01:03.620" end="01:06.510">I alway kinda knew you'd leave</p><p ttm:agent="v1" begin="01:06.510" end="01:10.590">Knew you'd turn away from me, I know</p><p ttm:agent="v1" begin="01:10.590" end="01:13.570">Oh, honey, I know</p><p ttm:agent="v1" begin="01:13.570" end="01:17.760">I always kinda knew you'd be the death of me</p><p ttm:agent="v1" begin="01:17.760" end="01:20.550">Oh, honey, I know (whoa)</p><p ttm:agent="v1" begin="01:20.550" end="01:23.210">Oh, honey, I know (yeah)</p><p ttm:agent="v1" begin="01:23.210" end="01:25.170">And I'ma lucky man</p><p ttm:agent="v1" begin="01:25.170" end="01:27.710">You're lovely, girl</p><p ttm:agent="v1" begin="01:27.710" end="01:30.020">You're better than me</p><p ttm:agent="v1" begin="01:30.020" end="01:32.240">And you can go to hell</p><p ttm:agent="v1" begin="01:32.240" end="01:37.040">Here it goes again, again</p><p ttm:agent="v1" begin="01:37.040" end="01:42.110">The misery extends again</p><p ttm:agent="v1" begin="01:42.110" end="01:46.750">Here it goes again, again</p><p ttm:agent="v1" begin="01:46.750" end="01:52.680">The misery extends again</p><p ttm:agent="v1" begin="01:52.680" end="01:54.830">And I'ma lucky man</p><p ttm:agent="v1" begin="01:54.830" end="01:57.760">You're lovely, girl</p><p ttm:agent="v1" begin="01:57.760" end="01:59.550">You're better than me</p><p ttm:agent="v1" begin="01:59.550" end="02:02.090">And you can go to hell</p><p ttm:agent="v1" begin="02:02.090" end="02:04.920">Here it goes again</p><p ttm:agent="v1" begin="02:04.920" end="02:09.760" itunes:key="role" itunes:value="background">(Yeah, yeah)</p><p ttm:agent="v1" begin="02:09.760" end="02:12.770" itunes:key="role" itunes:value="background">(Yeah, yeah)</p><p ttm:agent="v1" begin="02:12.770" end="02:16.770" /></div></body></tt>