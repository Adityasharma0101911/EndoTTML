<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>love is a knife</ttm:title><ttm:agent type="person" xml:id="v1">Artemas</ttm:agent><ttm:item type="album">LOVERCORE</ttm:item><ttm:item type="spotify_id">6TnCfFPnHT6Zy1a0mo9zam</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:14.481" end="00:17.102">Oh, love is a knife</p><p ttm:agent="v1" begin="00:17.102" end="00:20.827">Open my heart for the very last time</p><p ttm:agent="v1" begin="00:20.827" end="00:24.429">You don't love me anymore</p><p ttm:agent="v1" begin="00:24.429" end="00:28.976">You don't want me anymore</p><p ttm:agent="v1" begin="00:28.976" end="00:31.693">Oh, where is my mind?</p><p ttm:agent="v1" begin="00:31.693" end="00:35.445">Drowning in liquor, do you dare me to drive?</p><p ttm:agent="v1" begin="00:35.445" end="00:38.999">You don't love me anymore</p><p ttm:agent="v1" begin="00:38.999" end="00:43.588">You don't want me anymore</p><p ttm:agent="v1" begin="00:43.588" end="00:47.199">I don't wanna talk about it</p><p ttm:agent="v1" begin="00:47.199" end="00:50.783">I don't wanna think about it</p><p ttm:agent="v1" begin="00:50.783" end="00:54.514">I would rather go to her than</p><p ttm:agent="v1" begin="00:54.514" end="00:58.088">Have to live a life without you</p><p ttm:agent="v1" begin="00:58.088" end="01:01.069">Word of advice</p><p ttm:agent="v1" begin="01:01.069" end="01:04.886">You should run for your life</p><p ttm:agent="v1" begin="01:04.886" end="01:08.481">You should run for the hills</p><p ttm:agent="v1" begin="01:08.481" end="01:12.757">Into the night</p><p ttm:agent="v1" begin="01:12.757" end="01:15.276">Oh, love is a knife</p><p ttm:agent="v1" begin="01:15.276" end="01:19.004">Open my heart for the very last time</p><p ttm:agent="v1" begin="01:19.004" end="01:22.740">You don't love me anymore</p><p ttm:agent="v1" begin="01:22.740" end="01:27.183">You don't want me anymore</p><p ttm:agent="v1" begin="01:27.183" end="01:29.855">Oh, where is my mind?</p><p ttm:agent="v1" begin="01:29.855" end="01:33.546">Drowning in liquor, do you dare me to drive?</p><p ttm:agent="v1" begin="01:33.546" end="01:37.076">You don't love me anymore</p><p ttm:agent="v1" begin="01:37.076" end="01:41.782">You don't want me anymore</p><p ttm:agent="v1" begin="01:41.782" end="01:45.227">I don't ask for much</p><p ttm:agent="v1" begin="01:45.227" end="01:48.920">Just the air you breathe</p><p ttm:agent="v1" begin="01:48.920" end="01:52.406">Take a loaded gun</p><p ttm:agent="v1" begin="01:52.406" end="01:56.256">And point and shoot at me</p><p ttm:agent="v1" begin="01:56.256" end="01:58.904">Oh, love is a knife</p><p ttm:agent="v1" begin="01:58.904" end="02:02.631">Open my heart for the very last time</p><p ttm:agent="v1" begin="02:02.631" end="02:06.042">You don't love me anymore</p><p ttm:agent="v1" begin="02:06.042" end="02:10.770">You don't want me anymore</p><p ttm:agent="v1" begin="02:10.770" end="02:13.484">Oh, where is my mind?</p><p ttm:agent="v1" begin="02:13.484" end="02:17.247">Drowning in liquor, do you dare me to drive?</p><p ttm:agent="v1" begin="02:17.247" end="02:20.780">You don't love me anymore</p><p ttm:agent="v1" begin="02:20.780" end="02:24.780">You don't want me anymore</p></div></body></tt>