<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Taste (Speed)</ttm:title><ttm:agent type="person" xml:id="v1">Ari Abdul</ttm:agent><ttm:item type="album">Fallen Angel (Speed)</ttm:item><ttm:item type="spotify_id">1rQVCKl8I66BXhIhiAlHmK</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.450" end="00:04.350">I want a taste of you you you you you</p><p ttm:agent="v1" begin="00:04.350" end="00:06.090">You you you</p><p ttm:agent="v1" begin="00:06.090" end="00:09.970">Baby I'd burn this world for you</p><p ttm:agent="v1" begin="00:09.970" end="00:12.390">And if you leave I'm coming too</p><p ttm:agent="v1" begin="00:12.390" end="00:13.890">Oh oh oh</p><p ttm:agent="v1" begin="00:13.850" end="00:18.040">You feel so cold I'm turning blue</p><p ttm:agent="v1" begin="00:18.040" end="00:20.220">Where'd you go I wish I knew</p><p ttm:agent="v1" begin="00:20.220" end="00:21.720">Oh oh oh</p><p ttm:agent="v1" begin="00:21.230" end="00:23.090">Come close</p><p ttm:agent="v1" begin="00:23.090" end="00:27.420">Want you to take my soul</p><p ttm:agent="v1" begin="00:27.420" end="00:31.270">I want a taste of you</p><p ttm:agent="v1" begin="00:31.270" end="00:35.130">You tear my heart in two</p><p ttm:agent="v1" begin="00:35.130" end="00:39.180">Why do I waste my youth</p><p ttm:agent="v1" begin="00:39.180" end="00:44.980">Come back I always do</p><p ttm:agent="v1" begin="00:44.980" end="00:48.680">I hear you whispering my name</p><p ttm:agent="v1" begin="00:48.680" end="00:51.210">You're moving on but I can't change</p><p ttm:agent="v1" begin="00:51.210" end="00:52.710">Oh oh</p><p ttm:agent="v1" begin="00:52.450" end="00:56.660">It feels intoxicating</p><p ttm:agent="v1" begin="00:56.660" end="00:58.910">When you look at me that way</p><p ttm:agent="v1" begin="00:58.910" end="01:00.410">Oh oh</p><p ttm:agent="v1" begin="00:59.830" end="01:01.770">Come close</p><p ttm:agent="v1" begin="01:01.770" end="01:06.170">Want you to take my soul</p><p ttm:agent="v1" begin="01:06.170" end="01:10.010">I want a taste of you</p><p ttm:agent="v1" begin="01:10.010" end="01:13.790">You tear my heart in two</p><p ttm:agent="v1" begin="01:13.790" end="01:17.910">Why do I waste my youth</p><p ttm:agent="v1" begin="01:17.910" end="01:25.910">Come back I always do</p><p ttm:agent="v1" begin="01:38.480" end="01:41.940">I'm begging you untie this noose</p><p ttm:agent="v1" begin="01:41.940" end="01:46.050">Want your hands 'round my neck</p><p ttm:agent="v1" begin="01:46.050" end="01:49.600">I'm begging you come be my muse</p><p ttm:agent="v1" begin="01:49.600" end="01:52.630">You're all that I have left</p><p ttm:agent="v1" begin="01:52.630" end="01:56.460">I want a taste of you</p><p ttm:agent="v1" begin="01:56.460" end="02:00.250">You tear my heart in two</p><p ttm:agent="v1" begin="02:00.250" end="02:04.140">Why do I waste my youth</p><p ttm:agent="v1" begin="02:04.140" end="02:08.080">Come back I always do</p><p ttm:agent="v1" begin="02:08.080" end="02:11.850">I want a taste of you</p><p ttm:agent="v1" begin="02:11.850" end="02:15.770">You tear my heart in two</p><p ttm:agent="v1" begin="02:15.770" end="02:19.600">Why do I waste my youth</p><p ttm:agent="v1" begin="02:19.600" end="02:23.600">Come back I always do</p></div></body></tt>