<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>High Waters</ttm:title><ttm:agent type="person" xml:id="v1">Royal Blood</ttm:agent><ttm:item type="album">Back To The Water Below (Bonus Edition)</ttm:item><ttm:item type="spotify_id">5S8aZ2NSJ96UsHF2JYvuea</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:20.730" end="00:23.340">The dogs are coming for my throat</p><p ttm:agent="v1" begin="00:23.340" end="00:25.010">Coast to coast I'm rushing</p><p ttm:agent="v1" begin="00:25.010" end="00:26.510" /><p ttm:agent="v1" begin="00:25.590" end="00:27.900">God knows I'm gonna need something</p><p ttm:agent="v1" begin="00:27.900" end="00:30.500">Someone to tell me out the smoke</p><p ttm:agent="v1" begin="00:30.500" end="00:32.050">Before I choke</p><p ttm:agent="v1" begin="00:32.050" end="00:34.240">On counterfeit any</p><p ttm:agent="v1" begin="00:34.240" end="00:35.740" /><p ttm:agent="v1" begin="00:35.460" end="00:38.660">Deep diving can't wash it off my skin</p><p ttm:agent="v1" begin="00:38.660" end="00:40.340">Caving just keeping my</p><p ttm:agent="v1" begin="00:40.340" end="00:43.270">Head on high waters</p><p ttm:agent="v1" begin="00:43.270" end="00:45.840">Down and down in the dust</p><p ttm:agent="v1" begin="00:45.840" end="00:48.130">Know it's never enough</p><p ttm:agent="v1" begin="00:48.130" end="00:50.480">'Fore it's just a little too</p><p ttm:agent="v1" begin="00:50.480" end="00:52.660">Late goin' under</p><p ttm:agent="v1" begin="00:52.660" end="00:54.160" /><p ttm:agent="v1" begin="00:53.490" end="00:55.620">Goin' out in the sun</p><p ttm:agent="v1" begin="00:55.620" end="00:57.970">Can't keep my head on high waters</p><p ttm:agent="v1" begin="00:57.970" end="00:59.470" /><p ttm:agent="v1" begin="00:58.480" end="01:00.020">I'm low just come</p><p ttm:agent="v1" begin="01:00.020" end="01:03.440">Waters waters waters</p><p ttm:agent="v1" begin="01:03.440" end="01:05.120">Keep my head on high</p><p ttm:agent="v1" begin="01:05.120" end="01:08.320">Waters waters waters</p><p ttm:agent="v1" begin="01:08.320" end="01:09.880">Keep my head on high</p><p ttm:agent="v1" begin="01:09.880" end="01:11.380" /><p ttm:agent="v1" begin="01:10.630" end="01:13.430">The traps are closing and I toast</p><p ttm:agent="v1" begin="01:13.430" end="01:15.510">Half a float I'm breaking</p><p ttm:agent="v1" begin="01:15.510" end="01:18.050">God knows I'm gonna need saving</p><p ttm:agent="v1" begin="01:18.050" end="01:20.470">Someone to drag me out of Hell</p><p ttm:agent="v1" begin="01:20.470" end="01:21.970" /><p ttm:agent="v1" begin="01:21.040" end="01:23.420">To the shadows to the swirl</p><p ttm:agent="v1" begin="01:23.420" end="01:25.420" /><p ttm:agent="v1" begin="01:25.420" end="01:28.640">Deep diving can't wash it off my skin</p><p ttm:agent="v1" begin="01:28.640" end="01:30.480">Waving just keeping my</p><p ttm:agent="v1" begin="01:30.480" end="01:32.630">Head on high waters</p><p ttm:agent="v1" begin="01:32.630" end="01:34.130" /><p ttm:agent="v1" begin="01:33.260" end="01:35.830">Down and down in the dust</p><p ttm:agent="v1" begin="01:35.830" end="01:38.220">Know it's never enough</p><p ttm:agent="v1" begin="01:38.220" end="01:40.490">'Fore it's just a little too</p><p ttm:agent="v1" begin="01:40.490" end="01:43.050">Late goin' under</p><p ttm:agent="v1" begin="01:43.050" end="01:45.580">Goin' out in the sun</p><p ttm:agent="v1" begin="01:45.580" end="01:48.490">Can't keep my head on high waters</p><p ttm:agent="v1" begin="01:48.490" end="01:50.540">I'm low just come</p><p ttm:agent="v1" begin="01:50.540" end="01:53.590" /><p ttm:agent="v1" begin="01:53.590" end="01:56.110">I'm low just come in</p><p ttm:agent="v1" begin="01:56.110" end="02:04.110" /><p ttm:agent="v1" begin="02:09.550" end="02:12.750">Just keeping my head on high waters</p><p ttm:agent="v1" begin="02:12.750" end="02:14.250" /><p ttm:agent="v1" begin="02:13.440" end="02:15.860">Down and down in the dust</p><p ttm:agent="v1" begin="02:15.860" end="02:18.210">Know it's never enough</p><p ttm:agent="v1" begin="02:18.210" end="02:20.400">'Fore it's just a little too</p><p ttm:agent="v1" begin="02:20.400" end="02:22.680">Late goin' under</p><p ttm:agent="v1" begin="02:22.680" end="02:24.180" /><p ttm:agent="v1" begin="02:23.370" end="02:25.790">Goin' out in the sun</p><p ttm:agent="v1" begin="02:25.790" end="02:28.480">Can't keep my head on high waters</p><p ttm:agent="v1" begin="02:28.480" end="02:30.640">I'm low just come</p><p ttm:agent="v1" begin="02:30.640" end="02:33.840">Waters waters waters</p><p ttm:agent="v1" begin="02:33.840" end="02:35.340">Keep my head on high</p><p ttm:agent="v1" begin="02:35.040" end="02:36.540">I'm low just come in</p><p ttm:agent="v1" begin="02:36.130" end="02:38.320">Waters waters waters</p><p ttm:agent="v1" begin="02:38.320" end="02:42.320">Keep my head on high</p></div></body></tt>