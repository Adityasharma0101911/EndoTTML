      <p begin="03:16.310" end="03:18.130" ttm:agent="v1"/>
      <p begin="03:18.130" end="03:19.630" ttm:agent="v1" itunes:key="role" itunes:value="background">(One)</p>
      <p begin="03:19.220" end="03:21.060" ttm:agent="v1" itunes:key="role" itunes:value="background">(What the)</p>
      <p begin="03:21.060" end="03:22.560" ttm:agent="v1"/>
      <p begin="03:22.540" end="03:25.830" ttm:agent="v1" itunes:key="role" itunes:value="background">(What the... was that?)</p>
      <p begin="03:25.830" end="03:28.350" ttm:agent="v1">You're unbelievable</p>
