<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Aquamarine</ttm:title><ttm:agent type="person" xml:id="v1">Addison Rae</ttm:agent><ttm:item type="album">Addison</ttm:item><ttm:item type="spotify_id">3kDO0ttXrVCWbKCS3sQeC1</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:04.490" end="00:07.600">Aquamarine</p><p ttm:agent="v1" begin="00:07.600" end="00:11.790">Honey dive into me</p><p ttm:agent="v1" begin="00:11.790" end="00:16.310">I’m not hiding, anymore</p><p ttm:agent="v1" begin="00:16.310" end="00:22.140">I won’t hide</p><p ttm:agent="v1" begin="00:22.140" end="00:24.620">The world is my oyster</p><p ttm:agent="v1" begin="00:24.620" end="00:31.050">Baby come touch the pearl</p><p ttm:agent="v1" begin="00:31.050" end="00:33.130">The world is my oyster</p><p ttm:agent="v1" begin="00:33.130" end="00:39.670">And I’m the only girl</p><p ttm:agent="v1" begin="00:39.670" end="00:43.900">I’m dancing in my own reflection</p><p ttm:agent="v1" begin="00:43.900" end="00:48.180">I’m the ray of light</p><p ttm:agent="v1" begin="00:48.180" end="00:52.400">I’m transforming and realigning</p><p ttm:agent="v1" begin="00:52.400" end="00:55.960">I’ll take you with me h-h-h-h-high</p><p ttm:agent="v1" begin="00:55.960" end="00:58.930">Aquamarine</p><p ttm:agent="v1" begin="00:58.930" end="01:03.190">Honey dive into me</p><p ttm:agent="v1" begin="01:03.190" end="01:07.690">I’m not hiding, anymore</p><p ttm:agent="v1" begin="01:07.690" end="01:12.860">I won’t hide</p><p ttm:agent="v1" begin="01:12.860" end="01:17.360">I’m free</p><p ttm:agent="v1" begin="01:17.360" end="01:19.780">Swimming in the sea with the salt in my hair</p><p ttm:agent="v1" begin="01:19.780" end="01:21.710">Kissed by the sun it’s a love affair</p><p ttm:agent="v1" begin="01:21.710" end="01:23.650">Heart of the ocean around my neck</p><p ttm:agent="v1" begin="01:23.650" end="01:25.150">Don’t have to say it</p><p ttm:agent="v1" begin="01:24.750" end="01:26.500">You know what’s next</p><p ttm:agent="v1" begin="01:26.500" end="01:30.960">I’m transforming and realigning</p><p ttm:agent="v1" begin="01:30.960" end="01:38.960">I’ll take you with me h-h-h-high</p><p ttm:agent="v1" begin="01:41.890" end="01:46.200">Give me more</p><p ttm:agent="v1" begin="01:46.200" end="01:50.650">Give me more</p><p ttm:agent="v1" begin="01:50.650" end="01:54.700">Give me more</p><p ttm:agent="v1" begin="01:54.700" end="01:59.260">Give me more</p><p ttm:agent="v1" begin="01:59.260" end="02:00.760">Give me</p><p ttm:agent="v1" begin="02:00.260" end="02:03.270">Aquamarine</p><p ttm:agent="v1" begin="02:03.270" end="02:07.500">Honey dive into me</p><p ttm:agent="v1" begin="02:07.500" end="02:11.930">I’m not hiding, anymore</p><p ttm:agent="v1" begin="02:11.930" end="02:17.280">I won’t hide</p><p ttm:agent="v1" begin="02:17.280" end="02:20.450">Aquamarine</p><p ttm:agent="v1" begin="02:20.450" end="02:24.630">Honey dive into me</p><p ttm:agent="v1" begin="02:24.630" end="02:29.080">I’m not hiding, anymore</p><p ttm:agent="v1" begin="02:29.080" end="02:33.970">I won’t hide</p><p ttm:agent="v1" begin="02:33.970" end="02:37.970">I’m free</p></div></body></tt>