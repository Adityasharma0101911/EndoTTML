<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Creep - from "The Book of Life" Soundtrack</ttm:title><ttm:agent type="person" xml:id="v1">Albert Hammond</ttm:agent><ttm:agent type="person" xml:id="v2">Michael Hazlewood</ttm:agent><ttm:agent type="person" xml:id="v3">Colin Greenwood</ttm:agent><ttm:agent type="person" xml:id="v4">Jonathan Greenwood</ttm:agent><ttm:agent type="person" xml:id="v5">Philip Selway</ttm:agent><ttm:agent type="person" xml:id="v6">Thomas Yorke</ttm:agent><ttm:agent type="person" xml:id="v7">Edward O'Brien</ttm:agent><ttm:agent type="person" xml:id="v8">Diego Luna</ttm:agent><ttm:agent type="person" xml:id="v9">Gustavo Santaolalla</ttm:agent><ttm:item type="album">The Book of Life (Original Motion Picture Soundtrack)</ttm:item><ttm:item type="spotify_id">6Hrdertyam29E9LcljtfmW</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:19.480" end="00:22.030">Hay, Maria</p><p ttm:agent="v1" begin="00:22.030" end="00:24.230">When you were here before</p><p ttm:agent="v1" begin="00:24.230" end="00:26.720" /><p ttm:agent="v1" begin="00:26.720" end="00:31.540">Couldn't look you in the eye</p><p ttm:agent="v1" begin="00:31.540" end="00:36.800">You're just like an angel</p><p ttm:agent="v1" begin="00:36.800" end="00:42.280">Your skin makes me cry</p><p ttm:agent="v1" begin="00:42.280" end="00:50.280">But I'm a creep, I'm a weirdo</p><p ttm:agent="v1" begin="00:52.770" end="00:57.920">What am I doing here?</p><p ttm:agent="v1" begin="00:57.920" end="01:03.330">I don't belong here</p><p ttm:agent="v1" begin="01:03.330" end="01:07.290">I don't belong</p><p ttm:agent="v1" begin="01:07.290" end="01:11.290" /></div></body></tt>