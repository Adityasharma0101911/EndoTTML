<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Astronaut Song</ttm:title>
      <ttm:agent type="person" xml:id="v1">jomm</ttm:agent>
      <ttm:agent type="person" xml:id="v2">readyaimfire27</ttm:agent>
      <ttm:item type="album">Astronaut Song</ttm:item>
      <ttm:item type="spotify_id">3X6Td9MHihqUIlcsONRvLJ</ttm:item>
      <itunes:duration>03:08.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:03.980" end="00:11.980" ttm:agent="v1">Oh I'll try to find a way to the moon</p>
      <p begin="00:12.720" end="00:20.720" ttm:agent="v1">Like shooting stars we fall in love</p>
      <p begin="00:21.950" end="00:29.950" ttm:agent="v1">But I will find you someday somehow</p>
      <p begin="00:30.060" end="00:38.060" ttm:agent="v1">So wait for me darling I love you so</p>
      <p begin="00:39.110" end="00:46.450" ttm:agent="v1">I wonder when you look at me do you see the stars and galaxies</p>
      <p begin="00:46.450" end="00:52.850" ttm:agent="v1">Aurora skies your eyes they make me want to fly so high</p>
      <p begin="00:52.850" end="00:56.930" ttm:agent="v1">Saying goodbye's the hardest part</p>
      <p begin="00:56.930" end="00:59.980" ttm:agent="v1">I don't wanna go and break your heart</p>
      <p begin="00:59.980" end="01:06.740" ttm:agent="v1">I wish that i could stay just one more night with you</p>
      <p begin="01:06.740" end="01:14.090" ttm:agent="v1">But I'll try to find a way to the moon</p>
      <p begin="01:14.090" end="01:21.430" ttm:agent="v1">Like shooting stars we fall in love</p>
      <p begin="01:21.430" end="01:28.140" ttm:agent="v1">But I will find you someday somehow</p>
      <p begin="01:28.140" end="01:36.140" ttm:agent="v1">So wait for me darling I love you so</p>
      <p begin="02:02.980" end="02:05.850" ttm:agent="v1">But do you feel it like I do</p>
      <p begin="02:05.850" end="02:09.640" ttm:agent="v1">Are you the sunlight to my moon</p>
      <p begin="02:09.640" end="02:16.530" ttm:agent="v1">And when we're older would you stay right by my side all night</p>
      <p begin="02:16.530" end="02:23.680" ttm:agent="v1">And tell me if we're meant to be tell me why I cry myself to sleep</p>
      <p begin="02:23.680" end="02:30.450" ttm:agent="v1">You say you'd fly a thousands light years just for me</p>
      <p begin="02:30.450" end="02:37.750" ttm:agent="v1">But I'll try to find a way to the moon</p>
      <p begin="02:37.750" end="02:45.270" ttm:agent="v1">Like shooting stars we fall in love</p>
      <p begin="02:45.270" end="02:51.720" ttm:agent="v1">But I will find you someday somehow</p>
      <p begin="02:51.720" end="02:54.910" ttm:agent="v1">So wait for me darling</p>
      <p begin="02:54.910" end="02:58.710" ttm:agent="v1">Like a comet I'm falling</p>
      <p begin="02:58.710" end="03:01.740" ttm:agent="v1">So wait for me darling</p>
      <p begin="03:01.740" end="03:04.660" ttm:agent="v1">I love you so</p>
      <p begin="03:04.660" end="03:08.660" ttm:agent="v1"/>
    </div>
  </body>
</tt>
