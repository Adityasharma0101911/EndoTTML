<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Dial 143</ttm:title>
      <ttm:agent type="person" xml:id="v1">jomm</ttm:agent>
      <ttm:agent type="person" xml:id="v2">readyaimfire27</ttm:agent>
      <ttm:item type="album">Dial 143</ttm:item>
      <ttm:item type="spotify_id">53U4TXdEBFtRe9VS2U43FQ</ttm:item>
      <itunes:duration>03:38.500</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:21.490" end="00:28.580" ttm:agent="v1">Memorized every smile, every glance, every hi</p>
      <p begin="00:28.580" end="00:34.420" ttm:agent="v1">Giving you all my time, cos you make it alright</p>
      <p begin="00:34.420" end="00:36.920" ttm:agent="v1">Cos something's on my chest</p>
      <p begin="00:36.920" end="00:40.490" ttm:agent="v1">I wish that I said, it's all in my head</p>
      <p begin="00:40.490" end="00:44.080" ttm:agent="v1">I think I'm in love, I, I don't know yet</p>
      <p begin="00:44.080" end="00:48.000" ttm:agent="v1">I'm losing my mind, it's you all the time</p>
      <p begin="00:48.000" end="00:49.900" ttm:agent="v1">Only you</p>
      <p begin="00:49.900" end="00:52.460" ttm:agent="v1">Dial one, to the four, to the three</p>
      <p begin="00:52.460" end="00:55.130" ttm:agent="v1">That's my heart on the tone</p>
      <p begin="00:55.130" end="00:57.860" ttm:agent="v1">Anytime, cos I want you to know</p>
      <p begin="00:57.860" end="01:02.120" ttm:agent="v1">That I might be in love and I just wanna know</p>
      <p begin="01:02.120" end="01:04.960" ttm:agent="v1">If you like me or if I should just go</p>
      <p begin="01:04.960" end="01:07.950" ttm:agent="v1">Oh one day, you'll say that it was fate</p>
      <p begin="01:07.950" end="01:10.680" ttm:agent="v1">And that we were meant to be</p>
      <p begin="01:10.680" end="01:13.880" ttm:agent="v1">So dial one, to the four, to the three</p>
      <p begin="01:13.880" end="01:18.460" ttm:agent="v1">And I'll pick up the phone, you know my tone</p>
      <p begin="01:18.460" end="01:21.670" ttm:agent="v1">I don't know what to do</p>
      <p begin="01:21.670" end="01:24.760" ttm:agent="v1">What to say, cos it's you</p>
      <p begin="01:24.760" end="01:26.260" ttm:agent="v1">Losing sleep</p>
      <p begin="01:26.120" end="01:27.620" ttm:agent="v1">Over you</p>
      <p begin="01:27.110" end="01:28.610" ttm:agent="v1">Every night</p>
      <p begin="01:28.050" end="01:29.550" ttm:agent="v1">All the time</p>
      <p begin="01:28.940" end="01:30.440" ttm:agent="v1">Overthink</p>
      <p begin="01:29.980" end="01:31.480" ttm:agent="v1">On my mind</p>
      <p begin="01:30.750" end="01:32.250" ttm:agent="v1">My reply</p>
      <p begin="01:31.990" end="01:33.490" ttm:agent="v1">Cos something's on my chest</p>
      <p begin="01:33.120" end="01:37.380" ttm:agent="v1">I wish that I said, it's all in my head</p>
      <p begin="01:37.380" end="01:40.830" ttm:agent="v1">I think I'm in love, I, I don't know yet</p>
      <p begin="01:40.830" end="01:44.880" ttm:agent="v1">I'm losing my mind, it's you all the time</p>
      <p begin="01:44.880" end="01:46.850" ttm:agent="v1">Only you</p>
      <p begin="01:46.850" end="01:49.330" ttm:agent="v1">Dial one, to the four, to the three</p>
      <p begin="01:49.330" end="01:52.070" ttm:agent="v1">That's my heart on the tone</p>
      <p begin="01:52.070" end="01:54.670" ttm:agent="v1">Anytime, cos I want you to know</p>
      <p begin="01:54.670" end="01:58.050" ttm:agent="v1">That I might be in love and I just wanna know</p>
      <p begin="01:58.050" end="02:01.560" ttm:agent="v1">If you like me or if I should just go</p>
      <p begin="02:01.560" end="02:04.660" ttm:agent="v1">Oh one day, you'll say that it was fate</p>
      <p begin="02:04.660" end="02:07.350" ttm:agent="v1">And that we were meant to be</p>
      <p begin="02:07.350" end="02:11.360" ttm:agent="v1">So dial one, to the four, to the three</p>
      <p begin="02:11.360" end="02:19.360" ttm:agent="v1">And I'll pick up the phone, you know my tone</p>
      <p begin="02:43.520" end="02:46.290" ttm:agent="v1">Dial one, to the four, to the three</p>
      <p begin="02:46.290" end="02:48.930" ttm:agent="v1">That's my heart on the tone</p>
      <p begin="02:48.930" end="02:51.650" ttm:agent="v1">Anytime, cos I want you to know</p>
      <p begin="02:51.650" end="02:55.840" ttm:agent="v1">That I might be in love and I just wanna know</p>
      <p begin="02:55.840" end="02:58.680" ttm:agent="v1">If you like me or if I should just go</p>
      <p begin="02:58.680" end="03:01.630" ttm:agent="v1">Oh one day, you'll say that it was fate</p>
      <p begin="03:01.630" end="03:04.520" ttm:agent="v1">And that we were meant to be</p>
      <p begin="03:04.520" end="03:07.640" ttm:agent="v1">So dial one, to the four, to the three</p>
      <p begin="03:07.640" end="03:12.300" ttm:agent="v1">And I'll pick up the phone, you know my tone</p>
      <p begin="03:12.300" end="03:19.280" ttm:agent="v1">I'm makin' up reasons to call you, to see you</p>
      <p begin="03:19.280" end="03:25.970" ttm:agent="v1">Rehearsing my lines to a mirror got me blushing</p>
      <p begin="03:25.970" end="03:33.970" ttm:agent="v1">Cos of you, only you, cos it's you</p>
      <p begin="03:36.620" end="03:40.620" ttm:agent="v1"/>
    </div>
  </body>
</tt>
