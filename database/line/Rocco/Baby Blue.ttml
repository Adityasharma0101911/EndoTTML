<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Baby Blue</ttm:title>
      <ttm:agent type="person" xml:id="v1">Rocco</ttm:agent>
      <ttm:item type="album">Baby Blue</ttm:item>
      <ttm:item type="spotify_id">0Sc2BfHM8q8WIWlq9SeFcZ</ttm:item>
      <itunes:duration>02:51.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:11.260" end="00:19.260" ttm:agent="v1">Somewhere, someplace in the distance</p>
      <p begin="00:20.740" end="00:25.820" ttm:agent="v1">Transcending time and space</p>
      <p begin="00:25.820" end="00:29.410" ttm:agent="v1">There's this things they call love</p>
      <p begin="00:29.410" end="00:32.530" ttm:agent="v1">And I feel you got my touch</p>
      <p begin="00:32.530" end="00:38.840" ttm:agent="v1">I never thought that I could feel this way</p>
      <p begin="00:38.840" end="00:42.440" ttm:agent="v1">But when your lips press on mine</p>
      <p begin="00:42.440" end="00:46.070" ttm:agent="v1">There's not much that'll change my mind</p>
      <p begin="00:46.070" end="00:52.200" ttm:agent="v1">It's you that I'm looking for, all my life</p>
      <p begin="00:52.200" end="00:55.770" ttm:agent="v1">Under the sheets, well intertwine</p>
      <p begin="00:55.770" end="00:59.160" ttm:agent="v1">I'll say once, oh, I'll say it twice</p>
      <p begin="00:59.160" end="01:07.160" ttm:agent="v1">I love you, my baby blue</p>
      <p begin="01:08.540" end="01:11.000" ttm:agent="v1">Bah, bah, bah, bah</p>
      <p begin="01:11.000" end="01:19.000" ttm:agent="v1" itunes:key="role" itunes:value="background">My baby blue (My baby blue)</p>
      <p begin="01:19.360" end="01:24.930" ttm:agent="v1">Love can do all kinds of things</p>
      <p begin="01:24.930" end="01:28.580" ttm:agent="v1">It'll eat you up and spit you out</p>
      <p begin="01:28.580" end="01:33.290" ttm:agent="v1">But still, you'll come back around for more</p>
      <p begin="01:33.290" end="01:38.300" ttm:agent="v1">I know this game's not for the weak</p>
      <p begin="01:38.300" end="01:41.570" ttm:agent="v1">It'll build you up, and break you down</p>
      <p begin="01:41.570" end="01:45.300" ttm:agent="v1">It'll tear you at the seams</p>
      <p begin="01:45.300" end="01:48.180" ttm:agent="v1">But when your lips press on mine</p>
      <p begin="01:48.180" end="01:51.660" ttm:agent="v1">There's not much that'll change my mind</p>
      <p begin="01:51.660" end="01:57.820" ttm:agent="v1">It's you that I'm looking for, all my life</p>
      <p begin="01:57.820" end="02:01.340" ttm:agent="v1">Under the sheets, well intertwine</p>
      <p begin="02:01.340" end="02:04.940" ttm:agent="v1">I'll say once, oh, I'll say it twice</p>
      <p begin="02:04.940" end="02:12.940" ttm:agent="v1">I love you, my baby blue, ooh</p>
      <p begin="02:14.240" end="02:16.950" ttm:agent="v1">Bah, bah, bah, bah</p>
      <p begin="02:16.950" end="02:24.430" ttm:agent="v1" itunes:key="role" itunes:value="background">My baby blue (My baby blue)</p>
      <p begin="02:24.430" end="02:28.430" ttm:agent="v1"/>
    </div>
  </body>
