<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Love Shine</ttm:title>
      <ttm:agent type="person" xml:id="v1">LEEHEESANG</ttm:agent>
      <ttm:item type="album">WHOEVER</ttm:item>
      <ttm:item type="spotify_id">467zSU1hr4OF3Zq5zVX3Dt</ttm:item>
      <itunes:duration>04:27.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:33.470" end="00:37.360" ttm:agent="v1">걱정하지 마</p>
      <p begin="00:37.360" end="00:41.530" ttm:agent="v1">우린 영원할 거잖아</p>
      <p begin="00:41.530" end="00:44.540" ttm:agent="v1">네 곁에 있으면</p>
      <p begin="00:44.540" end="00:49.440" ttm:agent="v1">언제나 환상 같아</p>
      <p begin="00:49.440" end="00:53.220" ttm:agent="v1">사라지지마</p>
      <p begin="00:53.220" end="00:57.370" ttm:agent="v1">서로가 미워진대도</p>
      <p begin="00:57.370" end="01:00.180" ttm:agent="v1">네 옆에 앉으면</p>
      <p begin="01:00.180" end="01:07.200" ttm:agent="v1">언제나 사랑이야</p>
      <p begin="01:07.200" end="01:15.140" ttm:agent="v1">결국 우린 변하고야 말겠지</p>
      <p begin="01:15.140" end="01:22.700" ttm:agent="v1">금세 사랑은 더 잊혀져가고</p>
      <p begin="01:22.700" end="01:27.670" ttm:agent="v1">영원할 거란 말에 끄덕이던</p>
      <p begin="01:27.670" end="01:35.670" ttm:agent="v1">그 시절 우리의 감정은 떠나가고 어디에</p>
      <p begin="01:39.160" end="01:45.370" ttm:agent="v1">떠내려가네 내 사랑</p>
      <p begin="01:45.370" end="01:53.170" ttm:agent="v1">내 곁에 있어줘</p>
      <p begin="01:53.170" end="01:55.730" ttm:agent="v1">그대가 사라져도</p>
      <p begin="01:55.730" end="01:59.000" ttm:agent="v1">기억할 거야 영원히</p>
      <p begin="01:59.000" end="02:04.110" ttm:agent="v1">모든 게 잊혀진대도</p>
      <p begin="02:04.110" end="02:12.110" ttm:agent="v1"/>
      <p begin="02:47.230" end="02:54.700" ttm:agent="v1">결국 우린 변하고야 말겠지</p>
      <p begin="02:54.700" end="03:02.700" ttm:agent="v1">금세 사랑은 더 잊혀져가고</p>
      <p begin="03:02.920" end="03:07.630" ttm:agent="v1">영원할 거란 말에 끄덕이던</p>
      <p begin="03:07.630" end="03:15.630" ttm:agent="v1">그 시절 우리의 감정은 떠나가고 어디에</p>
      <p begin="03:19.340" end="03:25.240" ttm:agent="v1">떠내려가네 내 사랑</p>
      <p begin="03:25.240" end="03:33.240" ttm:agent="v1">내 곁에 있어줘</p>
      <p begin="03:33.310" end="03:36.060" ttm:agent="v1">그대가 사라져도</p>
      <p begin="03:36.060" end="03:39.380" ttm:agent="v1">기억할 거야 영원히</p>
      <p begin="03:39.380" end="03:43.960" ttm:agent="v1">모든 게 잊혀진대도</p>
      <p begin="03:43.960" end="03:47.960" ttm:agent="v1"/>
    </div>
  </body>
</tt>
