<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Half of Me</ttm:title>
      <ttm:agent type="person" xml:id="v1">shae</ttm:agent>
      <ttm:item type="album">Half of Me</ttm:item>
      <ttm:item type="spotify_id">5paeg12iGMC5nZnVZ05zLn</ttm:item>
      <itunes:duration>03:03.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:12.430" end="00:15.930" ttm:agent="v1">Ah-ah-ah-ah-ah-aah</p>
      <p begin="00:15.930" end="00:19.320" ttm:agent="v1">Mhm, mhm</p>
      <p begin="00:19.320" end="00:21.600" ttm:agent="v1">Wasn't feeling lonely</p>
      <p begin="00:21.600" end="00:24.010" ttm:agent="v1">I got used to my advice</p>
      <p begin="00:24.010" end="00:25.510" ttm:agent="v1">Feeling all brand new</p>
      <p begin="00:25.440" end="00:26.940" ttm:agent="v1">And 'yay' for me</p>
      <p begin="00:26.770" end="00:28.460" ttm:agent="v1">I've only cried here twice</p>
      <p begin="00:28.460" end="00:30.830" ttm:agent="v1">Wasn't really looking</p>
      <p begin="00:30.830" end="00:33.130" ttm:agent="v1">At least that's what I implied</p>
      <p begin="00:33.130" end="00:34.630" ttm:agent="v1">They all come and go</p>
      <p begin="00:34.580" end="00:37.100" ttm:agent="v1">But no one's ever seem to catch my eye</p>
      <p begin="00:37.100" end="00:41.510" ttm:agent="v1">Then, you came like summer breeze</p>
      <p begin="00:41.510" end="00:46.230" ttm:agent="v1">Stole me from reality, oh-oh, oh</p>
      <p begin="00:46.230" end="00:51.370" ttm:agent="v1">Well, there goes my self-esteem, oh, oh</p>
      <p begin="00:51.370" end="00:55.360" ttm:agent="v1">Kinda scared I lose control of who I am becoming</p>
      <p begin="00:55.360" end="00:59.100" ttm:agent="v1">Ooh, I've gotta make you mine</p>
      <p begin="00:59.100" end="01:01.230" ttm:agent="v1">I'm losing half of me</p>
      <p begin="01:01.230" end="01:04.580" ttm:agent="v1">You're taking my half, baby, come on</p>
      <p begin="01:04.580" end="01:08.190" ttm:agent="v1">Getting so obsessed with you around</p>
      <p begin="01:08.190" end="01:10.560" ttm:agent="v1">'Cause you took half of me</p>
      <p begin="01:10.560" end="01:14.230" ttm:agent="v1">You're taking up half of my mind</p>
      <p begin="01:14.230" end="01:18.840" ttm:agent="v1">Ooh-ooh, whoa-oh-wah-ah-ah-ah</p>
      <p begin="01:18.840" end="01:23.250" ttm:agent="v1">Ooh, whoa-ah-ah-ah-ah-ah-ha</p>
      <p begin="01:23.250" end="01:26.470" ttm:agent="v1">Ooh-ooh, whoa-oh-wah-ah-ah-ah</p>
      <p begin="01:26.470" end="01:28.750" ttm:agent="v1">'Cause you took half of me</p>
      <p begin="01:28.750" end="01:32.290" ttm:agent="v1">You're taking up half of my mind</p>
      <p begin="01:32.290" end="01:34.080" ttm:agent="v1">Yeah, this feeling's great</p>
      <p begin="01:34.080" end="01:36.540" ttm:agent="v1">But I should smarten up</p>
      <p begin="01:36.540" end="01:40.560" ttm:agent="v1">I know that these butterflies won't stay when I'm in love</p>
      <p begin="01:40.560" end="01:42.500" ttm:agent="v1">Should I just leave it here?</p>
      <p begin="01:42.500" end="01:46.180" ttm:agent="v1">Don't wanna test this new fear, oh-oh, oh-oh</p>
      <p begin="01:46.180" end="01:47.680" ttm:agent="v1">I need this life</p>
      <p begin="01:47.190" end="01:48.690" ttm:agent="v1">I need your love</p>
      <p begin="01:48.320" end="01:50.170" ttm:agent="v1">I need us to be something</p>
      <p begin="01:50.170" end="01:54.810" ttm:agent="v1">I love it when you're close to me</p>
      <p begin="01:54.810" end="01:59.360" ttm:agent="v1">And this new anxiety, oh-oh, oh</p>
      <p begin="01:59.360" end="02:04.440" ttm:agent="v1">My heart's quick, it's hard to breathe, oh, oh</p>
      <p begin="02:04.440" end="02:08.450" ttm:agent="v1">Gotta catch myself, I don't know who I am becoming</p>
      <p begin="02:08.450" end="02:12.370" ttm:agent="v1">Ooh, I've got to make you mine</p>
      <p begin="02:12.370" end="02:14.370" ttm:agent="v1">I'm losing half of me</p>
      <p begin="02:14.370" end="02:17.750" ttm:agent="v1">You're taking my half, baby, come on</p>
      <p begin="02:17.750" end="02:21.470" ttm:agent="v1">Getting so obsessed with you around</p>
      <p begin="02:21.470" end="02:23.670" ttm:agent="v1">'Cause you took half of me</p>
      <p begin="02:23.670" end="02:27.390" ttm:agent="v1">You're taking up half of my mind</p>
      <p begin="02:27.390" end="02:31.740" ttm:agent="v1">Ooh-ooh, whoa-oh-wah-ah-ah-ah</p>
      <p begin="02:31.740" end="02:36.440" ttm:agent="v1">Ooh, whoa-ah-ah-ah-ah-ah-ha</p>
      <p begin="02:36.440" end="02:39.690" ttm:agent="v1">Ooh-ooh, whoa-oh-wah-ah-ah-ah</p>
      <p begin="02:39.690" end="02:41.960" ttm:agent="v1">'Cause you took half of me</p>
      <p begin="02:41.960" end="02:49.960" ttm:agent="v1">You're taking up half of my mind</p>
      <p begin="03:02.430" end="03:06.430" ttm:agent="v1"/>
    </div>
