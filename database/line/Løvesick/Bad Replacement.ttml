<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Bad Replacement</ttm:title>
      <ttm:agent type="person" xml:id="v1">Løvesick</ttm:agent>
      <ttm:item type="album">Bad Replacement</ttm:item>
      <ttm:item type="spotify_id">2ghF7ykisp8A2wAW8Rkyfa</ttm:item>
      <itunes:duration>02:32.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:13.830" end="00:17.080" ttm:agent="v1">Is it bad, that I dream of you?</p>
      <p begin="00:17.080" end="00:20.770" ttm:agent="v1">'Cause I press replay but every time I lose</p>
      <p begin="00:20.770" end="00:24.430" ttm:agent="v1">Guess you can't relate, I'm not the one you'd choose</p>
      <p begin="00:24.430" end="00:26.070" ttm:agent="v1">Guess I am replaced</p>
      <p begin="00:26.070" end="00:28.620" ttm:agent="v1" itunes:key="role" itunes:value="background">(Guess I am replaced)</p>
      <p begin="00:28.620" end="00:32.160" ttm:agent="v1">Thought we were meant to be</p>
      <p begin="00:32.160" end="00:36.110" ttm:agent="v1">Didn't know that forever meant a couple of weeks</p>
      <p begin="00:36.110" end="00:39.280" ttm:agent="v1">Chose him over me</p>
      <p begin="00:39.280" end="00:41.630" ttm:agent="v1">You betrayed me</p>
      <p begin="00:41.630" end="00:43.470" ttm:agent="v1">Trade me yeah</p>
      <p begin="00:43.470" end="00:47.160" ttm:agent="v1">All of the things that I had for you oh</p>
      <p begin="00:47.160" end="00:50.610" ttm:agent="v1">They meant nothing, they meant nothing</p>
      <p begin="00:50.610" end="00:52.490" ttm:agent="v1">Burn it all</p>
      <p begin="00:52.490" end="00:55.630" ttm:agent="v1">There's nothing left of me yeah</p>
      <p begin="00:55.630" end="00:59.020" ttm:agent="v1" itunes:key="role" itunes:value="background">(You fucking burn it all again)</p>
      <p begin="00:59.020" end="01:02.570" ttm:agent="v1">Call out his name but it's never the same way</p>
      <p begin="01:02.570" end="01:04.070" ttm:agent="v1" itunes:key="role" itunes:value="background">(Never the same)</p>
      <p begin="01:03.520" end="01:06.230" ttm:agent="v1" itunes:key="role" itunes:value="background">(Feeling so damn replaced)</p>
      <p begin="01:06.230" end="01:09.440" ttm:agent="v1">Gave him my name I feel so betrayed</p>
      <p begin="01:09.440" end="01:12.330" ttm:agent="v1" itunes:key="role" itunes:value="background">(I feel so damn betrayed)</p>
      <p begin="01:12.330" end="01:15.790" ttm:agent="v1">Because I'm just a bad replacement</p>
      <p begin="01:15.790" end="01:19.990" ttm:agent="v1">Don't bother choosing go on date him</p>
      <p begin="01:19.990" end="01:21.600" ttm:agent="v1">Leave me be</p>
      <p begin="01:21.600" end="01:25.560" ttm:agent="v1">I'll spiral all alone</p>
      <p begin="01:25.560" end="01:27.660" ttm:agent="v1" itunes:key="role" itunes:value="background">(Turned me into a nightmare)</p>
      <p begin="01:27.660" end="01:31.130" ttm:agent="v1">But it wasn't me tore my heart out</p>
      <p begin="01:31.130" end="01:34.850" ttm:agent="v1">Put the blame on me girl you're so foul</p>
      <p begin="01:34.850" end="01:38.750" ttm:agent="v1">Sold my heart for free you got him now</p>
      <p begin="01:38.750" end="01:41.920" ttm:agent="v1">Put that shit on me</p>
      <p begin="01:41.920" end="01:49.080" ttm:agent="v1">What does he have that I don't possess my dear?</p>
      <p begin="01:49.080" end="01:52.280" ttm:agent="v1">It'll never be the same way</p>
      <p begin="01:52.280" end="01:54.910" ttm:agent="v1">You betrayed me</p>
      <p begin="01:54.910" end="01:57.840" ttm:agent="v1">You replaced me</p>
      <p begin="01:57.840" end="02:01.200" ttm:agent="v1">Call out his name but it's never the same way</p>
      <p begin="02:01.200" end="02:02.700" ttm:agent="v1" itunes:key="role" itunes:value="background">(Never the same)</p>
      <p begin="02:02.280" end="02:05.170" ttm:agent="v1" itunes:key="role" itunes:value="background">(Feeling so damn replaced)</p>
      <p begin="02:05.170" end="02:08.170" ttm:agent="v1">Gave him my name I feel so betrayed</p>
      <p begin="02:08.170" end="02:10.770" ttm:agent="v1" itunes:key="role" itunes:value="background">(I feel so damn betrayed)</p>
      <p begin="02:10.770" end="02:14.440" ttm:agent="v1">Because I'm just a bad replacement</p>
      <p begin="02:14.440" end="02:18.710" ttm:agent="v1">Don't bother choosing go on date him</p>
      <p begin="02:18.710" end="02:20.530" ttm:agent="v1">Leave me be</p>
      <p begin="02:20.530" end="02:24.710" ttm:agent="v1">I'll spiral all alone</p>
      <p begin="02:24.710" end="02:28.710" ttm:agent="v1"/>
    </div>
  </body>
