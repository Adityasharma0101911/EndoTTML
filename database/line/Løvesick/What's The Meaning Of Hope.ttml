<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>What's The Meaning Of Hope</ttm:title>
      <ttm:agent type="person" xml:id="v1">Løvesick</ttm:agent>
      <ttm:item type="album">What's The Meaning Of Hope</ttm:item>
      <ttm:item type="spotify_id">22dEHlf9nKVaNKUGqJ7FiI</ttm:item>
      <itunes:duration>03:56.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:04.220" end="00:09.080" ttm:agent="v1">On these lonely nights do you miss me?</p>
      <p begin="00:09.080" end="00:13.840" ttm:agent="v1">'Cause I love you till the moon till the stars bleed out</p>
      <p begin="00:13.840" end="00:19.480" ttm:agent="v1">Did you love me for real or was it sympathy?</p>
      <p begin="00:19.480" end="00:22.010" ttm:agent="v1">Was it sympathy?</p>
      <p begin="00:22.010" end="00:26.550" ttm:agent="v1">The stars in your eyes they don't shine like before</p>
      <p begin="00:26.550" end="00:31.620" ttm:agent="v1">Your looks were deceiving got me begging for more</p>
      <p begin="00:31.620" end="00:38.220" ttm:agent="v1">I looked away you stabbed me in the back I'm on the floor</p>
      <p begin="00:38.220" end="00:40.360" ttm:agent="v1">I'm on the floor</p>
      <p begin="00:40.360" end="00:46.270" ttm:agent="v1">Cut out the pictures we made 'cause they all seem so wrong</p>
      <p begin="00:46.270" end="00:48.050" ttm:agent="v1" itunes:key="role" itunes:value="background">(All seem so wrong)</p>
      <p begin="00:48.050" end="00:56.050" ttm:agent="v1">I Hate that you left but I'll face it I'm all in myself on my own</p>
      <p begin="00:56.310" end="01:02.770" ttm:agent="v1">But all of the things that you said, live free in my head</p>
      <p begin="01:02.770" end="01:08.030" ttm:agent="v1">Rather drop dead than see you with somebody's hands</p>
      <p begin="01:08.030" end="01:11.590" ttm:agent="v1">And all the paragraphs you sent tell me who</p>
      <p begin="01:11.590" end="01:15.530" ttm:agent="v1">Were they meant for, was it me or for them?</p>
      <p begin="01:15.530" end="01:18.420" ttm:agent="v1">'Cause I don't know who to trust</p>
      <p begin="01:18.420" end="01:22.970" ttm:agent="v1">Always lost inside my head</p>
      <p begin="01:22.970" end="01:28.090" ttm:agent="v1">Locked my heart 'cause the pain won't end</p>
      <p begin="01:28.090" end="01:32.500" ttm:agent="v1">Threw away the key to the promised neverland</p>
      <p begin="01:32.500" end="01:34.910" ttm:agent="v1">Fallen twenty feet</p>
      <p begin="01:34.910" end="01:38.630" ttm:agent="v1">But here you still stand, standing strong</p>
      <p begin="01:38.630" end="01:41.820" ttm:agent="v1">Walking down this lonely road</p>
      <p begin="01:41.820" end="01:46.800" ttm:agent="v1">This dark alleyway that we used to call home</p>
      <p begin="01:46.800" end="01:51.200" ttm:agent="v1">The only difference now is that I'm all alone</p>
      <p begin="01:51.200" end="01:53.770" ttm:agent="v1">What's the meaning of hope</p>
      <p begin="01:53.770" end="01:58.570" ttm:agent="v1">The meaning of hope when you're alone</p>
      <p begin="01:58.570" end="02:03.540" ttm:agent="v1">I don't do smoke but my heart is still black</p>
      <p begin="02:03.540" end="02:09.110" ttm:agent="v1">Heart so discolored 'cause I want you back</p>
      <p begin="02:09.110" end="02:12.070" ttm:agent="v1">I know it's bad</p>
      <p begin="02:12.070" end="02:15.520" ttm:agent="v1">Cutting the pieces in my head, but</p>
      <p begin="02:15.520" end="02:21.320" ttm:agent="v1">I still refuse, to say that I'm not over you</p>
      <p begin="02:21.320" end="02:24.550" ttm:agent="v1">I'm running round in laps man I'm racing</p>
      <p begin="02:24.550" end="02:28.250" ttm:agent="v1">'Cause I know that I got nothing to lose</p>
      <p begin="02:28.250" end="02:30.820" ttm:agent="v1">With my foot on the pedal</p>
      <p begin="02:30.820" end="02:34.660" ttm:agent="v1">If love was a race I'd be prone to lose</p>
      <p begin="02:34.660" end="02:36.790" ttm:agent="v1">Cannot just save up the mess I've made</p>
      <p begin="02:36.790" end="02:41.740" ttm:agent="v1">Can god forgive me of my mistakes?</p>
      <p begin="02:41.740" end="02:46.560" ttm:agent="v1">Please set me free 'cause I'm not okay</p>
      <p begin="02:46.560" end="02:52.350" ttm:agent="v1">Take all my misery end my ways</p>
      <p begin="02:52.350" end="02:53.850" ttm:agent="v1" itunes:key="role" itunes:value="background">(End my ways)</p>
      <p begin="02:53.700" end="02:58.420" ttm:agent="v1">Always lost inside my head</p>
      <p begin="02:58.420" end="03:03.260" ttm:agent="v1">Locked my heart 'cause the pain won't end</p>
      <p begin="03:03.260" end="03:08.080" ttm:agent="v1">Threw away the key to the promised neverland</p>
      <p begin="03:08.080" end="03:10.350" ttm:agent="v1">Fallen twenty feet</p>
      <p begin="03:10.350" end="03:13.860" ttm:agent="v1">But here you still stand, standing strong</p>
      <p begin="03:13.860" end="03:17.000" ttm:agent="v1">Walking down this lonely road</p>
      <p begin="03:17.000" end="03:22.170" ttm:agent="v1">This dark alleyway that we used to call home</p>
      <p begin="03:22.170" end="03:26.630" ttm:agent="v1">The only difference now is that I'm all alone</p>
      <p begin="03:26.630" end="03:29.200" ttm:agent="v1">What's the meaning of hope</p>
      <p begin="03:29.200" end="03:32.970" ttm:agent="v1">The meaning of hope when you're alone</p>
      <p begin="03:32.970" end="03:37.250" ttm:agent="v1" itunes:key="role" itunes:value="background">(Never thought it was this easy)</p>
      <p begin="03:37.250" end="03:42.530" ttm:agent="v1" itunes:key="role" itunes:value="background">(For you to grab your stuff and leave me)</p>
      <p begin="03:42.530" end="03:46.530" ttm:agent="v1"/>
    </div>
  </body>
</tt>
