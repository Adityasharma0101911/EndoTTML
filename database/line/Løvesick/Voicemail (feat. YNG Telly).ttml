<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Voicemail (feat. YNG Telly)</ttm:title>
      <ttm:agent type="person" xml:id="v1">Løvesick</ttm:agent>
      <ttm:agent type="person" xml:id="v2">YNG Telly</ttm:agent>
      <ttm:item type="album">Sorry Doesn't Fix A Broken Heart</ttm:item>
      <ttm:item type="spotify_id">73kFEiuLCtjvTVe9ZujMVl</ttm:item>
      <itunes:duration>03:11.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:14.360" end="00:17.620" ttm:agent="v1">You hit my phone, I don't pick up, you hit my voicemail</p>
      <p begin="00:17.620" end="00:21.790" ttm:agent="v1">'Cause I don't wanna hear the things you say</p>
      <p begin="00:21.790" end="00:24.530" ttm:agent="v1">All the things that you be screaming in my face</p>
      <p begin="00:24.530" end="00:28.950" ttm:agent="v1" itunes:key="role" itunes:value="background">Man, if I'm that bad, then babe, why do you stay? (Free space)</p>
      <p begin="00:28.950" end="00:31.840" ttm:agent="v1">You hit my phone, I don't pick up, you hit my voicemail</p>
      <p begin="00:31.840" end="00:36.180" ttm:agent="v1">'Cause I don't wanna hear the things you say</p>
      <p begin="00:36.180" end="00:38.930" ttm:agent="v1" itunes:key="role" itunes:value="background">All the things that you be screaming in my face (oh, hey)</p>
      <p begin="00:38.930" end="00:43.020" ttm:agent="v1">Man, if I'm that bad, then babe, why do you stay?</p>
      <p begin="00:43.020" end="00:46.240" ttm:agent="v1">Held your hand through all of this</p>
      <p begin="00:46.240" end="00:49.800" ttm:agent="v1">And this is what I get from it?</p>
      <p begin="00:49.800" end="00:53.380" ttm:agent="v1">It's kinda unfair how you treated me</p>
      <p begin="00:53.380" end="00:58.570" ttm:agent="v1">But there's nothin' I can say for you to stay</p>
      <p begin="00:58.570" end="01:01.320" ttm:agent="v1" itunes:key="role" itunes:value="background">Is it true, ooh? (True, ooh)</p>
      <p begin="01:01.320" end="01:08.030" ttm:agent="v1" itunes:key="role" itunes:value="background">All these people sayin' that you're with another dude (how could you? Whoa)</p>
      <p begin="01:08.030" end="01:16.030" ttm:agent="v1">And I keep saying that I'm happy for you</p>
      <p begin="01:16.620" end="01:19.610" ttm:agent="v1">But you know that it's not true</p>
      <p begin="01:19.610" end="01:22.990" ttm:agent="v1">I be lost in our pictures</p>
      <p begin="01:22.990" end="01:25.910" ttm:agent="v1" itunes:key="role" itunes:value="background">The way that I cannot fix her (free space)</p>
      <p begin="01:25.910" end="01:29.130" ttm:agent="v1">You hit my phone, I don't pick up, you hit my voicemail</p>
      <p begin="01:29.130" end="01:33.570" ttm:agent="v1">'Cause I don't wanna hear the things you say</p>
      <p begin="01:33.570" end="01:36.250" ttm:agent="v1" itunes:key="role" itunes:value="background">All the things that you be screaming in my face (oh, hey)</p>
      <p begin="01:36.250" end="01:40.120" ttm:agent="v1">Man, if I'm that bad, then babe, why do you stay?</p>
      <p begin="01:40.120" end="01:43.620" ttm:agent="v1">Held your hand through all of this</p>
      <p begin="01:43.620" end="01:47.180" ttm:agent="v1">And this is what I get from it?</p>
      <p begin="01:47.180" end="01:50.590" ttm:agent="v1">It's kinda unfair how you treated me</p>
      <p begin="01:50.590" end="01:54.400" ttm:agent="v1">But there's nothin' I can say for you to stay</p>
      <p begin="01:54.400" end="01:57.730" ttm:agent="v1">I want you to stay with me, but we both know how this can be</p>
      <p begin="01:57.730" end="02:01.060" ttm:agent="v1">Girl, you broke my heart, this shit feel like a bad dream</p>
      <p begin="02:01.060" end="02:05.360" ttm:agent="v1">And now you're listening to all these people, see, ah</p>
      <p begin="02:05.360" end="02:09.000" ttm:agent="v1">No, I want you all alone</p>
      <p begin="02:09.000" end="02:11.430" ttm:agent="v1">I want you all alone to myself</p>
      <p begin="02:11.430" end="02:14.190" ttm:agent="v1">I want you all alone to myself</p>
      <p begin="02:14.190" end="02:16.380" ttm:agent="v1">I want you all alone to myself</p>
      <p begin="02:16.380" end="02:19.860" ttm:agent="v1">But then you fucked it up, you are not getting it back</p>
      <p begin="02:19.860" end="02:23.430" ttm:agent="v1" itunes:key="role" itunes:value="background">So why did you? (Then why did you stay?)</p>
      <p begin="02:23.430" end="02:26.430" ttm:agent="v1">You hit my phone, I don't pick up, you hit my voicemail</p>
      <p begin="02:26.430" end="02:30.650" ttm:agent="v1">'Cause I don't wanna hear the things you say</p>
      <p begin="02:30.650" end="02:33.370" ttm:agent="v1" itunes:key="role" itunes:value="background">All the things that you be screaming in my face (oh, hey)</p>
      <p begin="02:33.370" end="02:37.550" ttm:agent="v1">Man, if I'm that bad, then babe, why do you stay?</p>
      <p begin="02:37.550" end="02:41.090" ttm:agent="v1">Held your hand through all of this</p>
      <p begin="02:41.090" end="02:44.580" ttm:agent="v1">And this is what I get from it?</p>
      <p begin="02:44.580" end="02:47.830" ttm:agent="v1">It's kinda unfair how you treated me</p>
      <p begin="02:47.830" end="02:54.360" ttm:agent="v1">But there's nothin' I can say for you to stay</p>
      <p begin="02:54.360" end="02:57.700" ttm:agent="v1">For you to stay</p>
      <p begin="02:57.700" end="03:01.470" ttm:agent="v1">For you to stay</p>
      <p begin="03:01.470" end="03:04.080" ttm:agent="v1">Ah-ah</p>
      <p begin="03:04.080" end="03:08.080" ttm:agent="v1"/>
    </div>
  </body>
</tt>
