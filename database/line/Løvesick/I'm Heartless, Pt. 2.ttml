<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>I'm Heartless, Pt. 2</ttm:title>
      <ttm:agent type="person" xml:id="v1">Løvesick</ttm:agent>
      <ttm:item type="album">I'm Heartless, Pt. 2</ttm:item>
      <ttm:item type="spotify_id">6uIYpRQ7YbM23fcIcTyEjj</ttm:item>
      <itunes:duration>02:34.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:00.280" end="00:03.420" ttm:agent="v1" itunes:key="role" itunes:value="background">('Cause I'm heartless)</p>
      <p begin="00:03.420" end="00:07.710" ttm:agent="v1" itunes:key="role" itunes:value="background">(I'll break your heart)</p>
      <p begin="00:07.710" end="00:11.420" ttm:agent="v1" itunes:key="role" itunes:value="background">(I look harmless)</p>
      <p begin="00:11.420" end="00:14.940" ttm:agent="v1" itunes:key="role" itunes:value="background">(My love is hard makes sure you'll fall apart)</p>
      <p begin="00:14.940" end="00:17.560" ttm:agent="v1">I cannot stand that</p>
      <p begin="00:17.560" end="00:19.060" ttm:agent="v1">You walked away</p>
      <p begin="00:18.820" end="00:22.820" ttm:agent="v1">You were my everything, but you had nothing to say</p>
      <p begin="00:22.820" end="00:25.530" ttm:agent="v1">I'm in my room now</p>
      <p begin="00:25.530" end="00:27.030" ttm:agent="v1">I'm rotting away</p>
      <p begin="00:26.810" end="00:31.680" ttm:agent="v1">Cut out the pictures, the ones we made that day</p>
      <p begin="00:31.680" end="00:35.620" ttm:agent="v1">Burn all the pages I wrote for you</p>
      <p begin="00:35.620" end="00:38.840" ttm:agent="v1">Third degree burns ain't enough for you?</p>
      <p begin="00:38.840" end="00:42.840" ttm:agent="v1">You made me shameless, hateless</p>
      <p begin="00:42.840" end="00:45.290" ttm:agent="v1">So I'll say this</p>
      <p begin="00:45.290" end="00:48.160" ttm:agent="v1" itunes:key="role" itunes:value="background">(You tore my heart out)</p>
      <p begin="00:48.160" end="00:49.790" ttm:agent="v1">'Cause I'm heartless</p>
      <p begin="00:49.790" end="00:51.340" ttm:agent="v1">Don't come near me</p>
      <p begin="00:51.340" end="00:55.900" ttm:agent="v1">I'll break your heart, make sure you'll fall apart on the floor</p>
      <p begin="00:55.900" end="00:59.280" ttm:agent="v1">I look harmless, but it ain't me</p>
      <p begin="00:59.280" end="01:03.580" ttm:agent="v1">My love is hard, makes sure you'll fall apart again</p>
      <p begin="01:03.580" end="01:05.680" ttm:agent="v1" itunes:key="role" itunes:value="background">(Babe)</p>
      <p begin="01:05.680" end="01:07.410" ttm:agent="v1">Won't you take this dance?</p>
      <p begin="01:07.410" end="01:09.030" ttm:agent="v1" itunes:key="role" itunes:value="background">(Just dance with me)</p>
      <p begin="01:09.030" end="01:12.280" ttm:agent="v1" itunes:key="role" itunes:value="background">(I'll spin you round and round till the end)</p>
      <p begin="01:12.280" end="01:14.160" ttm:agent="v1">And it's like I'm feeling cold</p>
      <p begin="01:14.160" end="01:16.260" ttm:agent="v1" itunes:key="role" itunes:value="background">(Feeling cold)</p>
      <p begin="01:16.260" end="01:19.910" ttm:agent="v1">No love left for me to hold</p>
      <p begin="01:19.910" end="01:22.050" ttm:agent="v1">Heart so tight so I'm all alone</p>
      <p begin="01:22.050" end="01:24.220" ttm:agent="v1" itunes:key="role" itunes:value="background">(All alone)</p>
      <p begin="01:24.220" end="01:28.170" ttm:agent="v1">In the depths of my soul love has turned to dust</p>
      <p begin="01:28.170" end="01:33.510" ttm:agent="v1">A heart once warm, now covered in rust</p>
      <p begin="01:33.510" end="01:35.050" ttm:agent="v1" itunes:key="role" itunes:value="background">(I dealt with this shit too many times)</p>
      <p begin="01:35.050" end="01:39.690" ttm:agent="v1">Because I'm heartless don't come near me</p>
      <p begin="01:39.690" end="01:43.840" ttm:agent="v1">I'll break your heart make sure you'll fall apart on the floor</p>
      <p begin="01:43.840" end="01:45.700" ttm:agent="v1">I look harmless</p>
      <p begin="01:45.700" end="01:51.860" ttm:agent="v1">But it ain't me, my love is hard makes sure you'll fall apart again</p>
      <p begin="01:51.860" end="01:53.960" ttm:agent="v1">'Cause I'm heartless</p>
      <p begin="01:53.960" end="01:55.520" ttm:agent="v1">Don't come near me</p>
      <p begin="01:55.520" end="01:59.780" ttm:agent="v1">I'll break your heart, make sure you'll fall apart on the floor</p>
      <p begin="01:59.780" end="02:03.480" ttm:agent="v1">I look harmless, but it ain't me</p>
      <p begin="02:03.480" end="02:07.500" ttm:agent="v1">My love is hard, makes sure you'll fall apart again</p>
      <p begin="02:07.500" end="02:09.620" ttm:agent="v1" itunes:key="role" itunes:value="background">(Babe)</p>
      <p begin="02:09.620" end="02:11.410" ttm:agent="v1">Won't you take this dance?</p>
      <p begin="02:11.410" end="02:13.030" ttm:agent="v1" itunes:key="role" itunes:value="background">(Just dance with me)</p>
      <p begin="02:13.030" end="02:15.500" ttm:agent="v1" itunes:key="role" itunes:value="background">(I'll spin you round and round till the end)</p>
      <p begin="02:15.500" end="02:21.060" ttm:agent="v1">I ain't sweet, my love contains a bitter end</p>
      <p begin="02:21.060" end="02:24.220" ttm:agent="v1" itunes:key="role" itunes:value="background">(I'll make you suffer on again)</p>
      <p begin="02:24.220" end="02:27.940" ttm:agent="v1" itunes:key="role" itunes:value="background">(I still see your shadows in my room)</p>
      <p begin="02:27.940" end="02:31.960" ttm:agent="v1" itunes:key="role" itunes:value="background">(Can't take back the love that I gave you)</p>
      <p begin="02:31.960" end="02:35.960" ttm:agent="v1"/>
    </div>
  </body>
</tt>
