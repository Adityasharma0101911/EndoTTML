<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>How Do I Miss Someone I Don't Know?</ttm:title>
      <ttm:agent type="person" xml:id="v1">Løvesick</ttm:agent>
      <ttm:item type="album">How Do I Miss Someone I Don't Know?</ttm:item>
      <ttm:item type="spotify_id">6P84BHen9jIll76a77oC9C</ttm:item>
      <itunes:duration>02:21.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:18.880" end="00:22.760" ttm:agent="v1">Talking to the moon now looking through the stars</p>
      <p begin="00:22.760" end="00:26.430" ttm:agent="v1">Wishing you were here now I'm wondering where you are</p>
      <p begin="00:26.430" end="00:30.120" ttm:agent="v1">Feels there's some things missing inside of me</p>
      <p begin="00:30.120" end="00:33.860" ttm:agent="v1">Hoping that my prayers will set me free</p>
      <p begin="00:33.860" end="00:37.240" ttm:agent="v1">Talking to myself now, were we meant to be?</p>
      <p begin="00:37.240" end="00:41.290" ttm:agent="v1">I'm sorry that I hurt you 'cause you're the one I need</p>
      <p begin="00:41.290" end="00:45.760" ttm:agent="v1">Feels there's some things missing again</p>
      <p begin="00:45.760" end="00:51.100" ttm:agent="v1">Missing again</p>
      <p begin="00:51.100" end="00:58.320" ttm:agent="v1">And I'm overly obsessed with you, the way my eyes locked on straight on you</p>
      <p begin="00:58.320" end="01:01.580" ttm:agent="v1">And I'm sorry that I can't see through</p>
      <p begin="01:01.580" end="01:04.630" ttm:agent="v1">No matter how hard I try I lose</p>
      <p begin="01:04.630" end="01:11.290" ttm:agent="v1">Both of your ocean eyes</p>
      <p begin="01:11.290" end="01:19.290" ttm:agent="v1">They serve as a beacon at night</p>
      <p begin="01:19.450" end="01:26.330" ttm:agent="v1">I miss you so damn much</p>
      <p begin="01:26.330" end="01:33.470" ttm:agent="v1">My heart breaks 'cause we can't touch</p>
      <p begin="01:33.470" end="01:37.870" ttm:agent="v1">Talking to your ghost now were we heart to heart?</p>
      <p begin="01:37.870" end="01:40.860" ttm:agent="v1">You're fading now, you're fading now</p>
      <p begin="01:40.860" end="01:44.760" ttm:agent="v1">I have done the most now 'cause it's really hard</p>
      <p begin="01:44.760" end="01:47.960" ttm:agent="v1">To remember how, remember how</p>
      <p begin="01:47.960" end="01:51.960" ttm:agent="v1">Talking to the moon now looking through the stars</p>
      <p begin="01:51.960" end="01:55.660" ttm:agent="v1">Wishing you were here now I'm wondering where you are</p>
      <p begin="01:55.660" end="01:59.320" ttm:agent="v1">Feels there's some things missing inside of me</p>
      <p begin="01:59.320" end="02:03.290" ttm:agent="v1">Hoping that my prayers will set me free</p>
      <p begin="02:03.290" end="02:06.630" ttm:agent="v1">Talking to myself now, were we meant to be?</p>
      <p begin="02:06.630" end="02:10.650" ttm:agent="v1">I'm sorry that I hurt you 'cause you're the one I need</p>
      <p begin="02:10.650" end="02:15.150" ttm:agent="v1">Feels there's some things missing again</p>
      <p begin="02:15.150" end="02:18.390" ttm:agent="v1">Missing again</p>
      <p begin="02:18.390" end="02:22.390" ttm:agent="v1"/>
    </div>
  </body>
</tt>
