<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Meant For Me</ttm:title>
      <ttm:agent type="person" xml:id="v1">Løvesick</ttm:agent>
      <ttm:item type="album">Sorry Doesn't Fix A Broken Heart</ttm:item>
      <ttm:item type="spotify_id">4C1MQDUVIIMWfu1yAfs7z3</ttm:item>
      <itunes:duration>02:01.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:21.710" end="00:26.170" ttm:agent="v1">Trynna fall in love but man I can't be</p>
      <p begin="00:26.170" end="00:30.130" ttm:agent="v1">The scars that she had cut man they go too deep</p>
      <p begin="00:30.130" end="00:34.680" ttm:agent="v1">And all I see is her</p>
      <p begin="00:34.680" end="00:39.810" ttm:agent="v1">All I see is her</p>
      <p begin="00:39.810" end="00:44.840" ttm:agent="v1">Break bones I crumble so you'd see</p>
      <p begin="00:44.840" end="00:51.430" ttm:agent="v1">But sadly you've gone blind and now my heart seeks vengeance</p>
      <p begin="00:51.430" end="00:56.210" ttm:agent="v1">Long for acceptance</p>
      <p begin="00:56.210" end="01:00.970" ttm:agent="v1">I don't want dopamine I want love</p>
      <p begin="01:00.970" end="01:05.770" ttm:agent="v1">I want to be told that I'm number one</p>
      <p begin="01:05.770" end="01:09.660" ttm:agent="v1">I want her to marry not to have fun</p>
      <p begin="01:09.660" end="01:14.920" ttm:agent="v1">I wanna remind her that she's the sun</p>
      <p begin="01:14.920" end="01:18.080" ttm:agent="v1" itunes:key="role" itunes:value="background">(I don't wanna be alone)</p>
      <p begin="01:18.080" end="01:22.220" ttm:agent="v1">Oh oh woah</p>
      <p begin="01:22.220" end="01:26.990" ttm:agent="v1">Oh oh woah</p>
      <p begin="01:26.990" end="01:31.430" ttm:agent="v1">I'm craving for attention man can someone help me out</p>
      <p begin="01:31.430" end="01:36.420" ttm:agent="v1">I hit my lowest point and now the silence is too loud</p>
      <p begin="01:36.420" end="01:40.970" ttm:agent="v1">Oh oh woah</p>
      <p begin="01:40.970" end="01:45.400" ttm:agent="v1">Heartbreaks are meant for me</p>
      <p begin="01:45.400" end="01:50.100" ttm:agent="v1">Oh oh woah</p>
      <p begin="01:50.100" end="01:54.310" ttm:agent="v1">Heartbreak is meant for me</p>
      <p begin="01:54.310" end="02:00.320" ttm:agent="v1">For me</p>
      <p begin="02:00.320" end="02:04.320" ttm:agent="v1"/>
    </div>
  </body>
</tt>
