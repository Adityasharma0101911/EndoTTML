<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>If The World Burns Down</ttm:title>
      <ttm:agent type="person" xml:id="v1">Løvesick</ttm:agent>
      <ttm:item type="album">If The World Burns Down</ttm:item>
      <ttm:item type="spotify_id">7koAqfDIAeU6RjVryYC03B</ttm:item>
      <itunes:duration>03:41.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:22.250" end="00:27.660" ttm:agent="v1">I'm lying on the ground</p>
      <p begin="00:27.660" end="00:32.910" ttm:agent="v1">'Cause I bleed internally</p>
      <p begin="00:32.910" end="00:37.680" ttm:agent="v1">And if you see me do you feel remorse for me?</p>
      <p begin="00:37.680" end="00:43.240" ttm:agent="v1">'Cause I've been bleeding, I've been bleeding to my knees</p>
      <p begin="00:43.240" end="00:49.810" ttm:agent="v1">I'm so blind I cannot see that you weren't meant for me</p>
      <p begin="00:49.810" end="00:53.570" ttm:agent="v1">Though I tried to set you free</p>
      <p begin="00:53.570" end="01:00.750" ttm:agent="v1">My room is red, all my blood drips to our pictures</p>
      <p begin="01:00.750" end="01:03.830" ttm:agent="v1">With my sadness in the mixture</p>
      <p begin="01:03.830" end="01:09.110" ttm:agent="v1">And if the world burns down I'd be here with you</p>
      <p begin="01:09.110" end="01:14.450" ttm:agent="v1">And if you'd fall apart I'd fall here with you babe</p>
      <p begin="01:14.450" end="01:17.610" ttm:agent="v1">But would you do the same for me?</p>
      <p begin="01:17.610" end="01:21.870" ttm:agent="v1">I'm having doubts and I cannot sleep</p>
      <p begin="01:21.870" end="01:25.010" ttm:agent="v1">I cannot breathe babe</p>
      <p begin="01:25.010" end="01:31.160" ttm:agent="v1">A ring on your finger 'cause I want you to linger</p>
      <p begin="01:31.160" end="01:35.890" ttm:agent="v1">I want you by my side, by my side</p>
      <p begin="01:35.890" end="01:41.690" ttm:agent="v1">And if you cannot linger I might just pull the trigger</p>
      <p begin="01:41.690" end="01:45.180" ttm:agent="v1">I need you by my side</p>
      <p begin="01:45.180" end="01:47.710" ttm:agent="v1">I need you by my side</p>
      <p begin="01:47.710" end="01:54.330" ttm:agent="v1">I need you by my side, but it's not me who decides</p>
      <p begin="01:54.330" end="01:57.210" ttm:agent="v1">Whose side you're gonna fight</p>
      <p begin="01:57.210" end="01:58.710" ttm:agent="v1">Is it me?</p>
      <p begin="01:58.610" end="02:00.110" ttm:agent="v1">Or them?</p>
      <p begin="01:59.880" end="02:02.510" ttm:agent="v1">'Cause I am just a man</p>
      <p begin="02:02.510" end="02:05.150" ttm:agent="v1">There's not much I can do</p>
      <p begin="02:05.150" end="02:08.050" ttm:agent="v1">That they surely can</p>
      <p begin="02:08.050" end="02:12.050" ttm:agent="v1">But I gave you my all</p>
      <p begin="02:12.050" end="02:15.960" ttm:agent="v1">Gave you all I had</p>
      <p begin="02:15.960" end="02:18.380" ttm:agent="v1">Now there's nothing left</p>
      <p begin="02:18.380" end="02:21.020" ttm:agent="v1">I wish that it was you</p>
      <p begin="02:21.020" end="02:23.930" ttm:agent="v1">That had a fucking clue</p>
      <p begin="02:23.930" end="02:26.340" ttm:agent="v1">I gave you everything</p>
      <p begin="02:26.340" end="02:29.280" ttm:agent="v1">While you put out my fuse</p>
      <p begin="02:29.280" end="02:34.230" ttm:agent="v1">And if the world burns down I'd be here with you</p>
      <p begin="02:34.230" end="02:39.810" ttm:agent="v1">And if you'd fall apart I'd fall here with you babe</p>
      <p begin="02:39.810" end="02:42.730" ttm:agent="v1">But would you do the same for me?</p>
      <p begin="02:42.730" end="02:46.930" ttm:agent="v1">I'm having doubts and I cannot sleep</p>
      <p begin="02:46.930" end="02:50.480" ttm:agent="v1">I cannot breathe babe</p>
      <p begin="02:50.480" end="02:56.270" ttm:agent="v1">A ring on your finger 'cause I want you to linger</p>
      <p begin="02:56.270" end="03:01.050" ttm:agent="v1">I want you by my side, by my side</p>
      <p begin="03:01.050" end="03:06.900" ttm:agent="v1">And if you cannot linger I might just pull the trigger</p>
      <p begin="03:06.900" end="03:11.640" ttm:agent="v1">I need you by my side</p>
      <p begin="03:11.640" end="03:17.470" ttm:agent="v1">A ring on your finger 'cause I want you to linger</p>
      <p begin="03:17.470" end="03:22.470" ttm:agent="v1">I want you by my side</p>
      <p begin="03:22.470" end="03:28.250" ttm:agent="v1">And if you cannot linger then go on pull the trigger</p>
      <p begin="03:28.250" end="03:33.040" ttm:agent="v1">I need you in my life</p>
      <p begin="03:33.040" end="03:37.040" ttm:agent="v1"/>
    </div>
  </body>
</tt>
