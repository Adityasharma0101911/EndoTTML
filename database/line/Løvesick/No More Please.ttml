<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>No More Please</ttm:title>
      <ttm:agent type="person" xml:id="v1">Løvesick</ttm:agent>
      <ttm:item type="album">No More Please</ttm:item>
      <ttm:item type="spotify_id">00Yq9x51Fs7jQDXbaKFwQc</ttm:item>
      <itunes:duration>02:03.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:00.530" end="00:03.130" ttm:agent="v1" itunes:key="role" itunes:value="background">(Baby I don't understand this)</p>
      <p begin="00:03.130" end="00:07.450" ttm:agent="v1" itunes:key="role" itunes:value="background">(You're changing I can't stand it)</p>
      <p begin="00:07.450" end="00:11.370" ttm:agent="v1" itunes:key="role" itunes:value="background">(My heart can't take this damage)</p>
      <p begin="00:11.370" end="00:15.560" ttm:agent="v1" itunes:key="role" itunes:value="background">(And the way I feel can't stand it)</p>
      <p begin="00:15.560" end="00:18.290" ttm:agent="v1" itunes:key="role" itunes:value="background">(Mmmm baby I don't understand it)</p>
      <p begin="00:18.290" end="00:23.780" ttm:agent="v1" itunes:key="role" itunes:value="background">(Too many thoughts going through my brain)</p>
      <p begin="00:23.780" end="00:26.140" ttm:agent="v1" itunes:key="role" itunes:value="background">(Girl you're making it hard for me)</p>
      <p begin="00:26.140" end="00:34.140" ttm:agent="v1" itunes:key="role" itunes:value="background">(Taking these shots like it's novocaine)</p>
      <p begin="00:34.370" end="00:37.210" ttm:agent="v1">Ah aha</p>
      <p begin="00:37.210" end="00:43.680" ttm:agent="v1">Fucked it up too much and now I'm stuck inside my head</p>
      <p begin="00:43.680" end="00:47.880" ttm:agent="v1">Played too much, heart was struck</p>
      <p begin="00:47.880" end="00:50.710" ttm:agent="v1">Singing this stupid song in my head</p>
      <p begin="00:50.710" end="00:53.670" ttm:agent="v1">Needed</p>
      <p begin="00:53.670" end="00:58.600" ttm:agent="v1">Was I really needed?</p>
      <p begin="00:58.600" end="01:01.550" ttm:agent="v1">'Cause I feel it</p>
      <p begin="01:01.550" end="01:07.340" ttm:agent="v1">That I wasn't really needed</p>
      <p begin="01:07.340" end="01:11.050" ttm:agent="v1">Feelings</p>
      <p begin="01:11.050" end="01:15.570" ttm:agent="v1">Anxiety</p>
      <p begin="01:15.570" end="01:19.570" ttm:agent="v1">It's way too much</p>
      <p begin="01:19.570" end="01:23.750" ttm:agent="v1" itunes:key="role" itunes:value="background">(Way too much)</p>
      <p begin="01:23.750" end="01:28.780" ttm:agent="v1">I cannot save myself no more</p>
      <p begin="01:28.780" end="01:32.970" ttm:agent="v1">Too far down can't help me now</p>
      <p begin="01:32.970" end="01:36.980" ttm:agent="v1">Suicidal in my room</p>
      <p begin="01:36.980" end="01:41.130" ttm:agent="v1">Watch it fall apart again</p>
      <p begin="01:41.130" end="01:45.130" ttm:agent="v1">Cannot stand this shit no more</p>
      <p begin="01:45.130" end="01:49.390" ttm:agent="v1">Every day is such a beg for more</p>
      <p begin="01:49.390" end="01:53.560" ttm:agent="v1">Cannot step foot outside my door</p>
      <p begin="01:53.560" end="01:57.720" ttm:agent="v1">Better off dead instead of more</p>
      <p begin="01:57.720" end="02:01.720" ttm:agent="v1"/>
    </div>
  </body>
