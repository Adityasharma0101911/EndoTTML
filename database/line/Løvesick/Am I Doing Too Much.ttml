<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Am I Doing Too Much</ttm:title>
      <ttm:agent type="person" xml:id="v1">Løvesick</ttm:agent>
      <ttm:item type="album">Sorry Doesn't Fix A Broken Heart</ttm:item>
      <ttm:item type="spotify_id">5QmEUczRNdlcCTA3EtaIWc</ttm:item>
      <itunes:duration>02:12.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:03.190" end="00:05.860" ttm:agent="v1" itunes:key="role" itunes:value="background">(Am I doing too much for you?)</p>
      <p begin="00:05.860" end="00:07.910" ttm:agent="v1" itunes:key="role" itunes:value="background">(Oh woah)</p>
      <p begin="00:07.910" end="00:11.140" ttm:agent="v1" itunes:key="role" itunes:value="background">('Cause baby I don't wanna lose)</p>
      <p begin="00:11.140" end="00:14.020" ttm:agent="v1">Oh god, look at my face</p>
      <p begin="00:14.020" end="00:16.680" ttm:agent="v1">Been fucked up for months and days</p>
      <p begin="00:16.680" end="00:19.900" ttm:agent="v1">You've been going on your own damn ways</p>
      <p begin="00:19.900" end="00:21.690" ttm:agent="v1">And I'm feeling so replaced</p>
      <p begin="00:21.690" end="00:24.900" ttm:agent="v1">Stop, I am going thru enough</p>
      <p begin="00:24.900" end="00:29.020" ttm:agent="v1">I just need some human touch</p>
      <p begin="00:29.020" end="00:32.530" ttm:agent="v1">I just need someone to love</p>
      <p begin="00:32.530" end="00:35.190" ttm:agent="v1">I'm going solo</p>
      <p begin="00:35.190" end="00:39.950" ttm:agent="v1">I'm fighting solo</p>
      <p begin="00:39.950" end="00:43.040" ttm:agent="v1">'Cause everyday I'm feeling low</p>
      <p begin="00:43.040" end="00:45.910" ttm:agent="v1">Oh</p>
      <p begin="00:45.910" end="00:48.100" ttm:agent="v1">Am I doing too much for you?</p>
      <p begin="00:48.100" end="00:50.720" ttm:agent="v1">Oh</p>
      <p begin="00:50.720" end="00:56.090" ttm:agent="v1">'Cause baby I don't wanna lose what we have made</p>
      <p begin="00:56.090" end="00:59.260" ttm:agent="v1">I fight in hell everything for you</p>
      <p begin="00:59.260" end="01:02.630" ttm:agent="v1">I'd kill myself for you</p>
      <p begin="01:02.630" end="01:06.810" ttm:agent="v1">I would do it all for you</p>
      <p begin="01:06.810" end="01:09.430" ttm:agent="v1">And I'm feeling so damn numb</p>
      <p begin="01:09.430" end="01:11.900" ttm:agent="v1">Feel like the whole world's against me</p>
      <p begin="01:11.900" end="01:14.470" ttm:agent="v1">I'm trynna be someone</p>
      <p begin="01:14.470" end="01:17.160" ttm:agent="v1">I'm not okay</p>
      <p begin="01:17.160" end="01:19.750" ttm:agent="v1">Tell death I'm on my way</p>
      <p begin="01:19.750" end="01:23.710" ttm:agent="v1">I don't wanna leave but it's hard to stay</p>
      <p begin="01:23.710" end="01:25.350" ttm:agent="v1">When everyday's a pain</p>
      <p begin="01:25.350" end="01:30.810" ttm:agent="v1">My heart is broken cannot seem to focus</p>
      <p begin="01:30.810" end="01:35.890" ttm:agent="v1">If I'm so broken then why's my heart so open?</p>
      <p begin="01:35.890" end="01:38.760" ttm:agent="v1">Oh</p>
      <p begin="01:38.760" end="01:41.190" ttm:agent="v1">Am I doing too much for you?</p>
      <p begin="01:41.190" end="01:43.550" ttm:agent="v1">Oh</p>
      <p begin="01:43.550" end="01:48.880" ttm:agent="v1">'Cause baby I don't wanna lose what we have made</p>
      <p begin="01:48.880" end="01:52.220" ttm:agent="v1">I fight in hell everything for you</p>
      <p begin="01:52.220" end="01:55.450" ttm:agent="v1">I'd kill myself for you</p>
      <p begin="01:55.450" end="02:00.170" ttm:agent="v1">I would do it all for you</p>
      <p begin="02:00.170" end="02:03.610" ttm:agent="v1" itunes:key="role" itunes:value="background">(I would anything)</p>
      <p begin="02:03.610" end="02:06.260" ttm:agent="v1" itunes:key="role" itunes:value="background">(Anything)</p>
      <p begin="02:06.260" end="02:08.150" ttm:agent="v1" itunes:key="role" itunes:value="background">(Oh woah)</p>
      <p begin="02:08.150" end="02:12.150" ttm:agent="v1"/>
    </div>
  </body>
</tt>
