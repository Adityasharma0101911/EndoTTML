<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>I'm Heartless</ttm:title>
      <ttm:agent type="person" xml:id="v1">Løvesick</ttm:agent>
      <ttm:item type="album">I'm Heartless</ttm:item>
      <ttm:item type="spotify_id">4OkR3Ag0gpeSPW0yOXzn8V</ttm:item>
      <itunes:duration>02:50.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:00.260" end="00:03.910" ttm:agent="v1" itunes:key="role" itunes:value="background">('Cause I'm heartless)</p>
      <p begin="00:03.910" end="00:09.050" ttm:agent="v1" itunes:key="role" itunes:value="background">(I'll break your heart)</p>
      <p begin="00:09.050" end="00:13.050" ttm:agent="v1" itunes:key="role" itunes:value="background">(I look harmless)</p>
      <p begin="00:13.050" end="00:16.730" ttm:agent="v1" itunes:key="role" itunes:value="background">(My love is hard makes sure you'll fall apart)</p>
      <p begin="00:16.730" end="00:19.480" ttm:agent="v1">I cannot stand that</p>
      <p begin="00:19.480" end="00:21.240" ttm:agent="v1">You walked away</p>
      <p begin="00:21.240" end="00:25.590" ttm:agent="v1">You were my everything, but you had nothing to say</p>
      <p begin="00:25.590" end="00:28.120" ttm:agent="v1">I'm in my room now</p>
      <p begin="00:28.120" end="00:29.940" ttm:agent="v1">I'm rotting away</p>
      <p begin="00:29.940" end="00:35.080" ttm:agent="v1">Cut out the pictures, the ones we made that day</p>
      <p begin="00:35.080" end="00:39.350" ttm:agent="v1">Burn all the pages I wrote for you</p>
      <p begin="00:39.350" end="00:43.030" ttm:agent="v1">Third degree burns ain't enough for you?</p>
      <p begin="00:43.030" end="00:47.530" ttm:agent="v1">You made me shameless, hateless</p>
      <p begin="00:47.530" end="00:49.980" ttm:agent="v1">So I'll say this</p>
      <p begin="00:49.980" end="00:52.850" ttm:agent="v1" itunes:key="role" itunes:value="background">(You tore my heart out)</p>
      <p begin="00:52.850" end="00:54.950" ttm:agent="v1">'Cause I'm heartless</p>
      <p begin="00:54.950" end="00:56.770" ttm:agent="v1">Don't come near me</p>
      <p begin="00:56.770" end="01:01.920" ttm:agent="v1">I'll break your heart, make sure you'll fall apart on the floor</p>
      <p begin="01:01.920" end="01:05.810" ttm:agent="v1">I look harmless, but it ain't me</p>
      <p begin="01:05.810" end="01:10.320" ttm:agent="v1">My love is hard, makes sure you'll fall apart again</p>
      <p begin="01:10.320" end="01:12.540" ttm:agent="v1" itunes:key="role" itunes:value="background">(Babe)</p>
      <p begin="01:12.540" end="01:14.560" ttm:agent="v1">Won't you take this dance?</p>
      <p begin="01:14.560" end="01:16.120" ttm:agent="v1" itunes:key="role" itunes:value="background">(Just dance with me)</p>
      <p begin="01:16.120" end="01:19.020" ttm:agent="v1" itunes:key="role" itunes:value="background">(I'll spin you round and round till the end)</p>
      <p begin="01:19.020" end="01:24.930" ttm:agent="v1">I ain't sweet, my love contains a bitter end</p>
      <p begin="01:24.930" end="01:29.410" ttm:agent="v1" itunes:key="role" itunes:value="background">(I'll make you suffer on again)</p>
      <p begin="01:29.410" end="01:32.170" ttm:agent="v1">And I'm so tired of</p>
      <p begin="01:32.170" end="01:36.620" ttm:agent="v1">The things she said, the things you said</p>
      <p begin="01:36.620" end="01:39.230" ttm:agent="v1">You cut me up, crossed me up</p>
      <p begin="01:39.230" end="01:41.130" ttm:agent="v1">While you're still out there</p>
      <p begin="01:41.130" end="01:43.580" ttm:agent="v1">You have no fucking clue</p>
      <p begin="01:43.580" end="01:45.650" ttm:agent="v1" itunes:key="role" itunes:value="background">(You turned me into a nightmare)</p>
      <p begin="01:45.650" end="01:47.490" ttm:agent="v1">I see red</p>
      <p begin="01:47.490" end="01:49.840" ttm:agent="v1">Blood on my bed</p>
      <p begin="01:49.840" end="01:51.990" ttm:agent="v1">Marks on my neck</p>
      <p begin="01:51.990" end="01:54.370" ttm:agent="v1">You killed me in my head</p>
      <p begin="01:54.370" end="01:56.280" ttm:agent="v1">I'm done with this</p>
      <p begin="01:56.280" end="02:00.180" ttm:agent="v1">You broke me piece by piece</p>
      <p begin="02:00.180" end="02:03.300" ttm:agent="v1" itunes:key="role" itunes:value="background">(You got me down onto my knees)</p>
      <p begin="02:03.300" end="02:05.430" ttm:agent="v1">'Cause I'm heartless</p>
      <p begin="02:05.430" end="02:07.370" ttm:agent="v1">Don't come near me</p>
      <p begin="02:07.370" end="02:12.060" ttm:agent="v1">I'll break your heart, make sure you'll fall apart on the floor</p>
      <p begin="02:12.060" end="02:16.160" ttm:agent="v1">I look harmless, but it ain't me</p>
      <p begin="02:16.160" end="02:20.810" ttm:agent="v1">My love is hard, makes sure you'll fall apart again</p>
      <p begin="02:20.810" end="02:22.950" ttm:agent="v1" itunes:key="role" itunes:value="background">(Babe)</p>
      <p begin="02:22.950" end="02:25.120" ttm:agent="v1">Won't you take this dance?</p>
      <p begin="02:25.120" end="02:26.670" ttm:agent="v1" itunes:key="role" itunes:value="background">(Just dance with me)</p>
      <p begin="02:26.670" end="02:29.510" ttm:agent="v1" itunes:key="role" itunes:value="background">(I'll spin you round and round till the end)</p>
      <p begin="02:29.510" end="02:35.150" ttm:agent="v1">I ain't sweet, my love contains a bitter end</p>
      <p begin="02:35.150" end="02:39.180" ttm:agent="v1" itunes:key="role" itunes:value="background">(I'll make you suffer on again)</p>
      <p begin="02:39.180" end="02:43.140" ttm:agent="v1" itunes:key="role" itunes:value="background">(I still see your shadows in my room)</p>
      <p begin="02:43.140" end="02:47.190" ttm:agent="v1" itunes:key="role" itunes:value="background">(Can't take back the love that I gave you)</p>
      <p begin="02:47.190" end="02:51.190" ttm:agent="v1"/>
    </div>
  </body>
</tt>
