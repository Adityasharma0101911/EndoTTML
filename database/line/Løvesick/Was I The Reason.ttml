<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Was I The Reason</ttm:title>
      <ttm:agent type="person" xml:id="v1">Løvesick</ttm:agent>
      <ttm:item type="album">Was I The Reason</ttm:item>
      <ttm:item type="spotify_id">4zl3bmWI07pyxtBJwkb2aq</ttm:item>
      <itunes:duration>02:36.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:26.860" end="00:31.380" ttm:agent="v1">I slam my skull into the wall</p>
      <p begin="00:31.380" end="00:33.430" ttm:agent="v1" itunes:key="role" itunes:value="background">(Oh woah)</p>
      <p begin="00:33.430" end="00:38.420" ttm:agent="v1">Concussions all so I forget you</p>
      <p begin="00:38.420" end="00:40.040" ttm:agent="v1" itunes:key="role" itunes:value="background">(Oh woah)</p>
      <p begin="00:40.040" end="00:46.690" ttm:agent="v1">Don't call the ambulance I'm fine</p>
      <p begin="00:46.690" end="00:51.830" ttm:agent="v1">These scars won't heal overtime</p>
      <p begin="00:51.830" end="00:55.200" ttm:agent="v1">But was it just me?</p>
      <p begin="00:55.200" end="00:58.630" ttm:agent="v1">Or was it just all the things I've done</p>
      <p begin="00:58.630" end="01:01.830" ttm:agent="v1">The letters I wrote?</p>
      <p begin="01:01.830" end="01:04.790" ttm:agent="v1">The time that I spent inside a home</p>
      <p begin="01:04.790" end="01:07.980" ttm:agent="v1">Was always empty from the start</p>
      <p begin="01:07.980" end="01:11.860" ttm:agent="v1">Was never meant inside your heart</p>
      <p begin="01:11.860" end="01:15.100" ttm:agent="v1">Then was it just me?</p>
      <p begin="01:15.100" end="01:20.330" ttm:agent="v1">Was I the reason that you left?</p>
      <p begin="01:20.330" end="01:27.270" ttm:agent="v1">I held my breath for you, you still blew away oh woah</p>
      <p begin="01:27.270" end="01:32.270" ttm:agent="v1">And I'm sorry for all the things that I used to say</p>
      <p begin="01:32.270" end="01:36.260" ttm:agent="v1">But you left without a trace no footsteps</p>
      <p begin="01:36.260" end="01:39.640" ttm:agent="v1">Still see your face in my head</p>
      <p begin="01:39.640" end="01:43.450" ttm:agent="v1">Cause of me you bit the dust and left</p>
      <p begin="01:43.450" end="01:45.740" ttm:agent="v1">And you left me</p>
      <p begin="01:45.740" end="01:52.610" ttm:agent="v1">Packed up all your shit and left, apparently I'm nothing more than left on read</p>
      <p begin="01:52.610" end="01:55.560" ttm:agent="v1">Sent me one more text and that</p>
      <p begin="01:55.560" end="01:58.180" ttm:agent="v1">Concluded all we had</p>
      <p begin="01:58.180" end="02:01.310" ttm:agent="v1">But was it just me?</p>
      <p begin="02:01.310" end="02:04.580" ttm:agent="v1">Or was it just all the things I've done</p>
      <p begin="02:04.580" end="02:06.160" ttm:agent="v1">The letters I wrote?</p>
      <p begin="02:06.160" end="02:07.910" ttm:agent="v1" itunes:key="role" itunes:value="background">(Were they enough for you?)</p>
      <p begin="02:07.910" end="02:10.830" ttm:agent="v1">The time that I spent inside a home</p>
      <p begin="02:10.830" end="02:14.010" ttm:agent="v1">Was always empty from the start</p>
      <p begin="02:14.010" end="02:17.770" ttm:agent="v1">Was never meant inside your heart</p>
      <p begin="02:17.770" end="02:21.190" ttm:agent="v1">Then was it just me?</p>
      <p begin="02:21.190" end="02:25.690" ttm:agent="v1">Was I the reason that you left?</p>
      <p begin="02:25.690" end="02:29.690" ttm:agent="v1"/>
    </div>
  </body>
</tt>
