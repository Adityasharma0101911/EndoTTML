<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>My Interlude</ttm:title>
      <ttm:agent type="person" xml:id="v1">Løvesick</ttm:agent>
      <ttm:item type="album">Sorry Doesn't Fix A Broken Heart</ttm:item>
      <ttm:item type="spotify_id">5oiq4WhwohxPCUcfhjxTRx</ttm:item>
      <itunes:duration>02:17.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:26.420" end="00:33.900" ttm:agent="v1">A gun inside my head</p>
      <p begin="00:33.900" end="00:38.530" ttm:agent="v1">A knife inside my back</p>
      <p begin="00:38.530" end="00:41.450" ttm:agent="v1">Keep on stabbing oh</p>
      <p begin="00:41.450" end="00:47.740" ttm:agent="v1">All my friends are dead</p>
      <p begin="00:47.740" end="00:52.490" ttm:agent="v1">And now I am the last</p>
      <p begin="00:52.490" end="00:55.030" ttm:agent="v1">Keep on living oh</p>
      <p begin="00:55.030" end="01:01.630" ttm:agent="v1">I don't know where to go</p>
      <p begin="01:01.630" end="01:08.450" ttm:agent="v1">Everywhere is not my home</p>
      <p begin="01:08.450" end="01:15.200" ttm:agent="v1">Fall, I will die alone</p>
      <p begin="01:15.200" end="01:22.680" ttm:agent="v1">Rain, I'm inside but I'm soaked</p>
      <p begin="01:22.680" end="01:26.080" ttm:agent="v1">I'm falling down</p>
      <p begin="01:26.080" end="01:28.420" ttm:agent="v1">You're safe and sound</p>
      <p begin="01:28.420" end="01:32.630" ttm:agent="v1">I am worthless</p>
      <p begin="01:32.630" end="01:36.530" ttm:agent="v1">Cannot stop</p>
      <p begin="01:36.530" end="01:39.220" ttm:agent="v1">They come around and go</p>
      <p begin="01:39.220" end="01:42.690" ttm:agent="v1">I'm tired of the fake love</p>
      <p begin="01:42.690" end="01:45.720" ttm:agent="v1">Just leave me</p>
      <p begin="01:45.720" end="01:49.730" ttm:agent="v1">Don't turn around</p>
      <p begin="01:49.730" end="01:53.730" ttm:agent="v1"/>
    </div>
  </body>
</tt>
