<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>My Interlude</ttm:title><ttm:agent type="person" xml:id="v1">Løvesick</ttm:agent><ttm:item type="album">Sorry Doesn't Fix A Broken Heart</ttm:item><ttm:item type="spotify_id">5oiq4WhwohxPCUcfhjxTRx</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:26.420" end="00:33.900">A gun inside my head</p><p ttm:agent="v1" begin="00:33.900" end="00:38.530">A knife inside my back</p><p ttm:agent="v1" begin="00:38.530" end="00:41.450">Keep on stabbing oh</p><p ttm:agent="v1" begin="00:41.450" end="00:47.740">All my friends are dead</p><p ttm:agent="v1" begin="00:47.740" end="00:52.490">And now I am the last</p><p ttm:agent="v1" begin="00:52.490" end="00:55.030">Keep on living oh</p><p ttm:agent="v1" begin="00:55.030" end="01:01.630">I don't know where to go</p><p ttm:agent="v1" begin="01:01.630" end="01:08.450">Everywhere is not my home</p><p ttm:agent="v1" begin="01:08.450" end="01:15.200">Fall, I will die alone</p><p ttm:agent="v1" begin="01:15.200" end="01:22.680">Rain, I'm inside but I'm soaked</p><p ttm:agent="v1" begin="01:22.680" end="01:26.080">I'm falling down</p><p ttm:agent="v1" begin="01:26.080" end="01:28.420">You're safe and sound</p><p ttm:agent="v1" begin="01:28.420" end="01:32.630">I am worthless</p><p ttm:agent="v1" begin="01:32.630" end="01:36.530">Cannot stop</p><p ttm:agent="v1" begin="01:36.530" end="01:39.220">They come around and go</p><p ttm:agent="v1" begin="01:39.220" end="01:42.690">I'm tired of the fake love</p><p ttm:agent="v1" begin="01:42.690" end="01:45.720">Just leave me</p><p ttm:agent="v1" begin="01:45.720" end="01:49.730">Don't turn around</p><p ttm:agent="v1" begin="01:49.730" end="01:53.730" /></div></body></tt>