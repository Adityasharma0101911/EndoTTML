      <p begin="01:10.540" end="01:12.330" ttm:agent="v1">Dale a tu cuerpo alegría, Macarena</p>
      <p begin="01:12.330" end="01:15.290" ttm:agent="v1">Que tu cuerpo es pa' darle alegría y cosas buenas</p>
      <p begin="01:15.290" end="01:17.390" ttm:agent="v1">Dale a tu cuerpo alegría, Macarena</p>
      <p begin="01:17.390" end="01:19.590" ttm:agent="v1" itunes:key="role" itunes:value="background">Eh, Macarena (Ay)</p>
      <p begin="01:19.590" end="01:21.760" ttm:agent="v1">Macarena, Macarena, Macarena</p>
      <p begin="01:21.760" end="01:24.270" ttm:agent="v1">Que te gustan los veranos de Marbella</p>
      <p begin="01:24.270" end="01:26.430" ttm:agent="v1">Macarena, Macarena, Macarena</p>
      <p begin="01:26.430" end="01:29.290" ttm:agent="v1" itunes:key="role" itunes:value="background">Que te gusta la movida guerrillera (Ay)</p>
      <p begin="01:29.290" end="01:37.290" ttm:agent="v1"/>
