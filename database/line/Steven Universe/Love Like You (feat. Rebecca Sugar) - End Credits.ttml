<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Love Like You (feat. Rebecca Sugar) - End Credits</ttm:title><ttm:agent type="person" xml:id="v1">Steven Universe</ttm:agent><ttm:agent type="person" xml:id="v2">Rebecca Sugar</ttm:agent><ttm:item type="album">Steven Universe, Vol. 1 (Original Soundtrack)</ttm:item><ttm:item type="spotify_id">3z9OnsnvM6SFN2dzrSDdVO</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:06.440" end="00:09.770">If u could begin to be</p><p ttm:agent="v1" begin="00:09.770" end="00:12.370">Half of what you think of me</p><p ttm:agent="v1" begin="00:12.370" end="00:14.770">I could do about anything</p><p ttm:agent="v1" begin="00:14.770" end="00:18.520">I could even learn how to love</p><p ttm:agent="v1" begin="00:18.520" end="00:21.840">When I see the way you act</p><p ttm:agent="v1" begin="00:21.840" end="00:24.730">Wondering when I'm coming back</p><p ttm:agent="v1" begin="00:24.730" end="00:27.070">I could do about anything</p><p ttm:agent="v1" begin="00:27.070" end="00:35.070">I could even learn how to love... Like you</p><p ttm:agent="v1" begin="00:54.620" end="00:57.250">I always thought I might be bad</p><p ttm:agent="v1" begin="00:57.250" end="01:00.180">Now I'm sure that it's true</p><p ttm:agent="v1" begin="01:00.180" end="01:03.340">Cause I think you're so good</p><p ttm:agent="v1" begin="01:03.340" end="01:06.490">And nothing like you</p><p ttm:agent="v1" begin="01:06.490" end="01:08.060">Look at you go</p><p ttm:agent="v1" begin="01:08.060" end="01:09.670">I just adore you</p><p ttm:agent="v1" begin="01:09.670" end="01:12.920">I wish that I knew</p><p ttm:agent="v1" begin="01:12.920" end="01:20.280">What makes you think I'm so especial</p><p ttm:agent="v1" begin="01:20.280" end="01:22.770">If I could begin to do</p><p ttm:agent="v1" begin="01:22.770" end="01:26.800">Something that does right to you</p><p ttm:agent="v1" begin="01:26.800" end="01:29.010">I could do about anything</p><p ttm:agent="v1" begin="01:29.010" end="01:37.010">I could even learn how to love</p><p ttm:agent="v1" begin="01:37.900" end="01:40.830">When I see the way you look</p><p ttm:agent="v1" begin="01:40.830" end="01:43.490">Shaking by how long it took</p><p ttm:agent="v1" begin="01:43.490" end="01:45.860">I could do about anything</p><p ttm:agent="v1" begin="01:45.860" end="01:53.860">I could even learn how to love like you</p><p ttm:agent="v1" begin="01:54.320" end="02:00.630">Love like you</p><p ttm:agent="v1" begin="02:00.630" end="02:02.960">Love me like you</p><p ttm:agent="v1" begin="02:02.960" end="02:06.960" /></div></body></tt>