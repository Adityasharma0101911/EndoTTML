<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Rindu yang dalam</ttm:title>
      <ttm:agent type="person" xml:id="v1">Hendry landry</ttm:agent>
      <ttm:item type="album">Rindu yang dalam</ttm:item>
      <ttm:item type="spotify_id">5XFmhGIhXAPUTSWYUNljKd</ttm:item>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:00.000" end="00:01.500" ttm:agent="v1">作词 : Hendry landry</p>
      <p begin="00:00.249" end="00:01.749" ttm:agent="v1">作曲 : Hendry landry</p>
      <p begin="00:00.498" end="00:04.158" ttm:agent="v1">Berjalan-jalan di tengah malam</p>
      <p begin="00:04.158" end="00:08.710" ttm:agent="v1">Bintang-bintang bersinar terang</p>
      <p begin="00:08.710" end="00:12.361" ttm:agent="v1">Lampu-lampu kota berkilauan</p>
      <p begin="00:12.361" end="00:16.530" ttm:agent="v1">Hati ini tak pernah tenang</p>
      <p begin="00:16.530" end="00:21.030" ttm:agent="v1">Langkah kaki menyusuri jalan</p>
      <p begin="00:21.030" end="00:25.508" ttm:agent="v1">Di bawah langit yang penuh kenangan</p>
      <p begin="00:25.508" end="00:28.096" ttm:agent="v1">Segala resah dan beban</p>
      <p begin="00:28.096" end="00:34.466" ttm:agent="v1">Tak terabaikan hilang perlahan</p>
      <p begin="00:34.466" end="00:39.180" ttm:agent="v1">Malam yang panjang temani aku</p>
      <p begin="00:39.180" end="00:43.688" ttm:agent="v1">Rindu yang dalam mengisi waktu</p>
      <p begin="00:43.688" end="00:48.108" ttm:agent="v1">Di setiap detik ada kamu</p>
      <p begin="00:48.108" end="00:56.108" ttm:agent="v1">Tak ku tahu apa yang kutunggu</p>
      <p begin="01:17.592" end="01:22.408" ttm:agent="v1">Angin malam berbisik pelan</p>
      <p begin="01:22.408" end="01:26.977" ttm:agent="v1">Tentang mimpi yang hilang ingatan</p>
      <p begin="01:26.977" end="01:30.684" ttm:agent="v1">Meski dunia bertambah gelap</p>
      <p begin="01:30.684" end="01:35.931" ttm:agent="v1">Ada cahaya dalam setiap harap</p>
      <p begin="01:35.931" end="01:40.331" ttm:agent="v1">Bersembunyi dalam keramaian</p>
      <p begin="01:40.331" end="01:44.777" ttm:agent="v1">Mencari jawaban yang tersimpan</p>
      <p begin="01:44.777" end="01:48.699" ttm:agent="v1">Di setiap sudut kota ini</p>
      <p begin="01:48.699" end="01:52.585" ttm:agent="v1">Hati ini terus menanti</p>
      <p begin="01:52.585" end="01:57.291" ttm:agent="v1">Malam yang panjang temani aku</p>
      <p begin="01:57.291" end="02:01.803" ttm:agent="v1">Rindu yang dalam mengisi waktu</p>
      <p begin="02:01.803" end="02:06.543" ttm:agent="v1">Di setiap detik ada kamu</p>
      <p begin="02:06.543" end="02:10.543" ttm:agent="v1">Tak ku tahu apa yang kutunggu</p>
    </div>
  </body>
</tt>
