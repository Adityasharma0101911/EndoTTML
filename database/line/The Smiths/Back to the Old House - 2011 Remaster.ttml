<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Back to the Old House - 2011 Remaster</ttm:title><ttm:agent type="person" xml:id="v1">The Smiths</ttm:agent><ttm:item type="album">Louder Than Bombs</ttm:item><ttm:item type="spotify_id">6LUGvXEAK8WxIBYK43uoTb</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:14.290" end="00:18.450">I would rather not go</p><p ttm:agent="v1" begin="00:18.450" end="00:22.070">Back to the old house</p><p ttm:agent="v1" begin="00:22.070" end="00:26.640" /><p ttm:agent="v1" begin="00:26.640" end="00:31.340">I would rather not go</p><p ttm:agent="v1" begin="00:31.340" end="00:36.240">Back to the old house</p><p ttm:agent="v1" begin="00:36.240" end="00:41.840">There's too many bad memories</p><p ttm:agent="v1" begin="00:41.840" end="00:45.440">Too many memories</p><p ttm:agent="v1" begin="00:45.440" end="00:53.440" /><p ttm:agent="v1" begin="01:01.980" end="01:08.840">When you cycled by, here began all my dreams</p><p ttm:agent="v1" begin="01:08.840" end="01:15.010">The saddest thing I've ever seen</p><p ttm:agent="v1" begin="01:15.010" end="01:17.080">And you never knew</p><p ttm:agent="v1" begin="01:17.080" end="01:21.220">How much I really liked you</p><p ttm:agent="v1" begin="01:21.220" end="01:24.420">Because I never even told you</p><p ttm:agent="v1" begin="01:24.420" end="01:27.940">Oh, and I meant to</p><p ttm:agent="v1" begin="01:27.940" end="01:34.460">Are you still there?</p><p ttm:agent="v1" begin="01:34.460" end="01:41.070">Or have you moved away?</p><p ttm:agent="v1" begin="01:41.070" end="01:46.810">Or have you moved away?</p><p ttm:agent="v1" begin="01:46.810" end="01:54.810" /><p ttm:agent="v1" begin="01:58.900" end="02:03.080">I would love to go</p><p ttm:agent="v1" begin="02:03.080" end="02:07.430">Back to the old house</p><p ttm:agent="v1" begin="02:07.430" end="02:10.930">But I never will</p><p ttm:agent="v1" begin="02:10.930" end="02:18.930">I never will, I never will</p><p ttm:agent="v1" begin="02:20.290" end="02:26.880">I never will</p><p ttm:agent="v1" begin="02:26.880" end="02:30.880" /></div></body></tt>