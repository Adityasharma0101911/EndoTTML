<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>unconditionally</ttm:title><ttm:agent type="person" xml:id="v1">Takayoshi</ttm:agent><ttm:item type="album">unconditionally</ttm:item><ttm:item type="spotify_id">54CwEH4WvwMvoPPoOstJy7</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.000" end="00:03.370">I say I don't know</p><p ttm:agent="v1" begin="00:03.370" end="00:05.354">Because all the words that I say</p><p ttm:agent="v1" begin="00:05.354" end="00:07.823">Go out the door when you look at me</p><p ttm:agent="v1" begin="00:07.823" end="00:09.907">It's been way too long</p><p ttm:agent="v1" begin="00:09.907" end="00:14.054">I got to push the days</p><p ttm:agent="v1" begin="00:14.054" end="00:16.204">Because you think I'm going to change</p><p ttm:agent="v1" begin="00:16.204" end="00:18.291">But I won't stay the same</p><p ttm:agent="v1" begin="00:18.291" end="00:22.013">Because my love for you always grows</p><p ttm:agent="v1" begin="00:22.013" end="00:24.128">I promise I won't fade</p><p ttm:agent="v1" begin="00:24.128" end="00:26.024">I'll take a bet and wait</p><p ttm:agent="v1" begin="00:26.024" end="00:30.117">But deep inside I already won</p><p ttm:agent="v1" begin="00:30.117" end="00:36.798">Because I know I love you unconditionally</p><p ttm:agent="v1" begin="00:36.798" end="00:39.261" /><p ttm:agent="v1" begin="00:39.261" end="00:42.900">Call me it's another day I hate</p><p ttm:agent="v1" begin="00:42.900" end="00:45.863">The way I'm missing you</p><p ttm:agent="v1" begin="00:45.863" end="00:48.811">And I'm coming through to you</p><p ttm:agent="v1" begin="00:48.811" end="00:52.644">Let's be patient on the way</p><p ttm:agent="v1" begin="00:52.644" end="00:54.978">Because you think I'm going to change</p><p ttm:agent="v1" begin="00:54.978" end="00:56.979">But I won't stay the same</p><p ttm:agent="v1" begin="00:56.979" end="01:00.694">Because my love for you always grows</p><p ttm:agent="v1" begin="01:00.694" end="01:02.715">I promise I won't fade</p><p ttm:agent="v1" begin="01:02.715" end="01:04.631">I'll take a bet and wait</p><p ttm:agent="v1" begin="01:04.631" end="01:08.161">But deep inside I already won</p><p ttm:agent="v1" begin="01:08.161" end="01:12.161">Because I know I love you unconditionally</p></div></body></tt>