<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>apart of me</ttm:title>
      <ttm:agent type="person" xml:id="v1">Takayoshi</ttm:agent>
      <ttm:item type="album">apart of me</ttm:item>
      <ttm:item type="spotify_id">2D79qw6Zobv0O7MMD74V6C</ttm:item>
      <itunes:duration>01:16.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:14.520" end="00:17.070" ttm:agent="v1">You say I don't want to go</p>
      <p begin="00:17.070" end="00:18.630" ttm:agent="v1">Baby don't cry</p>
      <p begin="00:18.630" end="00:21.490" ttm:agent="v1">Hope you don't cry</p>
      <p begin="00:21.490" end="00:23.830" ttm:agent="v1">You say you're going to be alone</p>
      <p begin="00:23.830" end="00:27.330" ttm:agent="v1">I'll see you next time</p>
      <p begin="00:27.330" end="00:30.680" ttm:agent="v1">I don't care</p>
      <p begin="00:30.680" end="00:34.290" ttm:agent="v1">Just talk to me</p>
      <p begin="00:34.290" end="00:37.210" ttm:agent="v1">Forever in love</p>
      <p begin="00:37.210" end="00:42.310" ttm:agent="v1">You're apart of me</p>
      <p begin="00:42.310" end="00:43.920" ttm:agent="v1">All alone in your bed</p>
      <p begin="00:43.920" end="00:45.830" ttm:agent="v1">You should let me come through</p>
      <p begin="00:45.830" end="00:49.810" ttm:agent="v1">Missing you write a song and now i'm singing for you</p>
      <p begin="00:49.810" end="00:54.790" ttm:agent="v1">Because I can't get enough of you</p>
      <p begin="00:54.790" end="00:58.160" ttm:agent="v1">I don't care</p>
      <p begin="00:58.160" end="01:01.470" ttm:agent="v1">Just talk to me</p>
      <p begin="01:01.470" end="01:04.650" ttm:agent="v1">Forever in love</p>
      <p begin="01:04.650" end="01:12.650" ttm:agent="v1">You're apart of me</p>
      <p begin="01:15.310" end="01:19.310" ttm:agent="v1"/>
    </div>
  </body>
