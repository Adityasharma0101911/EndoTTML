<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>apart of me - sped up</ttm:title><ttm:agent type="person" xml:id="v1">Takayoshi</ttm:agent><ttm:item type="album">apart of me</ttm:item><ttm:item type="spotify_id">2ZRjaSlCnlfZ0dpxyFhS0d</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:11.360" end="00:13.390">You say I don't want to go</p><p ttm:agent="v1" begin="00:13.390" end="00:14.890">Baby don't cry</p><p ttm:agent="v1" begin="00:14.780" end="00:16.930">Hope you don't cry</p><p ttm:agent="v1" begin="00:16.930" end="00:18.900">You say you're going to be alone</p><p ttm:agent="v1" begin="00:18.900" end="00:21.910">I'll see you next time</p><p ttm:agent="v1" begin="00:21.910" end="00:24.590">I don't care</p><p ttm:agent="v1" begin="00:24.590" end="00:27.350">Just talk to me</p><p ttm:agent="v1" begin="00:27.350" end="00:29.950">Forever in love</p><p ttm:agent="v1" begin="00:29.950" end="00:34.230">You're apart of me</p><p ttm:agent="v1" begin="00:34.230" end="00:35.730">All alone in your bed</p><p ttm:agent="v1" begin="00:35.700" end="00:37.200">You should let me come through</p><p ttm:agent="v1" begin="00:37.160" end="00:40.020">Missing you write a song and now i'm singing for you</p><p ttm:agent="v1" begin="00:40.020" end="00:44.480">because I can't get enough of you</p><p ttm:agent="v1" begin="00:44.480" end="00:47.090">I don't care</p><p ttm:agent="v1" begin="00:47.090" end="00:50.010">Just talk to me</p><p ttm:agent="v1" begin="00:50.010" end="00:52.520">Forever in love</p><p ttm:agent="v1" begin="00:52.520" end="00:56.520">You're apart of me</p></div></body></tt>