<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Chest Pain (I Love)</ttm:title>
      <ttm:agent type="person" xml:id="v1">Malcolm Todd</ttm:agent>
      <ttm:item type="album">Chest Pain (I Love)</ttm:item>
      <ttm:item type="spotify_id">3gPYoFtn70aTgl546XVSET</ttm:item>
      <itunes:duration>03:22.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:00.000" end="00:01.500" ttm:agent="v1"/>
      <p begin="00:00.470" end="00:03.080" ttm:agent="v1">My chest is hurting</p>
      <p begin="00:03.080" end="00:05.870" ttm:agent="v1">My feet can't fall out of bed</p>
      <p begin="00:05.870" end="00:10.750" ttm:agent="v1">I don't know where to go so I'll lay here instead</p>
      <p begin="00:10.750" end="00:15.360" ttm:agent="v1">With my symptoms, symptoms of sorrow and dread</p>
      <p begin="00:15.360" end="00:20.710" ttm:agent="v1">They all said it would fade, but again and again</p>
      <p begin="00:20.710" end="00:23.070" ttm:agent="v1">I love</p>
      <p begin="00:23.070" end="00:25.430" ttm:agent="v1">I love</p>
      <p begin="00:25.430" end="00:30.280" ttm:agent="v1">I love, I love, I love</p>
      <p begin="00:30.280" end="00:32.710" ttm:agent="v1">I love</p>
      <p begin="00:32.710" end="00:35.030" ttm:agent="v1">I love</p>
      <p begin="00:35.030" end="00:41.500" ttm:agent="v1">I love</p>
      <p begin="00:41.500" end="00:44.940" ttm:agent="v1">I've been so busy</p>
      <p begin="00:44.940" end="00:49.060" ttm:agent="v1">But now that I'm alone, where did you go</p>
      <p begin="00:49.060" end="00:52.230" ttm:agent="v1">Tell me why</p>
      <p begin="00:52.230" end="00:59.140" ttm:agent="v1">Why can't you live at home tonight and stay with me inside</p>
      <p begin="00:59.140" end="01:03.060" ttm:agent="v1">It's nice</p>
      <p begin="01:03.060" end="01:08.020" ttm:agent="v1">Please I wanna see what we would be if you were by my side</p>
      <p begin="01:08.020" end="01:10.340" ttm:agent="v1">Make me feel lonely soon</p>
      <p begin="01:10.340" end="01:15.210" ttm:agent="v1">You might not know me, I wish I could lie</p>
      <p begin="01:15.210" end="01:17.500" ttm:agent="v1">But I can't deny</p>
      <p begin="01:17.500" end="01:19.850" ttm:agent="v1">My chest is hurting</p>
      <p begin="01:19.850" end="01:22.530" ttm:agent="v1">My feet can't fall out of bed</p>
      <p begin="01:22.530" end="01:27.460" ttm:agent="v1">I don't know where to go so I'll lay here instead</p>
      <p begin="01:27.460" end="01:31.960" ttm:agent="v1">With my symptoms, symptoms of sorrow and dread</p>
      <p begin="01:31.960" end="01:37.480" ttm:agent="v1">They all said it would fade but again and again</p>
      <p begin="01:37.480" end="01:39.920" ttm:agent="v1">I love</p>
      <p begin="01:39.920" end="01:42.280" ttm:agent="v1">I love</p>
      <p begin="01:42.280" end="01:47.130" ttm:agent="v1">I love, I love, I love</p>
      <p begin="01:47.130" end="01:49.480" ttm:agent="v1">I love</p>
      <p begin="01:49.480" end="01:51.850" ttm:agent="v1">I love</p>
      <p begin="01:51.850" end="01:56.760" ttm:agent="v1">I love</p>
      <p begin="01:56.760" end="02:04.760" ttm:agent="v1"/>
      <p begin="02:16.930" end="02:20.250" ttm:agent="v1">I'm hurting, I'm stuck in my bed</p>
      <p begin="02:20.250" end="02:25.090" ttm:agent="v1">I don't know where to go so I'll lay here instead</p>
      <p begin="02:25.090" end="02:29.690" ttm:agent="v1">With my symptoms, symptoms of sorrow and dread</p>
      <p begin="02:29.690" end="02:35.100" ttm:agent="v1">They all said it would fade, but again and again</p>
      <p begin="02:35.100" end="02:37.530" ttm:agent="v1">I love</p>
      <p begin="02:37.530" end="02:39.900" ttm:agent="v1">I love</p>
      <p begin="02:39.900" end="02:44.730" ttm:agent="v1">I love, I love, I love</p>
      <p begin="02:44.730" end="02:47.090" ttm:agent="v1">I love</p>
      <p begin="02:47.090" end="02:49.530" ttm:agent="v1">I love</p>
      <p begin="02:49.530" end="02:54.780" ttm:agent="v1">I love, I love, uh huh</p>
      <p begin="02:54.780" end="02:58.780" ttm:agent="v1"/>
    </div>
  </body>
</tt>
