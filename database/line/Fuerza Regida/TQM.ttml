<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>TQM</ttm:title><ttm:agent type="person" xml:id="v1">Fuerza Regida</ttm:agent><ttm:item type="album">TQM</ttm:item><ttm:item type="spotify_id">368eeEO3Y2uZUQ6S5oIjcu</ttm:item><itunes:duration>02:38.000</itunes:duration></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:06.180" end="00:14.180" /><p ttm:agent="v1" begin="00:25.360" end="00:28.160">De Psycho Bunny o de Burberry</p><p ttm:agent="v1" begin="00:28.160" end="00:31.120">Fumando pura motita cherry</p><p ttm:agent="v1" begin="00:31.120" end="00:33.940">Super dorada cacha de San Judas</p><p ttm:agent="v1" begin="00:33.940" end="00:36.790">Las morras fresas me ponen débil</p><p ttm:agent="v1" begin="00:36.790" end="00:40.970">Una gorrita de esas del pescado tapan la mirada</p><p ttm:agent="v1" begin="00:40.970" end="00:42.620">Poco saben de mí</p><p ttm:agent="v1" begin="00:42.620" end="00:45.460">Venadeando voy metiendo goles</p><p ttm:agent="v1" begin="00:45.460" end="00:48.210">Y en el putero me dicen "El Baby"</p><p ttm:agent="v1" begin="00:48.210" end="00:50.220" /><p ttm:agent="v1" begin="00:50.220" end="00:53.950">Me dicen "TQM" cuando ven el BM</p><p ttm:agent="v1" begin="00:53.950" end="00:56.940">Voy partiendo el queso de JGL</p><p ttm:agent="v1" begin="00:56.940" end="00:59.890">Siempre oloroso Le Labo me quiere</p><p ttm:agent="v1" begin="00:59.890" end="01:03.420">Haciendo feria consigna de Iván y vienen</p><p ttm:agent="v1" begin="01:03.420" end="01:05.850" /><p ttm:agent="v1" begin="01:05.850" end="01:07.350">A huevo viejo</p><p ttm:agent="v1" begin="01:06.700" end="01:09.770" /><p ttm:agent="v1" begin="01:09.770" end="01:14.640">Y pura Fuerza Regida viejo</p><p ttm:agent="v1" begin="01:14.640" end="01:21.460" /><p ttm:agent="v1" begin="01:21.460" end="01:23.440">Otro pedo viejo</p><p ttm:agent="v1" begin="01:23.440" end="01:24.940" /><p ttm:agent="v1" begin="01:24.090" end="01:25.590">Como siempre a la verga</p><p ttm:agent="v1" begin="01:25.530" end="01:27.220" /><p ttm:agent="v1" begin="01:27.220" end="01:30.120">Ya ando enfiestado y parece un festín</p><p ttm:agent="v1" begin="01:30.120" end="01:33.080">Quiero despertar mirando a esta perri</p><p ttm:agent="v1" begin="01:33.080" end="01:35.860">Perrillo trucha que no anda de oqui'</p><p ttm:agent="v1" begin="01:35.860" end="01:38.840">Y esta princesa pide que le dé un kiss</p><p ttm:agent="v1" begin="01:38.840" end="01:41.590">Cinco redondas son los anillos</p><p ttm:agent="v1" begin="01:41.590" end="01:44.490">Pa' un imprevisto que me saquen de aquí</p><p ttm:agent="v1" begin="01:44.490" end="01:47.290">Rumbo pa'l depa ya suena "Pepas"</p><p ttm:agent="v1" begin="01:47.290" end="01:50.430">Ya ando bien Travis tráiganme a la Kylie</p><p ttm:agent="v1" begin="01:50.430" end="01:52.180" /><p ttm:agent="v1" begin="01:52.180" end="01:55.820">Me dicen "TQM" cuando ven el BM</p><p ttm:agent="v1" begin="01:55.820" end="01:58.840">Voy partiendo el queso de JGL</p><p ttm:agent="v1" begin="01:58.840" end="02:01.790">Siempre oloroso Le Labo me quiere</p><p ttm:agent="v1" begin="02:01.790" end="02:04.900">Haciendo feria consigna de Iván y vienen</p><p ttm:agent="v1" begin="02:04.900" end="02:09.170" /><p ttm:agent="v1" begin="02:09.170" end="02:10.670">Arriba la mafia viejo</p><p ttm:agent="v1" begin="02:10.320" end="02:11.820" /><p ttm:agent="v1" begin="02:11.370" end="02:12.870">Street Mob Records</p><p ttm:agent="v1" begin="02:12.410" end="02:13.910" /><p ttm:agent="v1" begin="02:13.730" end="02:15.230">Empresa SM</p><p ttm:agent="v1" begin="02:14.740" end="02:19.050" /><p ttm:agent="v1" begin="02:19.050" end="02:23.050">Aquí seguimos generando pariente</p></div></body></tt>