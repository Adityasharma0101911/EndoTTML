  <head>
    <metadata>
      <ttm:title>Pretty Lips</ttm:title>
      <ttm:agent type="person" xml:id="v1">WINEHOUSE</ttm:agent>
      <ttm:item type="album">Pretty Lips</ttm:item>
      <ttm:item type="spotify_id">1pzAjKbxaG6MytLEpv8S2J</ttm:item>
      <itunes:duration>04:55.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
