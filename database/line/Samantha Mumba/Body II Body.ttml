<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Body II Body</ttm:title><ttm:agent type="person" xml:id="v1">Samantha Mumba</ttm:agent><ttm:item type="album">Gotta Tell You</ttm:item><ttm:item type="spotify_id">29mlXUONiZNuHn7euEes7v</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.000" end="00:01.890">body to body</p><p ttm:agent="v1" begin="00:01.890" end="00:03.930">funky to funky</p><p ttm:agent="v1" begin="00:03.930" end="00:11.930">we know how to rock your party</p><p ttm:agent="v1" begin="00:27.810" end="00:29.310">mama said</p><p ttm:agent="v1" begin="00:28.580" end="00:31.340" /><p ttm:agent="v1" begin="00:31.340" end="00:35.020">'don't you play around town'</p><p ttm:agent="v1" begin="00:35.020" end="00:39.170">but i just can't control myself</p><p ttm:agent="v1" begin="00:39.170" end="00:41.400">picking up that boy tonight</p><p ttm:agent="v1" begin="00:41.400" end="00:43.810">ain't gonna put him down 'til it feels all right</p><p ttm:agent="v1" begin="00:43.810" end="00:45.960">people stop and stare</p><p ttm:agent="v1" begin="00:45.960" end="00:47.900">'cos he's looking fair</p><p ttm:agent="v1" begin="00:47.900" end="00:51.740">come on over baby let me show you how i care</p><p ttm:agent="v1" begin="00:51.740" end="00:55.730">how do we</p><p ttm:agent="v1" begin="00:55.730" end="00:57.230">my biorhythm's jumping</p><p ttm:agent="v1" begin="00:57.100" end="00:59.580">got my circulation pumping</p><p ttm:agent="v1" begin="00:59.580" end="01:01.080">we are</p><p ttm:agent="v1" begin="01:00.050" end="01:01.780">body to body</p><p ttm:agent="v1" begin="01:01.780" end="01:04.050">funk to funky</p><p ttm:agent="v1" begin="01:04.050" end="01:10.470">we know how to rock your party</p><p ttm:agent="v1" begin="01:10.470" end="01:12.080">oh oh oh</p><p ttm:agent="v1" begin="01:12.080" end="01:14.120">body to body body to body</p><p ttm:agent="v1" begin="01:14.120" end="01:15.690">funk to funky</p><p ttm:agent="v1" begin="01:15.690" end="01:19.900">we know how we're wreckin' up your party</p><p ttm:agent="v1" begin="01:19.900" end="01:23.670" /><p ttm:agent="v1" begin="01:23.670" end="01:25.170">it's physical</p><p ttm:agent="v1" begin="01:24.330" end="01:26.850" /><p ttm:agent="v1" begin="01:26.850" end="01:29.980">not just spiritual attraction</p><p ttm:agent="v1" begin="01:29.980" end="01:35.290">i hear you coming when i ring the dinner bell</p><p ttm:agent="v1" begin="01:35.290" end="01:37.390">got my phaser set to stun</p><p ttm:agent="v1" begin="01:37.390" end="01:38.980">now we're gonna have some fun</p><p ttm:agent="v1" begin="01:38.980" end="01:41.450">i got my people up inside</p><p ttm:agent="v1" begin="01:41.450" end="01:43.640">baby wanna ride</p><p ttm:agent="v1" begin="01:43.640" end="01:46.890">party's fairly jumping but we're gonna have to slide</p><p ttm:agent="v1" begin="01:46.890" end="01:51.180">i need a miracle</p><p ttm:agent="v1" begin="01:51.180" end="01:53.300">turn it up a little higher</p><p ttm:agent="v1" begin="01:53.300" end="01:55.080">the roof is on fire</p><p ttm:agent="v1" begin="01:55.080" end="01:56.580">we are</p><p ttm:agent="v1" begin="01:56.110" end="01:58.010">body to body body to body</p><p ttm:agent="v1" begin="01:58.010" end="01:59.510">funk to funky</p><p ttm:agent="v1" begin="01:58.810" end="02:00.310" /><p ttm:agent="v1" begin="01:59.850" end="02:07.690">we know how to rock your party yeah</p><p ttm:agent="v1" begin="02:07.690" end="02:09.340">body to body</p><p ttm:agent="v1" begin="02:09.340" end="02:11.340">funky to funky</p><p ttm:agent="v1" begin="02:11.340" end="02:12.850">we're coming in your house</p><p ttm:agent="v1" begin="02:12.850" end="02:15.370">we know how we're wreckin' up your party</p><p ttm:agent="v1" begin="02:15.370" end="02:18.680">struck out another line</p><p ttm:agent="v1" begin="02:18.680" end="02:26.680">making an all time flow</p><p ttm:agent="v1" begin="02:27.570" end="02:29.280">my mama said</p><p ttm:agent="v1" begin="02:29.280" end="02:31.120">'to get things done</p><p ttm:agent="v1" begin="02:31.120" end="02:32.650">you gotta go to school</p><p ttm:agent="v1" begin="02:32.650" end="02:35.460">ain't gonna have no fun' have no fun</p><p ttm:agent="v1" begin="02:35.460" end="02:37.060">my mama said</p><p ttm:agent="v1" begin="02:37.060" end="02:39.710">'you're still too young still too young</p><p ttm:agent="v1" begin="02:39.710" end="02:41.210">you gotta slow it down</p><p ttm:agent="v1" begin="02:40.710" end="02:42.970">ain't gonna have no fun'</p><p ttm:agent="v1" begin="02:42.970" end="02:44.610">no no</p><p ttm:agent="v1" begin="02:44.610" end="02:46.110">cos we are</p><p ttm:agent="v1" begin="02:45.510" end="02:47.010">cos we are</p><p ttm:agent="v1" begin="02:46.250" end="02:47.750">cos we are</p><p ttm:agent="v1" begin="02:47.200" end="02:48.970">body to body</p><p ttm:agent="v1" begin="02:48.970" end="02:50.990">funk to funky</p><p ttm:agent="v1" begin="02:50.990" end="02:58.990">we know how to rock your party rock your party baby</p><p ttm:agent="v1" begin="02:59.210" end="03:00.950">body to body</p><p ttm:agent="v1" begin="03:00.950" end="03:02.880">funky to funky</p><p ttm:agent="v1" begin="03:02.880" end="03:04.460">we're coming in your house</p><p ttm:agent="v1" begin="03:04.460" end="03:07.650">we know how we're wreckin up your party wreckin' up your party</p><p ttm:agent="v1" begin="03:07.650" end="03:10.890">struck out another line</p><p ttm:agent="v1" begin="03:10.890" end="03:14.890">making an all time flow</p></div></body></tt>