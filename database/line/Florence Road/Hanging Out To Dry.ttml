<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Hanging Out To Dry</ttm:title><ttm:agent type="person" xml:id="v1">Florence Road</ttm:agent><ttm:item type="album">Spring Forward</ttm:item><ttm:item type="spotify_id">1GZ5KqHOdkU0cZoz1JfQo8</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.011" end="00:01.660" itunes:key="role" itunes:value="background">(One, two)</p><p ttm:agent="v1" begin="00:01.660" end="00:09.660" itunes:key="role" itunes:value="background">(One, two, three, four)</p><p ttm:agent="v1" begin="00:10.550" end="00:17.100">I broke my tooth</p><p ttm:agent="v1" begin="00:17.100" end="00:23.994">On the way out of your room</p><p ttm:agent="v1" begin="00:23.994" end="00:27.487">Called you over, are you over?</p><p ttm:agent="v1" begin="00:27.487" end="00:30.621">You don't even look me over</p><p ttm:agent="v1" begin="00:30.621" end="00:34.265">Yes, I lied</p><p ttm:agent="v1" begin="00:34.265" end="00:38.334">I lied</p><p ttm:agent="v1" begin="00:38.334" end="00:41.619">Don't wait up</p><p ttm:agent="v1" begin="00:41.619" end="00:45.044">Don't wait up</p><p ttm:agent="v1" begin="00:45.044" end="00:48.854">Just wait up</p><p ttm:agent="v1" begin="00:48.854" end="00:50.354">Ah!</p><p ttm:agent="v1" begin="00:50.097" end="00:53.806">Trust me, I'm not falling</p><p ttm:agent="v1" begin="00:53.806" end="00:57.058">No supеrsonic heartbeats in the morning</p><p ttm:agent="v1" begin="00:57.058" end="01:00.700">Don't trust mе, I might fall in</p><p ttm:agent="v1" begin="01:00.700" end="01:04.285">I never think about you at all</p><p ttm:agent="v1" begin="01:04.285" end="01:08.646">Leave me hanging out to dry</p><p ttm:agent="v1" begin="01:08.646" end="01:11.414">Yeah, I'm hanging around</p><p ttm:agent="v1" begin="01:11.414" end="01:19.414">Leave me hanging out to dry</p><p ttm:agent="v1" begin="01:20.519" end="01:24.052">Wonder if I'm square</p><p ttm:agent="v1" begin="01:24.052" end="01:31.021">Is the grass greener over there?</p><p ttm:agent="v1" begin="01:31.021" end="01:32.805">Do you like me?</p><p ttm:agent="v1" begin="01:32.805" end="01:34.597">Do you want me?</p><p ttm:agent="v1" begin="01:34.597" end="01:41.266">Did you know I'm pretty funny if I try?</p><p ttm:agent="v1" begin="01:41.266" end="01:45.111">I try</p><p ttm:agent="v1" begin="01:45.111" end="01:48.537">Don't wait up</p><p ttm:agent="v1" begin="01:48.537" end="01:52.355">Just wait up</p><p ttm:agent="v1" begin="01:52.355" end="01:53.855">Ah!</p><p ttm:agent="v1" begin="01:53.662" end="01:57.040">Trust me, I'm not falling</p><p ttm:agent="v1" begin="01:57.040" end="02:00.576">No supеrsonic heartbeats in the morning</p><p ttm:agent="v1" begin="02:00.576" end="02:04.910">Don't trust mе, I might fall in</p><p ttm:agent="v1" begin="02:04.910" end="02:07.794">I never think about you at all</p><p ttm:agent="v1" begin="02:07.794" end="02:12.138">Leave me hanging out to dry</p><p ttm:agent="v1" begin="02:12.138" end="02:14.914">Yeah, I'm hanging around</p><p ttm:agent="v1" begin="02:14.914" end="02:22.914">Leave me hanging out to dry</p><p ttm:agent="v1" begin="02:35.622" end="02:42.808">Don't trust me, I might fall in, in</p><p ttm:agent="v1" begin="02:42.808" end="02:50.103">Don't trust me, I might fall in</p><p ttm:agent="v1" begin="02:50.103" end="02:54.571">Leave me hanging out to dry</p><p ttm:agent="v1" begin="02:54.571" end="02:57.290">Yeah, I'm hanging around</p><p ttm:agent="v1" begin="02:57.290" end="03:01.591">Leave me hanging out to dry</p><p ttm:agent="v1" begin="03:01.591" end="03:04.342">Yeah, I'm hanging around</p><p ttm:agent="v1" begin="03:04.342" end="03:08.662">Leave me hanging out to dry</p><p ttm:agent="v1" begin="03:08.662" end="03:11.370">Yeah, I'm hanging around</p><p ttm:agent="v1" begin="03:11.370" end="03:15.714">Leave me hanging out to dry</p><p ttm:agent="v1" begin="03:15.714" end="03:19.714">Yeah, I'm hanging around</p></div></body></tt>