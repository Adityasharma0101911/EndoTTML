<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>hypnotized</ttm:title>
      <ttm:agent type="person" xml:id="v1">Minh</ttm:agent>
      <ttm:item type="album">hypnotized</ttm:item>
      <ttm:item type="spotify_id">6ktQAWJH0d6BbMJyrs3aQO</ttm:item>
      <itunes:duration>02:18.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:09.340" end="00:11.660" ttm:agent="v1">You said you need some space</p>
      <p begin="00:11.660" end="00:13.820" ttm:agent="v1">You need some time away</p>
      <p begin="00:13.820" end="00:16.220" ttm:agent="v1">But you keep calling me back</p>
      <p begin="00:16.220" end="00:18.540" ttm:agent="v1">Wishing that I would stay</p>
      <p begin="00:18.540" end="00:20.710" ttm:agent="v1">Oh don't you waste my time</p>
      <p begin="00:20.710" end="00:23.070" ttm:agent="v1">Told you to hit my line</p>
      <p begin="00:23.070" end="00:25.420" ttm:agent="v1">Girl if you want me then tell me</p>
      <p begin="00:25.420" end="00:27.430" ttm:agent="v1">Baby make up your mind</p>
      <p begin="00:27.430" end="00:29.330" ttm:agent="v1">No control</p>
      <p begin="00:29.330" end="00:32.080" ttm:agent="v1">Girl you got me hypnotized</p>
      <p begin="00:32.080" end="00:34.250" ttm:agent="v1">Wrapped around your finger baby</p>
      <p begin="00:34.250" end="00:36.590" ttm:agent="v1">I can't get you off my mind</p>
      <p begin="00:36.590" end="00:38.450" ttm:agent="v1">Heart and soul</p>
      <p begin="00:38.450" end="00:41.190" ttm:agent="v1">I would give you all of mine</p>
      <p begin="00:41.190" end="00:42.770" ttm:agent="v1">Way you got me trippin</p>
      <p begin="00:42.770" end="00:50.770" ttm:agent="v1">Like every time I look in your eyes</p>
      <p begin="00:53.080" end="00:55.180" ttm:agent="v1" itunes:key="role" itunes:value="background">(2, 3, 4)</p>
      <p begin="00:55.180" end="00:57.300" ttm:agent="v1">Wear my heart on my sleeve</p>
      <p begin="00:57.300" end="00:59.630" ttm:agent="v1">You got me on a string</p>
      <p begin="00:59.630" end="01:02.470" ttm:agent="v1">I keep on running but coming back</p>
      <p begin="01:02.470" end="01:04.160" ttm:agent="v1">And honestly</p>
      <p begin="01:04.160" end="01:06.570" ttm:agent="v1">Don't know what's wrong with me</p>
      <p begin="01:06.570" end="01:09.010" ttm:agent="v1">You know it's hard for me</p>
      <p begin="01:09.010" end="01:10.540" ttm:agent="v1">Where you are is the</p>
      <p begin="01:10.540" end="01:14.220" ttm:agent="v1">Only place I wanna be</p>
      <p begin="01:14.220" end="01:16.570" ttm:agent="v1">Caught my attention</p>
      <p begin="01:16.570" end="01:18.720" ttm:agent="v1">Need your affection</p>
      <p begin="01:18.720" end="01:20.220" ttm:agent="v1">Act like you don't</p>
      <p begin="01:20.060" end="01:22.380" ttm:agent="v1">But I know you feel the tension</p>
      <p begin="01:22.380" end="01:24.230" ttm:agent="v1">No control</p>
      <p begin="01:24.230" end="01:26.790" ttm:agent="v1">Girl you got me hypnotized</p>
      <p begin="01:26.790" end="01:29.150" ttm:agent="v1">Wrapped around your finger baby</p>
      <p begin="01:29.150" end="01:31.460" ttm:agent="v1">I can't get you off my mind</p>
      <p begin="01:31.460" end="01:33.410" ttm:agent="v1">Heart and soul</p>
      <p begin="01:33.410" end="01:35.980" ttm:agent="v1">I would give you all of mine</p>
      <p begin="01:35.980" end="01:37.770" ttm:agent="v1">Way you got me trippin</p>
      <p begin="01:37.770" end="01:40.690" ttm:agent="v1">Like every time I look in your eyes</p>
      <p begin="01:40.690" end="01:45.110" ttm:agent="v1">I can't take my eyes off you</p>
      <p begin="01:45.110" end="01:49.500" ttm:agent="v1">My heart aches I still want you</p>
      <p begin="01:49.500" end="01:53.500" ttm:agent="v1"/>
    </div>
  </body>
</tt>
