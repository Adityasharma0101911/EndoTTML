<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>worst days</ttm:title><ttm:agent type="person" xml:id="v1">PRYVT</ttm:agent><ttm:item type="album">&amp;SCENE</ttm:item><ttm:item type="spotify_id">3Jz4NOB1zQgrPSinNdsqEo</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:25.148" end="00:28.178">Time is slowing down</p><p ttm:agent="v1" begin="00:28.178" end="00:30.646">I'm stuck here, a lot</p><p ttm:agent="v1" begin="00:30.646" end="00:34.166">Make amends with love</p><p ttm:agent="v1" begin="00:34.166" end="00:37.680">Enough is enough</p><p ttm:agent="v1" begin="00:37.680" end="00:40.096">I'm tired I’m done</p><p ttm:agent="v1" begin="00:40.096" end="00:47.509">Erase me from here now</p><p ttm:agent="v1" begin="00:47.509" end="00:50.289">I don't wanna feel loved</p><p ttm:agent="v1" begin="00:50.289" end="00:53.306">Tired of the cold hearts</p><p ttm:agent="v1" begin="00:53.306" end="00:55.456">I been walking thru the fog</p><p ttm:agent="v1" begin="00:55.456" end="00:58.513">Cause I just wanna see someone</p><p ttm:agent="v1" begin="00:58.513" end="01:00.013">Feel somebody</p><p ttm:agent="v1" begin="00:59.716" end="01:01.915">I been living thru my worst days ya</p><p ttm:agent="v1" begin="01:01.915" end="01:04.917">I been going thru hell n back</p><p ttm:agent="v1" begin="01:04.917" end="01:08.232">I'm always getting too attached</p><p ttm:agent="v1" begin="01:08.232" end="01:12.814">Got me singing like</p><p ttm:agent="v1" begin="01:12.814" end="01:20.814" /><p ttm:agent="v1" begin="01:37.186" end="01:40.344">There’s people laughing and tears are falling</p><p ttm:agent="v1" begin="01:40.344" end="01:43.290">Their feelings come alive</p><p ttm:agent="v1" begin="01:43.290" end="01:46.479">My situations getting to me</p><p ttm:agent="v1" begin="01:46.479" end="01:49.320">I don't know what’s right</p><p ttm:agent="v1" begin="01:49.320" end="01:52.517">I don't know what it's like</p><p ttm:agent="v1" begin="01:52.517" end="01:59.411">Just want to understand</p><p ttm:agent="v1" begin="01:59.411" end="02:02.389">I don't wanna feel loved</p><p ttm:agent="v1" begin="02:02.389" end="02:05.175">Tired of the cold hearts</p><p ttm:agent="v1" begin="02:05.175" end="02:07.237">I been walking thru the fog</p><p ttm:agent="v1" begin="02:07.237" end="02:10.593">Cause I just wanna see someone</p><p ttm:agent="v1" begin="02:10.593" end="02:12.093">Feel somebody</p><p ttm:agent="v1" begin="02:11.612" end="02:14.071">I been living thru my worst days ya</p><p ttm:agent="v1" begin="02:14.071" end="02:16.980">I been going thru hell n back</p><p ttm:agent="v1" begin="02:16.980" end="02:23.397">I'm always getting too attached</p><p ttm:agent="v1" begin="02:23.397" end="02:26.286">I don't wanna feel loved</p><p ttm:agent="v1" begin="02:26.286" end="02:29.276">Tired of the cold hearts</p><p ttm:agent="v1" begin="02:29.276" end="02:31.238">I been walking thru the fog</p><p ttm:agent="v1" begin="02:31.238" end="02:34.543">Cause I just wanna see someone</p><p ttm:agent="v1" begin="02:34.543" end="02:36.043">Feel somebody</p><p ttm:agent="v1" begin="02:35.669" end="02:38.029">I been living thru my worst days ya</p><p ttm:agent="v1" begin="02:38.029" end="02:40.997">I been going thru hell n back</p><p ttm:agent="v1" begin="02:40.997" end="02:47.036">I'm always getting too attached</p><p ttm:agent="v1" begin="02:47.036" end="02:51.036">Got me singing like</p></div></body></tt>