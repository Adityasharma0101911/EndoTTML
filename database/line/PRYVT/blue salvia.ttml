<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>blue salvia</ttm:title>
      <ttm:agent type="person" xml:id="v1">PRYVT</ttm:agent>
      <ttm:item type="album">blue salvia</ttm:item>
      <ttm:item type="spotify_id">3BeRfdDva5tTPCHPYBaGlA</ttm:item>
      <itunes:duration>03:18.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:30.670" end="00:34.220" ttm:agent="v1">It comes to mind</p>
      <p begin="00:34.220" end="00:40.820" ttm:agent="v1">How you're making me smile from a far</p>
      <p begin="00:40.820" end="00:44.750" ttm:agent="v1">Do you feel like me too?</p>
      <p begin="00:44.750" end="00:48.950" ttm:agent="v1">Enough has been said</p>
      <p begin="00:48.950" end="00:52.610" ttm:agent="v1">Cause there's a million people out there</p>
      <p begin="00:52.610" end="00:58.450" ttm:agent="v1">But all i need is you</p>
      <p begin="00:58.450" end="01:05.490" ttm:agent="v1">And i just want to know, about your day</p>
      <p begin="01:05.490" end="01:10.430" ttm:agent="v1">If all is okay with you</p>
      <p begin="01:10.430" end="01:14.870" ttm:agent="v1">We can talk all night and day</p>
      <p begin="01:14.870" end="01:18.460" ttm:agent="v1">You're all thats on my mind</p>
      <p begin="01:18.460" end="01:24.800" ttm:agent="v1">I'm waiting to hear back from you</p>
      <p begin="01:24.800" end="01:29.420" ttm:agent="v1" itunes:key="role" itunes:value="background">(Cause i know no one makes me laugh like you do)</p>
      <p begin="01:29.420" end="01:32.560" ttm:agent="v1">The time flies on by</p>
      <p begin="01:32.560" end="01:36.770" ttm:agent="v1">When my days are with you</p>
      <p begin="01:36.770" end="01:40.360" ttm:agent="v1">You won't understand</p>
      <p begin="01:40.360" end="01:48.360" ttm:agent="v1">My seasons are better with you</p>
      <p begin="01:50.370" end="01:56.000" ttm:agent="v1">It's better with you</p>
      <p begin="01:56.000" end="02:03.680" ttm:agent="v1">I'm always here for you</p>
      <p begin="02:03.680" end="02:07.680" ttm:agent="v1"/>
    </div>
  </body>
</tt>
