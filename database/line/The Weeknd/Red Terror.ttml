<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Red Terror</ttm:title>
      <ttm:agent type="person" xml:id="v1">The Weeknd</ttm:agent>
      <ttm:item type="album">Hurry Up Tomorrow</ttm:item>
      <ttm:item type="spotify_id">717s9KFmHhyy5t3xkStS56</ttm:item>
      <itunes:duration>03:52.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:11.780" end="00:13.860" ttm:agent="v1">Oh, whoa</p>
      <p begin="00:13.860" end="00:16.800" ttm:agent="v1">Oh, whoa</p>
      <p begin="00:16.800" end="00:21.540" ttm:agent="v1">Oh, whoa, whoa</p>
      <p begin="00:21.540" end="00:23.950" ttm:agent="v1">Oh, whoa</p>
      <p begin="00:23.950" end="00:26.560" ttm:agent="v1">Oh, whoa</p>
      <p begin="00:26.560" end="00:30.100" ttm:agent="v1">Oh, whoa, whoa</p>
      <p begin="00:30.100" end="00:38.100" ttm:agent="v1">You're not heavy, I rock you to sleep, I hold you for hours long</p>
      <p begin="00:39.990" end="00:45.510" ttm:agent="v1">Never heavy, I won't let you weep</p>
      <p begin="00:45.510" end="00:53.510" ttm:agent="v1">Hush, my child, you're mine</p>
      <p begin="00:54.490" end="01:02.490" ttm:agent="v1">All my life, I've tried</p>
      <p begin="01:05.560" end="01:11.640" ttm:agent="v1">Oh-oh, you were never heavy, light just like a feather</p>
      <p begin="01:11.640" end="01:16.700" ttm:agent="v1">I ran from the terror, the crowd was led from the left</p>
      <p begin="01:16.700" end="01:21.590" ttm:agent="v1">You were never scary, I knew you were special</p>
      <p begin="01:21.590" end="01:26.240" ttm:agent="v1">My only attention, alone, I left to the west</p>
      <p begin="01:26.240" end="01:30.800" ttm:agent="v1">Then moved to the city, eight months we were pregnant</p>
      <p begin="01:30.800" end="01:35.870" ttm:agent="v1">You came out so precious, in the snow you would grow</p>
      <p begin="01:35.870" end="01:43.500" ttm:agent="v1">Your mama loves you, you'll never be alone</p>
      <p begin="01:43.500" end="01:51.500" ttm:agent="v1" itunes:key="role" itunes:value="background">Hush, my child, you're mine (I know, I know, I know, hey)</p>
      <p begin="01:53.470" end="02:01.470" ttm:agent="v1" itunes:key="role" itunes:value="background">All my life, I've tried (I'm sorry mama, I'm sorry mama, whoa-whoa)</p>
      <p begin="02:02.490" end="02:10.490" ttm:agent="v1" itunes:key="role" itunes:value="background">To keep you warm, if I go (if I go, I feel so cold without you mama, I feel so cold without you, whoa-whoa)</p>
      <p begin="02:11.750" end="02:17.220" ttm:agent="v1">You're still my child, don't cry</p>
      <p begin="02:17.220" end="02:25.220" ttm:agent="v1"/>
      <p begin="02:55.600" end="03:03.410" ttm:agent="v1">Death is nothin' at all, it does not count</p>
      <p begin="03:03.410" end="03:08.790" ttm:agent="v1">I have only slipped away into the next room</p>
      <p begin="03:08.790" end="03:11.810" ttm:agent="v1">Nothin' has happened</p>
      <p begin="03:11.810" end="03:18.130" ttm:agent="v1">Everything remains exactly how it was</p>
      <p begin="03:18.130" end="03:26.130" ttm:agent="v1">I am I, and you are you</p>
      <p begin="03:28.000" end="03:36.000" ttm:agent="v1">And the old life that we lived so fondly together is untouched, unchanged</p>
      <p begin="03:39.130" end="03:47.130" ttm:agent="v1">Whatever we were to each other, that we are still</p>
      <p begin="03:48.250" end="03:50.810" ttm:agent="v1">Call me by the old familiar name</p>
      <p begin="03:50.810" end="03:54.810" ttm:agent="v1"/>
    </div>
  </body>
</tt>
