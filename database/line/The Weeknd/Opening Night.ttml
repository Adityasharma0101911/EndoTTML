<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Opening Night</ttm:title>
      <ttm:agent type="person" xml:id="v1">The Weeknd</ttm:agent>
      <ttm:item type="album">Hurry Up Tomorrow</ttm:item>
      <ttm:item type="spotify_id">4Msr8L0gHGDsLSBlk7pSPU</ttm:item>
      <itunes:duration>01:36.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:22.430" end="00:27.530" ttm:agent="v1">Tell me how our love grows</p>
      <p begin="00:27.530" end="00:32.980" ttm:agent="v1">When you're tryna dig for lies</p>
      <p begin="00:32.980" end="00:38.550" ttm:agent="v1">You're just bein' emotional, mm</p>
      <p begin="00:38.550" end="00:43.550" ttm:agent="v1">When I'm being logical at times</p>
      <p begin="00:43.550" end="00:49.170" ttm:agent="v1">Hate when you're irrational</p>
      <p begin="00:49.170" end="00:54.420" ttm:agent="v1">When I see you chronically online</p>
      <p begin="00:54.420" end="00:59.710" ttm:agent="v1">Why bring this up right now?</p>
      <p begin="00:59.710" end="01:03.110" ttm:agent="v1">You know it's my opening night</p>
      <p begin="01:03.110" end="01:08.950" ttm:agent="v1">Circulation gone, shakin' on the floor</p>
      <p begin="01:08.950" end="01:14.260" ttm:agent="v1">Steroids in my lungs, fighting off the mud</p>
      <p begin="01:14.260" end="01:19.120" ttm:agent="v1">Give me what I want, then we'll start the show</p>
      <p begin="01:19.120" end="01:22.920" ttm:agent="v1">I'm fixing, I'm fixing, oh</p>
      <p begin="01:22.920" end="01:26.920" ttm:agent="v1"/>
    </div>
  </body>
</tt>
