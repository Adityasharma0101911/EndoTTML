<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Final Lullaby - Bonus Track</ttm:title><ttm:agent type="person" xml:id="v1">The Weeknd</ttm:agent><ttm:item type="album">After Hours (Deluxe)</ttm:item><ttm:item type="spotify_id">2wDAD2hRCw8qanm6UjdLpx</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:28.800" end="00:35.390">I'm running out of time</p><p ttm:agent="v1" begin="00:35.390" end="00:42.460">And you'll always be on my mind</p><p ttm:agent="v1" begin="00:42.460" end="00:49.760">And I can't make you stay in this broken place</p><p ttm:agent="v1" begin="00:49.760" end="00:53.040">And I hope you find peace</p><p ttm:agent="v1" begin="00:53.040" end="00:59.610">Close your eyes as I put us to sleep</p><p ttm:agent="v1" begin="00:59.610" end="01:03.770">Finally</p><p ttm:agent="v1" begin="01:03.770" end="01:06.710">To sleep</p><p ttm:agent="v1" begin="01:06.710" end="01:11.020">Finally</p><p ttm:agent="v1" begin="01:11.020" end="01:14.840">And I can't make you stay</p><p ttm:agent="v1" begin="01:14.840" end="01:18.340">In this broken place</p><p ttm:agent="v1" begin="01:18.340" end="01:21.810">And I hope you find peace</p><p ttm:agent="v1" begin="01:21.810" end="01:28.150">Close your eyes as I put us to sleep</p><p ttm:agent="v1" begin="01:28.150" end="01:32.380">Finally</p><p ttm:agent="v1" begin="01:32.380" end="01:35.430">Go to sleep</p><p ttm:agent="v1" begin="01:35.430" end="01:39.860">Finally</p><p ttm:agent="v1" begin="01:39.860" end="01:46.650">Oh-oh, oh, oh-oh</p><p ttm:agent="v1" begin="01:46.650" end="01:54.650">Oh-oh, oh, oh-oh-oh, oh</p><p ttm:agent="v1" begin="01:54.690" end="02:01.420">I'm home alone</p><p ttm:agent="v1" begin="02:01.420" end="02:08.660">My trauma, alone</p><p ttm:agent="v1" begin="02:08.660" end="02:15.870">I can't make you stay in this broken place</p><p ttm:agent="v1" begin="02:15.870" end="02:19.160">Won't you find peace?</p><p ttm:agent="v1" begin="02:19.160" end="02:25.670">Close your eyes and I put us to sleep</p><p ttm:agent="v1" begin="02:25.670" end="02:29.500">Whoa, oh, oh</p><p ttm:agent="v1" begin="02:29.500" end="02:37.070">To sleep, woah</p><p ttm:agent="v1" begin="02:37.070" end="02:40.730">Na-na-na-duh-na-na</p><p ttm:agent="v1" begin="02:40.730" end="02:44.300">Whoa, no, no</p><p ttm:agent="v1" begin="02:44.300" end="02:47.870">Na-na-na-na</p><p ttm:agent="v1" begin="02:47.870" end="02:51.350">Oh, oh, oh</p><p ttm:agent="v1" begin="02:51.350" end="02:52.850">Oh, oh, oh</p><p ttm:agent="v1" begin="02:52.410" end="02:56.410" /></div></body></tt>