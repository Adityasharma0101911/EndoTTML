860">Tum paas aa'e</p><p ttm:agent="v1" begin="01:10.860" end="01:12.970">Yuu'n muskaraa'e</p><p ttm:agent="v1" begin="01:12.970" end="01:14.470" /><p ttm:agent="v1" begin="01:13.480" end="01:16.130">Tum ne na jaane kya</p><p ttm:agent="v1" begin="01:16.130" end="01:18.240">Sapane dikhaa'e</p><p ttm:agent="v1" begin="01:18.240" end="01:19.740" /><p ttm:agent="v1" begin="01:18.770" end="01:21.340">Ab to mera dil</p><p ttm:agent="v1" begin="01:21.340" end="01:23.270">Jaage na sota hai</p><p ttm:agent="v1" begin="01:23.270" end="01:24.770" /><p ttm:agent="v1" begin="01:23.940" end="01:26.580">Kya karuu haa'e</p><p ttm:agent="v1" begin="01:26.580" end="01:29.480">Kuchh kuchh hota hai</p><p ttm:agent="v1" begin="01:29.480" end="01:31.860">Kya karuu haa'e</p><p ttm:agent="v1" begin="01:31.860" end="01:34.140">Kuchh kuchh hota hai</p><p ttm:agent="v1" begin="01:34.140" end="01:35.640" /><p ttm:agent="v1" begin="01:34.700" end="01:37.220">Tum paas aa'e</p><p ttm:agent="v1" begin="01:37.220" end="01:39.700">Yuu'n muskaraa'e</p><p ttm:agent="v1" begin="01:39.700" end="01:42.430">Tum ne na jaane kya</p><p ttm:agent="v1" begin="01:42.430" end="01:45.020">Sapane dikhaa'e</p><p ttm:agent="v1" begin="01:45.020" end="01:47.880">Ab to mera dil</p><p ttm:agent="v1" begin="01:47.880" end="01:50.470">Jaage na sota hai</p><p ttm:agent="v1" begin="01:50.470" end="01:52.920">Kya karuu haa'e</p><p ttm:agent="v1" begin="01:52.920" end="01:55.710">Kuchh kuchh hota hai</p><p ttm:agent="v1" begin="01:55.710" end="01:58.200">Kya karuu haa'e</p><p ttm:agent="v1" begin="01:58.200" end="02:00.840">Kuchh kuchh hota hai</p><p ttm:agent="v1" begin="02:00.840" end="02:08.840" /><p ttm:agent="v1" begin="02:21.200" end="02:25.890">Na jaane kaisa ahasaas hai</p><p ttm:agent="v1" begin="02:25.890" end="02:27.390" /><p ttm:agent="v1" begin="02:26.390" end="02:31.760">Bujhatii nahii hai kya pyaas hai</p><p ttm:agent="v1" begin="02:31.760" end="02:34.630">Kya nasha is pyaar ka</p><p ttm:agent="v1" begin="02:34.630" end="02:39.950">Mujhape sanam'hu chhaane laga</p><p ttm:agent="v1" begin="02:39.950" end="02:45.100">Koii na jaane kyo chain khota hai</p><p ttm:agent="v1" begin="02:45.100" end="02:47.690">Kya karuun haa'e</p><p ttm:agent="v1" begin="02:47.690" end="02:50.570">Kuchh kuchh hota hai</p><p ttm:agent="v1" begin="02:50.570" end="02:53.000">Kya karuu'n haa'e</p><p ttm:agent="v1" begin="02:53.000" end="02:55.650">Kuchh kuchh hota hai</p><p ttm:agent="v1" begin="02:55.650" end="03:03.650" /><p ttm:agent="v1" begin="03:08.430" end="03:16.430">Hahayai hmmmm ahahaaa haaa</p><p ttm:agent="v1" begin="03:21.430" end="03:29.430" /><p ttm:agent="v1" begin="03:31.690" end="03:36.880">Kya ra'ng laaii merii dua</p><p ttm:agent="v1" begin="03:36.880" end="03:42.140">Ye ishq jaane kaise hua</p><p ttm:agent="v1" begin="03:42.140" end="03:45.250">Bechainiyo'n me'n chain</p><p ttm:agent="v1" begin="03:45.250" end="03:47.690">Na jaane kyo'n</p><p ttm:agent="v1" begin="03:47.690" end="03:50.420">Aane laga</p><p ttm:agent="v1" begin="03:50.420" end="03:55.540">Tanhaaii mei dil yaade'n sa'njota hai</p><p ttm:agent="v1" begin="03:55.540" end="03:58.110">Kya karuu'n haa'e</p><p ttm:agent="v1" begin="03:58.110" end="04:00.990">Kuchh kuchh hota hai</p><p ttm:agent="v1" begin="04:00.990" end="04:03.500">Kya karuu'n haa'e</p><p ttm:agent="v1" begin="04:03.500" end="04:06.310">Kuchh kuchh hota hai</p><p ttm:agent="v1" begin="04:06.310" end="04:08.300">Tum paas aa'e</p><p ttm:agent="v1" begin="04:08.300" end="04:09.800" /><p ttm:agent="v1" begin="04:08.800" end="04:11.360">Yuu'n muskaraa'e</p><p ttm:agent="v1" begin="04:11.360" end="04:14.040">Tum ne na jaane kya</p><p ttm:agent="v1" begin="04:14.040" end="04:16.630">Sapane dikhaa'e</p><p ttm:agent="v1" begin="04:16.630" end="04:19.340">Tum paas aa'e</p><p ttm:agent="v1" begin="04:19.340" end="04:21.930">Yuu'n muskaraa'e</p><p ttm:agent="v1" begin="04:21.930" end="04:24.470">Tum ne na jaane kya</p><p ttm:agent="v1" begin="04:24.470" end="04:2