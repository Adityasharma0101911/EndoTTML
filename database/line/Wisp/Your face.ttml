<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Your face</ttm:title><ttm:agent type="person" xml:id="v1">Wisp</ttm:agent><ttm:item type="album">Your face</ttm:item><ttm:item type="spotify_id">5MRWG1owcChqkYFIzsYlMb</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:31.750" end="00:35.097">It's all real?</p><p ttm:agent="v1" begin="00:35.097" end="00:43.097">You're stuck in my head</p><p ttm:agent="v1" begin="00:46.166" end="00:49.779">Drowning</p><p ttm:agent="v1" begin="00:49.779" end="00:57.779">Falling into you</p><p ttm:agent="v1" begin="01:03.793" end="01:08.207">You look at me the same</p><p ttm:agent="v1" begin="01:08.207" end="01:16.207">But I can't reciprocate</p><p ttm:agent="v1" begin="01:18.930" end="01:21.687">Fragrant air</p><p ttm:agent="v1" begin="01:21.687" end="01:29.687">And then I see your face</p><p ttm:agent="v1" begin="01:30.161" end="01:37.325">I see your face</p><p ttm:agent="v1" begin="01:37.325" end="01:45.325">I see your face</p><p ttm:agent="v1" begin="01:49.535" end="01:56.235">I want to feel</p><p ttm:agent="v1" begin="01:56.235" end="02:03.383">Only when I'm with you</p><p ttm:agent="v1" begin="02:03.383" end="02:06.586">Black and White</p><p ttm:agent="v1" begin="02:06.586" end="02:14.586">I'm stuck in the loops of your mind</p><p ttm:agent="v1" begin="02:17.634" end="02:20.853">Black and White</p><p ttm:agent="v1" begin="02:20.853" end="02:28.853">I wish that I could call you mine</p><p ttm:agent="v1" begin="02:32.790" end="02:40.790">There's no going back</p><p ttm:agent="v1" begin="02:42.514" end="02:46.716">You look at me the same</p><p ttm:agent="v1" begin="02:46.716" end="02:54.716">But I can't reciprocate</p><p ttm:agent="v1" begin="02:56.814" end="03:00.217">Fragrant air</p><p ttm:agent="v1" begin="03:00.217" end="03:08.217">And then I see your face</p><p ttm:agent="v1" begin="03:09.033" end="03:15.863">I see your face</p><p ttm:agent="v1" begin="03:15.863" end="03:19.863">I see your face</p></div></body></tt>