<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Take My Mind</ttm:title><ttm:agent type="group" xml:id="v1">WizTheMc, bees &amp; honey</ttm:agent><ttm:item type="album">Take My Mind</ttm:item><ttm:item type="spotify_id">3bB97PIqXf7WtkKeuYuXFS</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:00.063" end="00:03.842">Take my mind to another place</p><p ttm:agent="v1" begin="00:03.842" end="00:07.138">I feel your thunder I feel your rain</p><p ttm:agent="v1" begin="00:07.138" end="00:08.638">On my skin</p><p ttm:agent="v1" begin="00:08.350" end="00:12.651">When the sundown you show me ways</p><p ttm:agent="v1" begin="00:12.651" end="00:14.734">Ways to follow intention</p><p ttm:agent="v1" begin="00:14.734" end="00:17.865">Ways to unknown dimensions</p><p ttm:agent="v1" begin="00:17.865" end="00:22.058">Why’d you move like that</p><p ttm:agent="v1" begin="00:22.058" end="00:24.198">Why’d you move like that</p><p ttm:agent="v1" begin="00:24.198" end="00:26.278">Got me spinning round the sun</p><p ttm:agent="v1" begin="00:26.278" end="00:30.294">I can’t choose my past</p><p ttm:agent="v1" begin="00:30.294" end="00:32.550">But i can choose you next</p><p ttm:agent="v1" begin="00:32.550" end="00:34.446">I don’t wanna let you down</p><p ttm:agent="v1" begin="00:34.446" end="00:36.509">Oh baby come ride with me</p><p ttm:agent="v1" begin="00:36.509" end="00:38.009">Slide with me</p><p ttm:agent="v1" begin="00:37.180" end="00:38.680">Get high with me</p><p ttm:agent="v1" begin="00:38.558" end="00:40.753">I love when your roll with me</p><p ttm:agent="v1" begin="00:40.753" end="00:42.561">Talk til there no lies</p><p ttm:agent="v1" begin="00:42.561" end="00:44.395">This aint no love song</p><p ttm:agent="v1" begin="00:44.395" end="00:46.491">And far from confessions</p><p ttm:agent="v1" begin="00:46.491" end="00:48.570">I feel your intentions</p><p ttm:agent="v1" begin="00:48.570" end="00:50.424">And you by my side</p><p ttm:agent="v1" begin="00:50.424" end="00:54.478">Take my mind to another place</p><p ttm:agent="v1" begin="00:54.478" end="00:57.485">I feel your thunder I feel your rain</p><p ttm:agent="v1" begin="00:57.485" end="00:58.985">On my skin</p><p ttm:agent="v1" begin="00:58.852" end="01:03.027">When the sundown you show me ways</p><p ttm:agent="v1" begin="01:03.027" end="01:05.129">Ways to follow intention</p><p ttm:agent="v1" begin="01:05.129" end="01:07.177">Ways to unknown dimensions</p><p ttm:agent="v1" begin="01:07.177" end="01:11.374">Take my mind to another place</p><p ttm:agent="v1" begin="01:11.374" end="01:14.420">I feel your thunder I feel your rain</p><p ttm:agent="v1" begin="01:14.420" end="01:15.920">On my skin</p><p ttm:agent="v1" begin="01:15.645" end="01:19.773">When the sundown you show me ways</p><p ttm:agent="v1" begin="01:19.773" end="01:21.949">Ways to follow intention</p><p ttm:agent="v1" begin="01:21.949" end="01:25.119">Ways to unknown dimensions</p><p ttm:agent="v1" begin="01:25.119" end="01:26.619">Baby why you move</p><p ttm:agent="v1" begin="01:26.143" end="01:27.711">Baby why you move like that</p><p ttm:agent="v1" begin="01:27.711" end="01:29.279">Baby how you do it like that</p><p ttm:agent="v1" begin="01:29.279" end="01:30.912">I just need you right here</p><p ttm:agent="v1" begin="01:30.912" end="01:32.412">Maybe its the moonlight yeah</p><p ttm:agent="v1" begin="01:32.254" end="01:33.754">Imma do right yeah</p><p ttm:agent="v1" begin="01:33.593" end="01:35.093">I can’t see</p><p ttm:agent="v1" begin="01:34.798" end="01:36.579">The sky is fallin</p><p ttm:agent="v1" begin="01:36.579" end="01:38.100">We dont talk alot</p><p ttm:agent="v1" begin="01:38.100" end="01:39.600">I’m free</p><p ttm:agent="v1" begin="01:39.243" end="01:40.743">Love is calling</p><p ttm:agent="v1" begin="01:40.347" end="01:41.847">Whatever you got</p><p ttm:agent="v1" begin="01:41.193" end="01:42.693">I want some more</p><p ttm:agent="v1" begin="01:41.952" end="01:43.452">Baby why you move</p><p ttm:agent="v1" begin="01:42.926" end="01:44.509">Baby how you move like that</p><p ttm:agent="v1" begin="01:44.509" end="01:46.031">Losing my cool right here</p><p ttm:agent="v1" begin="01:46.031" end="01:47.632">I just like you like that</p><p ttm:agent="v1" begin="01:47.632" end="01:49.132">Baby how you move it like that</p><p ttm:agent="v1" begin="01:48.995" end="01:50.495">How you move like</p><p ttm:agent="v1" begin="01:49.748" end="01:51.924">Don’t feel this often</p><p ttm:agent="v1" begin="01:51.924" end="01:53.972">Maybe I lost it</p><p ttm:agent="v1" begin="01:53.972" end="01:56.120">Feel like I'm falling</p><p ttm:agent="v1" begin="01:56.120" end="01:57.718">Where will we go</p><p ttm:agent="v1" begin="01:57.718" end="02:01.686">Take my mind to another place</p><p ttm:agent="v1" begin="02:01.686" end="02:04.708">I feel your thunder I feel your rain</p><p ttm:agent="v1" begin="02:04.708" end="02:06.208">On my skin</p><p ttm:agent="v1" begin="02:05.975" end="02:10.338">When the sundown you show me ways</p><p ttm:agent="v1" begin="02:10.338" end="02:12.370">Ways to follow intention</p><p ttm:agent="v1" begin="02:12.370" end="02:14.498">Ways to unknown dimensions</p><p ttm:agent="v1" begin="02:14.498" end="02:18.523">Take my mind to another place</p><p ttm:agent="v1" begin="02:18.523" end="02:21.515">I feel your thunder I feel your rain</p><p ttm:agent="v1" begin="02:21.515" end="02:23.015">On my skin</p><p ttm:agent="v1" begin="02:22.811" end="02:27.035">When the sundown you show me ways</p><p ttm:agent="v1" begin="02:27.035" end="02:29.163">Ways to follow intention</p><p ttm:agent="v1" begin="02:29.163" end="02:33.163">Ways to unknown dimensions</p></div></body></tt>