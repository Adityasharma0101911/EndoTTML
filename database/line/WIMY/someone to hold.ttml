<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>someone to hold</ttm:title>
      <ttm:agent type="person" xml:id="v1">WIMY</ttm:agent>
      <ttm:item type="album">someone to hold</ttm:item>
      <ttm:item type="spotify_id">1OzVgesO7hRNH4uZKzVkZR</ttm:item>
      <itunes:duration>02:41.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:01.150" end="00:05.290" ttm:agent="v1">I want someone to know</p>
      <p begin="00:05.290" end="00:10.060" ttm:agent="v1">Someone to know me again</p>
      <p begin="00:10.060" end="00:15.800" ttm:agent="v1">Know me again</p>
      <p begin="00:15.800" end="00:18.830" ttm:agent="v1">I feel so lonely</p>
      <p begin="00:18.830" end="00:22.390" ttm:agent="v1">Been struggling lately</p>
      <p begin="00:22.390" end="00:29.740" ttm:agent="v1">Can't get out of bed</p>
      <p begin="00:29.740" end="00:32.590" ttm:agent="v1">I tried to call you</p>
      <p begin="00:32.590" end="00:35.760" ttm:agent="v1">But you told me not to</p>
      <p begin="00:35.760" end="00:43.040" ttm:agent="v1">Left a message instead</p>
      <p begin="00:43.040" end="00:49.680" ttm:agent="v1">But if it's not you</p>
      <p begin="00:49.680" end="00:53.980" ttm:agent="v1">I want someone to know</p>
      <p begin="00:53.980" end="00:58.560" ttm:agent="v1">Someone to know me again</p>
      <p begin="00:58.560" end="01:03.570" ttm:agent="v1">Know me again</p>
      <p begin="01:03.570" end="01:07.770" ttm:agent="v1">I want someone to hold</p>
      <p begin="01:07.770" end="01:12.560" ttm:agent="v1">Someone to hold me again</p>
      <p begin="01:12.560" end="01:18.270" ttm:agent="v1">Hold me again</p>
      <p begin="01:18.270" end="01:21.630" ttm:agent="v1">All of the moments</p>
      <p begin="01:21.630" end="01:24.900" ttm:agent="v1">They left me hoping</p>
      <p begin="01:24.900" end="01:32.340" ttm:agent="v1">That we could pretend</p>
      <p begin="01:32.340" end="01:35.460" ttm:agent="v1">I tried to chase her</p>
      <p begin="01:35.460" end="01:38.550" ttm:agent="v1">But I can't escape you</p>
      <p begin="01:38.550" end="01:45.880" ttm:agent="v1">You're stuck in my head</p>
      <p begin="01:45.880" end="01:52.430" ttm:agent="v1">But if it's not you</p>
      <p begin="01:52.430" end="01:56.630" ttm:agent="v1">I want someone to know</p>
      <p begin="01:56.630" end="02:01.550" ttm:agent="v1">Someone to know me again</p>
      <p begin="02:01.550" end="02:06.400" ttm:agent="v1">Know me again</p>
      <p begin="02:06.400" end="02:10.480" ttm:agent="v1">I want someone to hold</p>
      <p begin="02:10.480" end="02:15.370" ttm:agent="v1">Someone to hold me again</p>
      <p begin="02:15.370" end="02:20.120" ttm:agent="v1">Hold me again</p>
      <p begin="02:20.120" end="02:24.530" ttm:agent="v1">I want someone to hold</p>
      <p begin="02:24.530" end="02:29.430" ttm:agent="v1">Someone to hold me again</p>
      <p begin="02:29.430" end="02:34.120" ttm:agent="v1">Hold me again</p>
      <p begin="02:34.120" end="02:38.120" ttm:agent="v1"/>
    </div>
  </body>
</tt>
