<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>again and again</ttm:title>
      <ttm:agent type="person" xml:id="v1">WIMY</ttm:agent>
      <ttm:item type="album">again and again</ttm:item>
      <ttm:item type="spotify_id">3tsECONbCznHQSd2JR4VQN</ttm:item>
      <itunes:duration>03:00.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:15.850" end="00:20.690" ttm:agent="v1">Just stay, too much on my plate</p>
      <p begin="00:20.690" end="00:28.690" ttm:agent="v1">Do you know, how badly I need you? I’m here all alone</p>
      <p begin="00:29.940" end="00:34.820" ttm:agent="v1">My brain can't put you away</p>
      <p begin="00:34.820" end="00:42.820" ttm:agent="v1">Don’t you know how badly I want you to get out of my head?</p>
      <p begin="00:44.820" end="00:47.330" ttm:agent="v1">What have I said?</p>
      <p begin="00:47.330" end="00:51.770" ttm:agent="v1">You’re gone again</p>
      <p begin="00:51.770" end="00:55.940" ttm:agent="v1">Would you still call me a friend?</p>
      <p begin="00:55.940" end="00:59.570" ttm:agent="v1">I keep running back</p>
      <p begin="00:59.570" end="01:05.690" ttm:agent="v1">You’ll break me again and again</p>
      <p begin="01:05.690" end="01:10.050" ttm:agent="v1">I would still love to pretend</p>
      <p begin="01:10.050" end="01:18.050" ttm:agent="v1">That someday you’ll learn to love me again and again</p>
      <p begin="01:18.670" end="01:26.670" ttm:agent="v1"/>
      <p begin="01:34.510" end="01:41.950" ttm:agent="v1">Can you feel me fading slowly?</p>
      <p begin="01:41.950" end="01:49.010" ttm:agent="v1">I don’t know who I am anymore</p>
      <p begin="01:49.010" end="01:52.530" ttm:agent="v1">Can you hear me?</p>
      <p begin="01:52.530" end="01:55.290" ttm:agent="v1" itunes:key="role" itunes:value="background">You’re not sorry (Sorry I miss)</p>
      <p begin="01:55.290" end="02:02.220" ttm:agent="v1" itunes:key="role" itunes:value="background">Baby, I miss holding you in my bed (In my bed)</p>
      <p begin="02:02.220" end="02:05.090" ttm:agent="v1">What have I said?</p>
      <p begin="02:05.090" end="02:09.570" ttm:agent="v1">You’re gone again</p>
      <p begin="02:09.570" end="02:13.410" ttm:agent="v1" itunes:key="role" itunes:value="background">Would you still call me a friend? (Would you still call me a friend?)</p>
      <p begin="02:13.410" end="02:17.210" ttm:agent="v1">I keep running back</p>
      <p begin="02:17.210" end="02:23.490" ttm:agent="v1" itunes:key="role" itunes:value="background">You’ll break me again and again (And again)</p>
      <p begin="02:23.490" end="02:27.740" ttm:agent="v1" itunes:key="role" itunes:value="background">I would still love to pretend (Love to pretend)</p>
      <p begin="02:27.740" end="02:35.740" ttm:agent="v1" itunes:key="role" itunes:value="background">That somеday you’ll learn to love me again and again (Lovе me and again)</p>
      <p begin="02:36.650" end="02:40.650" ttm:agent="v1"/>
    </div>
  </body>
</tt>
