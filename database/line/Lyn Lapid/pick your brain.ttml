<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>pick your brain</ttm:title>
      <ttm:agent type="person" xml:id="v1">Lyn Lapid</ttm:agent>
      <ttm:item type="album">to love in the 21st century</ttm:item>
      <ttm:item type="spotify_id">30TMiaI1TpsUzJAI8ZIduk</ttm:item>
      <itunes:duration>03:40.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:14.950" end="00:18.340" ttm:agent="v1">You kiss me on the forehead</p>
      <p begin="00:18.340" end="00:21.380" ttm:agent="v1">In the hall of your apartment</p>
      <p begin="00:21.380" end="00:29.380" ttm:agent="v1">Feel so high, high, high, high</p>
      <p begin="00:29.540" end="00:33.890" ttm:agent="v1">I swear, I see the world inside your eyes</p>
      <p begin="00:33.890" end="00:38.320" ttm:agent="v1">I wonder what you see in mine</p>
      <p begin="00:38.320" end="00:43.540" ttm:agent="v1">Wide awake at night</p>
      <p begin="00:43.540" end="00:45.380" ttm:agent="v1">Say, I'm all you need</p>
      <p begin="00:45.380" end="00:47.150" ttm:agent="v1" itunes:key="role" itunes:value="background">I live in your head (in your head)</p>
      <p begin="00:47.150" end="00:50.630" ttm:agent="v1" itunes:key="role" itunes:value="background">I'm the one to keep 'cause I'm different (different)</p>
      <p begin="00:50.630" end="00:54.230" ttm:agent="v1" itunes:key="role" itunes:value="background">Don't you go away, I may sound insane (sound insane)</p>
      <p begin="00:54.230" end="00:57.080" ttm:agent="v1">Can I pick your brain?</p>
      <p begin="00:57.080" end="01:00.350" ttm:agent="v1">When the sun goes down</p>
      <p begin="01:00.350" end="01:03.850" ttm:agent="v1">And when I'm not around</p>
      <p begin="01:03.850" end="01:08.870" ttm:agent="v1">I wanna know, am I the last thought that you were thinking</p>
      <p begin="01:08.870" end="01:10.920" ttm:agent="v1">Before you're sleepin'?</p>
      <p begin="01:10.920" end="01:14.210" ttm:agent="v1">Are you gonna change my life?</p>
      <p begin="01:14.210" end="01:17.810" ttm:agent="v1">Are you gonna waste all my time?</p>
      <p begin="01:17.810" end="01:22.840" ttm:agent="v1">I wanna know your ploy, 'cause boy, you got me believing</p>
      <p begin="01:22.840" end="01:27.460" ttm:agent="v1">I must have met you for a reason</p>
      <p begin="01:27.460" end="01:30.420" ttm:agent="v1">The way you call me &quot;darling&quot;</p>
      <p begin="01:30.420" end="01:33.420" ttm:agent="v1">While you hold me in your arms</p>
      <p begin="01:33.420" end="01:37.030" ttm:agent="v1">And suddenly, we're in your car</p>
      <p begin="01:37.030" end="01:42.410" ttm:agent="v1">We're driving through a city to get lost in</p>
      <p begin="01:42.410" end="01:45.270" ttm:agent="v1">Who knows what's gonna happen</p>
      <p begin="01:45.270" end="01:48.920" ttm:agent="v1">At this point, I've lost all my logic</p>
      <p begin="01:48.920" end="01:55.530" ttm:agent="v1" itunes:key="role" itunes:value="background">I'd just love to live in your pocket (yeah, yeah, yeah)</p>
      <p begin="01:55.530" end="01:58.530" ttm:agent="v1">When the sun goes down</p>
      <p begin="01:58.530" end="02:02.280" ttm:agent="v1">And when I'm not around</p>
      <p begin="02:02.280" end="02:07.350" ttm:agent="v1">I wanna know, am I the last thought that you were thinking</p>
      <p begin="02:07.350" end="02:09.190" ttm:agent="v1">Before you're sleepin'?</p>
      <p begin="02:09.190" end="02:12.450" ttm:agent="v1">Are you gonna change my life?</p>
      <p begin="02:12.450" end="02:16.090" ttm:agent="v1">Are you gonna waste all my time?</p>
      <p begin="02:16.090" end="02:21.170" ttm:agent="v1">I wanna know your ploy, 'cause boy, you got me believing</p>
      <p begin="02:21.170" end="02:26.060" ttm:agent="v1">I must have met you for a reason</p>
      <p begin="02:26.060" end="02:32.620" ttm:agent="v1"/>
      <p begin="02:32.620" end="02:38.690" ttm:agent="v1"/>
      <p begin="02:38.690" end="02:42.280" ttm:agent="v1">Feed all of my delusions</p>
      <p begin="02:42.280" end="02:45.900" ttm:agent="v1">Even for your amusement</p>
      <p begin="02:45.900" end="02:48.330" ttm:agent="v1">I have nothing to lose in</p>
      <p begin="02:48.330" end="02:52.570" ttm:agent="v1">In the deep end, I'm in the deep end</p>
      <p begin="02:52.570" end="02:55.060" ttm:agent="v1" itunes:key="role" itunes:value="background">When the sun goes down (ooh)</p>
      <p begin="02:55.060" end="02:58.560" ttm:agent="v1" itunes:key="role" itunes:value="background">And when I'm not around (when I'm not around)</p>
      <p begin="02:58.560" end="03:03.210" ttm:agent="v1" itunes:key="role" itunes:value="background">I wanna know, am I the last thought that you were thinking (you were thinking)</p>
      <p begin="03:03.210" end="03:05.440" ttm:agent="v1" itunes:key="role" itunes:value="background">Before you're sleepin' (ah-aah)</p>
      <p begin="03:05.440" end="03:09.020" ttm:agent="v1" itunes:key="role" itunes:value="background">Are you gonna change my life? (Change my life)</p>
      <p begin="03:09.020" end="03:12.770" ttm:agent="v1" itunes:key="role" itunes:value="background">Are you gonna waste all my time? (Waste all my time)</p>
      <p begin="03:12.770" end="03:17.410" ttm:agent="v1" itunes:key="role" itunes:value="background">I wanna know your ploy, 'cause boy, you got me believing (oh-oh)</p>
      <p begin="03:17.410" end="03:23.390" ttm:agent="v1" itunes:key="role" itunes:value="background">I must have met you for a reason (oh)</p>
      <p begin="03:23.390" end="03:27.390" ttm:agent="v1"/>
    </div>
  </body>
</tt>
