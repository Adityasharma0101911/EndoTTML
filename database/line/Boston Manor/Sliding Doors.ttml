<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Sliding Doors</ttm:title><ttm:agent type="person" xml:id="v1">Boston Manor</ttm:agent><ttm:item type="album">Sundiver</ttm:item><ttm:item type="spotify_id">56F5xUGrogLzbK5M6igRua</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:01.230" end="00:02.730">Sliding doors</p><p ttm:agent="v1" begin="00:01.800" end="00:03.300">On Butterfly wings</p><p ttm:agent="v1" begin="00:02.220" end="00:03.720">Nothing is yours</p><p ttm:agent="v1" begin="00:03.000" end="00:11.000">It’s all for free</p><p ttm:agent="v1" begin="00:25.290" end="00:26.790">A rip in spacetime</p><p ttm:agent="v1" begin="00:25.830" end="00:27.660">A cosmic fluke</p><p ttm:agent="v1" begin="00:27.660" end="00:29.160">A glimpse through the turbine</p><p ttm:agent="v1" begin="00:28.200" end="00:29.700">That created you</p><p ttm:agent="v1" begin="00:28.560" end="00:31.890">Where do I begin?</p><p ttm:agent="v1" begin="00:31.890" end="00:33.960">Peel back all your skin</p><p ttm:agent="v1" begin="00:33.960" end="00:41.960">Sometimes the truth can hurt</p><p ttm:agent="v1" begin="00:54.510" end="00:56.880">But everything is just getting worse</p><p ttm:agent="v1" begin="00:56.880" end="00:58.380">A chance encounter</p><p ttm:agent="v1" begin="00:57.270" end="01:05.270">A casual glance</p><p ttm:agent="v1" begin="01:15.570" end="01:23.570">A natural disaster,</p><p ttm:agent="v1" begin="01:23.940" end="01:31.940">that makes you dance</p><p ttm:agent="v1" begin="01:38.220" end="01:39.720">A rip in spacetime</p><p ttm:agent="v1" begin="01:38.610" end="01:41.790">A cosmic fluke</p><p ttm:agent="v1" begin="01:41.790" end="01:43.290">A glimpse through the turbine</p><p ttm:agent="v1" begin="01:42.330" end="01:43.830">That created you</p><p ttm:agent="v1" begin="01:42.690" end="01:44.910">Where do I begin?</p><p ttm:agent="v1" begin="01:44.910" end="01:52.910">Peel back all your skin</p><p ttm:agent="v1" begin="02:36.330" end="02:44.330">Sometimes the truth can hurt</p><p ttm:agent="v1" begin="03:06.900" end="03:14.900">But everything is just getting worse</p><p ttm:agent="v1" begin="03:18.240" end="03:22.240">Everything is just getting worse</p></div></body></tt>