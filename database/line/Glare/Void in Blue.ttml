<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Void in Blue</ttm:title><ttm:agent type="person" xml:id="v1">Glare</ttm:agent><ttm:item type="album">Void in Blue</ttm:item><ttm:item type="spotify_id">0eZjwNa0wGZSzsOnt4T2hG</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:54.706" end="01:02.706">Here we lay in my bed</p><p ttm:agent="v1" begin="01:06.015" end="01:14.015">I don't feel anything</p><p ttm:agent="v1" begin="01:18.295" end="01:26.295">Discontent in my head</p><p ttm:agent="v1" begin="01:30.446" end="01:38.446">All of this is meaningless</p><p ttm:agent="v1" begin="01:44.134" end="01:50.343">I'll use you</p><p ttm:agent="v1" begin="01:50.343" end="01:56.196">Use me too</p><p ttm:agent="v1" begin="01:56.196" end="02:02.125">We'll make it through</p><p ttm:agent="v1" begin="02:02.125" end="02:07.525">The void in blue</p><p ttm:agent="v1" begin="02:07.525" end="02:15.525">Here we lay once again</p><p ttm:agent="v1" begin="02:19.126" end="02:27.126">Where has my mind been?</p><p ttm:agent="v1" begin="02:31.072" end="02:39.072">Fleeting gift of love once lived</p><p ttm:agent="v1" begin="02:43.259" end="02:51.259">I want to fall in it</p><p ttm:agent="v1" begin="02:57.186" end="03:02.912">I'll use you</p><p ttm:agent="v1" begin="03:02.912" end="03:07.994">Use me too</p><p ttm:agent="v1" begin="03:07.994" end="03:14.967">We'll make it through</p><p ttm:agent="v1" begin="03:14.967" end="03:18.967">The void in blue</p></div></body></tt>