      <p begin="01:59.630" end="02:01.660" ttm:agent="v1">Buckle up and take a seat</p>
      <p begin="02:01.660" end="02:04.150" ttm:agent="v1">Hold on tight</p>
      <p begin="02:04.150" end="02:07.600" ttm:agent="v1">La, la, la, la, la, la, la, la, la, la</p>
