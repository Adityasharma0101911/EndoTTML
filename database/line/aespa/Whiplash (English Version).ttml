      <p begin="02:13.450" end="02:15.010" ttm:agent="v1">I'm the highlight</p>
      <p begin="02:15.010" end="02:17.170" ttm:agent="v1">A shining red light</p>
      <p begin="02:17.170" end="02:18.670" ttm:agent="v1">Yeah tonight,</p>
      <p begin="02:18.220" end="02:19.720" ttm:agent="v1">it's all about me</p>
