<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>Nothing's New</ttm:title>
      <ttm:agent type="person" xml:id="v1">Rio Romeo</ttm:agent>
      <ttm:item type="album">Good God!</ttm:item>
      <ttm:item type="spotify_id">0EF1EE8zusg3Y869e56JFd</ttm:item>
      <itunes:duration>03:31.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:15.430" end="00:18.300" ttm:agent="v1">I wanna be touched</p>
      <p begin="00:18.300" end="00:19.800" ttm:agent="v1">Be loved</p>
      <p begin="00:19.720" end="00:22.130" ttm:agent="v1">I wanna heal</p>
      <p begin="00:22.130" end="00:23.630" ttm:agent="v1">Be hugged</p>
      <p begin="00:23.440" end="00:26.940" ttm:agent="v1">It's just the two of us</p>
      <p begin="00:26.940" end="00:31.210" ttm:agent="v1">Or that's what we swore</p>
      <p begin="00:31.210" end="00:34.660" ttm:agent="v1">And if I've lost my charm</p>
      <p begin="00:34.660" end="00:38.680" ttm:agent="v1">Apologies due, no harm</p>
      <p begin="00:38.680" end="00:42.360" ttm:agent="v1">'Cause you've got ahold of my heart</p>
      <p begin="00:42.360" end="00:46.090" ttm:agent="v1">And I know it's worn</p>
      <p begin="00:46.090" end="00:53.770" ttm:agent="v1">So, won't you please spare me indignity?</p>
      <p begin="00:53.770" end="01:00.850" ttm:agent="v1">And won't you please give me some decency?</p>
      <p begin="01:00.850" end="01:08.280" ttm:agent="v1">And won't you please call it, if our time is through?</p>
      <p begin="01:08.280" end="01:15.050" ttm:agent="v1">'Cause I know that we fall apart, when nothing's new</p>
      <p begin="01:15.050" end="01:18.220" ttm:agent="v1">Nothing's new</p>
      <p begin="01:18.220" end="01:23.320" ttm:agent="v1"/>
      <p begin="01:23.320" end="01:27.120" ttm:agent="v1">I want to be close to you</p>
      <p begin="01:27.120" end="01:30.880" ttm:agent="v1">But I don't know what to do</p>
      <p begin="01:30.880" end="01:34.670" ttm:agent="v1">'Cause if we are near to through</p>
      <p begin="01:34.670" end="01:38.540" ttm:agent="v1">It may make it worse</p>
      <p begin="01:38.540" end="01:42.060" ttm:agent="v1">And if I start to grieve</p>
      <p begin="01:42.060" end="01:45.650" ttm:agent="v1">'Cause it feels you're 'bout to leave</p>
      <p begin="01:45.650" end="01:49.340" ttm:agent="v1">Forgive me, I'm not naïve</p>
      <p begin="01:49.340" end="01:52.900" ttm:agent="v1">I've been here before</p>
      <p begin="01:52.900" end="02:00.660" ttm:agent="v1">So, won't you please spare me indignity?</p>
      <p begin="02:00.660" end="02:07.510" ttm:agent="v1">And won't you please give me some decency?</p>
      <p begin="02:07.510" end="02:15.070" ttm:agent="v1">And won't you please call it, if our time is through?</p>
      <p begin="02:15.070" end="02:22.050" ttm:agent="v1">'Cause I know that we fall apart, when nothing's new</p>
      <p begin="02:22.050" end="02:24.100" ttm:agent="v1">Nothing's new</p>
      <p begin="02:24.100" end="02:25.600" ttm:agent="v1">Nothing's new</p>
      <p begin="02:24.990" end="02:26.490" ttm:agent="v1">Nothing's new</p>
      <p begin="02:25.970" end="02:27.470" ttm:agent="v1">Nothing's new</p>
      <p begin="02:26.870" end="02:28.370" ttm:agent="v1">Nothing's new</p>
      <p begin="02:27.850" end="02:29.350" ttm:agent="v1">Nothing's new</p>
      <p begin="02:28.790" end="02:30.290" ttm:agent="v1">Nothing's new</p>
      <p begin="02:29.770" end="02:31.270" ttm:agent="v1">Nothing's new</p>
      <p begin="02:30.670" end="02:32.540" ttm:agent="v1">Nothing's new</p>
      <p begin="02:32.540" end="02:34.460" ttm:agent="v1">Nothing's new</p>
      <p begin="02:34.460" end="02:36.340" ttm:agent="v1">Nothing's new</p>
      <p begin="02:36.340" end="02:37.840" ttm:agent="v1">Nothing's new</p>
      <p begin="02:37.210" end="02:38.710" ttm:agent="v1">Nothing's new</p>
      <p begin="02:38.080" end="02:39.580" ttm:agent="v1">Nothing's new</p>
      <p begin="02:38.820" end="02:45.170" ttm:agent="v1">Please spare me indignity</p>
      <p begin="02:45.170" end="02:52.520" ttm:agent="v1">And won't you please give me some decency?</p>
      <p begin="02:52.520" end="02:59.990" ttm:agent="v1">And won't you please call it if our time is through?</p>
      <p begin="02:59.990" end="03:06.730" ttm:agent="v1">'Cause I know that we fall apart, when nothing's new</p>
      <p begin="03:06.730" end="03:08.230" ttm:agent="v1">Nothing's new</p>
      <p begin="03:08.020" end="03:12.020" ttm:agent="v1"/>
    </div>
  </body>
</tt>
