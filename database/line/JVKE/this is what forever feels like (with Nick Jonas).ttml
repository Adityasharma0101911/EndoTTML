<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>this is what forever feels like (with Nick Jonas)</ttm:title>
      <ttm:agent type="person" xml:id="v1">JVKE</ttm:agent>
      <ttm:agent type="person" xml:id="v2">Nick Jonas</ttm:agent>
      <ttm:item type="album">this is what forever feels like</ttm:item>
      <ttm:item type="spotify_id">3uTsiaNxy6h6EAd7MsCf9D</ttm:item>
      <itunes:duration>02:35.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:04.020" end="00:08.740" ttm:agent="v1">17, I had my first heartbreak and it was terrible</p>
      <p begin="00:08.740" end="00:12.520" ttm:agent="v1">And I pray that it won't happen again, but then again, I hope it does</p>
      <p begin="00:12.520" end="00:15.870" ttm:agent="v1">Because I wanna fall in love without the part where we give up</p>
      <p begin="00:15.870" end="00:18.310" ttm:agent="v1">I wonder if this still exists, I hope it does</p>
      <p begin="00:18.310" end="00:20.850" ttm:agent="v1">I wonder what it's like</p>
      <p begin="00:20.850" end="00:24.580" ttm:agent="v1">How it feels to be loved by someone who will never leave</p>
      <p begin="00:24.580" end="00:28.030" ttm:agent="v1">I wanna know if you wanna be growing old with me</p>
      <p begin="00:28.030" end="00:32.500" ttm:agent="v1">Until we're 70</p>
      <p begin="00:32.500" end="00:35.160" ttm:agent="v1">Dancing with me</p>
      <p begin="00:35.160" end="00:38.060" ttm:agent="v1">Just passing the time</p>
      <p begin="00:38.060" end="00:41.510" ttm:agent="v1">With you right by my side</p>
      <p begin="00:41.510" end="00:44.380" ttm:agent="v1">Just stay with me</p>
      <p begin="00:44.380" end="00:48.570" ttm:agent="v1">Promise you'll never leave</p>
      <p begin="00:48.570" end="00:53.790" ttm:agent="v1">I wanna love you for the rest of my life</p>
      <p begin="00:53.790" end="01:01.790" ttm:agent="v1">Until we're 70</p>
      <p begin="01:03.710" end="01:07.100" ttm:agent="v1">Baby, I'm so into you, I've lived a thousand lives</p>
      <p begin="01:07.100" end="01:10.020" ttm:agent="v1">Can't go a single night without you</p>
      <p begin="01:10.020" end="01:12.890" ttm:agent="v1" itunes:key="role" itunes:value="background">You're more than a feeling (ooh)</p>
      <p begin="01:12.890" end="01:16.060" ttm:agent="v1">I think I'm ready for the real thing, yeah</p>
      <p begin="01:16.060" end="01:19.020" ttm:agent="v1">I want that love, that type of love that's steady</p>
      <p begin="01:19.020" end="01:21.430" ttm:agent="v1">Like kitchen hugs, sentimental stuff</p>
      <p begin="01:21.430" end="01:25.050" ttm:agent="v1" itunes:key="role" itunes:value="background">You give me everything I want and need (everything I want and need)</p>
      <p begin="01:25.050" end="01:29.100" ttm:agent="v1">I found it here with you and me, yeah</p>
      <p begin="01:29.100" end="01:31.510" ttm:agent="v1">You don't know what it's like</p>
      <p begin="01:31.510" end="01:35.240" ttm:agent="v1">How it feels to be loved by someone who will never leave</p>
      <p begin="01:35.240" end="01:38.700" ttm:agent="v1">I wanna know if you wanna be growing old with me</p>
      <p begin="01:38.700" end="01:43.140" ttm:agent="v1">Until we're 70</p>
      <p begin="01:43.140" end="01:46.020" ttm:agent="v1">Dancing with me</p>
      <p begin="01:46.020" end="01:48.770" ttm:agent="v1">Just passing the time</p>
      <p begin="01:48.770" end="01:52.410" ttm:agent="v1" itunes:key="role" itunes:value="background">With you right by my side (side)</p>
      <p begin="01:52.410" end="01:55.330" ttm:agent="v1">Just stay with me</p>
      <p begin="01:55.330" end="01:59.120" ttm:agent="v1" itunes:key="role" itunes:value="background">Promise you'll never leave (never leave)</p>
      <p begin="01:59.120" end="02:04.730" ttm:agent="v1">I wanna love you for the rest of my life</p>
      <p begin="02:04.730" end="02:08.620" ttm:agent="v1">Until we're 70</p>
      <p begin="02:08.620" end="02:12.140" ttm:agent="v1" itunes:key="role" itunes:value="background">(Ooh-ooh, ooh, yeah)</p>
      <p begin="02:12.140" end="02:17.380" ttm:agent="v1">I wanna love you for the rest of my life</p>
      <p begin="02:17.380" end="02:21.100" ttm:agent="v1">Until we're 70</p>
      <p begin="02:21.100" end="02:25.080" ttm:agent="v1" itunes:key="role" itunes:value="background">Promise you'll never leave (you'll never leave)</p>
      <p begin="02:25.080" end="02:30.380" ttm:agent="v1">I wanna love you for the rest of my life</p>
      <p begin="02:30.380" end="02:33.650" ttm:agent="v1">Until we're 70</p>
      <p begin="02:33.650" end="02:37.650" ttm:agent="v1"/>
    </div>
  </body>
