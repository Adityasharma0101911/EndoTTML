<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>next to you</ttm:title>
      <ttm:agent type="person" xml:id="v1">JVKE</ttm:agent>
      <ttm:item type="album">next to you</ttm:item>
      <ttm:item type="spotify_id">1GmZgx9giHMoqXqYBqbtw7</ttm:item>
      <itunes:duration>02:34.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:00.170" end="00:04.760" ttm:agent="v1">I was thinking</p>
      <p begin="00:04.760" end="00:09.590" ttm:agent="v1">Maybe we should</p>
      <p begin="00:09.590" end="00:11.980" ttm:agent="v1">Runaway to an exhilarating place</p>
      <p begin="00:11.980" end="00:14.130" ttm:agent="v1">Where everything is in your arms</p>
      <p begin="00:14.130" end="00:16.570" ttm:agent="v1">Take a trip inside kaleidoscopic eyes</p>
      <p begin="00:16.570" end="00:18.900" ttm:agent="v1">And watch as they reflect the stars</p>
      <p begin="00:18.900" end="00:20.400" ttm:agent="v1">Maybe when we fall asleep</p>
      <p begin="00:20.270" end="00:22.880" ttm:agent="v1">I'll see you in a dream, ignoring the alarm</p>
      <p begin="00:22.880" end="00:25.910" ttm:agent="v1">'Cause I don't wanna wake up unless</p>
      <p begin="00:25.910" end="00:30.470" ttm:agent="v1">I'm right next to you</p>
      <p begin="00:30.470" end="00:34.110" ttm:agent="v1">Ooh, ooh</p>
      <p begin="00:34.110" end="00:37.220" ttm:agent="v1">I'm right next to you</p>
      <p begin="00:37.220" end="00:39.250" ttm:agent="v1"/>
      <p begin="00:39.250" end="00:42.240" ttm:agent="v1">I don't wanna wake up unless</p>
      <p begin="00:42.240" end="00:44.650" ttm:agent="v1">I'm right next to you</p>
      <p begin="00:44.650" end="00:47.670" ttm:agent="v1">Wake up, wake up, wake up, I don't wanna wake up</p>
      <p begin="00:47.670" end="00:49.570" ttm:agent="v1">You look good without no makeup</p>
      <p begin="00:49.570" end="00:51.070" ttm:agent="v1">Morning coffee with no K-Cup</p>
      <p begin="00:51.040" end="00:53.070" ttm:agent="v1">All the energy I need</p>
      <p begin="00:53.070" end="00:55.170" ttm:agent="v1" itunes:key="role" itunes:value="background">Radiate from your light beams (ah)</p>
      <p begin="00:55.170" end="00:57.180" ttm:agent="v1">If I fall asleep, you'll be in my dreams</p>
      <p begin="00:57.180" end="00:58.680" ttm:agent="v1">I don't wanna leave</p>
      <p begin="00:58.430" end="01:01.430" ttm:agent="v1">Or let one moment pass</p>
      <p begin="01:01.430" end="01:05.680" ttm:agent="v1">Commitment is all that I ask</p>
      <p begin="01:05.680" end="01:08.460" ttm:agent="v1">And I'll give you all that I have</p>
      <p begin="01:08.460" end="01:10.320" ttm:agent="v1">Put you on and show you off</p>
      <p begin="01:10.320" end="01:12.170" ttm:agent="v1">Find myself whenever we get lost</p>
      <p begin="01:12.170" end="01:14.520" ttm:agent="v1">Girl, I know that we gon' last and they could laugh</p>
      <p begin="01:14.520" end="01:16.260" ttm:agent="v1">But they don't have what we've got</p>
      <p begin="01:16.260" end="01:20.500" ttm:agent="v1">I was thinking</p>
      <p begin="01:20.500" end="01:25.170" ttm:agent="v1">Maybe we should</p>
      <p begin="01:25.170" end="01:27.830" ttm:agent="v1">Runaway to an exhilarating place</p>
      <p begin="01:27.830" end="01:29.660" ttm:agent="v1">Where everything is in your arms</p>
      <p begin="01:29.660" end="01:31.660" ttm:agent="v1">Take a trip inside kaleidoscopic eyes</p>
      <p begin="01:31.660" end="01:33.810" ttm:agent="v1">And watch as they reflect the stars</p>
      <p begin="01:33.810" end="01:35.310" ttm:agent="v1">Maybe when we fall asleep</p>
      <p begin="01:35.290" end="01:37.930" ttm:agent="v1">I'll see you in a dream, ignoring the alarm</p>
      <p begin="01:37.930" end="01:40.820" ttm:agent="v1">'Cause I don't wanna wake up unless</p>
      <p begin="01:40.820" end="01:45.470" ttm:agent="v1">I'm right next to you</p>
      <p begin="01:45.470" end="01:48.920" ttm:agent="v1">Ooh, ooh</p>
      <p begin="01:48.920" end="01:54.130" ttm:agent="v1" itunes:key="role" itunes:value="background">I'm right next to you (ah)</p>
      <p begin="01:54.130" end="01:57.240" ttm:agent="v1">I don't wanna wake up unless</p>
      <p begin="01:57.240" end="01:58.860" ttm:agent="v1">I'm right next to you</p>
      <p begin="01:58.860" end="02:02.860" ttm:agent="v1"/>
    </div>
  </body>
</tt>
