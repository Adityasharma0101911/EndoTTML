<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>sinner</ttm:title><ttm:agent type="person" xml:id="v1">CHSKA</ttm:agent><ttm:item type="album">sinner</ttm:item><ttm:item type="spotify_id">0mwLD8R1dtPrAtXON1TJSA</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:14.125" end="00:17.571">Slowly</p><p ttm:agent="v1" begin="00:17.571" end="00:22.550">You kiss me</p><p ttm:agent="v1" begin="00:22.550" end="00:28.588">And I know I've been on your mind</p><p ttm:agent="v1" begin="00:28.588" end="00:31.896">Lately</p><p ttm:agent="v1" begin="00:31.896" end="00:34.323">You hold me</p><p ttm:agent="v1" begin="00:34.323" end="00:42.323">So tight, like I'm slipping out your life</p><p ttm:agent="v1" begin="00:42.963" end="00:45.372">Baby</p><p ttm:agent="v1" begin="00:45.372" end="00:49.651">I'm a sinner</p><p ttm:agent="v1" begin="00:49.651" end="00:57.348">The way you put me down on my knees</p><p ttm:agent="v1" begin="00:57.348" end="00:59.985">Maybe</p><p ttm:agent="v1" begin="00:59.985" end="01:05.364">We'll be forever</p><p ttm:agent="v1" begin="01:05.364" end="01:12.077">You're the only hollow missing piece</p><p ttm:agent="v1" begin="01:12.077" end="01:18.800">You bring me hell just to take me to heaven</p><p ttm:agent="v1" begin="01:18.800" end="01:25.960">You curse me with sin just to bless me with graces</p><p ttm:agent="v1" begin="01:25.960" end="01:29.506">Been on the low then we're high</p><p ttm:agent="v1" begin="01:29.506" end="01:33.178">You're my favourite vice</p><p ttm:agent="v1" begin="01:33.178" end="01:36.664">My strongest addiction</p><p ttm:agent="v1" begin="01:36.664" end="01:44.541">You're all that I'm missin'</p><p ttm:agent="v1" begin="01:44.541" end="01:51.095">Give you all - give you all of me</p><p ttm:agent="v1" begin="01:51.095" end="01:59.095">I'm breathin' you in</p><p ttm:agent="v1" begin="01:59.104" end="02:03.125">Feel of your skin</p><p ttm:agent="v1" begin="02:03.125" end="02:07.300">You don't know what it does to me</p><p ttm:agent="v1" begin="02:07.300" end="02:09.946">No, baby</p><p ttm:agent="v1" begin="02:09.946" end="02:16.307">You bring me hell just to take me to heaven</p><p ttm:agent="v1" begin="02:16.307" end="02:23.541">You curse me with sin just to bless me with graces</p><p ttm:agent="v1" begin="02:23.541" end="02:26.948">Been on the low then we're high</p><p ttm:agent="v1" begin="02:26.948" end="02:30.607">You're my favourite vice</p><p ttm:agent="v1" begin="02:30.607" end="02:34.274">My strongest addiction</p><p ttm:agent="v1" begin="02:34.274" end="02:38.274">You're all that I'm missin'</p></div></body></tt>