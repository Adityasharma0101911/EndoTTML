<?xml version='1.0' encoding='utf-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15"><head><metadata><ttm:title>Under My Tongue</ttm:title><ttm:agent type="person" xml:id="v1">Katastro</ttm:agent><ttm:item type="album">Strange Nights</ttm:item><ttm:item type="spotify_id">2OikEBxAnm5UfC0Ag6VCsa</ttm:item></metadata><styling><style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold" /><style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic" /></styling><layout><region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" /></layout></head><body><div><p ttm:agent="v1" begin="00:14.080" end="00:15.760">I can go</p><p ttm:agent="v1" begin="00:15.760" end="00:19.530">I can go all day if you need</p><p ttm:agent="v1" begin="00:19.530" end="00:21.030">I'm alone</p><p ttm:agent="v1" begin="00:21.030" end="00:24.740">But I've got something if you need</p><p ttm:agent="v1" begin="00:24.740" end="00:27.570">Don't let that dance stop</p><p ttm:agent="v1" begin="00:27.570" end="00:29.070">I know you gotta problem</p><p ttm:agent="v1" begin="00:28.950" end="00:30.450">Everybody's got 'em</p><p ttm:agent="v1" begin="00:29.990" end="00:35.280">But nothin' ever goes your way</p><p ttm:agent="v1" begin="00:35.280" end="00:36.780">Just feel the anthem</p><p ttm:agent="v1" begin="00:36.640" end="00:38.140">Come under your tongue</p><p ttm:agent="v1" begin="00:37.870" end="00:39.370">We'll have everybody jumpin</p><p ttm:agent="v1" begin="00:39.200" end="00:42.670">When they don't even know your name</p><p ttm:agent="v1" begin="00:42.670" end="00:47.180">You've been low</p><p ttm:agent="v1" begin="00:47.180" end="00:53.810">But there's more of me you should see</p><p ttm:agent="v1" begin="00:53.810" end="00:57.270">Don't you know</p><p ttm:agent="v1" begin="00:57.270" end="01:05.270">I can turn you up if you need</p><p ttm:agent="v1" begin="01:23.500" end="01:28.950">All I need is emotions for ya</p><p ttm:agent="v1" begin="01:28.950" end="01:33.740">When will I be here devoted to ya</p><p ttm:agent="v1" begin="01:33.740" end="01:41.740">All I see is you keep bringing me down</p><p ttm:agent="v1" begin="02:19.450" end="02:23.450" /></div></body></tt>