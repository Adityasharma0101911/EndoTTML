<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:timeBase="media" ttp:cellResolution="32 15">
  <head>
    <metadata>
      <ttm:title>more than a friend?</ttm:title>
      <ttm:agent type="person" xml:id="v1">88rising</ttm:agent>
      <ttm:agent type="person" xml:id="v2">FION</ttm:agent>
      <ttm:item type="album">more than a friend?</ttm:item>
      <ttm:item type="spotify_id">0EJSyxVGp7ZFbrj9WPaubp</ttm:item>
      <itunes:duration>03:08.000</itunes:duration>
    </metadata>
    <styling>
      <style xml:id="s1" tts:color="#FFFFFF" tts:fontSize="100%" tts:textAlign="center" tts:fontFamily="sansSerif" tts:fontStyle="normal" tts:fontWeight="bold"/>
      <style xml:id="bg_vocal" tts:color="#A0A0A0" tts:fontStyle="italic"/>
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:12.660" end="00:15.830" ttm:agent="v1">In my head we're just friends</p>
      <p begin="00:15.830" end="00:19.270" ttm:agent="v1">But I really wanna be with you</p>
      <p begin="00:19.270" end="00:22.310" ttm:agent="v1">Wear a dress, hope instead</p>
      <p begin="00:22.310" end="00:24.990" ttm:agent="v1">That you'll think the way I think of you</p>
      <p begin="00:24.990" end="00:28.160" ttm:agent="v1">You know I want you bad</p>
      <p begin="00:28.160" end="00:31.590" ttm:agent="v1">Just wanna hold your hand</p>
      <p begin="00:31.590" end="00:37.690" ttm:agent="v1">Hard time believing that I shouldn't come over</p>
      <p begin="00:37.690" end="00:42.950" ttm:agent="v1">What if you let me be your more than a friend?</p>
      <p begin="00:42.950" end="00:46.240" ttm:agent="v1">I'd love you from end to end</p>
      <p begin="00:46.240" end="00:50.640" ttm:agent="v1">Swear that you feel the same too</p>
      <p begin="00:50.640" end="00:54.540" ttm:agent="v1">'Cause I know I've seen the way we stare</p>
      <p begin="00:54.540" end="00:57.940" ttm:agent="v1">Can you feel it in the air?</p>
      <p begin="00:57.940" end="01:05.940" ttm:agent="v1">I can't help it boy I'm falling for you</p>
      <p begin="01:06.880" end="01:10.140" ttm:agent="v1">Na-na-na, na-na-na, oh</p>
      <p begin="01:10.140" end="01:13.410" ttm:agent="v1">Na-na-na, na-na-na, oh</p>
      <p begin="01:13.410" end="01:18.370" ttm:agent="v1">Na-na-na, na-na-na, oh</p>
      <p begin="01:18.370" end="01:21.520" ttm:agent="v1">Is it clear? I'm right here</p>
      <p begin="01:21.520" end="01:24.820" ttm:agent="v1">I've been waiting for a light from you</p>
      <p begin="01:24.820" end="01:28.240" ttm:agent="v1">Try to hide, been a year</p>
      <p begin="01:28.240" end="01:30.760" ttm:agent="v1">Boy you'd really be a dream come true</p>
      <p begin="01:30.760" end="01:33.980" ttm:agent="v1">You know I want you bad</p>
      <p begin="01:33.980" end="01:37.290" ttm:agent="v1" itunes:key="role" itunes:value="background">Just wanna hold your hand (just wanna)</p>
      <p begin="01:37.290" end="01:43.480" ttm:agent="v1">Hard time believing that I shouldn't come over</p>
      <p begin="01:43.480" end="01:48.730" ttm:agent="v1">What if you let me be your more than a friend?</p>
      <p begin="01:48.730" end="01:52.030" ttm:agent="v1">I'd love you from end to end</p>
      <p begin="01:52.030" end="01:56.490" ttm:agent="v1" itunes:key="role" itunes:value="background">Swear that you feel the same too (swear that you feel the same)</p>
      <p begin="01:56.490" end="02:00.390" ttm:agent="v1">'Cause I know I've seen the way we stare</p>
      <p begin="02:00.390" end="02:03.710" ttm:agent="v1">Can you feel it in the air?</p>
      <p begin="02:03.710" end="02:11.710" ttm:agent="v1">I can't help it boy I'm falling for you</p>
      <p begin="02:12.610" end="02:15.870" ttm:agent="v1">Na-na-na, na-na-na, oh</p>
      <p begin="02:15.870" end="02:19.240" ttm:agent="v1">Na-na-na, na-na-na, oh</p>
      <p begin="02:19.240" end="02:25.770" ttm:agent="v1">Na-na-na, na-na-na, oh</p>
      <p begin="02:25.770" end="02:29.030" ttm:agent="v1">Na-na-na, na-na-na, oh</p>
      <p begin="02:29.030" end="02:32.360" ttm:agent="v1">Na-na-na, na-na-na, oh</p>
      <p begin="02:32.360" end="02:36.060" ttm:agent="v1">Na-na-na, na-na-na, oh</p>
      <p begin="02:36.060" end="02:41.390" ttm:agent="v1">What if you let me be your more than a friend?</p>
      <p begin="02:41.390" end="02:44.480" ttm:agent="v1">I'd love you from end to end</p>
      <p begin="02:44.480" end="02:48.970" ttm:agent="v1">Swear that you feel the same too</p>
      <p begin="02:48.970" end="02:52.980" ttm:agent="v1">'Cause I know I've seen the way we stare</p>
      <p begin="02:52.980" end="02:56.370" ttm:agent="v1">Can you feel it in the air?</p>
      <p begin="02:56.370" end="03:02.330" ttm:agent="v1">I can't help it boy I'm falling for you</p>
      <p begin="03:02.330" end="03:06.330" ttm:agent="v1"/>
    </div>
  </body>
</tt>
